# Demo mode is intended only for local review. Production defaults to remote.
BSS_DATA_MODE=remote
BSS_API_BASE_URL=https://api.example.gov.in
BSS_AUTH_API_URL=https://identity.example.gov.in
BSS_APP_ORIGIN=https://portal.example.gov.in
BSS_SERVICE_TOKEN=
BSS_PAYMENT_HOSTS=checkout.razorpay.com,secure.payu.in
BSS_SESSION_SECRET=replace-with-at-least-32-random-characters
BSS_API_TIMEOUT_MS=10000

# Attendance client downloads (optional direct asset URLs; falls back to GitHub Releases)
BSS_ATTENDANCE_WINDOWS_URL=/downloads/attendance/BSS-Attendance-Windows-Setup.exe
BSS_ATTENDANCE_LINUX_URL=/downloads/attendance/BSS-Attendance-Linux.AppImage
BSS_ATTENDANCE_VERSION=1.0.0
