// ==========================================
// Bharat Shram Setu (BSS) — Database Diagram
// DBML representation for dbdiagram.io
// ==========================================

Table app_role {
  id int [pk, increment]
  code varchar(40) [unique, not null]
  label varchar(60) [not null]
  is_login_role boolean [not null, default: true]
  sort_order smallint [not null, default: 0]
}

Table users {
  id bigint [pk, increment]
  role varchar(40) [not null, ref: > app_role.code]
  password_hash varchar(255)
  account_active boolean [not null, default: true]
  is_verified boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table user_credentials {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  identity_type varchar(20) [not null, note: "mobile, email, aadhaar, login_id"]
  identity_value varchar(255) [not null]
  is_primary boolean [not null, default: false]
  verified boolean [not null, default: false]
  password_hash varchar(255)
  mpin_hash varchar(255)
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (identity_type, identity_value) [unique]
  }
}

Table contractor_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  contractor_name varchar(120)
  contractor_code varchar(40)
  contact_person varchar(120)
  mobile varchar(20)
  email varchar(120)
  state varchar(60)
  district varchar(60)
  address varchar(255)
  gstin varchar(40)
  pan_no varchar(20)
  lin varchar(40)
  approval_status varchar(20) [not null, default: "PENDING"]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table employer_profiles {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  employer_name varchar(120)
  employer_code varchar(40)
  contact_person varchar(120)
  mobile varchar(20)
  email varchar(120)
  state varchar(60)
  district varchar(60)
  address varchar(255)
  industry varchar(80)
  gstin varchar(40)
  pan_no varchar(20)
  lin varchar(40)
  approval_status varchar(20) [not null, default: "PENDING"]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table government_profile {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  gov_type varchar(20) [not null, note: "inspector, admin"]
  officer_name varchar(120)
  department varchar(80)
  designation varchar(80)
  jurisdiction varchar(120)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table bss_staff_profile {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  employee_code varchar(40)
  full_name varchar(120)
  department varchar(80)
  designation varchar(80)
  mobile varchar(20)
  email varchar(120)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table it_profile {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  employee_code varchar(40)
  full_name varchar(120)
  department varchar(80)
  designation varchar(80)
  mobile varchar(20)
  email varchar(120)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table site {
  // One row per physical site. Site -> Many-to-One -> Employer.
  // One EMPLOYER can own MANY SITES (employer_id is NOT unique) and can put
  // DIFFERENT contractors on DIFFERENT sites, e.g.
  //   E1 owns S1,S2,S3 ; C1 manages S1&S2 ; C2 manages S3.
  // Each employer-generated site QR token maps to one site row.
  // Employer derived via site.employer_id; contractor-site via worker_contractor_binding.site_id.
  id bigint [pk, increment]
  site_name varchar(120)
  site_code varchar(40) [unique, not null]
  employer_id bigint [not null, ref: > users.id, note: "site owner (role='employer'); NON-unique => employer has many sites"]
  latitude numeric [note: "GPS latitude; geolocation / attendance geofencing"]
  longitude numeric [note: "GPS longitude; geolocation / attendance geofencing"]
  site_qr_token uuid [not null, default: `gen_random_uuid()`, unique, note: "site-based QR code identity"]
  location varchar(255)
  city varchar(60)
  district varchar(60)
  state varchar(60)
  pincode varchar(10)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (employer_id) [name: 'idx_site_employer', note: "many sites per employer"]
  }
}

Table worker_contractor_binding {
  // Contractor manages MULTIPLE SITES via one binding row per site:
  //   (W1, C1, S1) and (W2, C1, S2)  =>  C1 manages both S1 and S2.
  // 1 worker = 1 ACTIVE site enforced by PARTIAL unique index on worker_id
  // where binding_status = 'ACCEPTED' (allows PENDING on other sites).
  // Employer derived through site.employer_id (constant E-C-S-W tuple).
  id bigint [pk, increment]
  worker_id bigint [not null, ref: > users.id, note: "W"]
  contractor_id bigint [not null, ref: > users.id, note: "C"]
  site_id bigint [not null, ref: > site.id, note: "S"]
  binding_status varchar(20) [not null, default: "PENDING", note: "PENDING, ACCEPTED, REJECTED, CANCELLED, EXPIRED"]
  consent_worker boolean [not null, default: false]
  consent_contractor boolean [not null, default: false]
  consent_method varchar(20) [note: "app, ivr, sms_otp, voice"]
  accepted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (worker_id, contractor_id, site_id) [unique, note: "constant E-C-S-W tuple; E via site"]
    (worker_id) [name: 'uq_binding_one_active_site_per_worker', unique, note: "PARTIAL: WHERE binding_status='ACCEPTED' => 1 worker = 1 active site"]
    (contractor_id) [name: 'idx_binding_contractor']
    (worker_id) [name: 'idx_binding_worker']
  }
}

Table worker_identity {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  bss_worker_id varchar(20) [unique, not null]
  name varchar(120)
  gender varchar(10)
