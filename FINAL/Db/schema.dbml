  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  worker_category varchar(60)
  sector varchar(80)
  industry varchar(80)
  occupation varchar(80)
  skill varchar(80)
  current_employment_status varchar(40)
  total_worker_experience varchar(40)
  gig_platform_worker_id varchar(60)
  gig_platform_name varchar(120)
  gig_platform_type varchar(60)
  gig_date_joined_platform date
  gig_avg_hours_per_day varchar(40)
  gig_avg_days_per_week varchar(40)
  gig_service_area varchar(120)
  gig_vehicle_type varchar(60)
  gig_vehicle_ownership varchar(40)
  gig_dl_number varchar(40)
  gig_dl_expiry date
  se_business_name varchar(120)
  se_business_type varchar(60)
  se_registration_status varchar(40)
  se_start_date date
  se_business_location varchar(120)
  se_avg_hours_per_day varchar(40)
  se_avg_days_per_week varchar(40)
  se_num_employees smallint
  se_employer_or_business_name varchar(120)
  season_job_work_type varchar(80)
  season_start_date date
  season_end_date date
  season_avg_hours_per_day varchar(40)
  season_avg_days_per_week varchar(40)
  season_work_location varchar(120)
  season_expected_income varchar(40)
  season_payment_frequency varchar(40)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table worker_employment {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  assignment_id bigint [ref: > worker_contractor_binding.id]
  camp_no varchar(40)
  shift varchar(40)
  ref_worker_id varchar(40)
  doj date
  designation varchar(80)
  department varchar(80)
  id_card_issue_date date
  id_card_validity_till date
  transport_facility varchar(40)
  route varchar(80)
  bus_no varchar(40)
  status varchar(40)
  pf_account varchar(40)
  nature_of_job varchar(120)
  type_of_work varchar(120)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table skill_master {
  id bigint [pk, increment]
  code varchar(6) [unique, not null]
  sector varchar(60) [not null]
  family varchar(80)
  occupation varchar(120) [not null]
  typical_level varchar(40)
  industry_use varchar(200)
  description varchar(300)
  sort_order smallint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table worker_skills_employability {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  qualification_course varchar(120)
  board_university varchar(120)
  passing_year varchar(10)
  primary_skill varchar(80)
  primary_skill_code varchar(6) [ref: > skill_master.code]
  secondary_skills varchar(255)
  skill_experience_years varchar(20)
  certification_name varchar(120)
  certification_number varchar(60)
  certification_authority varchar(120)
  certification_expiry date
  languages_known varchar(255)
}

Table worker_other {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  consent_registration boolean
  consent_verification boolean
  consent_date date
  qr_opt_in boolean [not null, default: false]
  registration_source varchar(80)
  registered_by varchar(120)
  registration_date date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table rbac_permissions {
  id bigint [pk, increment]
  role varchar(40) [not null, ref: > app_role.code]
  resource varchar(60) [not null]
  field varchar(60) [not null]
  access varchar(20) [not null, note: "view, edit, masked, view_masked, restricted, full, no, conditional, optional"]
  reveal_type varchar(20) [note: "full, verified_only, band_only, public"]
  binding_scope varchar(20) [note: "unbound, bound"]
  scope varchar(40)
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (role, resource, field, binding_scope) [unique]
  }
}

Table qr_role_access {
  id bigint [pk, increment]
  role varchar(40) [not null, ref: > app_role.code]
  binding_scope varchar(20) [note: "unbound, bound"]
  grant_mechanism varchar(120)
  default_access varchar(60)
  sensitive_allowed boolean [not null, default: false]
  optional_identifiers boolean [not null, default: false]
  recommended_scope varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (role, binding_scope) [unique]
  }
}

Table lookup_value {
  id bigint [pk, increment]
  category varchar(60) [not null]
  value varchar(120) [not null]
  sort_order smallint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (category, value) [unique]
  }
}

Table worker_category_master {
  id bigint [pk, increment]
  code varchar(5) [unique, not null]
  name varchar(120) [not null]
  definition varchar(500)
  typical_workplaces varchar(300)
  primary_relationship varchar(120)
  data_focus varchar(300)
  sort_order smallint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table contractor_job {
  id bigint [pk, increment]
  contractor_id bigint [not null, ref: > users.id]
  site_id bigint [ref: > site.id]
  job_title varchar(120) [not null]
  job_description varchar(500)
  wage_offered varchar(60)
  start_date date
  validity_until date
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table rozgar_request {
  id bigint [pk, increment]
  job_id bigint [not null, ref: > contractor_job.id]
  contractor_id bigint [not null, ref: > users.id]
  worker_id bigint [not null, ref: > users.id]
  status varchar(20) [not null, default: "PENDING", note: "PENDING, ACCEPTED, REJECTED, CANCELLED, EXPIRED"]
  requested_at timestamp [not null, default: `now()`]
  responded_at timestamp
  expires_at timestamp
  notes varchar(500)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table worker_grievance {
  id bigint [pk, increment]
  worker_id bigint [not null, ref: > users.id]
  language varchar(40)
  recording_file varchar(255)
  recording_duration_secs integer
  body varchar(1000)
  status varchar(30) [not null, default: "RECORDED", note: "RECORDED, SUBMITTED, VIEWED_ON_DASHBOARD"]
  submitted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table worker_document_master {
  id bigint [pk, increment]
  code varchar(6) [unique, not null]
  document_name varchar(120) [not null]
  is_mandatory boolean [not null, default: false]
  uploaded_by varchar(20) [not null, default: "worker", note: "worker, system"]
  sort_order smallint [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table worker_documents {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  document_id bigint [not null, ref: > worker_document_master.id]
  file_name varchar(255)
  file_path varchar(255)
  file_size bigint
  mime_type varchar(100)
  status varchar(20) [not null, default: "UPLOADED", note: "UPLOADED, VERIFIED, REJECTED"]
  uploaded_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (user_id, document_id, file_name) [unique]
  }
}

Table attendance_device {
  // Physical capture hardware / scan point bound to a site.
  // capture_type: QR = QR scanner, NFC = tap terminal, CAMERA = image/face terminal.
  id bigint [pk, increment]
  site_id bigint [not null, ref: > site.id]
  contractor_id bigint [ref: > users.id]
  device_code varchar(40) [unique, not null]
  device_name varchar(120)
  capture_type varchar(20) [not null, note: "QR, NFC, CAMERA"]
  device_serial varchar(80)
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (site_id) [name: 'idx_att_device_site']
  }
}

Table attendance {
  // Attendance punch/log captured by QR, NFC or CAMERA (image/face).
  // Linked to E-C-S-W via worker/site/contractor; employer derived via site.
  id bigint [pk, increment]
  worker_id bigint [not null, ref: > users.id, note: "W"]
  site_id bigint [not null, ref: > site.id, note: "S"]
  contractor_id bigint [ref: > users.id, note: "C (optional)"]
  device_id bigint [ref: > attendance_device.id]
  attendance_date date [not null, default: `CURRENT_DATE`]
  check_in_time timestamp
  check_out_time timestamp
  status varchar(20) [not null, default: "PRESENT", note: "PRESENT, ABSENT, LEAVE, HOLIDAY, EXPECTED, LATE, HALF_DAY"]
  capture_method varchar(20) [not null, note: "QR, NFC, CAMERA"]
  verification_type varchar(30) [note: "qr_worker, qr_site, nfc_card, face_image, badge_image"]
  image_file varchar(255) [note: "captured image path (CAMERA)"]
  confidence_pct numeric [note: "face/badge match confidence (CAMERA)"]
  gps_lat numeric [note: "geofence lat read at punch"]
  gps_long numeric [note: "geofence long read at punch"]
  is_geofence_ok boolean
  is_verified boolean [not null, default: false]
  verified_by bigint [ref: > users.id]
  verified_at timestamp
  remarks varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (worker_id, attendance_date) [name: 'idx_attendance_worker_date']
    (site_id, attendance_date) [name: 'idx_attendance_site_date']
    (contractor_id) [name: 'idx_attendance_contractor']
  }
}

Table worker_wages {
  // Earned wages per worker per pay period; auto-computed from attendance or manual.
  id bigint [pk, increment]
  worker_id bigint [not null, ref: > users.id, note: "W"]
  site_id bigint [ref: > site.id, note: "S"]
  contractor_id bigint [ref: > users.id, note: "C"]
  period_start date [not null]
  period_end date [not null]
  wage_frequency varchar(20) [not null, default: "MONTHLY", note: "DAILY, WEEKLY, MONTHLY, PIECE_RATE"]
  days_present numeric [not null, default: 0]
  days_absent numeric [not null, default: 0]
  daily_wage numeric
  units_done numeric [note: "piece-rate units (PIECE_RATE)"]
  piece_rate numeric [note: "per-unit amount (PIECE_RATE)"]
  base_wage numeric
  overtime_hours numeric [not null, default: 0]
  overtime_amount numeric [not null, default: 0]
  gross_wage numeric [not null, default: 0]
  deductions_amount numeric [not null, default: 0]
  net_wage numeric [not null, default: 0]
  status varchar(20) [not null, default: "DRAFT", note: "DRAFT, APPROVED, PAID, CANCELLED"]
  computed_from_attendance boolean [not null, default: false]
  approved_by bigint [ref: > users.id]
  approved_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (worker_id, period_start, period_end) [unique, note: "one wage row per pay cycle"]
    (worker_id) [name: 'idx_wages_worker']
    (site_id) [name: 'idx_wages_site']
  }
}

Table wage_payment {
  // Disbursement of an approved wage record (money transfer).
  id bigint [pk, increment]
  worker_wages_id bigint [not null, ref: > worker_wages.id]
  pay_mode varchar(20) [not null, note: "BANK, UPI, CASH"]
  amount numeric [not null]
  paid_at timestamp [not null, default: `now()`]
  transaction_ref varchar(80)
  bank_account_last4 varchar(10)
  upi_id varchar(80)
  paid_by bigint [ref: > users.id, note: "processor (contractor/employer)"]
  remarks varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (worker_wages_id) [name: 'idx_wage_payment_wages']
  }
}

Table document_access_token {
  // Time-bound / timed tokens for secure document access & verification.
  // Short-lived token, stored hashed; expires at expires_at (time-bound),
  // optionally limited by max_uses; can be USED / EXPIRED / REVOKED.
  id bigint [pk, increment]
  token_type varchar(30) [not null, note: "DOCUMENT_VIEW, DOCUMENT_VERIFY, DOCUMENT_DOWNLOAD, ONBOARDING, OFFER_LETTER"]
  document_id bigint [ref: > worker_documents.id, note: "optional target document"]
  subject_id bigint [ref: > users.id, note: "entity the token is about (worker)"]
  requester_id bigint [ref: > users.id, note: "who requested/issued"]
  token_hash varchar(128) [unique, not null, note: "hashed token value (never raw)"]
  status varchar(20) [not null, default: "ACTIVE", note: "ACTIVE, USED, EXPIRED, REVOKED"]
  issued_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null, note: "time-bound expiry"]
  used_at timestamp
  max_uses smallint [not null, default: 1]
  use_count smallint [not null, default: 0]
  redirect_url varchar(255)
  ip_address varchar(45)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (token_hash) [name: 'idx_doc_token_hash']
    (expires_at) [name: 'idx_doc_token_expiry']
    (document_id) [name: 'idx_doc_token_doc']
  }
}

Table worker_gate_pass {
  // Temporary (TGP) / Permanent (PGP) site access permits.
  // From 'workplace compliance' 10-17, auto-sourced from contractor gate pass.
  // Each pass is time-bound (start/end date), has its own status & number;
  // a worker can hold multiple passes over time (child table, not flat cols).
  id bigint [pk, increment]
  worker_id bigint [not null, ref: > users.id]
  site_id bigint [ref: > site.id, note: "site the pass grants access to"]
  gate_pass_type varchar(20) [not null, note: "TGP (Temporary), PGP (Permanent)"]
  gate_pass_no varchar(40) [not null]
  status varchar(20) [not null, default: "ACTIVE", note: "ACTIVE, EXPIRED, REVOKED, PENDING"]
  start_date date
  end_date date [note: "time-bound validity"]
  issued_by bigint [ref: > users.id, note: "contractor who issued"]
  source varchar(20) [not null, default: "CONTRACTOR_GATE_PASS", note: "CONTRACTOR_GATE_PASS, MANUAL, SYSTEM"]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    (worker_id, gate_pass_type, gate_pass_no) [unique]
    (worker_id) [name: 'idx_gate_pass_worker']
    (worker_id, gate_pass_type) [name: 'idx_gate_pass_type']
  }
}
