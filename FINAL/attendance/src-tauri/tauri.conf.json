{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BSS Attendance",
  "version": "1.5.10",
  "identifier": "com.bharatshramsetu.attendance",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "BSS Attendance",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBNzY4REQ5NzEyMENDNTEKUldSUnpDQngyWTEyK2huWGtNTVQvcXVOUFlDVDZqbSs2ZTNldUp4Ly9paHpucm5oaDRqZm91SnAK",
      "endpoints": [
        "https://login.bharatshramsetu.com/downloads/attendance/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/attendance-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
