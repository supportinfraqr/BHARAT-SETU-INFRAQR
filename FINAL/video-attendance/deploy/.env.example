# Postgres password for the pipeline's own database (REQUIRED).
BTP_PG_PASSWORD=

# Shared secret the BSS backend sends as X-Attendance-Token (REQUIRED).
CONTROL_TOKEN=

# Optional comma-separated IP allowlist for the control API (e.g. the BSS prod
# public IP). Empty = allow any client that has the token.
ALLOWED_CLIENTS=

# Fallback camera source used when a /session/start request has none. While
# there are no cameras this can be a bundled test video (looped by the
# controller) or any rtsp:// URL.
DEFAULT_SOURCE=tests/assets/cctv_sim.mp4
