# BSS Backend environment — copy to .env and adjust. DO NOT COMMIT .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Kolkata

# PostgreSQL (FINAL/Db schema) behind the BSS pgpool -> postgres pool.
BSS_PG_DB=bss_final
BSS_PG_USER=bss
BSS_PG_PASSWORD=Bss2026!pg
BSS_PG_HOST=127.0.0.1
BSS_PG_PORT=5432
BSS_PG_CONN_MAX_AGE=60
BSS_PG_CONNECT_TIMEOUT=5

# JWT
BSS_JWT_ACCESS_MIN=60
BSS_JWT_REFRESH_DAYS=7

# CORS
BSS_CORS_ALLOW_ALL=True

# DigiLocker OAuth2 (match EesassinErp live creds in production)
DIGILOCKER_CLIENT_ID=MS53AA158D
DIGILOCKER_CLIENT_SECRET=727f64249a2d50ac2019
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/digilocker/callback/
DIGILOCKER_SESSION_TTL_MIN=10
