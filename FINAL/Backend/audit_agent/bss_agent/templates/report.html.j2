<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BSS Compliance Audit — {{ m.meta.report_no }}</title>
<style>
{{ fontfaces|safe }}
:root{
  --navy:{{ c.primary }}; --navy-2:#11496F; --navy-3:#082C45; --saffron:{{ c.secondary }}; --green:{{ c.accent }};
  --accent:#1D6FB8; --accent-soft:{{ c.primary_soft }}; --line:#D6DEE8; --bg:#F3F6F9; --card:#fff;
  --text:{{ c.text_dark }}; --muted:{{ c.text_muted }};
  --s-c:{{ sc['Complied'] }}; --s-pc:{{ sc['Partially Complied'] }}; --s-nc:{{ sc['Non-Complied'] }}; --s-dna:{{ sc['Document Not Available'] }};
  --s-nv:{{ sc['Not Verifiable'] }}; --s-na:{{ sc['Not Applicable'] }}; --s-nau:{{ sc['Not Auditable'] }};
  --b-c:{{ ss['Complied'] }}; --b-pc:{{ ss['Partially Complied'] }}; --b-nc:{{ ss['Non-Complied'] }}; --b-dna:{{ ss['Document Not Available'] }};
  --b-nv:{{ ss['Not Verifiable'] }}; --b-na:{{ ss['Not Applicable'] }}; --b-nau:{{ ss['Not Auditable'] }};
  --r-critical:{{ rc['Critical'] }}; --r-high:{{ rc['High'] }}; --r-medium:#B5651D; --r-low:#9A4B47;
  --radius:10px; --shadow:0 2px 10px rgba(11,60,93,.08);
  --head:"Poppins","Segoe UI",Roboto,Arial,sans-serif; --body:"Inter","Segoe UI",Roboto,Arial,sans-serif;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{margin:0;font-family:var(--body);background:var(--bg);color:var(--text);font-size:13.5px;line-height:1.5;}
a{color:inherit;}

/* ============ COVER / HEADER ============ */
.cover{background:var(--navy);color:#fff;position:relative;overflow:hidden;padding:40px 40px 34px;}
.cover::before{content:"";position:absolute;right:-180px;bottom:-260px;width:720px;height:720px;border-radius:50%;
  box-shadow:0 0 0 46px rgba(255,255,255,.035),0 0 0 92px rgba(255,255,255,.03),0 0 0 138px rgba(255,255,255,.025),0 0 0 184px rgba(255,255,255,.02);}
.cover .brandrow{display:flex;gap:20px;align-items:center;position:relative;}
.cover .plate{width:84px;height:92px;background:#fff;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.cover .plate img{width:64px;height:auto;}
.cover .bname{font-family:var(--head);font-weight:700;font-size:30px;letter-spacing:-.4px;line-height:1.1;}
.cover .btag{font-size:14px;opacity:.82;margin-top:4px;}
.cover .bkick{font-weight:800;font-size:12px;letter-spacing:.06em;color:var(--saffron);margin-top:6px;}
.cover h1{font-family:var(--head);font-weight:700;font-size:44px;line-height:1.08;margin:44px 0 10px;letter-spacing:-.6px;position:relative;max-width:900px;}
.cover .sub{font-size:17px;opacity:.86;position:relative;}
.cover .pills{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px;position:relative;}
.pill{display:inline-block;border-radius:999px;padding:6px 16px;font-weight:800;font-size:12.5px;letter-spacing:.04em;}
.pill.saffron{background:var(--saffron);color:#1A1A1A;} .pill.white{background:#fff;color:var(--navy);} .pill.green{background:var(--green);color:#fff;}
.cover .who{margin-top:46px;position:relative;}
.cover .who .cn{font-family:var(--head);font-weight:600;font-size:24px;}
.cover .who .cm{opacity:.8;font-size:14px;margin-top:4px;}
.tricolour{height:6px;background:linear-gradient(90deg,var(--saffron),#fff 50%,var(--green));}
.metaline{background:#fff;border-bottom:1px solid var(--line);padding:10px 40px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:12px;color:var(--muted);}
.metaline b{color:var(--navy);} .conf{background:#FBE9E9;color:var(--r-high);font-weight:800;font-size:10px;letter-spacing:.08em;padding:2px 8px;border-radius:4px;}

/* ============ TOOLBAR ============ */
.toolbar{position:sticky;top:0;z-index:80;background:rgba(255,255,255,.97);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);
  padding:10px 32px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.toolbar .spacer{flex:1;}
button,.btn{font-family:inherit;font-size:12.5px;font-weight:700;border-radius:7px;padding:7px 14px;cursor:pointer;border:1px solid var(--line);
  background:#fff;color:var(--navy);transition:.15s;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
button:hover,.btn:hover{background:var(--accent-soft);border-color:var(--navy);}
.btn.primary{background:var(--navy);border-color:var(--navy);color:#fff;} .btn.primary:hover{background:var(--navy-2);}
.btn.saffron{background:var(--saffron);border-color:var(--saffron);color:#1A1A1A;}
.toolbar select,.toolbar input{font-family:inherit;font-size:12.5px;padding:7px 10px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--text);}
.toolbar input{min-width:230px;}
#liveStatus{font-size:12px;color:var(--muted);font-weight:700;}

/* ============ LAYOUT ============ */
main{padding:22px 32px 60px;max-width:1500px;margin:0 auto;}
section.block{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:18px;overflow:hidden;}
.block > h2,.areahead{margin:0;background:var(--navy);color:#fff;font-family:var(--head);font-size:13px;font-weight:600;letter-spacing:.05em;
  text-transform:uppercase;padding:11px 18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.num{background:rgba(255,255,255,.16);border-radius:5px;padding:1px 8px;font-size:11.5px;font-weight:800;}
.sec-meta{margin-left:auto;font-size:11px;font-weight:700;letter-spacing:.03em;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.3);
  padding:2px 10px;border-radius:999px;}
.scoredot{width:34px;height:34px;border-radius:50%;background:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:10.5px;font-weight:800;}
.section-body{padding:16px 18px;}
h3.sub{font-family:var(--head);font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin:22px 0 10px;padding-bottom:6px;border-bottom:1px dashed var(--line);font-weight:600;}
h3.sub:first-child{margin-top:0;}

/* ============ CARDS ============ */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;}
.card{border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px;background:#fff;border-left:5px solid var(--navy);}
.card .card-label{font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:800;}
.card .card-value{font-family:var(--head);font-size:24px;font-weight:700;line-height:1.15;margin-top:3px;color:var(--navy);word-break:break-word;}
.card .card-value.sm{font-size:13.5px;line-height:1.3;} .card .card-foot{font-size:11px;color:var(--muted);margin-top:3px;}
.c-green{border-left-color:var(--s-c)!important;} .c-green .card-value{color:var(--s-c);}
.c-amber{border-left-color:var(--s-pc)!important;} .c-amber .card-value{color:var(--s-pc);}
.c-red{border-left-color:var(--s-nc)!important;} .c-red .card-value{color:var(--s-nc);}
.c-purple{border-left-color:var(--s-dna)!important;} .c-purple .card-value{color:var(--s-dna);}
.c-grey{border-left-color:var(--s-nv)!important;} .c-grey .card-value{color:var(--s-nv);}
.c-saffron{border-left-color:var(--saffron)!important;}

/* ============ EXEC ============ */
.exec{display:grid;grid-template-columns:260px 1fr;gap:26px;align-items:center;}
.statlist{width:100%;border-collapse:collapse;font-size:12.5px;}
.statlist td{padding:5px 2px;border-bottom:1px dashed var(--line);} .statlist td:first-child{color:var(--muted);font-weight:700;}
.statlist td:last-child{text-align:right;font-weight:800;}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 6px;}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:4px 12px;font-size:11.5px;font-weight:800;border:1px solid;}
.chip::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor;}
.callout{border-left:5px solid var(--navy);background:var(--accent-soft);padding:11px 15px;border-radius:7px;font-size:12.8px;margin:10px 0;}
.callout.danger{border-left-color:var(--s-nc);background:var(--b-nc);} .callout.warn{border-left-color:var(--saffron);background:#FDF1D8;}
.callout.teal{border-left-color:#0D6E6E;background:#E3F4F4;} .callout.purple{border-left-color:var(--s-dna);background:var(--b-dna);}
.callout ul{margin:4px 0 0;padding-left:18px;} .callout li{margin:3px 0;}
.lead{font-size:13.6px;text-align:justify;}
.src{font-size:11px;color:var(--muted);}

/* ============ CATEGORY CARDS ============ */
.cat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;margin-bottom:14px;}
.cat-card{border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px;background:#fff;border-left:6px solid var(--navy);}
.cat-card.lv-red{border-left-color:var(--s-nc);} .cat-card.lv-amber{border-left-color:var(--s-pc);} .cat-card.lv-green{border-left-color:var(--s-c);}
.cc-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
.cc-title{font-family:var(--head);font-size:14px;font-weight:600;color:var(--navy);} .cc-sub{font-size:11px;color:var(--muted);margin-top:2px;font-weight:600;}
.cc-score{font-family:var(--head);font-size:24px;font-weight:700;line-height:1;text-align:right;}
.cc-score small{display:block;font-family:var(--body);font-size:9.5px;font-weight:800;letter-spacing:.06em;color:var(--muted);margin-top:2px;}
.sc-green{color:var(--s-c);} .sc-amber{color:var(--s-pc);} .sc-red{color:var(--s-nc);} .sc-na{color:var(--muted);}
.cc-badges{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px;}
.mini{font-size:10.5px;font-weight:800;padding:3px 8px;border-radius:5px;border:1px solid;}
.bar{height:7px;border-radius:999px;background:#E6EBF0;overflow:hidden;margin-top:6px;} .bar > i{display:block;height:100%;}
.bar-label{display:flex;justify-content:space-between;font-size:10.5px;color:var(--muted);font-weight:700;margin-top:10px;}

/* ============ NAV ============ */
.nav-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:8px;}
.nav-grid a{display:flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:8px;padding:8px 10px;text-decoration:none;font-size:12.3px;
  font-weight:600;color:var(--navy);background:#fff;} .nav-grid a:hover{border-color:var(--navy);background:var(--accent-soft);}
.nav-grid .n{background:var(--navy);color:#fff;border-radius:4px;font-size:10.5px;font-weight:800;padding:1px 6px;}
.nav-grid .s{margin-left:auto;font-weight:800;font-size:11.5px;}

/* ============ TABLES ============ */
.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;}
table{width:100%;border-collapse:collapse;font-size:12px;background:#fff;}
thead th{background:var(--navy);color:#fff;text-align:left;padding:9px 10px;font-size:10px;letter-spacing:.05em;text-transform:uppercase;font-weight:800;
  white-space:nowrap;position:sticky;top:0;z-index:2;}
tbody td{padding:8px 10px;border-top:1px solid var(--line);vertical-align:top;}
tbody tr:nth-child(even) > td{background:#FAFBFD;}
td.center,th.center{text-align:center;} td.nowrap{white-space:nowrap;} td.idc{font-weight:800;color:var(--accent);white-space:nowrap;}
td.name{font-weight:700;color:var(--navy);} td.num{font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;}
tr.total td{background:var(--navy)!important;color:#fff;font-weight:800;}
.badge{display:inline-block;padding:2px 9px;border-radius:999px;font-size:10.5px;font-weight:800;letter-spacing:.02em;white-space:nowrap;border:1px solid;}
.risk{display:inline-block;padding:2px 9px;border-radius:999px;font-size:10.5px;font-weight:800;white-space:nowrap;}
.risk-Critical{background:var(--r-critical);color:#fff;} .risk-High{background:#FBE9E9;color:var(--r-high);border:1px solid #F2C0BC;}
.risk-Medium{background:#FDF1D8;color:var(--r-medium);border:1px solid #F0D19A;} .risk-Low{background:#F7ECEB;color:var(--r-low);border:1px solid #E8CFCD;}
.risk-None{color:var(--muted);}
.offroll{background:#FBE9E9;color:var(--r-high);border:1px solid #F2C0BC;border-radius:999px;font-size:10px;font-weight:800;padding:1px 7px;margin-left:4px;}

/* ============ VIEW TABS ============ */
.viewtabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;border-bottom:2px solid var(--line);}
.viewtabs button{border-radius:8px 8px 0 0;padding:10px 18px;font-size:13px;font-weight:800;}
.viewtabs button.active{background:var(--navy);color:#fff;border-color:var(--navy);}
.viewpane{display:none;} .viewpane.active{display:block;}
.entity-banner{display:flex;gap:18px;flex-wrap:wrap;align-items:center;background:#FBFCFE;border:1px solid var(--line);border-left:5px solid var(--navy);
  border-radius:8px;padding:13px 16px;margin-bottom:14px;}
.eb-avatar{width:48px;height:48px;border-radius:50%;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:17px;}
.eb-meta{flex:1;min-width:220px;} .eb-name{font-family:var(--head);font-size:15px;font-weight:600;color:var(--navy);} .eb-sub{font-size:12px;color:var(--muted);}
.eb-score{font-family:var(--head);font-size:26px;font-weight:700;text-align:right;}
.eb-score small{display:block;font-family:var(--body);font-size:10.5px;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:.06em;}
.chart-bars{display:flex;flex-direction:column;gap:8px;}
.chart-bar-row{display:flex;align-items:center;gap:10px;font-size:12px;}
.cb-label{flex:0 0 220px;font-weight:700;color:var(--navy);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.cb-bar{flex:1;height:16px;border-radius:999px;background:#E6EBF0;overflow:hidden;} .cb-bar > i{display:block;height:100%;}
.cb-val{flex:0 0 60px;text-align:right;font-weight:800;color:var(--navy);}

/* ============ AREAS ============ */
.area{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);margin-bottom:14px;overflow:hidden;scroll-margin-top:70px;}
.area > summary{list-style:none;cursor:pointer;} .area > summary::-webkit-details-marker{display:none;}
.area > summary .areahead::before{content:"▸";font-size:12px;opacity:.8;} .area[open] > summary .areahead::before{content:"▾";}
.objective{margin:12px 16px;padding:9px 13px;background:var(--accent-soft);border-left:4px solid var(--navy);border-radius:6px;font-size:12.8px;}
.objective b{color:var(--navy);}
.lines{margin:0 16px 16px;}
.lines td.step b{color:var(--text);} .lines .cid{font-size:10.5px;color:var(--muted);}
tr.subrow td{background:#FAFBFC!important;font-size:11.5px;} tr.subrow td.step{padding-left:22px;color:var(--muted);}
tr.detail td{background:#F6F8FB!important;padding:10px 14px;}
.ev-toggle{font-size:11px;padding:3px 8px;}
.ai{font-size:10px;font-weight:800;color:var(--green);} .diff{font-size:11px;color:var(--s-dna);margin-top:4px;}
.mini-table th{background:var(--navy-2);font-size:9.5px;} .mini-table td{font-size:11.3px;padding:6px 8px;}

footer.report-foot{text-align:center;font-size:11.5px;color:var(--muted);padding:22px;border-top:1px solid var(--line);background:#fff;}
footer .tricolour{margin:-22px -22px 18px;}
.hidden{display:none!important;}

/* ============ PRINT ============ */
@media print{
  body{background:#fff;font-size:9.5px;}
  .toolbar,.no-print,.ev-toggle{display:none!important;}
  main{padding:0;max-width:none;}
  .cover{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  section.block,.area{box-shadow:none;break-inside:auto;}
  .block > h2,.areahead,thead th,tr.total td,.n{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  .viewpane{display:block!important;} .viewtabs{display:none;}
  details.area{display:block;} details.area > *{display:block;}
}
@media (max-width:760px){
  .cover{padding:28px 16px;} .cover h1{font-size:30px;} .toolbar,main,.metaline{padding-left:16px;padding-right:16px;}
  .exec{grid-template-columns:1fr;} .cb-label{flex-basis:120px;}
}
</style>
</head>
<body>
{% macro badge(s) -%}
{%- set k = {'Complied':'c','Partially Complied':'pc','Non-Complied':'nc','Document Not Available':'dna','Not Verifiable':'nv','Not Applicable':'na','Not Auditable':'nau'}.get(s) -%}
{%- if k %}<span class="badge" style="background:var(--b-{{k}});color:var(--s-{{k}});border-color:var(--s-{{k}})">{{ s }}</span>{% else %}<span class="src">—</span>{% endif -%}
{%- endmacro %}
{% macro risk(r) -%}{% if r and r != 'None' %}<span class="risk risk-{{ r }}">{{ r }}</span>{% else %}<span class="risk risk-None">—</span>{% endif %}{%- endmacro %}
{% macro scls(p) -%}{% if p is none %}sc-na{% elif p >= 80 %}sc-green{% elif p >= 50 %}sc-amber{% else %}sc-red{% endif %}{%- endmacro %}
{% macro scol(p) -%}{% if p is none %}var(--muted){% elif p >= 80 %}var(--s-c){% elif p >= 50 %}var(--s-pc){% else %}var(--s-nc){% endif %}{%- endmacro %}

<!-- ============================ COVER ============================ -->
<header class="cover">
  <div class="brandrow">
    <div class="plate"><img src="{{ logo }}" alt="BharatShramSetu logo"></div>
    <div>
      <div class="bname">{{ m.meta.brand.name }}</div>
      <div class="btag">{{ m.meta.brand.tagline }}</div>
      <div class="bkick">COMPLIANCE INTELLIGENCE · AI-ASSISTED DOCUMENT AUDIT</div>
    </div>
  </div>
  <h1>Labour &amp; Contractor Compliance Audit Report</h1>
  <div class="sub">Contractor submission audited against worker ground truth — every field, every worker</div>
  <div class="pills">
    <span class="pill saffron">WAGE MONTH {{ m.meta.wage_month|upper }}</span>
    <span class="pill white">{{ m.kpi.total }} CHECKPOINTS AUDITED</span>
    <span class="pill white">{{ m.kpi.subchecks }} SUB-CHECKS</span>
    {% if m.meta.mode == 'deepseek' %}<span class="pill green">{{ m.meta.ai_label|upper }} AI AUDIT</span>{% endif %}
  </div>
  <div class="who">
    <div class="cn">{{ m.meta.contractor }}</div>
    <div class="cm">Principal employer: {{ m.meta.principal_employer }} &nbsp;·&nbsp; Site: {{ m.meta.site_short }}</div>
  </div>
</header>
<div class="tricolour"></div>
<div class="metaline">
  <span>Report <b>{{ m.meta.report_no }}</b> · Generated {{ m.meta.generated }}</span>
  <span>{{ m.meta.engine }}</span>
  <span class="conf">CONFIDENTIAL</span>
</div>

<!-- ============================ TOOLBAR ============================ -->
<div class="toolbar no-print">
  {% if pdf_name %}<a class="btn primary" href="{{ pdf_name }}" download>⬇ Summary PDF</a>{% endif %}
  {% if xlsx_name %}<a class="btn saffron" href="{{ xlsx_name }}" download>⬇ Detailed audit workbook (Excel)</a>{% endif %}
  <button onclick="window.print()">🖨 Print</button>
  <button onclick="toggleAll(true)">▾ Expand all</button>
  <button onclick="toggleAll(false)">▸ Collapse all</button>
  <input type="search" id="q" placeholder="Search worker, item, observation…" aria-label="Search">
  <select id="fStatus" aria-label="Filter by status"><option value="">All statuses</option>
    {% for s in m.statuses %}<option>{{ s }}</option>{% endfor %}</select>
  <select id="fRisk" aria-label="Filter by risk"><option value="">All risks</option>
    {% for r in ['Critical','High','Medium','Low'] %}<option>{{ r }}</option>{% endfor %}</select>
  <span class="spacer"></span>
  <span id="liveStatus">{{ m.kpi.total }} checkpoints</span>
</div>

<main>
<!-- ============================ 01 CONTROL ============================ -->
<section class="block" id="control">
  <h2><span class="num">01</span> Report Control Sheet</h2>
  <div class="section-body">
    <div class="cards">
      <div class="card"><div class="card-label">Principal Employer</div><div class="card-value sm">{{ m.meta.principal_employer }}</div><div class="card-foot">{{ m.meta.site_short }}</div></div>
      <div class="card"><div class="card-label">Contractor</div><div class="card-value sm">{{ m.meta.contractor }}</div><div class="card-foot">{{ m.meta.contractor_address or m.meta.nature_of_work }}</div></div>
      <div class="card"><div class="card-label">Site / Location</div><div class="card-value sm">{{ m.meta.site_short }}</div><div class="card-foot">{{ m.meta.site }}</div></div>
      <div class="card"><div class="card-label">Audit Period</div><div class="card-value sm">{{ m.meta.period }}</div><div class="card-foot">Wage month {{ m.meta.wage_month }}</div></div>
      <div class="card"><div class="card-label">Audit Date</div><div class="card-value sm">{{ m.meta.audit_date }}</div><div class="card-foot">{{ m.meta.auditor }}</div></div>
      <div class="card"><div class="card-label">Registrations</div><div class="card-value sm" style="font-family:var(--body);font-size:12px">{% for r in m.meta.registrations.split(' · ') %}{{ r }}<br>{% endfor %}</div><div class="card-foot">As read from the submission</div></div>
      <div class="card"><div class="card-label">Workers in Scope</div><div class="card-value">{{ m.kpi.on_rolls }}</div><div class="card-foot">On rolls · {{ m.kpi.gt_missing }} ground-truth worker(s) off rolls</div></div>
      <div class="card"><div class="card-label">Overall Compliance</div><div class="card-value" style="color:{{ scol(m.kpi.score) }}">{{ m.kpi.score|round|int }}%</div><div class="card-foot">Weighted score</div></div>
    </div>
  </div>
</section>

<!-- ============================ 02 EXECUTIVE ============================ -->
<section class="block" id="executive">
  <h2><span class="num">02</span> Executive Summary <span class="sec-meta">Overall risk: {{ m.kpi.overall_risk|upper }}</span></h2>
  <div class="section-body">
    <div class="exec">
      <div>{{ gauge|safe }}</div>
      <table class="statlist">
        <tr><td>Overall Risk Rating</td><td style="color:var(--r-high)">{{ m.kpi.overall_risk|upper }}</td></tr>
        <tr><td>Complied</td><td style="color:var(--s-c)">{{ m.kpi.counts['Complied'] }}</td></tr>
        <tr><td>Partially Complied</td><td style="color:var(--s-pc)">{{ m.kpi.counts['Partially Complied'] }}</td></tr>
        <tr><td>Non-Complied</td><td style="color:var(--s-nc)">{{ m.kpi.counts['Non-Complied'] }}</td></tr>
        <tr><td>Document Not Available</td><td style="color:var(--s-dna)">{{ m.kpi.counts['Document Not Available'] }}</td></tr>
        <tr><td>N/A · Not Verifiable · Not Auditable</td><td style="color:var(--s-nv)">{{ m.kpi.other }}</td></tr>
        <tr><td>Discrepancy Flags</td><td style="color:var(--r-high)">{{ m.kpi.flags }}</td></tr>
        <tr><td>Workers Off the Rolls</td><td style="color:var(--r-high)">{{ m.kpi.gt_missing }}</td></tr>
        <tr><td>Indicative Exposure (wage month)</td><td style="color:var(--r-high)">₹{{ '{:,}'.format(m.kpi.exposure) }}</td></tr>
      </table>
    </div>
    <div class="chips">
      {% for s,k in [('Complied','c'),('Partially Complied','pc'),('Non-Complied','nc'),('Document Not Available','dna')] %}
      <span class="chip" style="background:var(--b-{{k}});color:var(--s-{{k}});border-color:var(--s-{{k}})">{{ s }} {{ m.kpi.counts[s] }}</span>{% endfor %}
      <span class="chip" style="background:var(--b-nv);color:var(--s-nv);border-color:var(--s-nv)">N/A · Not Verifiable · Not Auditable {{ m.kpi.other }}</span>
    </div>
    <h3 class="sub">Summary</h3>
    <p class="lead">{{ m.narrative.summary }}</p>
    <h3 class="sub">Key messages</h3>
    <div class="callout danger"><ul>{% for x in m.narrative.messages %}<li>{{ x }}</li>{% endfor %}</ul></div>
    <div class="callout warn"><b>Auditor's opinion.</b> {{ m.narrative.opinion }}</div>
    <div class="src">Narrative: {{ m.narrative.source }} · Verdicts: {{ m.meta.engine }}</div>
  </div>
</section>

<!-- ============================ 03 CATEGORIES ============================ -->
<section class="block" id="categories">
  <h2><span class="num">03</span> Point-wise Compliance Status by Category</h2>
  <div class="section-body">
    <div class="callout">The {{ m.kpi.total }} checkpoints are grouped into {{ m.categories|length }} audit categories. Each category shows its own compliance score,
      the count of checkpoints at each status, and the number of flags raised. Line items follow in Section 05.</div>
    <div class="cat-grid">
    {% for k in m.categories %}
      <div class="cat-card lv-{{ k.band }}">
        <div class="cc-head"><div><div class="cc-title">{{ k.short }}</div><div class="cc-sub">{{ k.total }} checkpoints · {{ k.flags }} flags</div></div>
          <div class="cc-score {{ scls(k.score) }}">{{ k.score if k.score is not none else '—' }}%<small>SCORE</small></div></div>
        <div class="cc-badges">
          <span class="mini" style="background:var(--b-c);color:var(--s-c)">C {{ k.c }}</span><span class="mini" style="background:var(--b-pc);color:var(--s-pc)">PC {{ k.pc }}</span>
          <span class="mini" style="background:var(--b-nc);color:var(--s-nc)">NC {{ k.nc }}</span><span class="mini" style="background:var(--b-dna);color:var(--s-dna)">DNA {{ k.dna }}</span>
          <span class="mini" style="background:var(--b-nv);color:var(--s-nv)">Other {{ k.other }}</span></div>
        <div class="bar-label"><span>Compliance</span><span>{{ k.score if k.score is not none else '—' }}%</span></div>
        <div class="bar"><i style="width:{{ k.score or 0 }}%;background:{{ scol(k.score) }}"></i></div>
      </div>
    {% endfor %}
    </div>
    <h3 class="sub">Category scorecard</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>Category</th><th class="center">C</th><th class="center">PC</th><th class="center">NC</th><th class="center">DNA</th><th class="center">Other</th><th class="center">Total</th><th class="center">Flags</th><th class="center">Score</th></tr></thead>
      <tbody>
      {% for k in m.categories %}<tr><td class="name">{{ k.name }}</td><td class="center" style="color:var(--s-c);font-weight:800">{{ k.c }}</td>
        <td class="center" style="color:var(--s-pc);font-weight:800">{{ k.pc }}</td><td class="center" style="color:var(--s-nc);font-weight:800">{{ k.nc }}</td>
        <td class="center" style="color:var(--s-dna);font-weight:800">{{ k.dna }}</td><td class="center">{{ k.other }}</td><td class="center"><b>{{ k.total }}</b></td>
        <td class="center"><b>{{ k.flags }}</b></td><td class="center" style="color:{{ scol(k.score) }};font-weight:800">{{ k.score if k.score is not none else '—' }}%</td></tr>{% endfor %}
      {% set t = m.category_totals %}<tr class="total"><td>TOTAL</td><td class="center">{{ t.c }}</td><td class="center">{{ t.pc }}</td><td class="center">{{ t.nc }}</td><td class="center">{{ t.dna }}</td>
        <td class="center">{{ t.other }}</td><td class="center">{{ t.total }}</td><td class="center">{{ t.flags }}</td><td class="center">{{ t.score }}%</td></tr>
      </tbody></table></div>
  </div>
</section>

<!-- ============================ QUICK NAV ============================ -->
<section class="block" id="nav">
  <h2>Quick navigation — {{ m.areas|length }} audit areas <span class="sec-meta">{{ m.kpi.total }} line items</span></h2>
  <div class="section-body"><div class="nav-grid">
    {% for a in m.areas %}<a href="#area-{{ a.no }}" onclick="openArea({{ a.no }})"><span class="n">{{ '%02d' % a.no }}</span>{{ a.name }}
      <span class="s" style="color:{{ scol(a.score) }}">{{ (a.score|string + '%') if a.score is not none else 'n/a' }}</span></a>{% endfor %}
  </div></div>
</section>

<!-- ============================ 04 VIEWS ============================ -->
<section class="block" id="views">
  <h2><span class="num">04</span> Compliance Views — Worker / Contractor / Site / State / Summary</h2>
  <div class="section-body">
    <div class="viewtabs no-print">
      <button class="active" data-view="worker">👤 Worker-wise</button>
      <button data-view="contractor">🏗 Contractor Comparison</button>
      <button data-view="site">📍 Site &amp; State Analysis</button>
      <button data-view="summary">📊 Summary Report</button>
    </div>

    <div class="viewpane active" id="view-worker">
      <div class="callout teal"><b>Worker-wise compliance report:</b> each row is one worker — on the contractor's rolls, then ground-truth workers missing from
        the rolls. Each parameter column is the worst status of that worker's findings in the related catalogue rows (hover a heading for its scope); '—' = not applicable.</div>
      <div class="entity-banner"><div class="eb-avatar">{{ m.kpi.on_rolls }}</div>
        <div class="eb-meta"><div class="eb-name">{{ m.kpi.on_rolls }} workers audited on the rolls · {{ m.kpi.gt_missing }} off the rolls</div>
          <div class="eb-sub">Applicability derived from wage, age, PF / ESI membership, overtime, joining and leaving dates</div></div>
        <div class="eb-score" style="color:{{ scol(m.avg_worker) }}">{{ m.avg_worker if m.avg_worker is not none else '—' }}%<small>Avg worker score</small></div></div>
      <div class="table-wrap"><table class="filterable" style="min-width:1700px">
        <thead><tr><th>Worker ID</th><th>Worker</th><th>Designation</th><th>DOJ</th><th>Wage (₹)</th><th>Gender</th><th>UAN</th><th>ESIC IP</th>
          {% for p in m.worker_params %}<th class="center" title="{{ p.desc }}">{{ p.label }}</th>{% endfor %}<th class="center">Score</th><th>Observation</th></tr></thead>
        <tbody>
        {% for w in m.workers %}<tr data-status="{{ w.params.values()|join('|') }}" data-risk="{{ w.risk }}">
          <td class="idc">{{ w.code }}</td><td class="name">{{ w.worker }}{% if not w.on_rolls %}<span class="offroll">Off roll</span>{% endif %}</td>
          <td>{{ w.designation }}</td><td class="nowrap">{{ w.doj or '—' }}</td><td class="num">{{ w.wage }}</td><td class="center">{{ w.gender or '—' }}</td>
          <td style="font-size:11px">{{ w.uan or '—' }}</td><td style="font-size:11px">{{ w.esic or '—' }}</td>
          {% for p in m.worker_params %}<td class="center">{{ badge(w.params[p.key]) }}</td>{% endfor %}
          <td class="center" style="color:{{ scol(w.pct) }};font-weight:800">{{ w.pct if w.pct is not none else '—' }}%</td>
          <td style="font-size:11px;min-width:260px">{{ w.obs or 'No flagged finding.' }}</td></tr>{% endfor %}
        </tbody></table></div>
    </div>

    <div class="viewpane" id="view-contractor">
      <div class="callout warn"><b>Contractor comparison:</b> this audit covers one contractor. When the BSS platform aggregates several audits the same scorecard
        compares contractors side by side.</div>
      {% set e = m.contractors[0] %}
      <div class="cards" style="margin-bottom:14px">
        <div class="card c-green"><div class="card-label">Contractor</div><div class="card-value sm">{{ e.name }}</div><div class="card-foot">{{ e.workers }} workers · {{ e.off_rolls }} off rolls</div></div>
        <div class="card"><div class="card-label">Compliance score</div><div class="card-value" style="color:{{ scol(e.score) }}">{{ e.score }}%</div><div class="card-foot">Weighted</div></div>
        <div class="card c-red"><div class="card-label">Total exposure</div><div class="card-value">₹{{ '{:,}'.format(e.exposure) }}</div><div class="card-foot">Indicative, wage month</div></div>
        <div class="card c-red"><div class="card-label">Risk</div><div class="card-value">{{ e.risk|upper }}</div><div class="card-foot">From unresolved findings</div></div>
      </div>
      <h3 class="sub">Contractor scorecard</h3>
      <div class="table-wrap"><table style="min-width:1400px"><thead><tr><th>Contractor</th><th class="center">Workers</th><th class="center">Off rolls</th>
        {% for p in m.worker_params %}<th class="center" title="{{ p.desc }}">{{ p.label }}</th>{% endfor %}<th class="center">Compliance %</th><th class="center">Exposure ₹</th><th class="center">Risk</th></tr></thead>
        <tbody>{% for e in m.contractors %}<tr><td class="name">{{ e.name }}</td><td class="center">{{ e.workers }}</td><td class="center">{{ e.off_rolls }}</td>
          {% for p in m.worker_params %}<td class="center">{{ badge(e.params[p.key]) }}</td>{% endfor %}
          <td class="center" style="color:{{ scol(e.score) }};font-weight:800">{{ e.score }}%</td><td class="center" style="color:var(--r-high);font-weight:800">₹{{ '{:,}'.format(e.exposure) }}</td>
          <td class="center">{{ risk(e.risk) }}</td></tr>{% endfor %}</tbody></table></div>
      <h3 class="sub">Contractor comparison chart</h3>
      <div class="chart-bars">{% for e in m.contractors %}<div class="chart-bar-row"><div class="cb-label">{{ e.name }}</div>
        <div class="cb-bar"><i style="width:{{ e.score }}%;background:{{ scol(e.score) }}"></i></div><div class="cb-val">{{ e.score }}%</div></div>{% endfor %}</div>
    </div>

    <div class="viewpane" id="view-site">
      <div class="callout purple"><b>Site &amp; State analysis:</b> compliance grouped by site and state — for comparing geographies and allocating remediation.</div>
      {% for label, ents in [('Site', m.sites), ('State', m.states)] %}
      <h3 class="sub">{{ label }}-wise scorecard</h3>
      <div class="table-wrap"><table><thead><tr><th>{{ label }}</th>{% if label == 'Site' %}<th>State</th>{% endif %}<th class="center">Contractors</th><th class="center">Workers</th>
        <th class="center">Complied</th><th class="center">Partial</th><th class="center">Non-Complied</th><th class="center">DNA</th><th class="center">Compliance %</th><th class="center">Risk</th></tr></thead>
        <tbody>{% for e in ents %}<tr><td class="name">{{ e.name }}</td>{% if label == 'Site' %}<td>{{ e.state }}</td>{% endif %}<td class="center">{{ e.contractors }}</td><td class="center">{{ e.workers }}</td>
          <td class="center" style="color:var(--s-c);font-weight:800">{{ e.c }}</td><td class="center" style="color:var(--s-pc);font-weight:800">{{ e.pc }}</td>
          <td class="center" style="color:var(--s-nc);font-weight:800">{{ e.nc }}</td><td class="center" style="color:var(--s-dna);font-weight:800">{{ e.dna }}</td>
          <td class="center" style="color:{{ scol(e.score) }};font-weight:800">{{ e.score }}%</td><td class="center">{{ risk(e.risk) }}</td></tr>{% endfor %}</tbody></table></div>
      <div class="chart-bars" style="margin-top:10px">{% for e in ents %}<div class="chart-bar-row"><div class="cb-label">{{ e.name }}</div>
        <div class="cb-bar"><i style="width:{{ e.score }}%;background:{{ scol(e.score) }}"></i></div><div class="cb-val">{{ e.score }}%</div></div>{% endfor %}</div>
      {% endfor %}
    </div>

    <div class="viewpane" id="view-summary">
      <div class="callout purple"><b>Summary report:</b> consolidated view of overall compliance, category breakdown, top risks, material exposure and recommended actions.</div>
      <h3 class="sub">Overall compliance summary</h3>
      <div class="cards">
        <div class="card"><div class="card-label">Overall compliance</div><div class="card-value" style="color:{{ scol(m.kpi.score) }}">{{ m.kpi.score|round|int }}%</div><div class="card-foot">Weighted score</div></div>
        <div class="card c-red"><div class="card-label">Overall risk</div><div class="card-value">{{ m.kpi.overall_risk|upper }}</div><div class="card-foot">From unresolved findings</div></div>
        <div class="card c-green"><div class="card-label">Complied</div><div class="card-value">{{ m.kpi.counts['Complied'] }}</div><div class="card-foot">Checkpoints</div></div>
        <div class="card c-amber"><div class="card-label">Partially complied</div><div class="card-value">{{ m.kpi.counts['Partially Complied'] }}</div><div class="card-foot">Checkpoints</div></div>
        <div class="card c-red"><div class="card-label">Non-complied</div><div class="card-value">{{ m.kpi.counts['Non-Complied'] }}</div><div class="card-foot">Checkpoints</div></div>
        <div class="card c-purple"><div class="card-label">Doc not available</div><div class="card-value">{{ m.kpi.counts['Document Not Available'] }}</div><div class="card-foot">Checkpoints</div></div>
      </div>
      <h3 class="sub">Top 5 risks requiring immediate attention</h3>
      <div class="table-wrap"><table><thead><tr><th>Rank</th><th>Risk</th><th>Area</th><th class="center">Level</th><th>Affected workers / sites</th><th>Recommended action</th></tr></thead>
        <tbody>{% for t in m.top_risks %}<tr><td class="center idc">{{ loop.index }}</td><td><b>{{ t.id }}</b> {{ t.item }}<div class="src">{{ t.summary }}</div></td>
          <td>{{ t.area }}</td><td class="center">{{ risk(t.risk) }}</td><td style="font-size:11.5px">{{ t.affected }}</td>
          <td style="font-size:11.5px">Correct and evidence within {{ t.action_days }} days — see area “{{ t.area }}”, line {{ t.id }}.</td></tr>{% endfor %}</tbody></table></div>
      <h3 class="sub">Material financial exposure (indicative, wage month)</h3>
      <div class="table-wrap"><table><thead><tr><th>Exposure head</th><th>Nature</th><th class="center">Indicative ₹</th><th>Workers</th><th>Consequence if unresolved</th></tr></thead>
        <tbody>{% for e in m.exposure %}<tr><td class="name">{{ e.head }}</td><td class="src">{{ e.nature }}</td><td class="center num" style="color:var(--r-high)">₹{{ '{:,}'.format(e.amount) }}</td>
          <td style="font-size:11.5px">{{ e.workers }}</td><td style="font-size:11.5px">{{ e.consequence }}</td></tr>{% endfor %}
          <tr class="total"><td colspan="2">TOTAL INDICATIVE EXPOSURE</td><td class="center">₹{{ '{:,}'.format(m.exposure_total) }}</td><td colspan="2">Excludes interest u/s 7Q, damages u/s 14B and penalties</td></tr></tbody></table></div>
      <h3 class="sub">Recommended actions for management</h3>
      <div class="cat-grid">{% for a in m.actions %}<div class="cat-card lv-red"><div class="cc-title">{{ a.title }}</div>
        <div class="cc-sub">{{ a.owner }}{% if a.days %} · {{ a.days }} days{% endif %}</div><div style="font-size:12.3px;margin-top:8px">{{ a.body }}</div></div>{% endfor %}</div>
    </div>
  </div>
</section>

<!-- ============================ 05 AREAS ============================ -->
<section class="block" id="areas" style="background:transparent;border:0;box-shadow:none">
  <h2 style="border-radius:var(--radius)"><span class="num">05</span> Audit Areas — Line-item Results <span class="sec-meta">Every catalogue row · every sub-check</span></h2>
</section>
{% for a in m.areas %}
<details class="area" id="area-{{ a.no }}" open>
  <summary><div class="areahead"><span class="num">{{ '%02d' % a.no }}</span>{{ a.name }}
    <span class="sec-meta" style="margin-left:auto">{{ a.n }} line items · risk: {{ a.risk|upper if a.risk != 'None' else 'NONE' }}</span>
    <span class="scoredot" style="color:{{ scol(a.score) }}">{{ (a.score|string + '%') if a.score is not none else 'n/a' }}</span></div></summary>
  <div class="objective"><b>Objective:</b> {{ a.objective }}</div>
  <div class="lines table-wrap"><table class="filterable">
    <thead><tr><th>#</th><th>Audit step / point</th><th>Parameter verified</th><th>Verification point</th><th>AI action</th><th class="center">Risk</th><th>Compliance status</th><th>Observation</th><th class="no-print"></th></tr></thead>
    <tbody>
    {% for ln in a.lines %}
      <tr data-status="{{ ln.status }}" data-risk="{{ ln.risk }}" class="line">
        <td class="idc">{{ ln.no }}</td>
        <td class="step"><b>{{ ln.step }}</b><div class="cid">{{ ln.id }}{% if ln.sheet == 'Not Possible' %} · Not-Possible tab{% endif %}{% if ln.act %} · {{ ln.act }}{% endif %}</div></td>
        <td>{{ ln.parameter }}</td><td style="font-size:11.5px">{{ ln.verification }}</td><td class="src">{{ ln.action }}</td>
        <td class="center">{{ risk(ln.risk) }}</td><td>{{ badge(ln.status) }}</td>
        <td style="font-size:11.8px;min-width:260px">{{ ln.observation }}{% if ln.verdict_by == 'deepseek' %} <span class="ai">· {{ m.meta.ai_label }}</span>{% endif %}
          {% if ln.cross_check and ln.cross_check.startswith('Rule check') %}<div class="diff">⚑ {{ ln.cross_check }}</div>{% endif %}
          {% if ln.reason %}<div class="src">Scoping note: {{ ln.reason }}</div>{% endif %}</td>
        <td class="no-print">{% if ln.detail %}<button class="ev-toggle" onclick="toggleRow(this)">{{ ('Flags (' ~ ln.n_flags ~ ')') if ln.n_flags else ('Evidence (' ~ ln.n_findings ~ ')') }}</button>{% endif %}</td>
      </tr>
      {% for s in ln.subchecks %}
      <tr class="subrow" data-status="{{ s.status }}" data-risk="{{ s.risk }}"><td></td><td class="step" colspan="3">↳ Remark: {{ s.text }}</td><td class="src">Sub-check</td>
        <td class="center">{{ risk(s.risk) }}</td><td>{{ badge(s.status) }}</td><td style="font-size:11.3px">{{ s.observation }}{% if s.by == 'deepseek' %} <span class="ai">· {{ m.meta.ai_label }}</span>{% endif %}</td><td></td></tr>
      {% endfor %}
      {% if ln.detail %}
      <tr class="detail hidden"><td></td><td colspan="8">
        <table class="mini-table"><thead><tr><th>Worker / entity</th><th>Expected / ground truth</th><th>Found in contractor documents</th><th>Source</th><th>Status</th><th>Risk</th><th>Observation</th></tr></thead>
        <tbody>{% for f in ln.detail %}<tr><td class="name">{{ f.worker }}{% if f.code and f.code != '—' %} <span class="src">({{ f.code }})</span>{% endif %}{% if f.subcheck %}<div class="src">Sub-check: {{ f.subcheck[:80] }}</div>{% endif %}</td>
          <td>{{ f.expected }}</td><td>{{ f.found }}</td><td class="src">{{ f.source }}</td><td>{{ badge(f.status) }}</td><td>{{ risk(f.risk) }}</td>
          <td>{{ f.observation }}{% if 'overridden' in f.origin %} <span class="ai">· rule flag not upheld by {{ m.meta.ai_label }}</span>{% elif f.origin.startswith('deepseek') or f.origin.startswith('openrouter') %} <span class="ai">· {{ m.meta.ai_label }}</span>{% endif %}</td></tr>{% endfor %}</tbody></table>
        {% if ln.detail_more %}<div class="src" style="margin-top:6px">+{{ ln.detail_more }} more — every finding is in the Excel workbook, sheet “Evidence” (filter by ID {{ ln.id }}).</div>{% elif ln.n_flags and ln.n_flags < ln.n_findings %}<div class="src" style="margin-top:6px">{{ ln.n_findings - ln.n_flags }} compliant finding(s) not shown — see the workbook's Evidence sheet.</div>{% endif %}
      </td></tr>
      {% endif %}
    {% endfor %}
    </tbody></table></div>
</details>
{% endfor %}

<!-- ============================ 06 LEGEND ============================ -->
<section class="block" id="legend">
  <h2><span class="num">06</span> Legend — Status &amp; Risk Codes</h2>
  <div class="section-body">
    <h3 class="sub">Compliance status</h3>
    <div class="cards">{% for s in m.status_legend %}<div class="card" style="border-left-color:{{ s.color }}"><div class="card-label" style="color:{{ s.color }}">{{ s.status }}</div><div class="card-foot">{{ s.def }}</div></div>{% endfor %}</div>
    <h3 class="sub">Risk levels</h3>
    <div class="cards">{% for r in m.risk_legend %}<div class="card" style="border-left-color:{{ r.color }}"><div class="card-label">{{ r.risk }}</div><div class="card-foot">{{ r.def }}</div></div>{% endfor %}</div>
    <p class="src" style="margin-top:12px">Compliance score = (Complied + ½ × Partially Complied) ÷ (Complied + Partially Complied + Non-Complied + Document Not Available).
      Not Verifiable, Not Applicable and Not Auditable rows are excluded from the score. Overall risk = the highest risk among failing checkpoints.</p>
  </div>
</section>

<!-- ============================ ANNEXURES ============================ -->
<section class="block" id="annex">
  <h2><span class="num">A</span> Annexures — Documents Examined &amp; Audit Assurance</h2>
  <div class="section-body">
    <h3 class="sub">Audit assurance</h3>
    <table class="statlist" style="max-width:820px">
      <tr><td>Catalogue</td><td>{{ m.meta.catalogue }}</td></tr>
      <tr><td>Rows audited</td><td>{{ m.kpi.total }} of {{ m.kpi.total }} ({{ m.kpi.possible }} Possible + {{ m.kpi.not_possible }} Not Possible)</td></tr>
      <tr><td>Remarks sub-checks with a verdict</td><td>{{ m.kpi.subchecks }} of {{ m.kpi.subchecks }}</td></tr>
      <tr><td>Verdict engine</td><td>{{ m.meta.engine }}</td></tr>
      <tr><td>Rows with a {{ m.meta.ai_label }} verdict</td><td>{{ m.kpi.ai_rows }}</td></tr>
      <tr><td>Rows where {{ m.meta.ai_label }} differs from the rule check</td><td>{{ m.kpi.differs }}</td></tr>
      <tr><td>{{ m.meta.ai_label }} usage</td><td>{% if m.usage %}{% for k,v in m.usage.items() if k != 'models' %}{{ k }}: {{ v }}{% if not loop.last %} · {% endif %}{% endfor %}{% else %}not used{% endif %}</td></tr>
    </table>
    {% if m.differs %}<h3 class="sub">Rows where {{ m.meta.ai_label }} differs from the rule check (review recommended)</h3>
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Item</th><th>Rule check</th><th>Final</th><th>Note</th></tr></thead>
      <tbody>{% for d in m.differs %}<tr><td class="idc">{{ d.id }}</td><td>{{ d.item }}</td><td>{{ badge(d.rule) }}</td><td>{{ badge(d.final) }}</td><td style="font-size:11.5px">{{ d.note }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
    {% if m.issues %}<h3 class="sub">Processing notes</h3><ul class="src">{% for i in m.issues %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
    <h3 class="sub">Documents examined ({{ m.documents|length }})</h3>
    <div class="table-wrap"><table><thead><tr><th>Folder</th><th>File</th><th>Document type</th><th class="center">Pages</th><th>Read from</th></tr></thead>
      <tbody>{% for d in m.documents %}<tr><td>{{ d.root }}</td><td>{{ d.rel }}</td><td>{{ d.type }}</td><td class="center">{{ d.pages }}</td><td class="src">{{ d.read }}{% if d.error %} — {{ d.error }}{% endif %}</td></tr>{% endfor %}</tbody></table></div>
  </div>
</section>
</main>

<footer class="report-foot"><div class="tricolour"></div>
  {{ m.meta.brand.footer }} · {{ m.meta.report_no }} · {{ m.meta.classification }}
</footer>

<script>
document.querySelectorAll(".viewtabs button").forEach(function(b){
  b.addEventListener("click", function(){
    document.querySelectorAll(".viewtabs button").forEach(function(x){ x.classList.remove("active"); });
    b.classList.add("active");
    document.querySelectorAll(".viewpane").forEach(function(p){ p.classList.remove("active"); });
    document.getElementById("view-" + b.dataset.view).classList.add("active");
  });
});
function toggleRow(btn){
  var tr = btn.closest("tr"), n = tr.nextElementSibling;
  while (n && n.classList.contains("subrow")) n = n.nextElementSibling;
  if (n && n.classList.contains("detail")) n.classList.toggle("hidden");
}
function toggleAll(open){ document.querySelectorAll("details.area").forEach(function(d){ d.open = open; }); }
function openArea(no){ var d = document.getElementById("area-" + no); if (d) d.open = true; }
function applyFilters(){
  var q = document.getElementById("q").value.toLowerCase().trim();
  var st = document.getElementById("fStatus").value, rk = document.getElementById("fRisk").value, shown = 0, total = 0;
  document.querySelectorAll("table.filterable tbody > tr").forEach(function(tr){
    if (tr.classList.contains("detail")) return;
    var ok = true, isLine = tr.classList.contains("line");
    var text = tr.textContent.toLowerCase();
    if (isLine){ var n = tr.nextElementSibling; while (n && (n.classList.contains("subrow") || n.classList.contains("detail"))){ text += n.textContent.toLowerCase(); n = n.nextElementSibling; } }
    if (q && text.indexOf(q) < 0) ok = false;
    if (st && (tr.dataset.status || "").split("|").indexOf(st) < 0) ok = false;
    if (rk && tr.dataset.risk !== rk) ok = false;
    tr.style.display = ok ? "" : "none";
    if (isLine){ total++; if (ok) shown++; }
  });
  document.querySelectorAll("details.area").forEach(function(d){
    var any = Array.prototype.some.call(d.querySelectorAll("tr.line"), function(t){ return t.style.display !== "none"; });
    d.style.display = any ? "" : "none"; if (any && (q || st || rk)) d.open = true;
  });
  document.getElementById("liveStatus").textContent = (q || st || rk) ? (shown + " of " + total + " line items match") : (total + " checkpoints");
}
["q","fStatus","fRisk"].forEach(function(id){ document.getElementById(id).addEventListener(id === "q" ? "input" : "change", applyFilters); });
</script>
</body>
</html>
