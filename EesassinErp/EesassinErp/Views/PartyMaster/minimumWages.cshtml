@{
    ViewBag.Title = "Minimum Wages";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/MinimumWagesController.js?Ver=@ViewBag.Version"></script>
@*<script src="~/Scripts/myjslib/ddlBindings.js"></script>*@
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Minimum Wages</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Party Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">State<span class="vd_red">*</span></label>
                                            <div class="input-box" ng-init="AllCity()">
                                                <select class="select2 form-control validate" ng-model="State">
                                                    <option value="">Select State</option>
                                                    <option ng-repeat="x in AllCityList | unique:'STATE_NAME'"
                                                            value="{{x.STATE_NAME}}">
                                                        {{x.STATE_NAME}}
                                                    </option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Industry</label>
                                            <div class="input-box" ng-init="AllIndustry()">
                                                <select class="select2 form-control validate" ng-model="Industry">
                                                    <option value="">Select Industry</option>
                                                    <option ng-repeat="x in IndustryList" value="{{x.Id}}">{{x.Industry}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Effective From</label>
                                            <div class="input-box">
                                                <input type="date" class="form-control clear" id="txtefectivefrom" ng-model="EffectiveFrom"/>
                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Effective To</label>
                                            <div class="input-box">
                                                <input type="date" class="form-control clear" id="txteffectiveto"  ng-model="Effectiveto" />
                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Status</label>
                                            <div class="input-box">
                                                <select class="form-control clear"  ng-model="Status">
                                                    <option value="">Select</option>
                                                    <option value="Active">Active</option>
                                                    <option value="Inactive">Inactive</option>
                                                </select>
                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Payment Frequency</label>
                                            <div class="input-box">
                                                <select class="form-control clear"  ng-model="PaymentFrequency">
                                                    <option value="">Select</option>
                                                    <option>Daily </option>
                                                    <option>Weekly</option>
                                                    <option>Fortnight</option>
                                                    <option>Monthly</option>
                                                </select>
                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Yearly Percentage of Bonus</label>
                                            <div class="input-box">
                                                <input type="text" class="form-control clear"  ng-model="PercentageBonus"/>
                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>

                                        <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Payout Month</label>
                                            <div class="input-box">
                                                <input type="text" class="form-control clear"  ng-model="PayoutMonth"/>
                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>



                                        <div class="clearfix"></div>

                                        <!-- Employment Category Box -->

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 mgbt-xs-20">

                                            <div style="background:#f5f5f5;border-radius:10px;padding:20px;">

                                                <div class="row">
                                                    <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Grade</label>
                                                        <div class="input-box">
                                                            <select class="form-control clear" ng-model="Grade">
                                                                <option value="">Select</option>
                                                                <option>Highly Skilled</option>
                                                                <option>Skilled</option>
                                                                <option>Semi Skilled</option>
                                                                <option>unskilled</option>
                                                            </select>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Employment Category</label>
                                                        <div class="input-box">
                                                            <input type="text" class="form-control clear"  ng-model="EmploymentCategory"/>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Zone</label>
                                                        <div class="input-box">
                                                            <input type="text" class="form-control clear"  ng-model="Zone"/>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Basic per Month</label>
                                                        <div class="input-box">
                                                            <input type="text" class="form-control clear"  ng-model="BasicPerMonth"/>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">VDA per Month</label>
                                                        <div class="input-box">
                                                            <input type="text" class="form-control clear"  ng-model="VDAPerMonth"/>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Total per Month</label>
                                                        <div class="input-box">
                                                            <input type="text" class="form-control clear"  ng-model="TotalPerMonth"/>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                                        <label class="control-label">Minimum Wage</label>
                                                        <div class="input-box">
                                                            <input type="text" class="form-control clear"  ng-model="MinimumWage"/>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-3 col-sm-6 col-xs-12">
                                                        <label class="control-label">Floor Wage</label>
                                                        <div class="input-box">
                                                            <input type="text" class="form-control clear"  ng-model="FloorWage"/>
                                                            <div class="text-box-msg-r"></div>
                                                        </div>
                                                    </div>



                                                </div>

                                                <div class="text-right" style="margin-top:15px;display:none">
                                                    <button type="button" class="btn btn-primary">
                                                        Add New
                                                    </button>
                                                </div>

                                            </div>

                                        </div>

                                        <div class="clearfix"></div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>

