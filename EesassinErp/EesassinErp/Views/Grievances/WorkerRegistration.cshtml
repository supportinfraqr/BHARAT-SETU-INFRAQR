        <!-- Documents -->
        <div class="workerRegistrationTabContent"
             id="documentDetails">

            <div class="workerRegistrationGrid">


                <div class="workerRegistrationField">
                    <label>PAN Card</label>
                    <input type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           id="fuPANCardFilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('PANCardFilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="PANCardFilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(PANCardFilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(PANCardFilePath,'PAN Card')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Aadhar Card(Front Side)</label>
                    <input type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           id="fuAdhaarCard_FrontSide_FilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('AdhaarCard_FrontSide_FilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="AdhaarCard_FrontSide_FilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(AdhaarCard_FrontSide_FilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(AdhaarCard_FrontSide_FilePath,'AdhaarCard_FrontSide')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Aadhar Card(Back Side)</label>
                    <input type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           id="fuAdhaarCard_BackSide_FilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('AdhaarCard_BackSide_FilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="AdhaarCard_BackSide_FilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(AdhaarCard_BackSide_FilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(AdhaarCard_BackSide_FilePath,'AdhaarCard_BackSide')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Cheque/Passbook Copy</label>
                    <input type="file"
                           accept=".pdf"
                           id="fuCheque_Passbook_FilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('Cheque_Passbook_FilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="Cheque_Passbook_FilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(Cheque_Passbook_FilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(Cheque_Passbook_FilePath,'ChequePassbookCopy')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Educational Certificate</label>
                    <input type="file"
                           accept=".pdf"
                           id="fuEducationCertificateFilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('EducationCertificateFilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="EducationCertificateFilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(EducationCertificateFilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(EducationCertificateFilePath,'Educational Certificate')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Experience Ceritificate</label>
                    <input type="file"
                           accept=".pdf"
                           id="fuExperienceCertificateFilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('ExperienceCertificateFilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="ExperienceCertificateFilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(ExperienceCertificateFilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(ExperienceCertificateFilePath,'Experience Certificate')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Relieving Letter</label>
                    <input type="file"
                           accept=".pdf"
                           id="fuRelievingLetterfFilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('RelievingLetterfFilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="RelievingLetterfFilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(RelievingLetterfFilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(RelievingLetterfFilePath,'Relieving Letter')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Payslips</label>
                    <input type="file"
                           accept=".pdf"
                           id="fuPayslipsFilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('PayslipsFilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="PayslipsFilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(PayslipsFilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(PayslipsFilePath,'Payslips')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Photo</label>
                    <input type="file"
                           accept=".jpg,.jpeg,.png"
                           id="fuPhotos_1_FilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('Photos_1_FilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="Photos_1_FilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(Photos_1_FilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(Photos_1_FilePath,'Photo-1')" style="cursor:pointer;"></i>
                    </div>
                </div>

                <div class="workerRegistrationField">
                    <label>TIC Card</label>
                    <input type="file"
                           accept=".jpg,.jpeg,.png"
                           id="fuPhotos_3_FilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('Photos_3_FilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="Photos_3_FilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(Photos_3_FilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(Photos_3_FilePath,'Photo-3')" style="cursor:pointer;"></i>
                    </div>
                </div>
                <div class="workerRegistrationField">
                    <label>Signature</label>
                    <input type="file"
                           accept=".jpg,.jpeg,.png"
                           id="fuPhotos_4_FilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('Photos_4_FilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="Photos_4_FilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(Photos_4_FilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(Photos_4_FilePath,'Photo-4')" style="cursor:pointer;"></i>
                    </div>
                </div>

            </div>

        </div>

        <!-- Job History -->
        <div class="workerRegistrationTabContent"
             id="jobHistoryDetails">

            <div class="workerRegistrationGrid">

                <div class="workerRegistrationField">
                    <label>Client Name</label>
                    <input type="text" ng-model="CName">
                </div>
                <div class="workerRegistrationField">
                    <label>Site Name</label>
                    <input type="text" ng-model="SName">
                </div>
                <div class="workerRegistrationField">
                    <label>Nature of Job</label>
                    <input type="text" ng-model="NatureJob">
                </div>
                <div class="workerRegistrationField">
                    <label>Type of Worker</label>
                    <input type="text" ng-model="TypeWork">
                </div>
                <div class="workerRegistrationField">
                    <label>Start Date</label>
                    <input type="date" ng-model="Sdate">
                </div>
                <div class="workerRegistrationField">
                    <label>End Date</label>
                    <input type="date" ng-model="endate">
                </div>
                <div class="workerRegistrationField">
                    <label>Appointment Letter</label>
                    <input type="file"
                           accept=".jpg,.jpeg,.png"
                           id="fuPhotos_2_FilePath{{$index}}"
                           onchange="angular.element(this).scope().uploadFile('Photos_2_FilePath', this)" style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                    <div ng-if="Photos_2_FilePath" style="margin-top:5px;">
                        <i class="bi bi-eye" ng-click="ViewFileC(Photos_2_FilePath)" style="cursor:pointer;margin-right:10px;"></i>
                        <i class="bi bi-download" ng-click="DownloadFileC(Photos_2_FilePath,'Photo-2')" style="cursor:pointer;"></i>
                    </div>
                </div>

            </div>

        </div>

    </div>
    <div id="cropModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%; background:rgba(0,0,0,0.7);z-index:9999999; justify-content:center;align-items:center;">

        <div style="background:#fff;padding:10px;border-radius:10px;width:80%;text-align:center;">

            <img id="cropImage" style="max-width:100%;max-height:300px;" />

            <br><br>


            <button class="workerRegistrationNextBtn" ng-click="closeCrop()">Cancel</button>
            <button class="workerRegistrationNextBtn" ng-click="cropImageSave()">
                Crop & Save
            </button>
        </div>
    </div>

    <!-- Footer -->

    <div class="workerRegistrationFooter" style=" display: flex;  gap: 15px;  margin-top: 15px;">
        <button class="workerRegistrationNextBtn" ng-click="nextTab()">
            Next
        </button>

        <button ng-click="SaveEmployee()"
                style="border:none; border-radius:14px; background:var(--primary); color:white; font-size:16px; padding:6px 12px; font-weight:500;">
            Submit
        </button>
    </div>
</div>


