@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


<link href="~/Content/Masters/WorkerRegistration/style.css" rel="stylesheet" /> 
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="~/Content/Masters/WorkerRegistration/script.js"></script>


<script src="~/scripts/RetailJsLib/WorkerRegistrationController.js"></script>

<style>
    .cropper-view-box,
    .cropper-face,
    .cropper-crop-box {
        border-radius: 50%;
    }
    .text-danger {
        color: red;
    }
    #cropModal {
        position: fixed !important;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,.6);
        z-index: 999999 !important;
    }

        #cropModal .modal-dialog {
            z-index: 999999 !important;
        }

    .cropper-container {
        z-index: 9999999 !important;
    }

</style>
<div class="workerRegistration px-4 py-4">

    <!-- Progress Card -->
    <div class="workerRegistrationProgressCard">

        <div class="workerRegistrationProgressLeft">
            <h2>Complete Your Profile</h2>
            <p>
                Fill in the fields available to you. Locked fields will be
                completed by your contractor or employer.
            </p>
        </div>

        <div class="workerRegistrationProgressRight">

            <div class="workerRegistrationProgressHeader">
                <span>Completion Progress</span>
                <strong>{{progress}}% </strong>
            </div>

            <div class="workerRegistrationProgressBar">
                <div class="workerRegistrationProgressBar">
                    <div style="height:100%;
                background:var(--primary);
                border-radius:20px;
                transition:0.5s;"
                         ng-style="{'width': progress + '%'}">
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- Tabs -->

    <div class="workerRegistrationTabs">

        <button class="workerRegistrationTab active"
                data-target="workerDetails">
            Worker Details
        </button>

        <button class="workerRegistrationTab"
                data-target="contactDetails">
            Contact & Address
        </button>

        <button class="workerRegistrationTab"
                data-target="bankDetails">
            Statutory & Bank Details
        </button>

        @*<button class="workerRegistrationTab"
                    data-target="nomineeDetails">
                Nominee Details
            </button>*@

        <button class="workerRegistrationTab"
                data-target="documentDetails">
            Documents
        </button>

        <button class="workerRegistrationTab"
                data-target="jobHistoryDetails">
            Job History
        </button>

    </div>

    <!-- Tab Content -->

    <div class="workerRegistrationFormCard">

        <!-- Worker Details -->
        <div class="workerRegistrationTabContent active"
             id="workerDetails">

            <div class="workerRegistrationGrid">



                <div class="workerRegistrationField">
                    <label>Ref Worker Code  <span class="text-danger">*</span></label>
                    <input class="validateA" id="txtRefEmployeeCode" ng-model="RefEmployeeCode" name="RefEmployeeCode">
                </div>

                <div class="workerRegistrationField">
                    <label>Worker Name  <span class="text-danger">*</span></label>
                    <input class=" validateA" id="txtEmployeeName" ng-model="EmployeeName" name="EmployeeName" ng-disabled="true">
                </div>



                <div class="workerRegistrationField">
                    <label>Designation  <span class="text-danger">*</span></label>
                    <input class=" validateA" id="txtEmployeeDesignation" ng-model="EmployeeDesignation">
                </div>

                <div class="workerRegistrationField">
                    <label>Department  <span class="text-danger">*</span></label>
                    <input class=" validateA" id="txtEmployeeDepartment" ng-model="EmployeeDepartment">
                </div>

                <div class="workerRegistrationField">
                    <label>Father/Husband Name  <span class="text-danger">*</span></label>
                    <input class=" validateA" id="txtFatherHusbandName" ng-model="FatherHusbandName">
                </div>

                <div class="workerRegistrationField">
                    <label>Gender  <span class="text-danger">*</span></label>
                    <select class="validateA" ng-model="Gender">
                        <option value="">Select</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>

                <div class="workerRegistrationField">
                    <label>Marital Status  <span class="text-danger">*</span></label>
                    <select class="validateA" ng-model="MaritalStatus">
                        <option value="">Select</option>
                        <option value="Married">Married</option>
                        <option value="UnMarried">UnMarried</option>
                    </select>
                </div>



                <div class="workerRegistrationField">
                    <label>Date of Birth  <span class="text-danger">*</span></label>
                    <input type="date" class=" validateA" id="txtDateofBirth" ng-model="DateofBirth">
                </div>

                <div class="workerRegistrationField">
                    <label>Date of Joining  <span class="text-danger">*</span></label>
                    <input type="date" class=" validateA" id="txtDOJ" ng-model="DOJ">
                </div>




                <div class="workerRegistrationField">
                    <label>Blood Group  <span class="text-danger">*</span></label>
                    <input class="validateA" id="txtBloodGroup" ng-model="BloodGroup">
                </div>

                <div class="workerRegistrationField">

                    <label style="display: block; font-size: 12px; font-weight: bold; margin-bottom: 5px; text-align: left;">
                        Worker Photo
                    </label>
                    <input type="file"
                           onchange="angular.element(this).scope().openCropper(this)"
                           style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;">
                </div>

            </div>

        </div>

        <!-- Contact & Address -->
        <div class="workerRegistrationTabContent"
             id="contactDetails">

            <div class="workerRegistrationGrid">

                <div class="workerRegistrationField">
                    <label>Present Address  <span class="text-danger">*</span></label>
                    <input class=" validateA"
                           id="txtPresentAddress"
                           ng-model="PresentAddress">
                </div>

                <div class="workerRegistrationField">
                    <label>Permanent Address  <span class="text-danger">*</span></label>
                    <input class=" validateA"
                           id="txtPermanentAddress"
                           ng-model="PermanentAddress">
                </div>

                <div class="workerRegistrationField">
                    <label>Worker Email ID  <span class="text-danger">*</span></label>
                    <input type="email" class=" validateA" ng-model="EmployeeEmailID" ng-disabled="true">
                </div>

                <div class="workerRegistrationField">
                    <label>Mobile Number  <span class="text-danger">*</span></label>
                    <input type="text" class=" validateA" ng-model="MobileNumber" ng-disabled="true">
                </div>

                <div class="workerRegistrationField">
                    <label>Alternative Mobile No.</label>
                    <input type="text" ng-model="AlternativeMobileNumber">
                </div>

            </div>

        </div>

        <!-- Bank -->
        <div class="workerRegistrationTabContent"
             id="bankDetails">

            <div class="workerRegistrationGrid">
                <div class="workerRegistrationField">
                    <label>PAN Number</label>
                    <input id="txtPANNumber"
                           ng-model="PANNumber"
                           maxlength="10"
                           minlength="10"
                           style="text-transform:uppercase;">
                </div>

                <div class="workerRegistrationField">
                    <label>Aadhar Number</label>
                    <input type="text"
                           id="txtAdharCardNumber"
                           ng-keypress="onlyNumbers($event)"
                           ng-model="AdharCardNumber"
                           numeric-only
                           dynamic-length
                           maxlength="12"
                           minlength="12">
                </div>

                <div class="workerRegistrationField">
                    <label>UAN Number</label>
                    <input id="txtPreviousUAN"
                           ng-model="PreviousUAN">
                </div>
                <div class="workerRegistrationField">
                    <label>PF Account No.</label>
                    <input id="txtPFAccount"
                           ng-model="PFAccount">
                </div>
                <div class="workerRegistrationField">
                    <label>Bank Account No.</label>
                    <input id="txtBankAccountNumber"
                           ng-model="BankAccountNumber"
                           numeric-only>
                </div>
                <div class="workerRegistrationField">
                    <label>Bank IFSC Code</label>
                    <input id="txtBankIFSCCode"
                           ng-model="BankIFSCCode">
                </div>
                <div class="workerRegistrationField">
                    <label>Previous ESIC</label>
                    <input id="txtPreviousESI"
                           ng-model="PreviousESI">
                </div>
                <div class="workerRegistrationField">
                    <label>Gross Salary</label>
                    <input id="txtGrossSalary"
                           ng-model="GrossSalary"
                           numeric-only>
                </div>


            </div>

        </div>

        <!-- Nominee -->
        <!--<div class="workerRegistrationTabContent"
             id="nomineeDetails">

            <div class="workerNomineeWrapper">-->
