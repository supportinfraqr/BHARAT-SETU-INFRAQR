@{
    ViewBag.Title = "Document Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/Scripts/myjslib/DocumentMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Document Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Vendor</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Document Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding " ng-init="AllState()">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Document Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtDocumentName", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "DocumentName" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Type<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtDocumentType", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "DocumentType" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Frequency<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtFrequency", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "Frequency" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15" ng-init="AllState()">
                                            <label class="control-label">State<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlstate" autocomplete='address-level2' class="select2 form-control validate" ng-model="StateId">
                                                    <option value="">Select State</option>
                                                    <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">{{x.STATE_NM}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Form No.<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtForm", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "FormNo" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Criticality<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlCriticality" autocomplete='address-level2' class="select2 form-control validate" ng-model="Criticality">
                                                    <option value="">Select </option>
                                                    <option value="High">High</option>
                                                    <option value="Medium">Medium</option>
                                                    <option value="Low">Low</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Format Type<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlft" autocomplete='address-level2' class="select2 form-control validate" ng-model="FormatType">
                                                    <option value="">Select </option>
                                                    <option value="image">Image[Included only jpg and png Format]</option>
                                                    <option value="png">Only png</option>
                                                    <option value="jpg">Only jpg</option>

                                                    <option value="pdf">pdf</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Note</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtNote", "", new { @class = "form-control clea", @placeholder = "", @ng_model = "Note" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Act</label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAct", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "Act" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Mandotory <span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlVT" autocomplete='address-level2' class="select2 form-control validate" ng-model="IsDefault">
                                                    <option value="">Select </option>
                                                    <option value="Yes">Yes</option>
                                                    <option value="No">No</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Is Active<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlVT" autocomplete='address-level2' class="select2 form-control validate" ng-model="IsDelete">
                                                    <option value="">Select </option>
                                                    <option value="Yes">Yes</option>
                                                    <option value="No">No</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>




                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                            <button id="btnValidation"
                                                    type="button"
                                                    class="btn2 btn-common btn-3 btn-3d pe-7s-refresh-2"
                                                    ng-click="openValidationModal();BindDocument()">
                                                <span class="triangle-box" title="Validation"></span>
                                                <span>Validation Mapping</span>
                                            </button>
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>
    <div class="modal fade"
         id="validationModal"
         tabindex="-1"
         role="dialog">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">
 
                <div class="modal-header bg-primary text-white d-flex justify-content-between align-items-center px-3 py-2">

                    <h6 class="modal-title m-0">
                        Validation Mapping
                    </h6>

                  
                </div>

                <div class="modal-body">

                    <!-- Dropdown -->
                    <div class="form-group">
                        <label>Select Type</label>
                        <select class="form-control"    ng-model="SelectedType"  ng-change="BindValidations()">
                            <option value="">Select</option>
                            <option ng-repeat="x in validateDocumentList" value="{{x.Id}}">{{x.DocumentName}}</option> 
                        </select>
                    </div>

                    <br />

                    <!-- Table -->
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th width="45%">Validation</th>
                                <th width="45%">Value</th>
                                <th width="10%">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>
                                    <select class="form-control"
                                            ng-model="SelectedValidation"
                                            ng-change="addSelectedRow()">
                                        <option value="">--Select Validation--</option>
                                        <option ng-repeat="v in ValidationOptions"
                                                value="{{v}}">
                                            {{v}}
                                        </option>
                                    </select>
                                </td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr ng-repeat="x in ValidationRows">
                                <td>
                                    <input type="text"
                                           class="form-control"
                                           ng-model="x.Col1" />
                                </td>

                                <td>
                                    <input type="text"
                                           class="form-control"
                                           ng-model="x.Col2" />
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-success btn-sm"
                                            ng-click="addRow()">
                                        +
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            ng-click="removeRow($index)"
                                            ng-show="ValidationRows.length>1">
                                        -
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-success"
                            ng-click="saveValidation()">
                        Save
                    </button>

                    <button class="btn btn-secondary" style="background: #535050;" data-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Validation Modal -->
