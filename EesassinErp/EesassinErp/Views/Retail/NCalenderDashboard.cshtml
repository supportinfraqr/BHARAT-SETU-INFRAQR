    <script>
        function getFormattedDateTime() {
            const now = new Date();

            const months = [
                "January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"
            ];

            const month = months[now.getMonth()];
            const day = now.getDate().toString().padStart(2, '0');
            const year = now.getFullYear();

            let hours = now.getHours();
            const minutes = now.getMinutes().toString().padStart(2, '0');
            const seconds = now.getSeconds().toString().padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12 || 12; // convert to 12-hour format

            return `${month} ${day}, ${year} ${hours}:${minutes}:${seconds} ${ampm}`;
        }

        function startClock() {
            setInterval(function () {
                $('#output').text(getFormattedDateTime());
            }, 1000); // update every second
        }

        // Start the timer when page loads
        $(document).ready(function () {
            startClock();
        });
    </script>

    <!-- Output placeholder -->

    <script>
        let events = {};
        let currentDate = new Date();

        $(document).ready(function () {
            bindEvent();


              
            let newMonth; // global or outer-scope variable

            $('#prevMonth').on('click', function () {
                debugger;
                currentDate.setMonth(currentDate.getMonth() - 1);

                var newMonth = currentDate.getMonth() +1; // JS months are 0-based
                var newYear = currentDate.getFullYear(); 
                renderCalendar(); 
                var scope = angular.element(document.getElementById('main')).scope(); // Replace 'main' with your Angular app's root element ID
                scope.$apply(function () {
                    scope.LoadData(newMonth, newYear); // pass both month and year
                });
            });


            $('#nextMonth').on('click', function () {
                currentDate.setMonth(currentDate.getMonth() + 1);
                var newMonth = currentDate.getMonth() + 1; // JS months are 0-based
                var newYear = currentDate.getFullYear();
                renderCalendar();
                var scope = angular.element(document.getElementById('main')).scope(); // Replace 'main' with your Angular app's root element ID
                scope.$apply(function () {
                    scope.LoadData(newMonth, newYear); // pass both month and year
                });
            });

          
        });

        function bindEvent() {
            let queryString = window.location.href.split('?')[1] || '';
            let decoded = decodeURIComponent(queryString);
            let type = decoded.split('|')[0];
            debugger;
            const today = new Date();
            const collectionobj = {
                Action: 13,
                UserId: LoginId, // Make sure LoginId is available globally
                Industry: type,               
                currentMonth : today.getMonth() + 1,
                currentYear : today.getFullYear()
            };

            $.ajax({
                url: "../Retail/SearchClientDashboard",
                type: "POST",
                data: JSON.stringify({ obj: collectionobj }),
                contentType: "application/json",
                success: function (response) {
                    try {
                        if (typeof response === 'string') {
                            response = JSON.parse(response);
                        }

                        if (response && response.Result) {
                            events = {};

                            response.Result.forEach(event => {
                                const eventDate = event.date;
                                if (/^\d{4}-\d{2}-\d{2}$/.test(eventDate)) {
                                    events[eventDate] = true;
                                }
                            });
                          
                            renderCalendar();
                        }
                    } catch (e) {
                        console.error("Error parsing or processing response:", e);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                }
            });
        }

        function renderCalendar() {
            debugger;

            const calendarGrid = document.getElementById('calendar-grid');
            const calendarMonth = document.getElementById('calendarMonth');
            calendarGrid.innerHTML = '';

            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();

            const firstDay = new Date(year, month, 1);
            const lastDay = new Date(year, month + 1, 0);
            const daysInMonth = lastDay.getDate();

            const startDay = firstDay.getDay();
            const dayOffset = (startDay === 0) ? 6 : startDay - 1;

            const monthNames = ["January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"];
            calendarMonth.textContent = `${monthNames[month]} ${year}`;

            // Add empty cells before the first day
            for (let i = 0; i < dayOffset; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.classList.add('calendar-cell', 'empty-cell');
                calendarGrid.appendChild(emptyCell);
            }

            // Add actual day cells
            for (let day = 1; day <= daysInMonth; day++) {
                const cell = document.createElement('div');
                cell.classList.add('calendar-cell');

                const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                cell.textContent = day;
                $(cell).data("date", dateStr);

                if (events && events[dateStr]) {
                    const dot = document.createElement('div');
                    dot.classList.add('event-dot');
                    cell.appendChild(dot);
                }
               
                // Click event for selecting date
                cell.addEventListener('click', function () {
                    const selectedDate = $(this).data("date");

                    document.querySelectorAll('.calendar-cell').forEach(c => {
                        c.classList.remove('selected-cell');
                    });

                    this.classList.add('selected-cell');

                    const scope = angular.element($("#calendar-grid")).scope();
                    if (scope && scope.$$phase !== '$apply' && scope.$$phase !== '$digest') {
                        scope.$apply(function () {
                            scope.BindCalenderOnclickdetail(selectedDate); scope.BindCalender();
                        });
                    } else if (scope) {
                        scope.BindCalenderOnclickdetail(selectedDate); scope.BindCalender();
                    }
                });

                calendarGrid.appendChild(cell);
            }
        }

    </script>


