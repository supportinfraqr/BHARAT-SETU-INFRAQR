@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Labour Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Masters/LabourCompliance/style.css" rel="stylesheet" />
<script src="~/Masters/LabourCompliance/script.js"></script>
<script src="~/scripts/RetailJsLib/StatutoryController.js?Ver=@ViewBag.Version"></script>
<script>
    app.directive('fileModel', ['$parse', function ($parse) {
        return {
            restrict: 'A',
            scope: {
                fileModel: '=',
                rowData: '='   // 👈 row pass karenge
            },
            link: function (scope, element) {

                element.bind('change', function () {

                    scope.$apply(function () {
                        scope.fileModel = element[0].files;
                    });

                    scope.$parent.fileSelected(element[0].files, scope.rowData);
                });
            }
        };
    }]);</script>
<style>
    .table-container {
        max-height: 450px; /* Height yaha se control karo */
        overflow-y: auto; /* Vertical scroll */
        overflow-x: auto; /* Horizontal scroll ON */
    }

    input[type="file"] {
        display: none;
    }

    .custom-table {
        width: max-content;
        min-width: 100%;
    }


/*=========Changes==========*/
/* scroll wrapper */
.labourCompPage .toggle-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

/* hide scrollbar (optional) */
.labourCompPage .toggle-scroll::-webkit-scrollbar {
    height: 4px;
}

/* main capsule */
.labourCompPage .toggle-pill {
    display: inline-flex;
    min-width: max-content; /* important */
    border-radius: 999px;
    background: rgba(0,0,0,0.03);
    padding: 4px;
    gap: 4px;
    align-items: center;
}

.labourCompPage .table-container {
    max-height: 65vh;
    overflow: auto;
    border-radius: 12px; 
    scroll-behavior: smooth;
}

/* Sticky columns - body cells */
.labourCompPage .custom-table tbody td:nth-child(1) {
    position: sticky;
    left: 0;
    z-index: 5;
    background: var(--card-bg);
    min-width: 35px;
}

.labourCompPage .custom-table tbody td:nth-child(2) {
    position: sticky;
    left: 35px;
    z-index: 4;
    background: var(--card-bg);
    width: 195px;
    min-width: 195px;
    max-width: 195px;
}

.labourCompPage .custom-table tbody td:nth-child(3) {
    position: sticky;
    left: 230px; /* 35 + 195 */
    z-index: 3;
    background: var(--card-bg);
    min-width: 160px;
    max-width: 200px;
}

.labourCompPage .custom-table thead th:nth-child(1) {
    left: 0;
    z-index: 10;
}

.labourCompPage .custom-table thead th:nth-child(2) {
    left: 35px;
    z-index: 9;
    width: 195px;
    min-width: 195px;
    max-width: 195px;
}

.labourCompPage .custom-table thead th:nth-child(3) {
    left: 230px;
    z-index: 8;
}


.labourCompPage .custom-table thead th {
    position: sticky;
    top: 0;
    /*z-index: 6;*/
    background: #F37437;
    color: #fff;
}

.labourCompPage .custom-table {
    table-layout: auto;
}

/*.labourCompPage .custom-table td,
.labourCompPage .custom-table th {
    max-width: 160px;
}*/

/*Fix table issues here*/
.labourCompPage .small-table td,
.labourCompPage .small-table th {
    vertical-align: middle;
    line-height: 1.4;
}

.labourCompPage .small-table .form-select,
.labourCompPage .small-table .form-control {
    height: 30px;
    min-height: 30px;
    line-height: 1.2;
}

.labourCompPage .small-table {
    border-collapse: separate;
    border-spacing: 0;
}

.labourCompPage .custom-table td:nth-child(2),
.labourCompPage .custom-table td:nth-child(3) {
    white-space: normal !important;
    max-width: 250px;
    word-break: break-word;
}

.labourCompPage .custom-table td:nth-child(3),
.labourCompPage .custom-table th:nth-child(3) {
    white-space: normal !important;
    word-break: break-word;
}


/* Disable horizontal sticky columns on tablets and below */
@@media (max-width: 991px) {

    .labourCompPage .custom-table td:nth-child(1),
    .labourCompPage .custom-table td:nth-child(2),
    .labourCompPage .custom-table td:nth-child(3),
    .labourCompPage .custom-table th:nth-child(1),
    .labourCompPage .custom-table th:nth-child(2),
    .labourCompPage .custom-table th:nth-child(3) {

        left: auto !important;
    }
}


.labourCompPage {
    overflow-x: hidden;
}

/*Moddal responsiveness Optimization*/
@@media (max-width: 768px) {
    .labourCompPage .modal-dialog {
        margin: 0.5rem;
    }

    .labourCompPage .modal-xl,
    .labourCompPage .modal-lg {
        max-width: 100%;
    }
}

</style>

