                                                    <a ng-if="x.ISUPLOAD!='-1'" href="{{x.UploadLicenseCopy}}"><span class="browtext"><i class="fa fa-download" download></i></span></a></td>

                                            </tr>

                                        </table>
                                    </div>
                                </div>
