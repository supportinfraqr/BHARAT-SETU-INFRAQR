                                                <td>{{stores.CITY_NAME}}</td>
                                                @*<td>{{stores.CircleId}}</td>
                                                <td>{{stores.RegionName}}</td>
                                                *@
                                                <td>{{stores.StoreManagerName}}</td>
                                                <td>{{stores.StoreManagerEmail}}</td>
                                                <td>{{stores.StoreManagerMobileNo}}</td>
