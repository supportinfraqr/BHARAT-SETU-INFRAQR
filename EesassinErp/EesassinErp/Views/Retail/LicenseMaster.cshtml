@{
    ViewBag.Title = "LicenseMaster";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/ckeditor/ckeditor.js"></script>
<script src="~/Content/ckfinder/ckfinder.js"></script>

<script src="~/scripts/RetailJsLib/LicenseMasterController.js?Ver=@ViewBag.Version"></script>
<style>
    .input-box {
        position: relative;
    }
    fieldset {
        border: 2px solid #ccc; /* Set a border */
        padding: 10px;
        margin: 10px 0;
    }

    legend {
        font-weight: bold;
        color: #333;
    }
    .form-control {
        width: 100%;
        height: 34px;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px;
        font-size: 14px;
        color: #333;
        background-color: #fff;
        cursor: pointer;
        outline: none;
    }

        .form-control[multiple] {
            height: 200px;
        }

            .form-control[multiple] option[selected] {
                background-color: #007bff;
                color: #fff;
            }

            .form-control[multiple] option:hover {
                background-color: #f5f5f5;
            }
    .dropdown-menu { 
        display: block !important;
    }
    .dropdown-arrow {
        transition: transform 0.3s ease;
        display: inline-block;
        margin-left: 5px;
    }

    .arrow-up {
        transform: rotate(180deg);
    }

    .arrow-down {
        transform: rotate(0deg);
    }
</style>

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">License Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>License Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-init="BindAllState()">
                                            <label class="control-label">State<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                               
                                                <select id="ddlstateName" class="select2 form-control validate" ng-model="StateId" ng-change="BindLICENCE()">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">{{x.STATE_NM}}</option>
                                                </select> 
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" >
                                            <label class="control-label">License Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlLicenceName" class="select2 form-control validate" ng-model="LicenseId">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in LicenceList | unique:'LicenseId'" value="{{x.LicenseId}}">
                                                        {{x.LicenseName}}
                                                    </option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Permission For<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlModuleType" autocomplete='address-level2' class="select2 form-control validate" ng-model="PermissionId" ng-change="AllPartySiteLoad()">
                                                    <option value="">Select</option>
                                                    <option value="1">Permission For Directors Details Section</option>
                                                    <option value="2">Permission For  Authorized Signatory Details Section</option>
                                                    <option value="3">Permission For  Other Section</option>
                                                    <option value="12">Permission For  Directors Details & Authorized Signatory Details Section</option>
                                                    <option value="13">Permission For  Directors Details & Other Section</option>
                                                    <option value="23">Permission For Authorized Signatory Details & Other Section</option>
                                                    <option value="123">Permission For Directors Details , Authorized Signatory Details & Other Section</option>
                                                </select> <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-init="AllIndustry()">
                                            <label class="control-label">Industry<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlIndustry" autocomplete='address-level2' class="select2 form-control validate" ng-model="Industry">
                                                    <option value="">Select Industry</option>
                                                    <option ng-repeat="x in IndustryList" value="{{x.Id}}">{{x.Industry}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Category <span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <!-- Dropdown Container -->
                                                <div class="dropdown-container select2 form-control">
                                                    <button class="dropdown-button" ng-click="CategorytoggleDropdown()">
                                                        Select Category
                                                        <span class="dropdown-arrow" ng-class="{'arrow-up': CategorydropdownOpen, 'arrow-down': !CategorydropdownOpen}">&#9660;</span>
                                                    </button>
                                                    <div class="dropdown-menu " style=" overflow: scroll; height: 200px;" ng-show="CategorydropdownOpen">
                                                        <div ng-repeat="x in CategoryList" class="dropdown-item">
                                                            <label>
                                                                <input type="checkbox" ng-model="selectedCategory[x.Id]" ng-change="updateCategorySelection(x)" />
                                                                {{x.Name}}
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>



                                        <div class="col-lg-6 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <fieldset>
                                                <legend>    User List</legend>
                                                <div class="input-box" style="width:100%; height:200px; overflow:auto;">

                                                    <table style="color:black;width:100%" ng-init="DefaultBind()">
                                                        <thead><tr><td style="width: 10%; text-align: left; background-color: grey ">Sr No.</td><td style="width: 90%;text-align:center; background-color: grey">User</td></tr></thead>
                                                        <tbody>

                                                            <tr ng-repeat="x in AllPartyList">
                                                                <td>

                                                                    <input ng-click="change1(x.PartyId)" type="checkbox" ng-model="chk1[x.PartyId]" ng-init="chk1[x.PartyId]==x.PartyId" ng-disabled="Istrue" />
                                                                    <label for=""> </label>

                                                                </td>

                                                                <td> {{x.PartyName}}</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </fieldset>

                                        </div>
                                        <div class="col-lg-6 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <fieldset>
                                                <legend>    Document List<span class="vd_red">*</span></legend>
                                                <div class="input-box" style="width:100%; height:200px; overflow:auto;">

                                                    <table style="color:black;width:100%" ng-init="BindAllDocumentList()">
                                                        <thead><tr><td style="width: 10%; text-align: left; background-color: grey ">Sr No.</td><td style="width: 90%; text-align: center; background-color: grey">Document</td></tr></thead>
                                                        <tbody>

                                                            <tr ng-repeat="x in AllDocumentList">
                                                                <td>

                                                                    <input ng-click="change(x.DocumentId)" type="checkbox" ng-model="chk[x.DocumentId]" ng-init="chk[x.DocumentId]==x.DocumentId" />
                                                                    <label for=""> </label>

                                                                </td>

                                                                <td> {{x.DocumentName}}</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>