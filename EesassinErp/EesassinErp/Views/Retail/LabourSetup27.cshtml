@{
    ViewBag.Title = "Labour Setup";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


<script src="../Scripts/RetailJsLib/StatutorySetupController.js"></script>
<style>
    .statutorySetupPage {
        font-family: "Inter", sans-serif;
        --primary: #E45D27; /* theme accent */
        --primary-dark: #c44b1d;
        --card-bg: #FEF3EC;
        background: #FFF1EB;
        color: #223;
        min-height: 85vh;
    }

    /*.dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }*/

    .header-btn {
        border-radius: 999px;
        border: none;
        color: #fff;
        background: var(--primary);
        padding: 6px 12px;
        font-weight: 400;
        font-size: 0.8rem;
    }

        .header-btn:hover {
            background: var(--primary-dark);
            color: #fff;
        }

    .statutorySetupPage .header-btn:focus,
    .statutorySetupPage .header-btn:active {
        background: var(--primary);
        color: #fff;
        border: none;
        box-shadow: none;
    }

    .statutorySetupPage .header-btn:active {
        transform: scale(0.98);
    }

    /* Table wrapper and hide scrollbar visually */
    .statutorySetupPage .small-table-wrapper .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: smooth;
        position: relative;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        min-height: 320px;
    }

        .statutorySetupPage .small-table-wrapper .table-responsive::-webkit-scrollbar {
            display: none;
        }

    /* table header sticky */
    .statutorySetupPage .small-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #F37437;
        color: #fff;
        font-weight: 600;
        font-size: 0.78rem;
        text-align: left;
        vertical-align: middle;
        white-space: nowrap;
        padding: 8px 10px;
    }

    /* table body */
    .statutorySetupPage .small-table tbody td {
        background-color: var(--card-bg);
        font-size: 0.78rem;
        vertical-align: middle;
        text-align: left;
        padding: 8px 10px;
        white-space: normal;
    }

    /* hover */
    .statutorySetupPage .small-table tbody tr:hover td {
        background-color: #FFE8D9;
    }

    .statutorySetupPage .small-table input,
    .statutorySetupPage .small-table select {
        font-size: 0.78rem;
        padding: 4px 6px;
        height: 30px;
        min-width: 100px;
    }

    .statutorySetupPage .btn-add-row {
        background: #dff6e9;
        color: #197a3a;
    }

    .statutorySetupPage .btn-remove-row {
        background: #ffe9ee;
        color: #c43a5b;
    }
</style>


<div class="statutorySetupPage px-4 py-2">

    <div class="custom-card">

        <!-- Header -->
        <div class="page-header d-flex justify-content-between align-items-center mb-3">
            <h4 style="color: var(--primary)">Labour Setup</h4>

            <div class="d-flex gap-2">
                <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                    <div class="input-group input-group-sm">
                        <input id="lbSearch"
                               type="text"
                               ng-model="Search"
                               class="form-control form-control-sm"
                               placeholder="Search..." />
                        <button class="btn btn-sm" id="lbSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                    </div>
                </div>
                <button class="btn header-btn"
                        ng-click="switchView()">
                    {{ showEntryForm ? 'Back to Dashboard' : 'Add Statutory Setup' }}
                </button>

                <button class="btn header-btn"
                        ng-show="showEntryForm"
                        ng-click="ResetForm()">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>

                <button class="btn header-btn"
                        ng-show="showEntryForm"
                        ng-click="SaveAfterValidate();ManageLog('Save Statutory Setup')">
                    <i class="bi bi-check-circle"></i> Save
                </button>

            </div>
        </div>

        <!-- Content here -->
        <div class="small-table-wrapper" ng-show="showEntryForm">

            <div class="table-responsive rounded-3">
                <table class="table small-table" ng-init="AddListSet()">
                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>State</th>
                            <th>Act Name</th>
                            <th>Compliance Name</th>
                            <th>Registration Type</th>
                            <th>Upload</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="obj in ListSet track by $index">
                            <td>{{$index + 1}}</td>
                            <td>
                                <select class="form-control validate" ng-model="obj.State" ng-init="AllState()" ng-change="BindAct(obj.State, $index)">
                                    <option value="">Select State</option>
                                    <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">{{x.STATE_NM}}</option>
                                </select>
                            </td>

                            <td>
                                <select class="form-control validate" ng-model="obj.Act" ng-change="BindCompliance(obj.Act,obj.State, $index)">
                                    <option value="">Select Act</option>
                                    <option ng-repeat="x in AllActList[$index]" value="{{x.ActId}}">{{x.Act}}</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-control validate" ng-model="obj.ComplianceName">
                                    <option value="">Select Compliance</option>
                                    <option ng-repeat="x in AllComlist[$index]" value="{{x.CName}}">{{x.CName}}</option>
                                </select>
                            </td>

                            <td>

                                <select class="form-control validate" ng-model="obj.RegistrationType">
                                    <option value="">Select</option>
                                    <option value="Central">Central</option>
                                    <option value="State">State</option>
                                </select>

                            </td>

                            <td>

                                <input type="file"
                                       class="form-control-file"
                                       accept=".pdf,.doc,.jpg,.jpeg,.png"
                                       data-index="{{$index}}"
                                       onchange="angular.element(this).scope().handleFileUpload(this,'#file')"
                                       ng-model="obj.Upload">
                            </td>

                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-sm btn-add-row"
                                        ng-click="AddListSet()"
                                        ng-if="$last">
                                    <i class="bi bi-plus"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-remove-row"
                                        ng-click="RemoveListSet($index)"
                                        ng-if="ListSet.length > 1">
                                    <i class="bi bi-dash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

        <div class="small-table-wrapper" ng-show="showEntryForm==false">

            <div class="table-responsive rounded-3">
                <table class="table small-table" ng-init="Binddasboard()">
                    <thead>
                        <tr>
                            <th>State</th>
                            <th>Act Name</th>
                            <th>Compliance Name</th>
                            <th>Registration Type</th>
                            <th>Upload</th>
                            <th>Created On</th>
                        </tr>
                    </thead>
                    <tbody>


                        <tr ng-repeat="obj in dashboardlist | filter:Search">
                            <td>{{ obj.STATE_NM }}</td>
                            <td>
                                {{ obj.actname  }}
                            </td>
                            <td>{{obj.ComplianceName}}</td>
                            <td>{{ obj.RegistrationType }}</td>
                            <td>
                                <span ng-if="obj.Upoad">
                                    <a href="#" ng-click="viewFile(obj.Upoad)">
                                        Download
                                    </a>
                                </span>
                                <span ng-if="!obj.Upoad">No File</span>
                            </td>
                            <td>{{ obj.CreatedOn1}}</td>
                        </tr>
                        <tr ng-if="(dashboardlist | filter:Search).length === 0">
                            <td colspan="6" class="text-center text-danger fw-bold">
                                No Record Found
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</div>














