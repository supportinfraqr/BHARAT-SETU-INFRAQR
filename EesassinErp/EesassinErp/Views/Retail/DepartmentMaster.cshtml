
@{
    ViewBag.Title = "Department Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/scripts/RetailJsLib/DepartmentMasterController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<style>
    .dropdown-menu {
        display: block !important;
    }
</style>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Department Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Department Master</span></li>
            </ol>
        </div>
    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-init="AllPartySiteLoad()">
                                            <label class="control-label">Party Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlCustomerId" autocomplete='address-level2' class="select2 form-control validate" ng-model="PartyId">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in AllPartyList" value="{{x.PartyId}}">{{x.PartyName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div> 
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" >
                                            <label class="control-label">Department <span class="vd_red">*</span></label>
                                            <div class="input-box" ng-init="BindDepartment()"> 
                                                <div class="dropdown-container select2 form-control">
                                                    <button class="dropdown-button" ng-click="toggleDropdown()">
                                                        Select Department 
                                                        <span class="dropdown-arrow" ng-class="{'arrow-up': dropdownOpen, 'arrow-down': !dropdownOpen}">&#9660;</span>
                                                    </button>

                                                    <div class="dropdown-menu " style=" overflow: scroll; height: 200px;" ng-show="dropdownOpen">
                                                        <div ng-repeat="x in DepartmentList" class="dropdown-item">
                                                           
                                                            <label>
                                                                <input type="checkbox" ng-model="selectedDepartment[x.DepartmentId]" ng-change="updateDepartmentSelection(x)" />
                                                                {{x.DepartmentName}}
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @*<div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Start Date<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtStartDate" type="date" class="form-control clear validate" ng-model="StartDate" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">End Date</label>
                                            <div class="input-box">
                                                <input id="txtEndDate" type="date" class="form-control clear" ng-model="EndDate" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>*@
                                        <div class="col-lg-6 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Description</label>
                                            <div class="input-box">
                                                <textarea class="form-control clear" placeholder="" ng-model="Description"></textarea>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
