    @*ng-init="BindExecuter()">*@
    <div class="pagebody" >
    <div class="col-md-12 pageheader" >

    <a href="~/DownloadMat/ContractorMasterSheet.xlsx" class="download-btn" download >
    <i class="bi bi-download" > </i > Download Template
    </a >
    <div class="row mb-3" >
    <a href="" > </a >
    <div class="row g-3 align-items-end" >
    <!-- Financial Year -->
    <div class="col-md-2" >
    <div class="form-group" ng-init="BindFinacialYear();AllState();LoadStore()">
    <label for="ddlFinancialYear" class="form-label" > Financial Year</label >
    <select id="ddlFinancialYear" class="form-control form-select validate" ng-model="FY" ng-change="AllData()" >
    <option value="" > Select</option >
    <option ng-repeat="x in finacialyearList" value="{{x.FinancialName}}" > {{x.FinancialName}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <!-- Month -->
                    <div class="col-md-2">
                        <div class="form-group" ng-init="BindMonth();">
                            <label for="CMonth" class="form-label">Month</label>
                            <select id="CMonth" class="form-control form-select validate" ng-model="CMonth" ng-change="AllData()">
                                <option value="">Select</option>
                                <option ng-repeat="x in MonthList" value="{{x.MonthNumber}}">
                                    {{x.MonthName}}
                                </option>
                            </select>
                        </div>
                    </div>


                    <!-- Main Sheet Upload -->
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="input-excel" class="form-label">Upload Master Sheet</label>
                            <input type="file" id="input-excel" class="form-control"
                                   onchange="angular.element(this).scope().DisplayExcel()" />
                        </div>
                    </div>

                    <!-- Signature Upload -->
                    <div class="col-md-2">
                        <div class="form-group">
                            <label for="signatureFile" class="form-label">Signature</label>
                            <input type="file" id="signatureFile" class="form-control" />
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="form-label d-block">&nbsp;</label>
                            <button type="button" class="btn btn-warning w-100" ng-click="SaveRecord()">Submit</button>
                        </div>
                    </div>
                </div>



            </div>


