@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "AddContractorCompliance";
    Layout = "~/Views/Common/_RetailLayout.cshtml";
}
<style>
    .download-btn {
        display: inline-flex;
        align-items: center;
        background-color: #007bff;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.3s;
    }

    .download-btn:hover {
        background-color: #0056b3;
    }

    .download-btn i {
        margin-right: 8px;
    }
    </style >
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" > </script >
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" > </script >
   

    <script src="~/scripts/RetailJsLib/AddContractorComplianceController.js"></script>



