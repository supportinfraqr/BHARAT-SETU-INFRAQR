@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Establishment Report";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/ReportsDashboard/EstablishmentReport/script.js"></script>
<link href="~/ReportsDashboard/EstablishmentReport/style.css" rel="stylesheet" />

<div class="establishReportPage px-4 py-2">

    <h4 style="color: var(--primary)">Establishment Report</h4>

    <div class="card section-card ">
        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            State
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Delhi</a></li>
                            <li><a class="dropdown-item" href="#">Uttar Pradesh</a></li>
                            <li><a class="dropdown-item" href="#">Bihar</a></li>
                        </ul>
                    </div>

                    @*<div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Location
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Location 1</a></li>
                                <li><a class="dropdown-item" href="#">Location 2</a></li>
                            </ul>
                        </div>*@

                    <button class="btn btn-sm filter-btn active">Go</button>
                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="estRepSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" style="border-color: #E45D27" id="estRepSearchBtn" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>
                                <li><a class="dropdown-item" href="#">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table" id="estRepTable">
                        <thead>
                            <tr>
                                <th>Sr.No</th>
                                <th>Location Code</th>
                                <th>Ref Location Code</th>
                                <th>State</th>
                                <th>View</th>
                            </tr>
                        </thead>
                        <tbody id="estRepTableBody">
                            <tr>
                                <td>1</td>
                                <td>00004292</td>
                                <td>1234567</td>
                                <td>Uttar Pradesh</td>
                                <td>
                                    <button class="btn btn-sm view-btn" data-bs-toggle="modal" data-bs-target="#establishReportModal">
                                        View
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="estRepPaginationWrap">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm" id="estRepPrev" type="button">Previous</button>
                        <button class="btn btn-sm" id="estRepNext" type="button">Next</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="estRepPageInfo" style="font-size:0.85rem;color:#555;"></div>
                        <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ESTABLISHMENT REPORT VIEW MODAL -->
    <div class="modal fade establishReportModal"
         id="establishReportModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">
                    <h5 class="modal-title">Establishment Report Details</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body" style="background: var(--card-bg)">

                    <div class="card section-card">
                        <div class="card-body p-3 h-100 d-flex flex-column">

                            <!-- Toolbar -->
                            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                                <div class="d-flex align-items-center gap-2">
                                    @*<div class="dropdown">
                                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                State
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="#">Delhi</a></li>
                                                <li><a class="dropdown-item" href="#">Uttar Pradesh</a></li>
                                                <li><a class="dropdown-item" href="#">Bihar</a></li>
                                            </ul>
                                        </div>

                                        <div class="dropdown">
                                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                Location
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="#">Location 1</a></li>
                                                <li><a class="dropdown-item" href="#">Location 2</a></li>
                                            </ul>
                                        </div>

                                        <button class="btn btn-sm filter-btn active">Go</button>*@
                                </div>

                                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                                        <div class="input-group input-group-sm">
                                            <input id="estRepSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                                            <button class="btn btn-sm" style="border-color: #E45D27" id="estRepSearchBtn" type="button"><i class="bi bi-search"></i></button>
                                        </div>
                                    </div>

                                    <div>
                                        @*<div class="dropdown">
                                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item" href="#">CSV</a></li>
                                                    <li><a class="dropdown-item" href="#">PDF</a></li>
                                                    <li><a class="dropdown-item" href="#">Print</a></li>
                                                </ul>
                                            </div>*@
                                        <button class="btn btn-sm export-btn">Download All</button>
                                    </div>
                                </div>
                            </div>

                            <!-- TABLE -->
                            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0 small-table">
                                        <thead>
                                            <tr>
                                                <th style="width:40px;">
                                                    <input type="checkbox" />
                                                </th>
                                                <th>Document Name</th>
                                                <th>Document Type</th>
                                                <th>Act</th>
                                                <th>Form No.</th>
                                                <th>Criticality</th>
                                                <th>Frequency</th>
                                                <th style="width:120px;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <input type="checkbox" />
                                                </td>
                                                <td>Form B Delhi</td>
                                                <td>Register</td>
                                                <td>Shop and Commercial Establishment Act</td>
                                                <td>Form B</td>
                                                <td>High</td>
                                                <td>Monthly</td>
                                                <td class="action-col">
                                                    <i class="bi bi-download" title="Download"></i>
                                                    <i class="bi bi-printer" title="Print"></i>
                                                    <i class="bi bi-file-earmark-excel" title="Excel"></i>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>


</div>