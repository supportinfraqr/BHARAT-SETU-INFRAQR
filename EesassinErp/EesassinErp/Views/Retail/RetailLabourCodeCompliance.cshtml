<script>
    app.directive('fileModel', ['$parse', function ($parse) {
        return {
            restrict: 'A',
            scope: {
                fileModel: '=',
                rowContext: '=' // passing the row object
            },
            link: function (scope, element, attrs) {
                element.bind('change', function () {
                    scope.$parent.fileSelected(element[0].files, scope.rowContext);
                });
            }
        };
    }]);


</script>

