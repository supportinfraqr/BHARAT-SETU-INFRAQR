<div class="modal fade" id="complianceModal" tabindex="-1" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius: 10px; overflow: hidden; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">

            <!-- Header -->
            <div class="modal-header" style="background: linear-gradient(to right,  #E67624); padding: 14px 20px; ">
                <h5 class="modal-title" id="modalTitle" style="font-size: 1.5rem; font-weight: 700; color: white; margin: 0;">
                    Compliance Details
                </h5>

            </div>

            <!-- Body -->
            <div class="modal-body" ng-if="selectedCompliance" style="background: #fff; padding: 20px;">

                <div class="row mb-3">
                    <div class="col-md-6"><strong style="color:#444;">Rule:</strong> <span style="color:#007bff;">{{selectedCompliance.Rule}}</span></div>
                    <div class="col-md-6"><strong style="color:#444;">Section:</strong> <span style="color:#007bff;">{{selectedCompliance.Section}}</span></div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6"><strong style="color:#444;">Form No.:</strong> <span style="color:#007bff;"> {{selectedCompliance.FormNo}} </span></div>
                    <div class="col-md-6"><strong style="color:#444;">Risk:</strong> <span style="color: red; font-weight: bold;">{{selectedCompliance.Risk}}</span></div>
                </div>
               
                <div>
                    <strong style="color:#444;">Attachment:</strong><br>
                    <div ng-if="selectedCompliance.UploadedFilePath">
                        <a class="btn btn-sm btn-primary mt-2" href="#" ng-click="DownloadFile(selectedCompliance.UploadedFilePath)">
                            <i class="fa fa-download"></i> Download File
                        </a>
                    </div>
                    <div ng-if="!selectedCompliance.UploadedFilePath" style="color: #888; margin-top: 5px;">
                        No file uploaded.
                    </div>
                </div>
                <hr>
                <div class="mb-3">
                    <strong style="color:#444;">Detailed Compliance :</strong>
                    <p style="margin: 5px 0; font-size: 14px; color: #555;">{{selectedCompliance.DetailedCompliance || 'No Detailed Compliance available'}}</p>
                </div>
                <div class="mb-3">
                    <strong style="color:#444;">Impact on Employer (Narrative) :</strong>
                    <p style="margin: 5px 0; font-size: 14px; color: #555;">{{selectedCompliance.ImpactEmployer || 'No Impact on Employer (Narrative)  available'}}</p>
                </div>

                <div class="mb-3">
                    <strong style="color:#444;">Description:</strong>
                    <p style="margin: 5px 0; font-size: 14px; color: #555;">{{selectedCompliance.Description || 'No description available'}}</p>
                </div>


            </div>

            <!-- Footer -->
            <div class="modal-footer" style="background: #f9f9f9; padding: 12px 20px; border-top: 1px solid #eee;">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" ng-click="closeModal()" style="border-radius: 6px; padding: 6px 16px;">Close</button>
            </div>

        </div>

    </div>
</div>



