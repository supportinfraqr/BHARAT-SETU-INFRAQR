@{
    ViewBag.Title = "IndustryLicenseMapping";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/scripts/RetailJsLib/RetailIndustryMappingController.js"></script>
<style>
    .input-box {
        position: relative;
    }

    .form-control {
        width: 100%;
        height: 34px;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px;
        font-size: 14px;
        color: #333;
        background-color: #fff;
        cursor: pointer;
        outline: none;
    }

        .form-control[multiple] {
            height: auto;
        }

            .form-control[multiple] option[selected] {
                background-color: #007bff;
                color: #fff;
            }

            .form-control[multiple] option:hover {
                background-color: #f5f5f5;
            }
</style>

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Industry License Mapping</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Industry License Mapping</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">

                                        <div class="col-lg-4 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-init="AllIndustry()">
                                            <label class="control-label">Industry<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlIndustry" autocomplete='address-level2' class="select2 form-control validate" ng-model="IndustryId" ng-change="AllLicense()">
                                                    <option value="">Select Industry</option>
                                                    <option ng-repeat="x in IndustryList | filter:{ Industry: industry }" value="{{x.Id}}">{{x.Industry}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-show="IsOpen">
                                            <label class="control-label">License List<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <table id="tblNavMenu"
                                                       class="table compact table-hover table-striped table-bordered nowrap"
                                                       style="width:100%; table-layout:fixed;">

                                                    <thead style="display:table; width:100%; table-layout:fixed;">
                                                        <tr>
                                                            <th class="text-center w-50-p" style="width:50px;">
                                                                <div class="checkbox checkbox-primary table-check-wt">
                                                                    <input  
                                                                           type="checkbox"
                                                                           class="clear"
                                                                           ng-model="chkAll"
                                                                           ng-change="chkAllRow()" />
                                                                    <label></label>
                                                                </div>
                                                            </th>

                                                            <th class="srno" style="width:60px;">S.No.</th>
                                                            <th>License Name</th>
                                                        
                                                            <th>State</th>
                                                            <th>Act</th>
                                                        </tr>
                                                    </thead>

                                                    <tbody style="display:block; max-height:300px; overflow-y:auto; width:100%;">
                                                        <tr ng-repeat="x in OverallList"
                                                            repeat-done
                                                            style="display:table; width:100%; table-layout:fixed;">

                                                            <td class="text-center" style="width:50px;">
                                                                <div class="checkbox checkbox-primary table-check-wt">
                                                                  
                                                                    <input    type="checkbox" class="clear" id="chkAllow" ng-model="x.IsAllow" ng-checked="x.IsAllow"
                                                                           ng-change="chkRowAll($index)" />
                                                                    <label></label>
                                                                </div>
                                                            </td>


                                                            <td class="srno" style="width:60px;">
                                                                {{$index+1}}
                                                                <input type="hidden" value="{{x.LicenseId}}" />
                                                            </td>

                                                            <td>{{x.LicenseName}}</td>
                                                          
                                                            <td>{{x.State}}</td>
                                                            <td>{{x.Act}}</td>
                                                        </tr>
                                                    </tbody>
                                                </table>

                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>