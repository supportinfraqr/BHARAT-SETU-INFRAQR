                                <td>{{row.ComplianceName}}</td>
                                <td>{{row.STATE_NM}}</td>
                                <td>{{row.DueDate}}</td>
                                <td>{{row.ActualSubmissionDate}}</td>
                                <td>{{row.DelayDays}}</td>
                                <td>
                                    <span ng-show="row.CStatus=='Complied'" class="status completed">Complied</span>
                                    <span ng-show="row.CStatus=='Non Complied'" class="status pending">Non Complied</span>
                                    <span ng-show="row.CStatus==''" class="status pending">Pending</span>
                                    <span ng-show="row.CStatus=='Delay complied'" class="status delayed">Delay Complied</span>
                                    <span ng-show="row.CStatus=='Non-Applicable'" class="status delayed">Non-Applicable</span>

                                </td>

                                <td><a href="#" class="view" ng-show="row.openthis=='1'" ng-click="viewFile(row.UploadFile)">Download</a></td>
                            </tr>
                        </tbody>

                    </table>


