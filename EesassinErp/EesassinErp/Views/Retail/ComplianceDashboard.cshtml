<style>
    ::-webkit-scrollbar {
        display: none;
    }
    div#statutory {
        overflow: scroll;
        height: 351px;
    }
    .table th, .table td {
        text-align: left;
          padding: 5px !important;
        border-bottom: 1px solid #ddd;
    }
    div#internal {
        height: 351px;
        overflow: scroll;
    }
    ::-webkit-scrollbar {
        display: none;
    }
    .cardB {
        display: block; /* Ensures the div behaves as a block */
        height: 307px;
        overflow-y: auto;
    }
    .cardB {
        flex-grow: 1;
        min-height: 0; /* Prevents overflow issues inside flexbox */
    }
    .recontainer {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }
    canvas#riskMatrixChart {
        display: block;
        box-sizing: border-box;
         height: 100%;
           width: 100%
    }
    .view-all1 {
        float: right;
    }
    .view-all1 {
        display: block;
       
        padding: 15px;
        color: #dc3545;
        text-decoration: none;
        font-weight: bold;
    }
</style>
<div class="dashboard-container">
