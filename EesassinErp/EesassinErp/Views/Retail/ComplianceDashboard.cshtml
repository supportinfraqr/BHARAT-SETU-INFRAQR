                                <th>State Name</th>
                                <th>Due Date</th>
                                <th>Actual Submission Date</th>
                                <th>Delay Days</th>
                                <th>Status</th>
                                <th>Download File</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr ng-repeat="row in complianceRows | filter:{Calendartype : 'Statutory'}">
