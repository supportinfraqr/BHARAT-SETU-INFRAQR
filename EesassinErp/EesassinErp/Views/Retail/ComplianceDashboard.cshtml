</div>

<script>
    $(document).ready(function () {
        function Bindcompliancepie() {
            var collectionobj = {
                Action: 6,
                UserId: LoginId
            };

            $.ajax({
                type: "POST",
                url: "../Retail/SearchClientDashboard",
                contentType: "application/json",
                data: JSON.stringify({ obj: collectionobj }),
                success: function (response) {
                    debugger;
                    response = JSON.parse(response);
                    if (!response.Result || !response.Result || response.Result.length === 0) {
                        /*console.error("❌ Invalid API response:", response);*/
                        return;
                    }

                    var complete = Number(response.Result[0].CompletePercentage) || 0;
                    var pending = Number(response.Result[0].PendingPercentage) || 0;
                    var delayed = Number(response.Result[0].DelayedPercentage) || 0;

                  /*  console.log("📊 API Data -> Complete:", complete, "Pending:", pending, "Delayed:", delayed);*/

                    // Ensure chart updates **after DOM is ready**
                    updateChart(complete, pending, delayed);
                },
                error: function (xhr, status, error) {
                    console.error("❌ API request failed:", error);
                }
            });
        }

        function updateChart(complete, pending, delayed) {
            var ctx = $("#calendarChart");

            if (!ctx.length) {
                console.error("❌ Canvas element not found!");
                return;
            }

            // Destroy existing chart instance if any
            if (window.myPieChart) {
                window.myPieChart.destroy();
            }

            // Create new Chart
            window.myPieChart = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: ['Complied', 'Pending', 'Delay Complied'],
                    datasets: [{
                        data: [complete, pending, delayed],
                        backgroundColor: ['#2FBFDE', '#6463D6', '#F99C30']
                    }]
                }
            });

            console.log("✅ Chart updated successfully!");
        }

        // Run function after DOM is ready
        Bindcompliancepie();
    });
</script>