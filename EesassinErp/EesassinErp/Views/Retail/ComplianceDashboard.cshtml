@{
    ViewBag.Title = "Compliance Dashboard";
    Layout = "~/Views/Common/_RetailLayout.cshtml";
}
<link rel="stylesheet" href="~/ComplianceDashboard/css/style.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
<script src="~/ComplianceDashboard/script/script.js" defer></script>

<script src="~/scripts/RetailJsLib/StatutoryController.js?Ver=@ViewBag.Version"></script>
