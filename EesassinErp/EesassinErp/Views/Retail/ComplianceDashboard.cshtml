                            <strong ng-if="TotalCompliance ==0">0%</strong>
                            <div class="inner-box">
                                {{ TotalCompliance }}
                            </div>

                        </div>
                        <div class="card1">
                            Total Location<br><strong ng-if="StoreCount !=0">100%</strong>
                            <strong ng-if="StoreCount ==0">0%</strong>
                            <div class="inner-box1">
                                {{StoreCount}}
                            </div>

                        </div>
                        <div class="card2">
                            Complied<br><strong>{{CompliedPer}}%</strong>
                                        <div class="inner-box2">
                                            {{Complied}}
                                        </div>
                        </div>
                        <div class="card3">
                            Not Complied<br><strong>{{NotCompliedPer}}%</strong>
                                            <div class="inner-box3">
                                                {{REMAINDOC}}
                                            </div>
                        </div>

                    </section>
                </section>
            </div>
        </section>
        <br>



