@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Addcompliancefile";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<style>
    .download-btn {
        display: inline-flex;
        align-items: center;
        background: var(--primary);
        color: #fff;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 500;
        text-decoration: none;
        transition: background-color 0.3s;
    }
     
    .download-btn:hover {
        background-color: #0056b3;
    }

    .download-btn i {
        margin-right: 8px;
    }
    </style >
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" > </script >
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" > </script >
    <script src="~/scripts/RetailJsLib/AddcomplianceFileController.js" > </script >
    <div class="pagecontentbody">
       
        <div class="pagebody">
            <div class="col-md-12 pageheader" style=" margin-left: 7% !important; margin-top: 2%;">
                <h4 class="mb-4 " style="color: var(--primary)">Establishment Compliance </h4>
                <a href="~/DownloadMat/MasterSheet.xlsx" class="download-btn" download>
                    <i class="bi bi-download"> </i> Download Template
                </a>
                <div class="row mb-3">
                    <a href=""> </a>
                    <div class="row g-3 align-items-end">
                        <!-- Financial Year -->
                        <div class="col-md-2">
                            <div class="form-group" ng-init="BindFinacialYear();">
                                <label for="ddlFinancialYear" class="form-label"> Financial Year</label>
                                <select id="ddlFinancialYear" class="form-control form-select validate" ng-model="FY" ng-change="AllData()">
                                    <option value=""> Select</option>
                                    <option ng-repeat="x in finacialyearList" value="{{x.FinancialName}}">
                                        {{x.FinancialName}}
                                    </option>
                                </select>
                            </div>
                        </div>

                        <!-- Month -->
                        <div class="col-md-2">
                            <div class="form-group" ng-init="BindMonth();">
                                <label for="CMonth" class="form-label">Month</label>
                                <select id="CMonth" class="form-control form-select validate" ng-model="CMonth" ng-change="AllData()">
                                    <option value="">Select</option>
                                    <option ng-repeat="x in MonthList" value="{{x.MonthNumber}}">
                                        {{x.MonthName}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <!-- Category -->
                        <!-- Main Sheet Upload -->
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="input-excel" class="form-label">Upload Master Sheet</label>
                                <input type="file" id="input-excel" class="form-control"
                                       onchange="angular.element(this).scope().DisplayExcel()" />
                            </div>
                        </div>

                        <!-- Signature Upload -->
                        <div class="col-md-2">
                            <div class="form-group">
                                <label for="signatureFile" class="form-label">Signature</label>
                                <input type="file" id="signatureFile" class="form-control" />
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="col-md-2" ng-init="AllState();LoadStore()">
                            <div class="form-group">
                                <label class="form-label d-block">&nbsp;</label>
                                <button type="button" class="btn btn-sm filter-btn active" ng-click="SaveRecord()">Submit</button>
                            </div>
                        </div>
                    </div>



                </div>


