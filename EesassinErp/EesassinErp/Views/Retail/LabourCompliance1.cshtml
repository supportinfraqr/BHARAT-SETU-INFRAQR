@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Labour Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Masters/LabourCompliance/style.css" rel="stylesheet" />
<script src="~/Masters/LabourCompliance/script.js"></script>

<div class="labourCompPage px-4 py-2">
    <!-- ================= KPI Bar ================= -->
    <div class="container my-4 ">
        <div class="row g-3 justify-content-center">

            <!-- Complied -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Complied</div>
                    <div class="lb-kpi-value" id="kpiComplied">230</div>
                </div>
            </div>

            <!-- Non-Complied -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Non-Complied</div>
                    <div class="lb-kpi-value" id="kpiNonComplied">86</div>
                </div>
            </div>

            <!-- Delayed -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Delayed</div>
                    <div class="lb-kpi-value" id="kpiDelayed">68</div>
                </div>
            </div>

            <!-- Pending -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Pending</div>
                    <div class="lb-kpi-value" id="kpiPending">25</div>
                </div>
            </div>

            <!-- Verified -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Verified</div>
                    <div class="lb-kpi-value" id="kpiVerified">5</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="All, Act1 or Act2">
            <button type="button" class="btn btn-pill active" data-target="#allCard" aria-pressed="true">All</button>
            <button type="button" class="btn btn-pill" data-target="#act1Card" aria-pressed="false">Act1</button>
            <button type="button" class="btn btn-pill" data-target="#act2Card" aria-pressed="false">Act2</button>
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">
        <!-- ALL CARD (default visible) -->
        <div id="allCard" class="card section-card active">
            <h5 class="mb-4 " style="color: var(--primary)">All card </h5>
            <div class="card-body p-3 h-100 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                State
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Central</a></li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Status
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Complied</a></li>
                                <li><a class="dropdown-item" href="#">Non-complied</a></li>
                                <li><a class="dropdown-item" href="#">Delayed</a></li>
                                <li><a class="dropdown-item" href="#">Pending</a></li>
                                <li><a class="dropdown-item" href="#">Verified</a></li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Month
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">January</a></li>
                                <li><a class="dropdown-item" href="#">February</a></li>
                                <li><a class="dropdown-item" href="#">March</a></li>
                                <!-- ... -->
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Year
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">2025</a></li>
                                <li><a class="dropdown-item" href="#">2024</a></li>
                            </ul>
                        </div>

                        <button class="btn btn-sm filter-btn active">Go</button>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="lbSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                                <button class="btn btn-sm" id="lbSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div>
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="#">CSV</a></li>
                                    <li><a class="dropdown-item" href="#">PDF</a></li>
                                    <li><a class="dropdown-item" href="#">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="lbTable">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Act Name</th>
                                    <th>Compliance Name</th>
                                    <th>Month</th>
                                    <th>State</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Actual Submission Date</th>
                                    <th>Delay Days</th>
                                    <th>Upload File</th>
                                    <th>Upload Date</th>
                                    <th>Remarks</th>
                                    <th>Is Verified</th>
                                    <th>View</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="lbTableBody">
                                <tr>
                                    <td>1</td>
                                    <td>Professional Tax</td>
                                    <td><a href="#" class="store-code-link text-success">PTRC Payment</a></td>
                                    <td><a href="#" class="event-link text-success">Event</a></td>
                                    <td>Central</td>
                                    <td>dec 11</td>
                                    <!--Status column-->
                                    <td>
                                        <select class="form-select form-select-sm">
                                            <option value="">Select</option>
                                            <option>Complied</option>
                                            <option>Non-Complied</option>
                                            <option>Delayed</option>
                                            <option>Non-Applicable</option>
                                        </select>
                                    </td>
                                    <!--Actual Submission Date column-->
                                    <td>
                                        <input type="date" class="form-control form-control-sm">
                                    </td>
                                    <td>23</td>
                                    <!--Upload File column-->
                                    <td>
                                        <label class="btn btn-sm btn-upload px-3" style="white-space:nowrap; cursor:pointer;">
                                            Choose File
                                            <input type="file" hidden>
                                        </label>
                                    </td>
                                    <td>dec 11</td>
                                    <!--Remark column-->
                                    <td>
                                        <div class="d-flex align-items-center gap-2" style="min-width:150px;">
                                            <input type="text" class="form-control form-control-sm">
                                            <i class="bi bi-eye-fill" style="color:#E45D27" role="button" data-bs-toggle="modal" data-bs-target="#remarkModal"></i>
                                        </div>
                                    </td>
                                    <td>Yes/no</td>
                                    <!--View column-->
                                    <td>
                                        <button class="btn btn-sm btn-view">View</button>
                                    </td>
                                    <!--Actyion column-->
                                    <td>
                                        <button class="btn btn-sm btn-submit px-3">Submit</button>
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <!--<div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="scPaginationWrap">
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-primary" id="scPrev" type="button">Previous</button>
                            <button class="btn btn-sm btn-outline-primary" id="scNext" type="button">Next</button>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div id="scPageInfo" style="font-size:0.85rem;color:#555;"></div>
                            <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                        </div>
                    </div>-->
                </div>
            </div>
        </div>

        <!-- ================= Compliance Details Modal ================= -->
        <div class="modal fade" id="complianceDetailsModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                    <!-- Header -->
                    <div class="compDetail-header d-flex align-items-center">
                        <button type="button" class="btn compDetail-back-btn" data-bs-dismiss="modal">
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <h5 class="modal-title text-center flex-grow-1" style="color:#fff">Compliance Details</h5>
                    </div>

                    <!-- Body -->
                    <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Rule:</strong>
                                <div id="cd_rule" class="text-secondary">-</div>
                            </div>
                            <div class="col-md-6">
                                <strong>Section:</strong>
                                <div id="cd_section" class="text-secondary">-</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Form No.:</strong>
                                <div id="cd_form" class="text-secondary">-</div>
                            </div>
                            <div class="col-md-6">
                                <strong>Risk:</strong>
                                <div id="cd_risk" class="fw-bold text-danger">High</div>
                            </div>
                        </div>

                        <hr class="my-3">

                        <strong>Attachment:</strong>
                        <div id="cd_attachment" class="text-secondary mb-3">No file uploaded.</div>

                        <hr class="my-3">

                        <strong>Description:</strong>
                        <div id="cd_description" class="text-secondary" style="line-height:1.5;">
                            To report the financial performance of overseas Joint Ventures (JV) or Wholly Owned Subsidiaries...
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- ================= Event Modal ================= -->
        <div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                    <!-- Header -->
                    <div class="event-header d-flex align-items-center">
                        <button type="button" class="btn event-back-btn" data-bs-dismiss="modal">
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <h5 class="modal-title text-center flex-grow-1">Compliance Event</h5>
                    </div>

                    <!-- Body -->
                    <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">
                        <!-- Table wrapper -->
                        <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0 small-table" id="lbTable">
                                    <thead>
                                        <tr>
                                            <th>S.No</th>
                                            <th>Act Name</th>
                                            <th>Compliance Name</th>
                                            <th>Month</th>
                                            <th>State</th>
                                            <th>Due Date</th>
                                            <th>Status</th>
                                            <th>Actual Submission Date</th>
                                            <th>Delay Days</th>
                                            <th>Upload File</th>
                                            <th>Upload Date</th>
                                            <th>Remarks</th>
                                            <th>Is Verified</th>
                                            <th>View</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="lbTableBody">
                                        <tr>
                                            <td>1</td>
                                            <td>Goods & Services Act, 2017</td>
                                            <td><a href="#" class="store-code-link text-success">GSTR-1 (Outward Supply)</a></td>
                                            <td><a href="#" class="event-link text-success">Event</a></td>
                                            <td>Central</td>
                                            <td>dec 11</td>
                                            <!--Status column-->
                                            <td>
                                                <select class="form-select form-select-sm">
                                                    <option value="">Select</option>
                                                    <option>Complied</option>
                                                    <option>Non-Complied</option>
                                                    <option>Delayed</option>
                                                    <option>Non-Applicable</option>
                                                </select>
                                            </td>
                                            <!--Actual Submission Date column-->
                                            <td>
                                                <input type="date" class="form-control form-control-sm">
                                            </td>
                                            <td>23</td>
                                            <!--Upload File column-->
                                            <td>
                                                <label class="btn btn-sm btn-upload px-3" style="white-space:nowrap; cursor:pointer;">
                                                    Choose File
                                                    <input type="file" hidden>
                                                </label>
                                            </td>
                                            <td>dec 11</td>
                                            <!--Remark column-->
                                            <td>
                                                <div class="d-flex align-items-center gap-2" style="min-width:150px;">
                                                    <input type="text" class="form-control form-control-sm">
                                                    <i class="bi bi-eye-fill" style="color:#E45D27" role="button" data-bs-toggle="modal" data-bs-target="#remarkModal"></i>
                                                </div>
                                            </td>
                                            <td>Yes/no</td>
                                            <!--View column-->
                                            <td>
                                                <button class="btn btn-sm btn-view">View</button>
                                            </td>
                                            <!--Actyion column-->
                                            <td>
                                                <button class="btn btn-sm btn-submit px-3">Submit</button>
                                            </td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>

                        </div>

                    </div>

                    <div class="modal-footer d-flex justify-content-end">
                        <button type="button" class="btn btn-sm eventSubmitBtn">Add Event</button>
                    </div>

                </div>
            </div>
        </div>

        <!-- ================= Remark Modal ================= -->
        <div class="modal fade" id="remarkModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius:14px; overflow:hidden;">
                    <div style="background:#E45D27; padding:14px 20px;">
                        <h5 class="text-white m-0">Remark</h5>
                    </div>

                    <div class="modal-body" style="background:#FFF1EB;">
                        <textarea class="form-control" rows="5"></textarea>
                    </div>

                    <div class="modal-footer" style="background:#FFF1EB;">
                        <button type="button" class="btn btn-dark px-4" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>


        <!-- CARD 1 -->
        <div id="act1" class="card section-card d-none">
            <h5 class="mb-4" style="color: var(--primary)">card 1 </h5>
        </div>
        <!-- CARD 2 -->
        <div id="act2" class="card section-card d-none">
            <h5 class="mb-4" style="color: var(--primary)">card 2 </h5>
        </div>
    </div>

</div>
