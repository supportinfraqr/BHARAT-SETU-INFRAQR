
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Secretarial Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Masters/SecretarialCompliance/style.css" rel="stylesheet" />
<script src="~/Masters/SecretarialCompliance/script.js"></script>
<script src="~/scripts/RetailJsLib/SecretarialStatutoryController.js?Ver=@ViewBag.Version"></script>

<style>
    .toggle-pill {
        display: flex;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch; /* smooth scrolling on mobile */
        scrollbar-width: thin;
        scrollbar-color: #c96f2b transparent;
    }

        .toggle-pill::-webkit-scrollbar {
            height: 6px;
        }

        .toggle-pill::-webkit-scrollbar-thumb {
            background-color: #c96f2b;
            border-radius: 3px;
        }
</style>



<div class="secretarialCompPage px-4 py-2">
    <h4 class="mb-4 " style="color: var(--primary)">Secretarial Compliance </h4>
    <!-- ================= KPI Bar ================= -->
    <div class="container-fluid my-4 ">
        <div class="row g-3 justify-content-center">

            <!-- Total Compliance -->
            <div class="col-md-2">
                <div class="sc-kpi-card">
                    <div class="sc-kpi-title">Complied</div>
                    <div class="sc-kpi-value" id="kpiTotalCompliance">{{StatusCount.Complied}}</div>
                </div>
            </div>

            <!-- Pending -->
            <div class="col-md-2">
                <div class="sc-kpi-card">
                    <div class="sc-kpi-title">Non-Complied / Pending</div>
                    <div class="sc-kpi-value" id="kpiPending">{{StatusCount.NonComplied}} / {{StatusCount.Pending}}</div>
                </div>
            </div>

            <!-- Complied -->
            <div class="col-md-2">
                <div class="sc-kpi-card">
                    <div class="sc-kpi-title">Delay-Complied</div>
                    <div class="sc-kpi-value" id="kpiComplied">{{StatusCount.Delayed}}</div>
                </div>
            </div>

            <!-- Delayed -->
            <div class="col-md-2">
                <div class="sc-kpi-card">
                    <div class="sc-kpi-title">Non-Applicable</div>
                    <div class="sc-kpi-value" id="kpiDelayed">{{StatusCount.NonApplicable || 0}}</div>
                </div>
            </div>
            <!-- Delayed -->
            <div class="col-md-2">
                <div class="sc-kpi-card">
                    <div class="sc-kpi-title">Verified</div>
                    <div class="sc-kpi-value" id="kpiDelayed">{{StatusCount.Verified || 0}}</div>
                </div>
            </div>
            <!-- Delayed -->
            <div class="col-md-2">
                <div class="sc-kpi-card">
                    <div class="sc-kpi-title">Remarks</div>
                    <div class="sc-kpi-value" id="kpiDelayed">{{StatusCount.Remarks || 0}}</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Capsule Toggle (single capsule container) -->
    @*<div class="mb-3">
            <div class="toggle-pill" role="tablist" aria-label="All, Act1 or Act2">
                <button type="button" class="btn btn-pill active" data-target="#allCard" aria-pressed="true">All</button>
                <button type="button" class="btn btn-pill" data-target="#act1Card" aria-pressed="false">Act1</button>
                <button type="button" class="btn btn-pill" data-target="#act2Card" aria-pressed="false">Act2</button>
            </div>
        </div>*@
    <!-- Dynamic sections -->
    <div class="section-wrap">
        <!-- ALL CARD (default visible) -->
        <div id="allCard" class="card section-card active">
            <div class="card-body p-3 h-100 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{SelectedAct || 'Act'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="act in ActList track by $index">
                                    <a class="dropdown-item" href="javascript:void(0)" ng-click="getAct(act)">
                                        {{act}}
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{SelectedState || 'State'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="state in StateList track by $index">
                                    <a class="dropdown-item" href="javascript:void(0)" ng-click="getstate(state)">{{state}}</a>
                                </li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{SelectedStatus || 'Status'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="status in StatusList track by $index">
                                    <a class="dropdown-item"
                                       href="javascript:void(0)"
                                       ng-click="getstatus(status)">
                                        {{status}}
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{SelectedMonth || 'Month'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="month in MonthList track by $index">
                                    <a class="dropdown-item" href="javascript:void(0)" ng-click="getmonth(month)">
                                        {{month}}
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                {{SelectedYear || 'Year'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="year in YearsList track by $index">
                                    <a class="dropdown-item" href="javascript:void(0)" ng-click="getyear(year)">{{year}}</a>
                                </li>
                            </ul>
                        </div>
                        @*<button ng-click="BindSearch()" class="btn btn-sm filter-btn active">Search</button>*@

                        <button class="btn btn-sm filter-btn active"
                                ng-click="reset()">
                            Reset
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="scSearch" type="text" class="form-control form-control-sm" placeholder="Search..." ng-model="search" />
                                <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>
                        <div>
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" ng-click="NewExportTableToCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" ng-click="NEwPrintTable()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table custom-table" id="scTable" ng-init="BindSearch()">
                            <thead>
                                <tr style="background-color: #F37437">
                                    <th>S.No</th>
                                    <th>Act Name</th>
                                    <th>Compliance Name</th>
                                    <th> Risk  </th>
                                    <th> Frequency  </th>
                                    <th>Month</th>
                                    <th>State</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Actual Submission Date</th>
                                    <th>Delay Days</th>
                                    <th>Upload File</th>
                                    <th>Upload Date</th>
                                    <th>Remark</th>
                                    <th>Verification Status</th>
                                    <th>Download</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="row in complianceRows |  filter:search | filter:{Act:selectedAct}">
                                    <td>{{$index + 1}}</td>
                                    <td>{{row.Act}}</td>
                                    <td class="store-code-link text-success" ng-click="openComplianceModal(row)"> {{row.ComplianceName}}</td>
                                    @*<td>
                                        <a href="javascript:void(0)"
                                           class="store-code-link text-success"
                                           ng-click="openComplianceModalrow">
                                            {{row.ComplianceName}}
                                        </a> </td>*@
                                    <td>{{row.Risk}}</td>
                                    <td>
                                        <a href="#"
                                           ng-if="row.Frequency == 'Event'"
                                           class="event-link text-success"
                                           ng-click="openEventModal(row);">
                                            {{row.Frequency}}
                                        </a>

                                        <span ng-if="row.Frequency != 'Event'">
                                            {{row.Frequency}}
                                        </span>
                                    </td>
                                    <td>{{row.Month}}</td>
                                    <td>{{row.STATE_NM}}</td>
                                    <td>{{row.DueDate}}</td>
                                    <td>
                                        <select class="form-select form-select-sm" ng-model="row.CStatus" ng-disabled="row.Flag===1 || SC_allowupdfile===false">
                                            <option value="">Select</option>
                                            <option value="Complied">Complied</option>
                                            <option value="Non Complied">Non-Complied</option>
                                            <option value="Delay Complied">Delay-Complied</option>
                                            <option value="Non Applicable">Non-Applicable</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input date-input type="date" style="width:auto" class="form-control no-print" id="ActualSubmissionDate{{$index}}" ng-model="row.ActualSubmissionDate" ng-disabled="row.Flag===1 || SC_allowupdfile===false">
                                        <p ng-show="false">{{ row.ActualSubmissionDate | date:'yyyy-MM-dd' }}</p>
                                    </td>
                                    <td>{{ row.DelayDays ? row.DelayDays : 0 }}</td>
                                    @*<td>
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                                <div class="input-box">
                                                    <div style="display: flex; align-items: center;">
                                                        <label ng-click="SetValue(row,'#fileupoad'+$index);ManageLog('Upload File'+row.Act)" class="btn btn-sm btn-upload px-3" style="white-space:nowrap; cursor:pointer;">
                                                            Choose File
                                                        </label>
                                                        <input type="file"
                                                               id="fileupoad{{$index}}" style="display:none"
                                                               file-model="row.UploadFile"
                                                               ng-change="fileSelected(row.UploadFile, row)"
                                                               ng-model="row.UploadFile" />


                                                        <i class="fa fa-upload"
                                                           style="color: green; margin-left: 10px;"
                                                           ng-if="row.UploadFile"></i>
                                                    </div>


                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <p ng-show="false">
                                                {{ row.UploadFile ? 'Uploaded' : 'Not Uploaded' }}
                                            </p>
                                        </td>*@
                                    <td class="no-print">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                            <div class="input-box">
                                                <div style="display: flex; align-items: center;">
                                                    <button ng-disabled="row.Flag===1 || SC_allowupdfile===false" class="btn btn-sm btn-upload px-3 uploadbtn"
                                                            ng-click="SetValue(row,'#fileupoad'+$index);ManageLog('Upload File'+row.Act)">
                                                        <div ng-if="!row.UploadFile">Choose File</div>
                                                        <div ng-if="row.UploadFile">Uploaded</div>
                                                    </button>

                                                    <input type="file"
                                                           id="fileupoad{{$index}}"
                                                           file-model="row.UploadFile"
                                                           row-context="row"
                                                           style="display:none;" />

                                                </div>


                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <p ng-show="false">
                                            {{ row.UploadFile ? 'Uploaded' : 'Not Uploaded' }}
                                        </p>
                                    </td>
                                    <td>{{row.CreateOn}}</td>
                                    @*<td class="no-print">
                                            <input ng-if="IsExecuter!='Executer'" ng-model="row.CRemark1" type="text" class="form-control form-control-sm" id="CRemark" style="font-size:10px" />
                                            <input ng-model="row.VRemark1" type="text" class="form-control form-control-sm" id="VRemark" style="font-size:10px" ng-disabled="row.Flag=='1'" />
                                            <p ng-if="IsExecuter=='Executer' && row.CRemark !='' ">
                                                {{row.UserName}} (Reviewer) Remarks :
                                                <i class="fa fa-eye" style="cursor: pointer; color: #E45D27" ng-click="openRemarkModal(row.CRemark,'Client Remark')"></i>
                                            </p>
                                            <p ng-if="row.VRemark !=''">
                                                {{row.UserName}} Executer Remark :
                                                <i class="fa fa-eye" style="cursor:pointer; color:#E45D27" ng-click="openRemarkModal(row.VRemark,'Executer Remark')"></i>
                                            </p>
                                        </td>*@
                                    <td class="no-print">
                                        <div class="d-flex align-items-center gap-2">
                                            <input class="form-control form-control-sm" ng-model="row.VRemark1" ng-disabled="row.Flag==='1'" type="text" id="VRemark" style="font-size:10px" />

                                            <i ng-if="row.VRemark !=''" class="bi bi-eye-fill" style="cursor: pointer; color: #F37437" ng-click="openRemarkModal(row.VRemark,'Client Remark')"></i>
                                        </div>
                                    </td>
                                    @*<td class="no-print">
                                            <select class="form-control no-print" ng-model="row.IsVerified" ng-if="IsExecuter !='Executer'">
                                                <option value="">Select</option>
                                                <option value="Verified">Verified</option>
                                                <option value="Remarks">Remarks</option>
                                            </select>
