        left: 35px;
        z-index: 4;
        background: var(--card-bg);
        width: 195px;
        min-width: 195px;
        max-width: 195px;
    }

    .labourCompPage .custom-table tbody td:nth-child(3) {
        position: sticky;
        left: 230px; /* 35 + 195 */
        z-index: 3;
        background: var(--card-bg);
