                    <div class="fn-kpi-title">Non-Applicable</div>
                    <div class="lb-kpi-value">{{TotalNonApplicable}}</div>
                </div>
            </div>

            <!-- Verified -->
            <div class="col-md-2">
                <div class="fn-kpi-card d-flex">
                    <div class="fn-kpi-title">Verified</div>
                    <div class="lb-kpi-value">{{TotalVerified}}</div>
                </div>
            </div>
            <!-- Verified -->
            <div class="col-md-2">
                <div class="fn-kpi-card d-flex">
                    <div class="fn-kpi-title">Remarks</div>
                    <div class="lb-kpi-value">{{TotalClarification}}</div>
                </div>
            </div>
        </div>
