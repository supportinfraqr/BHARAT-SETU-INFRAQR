@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Finance Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/scripts/RetailJsLib/FinacialStatutoryController.js?Ver=@ViewBag.Version"></script>
<link href="~/Masters/FinanceCompliance/style.css" rel="stylesheet" />
<script src="~/Masters/FinanceCompliance/script.js"></script>
<script>
    app.directive('fileModel', function () {
        return {
            restrict: 'A',
            scope: {
                fileModel: '=',
                rowContext: '='
            },
            link: function (scope, element) {
                element.on('change', function () {
                    const files = element[0].files;
                    scope.$apply(function () {
                        if (!files || files.length === 0) {
                            scope.fileModel = null;
                            return;
                        }
                        scope.fileModel = files[0];

                        console.log("Row from directive:", scope.rowContext);

                        if (scope.$parent.fileSelected) {
                            scope.$parent.fileSelected(files, scope.rowContext);
                        }
                    });
                    element.val(null);
                });
                scope.$on('$destroy', function () {
                    element.off('change');
                });
            }
        };
    });
</script>
<style>
