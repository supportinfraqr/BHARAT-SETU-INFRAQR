@*<script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="~/scripts/angular.min.js"></script>*@
<script src="https://cdn.jsdelivr.net/npm/chart.js" defer></script>
<script>
    app.directive('fileModel', ['$parse', function ($parse) {
        return {
            restrict: 'A',
            scope: {
                fileModel: '=',
                rowContext: '=' // passing the row object
            },
            link: function (scope, element, attrs) {
                element.bind('change', function () {
                    scope.$parent.fileSelected(element[0].files, scope.rowContext);
                });
            }
        };
    }]);


</script>

<style>
    .filters button {
        padding: 8px 16px;
        background: #6f42c1;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        margin-right: 3px !important;
    }
  

    .table th, .table td {
        text-align: left;
        padding: 4px;
        border-bottom: 1px solid #ddd;
    }

    input#Remark {
        font-size: 10px;
    }

    .form-control {
        padding: 0.075rem 0.25rem !important;
    }

    #complianceTable thead th {
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 10;
    }

    .table > thead > tr > th, .table > tbody > tr > td {
        font-size: 12px;
    }
    /* Styling the container */
    .file-upload-container {
        position: relative;
        display: inline-block;
    }

    /* Hide the default file input */
    input[type="file"] {
        display: none;
    }

    /* Style the label that looks like a button */
    .file-upload-label {
        display: inline-block;
        background-color: #4CAF50;
        color: white;
        font-size: 12px;
        font-weight: bold;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        /* Hover effect for the label */
        .file-upload-label:hover {
            background-color: #45a049;
        }

        /* Optional: Add some text or icon next to the label for better UX */
        .file-upload-label:before {
            content: "📄 ";
        }

    .compliance-summary5 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: -22px;
        width: 100%;
        height: 100% !important
    }


    tbody td {
        height: 35px !important;
        font-size: 12px !important;
        vertical-align: middle !important;
        padding: 4px 6px !important;
    }
</style>
<style>
    .search-row {
        position: sticky;
        top: 35px; /* Adjust based on the height of your header row */
        background: #fff;
        z-index: 10;
    }

    thead tr:last-child {
        position: sticky;
        top: 0;
        background: #f1f1f1;
        z-index: 11;
    }

    #complianceTable th,
    #complianceTable td {
        height: 40px;
        vertical-align: middle;
    }
</style>

<div class="dashboard-container">
    <!-- Main Content -->
    <main class="main-content">
        <!-- Header -->
        <!-- Overview Cards -->
        <!-- Graphs and Statistics -->
        <!-- Statutory Due Dates Summary -->
        <section class="compliance-summary5" style="position:relative">

            <div class="container">
                <!-- Tabs -->
                <div class="tabs">
                    <div class="tab active" data-tab="statutory">Statutory Due Dates</div>
                    @*<div class="tab" data-tab="internal">Internal Due Dates</div>*@
                </div>

                <!-- Statutory Content -->
                <div class="content active" id="statutory">
                    <!-- Filters -->


                    <div class="filters">
                        <div ng-init="BindFilter()">
                            <select ng-model="State">
                                <option value="">Select</option>
                                <option ng-repeat="x in SMasterList  | unique:'State'" value="{{x.State}}"> {{x.STATE_NM}}  </option>
                            </select>
                            <select ng-model="Month">
                                <option value="">Select</option>
                                <option ng-repeat="x in SMasterList  | unique:'Month'" value="{{x.Month}}"> {{x.Month}}  </option>
                            </select>
                            <select ng-model="Year">
                                <option value="">Select</option>
                                <option ng-repeat="x in YearsList | orderBy: '-'" value="{{x}}"> {{x}}  </option>
                            </select>
                        </div>
                        <button ng-click="BindSearch()">Search</button>
                        <div style=" color: #fff; border: none; border-radius: 5px; background: #6f42c1; ">
                            <a href="#" class="btn expbtn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" style="margin-top: 2px; color: #fff; background: #6f42c1; ">Export</a>
                            <ul class="dropdown-menu escalul" aria-labelledby="escalbtnLink">
                                <li><a ng-click="ExportTableToExcel();ManageLog('Export in Excel')" class="dropdown-item">Export in Excel</a></li>

                                <li><a class="dropdown-item" ng-click="PrintTable();ManageLog('Export in PDF')">Export in PDF</a></li>
                            </ul>
                        </div>
                         <!-- <button><a style="color: #fff;" href="../Retail/SecretarialStatutorySetup?Secretarial Statutory Setup">Go to Setup</a></button>-->



                    </div>


                    <!-- Table -->
                    <div style="max-height: 700px; overflow-y: auto;">
                        <table id="complianceTable" class="table table-bordered table-striped display" ng-init="BindSearch()">
