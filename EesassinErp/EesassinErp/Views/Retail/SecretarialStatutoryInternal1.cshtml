                                <tr>
                                    <th>SNo</th>
                                    <th>Act Name</th>
                                    <th>Compliance Name</th>
                                    <th>Month</th>
                                    <th>State Name</th>
                                    <th>DueDate</th>
                                    <th>Status</th>
                                    <th>Actual Submission Date</th>
                                    <th>Delay Days</th>
                                    <th ng-if="IsExecuter=='Executer'">UploadFile</th>
                                    <th>Upload Date</th>
                                    <th class="no-print">Remark </th>
                                    <TH>IsVerified</TH>
                                    <th>View File</th>
                                    <th class="no-print">Action</th>
                                </tr>

                            </thead>
                            <tbody>

                                <tr ng-repeat="row in complianceRows | filter:{Calendartype : 'Statutory'} | filter:search">
                                    <td>{{row.SNo}}</td>
                                    <td>{{row.Act}}</td>
                                    <td>{{row.ComplianceName}}</td>
                                    <td>{{row.Month}}</td>
                                    <td>{{row.STATE_NM}}</td>
                                    <td>{{row.DueDate}}</td>
                                    <td>
                                        <select class="form-control no-print" ng-model="row.CStatus" ng-disabled="IsExecuter!='Executer' || row.Flag=='1'">
                                            <option value="">Select </option>
                                            <option value="Complied">Complied </option>
                                            <option value="Non Complied">Non Complied </option>
                                            <option value="Delay complied">Delay complied </option>
                                            <option value="Non-Applicable">Non-Applicable</option>
                                        </select>
                                        <p ng-show="false">{{row.CStatus}}</p>
                                    </td>
                                    <td>
                                        <input date-input type="date" style="width:auto" class="form-control no-print" id="ActualSubmissionDate{{$index}}" ng-model="row.ActualSubmissionDate" ng-disabled="IsExecuter!='Executer'  || row.Flag=='1'">
                                        <p ng-show="false">{{ row.ActualSubmissionDate | date:'yyyy-MM-dd' }}</p>
                                    </td>
                                    <td>{{row.DelayDays}}</td>
                                    <td ng-if="IsExecuter=='Executer'">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                            <div class="input-box">
                                                <div style="display: flex; align-items: center;">
                                                    <button class="uploadbtn" ng-disabled="row.Flag=='1'"
                                                            ng-click="SetValue(row,'#fileupoad'+$index);ManageLog('Upload File'+row.Act)">
                                                        Choose File
                                                    </button>

                                                    <input type="file"
                                                           id="fileupoad{{$index}}"
                                                           file-model="row.UploadFile"
                                                           ng-change="fileSelected(row.UploadFile, row)"
                                                           ng-model="row.UploadFile" />


                                                    <i class="fa fa-upload"
                                                       style="color: green; margin-left: 10px;"
                                                       ng-if="row.UploadFile"></i>
                                                </div>


                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <p ng-show="false">
                                            {{ row.UploadFile ? 'Uploaded' : 'Not Uploaded' }}
                                        </p>
                                    </td>

                                    <td>{{row.CreateOn}}</td>
                                    <td class="no-print">
                                        <input ng-if="IsExecuter!='Executer'" ng-model="row.CRemark1" type="text" id="CRemark" style="font-size:10px" />
                                        <input ng-if="IsExecuter=='Executer'" ng-model="row.VRemark1" type="text" id="VRemark" style="font-size:10px" ng-disabled="row.Flag=='1'" />
                                        <p ng-if="IsExecuter=='Executer' && row.CRemark !='' ">
                                            {{row.UserName}} (Reviewer) Remarks :
                                            <i class="fa fa-eye" style="cursor:pointer; color:blue" ng-click="openRemarkModal(row.CRemark,'Client Remark')"></i>
                                        </p>
                                        <p ng-if="IsExecuter!='Executer' && row.VRemark !=''">
                                            {{row.UserName}} Executer Remark :
                                            <i class="fa fa-eye" style="cursor:pointer; color:blue" ng-click="openRemarkModal(row.VRemark,'Executer Remark')"></i>
                                        </p>
                                    </td>
                                    <td class="no-print">


                                        <select class="form-control no-print" ng-model="row.IsVerified" ng-if="IsExecuter !='Executer'">
                                            <option value="">Select</option>
                                            <option value="Verified">Verified</option>
                                            <option value="Clarify">Under Clarification</option>
                                        </select>
                                        <span ng-if="IsExecuter=='Executer'" ng-show="row.IsVerified=='Verified' && row.Flag=='1'" class="status completed">Verified</span>
                                        <span ng-if="IsExecuter=='Executer'" ng-show="row.IsVerified=='Clarify' && IsExecuter=='Executer'" class="status pending">Under Clarification</span>
                                    </td>
                                    <td ng-show="false">
                                        {{row.IsVerified}}
                                    </td>
                                    <td><a href="#" class="view" ng-show="row.openthis=='1'" ng-click="viewFile(row)">{{ row.openthis == '1' ? 'View' : '' }}</a> </td>
                                    <td class="no-print">

                                        <input ng-if="IsExecuter=='Executer' && row.Flag!='1'" type="button" value="Submit" ng-click="AfterverifyRecord(row )" />
                                        <input ng-if="IsExecuter !='Executer' && row.IV =='' " type="button" value="Submit" ng-click="AfterverifyRecord(row )" />

                                    </td>
                                </tr>

                            </tbody>
                        </table>

