
@{
    ViewBag.Title = "Secretarial Statutory Internal";
    Layout = "~/Views/Common/_RetailLayout.cshtml";
}

<script src="~/scripts/RetailJsLib/SecretarialStatutoryController.js?Ver=@ViewBag.Version"></script>
<link rel="stylesheet" href="~/ComplianceDashboard/css/style.css">
<link rel="stylesheet" href="~/ComplianceDashboard/css/style.css">

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
