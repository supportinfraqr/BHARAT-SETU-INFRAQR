    <div class="modal fade" id="complianceModal" tabindex="-1" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="border-radius: 10px; overflow: hidden; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">

                <!-- Header -->
                <div class="modal-header" style="background: linear-gradient(to right,  #E67624); padding: 14px 20px; ">
                    <h5 class="modal-title" id="modalTitle" style="font-size: 1.5rem; font-weight: 700; color: white; margin: 0;">
                        Compliance Details
                    </h5>

                </div>

                <!-- Body -->
                <div class="modal-body" ng-if="selectedCompliance" style="background: #fff; padding: 20px;">

                    <div class="row mb-3">
                        <div class="col-md-6"><strong style="color:#444;">Rule:</strong> <span style="color:#007bff;">{{selectedCompliance.Rule}}</span></div>
                        <div class="col-md-6"><strong style="color:#444;">Section:</strong> <span style="color:#007bff;">{{selectedCompliance.Section}}</span></div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6"><strong style="color:#444;">Form No.:</strong> <span style="color:#007bff;"> {{selectedCompliance.Forms}} </span></div>
                        <div class="col-md-6"><strong style="color:#444;">Risk:</strong> <span style="color: red; font-weight: bold;">{{selectedCompliance.Risk}}</span></div>
                    </div>

                    <div>
                        <strong style="color:#444;">Attachment:</strong><br>
                        <div ng-if="selectedCompliance.UploadedFilePath">
                            <a class="btn btn-sm btn-primary mt-2" href="#" ng-click="DownloadFile(selectedCompliance.UploadedFilePath)">
                                <i class="fa fa-download"></i> Download File
                            </a>
                        </div>
                        <div ng-if="!selectedCompliance.UploadedFilePath" style="color: #888; margin-top: 5px;">
                            No file uploaded.
                        </div>
                    </div>
                    <hr>

                    <div class="mb-3">
                        <strong style="color:#444;">Description:</strong>
                        <p style="margin: 5px 0; font-size: 14px; color: #555;">{{selectedCompliance.Description || 'No description available'}}</p>
                    </div>


                </div>

                <!-- Footer -->
                <div class="modal-footer" style="background: #f9f9f9; padding: 12px 20px; border-top: 1px solid #eee;">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" ng-click="closeModal()" style="border-radius: 6px; padding: 6px 16px;">Close</button>
                </div>

            </div>

        </div>
    </div>
    <!-- ================= Event Modal ================= -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                <!-- Header -->
                <div class="event-header d-flex align-items-center">
                    <button type="button" class="btn event-back-btn" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left"></i>
                    </button>

                    <h5 class="modal-title text-center flex-grow-1">Compliance Event</h5>
                </div>

                <!-- Body -->
                <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">
                    <!-- Table wrapper -->
                    <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 small-table" id="scTable">
                                <thead>
                                    <tr>
                                        <th>S.No</th>
                                        <th>Act Name</th>
                                        <th>Compliance Name</th>
                                        <th> Risk  </th>
                                        <th> Frequency  </th>
                                        <th>Month</th>
                                        <th>State</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                        <th>Actual Submission Date</th>
                                        <th>Delay Days</th>
                                        <th>Upload File</th>
                                        <th>Upload Date</th>
                                        <th>Remark</th>
                                        <th>Verification Status</th>
                                        <th>Download</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="scTableBody">
                                    <tr ng-repeat="event in selectedEvent1">

                                        <td>
                                            {{$index + 1}}
                                            <input type="hidden" ng-model="event.CRemark1">
                                        </td>

                                        <td>{{event.Act}}</td>

                                        <td>{{event.ComplianceName}}</td>

                                        <td>{{event.Risk}}</td>

                                        <td>{{event.Frequency}}</td>

                                        <td>{{event.Month}}</td>

                                        <td>{{event.STATE_NM}}</td>

                                        <td>{{ event.DueDate | date:'dd-MM-yyyy' }}</td>

                                        <td>
                                            <select class="form-select form-select-sm"
                                                    ng-model="event.CStatus"
                                                    ng-disabled="event.Flag===1 || allowupdfile===false">
                                                <option value="">Select </option>
                                                <option value="Complied">Complied</option>
                                                <option value="Non Complied">Non-Complied</option>
                                                <option value="Delay Complied">Delay-Complied</option>
                                                <option value="Non Applicable">Non-Applicable</option>
                                            </select>
                                        </td>

                                        <td>

                                            <input date-input type="date" style="width:auto" class="form-control form-control-sm no-print" ng-model="event.ActualSubmissionDate" ng-disabled="event.Flag===1 || allowupdfile===false">
                                            <p ng-show="false">{{ event.ActualSubmissionDate | date:'yyyy-MM-dd' }}</p>

                                        </td>

                                        <td>{{ event.DelayDays ? event.DelayDays : 0 }}</td>

                                        <!-- Upload File -->
                                        <td class="no-print">
                                            <button ng-disabled="event.Flag===1 || allowupdfile===false"
                                                    class="btn btn-sm btn-upload px-3 uploadbtn"
                                                    ng-click="SetValue(event,'#fileupoad_event'+$index)">

                                                <span ng-if="!event.UploadFile">Choose File</span>
                                                <span ng-if="event.UploadFile">Uploaded</span>
                                            </button>

                                            <input type="file"
                                                   id="fileupoad_event{{$index}}"
                                                   file-model="event.UploadFile"
                                                   row-context="event"
                                                   style="display:none;" />
                                        </td>

                                        <td>{{event.CreateOn | date:'dd-MM-yyyy' }}</td>

                                        <!-- Remarks -->
                                        <td class="no-print">
                                            <div class="d-flex align-items-center gap-2">
                                                <input class="form-control form-control-sm"
                                                       ng-model="event.VRemark1"
                                                       type="text"
                                                       style="font-size:10px" ng-disabled="event.Flag===1" />

                                                <i ng-if="event.VRemark !=''"
                                                   class="bi bi-eye-fill"
                                                   style="cursor:pointer;color:#F37437"
                                                   ng-click="openRemarkModal1(event.VRemark,'Client Remark')">
                                                </i>
                                            </div>
                                        </td>

                                        <!-- Verified -->
                                        <td class="no-print">
                                            <select class="form-select form-select-sm"
                                                    ng-model="event.IsVerified"
                                                    ng-class="{'text-success': event.IsVerified === 'Verified','text-danger': event.IsVerified === 'Remarks'}" ng-disabled="event.Flag===1 || allowverifyflag===false">
                                                <option value="">Select</option>
                                                <option value="Verified">Verified</option>
                                                <option value="Remarks">Remarks</option>
                                            </select>
                                        </td>

                                        <!-- View -->
                                        <td class="no-print">
                                            <a href=""
                                               class="view"
                                               style="color:#F37437"
                                               ng-show="event.openthis == '1' && event.UploadFile"
                                               ng-click="viewFile(event, $event)">
                                                Download File
                                            </a>
                                        </td>

                                        <!-- Action -->
                                        <td class="no-print">
                                            <input class="btn btn-sm btn-submit px-3"
                                                   type="button"
                                                   value="Submit"
                                                   ng-hide="event.Flag===1" ng-disabled="!FM_EditFlag"
                                                   ng-click="AddEventNewverifyRecord(event)" />
                                        </td>

                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>

                </div>

                <div class="modal-footer d-flex justify-content-end">
                    <button type="button" class="btn btn-sm eventSubmitBtn" ng-click="addEventRow()">Add Event</button>
                </div>

            </div>
        </div>
    </div>

