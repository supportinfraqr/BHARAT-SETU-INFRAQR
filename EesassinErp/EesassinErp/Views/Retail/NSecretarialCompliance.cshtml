@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Labour Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Masters/LabourCompliance/style.css" rel="stylesheet" />
<script src="~/Masters/LabourCompliance/script.js"></script>
<script src="~/scripts/RetailJsLib/Sacretrialcompliancecontroller.js?Ver=@ViewBag.Version"></script>
<script>
  app.directive('fileModel', ['$parse', function ($parse) {
        return {
            restrict: 'A',
            scope: {
                fileModel: '=',
                rowData: '='   // 👈 row pass karenge
            },
            link: function (scope, element) {

                element.bind('change', function () {

                    scope.$apply(function () {
                        scope.fileModel = element[0].files;
                    });

                    scope.$parent.fileSelected(element[0].files, scope.rowData);
                });
            }
        };
    }]);</script>
<style>
    .table-container {
        max-height: 450px;
        overflow-y: auto;
        overflow-x: auto;
        position: relative;
    }

    input[type="file"] {
        display: none;
    }

    .custom-table {
        min-width: 2000px; /* Column zyada ho to width badhao */
    }

        .custom-table th,
        .custom-table td {
            white-space: nowrap;
        }

        .custom-table thead th:nth-child(1),
        .custom-table thead th:nth-child(2),
        .custom-table thead th:nth-child(3),
        .custom-table thead th:nth-child(4) 
        {
            z-index: 30;
        }

        .custom-table thead th {
            position: sticky;
            top: 0;
            background: #F37437; /* same as header color */
            color: white;
            z-index: 20;
        }

     
</style>

<style>
    /* Column width fix */
    .custom-table th:nth-child(1),
    .custom-table td:nth-child(1) {
        min-width: 60px;
    }

    .custom-table th:nth-child(2),
    .custom-table td:nth-child(2) {
        min-width: 160px;
    }

    .custom-table th:nth-child(3),
    .custom-table td:nth-child(3) {
        min-width: 220px;
    }

    .custom-table th:nth-child(4),
    .custom-table td:nth-child(4) {
        min-width: 180px;
    }

    /* Sticky Columns */

    /* Column 1 */
    .custom-table th:nth-child(1),
    .custom-table td:nth-child(1) {
        position: sticky;
        left: 0;
        background: white;
        z-index: 10;
    }

    /* Column 2 */
    .custom-table th:nth-child(2),
    .custom-table td:nth-child(2) {
        position: sticky;
        left: 60px;
        background: white;
        z-index: 10;
    }

    /* Column 3 */
    .custom-table th:nth-child(3),
    .custom-table td:nth-child(3) {
        position: sticky;
        left: 220px;
        background: white;
        z-index: 10;
    }

    /* Column 4 */
    .custom-table th:nth-child(4),
    .custom-table td:nth-child(4) {
        position: sticky;
        left: 440px;
        background: white;
        z-index: 10;
    }
</style>

<div class="labourCompPage px-4 py-2">
    <!-- ================= KPI Bar ================= -->
    <div class="container my-4 ">
        <div class="row g-3 justify-content-center">

            <!-- Complied -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Complied</div>
                    <div class="lb-kpi-value">{{TotalComplied}}</div>
                </div>
            </div>

            <!-- Non-Complied -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Non-Complied / Pending</div>
                    <div class="lb-kpi-value">{{TotalNonComplied}}</div>
                </div>
            </div>

            <!-- Delayed -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Delayed</div>
                    <div class="lb-kpi-value">{{TotalDelayComplied}}</div>
                </div>
            </div>

            <!-- Pending -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Non-Applicable</div>
                    <div class="lb-kpi-value">{{TotalNonApplicable}}</div>
                </div>
            </div>

            <!-- Verified -->
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title">Verified</div>
                    <div class="lb-kpi-value text-success">{{TotalVerified}}</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="lb-kpi-card d-flex">
                    <div class="lb-kpi-title"> Under Clarification</div>
                    <div class="lb-kpi-value text-danger">{{TotalClarification}}</div>

                </div>
            </div>

        </div>
    </div>

    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill"
             role="tablist"
             aria-label="All, Act1 or Act2"
             style="overflow-x:auto; white-space:nowrap; display:flex; flex-wrap:nowrap; gap:8px;">

            <button type="button"
                    class="btn btn-pill active"
                    ng-class="{'active-card': SelectedAct=='All'}"
                    ng-click="filterByAct('All')"
                    style="flex:0 0 auto;">
                All
            </button>

            <button type="button"
                    class="btn btn-pill"
                    ng-repeat="act in ActList"
                    ng-class="{'active-card': SelectedAct==act}"
                    ng-click="filterByAct(act)"
                    style="flex:0 0 auto;">
                {{act}}
            </button>

        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">
        <!-- ALL CARD (default visible) -->
        <div id="allCard" class="card section-card active" ng-init="BindNewSearch()">
            <h5 class="mb-4 " style="color: var(--primary)">All card </h5>
            <div class="card-body p-3 h-100 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedState || 'State'}}
                            </button>

                            <ul class="dropdown-menu">
                                <li ng-repeat="state in StateList">
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="getstate(state)">
                                        {{state}}
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedStatus || 'Status'}}
                            </button>

                            <ul class="dropdown-menu">
                                <li ng-repeat="status in StatusList">
                                    <a class="dropdown-item"
                                       href="javascript:void(0)"
                                       ng-click="getstatus(status)">
                                        {{status}}
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <div class="dropdown">
                            <ul class="dropdown-menu">
                                <li ng-repeat="month in MonthList">
                                    <a class="dropdown-item"
                                       href="javascript:void(0)"
                                       ng-click="getmonth(month.id)">
                                        {{month.name}}
                                    </a>
                                </li>
                            </ul>

                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedMonth ? getMonthName(SelectedMonth) : 'Month'}}
                            </button>

                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedYear || 'Year'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="year in YearList">
                                    <a class="dropdown-item"
                                       ng-click="getyear(year)">
                                        {{year}}
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <button class="btn btn-sm filter-btn active" ng-click="ApplyFilters()">Go</button>
                        <button class="btn btn-sm filter-btn active" ng-click="reset()">Reset</button>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="lbSearch"
                                       type="text"
                                       ng-model="Search"
                                       class="form-control form-control-sm"
                                       placeholder="Search..." />
                                <button class="btn btn-sm" id="lbSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div>
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" ng-click="NewExportTableToCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" ng-click="NEwPrintTable()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-container">
                        <table class="table table-sm mb-0 small-table custom-table" id="lbTable">
                            <thead>
                                <tr style="background-color: #F37437">
                                    <th>SNo</th>
                                    <th>Act Name</th>
                                    <th>Compliance Name</th>
                                    <th>Registration No.</th>
                                    <th> Risk  </th>
                                    <th> Frequency  </th>
                                    <th>Month</th>
                                    <th>State Name</th>
                                    <th>DueDate</th>
                                    <th>Status</th>
                                    <th>Actual Submission Date</th>
                                    <th>Delay Days</th>
                                    <th class="no-print" ng-if="PFUpload==1">UploadFile</th>
                                    <th>Upload Date</th>
                                    <th class="no-print">Remark </th>
                                    <th class="no-print" ng-if="PFVerify==1">IsVerified</th>
                                    <th class="no-print">View File</th>
                                    <th class="no-print">Action</th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr ng-repeat="row in labourcomplianceRows | filter:{Calendartype : 'Statutory'}  | filter:globalSearch">
                                    <td>{{$index + 1}}</td>
                                    <td>{{row.Act}}</td>
                                    <td>
                                        <a href="javascript:void(0)"
                                           class="store-code-link text-success"
                                           ng-click="BindCompliance(row.Id); openComplianceModal()">
                                            {{row.ComplianceName}}
                                        </a>
                                    </td>
                                    <td>{{row.RegistrationNumber}}</td>
                                    <td>{{row.Risk}}</td>
                                    <td>
                                        <a href="#"
                                           ng-if="row.Frequency == 'Event'"
                                           class="event-link text-success"
                                           ng-click="openEventModal(row);">
                                            {{row.Frequency}}
                                        </a>

                                        <span ng-if="row.Frequency != 'Event'">
                                            {{row.Frequency}}
                                        </span>
                                    </td>
                                    <td>{{ getMonthName(row.Month) }}</td>
                                    <td>{{row.STATE_NM}}</td>
                                    <td>{{row.DueDate}}</td>
                                    <td>
                                        <select class="form-select form-select-sm" ng-model="row.CStatus" ng-disabled="row.Flag=='1'">
                                            <option value="">Select </option>
                                            <option value="Complied">Complied </option>
                                            <option value="NonComplied">Non Complied </option>
                                            <option value="Delaycomplied">Delay complied </option>
                                            <option value="NonApplicable">Non-Applicable</option>
                                        </select>
                                        <p ng-show="false">{{row.CStatus}}</p>
                                    </td>
                                    <td>
                                        <input date-input type="date" style="width:auto" class="form-control form-control-sm no-print" id="ActualSubmissionDate{{$index}}" ng-model="row.ActualSubmissionDate" ng-disabled="row.Flag=='1'">
                                        <p ng-show="false">{{ row.ActualSubmissionDate | date:'yyyy-MM-dd' }}</p>
                                    </td>
                                    <td>{{row.DelayDays}}</td>
                                    <td class="no-print" ng-if="PFUpload==1">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                            <div class="input-box">
                                                <div style="display: flex; align-items: center;">
                                                    <button ng-disabled="row.Flag=='1'" class="btn btn-sm btn-upload px-3 uploadbtn"
                                                            ng-click="SetNewValue(row,'#fileupoad'+$index);ManageLog('Upload File'+row.Act)">
                                                       
                                                        <div ng-if="row.UploadFile==''"> Choose File</div>
                                                        <div  ng-if="row.UploadFile!=''" >Uploaded</div>
                                                    </button>

                                                    <input type="file"
                                                           id="fileupoad{{$index}}"
                                                           file-model="row.UploadFile"
                                                           row-data="row"
                                                           style="display:none;" />




                                                
                                                </div>


                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <p ng-show="false">
                                            {{ row.UploadFile ? 'Uploaded' : 'Not Uploaded' }}
                                        </p>
                                    </td>

                                    <td>{{row.CreateOn}}</td>
                                    <td class="d-flex align-items-center gap-2 no-print">
                                        <input class="form-control form-control-sm" ng-model="row.VRemark1" type="text" id="VRemark" style="font-size:10px" ng-show="row.Flag !='1'" />

                                        <i ng-if="row.VRemark !=''" class="bi bi-eye-fill" style="cursor: pointer; color: #F37437" ng-click="openRemarkModal(row.VRemark,'Client Remark')"></i>


                                    </td>

                                    <td class="no-print" ng-if="PFVerify==1">
                                        <select class="form-select form-select-sm"
                                                ng-model="row.IsVerified"
                                                ng-disabled="row.Flag=='1'"
                                                ng-class="{
            'text-success': row.IsVerified === 'Verified',
            'text-danger': row.IsVerified === 'Clarify'
        }">

                                            <option value="0">Select</option>
                                            <option value="Verified">Verified</option>
                                            <option value="Clarify">Under Clarification</option>

                                        </select>

                                    </td>

                                    <td class="no-print"><a href="#" class="view" style="color:#F37437" ng-show="row.openthis=='1'" ng-click="viewFile(row)">{{ row.openthis == '1' ? 'View' : '' }}</a> </td>
                                    <td class="no-print">

                                        <input class="btn btn-sm btn-submit px-3" ng-if="row.Flag!='1'" type="button" value="Submit" ng-click="NewverifyRecord(row )" />


                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <!--<div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="scPaginationWrap">
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-outline-primary" id="scPrev" type="button">Previous</button>
                            <button class="btn btn-sm btn-outline-primary" id="scNext" type="button">Next</button>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div id="scPageInfo" style="font-size:0.85rem;color:#555;"></div>
                            <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                        </div>
                    </div>-->
                </div>
            </div>
        </div>

        <!-- ================= Compliance Details Modal ================= -->
        <div class="modal fade" id="complianceDetailsModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                    <!-- Header -->
                    <div class="compDetail-header d-flex align-items-center">
                        <button type="button" class="btn compDetail-back-btn" data-bs-dismiss="modal">
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <h5 class="modal-title text-center flex-grow-1" style="color:#fff">Compliance Details</h5>
                    </div>

                    <!-- Body -->
                    <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Rule:</strong>
                                <div class="text-secondary">{{Rule}}</div>
                            </div>
                            <div class="col-md-6">
                                <strong>Section:</strong>
                                <div class="text-secondary">{{Section}}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Form No.:</strong>
                                <div class="text-secondary">{{FormNo}}</div>
                            </div>
                            <div class="col-md-6">
                                <strong>Risk:</strong>
                                <div class="fw-bold text-danger">{{Risk}}</div>
                            </div>
                        </div>

                        <hr class="my-3">

                        <strong>Attachment:</strong>

                        <div class="text-secondary mb-3">

                            <!-- If attachment exists -->
                            <a href="javascript:void(0)"
                               ng-if="Attachment && Attachment != ''"
                               ng-click="DownloadAttachment(Attachment)"
                               class="text-decoration-none d-inline-flex align-items-center gap-2">

                                <i class="bi bi-download text-primary" style="font-size:16px;"></i>
                                <span class="text-primary">Attachment</span>
                            </a>

                            <!-- If no attachment -->
                            <span ng-if="!Attachment || Attachment == ''" class="text-muted">
                                <i class="bi bi-paperclip"></i> No Attachment
                            </span>

                        </div>
                        <hr class="my-3">

                        <strong>Description:</strong>
                        <div id="cd_description" class="text-secondary" style="line-height:1.5;">
                            {{Description}}
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- ================= Event Modal ================= -->
        <div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                    <!-- Header -->
                    <div class="event-header d-flex align-items-center">

                        <button type="button" class="btn event-back-btn"
                                ng-click="closeEventModal()">
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <h5 class="modal-title text-center flex-grow-1">Compliance Event</h5>
                    </div>

                    <!-- Body -->
                    <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">
                        <!-- Table wrapper -->
                        <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                            <div style="width:100%; overflow-x:auto;">

                                <table class="table table-sm mb-0 small-table"
                                       id="complianceTable"
                                       style="min-width:1500px; white-space:nowrap;">
                                    <thead>
                                        <tr style="background-color: #F37437">
                                            <th>SNo</th>
                                            <th>Act Name</th>
                                            <th>Compliance Name</th>
                                            <th>Registration No.</th>
                                            <th> Frequency  </th>
                                            <th>Month</th>
                                            <th>State Name</th>
                                            <th>DueDate</th>
                                            <th>Status</th>
                                            <th>Actual Submission Date</th>
                                            <th>Delay Days</th>
                                            <th class="no-print">UploadFile</th>
                                            <th>Upload Date</th>
                                            <th class="no-print">Remark </th>
                                            <TH>IsVerified</TH>
                                            <th>View File</th>
                                            <th class="no-print">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        <tr>
                                            <td>1</td>
                                            <td>{{selectedEvent1.Act}}</td>
                                            <td>
                                                <a href="javascript:void(0)"
                                                   class="store-code-link text-success"
                                                   ng-click="BindCompliance(selectedEvent1.Id); openComplianceModal()">
                                                    {{selectedEvent1.ComplianceName}}
                                                </a>

                                            </td>
                                            <td>{{selectedEvent1.RegistrationNumber}}</td>
                                            <td>
                                                {{selectedEvent1.Frequency}}
                                            </td>
                                            <td>{{ getMonthName(selectedEvent1.Month) }}</td>
                                            <td>{{selectedEvent1.STATE_NM}}</td>
                                            <td>{{selectedEvent1.DueDate}}</td>
                                            <td>
                                                <select class="form-select form-select-sm" ng-model="selectedEvent.CStatus" ng-disabled="selectedEvent.Flag=='1'">
                                                    <option value="">Select </option>
                                                    <option value="Complied">Complied </option>
                                                    <option value="NonComplied">Non Complied </option>
                                                    <option value="Delaycomplied">Delay complied </option>
                                                    <option value="NonApplicable">Non-Applicable</option>
                                                </select>
                                                <p ng-show="false">{{selectedEvent.CStatus}}</p>
                                            </td>
                                            <td>
                                                <input date-input type="date" style="width:auto" class="form-control form-control-sm no-print" id="ActualSubmissionDate{{$index}}" ng-model="selectedEvent.ActualSubmissionDate" ng-disabled="selectedEvent.Flag=='1'">
                                                <p ng-show="false">{{ selectedEvent.ActualSubmissionDate | date:'yyyy-MM-dd' }}</p>
                                            </td>
                                            <td>{{selectedEvent.DelayDays}}</td>
                                            <td class="no-print">
                                                <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                                    <div class="input-box">
                                                        <div style="display: flex; align-items: center;">
                                                            <button ng-disabled="selectedEvent.Flag=='1'" class="btn btn-sm btn-upload px-3 uploadbtn"
                                                                    ng-click="SetNewValue(selectedEvent,'#fileupoad'+$index);ManageLog('Upload File'+selectedEvent.Act)">
                                                                Choose File
                                                            </button>

                                                            <input type="file"
                                                                   id="fileupoad{{$index}}"
                                                                   file-model="selectedEvent.UploadFile"
                                                                   row-data="selectedEvent"
                                                                   style="display:none;" />
                                                            <i class="fa fa-upload"
                                                               style="color: green; margin-left: 10px;"
                                                               ng-if="selectedEvent.UploadFile"></i>
                                                        </div>


                                                        <div class="text-box-msg-r">
                                                        </div>
                                                    </div>
                                                </div>
                                                <p ng-show="false">
                                                    {{ selectedEvent.UploadFile ? 'Uploaded' : 'Not Uploaded' }}
                                                </p>
                                            </td>

                                            <td>{{selectedEvent.CreateOn}}</td>
                                            <td  class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                                <br />
                                                <input class="form-control form-control-sm" ng-model="row.VRemark1" type="text"
                                                       id="VRemark" ng-disabled="row.Flag=='1'" />

                                                <i ng-if="row.VRemark  !=''" class="bi bi-eye-fill" style="cursor: pointer; color: #F37437" ng-click="openRemarkModal(row.VRemark,'Client Remark')"></i>


                                            </td>

                                            <td class="no-print">
                                                <select class="form-select form-select-sm" ng-model="selectedEvent.IsVerified" ng-disabled="selectedEvent.Flag=='1'">
                                                    <option value="0">Select</option>
                                                    <option value="Verified">Verified</option>
                                                    <option value="Clarify">Under Clarification</option>
                                                </select>
                                            </td>

                                            <td><a href="#" class="view" ng-show="selectedEvent.openthis=='1'" ng-click="viewFile(selectedEvent)">{{ selectedEvent.openthis == '1' ? 'View' : '' }}</a> </td>
                                            <td class="no-print">

                                                <input class="btn btn-sm btn-submit px-3" ng-if="selectedEvent.Flag!='1'" type="button" value="Submit" ng-click="NewverifyRecord(selectedEvent )" />


                                            </td>
                                        </tr>

                                    </tbody>
                                </table>
                            </div>

                        </div>

                    </div>

                    <div class="modal-footer d-flex justify-content-end">
                        @*<button class="btn btn-sm eventSubmitBtn"
                                    type="button"
                                    ng-click="Addevent(selectedEvent)">
                                Add Event
