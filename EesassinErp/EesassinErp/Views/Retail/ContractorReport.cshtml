                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table">
                        <thead>
                            <tr>
                                <th>Sr.No</th>
                                <th>Location Code</th>
                                <th>Ref Location Code</th>
                                <th>State</th>
                                <th>View</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>1</td>
                                <td>00004292</td>
                                <td>1234567</td>
                                <td>Uttar Pradesh</td>
                                <td>
                                    <button class="btn btn-sm view-btn" data-bs-toggle="modal" data-bs-target="#contractorReportModal">
                                        View
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="estRepPaginationWrap">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm" id="estRepPrev" type="button">Previous</button>
                        <button class="btn btn-sm" id="estRepNext" type="button">Next</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="estRepPageInfo" style="font-size:0.85rem;color:#555;"></div>
                        <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTRACTOR REPORT VIEW MODAL -->
    <div class="modal fade contractorReportModal"
         id="contractorReportModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">

                <!-- HEADER -->
                <div class="modal-header">
                    <h5 class="modal-title">Contractor Report Details</h5>
                    <button type="button"
