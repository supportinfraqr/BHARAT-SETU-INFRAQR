@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Compliance Report";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/scripts/RetailJsLib/AddcomplianceFileController.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.5/purify.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<!-- For Excel -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
 
<style>
    .pagecontentbody {
        font-family: "Inter", sans-serif;
        --primary: #E45D27; /* theme accent */
        --primary-dark: #c44b1d;
        --card-bg: #FEF3EC;
        background: #FFF1EB;
        color: #223;
        min-height: 90vh;
    }

    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        max-height: 240px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .download-btn, .btn-submit, .btn-view, .btn-print, .btn-excel, .btn-download {
        background: #E45D27;
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 6px 12px;
        font-weight: 400;
        display: inline-flex;
        align-items: center;
        gap: 1px;
        cursor: pointer;
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }

        .download-btn:hover, .btn-submit:hover, .btn-view:hover, .btn-print:hover, .btn-excel:hover, .btn-download:hover {
            background-color: #c44b1d;
            color: #fff;
        }

        .download-btn i {
            margin-right: 8px;
        }

        .control-label{
            margin-bottom:0.5rem;
        }

    .input-box {
        background: var(--card-bg);
        border-radius: 12px;
        border: none !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
        margin-bottom: 2rem;
    }

        .input-box h4 {
            color: var(--primary);
        }

        /* First header row */
        .input-box table thead tr:first-child th {
            position: sticky;
            top: 0;
            z-index: 2;
            background-color: #F37437;
            color: #fff;
            font-weight: 600;
            font-size: 0.78rem;
            text-align: left;
            vertical-align: middle;
            white-space: nowrap;
            padding: 8px 10px;
        }

        /* Second row (search row) */
        .input-box table thead tr:nth-child(2) th {
            position: sticky;
            top: 34px; /* adjust according to first row height */
            z-index: 1;
            background-color: var(--card-bg);
            color: #000;
            font-weight: 400;
            font-size: 0.78rem;
            text-align: left;
            vertical-align: middle;
            padding: 8px 10px;
            white-space: nowrap;
        }

            /* Search inputs */
            .input-box table thead tr:nth-child(2) th input {
                font-size: 0.78rem;
                min-width: 120px;
            }

        .input-box table tbody td {
            background-color: var(--card-bg);
            font-size: 0.78rem;
            vertical-align: middle;
            text-align: left;
            padding: 8px 10px;
            white-space: nowrap;
            font-weight: 400;
        }

        .input-box tbody tr:hover td {
            background-color: #FFE8D9;
        }

        .spin-icon{
    display:inline-block;
    animation: spin 1s linear infinite;
}

@@keyframes spin{
    from{
        transform: rotate(0deg);
    }
    to{
        transform: rotate(360deg);
    }
}

</style>

<style>
    /*.bg-primary {
        background-color: var(--primary) !important;
    }*/

    .form-check .form-check-input {
        float: left;
        margin-left: 0.5em !important;
    }

    .select-as-button {
        appearance: none;
        -webkit-appearance: none;
        background: #e63123; /* bootstrap primary */
        color: #fff;
        border: 1px solid #0d6efd;
        border-radius: .5rem;
        font-weight: 600;
        cursor: pointer;
        position: relative;
    }

        .select-as-button:disabled {
            opacity: .75;
            cursor: not-allowed;
        }

        .select-as-button:focus {
            outline: 0;
            box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
        }
    /* caret arrow */
    .select-as-button {
        background-image: linear-gradient(45deg, transparent 50%, #fff 50%), linear-gradient(135deg, #fff 50%, transparent 50%);
        background-position: calc(100% - 18px) calc(50% + 3px), calc(100% - 12px) calc(50% + 3px);
        background-size: 6px 6px, 6px 6px;
        background-repeat: no-repeat;
        padding-right: 2.25rem;
    }

    #print-area {
        position: absolute;
        top: -9999px;
        left: -9999px;
        visibility: visible;
        display: block;
        background: #fff;
    }

    .custom-tabs .nav-link {
        color: #333;
        font-weight: 500;
    }

        .custom-tabs .nav-link.active-tab {
            background-color: #e67525 !important; /* Highlight active tab */
            color: #000 !important;
            border-color: #ddd #ddd transparent;
        }

    .custom-dropdown {
        background-color: #f9f9f9;
    }

    .form-check {
        padding: 5px 10px;
    }

    .form-check-input {
        margin-top: 0.3rem;
    }

    .modal-backdrop.show {
        opacity: 0 !important;
        pointer-events: none !important; /* अब क्लिक block नहीं होगा */
    }
</style>
<div class="pagecontentbody px-4 py-2">

    <div class="pagebody">
        <div class="col-md-12 pageheader">

            <div class="pagecontentbody">
                <h4 class="mb-4 " style="color: var(--primary)">Establishment Report </h4>
               
                <button type="button"
                        class="download-btn mb-2"
                        data-bs-toggle="modal"
                        data-bs-target="#bulkDownloadModal">
                    <i class="bi bi-download"></i> Bulk Download Docs
                </button>
				<div style="margin-bottom: 1rem;padding-left: 1rem;">
                    {{downloadAlertMessage}}<br />
                    {{downloadMessage}}

                </div>
                <div class="pagebody">
                    <div class="col-md-12 pageheader">
                        <!-- Tabs Content -->
                        <div class="tab-content">
                            <div>

                                <div>
                                    <div>
                                        <div>

                                            <div>
                                                <div class="row g-3 align-items-end">


                                                    <!-- State -->
                                                    <div class="col-md-2">
                                                        <div class="form-group" ng-init="AllState();">
                                                            <label for="ddlState" class="form-label">State</label>
                                                            <select id="ddlState" class="form-control form-select validate" ng-model="StateId" ng-change="BindStore()">
                                                                <option value="">Select</option>
                                                                <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">
                                                                    {{x.STATE_NM}}
                                                                </option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <!-- Category -->
                                                    <div class="col-md-2">
                                                        <label class="control-label">Compliance Category<span class="vd_red">*</span></label>
                                                        <div class="input-box" style="margin-bottom: 0;">
                                                            <select id="ddlComplianceCategory" class="select2 form-control validate" ng-model="ComplianceCategory" ng-change="BindStore()">
                                                                <option value="">Select Compliance</option>
                                                                @*<option value="1">Store</option>
                                                        <option value="2">Warehouse</option>
                                                        <option value="3">Factory</option>*@
                                                                <option value="4">Establishment</option>
                                                                @*<option value="5">Contractor</option>*@
                                                            </select>
                                                            <div class="text-box-msg-r">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-2">
                                                        <div class="form-group">
                                                            <label style="margin-bottom: 0.5rem;">Store Code</label>

                                                            <select id="myDropdown" class="form-control form-select validate" ng-change="BindAct(StoreId);SetStoreCode(StoreId)" ng-model="StoreId">
                                                                <option value="">Select</option>
                                                                <option ng-repeat="xx in StoreList" value="{{xx.StoreId}}"> {{xx.StoreCode}} </option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-2" ng-click="$event.stopPropagation()">
                                                        <div class="form-group" ng-init="SelectedActs = []">
                                                            <label class="form-label">Act List</label>

                                                            <!-- Dropdown Container -->
                                                            <div class="dropdown" style="position:relative; display:inline-block; width:100%;">
                                                                <button type="button"
                                                                        class="form-control text-left"
                                                                        ng-click="toggleDropdown($event)">
                                                                    {{SelectedActs.length > 0 ? SelectedActs.length + ' selected' : 'Select Acts'}}
                                                                    <span style="float:right;">&#9662;</span>
                                                                </button>

                                                                <!-- Dropdown Content -->
                                                                <div ng-show="dropdownOpenActs"
                                                                     style="position:absolute; z-index:1000; background:white; border:1px solid #ccc; width:100%; max-height:200px; overflow-y:auto; padding:5px; box-shadow:0 2px 5px rgba(0,0,0,0.2);"
                                                                     ng-click="$event.stopPropagation()">

                                                                    <!-- Select All -->
                                                                    <div>
                                                                        <input type="checkbox" ng-model="selectAllActs" ng-change="toggleAllActs()" />
                                                                        <label><strong>Select All</strong></label>
                                                                    </div>
                                                                    <hr style="margin:4px 0;">

                                                                    <!-- Checkboxes -->
                                                                    <div ng-repeat="act in ActList">
                                                                        <input type="checkbox"
                                                                               ng-checked="SelectedActs.indexOf(act.Act) > -1"
                                                                               ng-click="toggleAct(act.Act)" />
                                                                        <label>{{act.Act}}</label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>



                                                    <!-- Financial Year -->
                                                    <div class="col-md-2">
                                                        <div class="form-group" ng-init="BindFinacialYear();">
                                                            <label for="ddlFinancialYear" class="form-label">Financial Year</label>
                                                            <select id="ddlFinancialYear" class="form-control form-select validate" ng-model="FY">
                                                                <option value="">Select</option>
                                                                <option ng-repeat="x in finacialyearList" value="{{x.FinancialName}}">
                                                                    {{x.FinancialName}}
                                                                </option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <!-- Month -->
                                                    <div class="col-md-1">
                                                        <div class="form-group" ng-init="BindMonth();">
                                                            <label for="CMonth" class="form-label">Month</label>
                                                            <select id="CMonth" class="form-control form-select validate" ng-model="CMonth">
                                                                <option value="">Select</option>
                                                                <option ng-repeat="x in MonthList" value="{{x.MonthNumber}}">
                                                                    {{x.MonthName}}
                                                                </option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-1">
                                                        <div class="form-group">
                                                            <label class="form-label d-block">&nbsp;</label>
                                                            <button type="button"
                                                                   class="download-btn"
                                                                    ng-click="BindAllDocumentList()"
                                                                    ng-disabled="searching">
                                                                <span ng-if="!searching">
                                                                    <i style="margin-right:0" class="bi bi-search"></i>
                                                                </span>
                                                                <span ng-if="searching">
                                                                    <i class="bi bi-arrow-repeat spin-icon" style="margin-right:0;"></i>
                                                                </span>
                                                            </button>
                                                        </div>
                                                    </div>





                                                </div>


                                                <div id="dynamic-content" style="display: none;"></div>
                                                <div id="print-area"
                                                     style="position:absolute; top:-9999px; left:-9999px; background:#fff; min-width:800px; min-height:600px; display:block; visibility:visible;">
                                                </div>
                                            </div>
                                        </div>


                                        <br />

                                        <div class="input-box" ng-show="Doclist" style="padding: 10px; border-radius: 12px;">

                                            <h4>Document List</h4>
                                            <div style="max-height: 500px; overflow-x: auto; overflow-y: auto; border-radius: 12px;">
                                                <table class="table" style="width:100%;">
                                                    <thead>
                                                        <tr>
                                                            <th>
                                                                <input type="checkbox" ng-model="selectAll" ng-click="toggleAll()" />
                                                            </th>
                                                            <th>DocumentName</th>
                                                            <th>DocumentType</th>
                                                            <th>Act</th>
                                                            <th>FormNo</th>
                                                            <th>Criticality</th>
                                                            <th>DocumentType</th>
                                                            <th>Frequency</th>
                                                            <th>Action</th>
                                                        </tr>
                                                        <!-- Search Inputs -->
                                                        <tr>
                                                            <th></th>
                                                            <th><input type="text" class="form-control" placeholder="Search DocumentName" ng-model="search.DocumentName"></th>
                                                            <th><input type="text" class="form-control" placeholder="Search DocumentType" ng-model="search.DocumentType"></th>
                                                            <th><input type="text" class="form-control" placeholder="Search Act" ng-model="search.Act"></th>
                                                            <th><input type="text" class="form-control" placeholder="Search FormNo" ng-model="search.FormNo"></th>
                                                            <th><input type="text" class="form-control" placeholder="Search Criticality" ng-model="search.Criticality"></th>
                                                            <th><input type="text" class="form-control" placeholder="Search DocumentType" ng-model="search.DocumentType2"></th>
                                                            <th><input type="text" class="form-control" placeholder="Search Frequency" ng-model="search.Frequency"></th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="x in DocumentList | filter:customFilter">
                                                            <td>
                                                                <input type="checkbox" ng-model="x.isSelected" ng-change="updateSelection()" />
                                                            </td>
                                                            <td>{{x.DocumentName}}</td>
                                                            <td>{{x.DocumentType}}</td>
                                                            <td >{{x.Act}}</td>
                                                            <td >{{x.FormNo}}</td>
                                                            <td >{{x.Criticality}}</td>
                                                            <td >{{x.DocumentType}}</td>
                                                            <td >{{x.Frequency}}</td>
                                                            <td >
                                                                <div class="btn-group" role="group">
                                                                    <!-- Download Button -->
                                                                    <button class="btn btn-sm btn-download"
                                                                            title="Download"
                                                                            ng-click="ApproveBeforeDownload(x.HeaderHtml,x.Allowed,x.DocumentId,3,x.DocumentName)"
                                                                            ng-disabled="loading[x.DocumentId]">
                                                                        <span ng-if="!loading[x.DocumentId]">
                                                                            <i class="bi bi-download"></i>
                                                                        </span>
                                                                        <span ng-if="loading[x.DocumentId]">
                                                                            <i class="bi bi-arrow-repeat spin-icon"></i>
                                                                        </span>
                                                                    </button>

                                                                    <!-- Print Button -->
                                                                    <button class="btn btn-sm btn-print"
                                                                            title="Print"
                                                                            ng-click="ApproveBeforeDownload(x.HeaderHtml,x.Allowed,x.DocumentId,1,x.DocumentName)"
                                                                            ng-disabled="loading[x.DocumentId]">
                                                                        <span ng-if="!loading[x.DocumentId]">
                                                                            <i class="bi bi-printer"></i>
                                                                        </span>
                                                                        <span ng-if="loading[x.DocumentId]">
                                                                            <i class="bi bi-arrow-repeat spin-icon"></i>
                                                                        </span>
                                                                    </button>
                                                                    <!-- Excel Button -->
                                                                    <button class="btn btn-sm btn-excel"
                                                                            title="Download Excel"
                                                                            ng-click="ApproveBeforeDownload(x.HeaderHtml,x.Allowed,x.DocumentId,2,x.DocumentName)"
                                                                            ng-disabled="loading[x.DocumentId]">
                                                                        <span ng-if="!loading[x.DocumentId]">
                                                                            <i class="bi bi-file-earmark-excel"></i>
                                                                        </span>
                                                                        <span ng-if="loading[x.DocumentId]">
                                                                            <i class="bi bi-arrow-repeat spin-icon"></i>
                                                                        </span>
                                                                    </button>
                                                                </div>
                                                            </td>


                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                    </div>



                                </div>


                            </div>
                        </div>


                    </div>



                </div>
            </div>
        </div>
    </div>
</div>
@*//----------------*@
<!-- Bootstrap Modal -->
<div id="employeeModal" tabindex="-1" role="dialog"
     style="display:none; position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.5); z-index:1050; overflow:auto;">

    <div class="modal-dialog" role="document"
         style="margin:20% auto; max-width:500px; z-index:1060;">

        <div class="modal-content" style="border-radius:8px; overflow:hidden;">

            <div class="modal-header" style="background: #E45D24; color: #fff; padding: 10px 15px;">
                <h5 class="modal-title">Select Employee</h5>
                @*<button type="button" class="close btn-close btn-close-white"
                style="border:none; background:none; font-size:24px;"
                onclick="angular.element(this).scope().closeModal()">
            &times;
        </button>*@
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="angular.element(this).scope().closeModal()"></button>
            </div>

            <div class="modal-body" style="padding: 15px; background: #FEF3EC;">
                <!-- Dropdown -->
                <select class="form-control" ng-model="SelectedEmployee">
                    <option value="">Select Employee</option>
                    <option ng-repeat="x in EmployeeDetail" value="{{x.Employee_Code}}">{{x.Employee_Code}}|{{x.Employee_Name}}</option>

                </select>
            </div>

            <div class="modal-footer" style="background: #FEF3EC; padding: 10px 15px; text-align: right;">
                <button type="button" style="margin-right: .5rem;" class="btn btn-download" ng-click="PrintEmployee()">Download Form</button>
                <button type="button" class="btn btn-view"
                        onclick="angular.element(this).scope().closeModal()">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>


<!-- 🔹 Modal -->
<div class="modal fade" id="bulkDownloadModal" tabindex="-1" aria-labelledby="bulkDownloadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header" style="background:#E45D24; color:#fff;">
                <h5 class="modal-title" id="bulkDownloadModalLabel">Bulk Download Documents</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" style="background: #FEF3EC;">
                <!-- 🔹 State Checkbox List -->
                <div class="form-group mb-3">
                    <label class="col-form-label mb-2">Select State(s)</label>
                    <div class="border" style="max-height: 200px; overflow-y: auto; background-color: #f8f9fa;">
                        <div class="form-check" ng-repeat="s in AllStateList">
                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chk_{{s.SATE_CODE}}"
                                   ng-checked="SelectedStates.indexOf(s.SATE_CODE) > -1"
                                   ng-click="toggleStateSelection(s.SATE_CODE)">
                            <label class="form-check-label ms-2" for="chk_{{s.SATE_CODE}}">
                                {{s.STATE_NM}}
                            </label>
                        </div>
                    </div>
                </div>

                <!-- 🔹 Financial Year and Month Dropdowns -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group" ng-init="BindFinacialYear();">
                            <label for="ddlFinancialYear" class="form-label">Financial Year</label>
                            <select id="ddlFinancialYear" class="form-control form-select" ng-model="FY">
                                <option value="">Select</option>
                                <option ng-repeat="x in finacialyearList" value="{{x.FinancialName}}">
                                    {{x.FinancialName}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group" ng-init="BindMonth();">
                            <label for="CMonth" class="form-label">Month</label>
                            <select id="CMonth" class="form-control form-select" ng-model="CMonth">
                                <option value="">Select</option>
                                <option ng-repeat="x in MonthList" value="{{x.MonthNumber}}">
                                    {{x.MonthName}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 🔹 Footer -->
            <div class="modal-footer" style="background: #FEF3EC;">
                <button type="button"
                        class="btn btn-download"
                        ng-click="DownloadSelected()"
                        data-bs-dismiss="modal">
                    <i class="bi bi-download"></i> Download
                </button>
                <button type="button" class="btn btn-view" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@*//----------------*@


<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/scripts/RetailJsLib/AddcomplianceFileController.js"></script>







