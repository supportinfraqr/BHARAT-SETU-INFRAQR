                                            <div class="row g-3">

                                                <div class="col-md-3">
                                                    <label class="form-label">Judgment Passed <span class="text-danger">*</span></label>
                                                    <select class="form-control" id="txtJudgmentPassed" ng-model="JudgmentPassed">
