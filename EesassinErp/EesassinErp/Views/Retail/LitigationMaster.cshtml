                                                    <select class="form-control" id="txtCondonationFiled" ng-model="CondonationFiled">
                                                        <option value="">Select</option>
                                                        <option value="1">Yes</option>
                                                        <option value="0">No</option>
                                                    </select>
                                                </div>

                                                <div class="col-md-3">
                                                    <label class="form-label">Condonation Status</label>
                                                    <select class="form-control" id="txtCondonationStatus" ng-model="CondonationStatus">
                                                        <option value="">Select</option>
                                                        <option value="1">Accepted</option>
                                                        <option value="0">Rejected</option>
                                                    </select>

                                                </div>

                                                <div class="col-md-3">
                                                    <label class="form-label">Judgment Copy</label>
                                                    <input type="file" class="form-control" id="txtJudgmentCopyPath" ng-model="JudgmentCopyPath" />

                                                    <div ng-if="JudgmentCopyPath" style="margin-top:10px;">
                                                        <i ng-class="getFileIcon(JudgmentCopyPath)" style="font-size: 20px;"></i>
                                                        <a ng-href="{{JudgmentCopyPath}}" target="_blank">
                                                            {{ getFileName(JudgmentCopyPath) }}
                                                        </a>
                                                    </div>

                                                </div>


                                                <div class="col-md-12">
                                                    <input type="button" class="btn btn-warning" value="Save Draft" style="width: 30%;text-align:center" ng-click="SaveStage4()">
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tab-content" id="tab5">
                            <div class="col-md-12">
                                <div class="row mb-3 p-3">
                                    <div class="card p-0">
                                        <div class="card-body">
                                            <h4>Appeal </h4>
                                            <div class="row g-3">

                                                <div class="col-md-3">
                                                    <label class="form-label">Appeal Status <span class="text-danger">*</span></label>
                                                    <select class="form-control" id="txtAppealStatus" ng-model="AppealStatus">
                                                        <option value="">Select</option>
                                                        <option value="1">Yes</option>
                                                        <option value="0">No</option>
                                                    </select>

                                                </div>

                                                <div class="col-md-3">
                                                    <label class="form-label">Appeal By <span class="text-danger">*</span></label>

                                                    <select class="form-control" id="txtAppealby" ng-model="Appealby">
                                                        <option value="">Select</option>
                                                        <option value="Self">Self</option>
                                                        <option value="Opposition">Opposition</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-12">
                                                    <input type="button" class="btn btn-warning" value="Final Save" style="width: 30%;text-align:center" ng-click="SaveStage5()">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-12" ng-hide="IsOpen">
            <div class="row mb-3 p-3">
                <div class="p-0">
                    <input class="form-control" type="text" id="myInput" value="" style="width: 30%; margin-left: 67%; " ng-keyup="GetLitigationMaster(1,10)" placeholder="Search">
                    <div>
                        <div id="myTabContent">
                            <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                                <table id="example" style="width:100% !important" class="display nowrap table table-bordred table-hover tableFixHead unittbl datatable themed-element">
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


