<script>
    function switchTab(evt, tabId) {
        var i, tabcontent, tablinks;
        debugger;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].classList.remove("active");
        }

        tablinks = document.querySelectorAll(".tab-nav li");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].classList.remove("active");
        }

        document.getElementById(tabId).classList.add("active");
        evt.currentTarget.classList.add("active");
    }
</script>
<style>
    .tab-container {
        margin-bottom: 20px;
    }

    .tab-nav {
        list-style-type: none;
        padding: 0;
        margin: 0;
        display: flex;
        border-bottom: 2px solid #ddd;
    }

        .tab-nav li {
            padding: 10px 20px;
            cursor: pointer;
            background-color: #F66659;
            color: white;
            margin-right: 2px;
            border-top-left-radius: 5px;
            border-top-right-radius: 5px;
        }

            .tab-nav li.active {
                background-color: #ddcdcd;
                border: 1px solid #ddd;
                border-bottom: none;
                color: black;
            }

    .tab-content {
        display: none;
        padding: 20px;
        border-top: none;
        background-color: #fff;
    }

        .tab-content.active {
            display: block;
        }
</style>

<script src="~/scripts/RetailJsLib/LitigationMasterController.js?Ver=@ViewBag.Version"></script>
<div class="pagecontentbody themed-element">
