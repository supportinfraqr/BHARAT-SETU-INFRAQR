                                                    <div class="col-md-12" style="font-size:18px">
                                                        <strong>Tracker {{$index+1}}</strong>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">Date of Hearing</label>
                                                        <input type="date" class="form-control" id="txtDateOfHearing{{$index}}" ng-model="hearing.DateOfHearing" />
                                                    </div>

                                                    <div class="col-md-3">
