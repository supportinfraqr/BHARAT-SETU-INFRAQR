                                                            <option value="Disposed">Disposed</option>
                                                            <option value="Others">Others</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-3">
                                                        <label class="form-label">Date of Upload</label>
                                                        <input type="date" class="form-control" id="txtDateOfUpload{{$index}}" ng-model="hearing.DateOfUpload" />
                                                    </div>

                                                    <div class="col-md-3">
