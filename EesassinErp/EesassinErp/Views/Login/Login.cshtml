                <div id="forgotMpinFlow"
                     class="newRegisterFlow">

                    <!-- STEP 1 -->

                    <div class="newRegisterStep active"
                         id="forgotMpinStep1">

                        <div class="newLoginField">

                            <label>
                                Mobile Number
                            </label>

                            <input type="text" ng-model="MobileNumber" ng-disabled="true">

                        </div>

                        <div class="newLoginField">

                            <div class="newLoginLabelRow">

                                <label>
                                    OTP
                                </label>

                                <a href="javascript:void(0)"
                                   class="newLoginInlineLink"
                                   ng-click="Loginotp()"
                                   ng-class="{'disabled-link': otpTimer > 0}"
                                   ng-disabled="otpTimer > 0"
                                   style="pointer-events: {{otpTimer > 0 ? 'none' : 'auto'}};">

                                    {{ otpTimer > 0 ? 'Resend OTP (' + otpTimer + 's)' : 'Resend OTP' }}

                                </a>

                            </div>

                            

                            <div class="newLoginInputWithAction">

                                <input type="text" id="NewOTP"
                                       placeholder="Enter OTP" ng-model="NewOTP">

                            </div>

                        </div>

                        <button class="newLoginPrimaryBtn" ng-click="Verifynumber()"
                                id="forgotMpinNext">

                            <span>Next</span>

                            <i class="fa-solid fa-arrow-right"></i>

                        </button>

                    </div>



                    <!-- STEP 2 -->

                    <div class="newRegisterStep"
                         id="forgotMpinStep2">

                        <div class="newLoginField">

                            <label>
                                New MPIN
                            </label>

                            <div class="newRegisterPasswordField">

                                <input type="password" id="MPIN1" ng-model="MPIN1" maxlength="6" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))"
                                       placeholder="Enter New MPIN">

                                <button type="button"
                                        class="newPasswordToggle">

                                    <i class="fa-regular fa-eye"></i>

                                </button>

                            </div>

                        </div>


                        <div class="newLoginField">

                            <label>
                                Confirm MPIN
                            </label>

                            <div class="newRegisterPasswordField">

                                <input type="password" id="MPIN2" ng-model="MPIN2" maxlength="6" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))"
                                       placeholder="Enter Confirm MPIN">

                                <button type="button"
                                        class="newPasswordToggle">

                                    <i class="fa-regular fa-eye"></i>

                                </button>

                            </div>

                        </div>

                        <button class="newLoginPrimaryBtn" ng-click="UpdateMpin()">

                            <span>Continue</span>

                            <i class="fa-solid fa-arrow-right"></i>

                        </button>

                    </div>

                </div>

                <!-- ====================================== -->
                <!-- FORGOT PASSWORD FLOW -->
                <!-- ====================================== -->
                <div id="forgotPasswordFlow">

                    <!-- STEP 1 -->

                    <div class="newForgotPasswordStep active"
                         id="forgotPasswordStep1">

                        <button type="button"
                                class="newLoginBackBtn"
                                id="forgotPasswordBackToLogin">

                            ← Back

                        </button>

                        <div class="newLoginField">

                            <label>
                                Mobile Number / Email ID
                            </label>

                            <input type="text" ng-model="MobileNumber" id="MobileNumber">

                        </div>

                        <button class="newLoginPrimaryBtn" ng-click="forgotPasswordNext()"
                                id="forgotPasswordNext">

                            <span>Next</span>

                            <i class="fa-solid fa-arrow-right"></i>

                        </button>

                    </div>



                    <!-- STEP 2 -->

                    <div class="newForgotPasswordStep"
                         id="forgotPasswordStep2">

                        <button type="button"
                                class="newLoginBackBtn"
                                id="forgotPasswordBackStep1">

                            ← Back

                        </button>


                        <div class="newOtpContainer">

                            <label>One-Time Password (OTP)</label>

                            <div class="newOtpBoxes" ng-class="{
        'otp-error': otpStatus == 'error',
        'otp-success': otpStatus == 'success'
    }">

                                <input maxlength="1" ng-model="o1" ng-keyup="otpKey($event,1)">
                                <input maxlength="1" ng-model="o2" ng-keyup="otpKey($event,2)">
                                <input maxlength="1" ng-model="o3" ng-keyup="otpKey($event,3)">
                                <input maxlength="1" ng-model="o4" ng-keyup="otpKey($event,4)">
                                <input maxlength="1" ng-model="o5" ng-keyup="otpKey($event,5)">
                                <input maxlength="1" ng-model="o6" ng-keyup="otpKey($event,6)">

                            </div>

                        </div>


                        <div class="newLoginField" ng-show="permissiontoopen">

                            <label>
                                New Password
                            </label>

                            <div class="newRegisterPasswordField">

                                <input type="password" ng-model="Password1"
                                       placeholder="Enter New Password">

                                <button type="button"
                                        class="newPasswordToggle">

                                    <i class="fa-regular fa-eye"></i>

                                </button>

                            </div>

                        </div>


                        <div class="newLoginField" ng-show="permissiontoopen">

                            <label>
                                Confirm Password
                            </label>

                            <div class="newRegisterPasswordField">

                                <input type="password" ng-model="Password2"
                                       placeholder="Enter Confirm Password ">

                                <button type="button"
                                        class="newPasswordToggle">

                                    <i class="fa-regular fa-eye"></i>

                                </button>

                            </div>

                        </div>


                        <button class="newLoginPrimaryBtn" ng-show="permissiontoopen" id="forgotPasswordContinue" ng-click="Updatepass()">

                            <span>Continue</span>

                            <i class="fa-solid fa-arrow-right"></i>

                        </button>

