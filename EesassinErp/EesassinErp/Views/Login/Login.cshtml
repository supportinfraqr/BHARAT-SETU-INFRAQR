<style>
    [ng\:cloak], [ng-cloak], [data-ng-cloak], [x-ng-cloak], .ng-cloak, .x-ng-cloak {
        display: none !important;
    }
    button.swal2-confirm.swal2-styled {
        background: #022B5E !important;
    }

    .registerBtnRow {
        display: flex;
        gap: 10px;
        width: 100%;
    }

        .registerBtnRow .newRegisterWhatsappBtn {
            flex: 1;
        }
    .red-validation {
        border: 1px solid #d65e65 !important;
    }

    .newOtpBoxes input {
        border: 1px solid #ccc;
        transition: .2s;
    }

    .otp-error input {
        border: 1px solid #dc3545 !important;
    }

    .otp-success input {
        border: 1px solid #28a745 !important;
    }
</style>
