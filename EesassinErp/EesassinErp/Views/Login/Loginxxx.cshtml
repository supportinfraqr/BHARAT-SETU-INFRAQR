@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = null;
}
<!DOCTYPE html>
<html ng-app="myLoginApp">
<head>
     
    <style>
        .modal {
            z-index: 1050;
        }

        .modal-backdrop {
            z-index: 1040;
        }

        .swal-overlay {
            z-index: 200000 !important;
        }

        .swal-modal {
            z-index: 200001 !important;
        }
        .text-danger {
            color: red;
        }

        .cropper-view-box,
        .cropper-face {
            border-radius: 50%;
        }

        .cropper-view-box {
            outline: 2px solid #39f;
        }

        #cropModal {
            position: fixed !important;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,.6);
            z-index: 999999 !important;
        }

            #cropModal .modal-dialog {
                z-index: 999999 !important;
            }

        .cropper-container {
            z-index: 9999999 !important;
        }

        .EZCOM {
            width: 90%;
            height: 32px;
        }

        .custom-modal {
            display: none;
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,.55);
            z-index: 99999;
        }

        .custom-modal-box {
            width: 92%;
            max-width: 1400px;
            background: #fff;
            margin: 25px auto;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0,0,0,.35);
        }

        .modal-header-custom {
            background: #ff7b00;
            color: #fff;
            padding: 12px 18px;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .close-btn {
            cursor: pointer;
            font-size: 18px;
        }

        .modal-body-custom {
            padding: 15px;
            max-height: 75vh;
            overflow: auto;
        }

        /*.form-row {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 12px;
                    margin-bottom: 12px;
                }*/

        /* .form-group {
                    width: calc(25% - 9px);
                }
        */
        /*.form-group label {
                        display: block;

                        font-weight: 600;
                        margin-bottom: 4px;
                        color: #444;
                    }

                    .form-group input,
                    .form-group select {
                        width: 100%;
                        height: 34px;
                        border: 1px solid #d5d5d5;
                        border-radius: 4px;
                        padding: 5px 8px;

                        box-sizing: border-box;
                    }*/



        .modal-footer-custom {
            background: #f5f5f5;
            padding: 10px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid #ddd;
        }

        .footer-left {
            font-size: 12px;
            font-weight: bold;
            color: #ff7b00;
        }

        .btn-save {
            background: #ff7b00;
            border: none;
            color: #fff;
            padding: 7px 18px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
        }

        .btn-cancel {
            background: #666;
            border: none;
            color: #fff;
            padding: 7px 18px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
            margin-right: 8px;
        }

        /*    @@media(max-width:992px) {

                    .form-group {
                        width: calc(50% - 6px);
                    }
                }

                @@media(max-width:600px) {

                    .form-group {
                        width: 100%;
                    }
                }*/
    </style>
    <style>
        .custom-modal {
            display: none;
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,.5);
            z-index: 99999;
        }

        .custom-modal-content {
            background: #fff;
            width: 80%;
            max-width: 900px;
            margin: 40px auto;
            padding: 20px;
            border-radius: 8px;
        }

        .close {
            float: right;
            cursor: pointer;
            font-size: 24px;
        }

        .swal-modal {
            background-color: #f0f0f0;
            border-radius: 15px;
            /*width: 23%;*/
            width: 90%;
            max-width: 420px;
        }

        .swal-title {
            color: #333;
            font-weight: bold;
        }

        .swal-button {
            background-color: #d73d3d;
            color: white;
        }

            .swal-button:hover {
                background-color: #28a745;
                !important /* green */
                color: white;
            }

        .swal-icon:first-child {
            margin-top: -48px;
            background-color: white;
        }

        .red-validation {
            border: 1px solid #d65e65 !important;
        }

        input[type="text"], input[type="password"] {
            padding: 10px;
            width: 99%;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .password-container {
            display: flex;
            width: 100%;
            align-items: center; /* Vertically center the elements */
        }

        .password-input {
            width: 80%;
            padding-right: 30px; /* Add space for the icon */
            margin-right: 10px; /* Optional: Adjust the margin to add spacing between the input and icon */
        }

        .input-icon {
            text-align: center; /* Center the icons */
        }

            .input-icon i {
                cursor: pointer; /* Make icons clickable */
            }

        .module-section {
            width: 100%;
            margin: 10px 0;
            margin: 8px 0;
        }



        .module-dropdown {
            width: 100%;
            height: 38px;
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 0 10px;
            font-size: 14px;
            background: #fff;
        }

        .change-username {
            text-align: right;
            margin-bottom: 8px;
        }

            .change-username span {
                color: #007BFF;
                cursor: pointer;
                font-size: 12px;
            }

        .full-login-form > * {
            margin-bottom: 12px;
        }

            .full-login-form > *:last-child {
                margin-bottom: 0;
            }

        .captcha-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 8px 0;
        }

        .full-login-form input,
        .full-login-form select {
            width: 100%;
            height: 38px;
        }
    </style>
    <script>
        $(document).ready(function () {

            $('#username-input').keypress(function (event) {
                if (event.which == 13) { // 13 = Enter key
                    //  event.preventDefault(); // prevent default form submit (optional)

                    $('#btnStep1Login').click(); // trigger button click
                    $('#username-input').focus();
                    // keep focus on the input box
                    //setTimeout(function () {
                    //    $('#username-input').focus();
                    //}, 100); // small delay ensures focus applies after button logic
                }
            });
            $('#txtCaptcha').keypress(function (event) {
                if (event.which == 13) { // 13 = Enter key
                    //  event.preventDefault(); // prevent default form submit (optional)

                    $('#btnLogin').click(); // trigger button click
                    $('#txtCaptcha').focus();
                    // keep focus on the input box
                    //setTimeout(function () {
                    //    $('#username-input').focus();
                    //}, 100); // small delay ensures focus applies after button logic
                }
            });
        });
    </script>
    <script>

        function openModal() {
            document.getElementById("workerModal").style.display = "block";
        }

        function closeModal() {
            document.getElementById("workerModal").style.display = "none";
        }

        window.onclick = function (e) {

            var modal = document.getElementById("workerModal");

            if (e.target == modal) {
                modal.style.display = "none";
            }

        }

    </script>
    <script>

        function EZshowTab(tabNo) {

            for (var i = 1; i <= 5; i++) {

                document.getElementById("tab" + i).style.display = "none";

                document.getElementById("btnTab" + i).style.background = "#ececec";
                document.getElementById("btnTab" + i).style.color = "#333";

            }

            document.getElementById("tab" + tabNo).style.display = "block";

            document.getElementById("btnTab" + tabNo).style.background = "#e64124";
            document.getElementById("btnTab" + tabNo).style.color = "white";

        }

    </script>
</head>
<body>

    @*end employee*@
    <div class="container">
        <div class="left-panel">
            <img src="../login/image/logo.png" class="logo" alt="Talent India Logo" />
            <div class="slideshow-container">
                <div class="slide slide1  active">
                    <div class="gif-wrapper">
                        <img src="../login/image/gif1.gif" class="gif" alt="EZ HRMS Demo" />
                        <div class="highlights">
                            <div class="highlight">Excellence</div>
                            <div class="highlight">Innovation</div>
                            <div class="highlight">Sustainability</div>
                        </div>
                    </div>
                </div>
                <div class="slide slide2">
                    <div class="gif-wrapper">
                        <img src="../login/image/gif2.gif" class="gif" alt="EzCompliance" />
                    </div>
                </div>
                <!-- Slide 3 - Testimonials -->
                <div class="slide slide3">
                    <div class="testimonial-slider">
                        <img src="../login/image/content.png" class="quote-image" alt="Quote">
                        <div class="testimonial active">
                            <img src="image/profile.PNG" class="testimonial-img" alt="Client 1">
                            <p class="quote-text">"Empowering Workforce enabling Future!"</p>
                          
                        </div>
                       

                        <div class="testimonial-dots">
                            <span class="t-dot active" onclick="showTestimonial(0)"></span>
                           
                        </div>
                    </div>
                </div>

            </div>
            <!-- Dots -->
            <div class="dots">
                <span class="dot active" onclick="currentSlide(0)"></span>
                <span class="dot" onclick="currentSlide(1)"></span>
                <span class="dot" onclick="currentSlide(2)"></span>
            </div>
        </div>




        <div class="right-panel" ng-controller="myLoginController">
            <div class="welcome-header">
                <h1 class="welcome-text">Welcome</h1>
                <img src="../login/image/ezfulllogo 3.png" alt="Company Logo" class="company-logo" />
            </div>

            <p>Sign in to access India's smart unified Compliance System.</p>

            <!-- Dynamic form container -->
            <div class="form-group" id="form-container">

                <!-- Initial View -->
                <div ng-show="Step1">
                    <input type="text" id="username-input" class="form-control validate" placeholder="Enter Username" ng-model="Username"
                           ng-blur="CUVAILD()" autocomplete="new-username" />

                    <button id="btnStep1Login" ng-click="CheckUserName()">Next</button>
                    <div class="divider1" style="margin-bottom: 1rem;">OR</div>

                  
                    <button type="button" class="demo-btn outline" onclick="openModal()">
                        Registration Worker
                    </button>


                    <div id="workerModal" class="custom-modal ez-modal" style="display:none;">

                        <div style="width:95%;max-width:1400px;margin:20px auto;background:#fff;
                border-radius:8px;overflow:hidden;box-shadow:0 0 15px rgba(0,0,0,.3);">

                            <!-- Header -->
                            <div style="background: #e64124; color: #fff; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; font-size: 20px; font-weight: bold;">

                                <span>Worker Registration</span>

                                <span onclick="closeModal()"
                                      style="cursor:pointer;font-size:24px;font-weight:bold;">✖</span>

                            </div>


                            <br />
                            <!-- ==================== TAB HEADER ==================== -->

                            <div style="display:flex;background:#f5f5f5;border-bottom:2px solid #ddd;">

                                <button type="button" onclick="EZshowTab(1)" id="btnTab1"
                                        style="padding: 12px 20px; background: #e64124; color: white; border: none; cursor: pointer; font-size: 13px; font-weight: bold;">
                                    Basic Details
                                </button>

                                <button type="button" onclick="EZshowTab(2)" id="btnTab2"
                                        style="padding:12px 20px;background:#ececec;color:#333;border:none;cursor:pointer;font-size:13px;font-weight:bold;">
                                    Contact & Address
                                </button>

                                <button type="button" onclick="EZshowTab(3)" id="btnTab3"
                                        style="padding:12px 20px;background:#ececec;color:#333;border:none;cursor:pointer;font-size:13px;font-weight:bold;">
                                    Statutory & Bank Details
                                </button>

                                <button type="button" onclick="EZshowTab(4)" id="btnTab4"
                                        style="padding:12px 20px;background:#ececec;color:#333;border:none;cursor:pointer;font-size:13px;font-weight:bold;">
                                    Nominee Details
                                </button>

                                <button type="button" onclick="EZshowTab(5)" id="btnTab5"
                                        style="padding:12px 20px;background:#ececec;color:#333;border:none;cursor:pointer;font-size:13px;font-weight:bold;">
                                    Upload Documents
                                </button>

                            </div>

                            <!-- ==================== TAB 1 ==================== -->

                            <div id="tab1" style="display: block; padding: 20px;">

                                <h5 style="text-align: left; margin-bottom: 15px; color: #e64124;">Basic Details</h5>

                                <div style="display:flex;flex-wrap:wrap;gap:15px;">

                                    <div style="flex: 1; min-width: 220px; text-align: left;">
                                        <label>Ref Employee Code</label>
                                        <input class="EZCOM validateA" id="txtRefEmployeeCode" ng-model="RefEmployeeCode"   name="RefEmployeeCode">
                                    </div>

                                    <div style="flex: 1; min-width: 220px; text-align: left;">
                                        <label>Worker Name  <span class="text-danger">*</span></label>
                                        <input class="EZCOM validateA" id="txtEmployeeName" ng-model="EmployeeName" name="EmployeeName">
                                    </div>

                                    <!-- Designation -->
                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Designation <span class="text-danger">*</span></label>
                                        <input class="EZCOM validateA" id="txtEmployeeDesignation" ng-model="EmployeeDesignation">
                                    </div>

                                    <!-- Department -->
                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Department <span class="text-danger">*</span></label>
                                        <input class="EZCOM validateA" id="txtEmployeeDepartment" ng-model="EmployeeDepartment">
                                    </div>

                                    <!-- Father Name -->
                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Father / Husband Name <span class="text-danger">*</span></label>
                                        <input class="EZCOM validateA" id="txtFatherHusbandName" ng-model="FatherHusbandName">
                                    </div>

                                    <!-- Gender -->
                                    <div style="flex:1;min-width:220px;text-align:left;" ng-init="BindGenderList()">
                                        <label>Gender <span class="text-danger">*</span></label>
                                        <select class="EZCOM validateA" ng-model="Gender">
                                            <option value="">Select</option>
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>
                                        </select>
                                    </div>

                                    <!-- Marital Status -->
                                    <div style="flex:1;min-width:220px;text-align:left;" ng-init="BindMaritalStatusList()">
                                        <label>Marital Status <span class="text-danger">*</span></label>
                                        <select class="EZCOM validateA" ng-model="MaritalStatus">
                                            <option value="">Select</option>
                                            <option value="Married">Married</option>
                                            <option value="UnMarried">UnMarried</option>
                                        </select>
                                    </div>




                                    <!-- DOB -->
                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Date of Birth <span class="text-danger">*</span></label>
                                        <input type="date" class="EZCOM validateA" id="txtDateofBirth" ng-model="DateofBirth">
                                    </div>

                                    <!-- DOJ -->
                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Date of Joining <span class="text-danger">*</span></label>
                                      
                                    </div>
                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Blood Group <span class="text-danger">*</span></label>
                                        <input class="EZCOM validateA" id="txtBloodGroup" ng-model="BloodGroup">
                                    </div>
                                    <br />


                                    <div style=" width: 250px; text-align: left;">
                                        <label style="display: block; font-size: 12px; font-weight: bold; margin-bottom: 5px; text-align: left;">
                                            Upload Photo
                                        </label>
                                        <input type="file"
                                               onchange="angular.element(this).scope().openCropper(this)"
                                               style=" border:1px solid #ccc;border-radius:4px;padding:5px;font-size:12px;" class="EZCOM">
                                    </div>



                                </div>

                                <div style="width:100%;margin-top:20px;text-align:right;">

                                    <button onclick="EZshowTab(2)" style="background: grey; color: #fff; border: none; padding: 8px 20px; border-radius: 4px; font-size: 12px; cursor: pointer;width:10%">
                                        Next →
                                    </button>

                                    <button style="background: #ff6e6e; color: #fff; border: none; padding: 8px 20px; border-radius: 4px; font-size: 12px; cursor: pointer; width: 10% " ng-click="SaveEmployee()">
                                        Submit
                                    </button>

                                </div>

                            </div>

                            <!-- ==================== TAB 2 ==================== -->

                            <div id="tab2" style="display:none;padding:20px;">

                                  <h5 style="text-align: left; margin-bottom: 15px; color: #e64124;">Contact Details</h5>

                                <div>

                                    <div style="display:flex;flex-wrap:wrap;gap:15px;">

                                        <div style="flex:1;min-width:220px;text-align:left;">
                                            <label>Mobile Number <span class="text-danger">*</span></label>
                                            <input class="EZCOM validateA"
                                                   id="txtMobileNumber"
                                                   ng-model="MobileNumber"
                                                    onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))"  
                                                   onblur="validatePhoneNo('#txtMobileNumber')"
                                                   numeric-only
                                                   dynamic-length
                                                   maxlength="10"
                                                   minlength="10">
                                        </div>

                                        <div style="flex:1;min-width:220px;text-align:left;">
                                            <label>Alternate Mobile</label>
                                            <input class="EZCOM"
                                                   id="txtAlternativeMobileNumber"
                                                   ng-model="AlternativeMobileNumber"
                                                   onblur="validatePhoneNo('#txtAlternativeMobileNumber')" 
                                                    onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))"  
                                                   numeric-only
                                                   dynamic-length
                                                   maxlength="10"
                                                   minlength="10">
                                        </div>

                                        <div style="flex:1;min-width:220px;text-align:left;">
                                            <label>Worker Email ID <span class="text-danger">*</span></label>
                                            <input class="EZCOM validateA"
                                                   id="txtEmployeeEmailID"
                                                   ng-model="EmployeeEmailID"
                                                   onblur="validateEmail('#txtEmployeeEmailID')">
                                        </div>





                                        <div style="flex:1;min-width:220px;text-align:left;" ng-init="AllCity()">
                                            <label>State <span class="text-danger">*</span></label>
                                            <select class="EZCOM validateA"
                                                    ng-model="State">
                                                <option value="">Select State</option>
                                                <option ng-repeat="x in AllCityList"  value="{{x.STATE_NAME}}">
                                                    {{x.STATE_NAME}}
                                                </option>
                                            </select>
                                        </div>

                                        <div style="flex:1;min-width:220px;text-align:left;">
                                            <label>City <span class="text-danger">*</span></label>
                                            <select class="EZCOM validateA"
                                                    ng-model="City">
                                                <option value="">Select City</option>
                                                <option ng-repeat="x in AllCityList | filter:{STATE_NAME: State}"
                                                        value="{{x.CITY_NAME}}">
                                                    {{x.CITY_NAME}}
                                                </option>
                                            </select>
                                        </div>

                                        <div style="flex:1;min-width:220px;text-align:left;">
                                            <label>Pincode <span class="text-danger">*</span></label>
                                            <input class="EZCOM validateA"
                                                   id="txtPincode" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" maxlength="6"
                                                   ng-model="Pincode">
                                        </div>
                                        <div style="flex:1;min-width:320px;text-align:left;">
                                            <label>Present Address <span class="text-danger">*</span></label>
                                            <input class="EZCOM validateA"
                                                   id="txtPresentAddress"
                                                   ng-model="PresentAddress">
                                        </div>
                                        <div style="flex:1;min-width:320px;text-align:left;">
                                            <label>Permanent Address <span class="text-danger">*</span></label>
                                            <input class="EZCOM validateA"
                                                   id="txtPermanentAddress"
                                                   ng-model="PermanentAddress">
                                        </div>





                                    </div>

                                </div>
                                <div style="width:100%;margin-top:20px;text-align:right;">

                                    <button onclick="EZshowTab(3)" style="background: grey; color: #fff; border: none; padding: 8px 20px; border-radius: 4px; font-size: 12px; cursor: pointer;width:10%">
                                        Next →
                                    </button>

                                    <button style="background: #ff6e6e; color: #fff; border: none; padding: 8px 20px; border-radius: 4px; font-size: 12px; cursor: pointer; width: 10% " ng-click="SaveEmployee()">
                                        Submit
                                    </button>

                                </div>
                            </div>

                            <!-- ==================== TAB 3 ==================== -->

                            <div id="tab3" style="display:none;padding:20px;">

                             <h5 style="text-align: left; margin-bottom: 15px; color: #e64124;">Statutory & Bank Details</h5>

                                <div style="display:flex;flex-wrap:wrap;gap:15px;">

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>PAN No</label>
                                        <input class="EZCOM"
                                               id="txtPANNumber"
                                               ng-model="PANNumber"
                                               maxlength="10"
                                               minlength="10"
                                               style="text-transform:uppercase;">
                                    </div>

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Aadhaar No</label>
                                        <input type="text"
                                               class="EZCOM"
                                               id="txtAdharCardNumber"
                                               ng-keypress="onlyNumbers($event)"
                                               ng-model="AdharCardNumber"
                                               numeric-only
                                               dynamic-length
                                               maxlength="12"
                                               minlength="12">
                                    </div>

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>UAN No</label>
                                        <input class="EZCOM"
                                               id="txtPreviousUAN"
                                               ng-model="PreviousUAN">
                                    </div>

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>PF Account No</label>
                                        <input class="EZCOM"
                                               id="txtPFAccount"
                                               ng-model="PFAccount">
                                    </div>

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Bank Account No.</label>
                                        <input class="EZCOM"
                                               id="txtBankAccountNumber"
                                               ng-model="BankAccountNumber"
                                               numeric-only>
                                    </div>

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Bank IFSC Code</label>
                                        <input class="EZCOM"
                                               id="txtBankIFSCCode"
                                               ng-model="BankIFSCCode">
                                    </div>

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Previous ESIC</label>
                                        <input class="EZCOM"
                                               id="txtPreviousESI"
                                               ng-model="PreviousESI">
                                    </div>

                                    <div style="flex:1;min-width:220px;text-align:left;">
                                        <label>Gross Salary</label>
                                        <input class="EZCOM"
                                               id="txtGrossSalary"
                                               ng-model="GrossSalary"
                                               numeric-only>
                                    </div>

                                </div>
                                <div style="width:100%;margin-top:20px;text-align:right;">

                                    <button onclick="EZshowTab(4)" style="background: grey; color: #fff; border: none; padding: 8px 20px; border-radius: 4px; font-size: 12px; cursor: pointer;width:10%">
