@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = null;
}
<!DOCTYPE html>
<html ng-app="myLoginApp">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EZ Compliance Login</title>
    <link rel="stylesheet" type="text/css" href="../login/style.css">
    <link href="@Url.Content("~/Content/plugins/assets/css/font-icons/font-awesome.css")" rel="stylesheet" media="all" />
    <script type="text/javascript" src="@Url.Content("~/scripts/jquery-1.12.4.js")"></script>
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/angular.min.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/Scripts/myjslib/loginController.js?Ver="+ViewBag.Version+"")"></script>

    <script type="text/javascript" src="@Url.Content("~/scripts/myjslib/myJs.js?Ver="+ViewBag.Version+"")"></script>

    <style>
        .swal-modal {
            background-color: #f0f0f0;
            border-radius: 15px;
            /*width: 23%;*/
            width: 90%;
            max-width: 420px;
        }

        .swal-title {
            color: #333;
            font-weight: bold;
        }

        .swal-button {
            background-color: #d73d3d;
            color: white;
        }

            .swal-button:hover {
                background-color: #28a745;
                !important /* green */
                color: white;
            }

        .swal-icon:first-child {
            margin-top: -48px;
            background-color: white;
        }

        .red-validation {
            border: 1px solid #d65e65 !important;
        }

        input[type="text"], input[type="password"] {
            padding: 10px;
            width: 99%;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .password-container {
            display: flex;
            width: 100%;
            align-items: center; /* Vertically center the elements */
        }

        .password-input {
            width: 80%;
            padding-right: 30px; /* Add space for the icon */
            margin-right: 10px; /* Optional: Adjust the margin to add spacing between the input and icon */
        }

        .input-icon {
            text-align: center; /* Center the icons */
        }

            .input-icon i {
                cursor: pointer; /* Make icons clickable */
            }

        .module-section {
            width: 100%;
            margin: 10px 0;
            margin: 8px 0;
        }



        .module-dropdown {
            width: 100%;
            height: 38px;
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 0 10px;
            font-size: 14px;
            background: #fff;
        }

        .change-username {
            text-align: right;
            margin-bottom: 8px;
        }

            .change-username span {
                color: #007BFF;
                cursor: pointer;
                font-size: 12px;
            }

        .full-login-form > * {
            margin-bottom: 12px;
        }

            .full-login-form > *:last-child {
                margin-bottom: 0;
            }

        .captcha-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 8px 0;
        }

        .full-login-form input,
        .full-login-form select {
            width: 100%;
            height: 38px;
        }
    </style>
    <script>
        $(document).ready(function () {

            $('#username-input').keypress(function (event) {
                if (event.which == 13) { // 13 = Enter key
                    //  event.preventDefault(); // prevent default form submit (optional)

                    $('#btnStep1Login').click(); // trigger button click
                    $('#username-input').focus();
                    // keep focus on the input box
                    //setTimeout(function () {
                    //    $('#username-input').focus();
                    //}, 100); // small delay ensures focus applies after button logic
                }
            });
            $('#txtCaptcha').keypress(function (event) {
                if (event.which == 13) { // 13 = Enter key
                    //  event.preventDefault(); // prevent default form submit (optional)

                    $('#btnLogin').click(); // trigger button click
                    $('#txtCaptcha').focus();
                    // keep focus on the input box
                    //setTimeout(function () {
                    //    $('#username-input').focus();
                    //}, 100); // small delay ensures focus applies after button logic
                }
            });
        });
    </script>

</head>
<body>
