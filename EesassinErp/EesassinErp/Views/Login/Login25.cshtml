                    </div>
                </div>
                <div class="slide slide2">
                    <div class="gif-wrapper">
                        <img src="../login/image/gif2.gif" class="gif" alt="EzCompliance" />
                    </div>
                </div>
                <!-- Slide 3 - Testimonials -->
                <div class="slide slide3">
                    <div class="testimonial-slider">
                        <img src="../login/image/content.png" class="quote-image" alt="Quote">
                        <div class="testimonial active">
                            <img src="image/profile.PNG" class="testimonial-img" alt="Client 1">
                            <p class="quote-text">"Empowering Workforce enabling Future!"</p>
                            <!--      <div class="client-info">
                                <div class="client-name">Priya Mehta</div>
                                <div class="client-role">Compliance Officer, TechNova</div>
                            </div> -->
                        </div>
                        <!--   <div class="testimonial">
                            <img src="../login/image/profile.PNG" class="testimonial-img" alt="Client 2">
                            <p class="quote-text">"The dashboard is clean and user-friendly. Great support team too!"</p>
                            <div class="client-info">
                                <div class="client-name">Rohan Kapoor</div>
                                <div class="client-role">HR Manager, GreenLogix</div>
                            </div>
                        </div>
                        <div class="testimonial">
                            <img src="../login/image/profile.PNG" class="testimonial-img" alt="Client 3">
                            <p class="quote-text">"Finally, a system that actually simplifies compliance processes."</p>
                            <div class="client-info">
                                <div class="client-name">Anjali Rao</div>
                                <div class="client-role">Legal Consultant, ApexGroup</div>
                            </div>
                        </div> -->

                        <div class="testimonial-dots">
                            <span class="t-dot active" onclick="showTestimonial(0)"></span>
                            <!-- <span class="t-dot" onclick="showTestimonial(1)"></span>
                            <span class="t-dot" onclick="showTestimonial(2)"></span> -->
                        </div>
                    </div>
                </div>

            </div>
            <!-- Dots -->
            <div class="dots">
