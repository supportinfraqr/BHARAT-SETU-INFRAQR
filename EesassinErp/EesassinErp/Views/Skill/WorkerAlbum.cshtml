@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Worker Skill Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link href="~/Content/Dashboards/SkillPages/WorkerSkillDashboard/style.css" rel="stylesheet" />
<script src="~/scripts/RetailJsLib/SkillController.js"></script>
<div class="workerSkillDash px-4 py-4">
    <!-- ======================================================
        HEADER
    ====================================================== -->

    <div class="workerSkillHeader">

        <div class="workerSkillTitleArea">
            <h2 class="workerSkillTitle">Worker Skill Dashboard</h2>
            <p class="workerSkillSubtitle">
                Learn new skills through training modules.
            </p>
        </div>

        <div class="workerSkillActions">

            <!-- Search -->

            <div class="workerSkillSearch">

                <i class="fas fa-search"></i>

                <input type="text"
                       class="form-control"
                       placeholder="Search Modules..." />

            </div>

            <!-- Filter -->

            <div class="dropdown">

                <button class="btn workerSkillFilterBtn dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">

                    <i class="fas fa-filter me-2"></i>
                    Filter

                </button>

                <ul class="dropdown-menu workerSkillDropdown">

                    <li>
                        <a class="dropdown-item active" href="#">
                            All Modules
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" href="#">
                            Live Modules
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" href="#">
                            Disabled Modules
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </div>


    <!-- ======================================================
        MODULE GRID
    ====================================================== -->



    <div class="workerSkillGrid" ng-init="getWorkerModuleAlbum()">
        <div class="workerSkillCard" ng-repeat="x in AlbumDetail">

            <div class="workerSkillThumb" ng-click="WorkerSkillModule(x.id)">


                <img ng-src="{{x.CourseCoverPage || '../Content/Skill/coverpreview.png'}}">
                <div class="workerSkillPlay">

                    <i class="fas fa-play"></i>

                </div>

            </div>

            <div class="workerSkillBody">

                <h5 class="workerSkillModuleTitle">
                    {{x.Modulename}}
                </h5>

                <p class="workerSkillTrainer">

                    Trainer :
                    <span>{{x.Contractor}}</span>

                </p>

            </div>

        </div>

       

    </div>



    <!-- ======================================================
        LOAD MORE
    ====================================================== -->

    <div class="workerSkillLoadMore">

        <button class="btn workerSkillLoadBtn">

            Load More

            <i class="fas fa-arrow-right ms-2"></i>

        </button>

    </div>

</div>