                                                </div>


                                            </div>

                                        </div>

                                    </div>

                                </div>
                            </div>

                        </div>


                        <!-- FOOTER NAVIGATION -->

                        <div class="courseFooter">

                            <button class="btnCourseBack">

                                <i class="bi bi-arrow-left"></i>

