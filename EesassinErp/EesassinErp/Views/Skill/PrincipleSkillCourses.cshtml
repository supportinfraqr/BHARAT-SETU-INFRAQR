                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button class="btnModuleSave" id="btnSaveModule" type="button" ng-click="SaveModule()">
                        <i class="bi bi-plus-circle"></i>
                        Add Module
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>
