                                    <span class="requirementTitle">
                                        Auto Certificate Issuing
                                    </span>

                                    <span class="requirementDesc">
                                        Workers receive certificates automatically after course completion.
                                    </span>

                                </label>

                            </div>

                        </div>

                        <div class="requirementItem">

                            <div class="form-check">

                                <input class="form-check-input"
                                       type="checkbox"
                                       ng-model="CourseReminder">

                                <label class="form-check-label"
                                       for="certificateIssue">

