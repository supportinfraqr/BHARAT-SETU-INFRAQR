                        </div>

                        <!-- Publish -->

                        <div class="col-md-12">

                            <div class="modulePublishBox">

                                <span>

                                    Publish this Module

                                </span>

                                <div class="form-check form-switch">
                                    <input class="form-check-input"
                                           type="checkbox" ng-model="ChkmodulePublish">

                                </div>

