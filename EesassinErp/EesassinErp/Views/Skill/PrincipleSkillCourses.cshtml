                                <label class="form-check-label" for="videoWatching">

                                    <span class="requirementTitle">
                                        Enforce Video Watching
                                    </span>

                                    <span class="requirementDesc">
                                        Workers must watch certain percentage of video to advance.
                                    </span>

                                </label>

                            </div>

                            <div class="requirementInputRow">

                                <input type="number"
                                       ng-model="LimitVideo"
