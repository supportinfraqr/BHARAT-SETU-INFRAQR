                                        Course Reminder
                                    </span>

                                    <span class="requirementDesc">
                                        Workers receive Reminder automatically if course pending.
                                    </span>

                                </label>

                            </div>

                        </div>



                     

                    </div>


                    <!-- ===================================== -->
                    <!-- STEP 2 FOOTER -->
                    <!-- ===================================== -->

                    <div class="courseFooter">

