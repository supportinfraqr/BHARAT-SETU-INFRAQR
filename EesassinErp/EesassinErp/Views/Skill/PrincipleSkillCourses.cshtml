                                id="btnStep2Back"
                                class="btnCourseBack">

                            <i class="bi bi-arrow-left"></i>

                            Back

                        </button>

                        <button type="button"
                                id="btnStep2Next"
                                class="btnCourseNext" ng-click="UpdateFlags()">

                            Next

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </div>

                </div>


                <!-- ===================================== -->
                <!-- STEP 3 -->
                <!-- ===================================== -->
                <div id="courseStep3" class="d-none">


                    <!-- STEP 3 : TRAINING CERTIFICATE -->

                    <div class="courseSectionCard courseCertificateSection">

                        <!-- Header -->

                        <div class="certificateHeader">

                            <h2 class="certificateTitle">

                                Training Certificate

                            </h2>

                            <p class="certificateSubTitle">

                                This certificate will be issued whenever an employee completes the training.

                            </p>

                        </div>



                        <!-- Certificate Preview -->

                        <div class="certificatePreviewWrapper">

                            <div class="certificatePreviewCard">

                                <img id="certificatePreviewImage"
                                     src="~/Content/Dashboards/SkillPages/PrincipleSkillDashboard/PrincipleSkillCourses/certificate-template.png"
                                     alt="Certificate">

                            </div>

                        </div>



                        <!-- Action Buttons -->
                        @*<div class="certificateActions">

                    <input type="file"
                           id="certificateUpload"
                           accept="image/*"
                           hidden>

                    <button type="button"
                            id="btnReplaceCertificate"
                            class="btnCoursePrimary">

                        <i class="bi bi-arrow-repeat me-2"></i>

                        Replace

                    </button>

                    <button type="button"
                            id="btnPreviewCertificate"
                            class="btnCourseOutline">

                        <i class="bi bi-eye me-2"></i>

                        Preview

                    </button>

                </div>*@

                    </div>



                    <!-- FOOTER -->

                    <div class="courseFooter">

                        <button type="button"
                                id="btnStep3Back"
                                class="btnCourseBack">

                            <i class="bi bi-arrow-left me-2"></i>

                            Back

                        </button>

                        @*<button type="button"
                                id="btnSaveCourse"
                                class="btnCourseNext">

                            <i class="bi bi-check-circle me-2"></i>

                            Save

                        </button>*@

                    </div>

                </div>

            </div>
            <!-- Right Column -->

        </div>
        <!-- Row -->

    </div>
    <!-- Container -->
    <!-- =======================================================
        ADD MODULE MODAL
    ======================================================= -->

    <div class="modal fade"
         id="addModuleModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content skillModal">

                <!-- Header -->

                <div class="modal-header">

                    <h4 class="modal-title">

                        Add New Module

                    </h4>

                    <button class="btn-close"
                            type="button"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <!-- Body -->

                <div class="modal-body">

                    <div class="row g-4">

                        <!-- Module Name -->

                        <div class="col-md-12">

                            <label class="form-label">

                                Module Name

                            </label>

                            <input type="text"
