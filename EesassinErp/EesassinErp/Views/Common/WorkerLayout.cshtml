        function toggleNotification() {
            var panel = document.getElementById("notificationPanel");

            if (panel.style.right === "0px") {
                panel.style.right = "-360px";
                panel.style.top = "60px";
            } else {
                panel.style.right = "0px";
                panel.style.top = "50px";
            }
        }

    </script>


