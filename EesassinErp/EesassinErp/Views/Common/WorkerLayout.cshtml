    <style>
      #cover-spin {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255,255,255,0.7);
    z-index: 9999;
    display: none;
}

#cover-spin::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border: 4px solid #ddd;
    border-top: 4px solid #022B5E;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

 
    </style> 

