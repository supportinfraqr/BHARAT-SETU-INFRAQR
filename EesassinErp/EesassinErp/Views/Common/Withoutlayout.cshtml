    <script>
        function toggleNotification() {
            var panel = document.getElementById("notificationPanel");

            if (panel.style.right === "0px") {
                panel.style.right = "-360px";
                panel.style.top = "60px";
            } else {
                panel.style.right = "0px";
                panel.style.top = "50px";
            }
        }

    </script>


    <style>
        button.swal2-confirm.swal2-styled {
            background-color: #fd670b !important;
        }

        .orange-checkbox {
            accent-color: orange;
        }

        .btn-primary {
            --bs-btn-color: #fff;
            --bs-btn-bg: #e45d27 !important;
            --bs-btn-border-color: #e45d27 !important;
            --bs-btn-hover-color: #ff;
            --bs-btn-hover-bg: #e45d 2 !important;
            --bs-btn-hover-border-color: #e45d27 !important;
            --bs-btn-focus-shadow-rgb: 49, 132, 253;
            --bs-btn-active-color: #fff;
            --bs-btn-active-bg: #0a58ca;
            --bs-btn-active-border-color: #0a53be;
            --bs-btn-active-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.125);
            --bs-btn-disabled-color: #fff;
            --bs-btn-disabled-bg: #0d6efd;
            --bs-btn-disabled-border-color: #0d6efd;
        }

        .btn-warning {
            --bs-btn-color: #000;
            --bs-btn-bg: #e45d27 !important;
            --bs-btn-border-color: #e45d27 !important;
            --bs-btn-hover-color: #ff;
            --bs-btn-hover-bg: #e45d 2 !important;
            --bs-btn-hover-border-color: #e45d 2 !important;
            --bs-btn-focus-shadow-rgb: 217, 164, 6;
            --bs-btn-active-color: #000;
            --bs-btn-active-bg: #ffcd39;
            --bs-btn-active-border-color: #ffc720;
            --bs-btn-active-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.125);
            --bs-btn-disabled-color: #000;
            --bs-btn-disabled-bg: #ffc107;
            --bs-btn-disabled-border-color: #ffc107;
        }

        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .loader-message {
            background: #fff;
            padding: 20px 40px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
        }

            .loader-message .spinner {
                border: 4px solid #f3f3f3;
                border-top: 4px solid #3498db;
                border-radius: 50%;
                width: 40px;
                height: 40px;
                margin: 0 auto 10px;
                animation: spin 1s linear infinite;
            }

        .red-validation {
            border: none !important;
            border-bottom: 2px solid #e74c3c !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }

        /* select2 */
        .select2-container .select2-selection.red-validation {
            border: none !important;
            border-bottom: 2px solid #e74c3c !important;
            border-radius: 0 !important;
        }
    </style>

    <style>
        #cover-spin {
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255,255,255,0.7);
            z-index: 9999;
            display: none;
        }

            #cover-spin::after {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 40px;
                height: 40px;
                margin: -20px 0 0 -20px;
                border: 4px solid #ddd;
                border-top: 4px solid #F37437;
                border-radius: 50%;
                animation: spin 1s linear infinite;
            }
    </style>

    <style>
        .navbar {
            background: #F4F9FF;
            color: #022B5E;
        }

        .dropbtn {
            border: none;
            color: #022B5E;
            background: transparent;
            border-radius: 999px;
            padding: 6px 20px;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: 0.3s;
            border: 1px solid #022B5E;
        }

            .dropbtn:hover {
                background: transparent;
                color: #022B5E;
                border: 2px solid #022B5E;
            }


        .profile-btn {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid #022B5E;
            background: transparent;
            padding: 0;
        }

        .logo {
            height: 18px;
        }
    </style>

</head>
