            .nav-item:hover {
                background-color: #f0f0f0; /* Slight hover effect for better interactivity */
            }
    </style>

    <script>
        $(document).ready(function () {
            $(".submenu").each(function () {
                var submenu = $(this);
                if (submenu.is(':visible')) {
                    submenu.prev().find('.toggle-icon').html('<i class="fas fa-minus"></i>');
                } else {
                    submenu.prev().find('.toggle-icon').html('<i class="fas fa-plus"></i>');
                }
            });
            $('#toggle-master, #master-menu-link').click(function () {
                var submenu = $('#master-submenu');
                var icon = $('#toggle-master');

                submenu.stop(true, true).slideToggle(300);
                if (icon.html().includes('fa-minus')) {
                    icon.html('<i class="fas fa-plus"></i>');
                } else {
                    icon.html('<i class="fas fa-minus"></i>');
                }
            });

            $('#toggle-report, #report-menu-link').click(function () {
                var submenu = $('#report-submenu');
                var icon = $('#toggle-report');

                submenu.stop(true, true).slideToggle(300);

                if (icon.html().includes('fa-minus')) {
                    // If the HTML contains the 'minus' icon
                    icon.html('<i class="fas fa-plus"></i>');
                } else {
                    // If the HTML does not contain the 'minus' icon
                    icon.html('<i class="fas fa-minus"></i>');
                }
            });

            // Toggle Dashboard Menu Submenu with slide (Icon and Link click)
            $('#toggle-Dashboard, #Dashboard-menu-link').click(function () {
                var submenu = $('#dashboard-submenu');  // Corrected to #dashboard-submenu
                var icon = $('#toggle-Dashboard');

                submenu.stop(true, true).slideToggle(300);  // Smooth slide toggle

                // Update the icon based on submenu visibility
                if (icon.html().includes('fa-minus')) {
                    // If the HTML contains the 'minus' icon
                    icon.html('<i class="fas fa-plus"></i>');
                } else {
                    // If the HTML does not contain the 'minus' icon
                    icon.html('<i class="fas fa-minus"></i>');
                }
            });
        });
    </script>

