<body>
    <div id="cover-spin"></div>
    <!-- FULL PAGE PROCESS OVERLAY -->
    <div ng-show="showLogoutProcess"
         style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.6); z-index:99999;
            display:flex; align-items:center; justify-content:center;">

        <div style="background:#fff; width:420px; padding:25px; border-radius:8px;
                text-align:center; box-shadow:0 0 20px rgba(0,0,0,0.3);">

            <h3 style="margin-bottom:15px;">Please wait...</h3>

            <div style="text-align:left; font-size:14px; line-height:26px;">

                <div>
                    <b>1.</b> Securing and saving your data...
                    <span ng-show="logoutStep >= 1" style="color:green;">✔</span>
                </div>

                <div>
                    <b>2.</b> Updating system preferences and settings...
                    <span ng-show="logoutStep >= 2" style="color:green;">✔</span>
                </div>

                <div>
                    <b>3.</b> Recording activity logs for audit...
                    <span ng-show="logoutStep >= 3" style="color:green;">✔</span>
                </div>

                <div ng-show="logoutStep >= 4" style="margin-top:10px; font-weight:bold; color:#d9534f;">
                    Finalizing session and logging out securely...
                </div>

            </div>

            <div style="margin-top:20px;">
                <span style="font-size:12px; color:#777;">
                    Please do not refresh or close the browser.
                </span>
            </div>
        </div>
    </div>

    <div id="file-validation-loader" style="display: none;">
        <div class="loader-overlay">
            <div class="loader-message">
                <div class="spinner"></div>
                <p>Validating the uploaded file. Please wait a moment.</p>
            </div>
        </div>
    </div>
    
    <!--NAVBAR-->
    <nav class="navbar px-4" style="background: #F4F9FF;" ng-init="BindMenus()">
        <!-- Left logo -->
        <div class="nav-left">
            <img src="~/CommonDashboard/assets/icons/NewLogo.png" alt="Logo" class="logo" />
        </div>
      
        <!-- Center nav items -->
        <div class="nav-center d-flex gap-3">
            <!-- Dashboard dropdown -->
          
            <div class="dropdown" >
                <button class="dropbtn d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                    Dashboard
                    <img src="~/CommonDashboard/assets/icons/NewDropArrow.svg" class="arrow ms-1" alt="Arrow">
                </button>
                <ul class="dropdown-menu">
                    <li ng-if="isDashboardLoading">
                        <i class="fa fa-spinner fa-spin"></i> Loading...
                    </li>
                    <li ng-if="!isDashboardLoading" ng-repeat="x in DahboardList | filter: { PageName : 'Dashboard' }">

                        <a ng-click="loadPage(x.Url);ManageLog('Click on '+ x.SectionName)" class="dropdown-item">{{ x.SectionName }}</a>
                    </li>
                </ul>
            </div>

            <!-- Master dropdown -->
            <div class="dropdown"  >
                <button class="dropbtn d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                    Master
                    <img src="~/CommonDashboard/assets/icons/NewDropArrow.svg" class="arrow ms-1" alt="Arrow">
                </button>
                <ul class="dropdown-menu">
                    <li ng-if="isDashboardLoading">
                        <i class="fa fa-spinner fa-spin"></i> Loading...
                    </li>
                    <li ng-if="!isDashboardLoading" ng-repeat="x in DahboardList | filter: { PageName : 'Master' }">

                        <a class="dropdown-item" ng-click="loadPage(x.Url);ManageLog('Click on '+ x.SectionName)">{{ x.SectionName }}</a>
                    </li>
                </ul>
            </div>

            <!-- Report dropdown -->
            <div class="dropdown"  >
                <button class="dropbtn d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                    Report
                    <img src="~/CommonDashboard/assets/icons/NewDropArrow.svg" class="arrow ms-1" alt="Arrow">
                </button>
                <ul class="dropdown-menu">
                    <li ng-if="isDashboardLoading">
                        <i class="fa fa-spinner fa-spin"></i> Loading...
                    </li>
                    <li ng-if="!isDashboardLoading" ng-repeat="x in DahboardList | filter: { PageName : 'Report' }">

                        <a class="dropdown-item" ng-click="loadPage(x.Url);ManageLog('Click on '+ x.SectionName)">{{ x.SectionName }}</a>
                    </li>

                </ul>
            </div>
        </div>

        <!-- Right icons & profile -->
        <div class="nav-right d-flex align-items-center gap-3">


            @*<div class="griviences" ng-show="LoginId == 512 || LoginId == 513 || LoginId == 714">
            <a ng-href="{{ LoginId == 512 ? '../RetailSection/supportGrievances' :
           LoginId == 513 ? '../RetailSection/ContractorGrievances' :
           LoginId == 714 ? '../RetailSection/WorkerGrievances' : '#' }}">
                <img src="~/CommonDashboard/assets/icons/Grievance.svg"
                     alt="Grievance" class="icon cursor-pointer">
            </a>
        </div>*@
            <div class="griviences" ng-show="loginType==5 || loginType==6 || loginType==7">
                <a ng-href="{{loginType==5 || loginType==6 ? '../RetailSection/ContractorGrievances' :
               loginType==7 ? '../grievances/WorkerGrievances' : '#' }}">
                    <img src="~/CommonDashboard/assets/icons/Grievance.svg"
                         alt="Grievance" class="icon cursor-pointer">
                </a>
            </div>



            <img src="~/CommonDashboard/assets/icons/notify.svg" style="display:none" onclick="toggleNotification()"
                 alt="Notify" class="icon cursor-pointer">

            <div id="notificationPanel" style="position:fixed;
        top:60px;
        right:-360px;
        width:350px;
        height:80vh;
        background:#fff;
        box-shadow:-4px 0 15px rgba(0,0,0,0.15);
        transition:all 0.4s ease;
        z-index:9999;
        border-radius:10px 0 0 10px;
     " ng-init="BindNotification()">

                <!-- Header -->
                <div style="
        padding:12px 16px;
        font-weight:600;
        border-bottom:1px solid #eee;
        display:flex;
        justify-content:space-between;
        align-items:center; BACKGROUND-COLOR: #fd670b;
     ">
                    Notifications
                    <span onclick="toggleNotification()"
                          style="cursor:pointer;font-size:18px;">✕</span>
                </div>

                <!-- Notification List -->
                <div style="padding:10px;overflow-y:auto;height:calc(80vh - 50px);">

                    <div style="padding:10px;border-bottom:1px solid #f1f1f1;" ng-repeat="x in AllNotification" ng-model="Notification">
                        🔔 {{x.Conversation}} {{x.CreatedOn}}
                    </div>



                </div>
            </div>

            <div class="dropdown">
                <button class="profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <img ng-src="{{Photo || '../content/profile.png'}}" alt="Profile">
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" ng-click="SwithctoProfile();ManageLog('open Profile page')">Profile</a></li>
                    <li><a class="dropdown-item" ng-show="loginType==5 || loginType=='5'" ng-click="switchtovendoradmin();ManageLog('open Switch to  Retail Admin page')"> Admin Setup</a></li>
                    <!--<li><a class="dropdown-item" ng-show="loginType==6" ng-click="switchtovendoradmin();ManageLog('open Switch to vendor Admin page')">  Admin Setup</a></li>-->
                    <li><a class="dropdown-item" ng-click="Logout();ManageLog('Logout from Retail Section')">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    

    @RenderBody()


    <!-- Email Sending Modal -->
    <div class="modal fade" id="emailSendingModal"
         data-bs-backdrop="static"
         data-bs-keyboard="false"
         tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4 position-relative">

                <!-- Close Button -->
                <button type="button"
                        class="btn-close position-absolute top-0 end-0 m-2"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

                <div class="modal-body">
                    <i class="fa fa-spinner fa-spin fa-2x mb-3"></i>
                    <h6 class="mb-0">
                        Your emails are in the process of being sent.<br>
                        Thank you for your patience.
                    </h6>
                </div>
            </div>
        </div>
    </div>



