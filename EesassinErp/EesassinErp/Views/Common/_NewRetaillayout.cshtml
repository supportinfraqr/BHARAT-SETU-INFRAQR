    <style>
        /* ── QR SYSTEM pages: match the ERP theme (muted orange + neutral),
               no bright Tailwind indigo/blue/green/red highlights ── */
        body.qr-page {
            background: #f4f6f9;
        }
        /* Primary actions → ERP orange */
        body.qr-page .btn-action,
        body.qr-page .btn-act-primary,
        body.qr-page .btn-save,
        body.qr-page .btn-approve,
        body.qr-page .btn-dl,
        body.qr-page .btn-card,
        body.qr-page .btn-qr-action {
            background: #e45d27 !important;
            border-color: #e45d27 !important;
            color: #fff !important;
        }
        body.qr-page .btn-action:hover,
        body.qr-page .btn-act-primary:hover,
        body.qr-page .btn-save:hover,
        body.qr-page .btn-approve:hover,
        body.qr-page .btn-dl:hover,
        body.qr-page .btn-card:hover,
        body.qr-page .btn-qr-action:hover {
            background: #c94a1d !important;
            border-color: #c94a1d !important;
        }
        /* Success actions stay green (semantic) but muted ERP tone */
        body.qr-page .btn-act-success,
        body.qr-page .btn-success {
            background: #2f7d43 !important;
            border-color: #2f7d43 !important;
            color: #fff !important;
        }
        /* Destructive actions → muted red */
        body.qr-page .btn-reject {
            background: #c0392b !important;
            border-color: #c0392b !important;
            color: #fff !important;
        }
        /* Ghost/secondary → neutral */
        body.qr-page .btn-ghost,
        body.qr-page .filter-btn {
            background: #fff !important;
            border: 1px solid #d1d5db !important;
            color: #475569 !important;
        }
        /* Links → ERP orange */
        body.qr-page a.op-link,
        body.qr-page a.card-link,
        body.qr-page .leaf-name a {
            color: #e45d27 !important;
        }
        /* Inputs focus → orange ring */
        body.qr-page input:focus,
        body.qr-page textarea:focus,
        body.qr-page select:focus {
            border-color: #e45d27 !important;
            box-shadow: 0 0 0 2px rgba(228, 93, 39, 0.15) !important;
        }
        /* Tabs active → orange */
        body.qr-page .tab-btn.active,
        body.qr-page .user-tab.active,
        body.qr-page .nav-pills .nav-link.active {
            background: #e45d27 !important;
            border-color: #e45d27 !important;
            color: #fff !important;
        }
        /* Headings/indigo accents → neutral navy-graphite */
        body.qr-page .qr-page-title,
        body.qr-page .branch-title,
        body.qr-page .entity-name,
        body.qr-page .wname,
        body.qr-page .op-title {
            color: #24344d !important;
        }
        /* QR scan gradients (indigo) → neutral blue-graphite */
        body.qr-page .scan-header,
        body.qr-page .gateway-header {
            background: linear-gradient(135deg, #24344d 0%, #3d557a 100%) !important;
            color: #fff !important;
        }
        /* Card-viewer pages (QrMyCard/QrWorkerCard) — replace dark navy page
           background with the ERP light theme; card canvas itself stays white */
        body.qr-page {
            background: #f4f6f9 !important;
        }
        body.qr-page .card-viewer,
        body.qr-page .card-flip-wrap,
        body.qr-page .viewer-wrap {
            background: #fff !important;
        }
        /* Status badges → muted, ERP-style */
        body.qr-page .badge-pending,
        body.qr-page .pill-muted,
        body.qr-page .tag-inactive,
        body.qr-page .badge-inactive {
            background: #fef3e2 !important;
            color: #a1581f !important;
        }
        body.qr-page .badge-approved,
        body.qr-page .pill-approved,
        body.qr-page .tag-active,
        body.qr-page .badge-active {
            background: #e8f5e9 !important;
            color: #2f7d43 !important;
        }
        body.qr-page .badge-rejected {
            background: #fdecea !important;
            color: #c0392b !important;
        }
        /* Flash messages → neutral */
        body.qr-page .flash-ok { background: #e8f5e9 !important; color: #2f7d43 !important; }
        body.qr-page .flash-err { background: #fdecea !important; color: #c0392b !important; }
    </style>

</head>
