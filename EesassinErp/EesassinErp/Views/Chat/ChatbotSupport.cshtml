
@{
    ViewBag.Title = "ChatbotSupport";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/scripts/RetailJsLib/ChatbotSupportController.js"></script>
<link href="~/Content/css/webwhatsapp/web-css.css" rel="stylesheet" /> 
<style>
    body {
        background: #f8f9fa;
        padding: 20px;
    }

    .tab-container {
        background: white;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0,0,0,0.1);
        padding: 20px;
    }

    .nav-tabs .nav-link {
        border: none;
        color: #6c757d;
    }

        .nav-tabs .nav-link.active {
            color: #007bff;
            font-weight: bold;
            border-bottom: 2px solid #007bff;
        }

    .tab-pane {
        margin-top: 20px;
    }

    iframe {
        border: none;
        border-radius: 8px;
    }
</style>
<div class="container-fluid">
    <div class="chat">
        <div class="chat-wrapper">
            <div class="row">
                <div class="col-md-4 stretch-card">
                    <div class="card w-100 left-card">
                        <div class="card-body p-2" ng-init="AllChatbotLoad();">
                            <div class="chatbox"  >
                                <select class="mb-3" ng-model="Controlbyuser" ng-change="AllChatbotLoad();">
                                    <option value="">Select</option>
                                    <option value="0">Pending</option>
                                    <option value="1">Complete</option>
                                </select>
                                <input class="mb-3 chatbox" ng-model="SearchCom" style="height: 37px; width: 65%;" ng-keyup="BindControl()" placeholder="Search TicketNo" />

                                <div class="chat-list-wrapper">
                                    <ul class="chat-list">
                                        <li class="new" ng-repeat="x in chatbotList | filter:{Status: Controlbyuser, TicketNo: SearchCom}" ng-click="SetValues(x.TicketNo)">
                                            <div class="body">
                                                <div class="header">
                                                    <span class="username">
                                                        {{x.UserName}}
                                                    </span>
                                                    <small class="timestamp text-muted">
                                                        <i class="fa fa-clock-o"></i>Last Update : {{x.createdon}}
                                                    </small>
                                                </div>
                                                <p>TicketNo : {{x.TicketNo}}</p>
                                                <p> Rate : {{x.Rate}}  </p>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-8 stretch-card">
                    <div class="card w-100 complete-card" ng-show="ComFreeze">
                        <div class="card-body p-2">
                            <div class="invoice-table w-100">

                                <div class="container-fluid tab-container">
                                    <!-- Tabs -->
                                    <ul class="nav nav-tabs" id="myTab" role="tablist">
                                        <li class="nav-item" ng-click="tabl1()">
                                            <a class="nav-link active" id="details-tab" data-toggle="tab" href="#tab1" role="tab">Details</a>
                                        </li>
                                        <li class="nav-item" ng-click="tabl2()">
                                            <a class="nav-link" id="preview-tab" data-toggle="tab" href="#tab2" role="tab">File Preview</a>
                                        </li>
                                    </ul>

                                    <!-- Tab Content -->
                                    <div class="tab-content" id="myTabContent">
                                        <div id="tab1" ng-show="isopentab1" role="tabpanel">
                                            <h5 class="mt-3">Summary : </h5>
                                            <p>{{Summary}}</p>
                                            <h5 class="mt-3">Suggestion : </h5>
                                            <p>{{Suggestion}}</p>
                                            <label>Add Comment</label>
                                            <input type="text" class="form-control mb-3" placeholder="Type your comment here..." ng-model="approvalComment">
                                            <button class="btn btn-primary" ng-click="Approve()">Approve</button>
                                        </div>

                                        <div id="tab2" ng-show="isopentab2" role="tabpanel">
                                            <h5 class="mt-3">Document Preview</h5>
                                            <iframe ng-src="{{FileUpload}}" width="100%" height="600px"></iframe>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>




            </div>
        </div>
    </div>
</div>
 
 