@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Post New Job";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/scripts/RetailJsLib/RozgarController.js"></script>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script src="~/Content/Dashboards/Rozgar/PostNewJob/script.js"></script>
<link href="~/Content/Dashboards/Rozgar/PostNewJob/style.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="postNewJobPage px-4 py-4">

    <div class="postNewJobContainer">

        <!-- PAGE TITLE -->
        <div class="pageHeader">
            <h1>Post a New Job</h1>
        </div>

        <div class="jobWizardLayout">

            <!-- LEFT -->
            <div class="wizardMain">

                <!-- STEPPER -->
                <div class="wizardCard wizardStepper">

                    <div class="stepItem active" data-step="1">
                        <div class="stepCircle">1</div>
                        <span>Basic Info</span>
                    </div>

                    <div class="stepLine"></div>

                    <div class="stepItem" data-step="2">
                        <div class="stepCircle">2</div>
                        <span>Description</span>
                    </div>

                    <div class="stepLine"></div>

                    <div class="stepItem" data-step="3">
                        <div class="stepCircle">3</div>
                        <span>Review</span>
                    </div>

                </div>

                <div class="wizardStep wizardCard activeStep" id="step1">

                    <div class="sectionHeader">

                        <h2>Step 1: Basic Information</h2>

                        <p>
                            Provide the fundamental details about the role
                            you are hiring for.
                        </p>

                    </div>

                    <div class="formCard">

                        <div class="formGroup">
                            <label>Job Title</label>
                            <input type="text"
                                   placeholder="e.g. Senior Product Designern" class="form-control form-control-sm validate" ng-model="JobTitle">
                        </div>

                        <div class="formGroup">
                            <label>Job Category</label>

                            <select ng-model="JobCategory" class="form-control form-control-sm validate">
                                <option value="">Select Category</option>
                                <option value="IT & Software">IT & Software</option>
                                <option value="Sales">Sales</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Finance">Finance</option>
                                <option value="Operations">Operations</option>
                                <option value="HR">HR</option>
                            </select>
                        </div>

                        <div class="formGroup">

                            <label>Workplace Type</label>
                            <select ng-model="worktype" class="form-control form-control-sm validate">
                                <option value="">Select Workplace Type</option>
                                <option value="On-site">On-site</option>
                                <option value="Remote">Remote</option>
                                <option value="Hybrid">Hybrid</option>
                            </select>
                            @*<div class="workplaceGrid" ng-model="worktype">
                                    <div class="workplaceCard active" data-workplace="On-site">
                                        <i class="fa-solid fa-building"></i>
                                        <h4>On-site</h4>
                                        <span>Work from office</span>
                                    </div>
                                    <div class="workplaceCard" data-workplace="Remote">
                                        <i class="fa-solid fa-globe"></i>
                                        <h4>Remote</h4>
                                        <span>Work from anywhere</span>
                                    </div>

                                    <div class="workplaceCard" data-workplace="Hybrid">
                                        <i class="fa-solid fa-city"></i>
                                        <h4>Hybrid</h4>
                                        <span>Flexible office & home</span>
                                    </div>

                                </div>*@

                        </div>

                        <div class="formGroup">
                            <label>Location</label>

                            <div class="inputIconWrap">

                                <i class="fa-solid fa-location-dot"></i>

                                <input type="text" class="form-control form-control-sm validate"
                                       placeholder="Enter Location" ng-model="Location">

                            </div>
                        </div>
                        <div class="formGroup" ng-init="AllCity()">
                            <label class="form-label">State </label>
                            <select class="form-select form-select-sm validate"
                                    ng-model="State">
                                <option value="">Select State</option>
                                <option ng-repeat="x in AllCityList | unique:'STATE_NAME'"
                                        value="{{x.STATE_NAME}}">
                                    {{x.STATE_NAME}}
                                </option>
                            </select>
                        </div>
                        <div class="formGroup">
                            <label class="form-label">City </label>
                            <select class="form-select form-select-sm validate"
                                    ng-model="City">
                                <option value="">Select City</option>
                                <option ng-repeat="x in AllCityList | filter:{STATE_NAME: State}"
                                        value="{{x.CITY_NAME}}">
                                    {{x.CITY_NAME}}
                                </option>
                            </select>
                        </div>

                        <div class="formFooter">

                            <button class="btnSecondary">
                                Cancel
                            </button>

                            <button class="btnPrimary nextBtn"
                                    data-next="2">
                                Save & Next
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>

                        </div>

                    </div>

                </div>

                <!-- ========================= -->
                <!-- STEP 2 -->
                <!-- ========================= -->

                <div class="wizardStep wizardCard" id="step2">

                    <div class="sectionHeader">

                        <h2>Step 2: Job Specification</h2>

                        <p>
                            Outline the core responsibilities and technical
                            requirements for this role.
                        </p>

                    </div>

                    <div class=" formCard">

                        <div class="formGroup">

                            <label>Description</label>

                            @*<div id="jobDescriptionEditor" ng-model="Description"></div>*@
                            <textarea ng-model="Description" class="form-control"></textarea>

                            <small>
                                Minimum 200 characters. Keep it professional and engaging.
                            </small>

                        </div>

                        <div class="formGroup">
                            <label>Required Skills</label>

                            <div class="skillInputWrapper">
                                <input type="text" placeholder="Add a skill..." ng-model="RequiredSkills">
                            </div>

                        </div>
                        <div class="formGroup">
                            <label>Experience</label>
                            <div class="skillInputWrapper">
                                <input type="text" placeholder="Experience" ng-model="Experience">
                            </div>

                        </div>

                        <div class="formGroup">

                            <label>Annual Salary Range (INR)</label>

                            <div class="salaryGrid">

                                <input type="number"
                                       id="salaryMin"
                                       placeholder="₹ Minimum" ng-model="MinSallery">

                                <input type="number"
                                       id="salaryMax"
                                       placeholder="₹ Maximum" ng-model="MaxSallery">

                            </div>

                        </div>

                        <div class="checkboxWrap">

                            <input type="checkbox"
                                   id="showSalary">

                            <label for="showSalary">
                                Show salary range on public posting
                            </label>

                        </div>

                        <div class="formFooter">

                            <button class="btnSecondary prevBtn"
                                    data-prev="1">

                                <i class="fa-solid fa-arrow-left"></i>
                                Back

                            </button>

                            <div class="footerActions">

                                <button class="btnGhost" ng-click="SaveasDraft()" hidden>
                                    Save Draft
                                </button>

                                <button class="btnPrimary nextBtn" data-next="3" ng-click="SavejobPost()">
                                    Save & Next
                                    <i class="fa-solid fa-arrow-right"></i>
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ========================= -->
                <!-- STEP 3 -->
                <!-- ========================= -->

                <div class="wizardStep wizardCard" id="step3">

                    <div class=" sectionHeader">

                        <h2>Step 3: Final Review</h2>

                        <p>
                            Review your job posting before publishing.
                        </p>

                    </div>

                    <div class=" reviewCard">

                        <div class="jobPreviewHeader">

                            <div>

                                <span class="previewLabel">
                                    JOB TITLE
                                </span>

                                <h2 id="previewTitle">
                                    {{Rozgarddetail.JobTitle}}
                                </h2>

                            </div>

                            <span class="draftBadge">
                                Draft
                            </span>

                        </div>

                        <div class="previewMeta">

                            <span><i class="fa-solid fa-location-dot" style="font-size:13px;"></i> &nbsp;{{Rozgarddetail.Location}}</span>

                            <span><i class="fa-solid fa-indian-rupee-sign" style="font-size:13.65px;"></i>&nbsp;{{Rozgarddetail.MinSallery}} - <i class="fa-solid fa-indian-rupee-sign" style="font-size:13.65px;"></i>&nbsp;{{Rozgarddetail.MaxSallery}}</span>
                        </div>

                        <hr>
                        <div class="previewMeta">
                            <span>State : {{Rozgarddetail.State}}</span>
                            <span>City : {{Rozgarddetail.City}}</span>
                            <span>Experience : {{Rozgarddetail.Experience}}</span>
                        </div>
                        <hr />
                        <div>
                            <span class="previewLabel">
                                DESCRIPTION
                            </span>
                            <div>{{Rozgarddetail.Description}}</div>
                        </div>

                        <div class="formFooter reviewFooter">

                            <button class="btnSecondary prevBtn"
                                    data-prev="2">

                                <i class="fa-solid fa-arrow-left"></i>
                                Back

                            </button>

                            <div class="footerActions">

                                <button class="btnGhost" hidden>
                                    Save Draft
                                </button>

                                <button class="btnPrimary" ng-click="redirecturl()">
                                    Save
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- SIDEBAR -->

            <div class="wizardSidebar">

                <!-- STEP 1 SIDEBAR -->

                <div class="sidebarCard sidebarStep activeSidebar"
                     id="sidebar1">

                    <h3>Tips for success</h3>

                    <ul>

                        <li>
                            Clear job titles receive up to 30% more applications.
                        </li>

                        <li>
                            Specifying Remote or Hybrid helps attract talent.
                        </li>

                    </ul>

                </div>

                <!-- STEP 2 SIDEBAR -->

                <div class="sidebarCard sidebarStep"
                     id="sidebar2">

                    <h3>Description Tips</h3>

                    <ul>

                        <li>Use bullet points.</li>

                        <li>Describe responsibilities clearly.</li>

                        <li>Highlight growth opportunities.</li>

                    </ul>

                </div>

                <!-- STEP 3 SIDEBAR -->

                <div class="sidebarStep"
                     id="sidebar3">

                    <div class="sidebarCard">

                        <h3>Required Skills</h3>

                        <div id="reviewSkills">{{Rozgarddetail.RequiredSkills}}</div>

                    </div>

                    <div class="sidebarCard">
                        <h3>Posting Settings</h3>
                        <div class="reviewSetting">
                            <span>Visibility</span>
                            <strong>Public</strong>
                        </div>
                        <div class="reviewSetting">
                            <span>Duration</span>
                            <strong>30 Days</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>