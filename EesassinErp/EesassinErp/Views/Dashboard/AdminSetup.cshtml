                                    <td>National & Festival Holidays Registration: Tamil Nadu Industrial Establishments </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button class="btn btn-sm save-btn">
                            Save
                        </button>
                    </div>

                </div>

            </div>

        </div>

        <!-- CARD 6 : Activity Report -->
        <div id="activityReport" class="card section-card d-none">
            <div class="card-body p-3 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="admin-dd">
                            <label class="admin-dd-label">Activity Date</label>
                            <input type="date"
                                   class="form-control admin-dd-select"
                                   placeholder="Select date">
                        </div>
                    </div>

                    <!-- RIGHT : Search + Export -->
                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-md-end">

                        <!-- Search -->
                        <div class="search-container">
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       class="form-control form-control-sm"
                                       placeholder="Search..." />
                                <button class="btn btn-sm btn-outline-primary" type="button">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Export -->
                        <button type="button" class="btn btn-sm export-btn">
                            <i class="bi bi-download me-1"></i> Export
                        </button>

                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="activityReportTable">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>User Name</th>
