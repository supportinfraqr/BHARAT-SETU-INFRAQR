                                    <td>172.31.33.46</td>
                                    <td>19.076-72.8777</td>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button class="btn btn-sm save-btn">
                            Save
                        </button>
                    </div>

                </div>

            </div>
        </div>
    </div>
