

@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


@*<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>*@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script src="~/Scripts/RetailJsLib/ReportDashbaord.js"></script>




<div class="report-header d-flex justify-content-between align-items-center px-4 py-2 text-white">
    <button class="btn btn-light btn-sm fw-semibold" ng-click="DownloadPDF('LitigationCommonCompliance')">
        <i class="bi bi-download me-1"></i> Download Report
    </button>
    <h6 class="mb-0">{{ReportPeriod}}</h6>
</div>
<!-- REPORT PAGE 10: Litigation Report-->
<div id="divprint" class="container-report10 py-4" ng-cloak>


    <!-- BODY -->
    <div class="report-body10 p-4">

        <!-- TITLE -->
        <div class="report-title-box text-center py-2 px-2 mb-3">
            <h5 class="fw-semibold mb-0">
                Litigation Report
            </h5>
        </div>

        <!-- DESCRIPTION -->
        <p class="text-muted text-center mb-4" style="font-size:14px;" ng-init="BindLitigation()">
            This section provides a consolidated overview of all compliances, highlighting the organization’s completion ratio,
            pending obligations, and compliance health for the selected period.
        </p>

        <!-- SMALL CARDS -->
        <div class="row g-3 mb-4 justify-content-center text-center">
            <div class="col-md-2 col-6">
                <div class="card small-card bg-success text-white py-3">
                    <h6>Total Cases</h6>
                    <h5>{{TotalCases}}</h5>
                </div>
            </div>
            <div class="col-md-2 col-6">
                <div class="card small-card bg-danger text-white py-3">
                    <h6>Total Pleading</h6>
                    <h5>{{PleadingsTotal}}</h5>
                </div>
            </div>
            <div class="col-md-2 col-6">
                <div class="card small-card bg-warning text-dark py-3">
                    <h6>Open Cases</h6>
                    <h5>{{StageOneTotal}}</h5>
                </div>
            </div>
            <div class="col-md-2 col-6">
                <div class="card small-card bg-orange text-white py-3" style="background-color:#E45D27;">
                    <h6>Order & Judgements</h6>
                    <h5>{{OrdersTotal}}</h5>
                </div>
            </div>
            <div class="col-md-2 col-6">
                <div class="card small-card bg-danger text-white py-3">
                    <h6>Total Hearing</h6>
                    <h5>{{HearingsTotal}}</h5>
                </div>
            </div>
            <div class="col-md-2 col-6">
                <div class="card small-card bg-success text-white py-3">
                    <h6>Cases Close</h6>
                    <h5>{{Appeal}}</h5>
                </div>
            </div>

        </div>


        <!-- TABLE  -->
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center" ng-init="BindLitigationManagement()">
                <thead>
                    <tr>
                        <th>Case Title</th>
                        <th>Case No</th>
                        <th>Opposition Party</th>
                        <th>Judgment Passed</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in litigationList">
                        <td>
                            {{x.CaseTitle}}
                        </td>
                        <td>
                            {{x.CaseNo}}
                        </td>
                        <td>
                            {{x.OppositionParty}}
                        </td>
                        <td>
                            {{x.JudgmentPassed}}
                        </td>
                    </tr>


                </tbody>
            </table>
        </div>


        <h6 class="mb-2 mt-6 fw-semibold text-center" style="color: #E45D27">Litigation Impact</h6>

        <!-- GRAPH -->
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body" style="height: 400px;">
                <canvas id="litigationChart"></canvas>
            </div>
        </div>


    </div>


    <!-- ===== Footer ===== -->
    @*<div class="report-footer d-flex justify-content-between align-items-center px-4 py-2 mt-4 border-top">
        <span class="small fw-semibold">Prepared By: EZ Compliance</span>
        <span class="small fw-semibold">Generated for: {{MapUser}}</span>
    </div>*@
</div>

<link href="~/ReportsDashboard/CommonReport/style.css" rel="stylesheet" />
<script src="~/ReportsDashboard/CommonReport/script.js"></script> 