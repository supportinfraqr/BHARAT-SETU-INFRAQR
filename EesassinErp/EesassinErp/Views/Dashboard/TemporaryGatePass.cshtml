@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Temporary Gate Pass";
    Layout = "~/Views/Common/Withoutlayout.cshtml";
}


<style>
    .temporaryGatePass {
        font-family: "Inter", sans-serif;
        background: #fff;
        color: #222;
        display: flex;
        justify-content: center;
        padding: 30px 0;
    }

        /*==============================
        A4 PAGE
    ==============================*/
        .temporaryGatePass .gatepass-page {
            width: 210mm;
            min-height: 297mm;
            background: #fff;
            padding: 18mm 15mm 16mm;
            margin: auto;
            box-sizing: border-box;
            box-shadow: 0 8px 35px rgba(0, 0, 0, .12);
            border-radius: 6px;
        }

    @@page {
        size: A4;
        margin: 0;
    }

    @@media print {
        body {
            margin: 0;
            background: #fff;
        }

        .temporaryGatePass {
            padding: 0;
        }

            .temporaryGatePass .gatepass-page {
                width: 210mm;
                min-height: 297mm;
                margin: 0;
                padding: 18mm 15mm 16mm;
                box-shadow: none;
            }
    }

    /*==============================
        HEADER
    ==============================*/

    .temporaryGatePass .page-title {
        text-align: center;
        color: #022B5E;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .temporaryGatePass .title-divider {
        border-top: 2px solid #39465d;
        margin-bottom: 28px;
    }

    /*==============================
        COMMON
    ==============================*/

    .temporaryGatePass p {
        margin: 0;
        line-height: 1.7;
        font-size: 15px;
    }

    .temporaryGatePass .bold {
        font-weight: 700;
    }

    .temporaryGatePass .italic {
        font-style: italic;
    }

    .temporaryGatePass .mt-10 {
        margin-top: 10px;
    }

    .temporaryGatePass .mt-18 {
        margin-top: 18px;
    }

    .temporaryGatePass .mt-25 {
        margin-top: 25px;
    }

    .temporaryGatePass .mt-35 {
        margin-top: 35px;
    }

    .temporaryGatePass .underline {
        display: inline-block;
        border-bottom: 1px solid #333;
        min-width: 130px;
        text-align: center;
        font-style: italic;
        padding: 0 6px 2px;
        line-height: 1.2;
    }

    .temporaryGatePass .underline-sm {
        min-width: 45px;
    }

    .temporaryGatePass .underline-md {
        min-width: 95px;
    }

    .temporaryGatePass .underline-lg {
        min-width: 210px;
    }

    .temporaryGatePass .underline-xl {
        min-width: 430px;
    }

    /*==============================
        TO SECTION
    ==============================*/

    .temporaryGatePass .to-section p {
        font-size: 15px;
        font-weight: 600;
        line-height: 1.65;
    }

    /*==============================
        SUBJECT & REF
    ==============================*/

    .temporaryGatePass .subject-row,
    .temporaryGatePass .reference-row {
        display: flex;
        align-items: flex-end;
        flex-wrap: wrap;
        font-size: 15px;
    }

        .temporaryGatePass .subject-row .label,
        .temporaryGatePass .reference-row .label {
            font-weight: 700;
            white-space: nowrap;
            margin-right: 8px;
        }

        .temporaryGatePass .reference-row .value {
            flex: 1;
        }

    /*==============================
        LETTER BODY
    ==============================*/

    .temporaryGatePass .letter-body {
        margin-top: 30px;
    }

        .temporaryGatePass .letter-body p {
            font-size: 15px;
            text-align: justify;
        }

    .temporaryGatePass .inline-date {
        display: inline-block;
        min-width: 110px;
        border-bottom: 1px solid #333;
        text-align: center;
        font-weight: 700;
        padding-bottom: 2px;
    }

    .temporaryGatePass .inline-days {
        display: inline-block;
        min-width: 30px;
        border-bottom: 1px solid #333;
        text-align: center;
        font-weight: 700;
    }

    /*==============================
        TABLE
    ==============================*/

    .temporaryGatePass .worker-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 18px;
    }

        .temporaryGatePass .worker-table th,
        .temporaryGatePass .worker-table td {
            border: 1px solid #222;
            padding: 7px 8px;
            font-size: 14px;
            vertical-align: middle;
        }

        .temporaryGatePass .worker-table th {
            text-align: center;
            font-weight: 700;
        }

        .temporaryGatePass .worker-table td {
            height: 34px;
        }

            .temporaryGatePass .worker-table td:first-child,
            .temporaryGatePass .worker-table td:nth-child(3) {
                text-align: center;
            }

/*==================================
    PLACE & DATE
==================================*/

.temporaryGatePass .place-date-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 42px;
    font-size: 15px;
    font-weight: 500;
}

/*==================================
    SIGNATURES
==================================*/

.temporaryGatePass .signature-wrapper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 42px;
    row-gap: 65px;
    margin-top: 58px;
}

.temporaryGatePass .signature-box {
    text-align: center;
}

.temporaryGatePass .signature-line {
    border-top: 1px solid #333;
    width: 100%;
    margin-bottom: 8px;
}

.temporaryGatePass .signature-title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
}

.temporaryGatePass .signature-note {
    margin-top: 4px;
    font-size: 11px;
    color: #6b7280;
    line-height: 1.4;
}

@@media print {

    .temporaryGatePass .signature-wrapper {
        page-break-inside: avoid;
    }

}

</style>

<div class="temporaryGatePass">

    <div class="gatepass-page">

        <!--==========================
            HEADER
        ===========================-->

        <div class="page-title">
            TEMPORARY GATE PASS
        </div>

        <div class="title-divider"></div>

        <!--==========================
            TO
        ===========================-->

        <div class="to-section">

            <p>To,</p>

            <p>Chief Security Officer</p>

            <p>SIOM</p>

        </div>

        <!--==========================
            SUBJECT
        ===========================-->

        <div class="subject-row mt-25">

            <div class="label">
                Sub: -
            </div>

            <div class="value bold">
                Issue of temporary workers Pass.
            </div>

        </div>

        <!--==========================
            REFERENCE
        ===========================-->

        <div class="reference-row mt-18">

            <div class="label">
                Ref.: -
            </div>

            <div class="value">

                <span class="bold">Contractor Name/ Order No.</span>

                <span class="underline underline-xl">
                    @* Contractor Name / PO Number *@
                    Auto Lube Solution / PO-SIOM-88712
                </span>

            </div>

        </div>

        <!--==========================
            LETTER
        ===========================-->

        <div class="letter-body">

            <p>Sir,</p>

            <p class="mt-18">

                Please permit the following worker whose address and signatures are
                shown against each to carry out work in

                <span class="underline underline-md">
                    Maintenance
                </span>

                area of the

                <span class="underline underline-md">
                    Mechanical
                </span>

                plant from date

                <span class="inline-date">
                    30/03/2026
                </span>

                &nbsp; To &nbsp;

                <span class="inline-date">
                    04/04/2026
                </span>

                (

                <span class="inline-days">
                    6
                </span>

                No. of days).

            </p>

            <!-- Worker table starts here -->
            <table class="worker-table">

                <thead>

                    <tr>

                        <th style="width:9%;">Sl. No.</th>

                        <th style="width:33%;">Name</th>

                        <th style="width:11%;">Age</th>

                        <th>Address</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>1.</td>

                        <td>Vikas Mahadeo Jungbare</td>

                        <td>51</td>

                        <td>Auto Lube Solution, Chandrapur</td>

                    </tr>

                </tbody>

            </table>

            <p class="mt-25">

                I hereby declare that I personally known to the above personnel to the
                best of my knowledge and in case of any eventuality, I will be held
                responsible for the same.

            </p>

            <!--==========================
                PLACE & DATE
            ==========================-->

            <div class="place-date-row">

                <div>
                    <span class="bold">Place :</span> SIOM
                </div>

                <div>
                    <span class="bold">Date :</span> 29/03/2026
                </div>

            </div>

            <!--==========================
                SIGNATURES
            ==========================-->

            <div class="signature-wrapper">

                <div class="signature-box">

                    <div class="signature-line"></div>

                    <div class="signature-title">
                        Sign of HOD
                    </div>

                    <div class="signature-note">
                        (Mention Name &amp; designation with seal)
                    </div>

                </div>

                <div class="signature-box">

                    <div class="signature-line"></div>

                    <div class="signature-title">
                        Sign of Contractor
                    </div>

                    <div class="signature-note">
                        Mention Name &amp; seal
                    </div>

                </div>

                <div class="signature-box">

                    <div class="signature-line"></div>

                    <div class="signature-title">
                        Sign of HR HEAD
                    </div>

                    <div class="signature-note">
                        (Mention Name &amp; Designation with seal)
                    </div>

                </div>

                <div class="signature-box">

                    <div class="signature-line"></div>

                    <div class="signature-title">
                        Sign of CSO
                    </div>

                    <div class="signature-note">
                        (Mention Name &amp; Designation with seal)
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
