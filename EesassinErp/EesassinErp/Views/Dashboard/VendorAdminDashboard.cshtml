                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Required -->
                    <div class="flex-fill d-flex flex-column min-height-0 vendor-c4-action">
                        <h6 class="fw-medium text-orange mb-2">Report Action Required</h6>

                        <div class="flex-grow-1 overflow-auto rounded-3">
                            <table class="table table-sm mb-0 text-center align-middle vendor-c4-table">
                                <thead>
                                    <tr>
                                        <th>Document</th>
                                        <th>Month/Year</th>
                                        <th>View</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <tr>
                                        <td>Document1</td>
                                        <td>Oct 2025</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Compliance Certificate</td>
                                        <td>Sep 2025</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Invoice</td>
                                        <td>Jan 2026</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>InvoiceDemo</td>
                                        <td>Dec 2025</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Invoice2</td>
                                        <td>Nov 2025</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Agreement Document</td>
                                        <td>Oct 2025</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Compliance Certificate</td>
                                        <td>Sep 2025</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Agreement Document</td>
                                        <td>Oct 2025</td>
                                        <td class="action-menu">
                                            <button class="btn btn-sm view-btn" title="View">
