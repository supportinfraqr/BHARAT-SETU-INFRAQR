<script>
    $(document).ready(function () {
        $('#LicenseDocument').on('shown.bs.modal', function () {
            $('.license-select').select2({
                dropdownParent: $('#LicenseDocument'),
                placeholder: "Select License",
                width: '100%'
            });
        });
    });
</script>
