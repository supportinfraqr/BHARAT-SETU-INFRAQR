
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Board";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
@*<script src="~/scripts/myjslib/myJs.js"></script>*@

<link href="~/Content/AdminSetup/Dashboard/style.css" rel="stylesheet" />
<script src="~/Content/AdminSetup/Dashboard/script.js"></script>

<link href="~/Masters/LocationMaster/style.css" rel="stylesheet" />

<script src="~/scripts/RetailJsLib/AdminDashboardcontroller.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
    .license-scroll {
        width: 350px;
        height: 150px;
        overflow-y: auto;
    }
    .location-btn {
        height: 32px; /* yahan adjust kar sakte ho */
        padding: 4px 10px;
        line-height: 22px;
    }

    .lm-multiselect .dropdown-menu {
        max-height: 160px; /* 200 se kam */
        overflow-y: auto;
    }

    .lm-multiselect .dropdown-item {
        padding: 4px 8px; /* pehle zyada hota hai */
        font-size: 13px;
    }

    .lm-multiselect input[type="checkbox"] {
        margin-top: 2px;
    }

    .lm-multiselect .border-bottom {
        padding: 4px 8px !important;
    }
</style>

<div class="adminSetup px-4 py-2">
    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="Overview, Users, Permissions, Store Mapping or Industry Mapping">
            <button type="button"
                    class="btn btn-pill active"
                    onclick="window.location.href='../Dashboard/Board'">
                Overview
            </button>
            <button type="button" class="btn btn-pill" data-target="#users" ng-click="ManageLog('Users')" aria-pressed="false">Users</button>
            <button type="button" class="btn btn-pill" data-target="#permissions" ng-click="ManageLog('Permissions');GetPagesSectionMasterList()" aria-pressed="false">Permissions</button>
            <button type="button" class="btn btn-pill" data-target="#storeMapping" ng-click="ManageLog('Location Management');AllUserListsLoad();GetPagesSectionMasterList()" aria-pressed="false">Location Management</button>
            <button type="button" class="btn btn-pill" data-target="#industryMapping" ng-click="AllIndustry();ManageLog('License Management');" aria-pressed="false">License Management</button>
            <button type="button" class="btn btn-pill" data-target="#activityReport" ng-click="ManageLog('Log Report');BindActivity()" aria-pressed="false">Log Report</button>
            <button type="button" class="btn btn-pill" data-target="#complianceDocCard" ng-click="ManageLog('Location Doc');BindComDoc()" aria-pressed="false">Location Doc</button>
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap" ng-init="BindMenuForDash();UserList();Limit();AllIndustry(); ">

        <!-- CARD 1 : Overview (default visible) -->
        <div id="overview" class="card section-card active adminOverview">
            <div class="card-body">

                <!-- TOP SUMMARY  -->
                <div class="adminOverview-header">

                    <!-- Left : Org Info -->
                    <div class="adminOverview-org">
                        <!--<div class="adminOverview-logo">-->
                        @*<img src="~/AdminSetup/Dashboard/theobroma-logo.png" alt="Organization Logo">*@
                        <!--</div>-->

                        <div class="adminOverview-orgInfo">
                            <h4>{{MapUser}}</h4>
                            @*<a href="https://www.ezcompliance.in" target="_blank">
                                www.ezcompliance.in
                            </a>*@
                        </div>
                    </div> 

                    <!-- Right : Meta Info -->
                    <div class="adminOverview-meta">
                        <div class="meta-item">
                            <label>Email Address</label>
                            <span>{{PartyEMail}}</span>
                        </div>

                        <div class="meta-item">
                            <label>Subscription Duration</label>
                            <span>{{Duration}}</span>
                        </div>

                        <div class="meta-item">
                            <label>Plan</label>
                            <span>{{PartyPlan}}</span>
                        </div>

                        <div class="meta-item">
                            <label>Renewal Date</label>
                            <span>{{ValidTo}}</span>
                        </div>
                    </div>

                    <!-- Edit Icon -->
                    <!--<button class="adminOverview-edit" title="Edit Organization">
                    <i class="bi bi-pencil"></i>
                </button>-->
                </div>

                <!-- KPI CARDS  -->
                <div class="adminOverview-kpis">

                    <div class="kpiCard">
                        <i class="bi bi-credit-card-2-front"></i>
                        <div>
                            <h6>Total Location</h6>
                            <span>{{StoreLimit ? StoreLimit : 0}}</span>
                        </div>
                    </div>

                    <div class="kpiCard">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <div>
                            <h6>Module Subscribed</h6>
                            <span>{{ DashMenu  ? DashMenu: 0 }}</span>
                        </div>
                    </div>

                    <div class="kpiCard">
                        <i class="bi bi-people"></i>
                        <div>
                            <h6>Organization Users</h6>
                            <span>{{(Useroccupied || 0) }}</span>
                        </div>
                    </div>

                    <div class="kpiCard">
                        <i class="bi bi-diagram-3"></i>
                        <div>
                            <h6>Organization User Limit</h6>
                            <span>{{UserLimit|| 0 }}</span>
                        </div>
                    </div>



                </div>

            </div>

            <!--USER ANALYTICS-->
            <div class=" adminUserAnalytics mt-4">

                <div class="row g-3 align-items-stretch">
                    <!-- LEFT : User Activity Trend -->
                    <div class="col-lg-8">
                        <div class="card section-card h-100" ng-init="BindUserActivity()">
                            <div class="card-body">

                                <div class="analytics-header">
                                    <h5 class="card-head">User Activity Trend</h5>

                                    <!--<div class="analytics-actions">
                                <select class="form-select form-select-sm">
                                    <option>Last 7 days</option>
                                    <option>Last 30 days</option>
                                    <option>Last 90 days</option>
                                </select>-->
                                    @*<a href="javascript:void(0)">View all reports</a>*@
                                    <!--</div>-->
                                </div>

                                <div class="chartWrap">
                                    <canvas id="userActivityChart"></canvas>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- RIGHT : User Status Summary -->
                    <div class="col-lg-4">
                        <div class="card section-card h-100">
                            <div class="card-body">

                                <h5 class="mb-3 card-head" style="color: var(--primary)">User Status Summary</h5>

                                <div class="donutWrap">
                                    <canvas id="userStatusChart"></canvas>
                                    <div class="donutCenter">
                                        <span>Total</span>
                                        <strong>
                                            {{activeCount}}
                                        </strong>
                                    </div>
                                </div>

                                <div class="userStats">
                                    <div>
                                        <span class="dot active"></span>
                                        <strong>
                                            {{activeCount}}
                                        </strong>
                                        <small>Used users</small>
                                    </div>

                                    <div>
                                        <span class="dot inactive"></span>
                                        <strong>{{ (UserLimit || 0) - (activeCount || 0) }}</strong>
                                        <small>Unused users</small>
                                    </div>

                                    <div>
                                        <span class="dot total"></span>
                                        <strong>{{UserLimit|| 0 }}</strong>
                                        <small>Total users</small>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!--  STORAGE & MODULES  -->
            <div class=" adminStorageModules mt-4" style="display:none">

                <div class="row g-3 align-items-stretch">

                    <!-- LEFT : User Storage Usage -->
                    <div class="col-lg-8">
                        <div class="card section-card h-100">
                            <div class="card-body">

                                <div class="analytics-header">
                                    <h5 class="card-head">User Storage Usage</h5>

                                    @*<a href="javascript:void(0)">View detailed report</a>*@
                                </div>

                                <div class="storageChartWrap">
                                    <canvas id="userStorageChart"></canvas>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- RIGHT : Recommended Modules -->
                    <div class="col-lg-4">
                        <div class="card section-card h-100">
                            <div class="card-body">

                                <h5 class="mb-3 card-head">Recommended Modules</h5>

                                <div class="moduleList">

                                    <div class="moduleItem" ng-repeat="x in DashMenu">
                                        <h6> {{x.SectionName}}</h6>
                                        <p>Assigned On: {{x.CreatedOn}}  </p>
                                    </div>

                                    <div class="moduleItem">
                                        <h6>Compliance Module</h6>
                                        <p>Manage statutory compliances, due dates, and renewals.</p>
                                    </div>

                                    <div class="moduleItem">
                                        <h6>Notice Module</h6>
                                        <p>Track, assign, and respond to legal and regulatory notices.</p>
                                    </div>

                                    <div class="moduleItem">
                                        <h6>Litigation Module</h6>
                                        <p>Monitor court cases, hearings, and case-related documents.</p>
                                    </div>

                                    <!-- more items can exist, scroll will activate -->

                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>


        </div>

        <!-- CARD 2 : Users -->
        <div id="users" class="card section-card d-none">
            <div class="container my-3">
                <div class="row g-3 justify-content-center">
                    <!-- Total User -->
                    <div class="col-md-3">
                        <div class="kpi-card d-flex">
                            <div class="kpi-title">User Limit</div>
                            <div class="kpi-value" id="kpiTotalStore">{{ (UserLimit|| 0) }}</div>
                        </div>
                    </div>
                    <!-- Used -->
                    <div class="col-md-3">
                        <div class="kpi-card d-flex">
                            <div class="kpi-title">User Created</div>
                            <div class="kpi-value" id="kpiUsed">{{(Useroccupied || 0) }}</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="kpi-card d-flex">
                            <div class="kpi-title">User Left</div>
                            <div class="kpi-value" id="kpiPending"> {{ (UserLimit || 0) - (Useroccupied || 0) }}</div>
                        </div>
                    </div>

                    <!-- Delayed -->
                    @*<div class="col-md-3">
                        <div class="kpi-card d-flex">
                            <div class="kpi-title">Delayed</div>
                            <div class="kpi-value" id="kpiDelayed">25</div>
                        </div>
                    </div>*@

                </div>
            </div>
            <div class="card userProfile-user-card p-3">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                    <div>
                        <h5 class="mb-1">User Management</h5>
                        <small class="text-muted">Manage users and their access permissions</small>
                    </div>
                    <button class="btn btn-sm add-user-btn" data-bs-toggle="modal" data-bs-target="#addUserModal" ng-click="OpenAddUserModal()">
                        <i class="bi bi-plus-lg me-1"></i> Add User
                    </button>
                </div>

                <div class="table-responsive userProfile-user-table-container rounded-3">

                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Last Login</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr ng-repeat="x in EmployeeList">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar">U</div>
                                        <div>
                                            <strong>{{x.UserName}}</strong><br>
                                            <small class="text-muted">{{x.EmailId}}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge role-admin">
                                        {{ x.LoginType == 5 ? 'Admin' : 'User' }}
                                    </span>
                                </td>
                                <td ng-show="1">
                                    <span class="badge status-active">
                                        {{ x.IsActive  == 1 ? 'Active' : 'InActive' }}
                                    </span>
                                </td>

                                <td>
                                    {{ x.LastLogin | date:'dd-MM-yyyy hh:mm a' }}
                                </td>

                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>

        </div>
        <!-- ADD USER MODAL INSIDE USERS section-->
        <div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content admin-user-modal">
                    <div class="modal-header">
                        <h6 class="modal-title">Add User</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">

                            <!-- Name -->
                            <div class="col-md-6">
                                <label class="form-label">Name</label>
                                <input type="text" class="form-control validate" ng-model="UName">
                            </div>

                            <!-- Username -->
                            <div class="col-md-6">
                                <label class="form-label">User Name</label>
                                <input type="text"
                                       class="form-control"
                                       ng-model="UserNames"
                                       oninput="this.value = this.value.replace(/[^A-Za-z]/g,'')">
                            </div>

                            <!-- Password -->
                            <div class="col-md-6">
                                <label class="form-label">Password</label>
                                <input type="password"
                                       class="form-control"
                                       ng-model="Password"
                                       oninput="this.value = this.value.replace(/\s/g,'')">
                            </div>

                            <!-- Contact -->
                            <div class="col-md-6">
                                <label class="form-label">Contact No</label>
                                <input type="text" class="form-control validate" ng-model="ContactNumber" maxlength="10">
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label class="form-label">Email Id</label>
                                <input id="txtEmail" ng-model="EmailId" class="form-control validate">
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer justify-content-end">
                        <button class="btn btn-sm save-user-btn" ng-click="SaveUser()">
                            Save
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- CARD 3 : Permissions -->
        <div id="permissions" class="card section-card d-none">
            <div class="card-body p-3 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        @*<div class="admin-dd">
                            <label class="admin-dd-label">Party</label>
                            <select class="form-select admin-dd-select">
                                <option selected disabled>Select Party</option>
                                <option>Test Admin</option>
                            </select>
                        </div>*@

                        <div class="admin-dd">
                            <label class="admin-dd-label">User List</label>
                            <select class="form-select admin-dd-select" ng-change="GetPagesSectionMasterList()" ng-model="UserId">
                                <option value="">Select</option>
                                <option ng-repeat="x in AllUserList" value="{{x.LoginId}}">{{x.Name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        @*<div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="scSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                                <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>*@

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="d-flex align-items-center gap-2 check-all-wrap">
                                <input type="checkbox" id="chkMaster" ng-click="checkUncheckAll()" ng-disabled="!UserId" />
                                <label for="checkAllPermissions" class="mb-0">Check All</label>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="permissionTable">
                            <thead>
                                <tr>
                                    <th>   S.No</th>
                                    <th>Page Name</th>
                                    <th>Section Name</th>
                                    <th style="text-align: center;">View</th>
                                    <th style="text-align: center;">Edit/Save</th>
                                </tr>
                            </thead>
                            <tbody id="permissionTableBody">
                                <tr ng-repeat="sectionlist in PagesSectionMasterList" repeat-done>
                                    <td class="srno">
                                        {{$index+1}}
                                        <input type="hidden" id="hfId" value="{{sectionlist.Id}}" />
                                        <input type="hidden" id="hfSectionName" value="{{sectionlist.SectionName}}" />
                                    </td>
                                    <td>{{sectionlist.PageName}}</td>
                                    <td>{{sectionlist.SectionName}}</td>
                                    <td class="text-center">
                                        <div ng-if="sectionlist.AllowViewFlag">
                                            <div class="checkbox checkbox-primary table-check-wt">

                                                <input type="checkbox" class="clear" id="chkAllowView" ng-model="chkAllow[$index]['View']"
                                                       ng-checked="chkAllow[$index]['View']" ng-init="chkAllow[$index]['View'] = sectionlist.ViewFlag" ng-disabled="!UserId" />
                                                <label for="chkAllowView{{$index}}"></label>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div ng-if="sectionlist.AllowEditFlag">
                                            <div class="checkbox checkbox-primary table-check-wt">
                                                <input type="checkbox" class="clear" id="chkAllowEdit" ng-model="chkAllow[$index]['Edit']"
                                                       ng-checked="chkAllow[$index]['Edit']" ng-init="chkAllow[$index]['Edit'] = sectionlist.EditFlag" ng-disabled="!UserId" />
                                                <label for="chkAllowEdit{{$index}}"></label>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button class="btn btn-sm save-btn" ng-click="SavePermissionRecord()">
                            Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- CARD 4 : Location Management-->
        <div id="storeMapping" class="card section-card d-none">
            <div class="card-body p-3 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">

                        <div class="admin-dd" ng-init="AllUserListsLoad();">
                            <label class="admin-dd-label">User List</label>
                            <select autocomplete='address-level2' class="select2 form-control" id="ddlUserList" ng-model="StoreUserId" ng-change="BindAllStoreList()">
                                <option value="">Select</option>
                                <option ng-repeat="x in AllUserList" value="{{x.LoginId}}">{{x.Name}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">

  <div class="d-flex align-items-center gap-2">
                            <div class="search-container">
                                <div class="input-group input-group-sm">
                                    <input type="text"
                                           class="form-control form-control-sm" ng-model="searchText"
                                           placeholder="Search..." />
                                    <button class="btn btn-sm btn-outline-primary" type="button">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="d-flex align-items-center gap-2 check-all-wrap">
                                <input ng-disabled="!StoreUserId" type="checkbox" class="clear" ng-model="chkAll" ng-change="chkStoreAllRow()" />
                                <label for="checkAllStoreMapping" class="mb-0">Check All</label>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="storeMappingTable">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>S.No</th>
                                    <th>Location Code</th>
                                    <th>Ref. Store Code</th>
                                    <th>Unit Name</th>
                                    <th>Created By</th>
                                    <th>User Type</th>
                                </tr>
                            </thead>
                            <tr ng-repeat="x in OverallStoresList | filter:SearchLocation" repeat-done>
                                <td class="text-center">
                                    <div class="checkbox checkbox-primary table-check-wt">
                                        <input ng-disabled="!StoreUserId" type="checkbox" class="clear" id="chkAllow" ng-model="x.IsAllow" ng-checked="x.IsAllow"
                                               ng-change="chkRowAll($index)" />

                                        <label></label>
                                    </div>
                                </td>
                                <td class="srno">
                                    {{$index+1}}
                                    <input type="hidden" id="hfMenuId" value="{{x.StoreId}}" />
                                </td>
                                <td>{{x.StoreCode}}</td>
                                <td>{{x.RefStoreCode}}</td>
                                <td>{{x.StoreName}}</td>
                                <td>{{x.UserName}}</td>
                                <td>{{x.ClientType}}</td>
                            </tr>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button class="btn btn-sm save-btn" ng-click="SaveStoremappingRecord()">
                            Save
                        </button>
                    </div>

                </div>

            </div>

        </div>
        <!-- CARD 5 : License Management -->
        <div id="industryMapping" class="card section-card d-none">
            <div class="card-body p-3 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="search-container">
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       class="form-control form-control-sm" ng-model="SearchIndustry"
                                       placeholder="Search..." ng-change="SearchData()" />


                                <button class="btn btn-sm btn-outline-primary" type="button">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="d-flex align-items-center gap-2 check-all-wrap">
                                <input type="checkbox"
                                       class="clear"
                                       ng-model="chkAll"
                                       ng-change="chkAllRow()" />
                                <label for="checkAllIndustryMapping" class="mb-0">Check All</label>

                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm add-user-btn" data-bs-toggle="modal" data-bs-target="#LicenseDocument">
                                    <i class="bi bi-plus-lg me-1"></i> Add License
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="industryMappingTable">
                            <thead>
                                <tr>
                                    <th class="text-center w-50-p" style="width:50px;">
                                        <div class="checkbox checkbox-primary table-check-wt">
                                            <input type="checkbox"
                                                   class="clear"
                                                   ng-model="chkAll"
                                                   ng-change="chkAllRow()" />
                                            <label></label>
                                        </div>
                                    </th>

                                    <th class="srno" style="width:60px;">S.No.</th>
                                    <th>License Name</th>
                                    <th>State</th>
                                    <th>Category</th>
                                    <th>Act</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in OverallList | filter:SearchIndustry" id="industryMappingTableBody">

                                    <td class="text-center" style="width:50px;">
                                        <div class="checkbox checkbox-primary table-check-wt" ng-if="x.LicenseType == 'a'">

                                            <input type="checkbox" class="clear" id="chkAllow" ng-model="x.IsAllow" ng-checked="x.IsAllow"
                                                   ng-change="chkRowAll($index)" />
                                            <label></label>
                                        </div>

                                        <!-- Delete Icon (jab LicenseType C ho) -->
                                        <i class="fa fa-trash text-danger"
                                           style="cursor:pointer;"
                                           ng-if="x.LicenseType == 'c'"
                                           ng-click="deleteCustomLicense(x,$index)">
                                        </i>
                                    </td>


                                    <td class="srno" style="width:60px;">
                                        {{$index+1}}
                                        <input type="hidden" value="{{x.LicenseId}}" />
                                    </td>

                                    <td>{{x.LicenseName}}</td>
                                    <td>{{x.State}}</td>
                                    <td>
                                        {{x.CategoryName}}
                                    </td>
                                    <td>{{x.Act}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between mt-2">

                        <div>
                            Showing {{(currentPage-1)*pageSize + 1}}
                            -
                            {{(currentPage-1)*pageSize + OverallList.length}}
                            of {{totalRecords}} Licenses
                        </div>

                        <div>

                            <button class="btn btn-sm save-btn"
                                    ng-disabled="currentPage==1"
                                    ng-click="PrevPage()">
                                Prev
                            </button>

                            Page {{currentPage}}

                            <button class="btn btn-sm save-btn"
                                    ng-disabled="currentPage*pageSize >= totalRecords"
                                    ng-click="NextPage()">
                                Next
                            </button>

                        </div>

                    </div>
                    <div class="d-flex justify-content-end mt-3">
                        <button class="btn btn-sm save-btn" ng-click="SaveIndustryMappingRecord()">
                            Save
                        </button>

                    </div>

                </div>

            </div>

        </div>

        <!-- CARD 6 : Log Report -->
        <div id="activityReport" class="card section-card d-none">
            <div class="card-body p-3 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="admin-dd">
                            <label class="admin-dd-label">Activity Date</label>
                            <input id="txtStartDate"
                                   type="date"
                                   ng-model="StartDate"
                                   ng-change="BindActivity()"
                                   class="form-control admin-dd-select" />

                        </div>
                    </div>

                    <!-- RIGHT : Search + Export -->
                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-md-end">

                        <!-- Search -->
                        <div class="search-container">
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       class="form-control form-control-sm" ng-model="SearchActivity"
                                       placeholder="Search..." />
                                <button class="btn btn-sm btn-outline-primary" type="button">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Export -->
                        <button type="button" class="btn btn-sm export-btn" ng-click="printActivityReport()">
                            <i class="bi bi-download me-1"></i> Print
                        </button>

                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="activityReportTable">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>User Name</th>
                                    <th>UserType</th>
                                    <th>Created On</th>
                                    <th>Activity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in LogActivity | filter:SearchActivity">
                                    <td>{{x.RowId}}</td>
                                    <td>{{x.UserName}}</td>

                                    <td>{{x.UserType}}</td>
                                    <td>{{x.CreatedOn}}</td>
                                    <td>{{x.Activity}}</td>
                            </tbody>
                        </table>
                    </div>


                </div>

            </div>
        </div>

        <div class="modal fade" id="AddDocumentModel" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content admin-user-modal">

                    <div class="modal-header">
                        <h6 class="modal-title">Add Document</h6>
                        <button type="button" class="btn-close" ng-click="ManageLog('Close Compliance Doc')" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">

                            <!-- Document Name -->
                            <div class="col-md-6">
                                <label class="form-label">Document Name</label>
                                <input type="text"
                                       class="form-control"
                                       ng-model="addDoc.docName">
                            </div>

                            <!-- Locations -->
                            <div class="col-md-6" ng-init="GETAllSTORE()">
                                <label class="form-label">Locations</label>

                                <div class="dropdown lm-multiselect w-100">
                                    <button class="form-select form-select-sm dropdown-toggle text-truncate location-btn"
                                            type="button"
                                            data-bs-toggle="dropdown">
                                        <span class="d-block text-truncate">
                                            {{ addDoc.locations.length ? addDoc.locations.join(', ') : 'Select Locations' }}
                                        </span>
                                    </button>

                                    <ul class="dropdown-menu w-100 p-1" style="max-height:200px; overflow:auto;">

                                        <!-- Select All -->
                                        <li class="px-2 py-1 border-bottom">
                                            <label class="dropdown-item fw-bold d-flex gap-2">
                                                <input type="checkbox"
                                                       ng-checked="addDoc.locationIds.length === locationLists.length && locationLists.length"
                                                       ng-click="selectAllLocations(addDoc, $event)">
                                                Select All
                                            </label>
                                        </li>

                                        <!-- Individual -->
                                        <li ng-repeat="loc in locationLists">
                                            <label class="dropdown-item d-flex gap-2 align-items-center">
                                                <input type="checkbox"
                                                       ng-checked="addDoc.locationIds.indexOf(loc.StoreId) > -1"
                                                       ng-click="toggleLocation(addDoc, loc, $event)">

                                                <span>
                                                    {{loc.StoreName}}- {{loc.StoreCode}} [{{loc.RefStoreCode}}]
                                                </span>
                                            </label>
                                        </li>

                                    </ul>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-sm save-user-btn"
                                ng-click="SaveDocument();ManageLog('Save Compliance Document')">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>


        <!-- License Document modal inside License Management-->
        <div class="modal fade" id="LicenseDocument" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content admin-user-modal" ng-init="AllRecordLicense()">

                    <div class="modal-header">
                        <h6 class="modal-title">License Document</h6>
                        <button type="button" class="btn-close"
                                ng-click="ManageLog('Close License Doc')"
                                data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">

                            <div class="col-md-12">

                                <label class="form-label">State</label>
                                <select class="form-control"
                                        ng-model="SelectedState"
                                        ng-options="s for s in StateList"
                                        ng-change="FilterLicense()">
                                    <option value="">Select State</option>
                                </select>

                                <label class="form-label mt-2">Category</label>
                                <select class="form-control"
                                        ng-model="SelectedCategory"
                                        ng-options="c for c in CategoryList"
                                        ng-change="FilterLicense()">
                                    <option value="">Select Category</option>
                                </select>

                                <label class="form-label mt-2">License</label>

                                <!-- License dropdown changes-->
                                <select class="form-select license-select"
                                        ng-model="addLicense.selectedLicense"
                                        ng-options="x as (x.LicenseName + ' | ' + x.State + ' | ' + x.CategoryName + ' | ' + x.Act) for x in FilteredLicenseList">
                                    <option value="">Select License</option>
                                    <option value="acgsv">hgfjsgdahdkjhasskjdsdfghjkjhgfdsdftyuiuytrdfvbnmbjh</option>
                                </select>

                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Unique Code</label>
                                <input type="text" class="form-control" ng-model="addLicense.UniqueId">
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-sm save-user-btn"
                                ng-click="SaveCustomLicense();ManageLog('Save License Document')">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>
        
        


    </div>

        <!-- CARD 7 : Location Doc -->
        <div id="complianceDocCard" class="card section-card d-none">
            <div class="card-body p-3">


                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-end mb-2 gap-2 flex-wrap">
				 <div class="d-flex align-items-center gap-2">
                        <div class="search-container">
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       class="form-control form-control-sm" ng-model="Searchdocument"
                                       placeholder="Search..." />
                                <button class="btn btn-sm btn-outline-primary" type="button">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm add-user-btn" data-bs-toggle="modal" data-bs-target="#AddDocumentModel">
                            <i class="bi bi-plus-lg me-1"></i> Add Document
                        </button>
                    </div>


                </div>

                <div class="small-table-wrapper ">
                    <div class="table-responsive rounded-3">

                        <table class="table table-sm mb-0 small-table" id="lm-compDoc-Table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Default</th>
                                    <th>Document Name</th>
                                    <th>Location</th>
                                    <th>Created On</th>
                                    <th>Created by</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tr ng-repeat="row in groupedDocs | filter:Searchdocument">
                                <td>{{$index + 1}}</td>
                                <td>
                                    <span ng-if="!row.isEdit">
                                        <input type="checkbox" ng-checked="row.IsDefault" disabled />
                                    </span>

                                    <input type="checkbox"
                                           ng-if="row.isEdit"
                                           ng-model="row.IsDefault"
                                           ng-change="SetDefault(row)" /> 
                                </td>
                                <td>
                                    <span ng-if="!row.isEdit"> {{row.DocumentName}} </span>
                                    <input type="text" class="form-control form-control-sm" ng-if="row.isEdit" ng-model="row.DocumentName" />
                                </td>

                                <!-- Location column -->
                                <td>
                                    {{row.Locations[0].StoreCode}}
                                    <a href=""
                                       ng-if="row.Locations.length > 1"
                                       ng-click="openLocationPopup(row)">
                                        +{{row.Locations.length - 1}} more
                                    </a>
                                </td>

                                <td>{{row.CreatedDate}}</td>
                                <td>{{row.UserName}}</td>

                                <!-- Action (ONLY Edit) -->
                                <td class="action-menu">
                                    <button class="btn btn-sm" ng-class="row.isEdit ? 'text-success' : ' '" ng-click="row.isEdit ? Updaterow(row) : EditRow(row)">
                                        <!--I've Removed text-primary from this line-->
                                        <i class="bi bi-pencil-square" ng-class="row.isEdit ? 'bi-check-lg' : 'bi-pencil-square'"></i>
                                    </button>

                                </td>
                            </tr>

                        </table>
                    </div>

                </div>
            </div>
        </div>
</div>



<div class="modal fade" id="loadingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">

            <!-- 🔹 Header with close icon -->
            <div class="modal-header py-2">
                <h6 class="modal-title">Please wait or close</h6>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <!-- 🔹 Body -->
            <div class="modal-body text-center p-3">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <h6 class="mb-0">loading data...</h6>
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="locationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header" style="background:#E45D27; color:#fff">
                <h4 class="modal-title">Locations</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body px-2 py-0" style="max-height: 600px; overflow-y: auto; background: #FEF3EC">
                <table class="table table-sm align-middle mb-0 rounded-3">
                    <thead class="table-light sticky-top" style="background:#E45D27; color:#fff">
                        <tr>
                            <th style="width:60px;">S.No</th>
                            <th>Location Code</th>
                            <th style="width:80px;" class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody >
                        <tr style="background: #FEF3EC" ng-repeat="loc in selectedDoc.Locations track by $index">
                            <td>{{$index + 1}}</td>
                            <td>
                                {{loc.StoreCode}}
                            </td>
                            <td class="text-center">
                                <i class="fa fa-trash text-danger"
                                   style="cursor:pointer;"
                                   title="Delete Location"
                                   ng-click="Deleterow(loc)">
                                </i>
                            </td>
                        </tr>

                        <tr ng-if="!selectedDoc.Locations || selectedDoc.Locations.length === 0">
                            <td colspan="3" class="text-center text-muted">
                                No locations found
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>

                

        </div>
    </div>
</div>

