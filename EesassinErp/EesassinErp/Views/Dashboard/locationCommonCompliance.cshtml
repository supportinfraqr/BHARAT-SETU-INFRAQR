    <div class="container-report8 py-4" ng-init="BindTiles();commonReport()">

        <!-- HEADER -->
        @*<div class="report-header8 d-flex justify-content-end align-items-center mb-3">
            <h6 class="mb-0 fw-semibold text-end">Report Period: Oct 2025</h6>
        </div>*@

        <!-- BODY -->
        <div class="report-body8 p-4" ng-init="Locationmaster()">

            <!-- TITLE -->
            <div class="report-title-box text-center py-2 px-2 mb-3">
                <h5 class="fw-semibold mb-0">
                    Location Report
                </h5>
            </div>

            <!-- DESCRIPTION -->
            <p class="text-muted text-center mb-4" style="font-size:14px;">
                This section provides a consolidated overview of all compliances, highlighting the organization’s completion ratio,
                pending obligations, and compliance health for the selected period.
            </p>

            <!-- SMALL CARDS -->
            <div class="row g-3 mb-4 justify-content-center text-center">
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-success text-white py-3">
                        <h6>Active</h6>
                        <h5>{{ActiveCount}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-danger text-white py-3">
                        <h6>Upcoming</h6>
                        <h5>{{UpcomingCount}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-warning text-dark py-3">
                        <h6>Inactive</h6>
                        <h5>{{InactiveCount}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-orange text-white py-3" style="background-color:#E45D27;">
                        <h6>Total States</h6>
                        <h5>{{StateCount}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-danger text-white py-3">
                        <h6>Total Cities</h6>
                        <h5>{{CityCount}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-success text-white py-3">
                        <h6>Total</h6>
                        <h5>{{TotalStores}}</h5>
                    </div>
                </div>
            </div> 

        


            <h6 class="mb-2 fw-semibold text-center" style="color: #E45D27">Document Expiry</h6>

            <!-- TABLE 2 -->
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>Store Code</th>
                            <th>Document Date</th>
                            <th>Days to Expire</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in DocumentHighlightsList">
                            <td>
                                {{x.StoreCode}}
                            </td>
                            <td>
                                {{x.ValidDate}}
                            </td>
                            <td>
                                {{x.DayExpire}}
                            <td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>


        <!-- ===== Footer ===== -->
        @*<div class="report-footer d-flex justify-content-between align-items-center px-4 py-2 mt-4 border-top">
