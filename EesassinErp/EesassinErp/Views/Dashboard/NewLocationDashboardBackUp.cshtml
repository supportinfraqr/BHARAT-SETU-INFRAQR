
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Location Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<link href="~/Dashboards/NewLocationDashboard/style.css" rel="stylesheet" />
<script src="~/Dashboards/NewLocationDashboard/script.js"></script>
<div class="locationDashPage px-4 py-2">
    <!-- ================= Container 1 : Header + KPI ================= -->
    <div class="locationDash-container1 mb-4">

        <!-- Header Row -->
        <div class="locationDash-header d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">

            <h4 class="locationDash-title mb-0">
                Location Dashboard
            </h4>

            <div class="locationDash-actions d-flex align-items-center gap-2 flex-wrap">



                <div class="locationDash-filter d-flex align-items-center gap-2">
                    <input type="date" class="form-control form-control-sm">
                    <span class="text-muted">-</span>
                    <input type="date" class="form-control form-control-sm">
                    <button class="btn btn-sm locationDash-goBtn">
                        Go
                    </button>
                </div>
                <button class="btn btn-sm locationDash-pdfBtn">
                    PDF
                </button>

            </div>
        </div>

        <!-- KPI Cards Row -->
        <div class="row g-3">

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="locationDash-kpiCard kpi-active">
                    <div class="kpi-left">
                        <div class="kpi-title">Active</div>
                        <div class="kpi-percent">52.66%</div>
                    </div>
                    <div class="kpi-value">99</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="locationDash-kpiCard kpi-inactive">
                    <div class="kpi-left">
                        <div class="kpi-title">Inactive</div>
                        <div class="kpi-percent">28.72%</div>
                    </div>
                    <div class="kpi-value">54</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="locationDash-kpiCard kpi-upcoming">
                    <div class="kpi-left">
                        <div class="kpi-title">Upcoming</div>
                        <div class="kpi-percent">18.62%</div>
                    </div>
                    <div class="kpi-value">35</div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="locationDash-kpiCard kpi-total">
                    <div class="kpi-left">
                        <div class="kpi-title">Total</div>
                        <div class="kpi-percent">100%</div>
                    </div>
                    <div class="kpi-value">188</div>
                </div>
            </div>

        </div>


    </div>

    <!-- ================= Container 2 : Upcoming Task + Hots & Hurry ================= -->
    <div class="locationDash-container2 mb-4">

        <div class="row g-3 align-items-stretch">

            <!-- ===== Left Card : Upcoming Task ===== -->
            <div class="col-12 col-lg-6 d-flex">
                <div class="locationDash-card flex-fill">

                    <!-- Header -->
                    <div class="locationDash-card-header d-flex justify-content-between align-items-center mb-3">
                        <h5 class="locationDash-card-title mb-0">Upcoming Task</h5>

                        <div class="locationDash-filter small-filter d-flex align-items-center gap-2">
                            <input type="date" class="form-control form-control-sm">
                            <span class="text-muted">-</span>
                            <input type="date" class="form-control form-control-sm">
                            <button class="btn btn-sm locationDash-goBtn">Go</button>
                        </div>
                    </div>

                    <!-- Inner KPI cards -->
                    <div class="row g-3">

                        <div class="col-6">
                            <div class="locationDash-miniCard kpi-upcoming">
                                <div class="mini-left">
                                    <div class="mini-title">Upcoming</div>
                                </div>
                                <div class="mini-value">35</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="locationDash-miniCard kpi-inactive ">
                                <div class="mini-left">
                                    <div class="mini-title">Upcoming License</div>
                                    <ul class="mini-list grid-2x2">
                                        <li>Doc. Pending :10</li>
                                        <li>Pending App :4</li>
                                        <li>Applied :0</li>
                                        <li>Issued :0</li>
                                    </ul>
                                </div>
                                <div class="mini-value">14</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="locationDash-miniCard kpi-active">
                                <div class="mini-left">
                                    <div class="mini-title">Executed Document</div>
                                </div>
                                <div class="mini-value">1</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="locationDash-miniCard kpi-total">
                                <div class="mini-left">
                                    <div class="mini-title">Active (Operational)</div>
                                </div>
                                <div class="mini-value">0</div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- ===== Right Card : Hots & Hurry ===== -->
            <div class="col-12 col-lg-6 d-flex">
                <div class="locationDash-card flex-fill">

                    <div class="locationDash-card-header mb-3">
                        <h5 class="locationDash-card-title mb-0">Hots And Hurry (NSO)</h5>
                    </div>

                    <div class="locationDash-chartRow">
                        <div class="chart-box">
                            <canvas id="budgetedChart"></canvas>
                            <div class="chart-label">Total Budgeted (No.)</div>
                        </div>

                        <div class="chart-box">
                            <canvas id="locationDaysChart"></canvas>
                            <div class="chart-label">Location Days</div>
                        </div>

                        <div class="chart-box">
                            <canvas id="actualDaysChart"></canvas>
                            <div class="chart-label">Actual Location Days</div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- ================= Container 3 : Location Document & Distribution ================= -->
    <div class="locationDash-container3 mb-4">

        <div class="row g-3 align-items-stretch">

            <!-- ===== Left Card : Location Document ===== -->
            <div class="col-12 col-lg-6 d-flex">
                <div class="locationDash-card flex-fill">

                    <!-- Header -->
                    <div class="locationDash-card-header d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <h5 class="locationDash-card-title mb-0">Location Document</h5>

                        <div class="locationDash-btnFilters d-flex gap-2 flex-wrap">

                            <!-- Region -->
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle locationDash-filterBtn"
                                        data-bs-toggle="dropdown">
                                    Region
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">Central</a></li>
                                    <li><a class="dropdown-item" href="#">North</a></li>
                                    <li><a class="dropdown-item" href="#">South</a></li>
                                    <li><a class="dropdown-item" href="#">East</a></li>
                                    <li><a class="dropdown-item" href="#">West</a></li>
                                </ul>
                            </div>

                            <!-- State -->
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle locationDash-filterBtn"
                                        data-bs-toggle="dropdown">
                                    State
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">All States</a></li>
                                    <li><a class="dropdown-item" href="#">Maharashtra</a></li>
                                    <li><a class="dropdown-item" href="#">Karnataka</a></li>
                                    <li><a class="dropdown-item" href="#">Delhi</a></li>
                                    <li><a class="dropdown-item" href="#">Tamil Nadu</a></li>
                                </ul>
                            </div>

                            <!-- Location Code -->
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle locationDash-filterBtn"
                                        data-bs-toggle="dropdown">
                                    Location Code
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">All Locations</a></li>
                                    <li><a class="dropdown-item" href="#">LOC-001</a></li>
                                    <li><a class="dropdown-item" href="#">LOC-002</a></li>
                                    <li><a class="dropdown-item" href="#">LOC-003</a></li>
                                </ul>
                            </div>

                        </div>

                    </div>

                    <!-- Bar Chart -->
                    <div class="locationDash-chartWrap">
                        <canvas id="locationDocumentChart"></canvas>
                    </div>

                </div>
            </div>

            <!-- ===== Right Card : Distribution ===== -->
            <div class="col-12 col-lg-6 d-flex">
                <div class="locationDash-card flex-fill">

                    <!-- Header -->
                    <div class="locationDash-card-header d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

                        <div class="locationDash-btnFilters d-flex gap-2 flex-wrap">

                            <!-- Year -->
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle locationDash-filterBtn active"
                                        data-bs-toggle="dropdown">
                                    Year
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">2025</a></li>
                                    <li><a class="dropdown-item" href="#">2024</a></li>
                                    <li><a class="dropdown-item" href="#">2023</a></li>
                                    <li><a class="dropdown-item" href="#">2022</a></li>
                                </ul>
                            </div>

                            <!-- Month -->
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle locationDash-filterBtn"
                                        data-bs-toggle="dropdown">
                                    Month
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">January</a></li>
                                    <li><a class="dropdown-item" href="#">February</a></li>
                                    <li><a class="dropdown-item" href="#">March</a></li>
                                    <li><a class="dropdown-item" href="#">April</a></li>
                                    <li><a class="dropdown-item" href="#">May</a></li>
                                </ul>
                            </div>

                            <!-- Category -->
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle locationDash-filterBtn"
                                        data-bs-toggle="dropdown">
                                    Category
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">All</a></li>
                                    <li><a class="dropdown-item" href="#">License</a></li>
                                    <li><a class="dropdown-item" href="#">Compliance</a></li>
                                    <li><a class="dropdown-item" href="#">Document</a></li>
                                </ul>
                            </div>

                            <!-- Status -->
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle locationDash-filterBtn"
                                        data-bs-toggle="dropdown">
                                    Status
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">All</a></li>
                                    <li><a class="dropdown-item" href="#">Active</a></li>
                                    <li><a class="dropdown-item" href="#">Inactive</a></li>
                                    <li><a class="dropdown-item" href="#">Upcoming</a></li>
                                </ul>
                            </div>

                        </div>


                    </div>

                    <!-- Donut Chart -->
                    <div class="locationDash-chartWrap d-flex justify-content-center">
                        <canvas id="locationDistributionChart"></canvas>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- ================= Container 4 : Document Highlights ================= -->
    <div class="locationDash-container4 mb-4">
        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <h4 class="locationDash-title mb-0">
                        Document Highlights
                    </h4>
                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="scSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 justify-content-center">
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>
                                <li><a class="dropdown-item" href="#">Print</a></li>
                            </ul>
                        </div>
                        
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table" id="locationDashTable">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Location Code</th>
                                <th>Document Name</th>
                                <th>Period</th>
                                <th>Days to Expire</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="locationDashTableBody">
                            <tr>
                                <td>1</td>
                                <td>00001232</td>
                                <td>Electricity Bill</td>
                                <td>12/26/2025</td>
                                <td>-67</td>
                                <td>
                                    <span class="badge status-disabled">Expired</span>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>00003807</td>
                                <td>Ownership Docs</td>
                                <td>07/01/2026</td>
                                <td>5</td>
                                <td>
                                    <span class="badge status-upcoming">Expiring Soon</span>
                                </td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>00004209</td>
                                <td>additional Docs</td>
                                <td>22/01/2026</td>
                                <td>20</td>
                                <td>
                                    <span class="badge status-active">Valid</span>
                                </td>
                            </tr>
                            

                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="locationDashPaginationWrap">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm" id="locationDashPrev" type="button">Previous</button>
                        <button class="btn btn-sm" id="locationDashNext" type="button">Next</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="locationDashPageInfo" style="font-size:0.85rem;color:#555;"></div>
                        <button class="btn btn-sm" id="viewAllRows" type="button">View All Rows</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>