                            </select>
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer cv-footer">
                    <button class="btn btn-sm cv-btn-outline" data-bs-dismiss="modal" ng-model="ClearH" ng-click="ClearReset()">
