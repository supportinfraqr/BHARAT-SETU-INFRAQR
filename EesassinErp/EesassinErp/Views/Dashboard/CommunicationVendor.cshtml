                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="" ng-click="exportCSV()">CSV</a></li>
                                <li><a class="dropdown-item" href="" ng-click="printData()">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3" ng-init="BindCommunication()">
