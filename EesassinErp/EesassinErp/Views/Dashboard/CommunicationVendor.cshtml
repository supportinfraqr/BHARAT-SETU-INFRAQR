                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- STATE -->
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                            {{selectedState || 'State'}}
                        </button>
                        <ul class="dropdown-menu">
                            <li ng-repeat="s in StateList">
                                <a class="dropdown-item" href="" ng-click="setFilter('state', s)">
                                    {{s}}
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- MONTH -->
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                            {{selectedMonth || 'Month'}}
                        </button>
                        <ul class="dropdown-menu">
                            <li ng-repeat="m in MonthList">
                                <a class="dropdown-item" href="" ng-click="setFilter('month', m)">
                                    {{m}}
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- YEAR -->
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                            {{selectedYear || 'Year'}}
                        </button>
                        <ul class="dropdown-menu">
                            <li ng-repeat="y in YearList">
                                <a class="dropdown-item" href="" ng-click="setFilter('year', y)">
                                    {{y}}
                                </a>
                            </li>
                        </ul>
                    </div>

                    <button class="btn btn-sm filter-btn active" ng-click="applyFilter()">Go</button>
                    <button class="btn btn-sm btn-secondary" ng-click="resetFilter()">Reset</button>

                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
