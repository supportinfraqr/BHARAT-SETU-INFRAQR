
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Communication Vendor";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="~/Scripts/myjslib/VendorInvoiceController.js?Ver=@ViewBag.Version"></script>
<script src="~/Scripts/myjslib/WithoutInvoiceController.js?Ver=@ViewBag.Version"></script>
 

<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.5/purify.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<!-- For Excel -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
 
<style>
    #communicationVendorPage {
        font-family: "Inter", sans-serif;
        --primary: #E45D27; /* theme accent */
        --primary-dark: #c44b1d;
        --card-bg: #FEF3EC;
        background: #FFF1EB;
        color: #223;
        min-height: 85vh;
    }


    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }

    #communicationVendorPage #createComplDoc {
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 6px 12px;
        font-weight: 400;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        -webkit-tap-highlight-color: transparent;
    }

        #communicationVendorPage #createComplDoc:hover {
            background: var(--primary-dark);
        }


    /* Section cards */
    #communicationVendorPage .section-card {
        background: transparent;
        border: none;
    }

        #communicationVendorPage .section-card .card-body {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            min-height: 320px;
        }

    /* Table wrapper and hide scrollbar visually */
    #communicationVendorPage .small-table-wrapper .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: smooth;
        position: relative;
    }

        #communicationVendorPage .small-table-wrapper .table-responsive::-webkit-scrollbar {
            display: none;
        }

    /* table header sticky */
    #communicationVendorPage .small-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #F37437;
        color: #fff;
        font-weight: 600;
        font-size: 0.78rem;
        text-align: left;
        vertical-align: middle;
        white-space: nowrap;
        padding: 8px 10px;
    }

    /* table body */
    #communicationVendorPage .small-table tbody td {
        background-color: var(--card-bg);
        font-size: 0.78rem;
        vertical-align: middle;
        text-align: left;
        padding: 8px 10px;
        white-space: nowrap;
    }

    /* hover */
    #communicationVendorPage .small-table tbody tr:hover td {
        background-color: #FFE8D9;
    }

    #communicationVendorPage .small-table tbody td .store-code-link,
    #communicationVendorPage .small-table tbody td .event-link {
        text-decoration: none;
    }

    /* action menu */
    #communicationVendorPage .action-menu {
        position: relative;
        width: 48px;
        text-align: right;
        background-color: var(--card-bg);
    }

        #communicationVendorPage .action-menu .btn {
            color: var(--primary);
        }

        #communicationVendorPage .action-menu .dropdown-menu {
            min-width: 120px;
            font-size: 0.85rem;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

    /* filter button */
    #communicationVendorPage .filter-btn {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #communicationVendorPage .filter-btn.active,
        #communicationVendorPage .filter-btn:hover {
            background: var(--primary);
            color: #fff;
        }

    /* small inputs */
    #communicationVendorPage .table-toolbar .form-control-sm {
        height: 36px;
        border-radius: 999px;
        border-color: var(--primary);
    }

    /* Export button (rounded) */
    #communicationVendorPage .export-btn {
        border-radius: 999px;
        color: #fff;
        background: var(--primary);
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
        -webkit-tap-highlight-color: transparent;
    }

        #communicationVendorPage .export-btn:hover {
            background: var(--primary-dark);
        }

        /* remove default dark flash on click for export and other action buttons while keeping subtle ring on focus */
        #communicationVendorPage .export-btn:focus,
        #communicationVendorPage .export-btn:active {
            outline: none;
            box-shadow: 0 0 0 3px rgba(228,93,39,0.12);
        }

    /*Fix Search bar and button in toolbar*/
    #communicationVendorPage .table-toolbar .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    #communicationVendorPage .table-toolbar .input-group .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-color: var(--primary);
    }

    /* Pagination area */
    #communicationVendorPage .table-pagination {
        border-top: 1px solid rgba(0,0,0,0.04);
        padding-top: 8px;
        margin-top: 8px;
    }

        #communicationVendorPage .table-pagination .btn {
            border-radius: 999px;
            font-size: 0.85rem;
            padding: 6px 12px;
            border: 1px solid var(--primary);
            background: #fff;
            color: var(--primary);
        }

            #communicationVendorPage .table-pagination .btn:hover {
                background: var(--primary);
                color: #fff;
                border-color: var(--primary);
            }

    #communicationVendorPage #viewAllRows {
        background-color: var(--primary);
        color: #fff;
        border: none;
    }

        #communicationVendorPage #viewAllRows:hover {
            background-color: var(--primary-dark);
        }


    /* statuses */
    #communicationVendorPage .badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
    }

    #communicationVendorPage .status-active {
        background: #dff6e9;
        color: #197a3a;
    }

    #communicationVendorPage .status-upcoming {
        background: #ffeedf;
        color: #d06a1e;
    }

    #communicationVendorPage .status-disabled {
        background: #ffe9ee;
        color: #c43a5b;
    }

    /* Responsive tweaks */
    @@media (max-width: 767px) {
        #communicationVendorPage .table-toolbar {
            flex-direction: column;
            gap: 8px;
            align-items: stretch;
        }

        #communicationVendorPage .top-bar {
            flex-direction: column;
            gap: 8px;
            align-items: flex-start;
        }

        #communicationVendorPage .limit-instruction {
            font-size: 0.85rem;
        }

        #communicationVendorPage .toggle-pill .btn-pill {
            padding: 8px 12px;
            min-width: 64px;
        }
    }

    /* Table Buttons*/

    .btn-upload, .btn-view, .btn-submit {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.78rem;
    }

        .btn-upload:hover, .btn-view:hover, .btn-submit:hover {
            background: var(--primary);
            color: #fff;
        }

    /* Communication Vendor Modal*/

    #communicationVendorPage .cv-header {
        background: var(--primary);
        color: #fff;
        padding: 12px 16px;
        border-bottom: none;
    }

        #communicationVendorPage .cv-header h6 {
            font-size: 0.95rem;
            font-weight: 500;
        }

    #communicationVendorPage .cv-close {
        filter: invert(1);
        opacity: 0.9;
    }

        #communicationVendorPage .cv-close:hover {
            opacity: 1;
        }

    #communicationVendorPage .cv-body {
        background: var(--card-bg);
        padding: 16px;
    }

        #communicationVendorPage .cv-body .form-label {
            font-size: 0.75rem;
            font-weight: 500;
            margin-bottom: 4px;
        }

        #communicationVendorPage .cv-body .form-select {
            height: 34px;
            font-size: 0.8rem;
            border-radius: 6px;
            border-color: #dcdcdc;
        }

            #communicationVendorPage .cv-body .form-select:focus {
                border-color: var(--primary);
                box-shadow: none;
            }

    #communicationVendorPage .cv-footer {
        background: var(--card-bg);
        border-top: none;
        justify-content: flex-end;
        padding: 12px 16px;
    }

    #communicationVendorPage .cv-btn-outline {
        border-radius: 999px;
        border: 1px solid var(--primary);
        background: transparent;
        color: var(--primary);
        padding: 4px 6px;
        font-size: 0.8rem;
    }

        #communicationVendorPage .cv-btn-outline:hover {
            background: var(--primary);
            color: #fff;
        }

    #communicationVendorPage .cv-btn-primary {
        border-radius: 999px;
        background: var(--primary);
        color: #fff;
        border: none;
        padding: 4px 6px;
        font-size: 0.8rem;
    }

        #communicationVendorPage .cv-btn-primary:hover {
            background: var(--primary-dark);
        }
</style>


<div id="communicationVendorPage" class="px-4 py-2">

    <!-- Top bar: Heading left + Create Compliance Document button right -->
    <div class="d-flex align-items-center justify-content-between mb-3 top-bar">
        <h4 style="color: #E45D27">Communication</h4>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm " id="createComplDoc" type="button" data-bs-toggle="modal" data-bs-target="#InvoiceRegistrationModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>  Invoice Registration</span>
            </button>
            <button class="btn btn-sm " id="createComplDoc" type="button" data-bs-toggle="modal" data-bs-target="#createComplianceDocModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Create Compliance Doc</span>
            </button>
        </div>
    </div>

    <div class="modal fade" id="InvoiceRegistrationModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <!-- large modal -->
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">Invoice Registration</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body" style="max-height: 80vh; overflow-y: auto;">

                    <form id="user-form">

                        <!-- 🔹 CARD 1 -->
                        <div class="card">
                            <div class="card-body">
                                <div class="row g-3">

                                    <div class="col-md-3" ng-init="AllParty()">
                                        <label class="form-label">Client</label>
                                        <select id="ddlClient" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-model="ClientId" ng-change="BindStatusInvoice()" ng-disabled="freeze">
                                            <option value="">Select</option>
                                            <option ng-repeat="x in AllPartyList | filter: { PartyType: 'Client' }" value="{{x.PartyId}}">{{x.PartyName}}</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">State</label>

                                        <select id="ddlstate" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-disabled="freeze" ng-init="AllState()" ng-model="StateId" ng-change="AllPartySiteLoadWI();WIBindMonth();WIBindFinacialYear();">
                                            <option value="">Select State</option>
                                            <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">{{x.STATE_NM}}</option>
                                        </select>
                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label">Financial Year</label>

                                        <select id="ddlfyid" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-model="FyId" ng-change="BindIn(FyId)" ng-disabled="freeze">
                                            <option value="">Select</option>
                                            <option ng-repeat="x in WIfinacialyearList" value="{{x.FinancialName}}">{{x.FinancialName}}</option>
                                        </select>

                                    </div>

                                    <div class="col-md-2">
                                        <label class="form-label">Month</label>

                                        <select id="ddlMONTH" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-model="Month" ng-change="ChangeMonth()" ng-disabled="freeze">
                                            <option value="">Select</option>
                                            <option ng-repeat="x in WIMonthList" value="{{x.MonthNumber}}">{{x.MonthName}}</option>
                                        </select>
                                    </div>

                                    <div class="col-md-2" style="display:none">
                                        <label class="form-label">Site</label>

                                        <select class="form-select form-select-sm clear " ng-model="WClientSiteId" ng-change="SetSingleLocation(WClientSiteId)">
                                            <option value="">Select Site</option>
                                            <option ng-repeat="x in AllPartySiteVList" value="{{x.SiteId}}">{{x.SiteId}}-{{x.SiteName}}</option>
                                        </select>
                                    </div>

                                    <div class="col-md-2" style="display:none">
                                        <label class="form-label">Location</label>

                                        <select id="ddlLocation" autocomplete='address-level2' class="form-select form-select-sm  clear" ng-model="WLocation">
                                            <option value="">Select Location</option>
                                            <option ng-repeat="x in LocationL" value="{{x.Location}}">{{x.Location}}</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" style="margin-top:17%" class="btn btn-sm filter-btn active" ng-model="Search" ng-click="HideShowtable()">Search</button>
                                        <button type="button" style="margin-top:17%" class="btn btn-sm filter-btn" ng-model="ClearH" ng-click="ClearHEADER()">Refresh</button>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">

                            </div>
                        </div>

                        <!-- 🔹 CARD 2 -->
                        <div class="card" ng-init="AddInvoiceDetail()" ng-show="IsHide">
                            <div class="card-body">
                                <h4 class="card-title">Invoice Details</h4>
                                <div class="table-responsive" style="max-height: 400px; overflow: auto;">
                                    <table class="table table-bordered nowrap" style="min-width: 1400px; table-layout: fixed;">
                                        <thead style="position: sticky; top: 0; background: #fff; z-index: 2;">
                                            <tr>
                                                <th style="width: 100px;">SNo.</th>
                                                <th style="width: 150px;">Site</th>
                                                <th style="width:130px;">Invoice Date</th>
                                                <th style="width:150px;">Invoice No.</th>
                                                <th style="width: 150px;">Location</th>
                                                <th style="width:120px;">Manpower Count</th>
                                                <th style="width: 150px;">Invoice Type</th>
                                                <th style="width:120px;">Taxable Value</th>
                                                <th style="width:100px;">CGST</th>
                                                <th style="width:100px;">SGST</th>
                                                <th style="width:120px;">IGST</th>
                                                <th style="width:120px;">Gross Amount</th>
                                                <th style="width:120px;">upload Invoicecopy</th>
                                                <th ng-if="{{Save}}=='Edit'">View Invoice</th>
                                                <th style="width: 100px;" class="text-center">+/-</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="obj in InvoiceDetail" repeat-done>
                                                <td>
                                                    <label ng-model="InvoiceDetail[$index].Srno" ng-bind="InvoiceDetail[$index].Srno=$index+1"></label>
                                                </td>
                                                <td>
                                                    <select id="ddlVendorSiteId" autocomplete='address-level2' class="select2 form-control validate" ng-init="AllPartySiteLoad()" ng-disabled="{{hideIsLocation}}" ng-model="InvoiceDetail[$index].VendorSiteId" ng-change="SetLocation(InvoiceDetail[$index].VendorSiteId,$index)">
                                                        <option value="">Select Site</option>
                                                        <option ng-repeat="x in AllPartySiteVList" value="{{x.SiteId}}">{{x.SiteId}}-{{x.SiteName}}</option>
                                                    </select>
                                                </td>

                                                <td>
                                                    <input id="txtToDate" type="date" ng-show="{{InvoiceDetail[$index].Ishide}}!=false" class="form-control clear" placeholder="To Date" ng-model="InvoiceDetail[$index].InvDate" ng-change="SetState($index)" min="{{StartDate}}" max="{{EndDate}}" value="{{convertTodate(InvoiceDetail[$index].InvDate)}}" />
                                                    <div ng-show="{{InvoiceDetail[$index].Ishide}}==false">{{InvoiceDetail[$index].InvDate}}</div>
                                                </td>
                                                <td>
                                                    <input id="VendorInvNum{{$index}}" type="text" ng-model="InvoiceDetail[$index].VendorInvNum" class="form-control clear validate" onkeyup="nospaces(this)" maxlength="50" />
                                                </td>

                                                <td>

                                                    <select id="ddlLocation{{$index}}" autocomplete='address-level2' class="form-control  clear" ng-model="InvoiceDetail[$index].Location" ng-hide="{{hideIsLocation}}">
                                                        <option value="">Select Location</option>
                                                        <option ng-repeat="x in LocationList[InvoiceDetail[$index].Srno-1]" value="{{x.Location}}">{{x.Location}}</option>
                                                    </select>

                                                    <input style="width: 150px !important;" id="txtLoc{{$index}}" type="text" ng-model="InvoiceDetail[$index].Location" class="form-control clear" ng-hide="{{IsLocation}}" ng-disabled="true" />
                                                </td>


                                                <td>
                                                    <input id="txtManpowerCount{{$index}}" type="text" ng-model="InvoiceDetail[$index].ManpowerCount" class="form-control clear" ng-keyup="ValidateINvoice($index);chkManpower($index)" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />


                                                </td>
                                                <td>
                                                    <select id="ddlInvoiceType" autocomplete='address-level2' class="select2 form-control validate" ng-model="InvoiceDetail[$index].InvoiceType" ng-keyup="ValidateINvoice($index);chkManpower($index)">
                                                        <option value="">Select </option>
                                                        <option value="Regular">Regular </option>
                                                        <option value="Reimbursement">Reimbursement</option>
                                                        <option value="Overtime">Overtime</option>
                                                        <option value="other">other</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input id="txtTaxable{{$index}}" type="text" ng-change="BindRowTax($index)" ng-model="InvoiceDetail[$index].TaxableValue" ng-keyup="ValidateINvoice($index)" class="form-control clear validate" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                                </td>
                                                <td>
                                                    <input id="txtCGST{{$index}}" type="text" ng-model="InvoiceDetail[$index].CGST" ng-blur="BindSGSTTax($index)" ng-keyup="ValidateINvoice($index)" class="form-control clear validate" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                                </td>
                                                <td>
                                                    <input id="txtSGST{{$index}}" type="text" ng-model="InvoiceDetail[$index].SGST" ng-disabled="true" class="form-control clear validate" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                                </td>
                                                <td>
                                                    <input id="txtIGST{{$index}}" type="text" ng-model="InvoiceDetail[$index].IGST" ng-blur="BindIGSTTax($index)" ng-keyup="ValidateINvoice($index)" class="form-control clear validate" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                                </td>
                                                <td>
                                                    <input id="txtGrossAmount{{$index}}" type="text" ng-model="InvoiceDetail[$index].GrossAmount"
                                                           ng-disabled="true" class="form-control clear validate" />
                                                </td>

                                                <td>
                                                    <i class="bi bi-cloud-upload" ng-show="InvoiceDetail[$index].Ishide != false"
                                                       style="font-size: 22px; cursor:pointer; color:#0d6efd;"
                                                       ng-click="SetValue($index,'#fuCandidatePhoto'+$index)">
                                                    </i>
                                                    <a ng-show="InvoiceDetail[$index].Ishide == false" on-click="ViewFileC(InvoiceDetail[$index].fileupload)">
                                                        <i class="bi bi-eye" style="font-size:20px; color:green;"></i>
                                                    </a>
                                                    <div ng-show="InvoiceDetail[$index].IsFile">
                                                        <i class="bi bi-check-circle text-success"></i>
                                                        {{InvoiceDetail[$index].IsFile}}
                                                    </div>
                                                    <div ng-show="InvoiceDetail[$index].loading" class="text-info">
                                                        Uploading...
                                                    </div>
                                                    @*<img id="CandidatePhoto{{$index}}" src="~/Content/img/upload.png" ng-click="SetValue($index,'#fuCandidatePhoto'+$index)" style="width: 35px; height: 35px" />*@
                                                    @*<div ng-show="{{InvoiceDetail[$index].IsFile}} !=''">{{InvoiceDetail[$index].IsFile}}</div>
                                                        <a target="_blank" ng-show="{{InvoiceDetail[$index].Ishide}}==false" href="{{InvoiceDetail[$index].fileupload}}">View Invoice</a>*@
                                                    <input type="file"
                                                           id="fuCandidatePhoto{{$index}}"
                                                           style="display:none"
                                                           onchange="angular.element(this).scope().fileChange(this)">
                                                </td>


                                                <td class="text-center">
                                                    <input type="button" value="+" class="btn btn-default2" ng-click="ValidateINvoice($index);AddInvoiceDetail()" data-toggle="tooltip" data-placement="top" title="Add Row"
                                                           ng-if="InvoiceDetail[$index].Srno==InvoiceDetail.length" />
                                                    <input type="button" class="btn btn-default2" id="btnRemoveCourses" value="-" ng-click="RemoveInvoiceDetail($index);"
                                                           ng-if="InvoiceDetail.length>1" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                            </div>
                        </div>

                    </form>

                </div>

                <!-- Footer -->
                <div class="modal-footer" ng-show="IsHide">
                    <button type="button" class="btn btn-sm filter-btn" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-sm filter-btn active" ng-click="BeforeSaveRecord()">Save</button>
                </div>

            </div>
        </div>
    </div>
    <!-- Create Compliance Doc Modal -->
    <div class="modal fade" id="createComplianceDocModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header cv-header">
                    <h6 class="mb-0">Create Compliance Document</h6>

                    <!-- CLOSE BUTTON -->
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="color:#fff"></button>
                </div>

                <!-- --Body-- -->
                <div class="modal-body cv-body">
                    <div class="row g-3">

                        <div class="col-md-6" ng-init="AllParty()">
                            <label class="form-label">Client</label>
                            <select id="ddlClient" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-model="ClientId" ng-change="BindStatusInvoice()" ng-disabled="freeze">
                                <option value="">Select</option>
                                <option ng-repeat="x in AllPartyList | filter: { PartyType: 'Client' }" value="{{x.PartyId}}">{{x.PartyName}}</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">State</label>

                            <select id="ddlstate" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-disabled="freeze" ng-init="AllState()" ng-model="StateId" ng-change="AllPartySiteLoadWI();WIBindMonth();WIBindFinacialYear();">
                                <option value="">Select State</option>
                                <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">{{x.STATE_NM}}</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Financial Year</label>

                            <select id="ddlfyid" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-model="FyId" ng-change="BindIn(FyId)" ng-disabled="freeze">
                                <option value="">Select</option>
                                <option ng-repeat="x in WIfinacialyearList" value="{{x.FinancialName}}">{{x.FinancialName}}</option>
                            </select>

                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Month</label>

                            <select id="ddlMONTH" autocomplete='address-level2' class="form-select form-select-sm clear validate" ng-model="Month" ng-change="ChangeMonth()" ng-disabled="freeze">
                                <option value="">Select</option>
                                <option ng-repeat="x in WIMonthList" value="{{x.MonthNumber}}">{{x.MonthName}}</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Site</label>

                            <select class="form-select form-select-sm clear  validate" ng-model="WClientSiteId" ng-change="SetSingleLocation(WClientSiteId)">
                                <option value="">Select Site</option>
                                <option ng-repeat="x in AllPartySiteVList" value="{{x.SiteId}}">{{x.SiteName}}</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Location</label>

                            <select id="ddlLocation" autocomplete='address-level2' class="form-select form-select-sm  clear validate" ng-model="WLocation">
                                <option value="">Select Location</option>
