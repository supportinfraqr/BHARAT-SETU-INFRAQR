@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Contractor Sites Overview";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="~/scripts/RetailJsLib/ContractorSiteOverviewController.js"></script>
<link href="~/Content/Dashboards/SitesOverview/style.css" rel="stylesheet" />
<script src="~/Content/Dashboards/SitesOverview/script.js"></script>

<div class="contractorSitesOverview sitesOverview px-4 py-3">

    <!-- PAGE HEADER -->
    <div class="sitesOverviewHeader">

        <div ng-init="SiteDetails()">
            <h2 class="sitesOverviewTitle">Sites Overview</h2>
            <p class="sitesOverviewSubTitle">
                All construction sites and projects
            </p>
        </div>

        <!-- VIEW TOGGLE -->
        <div class="viewToggleWrapper">

            <button class="viewToggleBtn active" data-view="grid">
                <i class="bi bi-grid-3x3-gap-fill"></i>
            </button>

            <button class="viewToggleBtn" data-view="table">
                <i class="bi bi-list-ul"></i>
            </button>

        </div>

    </div>

    <!-- GRID VIEW -->
    <div class="sitesGridView activeView">
        <div class="sitesGrid">
            <div class="siteOverviewCard" ng-repeat="x in SiteList">

                <!-- HEADER -->
                <div class="siteOverviewCardHeader">

                    <div class="siteOverviewIcon">
                        <i class="bi bi-buildings"></i>
                    </div>

                    <div class="flex-grow-1">
                        <h4>{{x.SiteName}}</h4>

                        <p>
                            <i class="bi bi-geo-alt"></i>
                            {{x.Address}}
                        </p>
                    </div>

                    <span class="siteOverviewStatus">
                        {{x.Status}}
                    </span>



                </div>

                <!-- STATS -->
                <div class="siteOverviewStats">

                    <div class="siteOverviewStat">
                        <span>Worker Count (PO)</span>
                        <strong>{{x.POCount}}</strong>
                    </div>

                    <div class="siteOverviewStat">
                        <span>Actual Worker</span>
                        <strong>{{x.EmployeeCount}}</strong>
                    </div>

                </div>

                <!-- PROGRESS -->
                <div class="siteOverviewProgressWrap">

                    <div class="d-flex justify-content-between mb-2">
                        <span>Completion</span>
                        <strong>{{x.CompliancePercentage}}%</strong>
                    </div>

                    <div class="progress siteOverviewProgress">
                        <div class="progress-bar" style="width:{{x.CompliancePercentage}}%"></div>
                    </div>

                </div>

                <!-- ACTION BUTTONS -->
                <div class="siteOverviewActionWrap">

                    <button class="siteOverviewViewBtn siteOverviewViewBtnWithActions"
                            ng-click="SearchSitebyId(x.SiteId)"
                            data-bs-toggle="modal" title="Site Details" 
                            data-bs-target="#viewSiteModal">
                        <i class="bi bi-eye"></i>
                        View
                    </button>

                    <button class="siteOverviewIconBtn"
                            data-bs-toggle="modal" title="Billing Order"  data-bs-target="#billingOrderModal" ng-click="GetSiteId(x.SiteId)">
                        <i class="bi bi-cash-stack"></i>
                    </button>

                    <button class="siteOverviewIconBtn" 
                            data-bs-toggle="modal" title="License Details"  data-bs-target="#licenseModal" ng-click="GetSiteId(x.SiteId)">
                        <i class="bi bi-file-earmark-text"></i>
                    </button>

                </div>

            </div>


        </div>

    </div>

    <!-- TABLE VIEW -->
    <div class="sitesTableView">

        <div class="sitesTableCard">

            <div class="table-responsive">

                <table class="table sitesOverviewTable align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Site Name</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Worker Count(PO)</th>
                            <th>Actual Workers</th>
                            <th>Completion</th>

                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr ng-repeat="x in SiteList">

                            <!-- SITE -->
                            <td>
                                <div class="tableSiteNameWrap">

                                    <div class="tableSiteIcon">
                                        <i class="bi bi-buildings"></i>
                                    </div>

                                    <strong>{{x.SiteName}}</strong>

                                </div>
                            </td>

                            <!-- LOCATION -->
                            <td>
                                <div class="tableLocation">
                                    <i class="bi bi-geo-alt"></i>
                                    {{x.Address}}
                                </div>
                            </td>

                            <!-- STATUS -->
                            <td>
                                <span class="tableStatusBadge">
                                    {{x.Status}}
                                </span>
                            </td>

                            <!-- CONTRACTORS -->
                            <td class="fw-semibold text-center">
                                {{x.POCount}}
                            </td>

                            <!-- WORKERS -->
                            <td class="fw-semibold text-center">
                                {{x.EmployeeCount}}
                            </td>

                            <!-- PROGRESS -->
                            <td>

                                <div class="tableProgressWrap">

                                    <div class="progress tableProgressBar siteOverviewProgress">
                                        <div class="progress-bar" style="width:{{x.CompliancePercentage}}%">  </div>
                                    </div>

                                    <strong>{{x.CompliancePercentage}}%</strong>

                                </div>




                            </td>

                            <!-- ACTIONS -->
                            <td>

                                <div class="tableActionWrap">

                                    <button class="tableActionBtn" title="Site Details"  data-bs-toggle="modal" data-bs-target="#viewSiteModal" ng-click="SearchSitebyId(x.SiteId)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="tableActionBtn" title="Billing Order" data-bs-toggle="modal" data-bs-target="#billingOrderModal">
                                        <i class="bi bi-cash-stack"></i>
                                    </button>
                                    <button class="tableActionBtn" title=" License Details" data-bs-toggle="modal" data-bs-target="#licenseModal">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </button>


                                </div>

                            </td>

                        </tr>


                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- VIEW MODAL -->
    <div class="modal fade sitesOverviewModal"
         id="viewSiteModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">{{Sitemaster.SiteCode}} - {{Sitemaster.SiteName}}<br />({{Sitemaster.Address}})</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <!-- Body -->
                <div class="modal-body">
                    <div class="siteViewWrapper">
                        <!-- Basic Info -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">Basic Info</h3>
                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>Assign Color</label>
                                    <span>{{Sitemaster.AssignColor}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Site Name</label>
                                    <span>{{Sitemaster.SiteName}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Location Name</label>
                                    <span>{{Sitemaster.LocationCode}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Manpower Count</label>
                                    <span>{{Sitemaster.ManPowerCount}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Address</label>
                                    <span>{{Sitemaster.Address}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Pincode</label>
                                    <span>{{Sitemaster.Pincode}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Country</label>
                                    <span>{{Sitemaster.CountryName}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>State</label>
                                    <span>{{Sitemaster.STATE_NAME}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>City</label>
                                    <span>{{Sitemaster.CITY_NAME}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Contact No.</label>
                                    <span>{{Sitemaster.ContactNo}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>PAN No.</label>
                                    <span>{{Sitemaster.PANITNO}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>GSTIN/UIN</label>
                                    <span>{{Sitemaster.GSTINUIN}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>CLRA RC</label>
                                    <span>{{Sitemaster.CLRARCstatus}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Contact Person Name</label>
                                    <span>{{Sitemaster.ContactPerson}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Contact Person Mobile</label>
                                    <span>{{Sitemaster.ContactMobile}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Contact Person Email</label>
                                    <span>{{Sitemaster.EmailId}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Description</label>
                                    <span>{{Sitemaster.Description}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Valid From</label>
                                    <span>{{Sitemaster.Validf}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Valid To</label>
                                    <span>{{Sitemaster.Validt}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>CLRA RC Copy</label>
                                    <!-- File Available -->
                                    <span ng-if="Sitemaster.VendorFileDoc && Sitemaster.VendorFileDoc !== 'No file uploaded.'"
                                          class="d-inline-flex align-items-center gap-3">

                                        <a href="#"
                                           ng-click="DownloadFileC(Sitemaster.VendorFileDoc, Sitemaster.VendorFileDoc)"
                                           class="text-decoration-none">
                                            <i class="bi bi-download text-danger" style="font-size:18px;"></i>
                                        </a>

                                        <a ng-href="#"
                                           ng-click="ViewFileC(Sitemaster.VendorFileDoc)"
                                           class="text-decoration-none">
                                            <i class="bi bi-eye-fill text-danger" style="font-size:18px;"></i>
                                        </a>

                                    </span>

                                    <!-- No File -->
                                    <span ng-if="!Sitemaster.VendorFileDoc || Sitemaster.VendorFileDoc === 'No file uploaded.'"
                                          class="text-muted">
                                        <i class="bi bi-paperclip"></i> No Attachment
                                    </span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Nearest Labour Office</label>
                                    <span>{{Sitemaster.NLabourOffice}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Nature</label>
                                    <span>{{Sitemaster.Nature}}</span>
                                </div>

                            </div>
                        </div>

                        <!-- CLRA -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">
                                Under Contract Labour (Regulation and Abolition) Act, 1970
                            </h3>

                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>Principle Employer Registration No.</label>
                                    <span>{{Sitemaster.PrincipalRegistration}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Issuing Authority</label>
                                    <span>{{Sitemaster.IssuingAuthority}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Max Contract Workers Allowed</label>
                                    <span>{{Sitemaster.CLRA_MaxWorkers}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>RC Copy</label>
                                    <span></span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Renewal RC</label>
                                    <span ng-if="Sitemaster.RenewalRCCopy && Sitemaster.RenewalRCCopy !== 'No file uploaded.'"
                                          class="d-inline-flex align-items-center gap-3">

                                        <a href="#"
                                           ng-click="DownloadFileC(Sitemaster.RenewalRCCopy, Sitemaster.RenewalRCCopy)"
                                           class="text-decoration-none">
                                            <i class="bi bi-download text-danger" style="font-size:18px;"></i>
                                        </a>

                                        <a ng-href="#"
                                           ng-click="ViewFileC(Sitemaster.RenewalRCCopy)"
                                           class="text-decoration-none">
                                            <i class="bi bi-eye-fill text-danger" style="font-size:18px;"></i>
                                        </a>

                                    </span>

                                    <!-- No File -->
                                    <span ng-if="!Sitemaster.RenewalRCCopy || Sitemaster.RenewalRCCopy === 'No file uploaded.'"
                                          class="text-muted">
                                        <i class="bi bi-paperclip"></i> No Attachment
                                    </span>
                                </div>


                                <div class="siteViewItem">
                                    <label>BOCW Registration</label>
                                    <span>{{Sitemaster.BOCW_Reg}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>BOCW Issuing Authority</label>
                                    <span>{{Sitemaster.BOCW_IssuingAuth}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>BOCW Max Workers</label>
                                    <span>{{Sitemaster.BOCW_MaxWorkers}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>BOCW Validity</label>
                                    <span>{{Sitemaster.BOCW_Validity}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>BOCW RC</label>
                                    <span ng-if="Sitemaster.BOCWRCCopy && Sitemaster.BOCWRCCopy !== 'No file uploaded.'"
                                          class="d-inline-flex align-items-center gap-3">

                                        <a href="#"
                                           ng-click="DownloadFileC(Sitemaster.BOCWRCCopy, Sitemaster.BOCWRCCopy)"
                                           class="text-decoration-none">
                                            <i class="bi bi-download text-danger" style="font-size:18px;"></i>
                                        </a>

                                        <a ng-href="#"
                                           ng-click="ViewFileC(Sitemaster.BOCWRCCopy)"
                                           class="text-decoration-none">
                                            <i class="bi bi-eye-fill text-danger" style="font-size:18px;"></i>
                                        </a>

                                    </span>

                                    <!-- No File -->
                                    <span ng-if="!Sitemaster.BOCWRCCopy || Sitemaster.BOCWRCCopy === 'No file uploaded.'"
                                          class="text-muted">
                                        <i class="bi bi-paperclip"></i> No Attachment
                                    </span>
                                </div>

                                <div class="siteViewItem">
                                    <label>BOCW Renewal</label>
                                    <span ng-if="Sitemaster.RenewalBOCWRCCopy && Sitemaster.RenewalBOCWRCCopy !== 'No file uploaded.'"
                                          class="d-inline-flex align-items-center gap-3">

                                        <a href="#"
                                           ng-click="DownloadFileC(Sitemaster.RenewalBOCWRCCopy, Sitemaster.RenewalBOCWRCCopy)"
                                           class="text-decoration-none">
                                            <i class="bi bi-download text-danger" style="font-size:18px;"></i>
                                        </a>

                                        <a ng-href="#"
                                           ng-click="ViewFileC(Sitemaster.RenewalBOCWRCCopy)"
                                           class="text-decoration-none">
                                            <i class="bi bi-eye-fill text-danger" style="font-size:18px;"></i>
                                        </a>

                                    </span>

                                    <!-- No File -->
                                    <span ng-if="!Sitemaster.RenewalBOCWRCCopy || Sitemaster.RenewalBOCWRCCopy === 'No file uploaded.'"
                                          class="text-muted">
                                        <i class="bi bi-paperclip"></i> No Attachment
                                    </span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Type of Contractor Allowed</label>
                                    <span>{{Sitemaster.VendorType}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Max Contractor Allowed</label>
                                    <span>{{Sitemaster.MaxContractors}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Max Workers at Site</label>
                                    <span>{{Sitemaster.MaxWorkersSite}}</span>
                                </div>


                            </div>
                        </div>

                        <!-- Safety -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">
                                Safety & Security Requirements
                            </h3>

                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>PPE Mandatory</label>
                                    <span>{{Sitemaster.PPEMandatory}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Types of PPE</label>
                                    <span>{{Sitemaster.PPEType}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Safety Training Required</label>
                                    <span>{{Sitemaster.SafetyTraining}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Site Induction Mandatory</label>
                                    <span>{{Sitemaster.SiteInduction}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Police Verification Required</label>
                                    <span>{{Sitemaster.PoliceVerification}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>ID Card Issuance Required</label>
                                    <span>{{Sitemaster.IDCardRequired}}</span>
                                </div>

                            </div>
                        </div>

                        <!-- Facility -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">Facility</h3>

                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>Drinking Water</label>
                                    <span>{{Sitemaster.Drinkingwater}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Washroom Facility</label>
                                    <span>{{Sitemaster.Washroom}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Rest Shelter</label>
                                    <span>{{Sitemaster.RestShelter}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>First Aid Kit</label>
                                    <span>{{Sitemaster.FirstAid}}</span>
                                </div>

                                <div class="siteViewItem">
                                    <label>Trainer Name</label>
                                    <span>{{Sitemaster.TrainerName}}</span>
                                </div>

                            </div>
                        </div>

                        <!-- Billing Order Details -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">Order Details</h3>
                            <!-- Data Available -->
                            <div ng-if="OrderDetails && OrderDetails.length > 0" ng-repeat="x in OrderDetails">
                                <h6 style="font-weight:600;color:var(--primary)">PO Detail {{$index + 1}}</h6>
                                <div class="siteViewGrid">
                                    <div class="siteViewItem">
                                        <label>Order Number</label>
                                        <span>{{x.OrderNumber || '-'}}</span>
                                    </div>

                                    <div class="siteViewItem">
                                        <label>Order Qty. (No. of ManPower)</label>
                                        <span>{{x.OrderQty || '-'}}</span>
                                    </div>

                                    <div class="siteViewItem">
                                        <label>Order Value</label>
                                        <span>{{x.OrderValue || '-'}}</span>
                                    </div>

                                    <div class="siteViewItem">
                                        <label>Order Validity Date From</label>
                                        <span>{{x.OrderValidityFrom || '-'}}</span>
                                    </div>

                                    <div class="siteViewItem">
                                        <label>Order Validity Date To</label>
                                        <span>{{x.OrderValidityTo || '-'}}</span>
                                    </div>

                                    <div class="siteViewItem">
                                        <label>Attach Order Copy</label>

                                        <span ng-if="x.OrderCopy" class="d-inline-flex align-items-center gap-3">
                                            <a href="#" ng-click="ViewFileC(x.OrderCopy,'Order Copy')" class="text-decoration-none">
                                                <i class="bi bi-eye-fill" style="font-size:18px;color:var(--primary);"></i>
                                            </a>

                                            <a href="#" ng-click="DownloadFileC(x.OrderCopy,'Order Copy')" class="text-decoration-none">
                                                <i class="bi bi-download" style="font-size:18px;color:var(--primary);"></i>
                                            </a>
                                        </span>

                                        <span ng-if="!x.OrderCopy" class="text-muted">
                                            <i class="bi bi-paperclip"></i> No Attachment
                                        </span>
                                    </div>

                                </div>

                            </div>

                            <!-- No Data -->
                            <div ng-if="!OrderDetails || OrderDetails.length == 0" class="text-center py-3">
                                <strong  style="color:var(--primary);">No Data Found</strong>
                            </div>
                        </div>


                        <h3 class="siteViewSectionTitle">License Details</h3>
                        <div ng-if="ContractorLicense && ContractorLicense.length > 0">
                            <div ng-repeat="s in ContractorLicense">
                                <h6 style="font-weight:600;color:var(--primary)">License {{$index + 1}}</h6>
                                <!-- License Details -->
                                <div class="siteViewSection">
                                    <div class="siteViewGrid">

                                        <div class="siteViewItem">
                                            <label>License Name</label>
                                            <span>{{s.LicenseName || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>License Status</label>
                                            <span>{{s.LicenseStatus || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>License Date</label>
                                            <span>{{s.LicenseDate || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>License Copy</label>
                                            <!-- File Available -->
                                            <span ng-if="s.LicenseCopy"
                                                  class="d-inline-flex align-items-center gap-3">
                                                <!-- View -->
                                                <a ng-href="#" ng-click="ViewFileC(s.LicenseCopy,'License Copy')"
                                                   class="text-decoration-none">
                                                    <i class="bi bi-eye-fill" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                                <!-- Download -->
                                                <a ng-href="#" ng-click="DownloadFileC(s.LicenseCopy,'License Copy')"
                                                   download
                                                   class="text-decoration-none">
                                                    <i class="bi bi-download" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                            </span>
                                            <!-- No File -->
                                            <span ng-if="!s.LicenseCopy"
                                                  class="text-muted">
                                                <i class="bi bi-paperclip"></i> No Attachment
                                            </span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Amendment Copy</label>
                                            <!-- File Available -->
                                            <span ng-if="s.AmendmentCopy"
                                                  class="d-inline-flex align-items-center gap-3">
                                                <!-- View -->
                                                <a ng-href="#" ng-click="ViewFileC(s.AmendmentCopy,'Amendment Copy')"
                                                   class="text-decoration-none">
                                                    <i class="bi bi-eye-fill" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                                <!-- Download -->
                                                <a ng-href="#" ng-click="DownloadFileWithName(s.AmendmentCopy,'Amendment Copy')"
                                                   download
                                                   class="text-decoration-none">
                                                    <i class="bi bi-download" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                            </span>
                                            <!-- No File -->
                                            <span ng-if="!s.AmendmentCopy"
                                                  class="text-muted">
                                                <i class="bi bi-paperclip"></i> No Attachment
                                            </span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>License Number</label>
                                            <span>{{s.LicenseNumber || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Validity Start Date</label>
                                            <span>{{s.LicenseValidFrom || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Validity End Date</label>
                                            <span>{{s.LicenseValidTo || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>License Cost</label>
                                            <span>{{s.LicenseCost || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Security Deposit Amount</label>
                                            <span>{{s.SecurityDepositAmt || '-'}}</span>
                                        </div>

                                    </div>
                                </div>

                                <!-- Application Details -->
                                <div class="siteViewSection" style="margin-top:10px;">
                                    <h4 class="siteViewSectionTitle" style="font-size:1.1rem !important;">Application Details</h4>

                                    <div class="siteViewGrid">

                                        <div class="siteViewItem">
                                            <label>Application Status</label>
                                            <span>{{s.ApplicationStatus || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Application Date</label>
                                            <span>{{s.ApplicationDate || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Application Copy</label>
                                            <span ng-if="x.ApplicationCopy"
                                                  class="d-inline-flex align-items-center gap-3">
                                                <!-- View -->
                                                <a ng-href="#" ng-click="ViewFileC(x.ApplicationCopy,'Application Copy')"
                                                   class="text-decoration-none">
                                                    <i class="bi bi-eye-fill" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                                <!-- Download -->
                                                <a ng-href="#" ng-click="DownloadFileC(x.ApplicationCopy,'Application Copy')"
                                                   download
                                                   class="text-decoration-none">
                                                    <i class="bi bi-download" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                            </span>
                                            <!-- No File -->
                                            <span ng-if="!x.ApplicationCopy"
                                                  class="text-muted">
                                                <i class="bi bi-paperclip"></i> No Attachment
                                            </span>
                                        </div>
                                        <div class="siteViewItem">
                                            <label>Challan Copy</label>
                                            <span ng-if="x.ChallanCopy"
                                                  class="d-inline-flex align-items-center gap-3">
                                                <!-- View -->
                                                <a ng-href="#" ng-click="ViewFileC(x.ChallanCopy,'Challan Copy')"
                                                   class="text-decoration-none">
                                                    <i class="bi bi-eye-fill" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                                <!-- Download -->
                                                <a ng-href="#" ng-click="DownloadFileC(x.ChallanCopy,'Challan Copy')"
                                                   download
                                                   class="text-decoration-none">
                                                    <i class="bi bi-download" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                            </span>
                                            <!-- No File -->
                                            <span ng-if="!x.ChallanCopy"
                                                  class="text-muted">
                                                <i class="bi bi-paperclip"></i> No Attachment
                                            </span>
                                        </div>
                                        <div class="siteViewItem">
                                            <label>Fees Copy</label>
                                            <span ng-if="x.FeesCopy"
                                                  class="d-inline-flex align-items-center gap-3">
                                                <!-- View -->
                                                <a ng-href="#" ng-click="ViewFileC(x.FeesCopy,'Fees Copy')"
                                                   class="text-decoration-none">
                                                    <i class="bi bi-eye-fill" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                                <!-- Download -->
                                                <a ng-href="#" ng-click="DownloadFileC(x.FeesCopy,'Fees Copy')"
                                                   download
                                                   class="text-decoration-none">
                                                    <i class="bi bi-download" style="font-size: 18px; color: var(--primary);"></i>
                                                </a>
                                            </span>
                                            <!-- No File -->
                                            <span ng-if="!x.FeesCopy"
                                                  class="text-muted">
                                                <i class="bi bi-paperclip"></i> No Attachment
                                            </span>
                                        </div>

                                    </div>
                                </div>

                                <!-- User Details -->
                                <div class="siteViewSection" style="margin-top:10px;">
                                    <h4 class="siteViewSectionTitle" style="font-size:1.1rem !important;">User Details</h4>
                                    <div class="siteViewGrid">
                                        <div class="siteViewItem">
                                            <label>Username</label>
                                            <span>{{s.Username || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem" hidden>
                                            <label>User Password</label>
                                            <span>{{s.Password || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Mobile Number</label>
                                            <span>{{s.MobileNo || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Email</label>
                                            <span>{{s.EmailId || '-'}}</span>
                                        </div>

                                        <div class="siteViewItem">
                                            <label>Remark</label>
                                            <span>{{s.Remarks || '-'}}</span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div ng-if="!ContractorLicense || ContractorLicense.length == 0" class="text-center py-3">
                            <strong  style="color:var(--primary);">No Data Found</strong>
                        </div>
                    </div>

                </div>


            </div>
        </div>
    </div>

    <!-- BILLING ORDER MODAL -->
    <div class="modal fade sitesOverviewModal"
         id="billingOrderModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Order Details</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="siteViewWrapper">

                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">Order Details</h3>

                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>Order Number</label>
                                    <input type="text"
                                           class="form-control"
                                           ng-model="OrderNumber">
                                </div>

                                <div class="siteViewItem">
                                    <label>Order Qty. (No. of ManPower)</label>
                                    <input type="number"
                                           class="form-control"
                                           ng-model="OrderQty">
                                </div>

                                <div class="siteViewItem">
                                    <label>Order Value</label>
                                    <input type="number"
                                           class="form-control"
                                           ng-model="OrderValue">
                                </div>

                                <div class="siteViewItem">
                                    <label>Order Validity Date From</label>
                                    <input type="date"
                                           class="form-control"
                                           ng-model="ValidFrom" id="txtvalidfrom">
                                </div>

                                <div class="siteViewItem">
                                    <label>Order Validity Date To</label>
                                    <input type="date"
                                           class="form-control"
                                           ng-model="ValidTo" id="txtvalidto">
                                </div>

                                <div class="siteViewItem">
                                    <label>Attach Order Copy</label>
                                    <input type="file" class="form-control"  onchange="angular.element(this).scope().uploadFile('AttachCopy', this)" ng-model="AttachCopy">
                                </div>

                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-cancel"
                            ng-click="AddOrder()" hidden>
                        <b><i class="bi bi-plus-lg"></i></b> Add
                    </button>

                    <button type="button"
                            class="btn btn-submit"
                            ng-click="SaveOrder(x.SiteId)">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- LICENSE MODAL -->
    <div class="modal fade sitesOverviewModal"
         id="licenseModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">License Modal</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <!-- Body -->
                <div class="modal-body">
                    <div class="siteViewWrapper">
                        <!-- License Details -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">License Details</h3>

                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>License Name</label>
                                    <input type="text" class="form-control validate" ng-model="LicenseName" />
                                </div>

                                <div class="siteViewItem">
                                    <label>License Status</label>
                                    <select class="form-select validate" ng-model="LicenseStatus">
                                        <option value="">Select Status</option>
                                        <option value="Issued">Issued</option>
                                        <option value="Not Issued">Not Issued</option>
                                    </select>
                                </div>

                                <div class="siteViewItem">
                                    <label>License Date </label>
                                    <input type="date" class="form-control" ng-model="LicenseDate" />
                                </div>
                                <div class="siteViewItem">
                                    <label>License Number</label>
                                    <input type="text" class="form-control" ng-model="LicenseNumber" />
                                </div>
                                <div class="siteViewItem">
                                    <label>Validity Start Date</label>
                                    <input type="date" class="form-control" ng-model="LicenseValidFrom" />
                                </div>

                                <div class="siteViewItem">
                                    <label>Validity End Date</label>
                                    <input type="date" class="form-control" ng-model="LicenseValidTo" />
                                </div>
                                <div class="siteViewItem">
                                    <label>License Cost</label>
                                    <input type="text" class="form-control" ng-model="LicenseCost" />
                                </div>

                                <div class="siteViewItem">
                                    <label>Security Deposit Amount</label>
                                    <input type="text" class="form-control" ng-model="SecurityDepositAmt" />
                                </div>
                                <div class="siteViewItem">
                                    <label>License Copy</label>
                                    <input type="file" class="form-control" onchange="angular.element(this).scope().uploadFile('LicenseCopy', this)" ng-model="LicenseCopy" />
                                </div>

                                <div class="siteViewItem">
                                    <label>Amendment Copy</label>
                                    <input type="file" class="form-control" onchange="angular.element(this).scope().uploadFile('AmendentCopy', this)" ng-model="AmendentCopy" />
                                </div>
                            </div>
                        </div>

                        <!-- Application Details -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">Application Details</h3>

                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>Application Status</label>
                                    <select class="form-select" ng-model="ApplicationStatus">
                                        <option value="">Select Status</option>
                                        <option value="Applied">Applied</option>
                                        <option value="Not Applied">Not Applied</option>
                                    </select>
                                </div>

                                <div class="siteViewItem">
                                    <label>Application Date</label>
                                    <input type="date" class="form-control" ng-model="ApplicationDate"/>
                                </div>

                                <div class="siteViewItem">
                                    <label>Application Copy</label>
                                    <input type="file" class="form-control" onchange="angular.element(this).scope().uploadFile('ApplicationCopy', this)" ng-model="ApplicationCopy"/>
                                </div>

                                <div class="siteViewItem">
                                    <label>Challan Copy</label>
                                    <input type="file" class="form-control" onchange="angular.element(this).scope().uploadFile('ChallanCopy', this)" ng-model="ChallanCopy" />
                                </div>

                                <div class="siteViewItem">
                                    <label>Fees Copy</label>
                                    <input type="file" class="form-control" onchange="angular.element(this).scope().uploadFile('FeesCopy', this)" ng-model="FeesCopy"/>
                                </div>

                            </div>
                        </div>

                        <!-- User Details -->
                        <div class="siteViewSection">
                            <h3 class="siteViewSectionTitle">User Details</h3>

                            <div class="siteViewGrid">

                                <div class="siteViewItem">
                                    <label>Username</label>
                                    <input type="text" class="form-control" ng-model="Username"/>
                                </div>

                                <div class="siteViewItem">
                                    <label>User Password</label>
                                    <input type="text" class="form-control" ng-model="Password"/>
                                </div>

                                <div class="siteViewItem">
                                    <label>Mobile Number</label>
                                    <input type="text" class="form-control" ng-model="MobileNo"/>
                                </div>

                                <div class="siteViewItem">
                                    <label>Email</label>
                                    <input type="text" class="form-control" ng-model="Emailid"/>
                                </div>

                                <div class="siteViewItem">
                                    <label>Remark</label>
                                    <textarea class="form-control" rows="3" ng-model="Remarks"></textarea>
                                </div>

                            </div>
                        </div>
                    </div>


                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal" hidden>
                        <b><i class="bi bi-plus-lg"></i></b> Add
                    </button>

                    <button type="button" class="btn btn-submit" ng-click="SaveLicense()">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>


</div>