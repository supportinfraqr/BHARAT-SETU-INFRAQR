
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Supplier Admin";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/Dashboards/SupplierAdmin/script.js"></script>
<link href="~/Dashboards/SupplierAdmin/style.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/scripts/RetailJsLib/VendorDashboardController.js"></script> 
<div class="supplierAdminPage px-4 py-2">
    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="Overview, Party, User, Site Management, Location Management or Site Mapping">
            @*<button type="button" class="btn btn-pill" data-target="#overview" aria-pressed="true">Overview</button>*@
            <button type="button" class="btn btn-pill active" data-target="#party" aria-pressed="true">Vendor</button>
            <button type="button" class="btn btn-pill" data-target="#user" aria-pressed="false">User</button>
            <button type="button" class="btn btn-pill" data-target="#siteManagement" aria-pressed="false">Site Management</button>
            @*<button type="button" class="btn btn-pill" data-target="#locationManagement" aria-pressed="false">Location Management</button>
            <button type="button" class="btn btn-pill" data-target="#siteMapping" aria-pressed="false">Site Mapping</button>*@
          <button type="button" class="btn btn-pill" data-target="#empCompDocs" aria-pressed="false" ng-show="loginType==5">Employee Compliance Docs</button> 
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">

        <!-- CARD 1 : Overview (default visible) -->
        @*<div id="overview" class="card section-card active adminOverview">
            <div class="card-body">



            </div>

        </div>*@


        <!-- CARD 2 : party -->
        <div id="party" class="card section-card active">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="mb-0">Party Management</h4> 
                <button type="button" class="btn btn-sm add-btn"  data-bs-toggle="modal" data-bs-target="#addPartyModal">
                    <i class="bi bi-plus me-1"></i> Add Party
                </button>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2">

                    <!-- Total License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total Vendor</div>
                        </div>
                        <div class="kpi-value">{{TotalVendor}}</div>
                    </div>

                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Active User</div>
                        </div>
                        <div class="kpi-value">{{ActiveUser}}</div>
                    </div>

                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Inactive User</div>
                        </div>
                        <div class="kpi-value">{{InactiveUser}}</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-3 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">
                                {{SelectedIndustry || 'Industry'}}
                            </button>

                            <ul class="dropdown-menu"> 
                                <li>
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="SelectIndustry('')">
                                        All
                                    </a>
                                </li> 
                                <li ng-repeat="item in NIndustryList">
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="SelectIndustry(item)">
                                        {{item}}
                                    </a>
                                </li> 
                            </ul>
                        </div>

                         

                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="scSearch"
                                       type="text"
                                       class="form-control form-control-sm"
                                       placeholder="Search..."
                                       ng-model="SearchText" />
                                <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="" ng-click="ExportVendorCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" href="" ng-click="PrintVendorList()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3" ng-init="PartySearch()">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Party Name</th>
                                    <th>Email</th>
                                    <th>Mobile</th>
                                    <th>Contact Person</th>
                                    <th>Industry</th>
                                    <th>UserLimit</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in FilteredVendorList | filter:SearchText">
                                    <td>{{x.SNO}}</td>
                                    <td>
                                        {{x.PartyName}}
                                    </td>
                                    <td>
                                        {{x.EmailId }}
                                    </td>
                                    <td>
                                        {{x.ContactNo }}
                                    </td>
                                    <td>
                                        {{x.ContactPerson }}
                                    </td>
                                    <td>
                                        {{x.IndustryName}}
                                    </td>
                                    <td>
                                        {{x.UserLimit}}
                                    </td>
                                    <td>{{x.IsActived}}</td>
                                    @*<td class="action-menu">
            <button class="btn btn-sm">
                Edit
            </button>
        </td>*@
                                </tr>


                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

        <!--  Add Party Modal -->
        <div class="modal fade supplierAdminModal"
             id="addPartyModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">
                        <h5 class="modal-title">Add Party</h5>
                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <div class="container-fluid">
                            <div class="row g-3">

                                <!-- Party Name -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Party Name </label>
                                    <input type="text" id="txtPartyName" class="form-control form-control-sm validate" ng-model="PartyName">
                                </div>

                                <!-- Address -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Address</label>
                                    <input id="txtAddress" type="text" class="form-control form-control-sm" ng-model="Address">
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Pincode</label>
                                    <input class="form-control form-control-sm" id="txtPincode" ng-model="Pincode" type="text" maxlength="6" onblur="validateNumberAndDecimalOnly('#txtPincode')">
                                </div>

                                <!-- Email -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Email Id </label>
                                    <input id="txtEmail" class="form-control form-control-sm validate" ng-model="EmailId" type="email" onblur="validateEmail('#txtEmail')" />

                                </div>

                                <!-- Contact No -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact No </label>
                                    <input id="txtContactNo" class="form-control form-control-sm validate" onblur="validatePhoneNo('#txtContactNo')" maxlength="10" placeholder="" ng-model="MobileNo" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />

                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact Person Name </label>
                                    <input type="text" id="txtContactPerson" class="form-control form-control-sm validate" ng-model="ContactPerson">
                                </div>

                                <!-- Contact Person Mobile -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact Person Mobile No.</label>
                                    <input type="text" id="txtContactMobile" class="form-control form-control-sm" onblur="validatePhoneNo('#txtContactMobile')" maxlength="10" placeholder="" ng-model="ContactMobile" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
                                </div> 
                                <!-- User Limit -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">User Limit </label>
                                    <input id="txtUserLimit" type="text" ng-model="UserLimit" onblur="validateNumberAndDecimalOnly('#txtUserLimit')"
                                           class="form-control form-control-sm text-right clear validate" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                </div>

                                <!-- Valid Date -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Valid Date</label>
                                    <input type="date" id="txtValidTo" class="form-control form-control-sm" ng-model="ValidTo">

                                </div>

                                <!-- Industry -->
                                <div class="col-lg-3 col-md-4 col-sm-6" ng-init="AllIndustry()">
                                    <label class="form-label">Industry </label>
                                    <select id="ddlIndustry" autocomplete='address-level2' class="form-select form-select-sm validate" ng-model="NIndustryId">
                                        <option value="">Select Industry</option>
                                        <option ng-repeat="x in IndustryList" value="{{x.Id}}">{{x.Industry}}</option>
                                    </select>
                                </div>

                                <!-- Description -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Description</label>
                                    <input id="txtDescritpion" type="text" class="form-control form-control-sm" ng-model="Descritpion">
                                </div>

                                <!-- Is Active -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Is Active</label> 
                                <select id="ddlIsActive" ng-init = "IsActive='True'" class="form-select form-select-sm" ng-model="IsActive">
                                    <option value="">Select</option>
                                    <option value="True">Yes</option>
                                    <option value="False">No</option> 
                                </select>
                                    
                                </div>

                                <!-- Month Expired -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Month Expired</label>
                                    <select id="ddlMonthExpired" class="form-select form-select-sm" ng-model="MonthExpired">
                                        <option value="">Select</option>
                                        <option value="1">1 Month</option>
                                        <option value="2">2 Month</option>
                                        <option value="3">3 Month</option>
                                        <option value="4">4 Month</option>
                                        <option value="5">5 Month</option>
                                        <option value="6">6 Month</option>
                                        <option value="7">7 Month</option>
                                        <option value="8">8 Month</option>
                                        <option value="9">9 Month</option>
                                        <option value="10">10 Month</option>
                                        <option value="11">11Month</option>
                                        <option value="12">12 Month</option>

                                    </select>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer">
                        <button type="button" id="btnCancel"
                                class="btn btn-sm cancel-btn"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button" ng-click="AddParty()"  class="btn btn-sm save-btn">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>



        <!-- CARD 3 : user -->
        <div id="user" class="card section-card d-none">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="mb-0">User Management</h4>
                <button type="button" class="btn btn-sm add-btn" data-bs-toggle="modal" data-bs-target="#addUserModal">
                    <i class="bi bi-plus me-1"></i> Add User
                </button>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2">

                    <!-- Total License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total User</div>
                        </div>
                        <div class="kpi-value">{{TotalUserLimit || 0}}</div>
                    </div>

                    <!-- Expiring Soon License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Used</div>
                        </div>
                        <div class="kpi-value">{{(UsedUsers || 0) }}</div>
                    </div>

                    <!-- Expired -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Left</div>
                        </div>
                        <div class="kpi-value">{{RemainingUsers||0}}</div>
                    </div>

                </div>
            </div>

            <div class="card-body p-3 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">
                                {{ SelectedPartyName || 'Vendor UserList' }}
                            </button>

                            <ul class="dropdown-menu">

                                <!-- All Option -->
                                <li>
                                    <a class="dropdown-item" href="" ng-click="SelectPartyAll()">
                                        All
                                    </a>
                                </li>

                                <li ng-repeat="x in EmployeeList">
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="SelectParty(x)">
                                        {{ x.PartyName }}
                                    </a>
                                </li>

                            </ul>
                        </div>



                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       class="form-control form-control-sm"
                                       placeholder="Search..."
                                       ng-model="searchText" />

                                <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="" ng-click="ExportUserCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" href="" ng-click="PrintUserList()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 rounded-3" ng-init="UserList()">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>UserName</th>
                                    <th>Party Name</th>
                                    <th>EmailId</th>
                                    <th>Contact No</th>
                                    <th>Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in EmployeeList
               | filter:(SelectedPartyId ? {PartyId: SelectedPartyId} : '')
               | filter:searchText">

                                    <td>{{x.Id}}</td>
                                    <td>
                                        {{x.UserName}}
                                    </td>
                                    <td>{{x.PartyName}}</td>

                                    <td>
                                        {{x.EmailId}}
                                    </td>
                                    <td>
                                        {{x.ContactNo}}
                                    </td>
                                    <td>      {{ x.LoginType == 5 ? 'Admin' : 'User' }}</td>

                                    @*<td class="action-menu">
            <button class="btn btn-sm">
                Edit
            </button>
        </td>*@
                                </tr>


                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <!--  Add User Modal -->
        <div class="modal fade supplierAdminModal"
             id="addUserModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">
                        <h5 class="modal-title">Add User</h5>
                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <div class="container-fluid">
                            <div class="row g-3">


                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Party Name</label>
                                  <select ng-model="PPId" id="ddlPPId" class="form-control" >
                                      <option value="">Select</option>
                                      <option ng-repeat="x in VendorList" value="{{x.PartyId}}">{{x.PartyName}}</option>
                                  </select>
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Name</label>
                                    <input type="text" id="txtUName" class="form-control" ng-model="UName">
                                </div>

                                <!-- User Name -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">User Name </label>
                                    <input type="text" id="txtUserNames"
                                           class="form-control"
                                           ng-model="UserNames"
                                           oninput="this.value = this.value.replace(/[^A-Za-z]/g,'')">
                                </div>

                                <!-- Password -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Password</label>
                                    <input type="text" id="txtPassword"
                                           class="form-control"
                                           ng-model="Password"
                                           oninput="this.value = this.value.replace(/\s/g,'')">
                                </div>

                                <!-- Contact No. -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact No.</label>
                                    <input id="txtContactNo" class="form-control" onblur="validatePhoneNo('#txtContactNumber')" maxlength="10" placeholder="" ng-model="ContactNumber" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                    
                                </div>

                                <!-- Email ID -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Email ID</label>
                                    <input ng-model="UserEmail" id="txtUserEmail" class="form-control">
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-sm cancel-btn"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-sm save-btn"  ng-click="SaveUser()">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>



        <!-- CARD 4 : Site Management -->
        <div id="siteManagement" class="card section-card d-none">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="mb-0">Site Management</h4>
                <button type="button" class="btn btn-sm add-btn" data-bs-toggle="modal" data-bs-target="#addSiteModal">
                    <i class="bi bi-plus me-1"></i> Add Site
                </button>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2">

                    <!-- Total License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total Vendor</div>
                        </div>
                        <div class="kpi-value">{{TotalVendor||0}}</div>
                    </div>

                    <!-- Expiring Soon License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total Site</div> 
                        </div>
                        <div class="kpi-value">{{TotalSite||0}}</div>
                    </div>
                  
                   
                </div>
            </div>

            <div class="card-body p-3 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                     

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="scSearch" type="text" class="form-control form-control-sm" ng-model="SiteSearch" placeholder="Search..." />
                                <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="" ng-click="ExportSiteCSV()">CSV</a></li> 
                                    <li><a class="dropdown-item" href="" ng-click="PrintSiteList()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 rounded-3" ng-init="BindVendorSiteList()">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Party Name</th>
                                    <th>Site Name</th>

                                    <th>Email Id</th>
                                    <th>Contact No</th>
                                    <th>Address</th>
                                    <th>Action</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in VendorSiteList  | filter:SiteSearch"> 
                                    <td>
                                        {{x.SNo}}
                                    </td>
                                    <td>
                                        {{x.PartyName}}
                                    </td>
                                    <td>
                                        {{x.SiteName}}
                                    </td>

                                    <td>
                                        {{x.EmailId}}
                                    </td>
                                   
                                    <td>
                                        {{x.ContactNo}}
                                    </td>
                                    <td>
                                        {{x.Address}}
                                    </td>
                                    <td class="action-menu"> 
                                        <button class="btn btn-danger btn-sm"
                                                ng-click="DeleteVendorSite(x.deleteid)">
                                            Delete
                                        </button> 
                                    </td>
                                </tr>


                            </tbody>
                        </table>
                    </div>

                </div>

            </div>
        </div>

        <!--  Add Site Modal -->
        <div class="modal fade supplierAdminModal"
             id="addSiteModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">
                        <h5 class="modal-title">Add Site</h5>
                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <div class="container-fluid">

                            <!-- ===================== 1. SITE / LOCATION ===================== -->
                            <div class="form-section">
                                <div class="section-title">Site / Location Details</div>

                                <div class="row g-3">

                                    <!-- Vendor Name -->
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Vendor Name</label>
                                        <div class="dropdown custom-dropdown">
                                            <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                Select Vendor
                                            </button>

                                            <ul class="dropdown-menu p-2">
                                                <li>
                                                    <input type="checkbox" ng-model="IsAllSelected" ng-change="SelectAll()"> <b>Select All</b>
                                                </li>

                                                <li ng-repeat="x in VendorList">
                                                    <input type="checkbox" ng-model="x.Selected" ng-change="UpdateSelection()"> {{x.PartyName}}
                                                </li>
                                            </ul>
                                        </div>
                                    </div>

                                    <!-- Site Code (NEW) -->
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Site Code</label>
                                        <input type="text" class="form-control form-control-sm">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Site Name</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="SiteName">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Location Name</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="LocationCode">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Manpower Count</label>
                                        <input type="text" class="form-control form-control-sm text-right" ng-model="ManPowerCount"
                                               onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Site Address</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="SiteAddress">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Pincode</label>
                                        <input class="form-control form-control-sm" ng-model="Pincode" maxlength="6"
                                               onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6" ng-init="AllCountry()">
                                        <label class="form-label">Country</label>
                                        <select class="form-select form-select-sm" ng-change="AllState()" ng-model="CountryId">
                                            <option value="">Select Country</option>
                                            <option ng-repeat="x in AllCountryList" value="{{x.CountryId}}">{{x.CountryName}}</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">State</label>
                                        <select class="form-select form-select-sm" ng-change="AllCity()" ng-model="StateId">
                                            <option value="">Select State</option>
                                            <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">{{x.STATE_NM}}</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">City</label>
                                        <select class="form-select form-select-sm" ng-model="CityId">
                                            <option value="">Select City</option>
                                            <option ng-repeat="x in AllCityList" value="{{x.CITY_CODE}}">{{x.CITY_NAME}}</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">CLRA RC</label>
                                        <select class="form-select form-select-sm" ng-model="CLRARC">
                                            <option value="">Select</option>
                                            <option value="1">Yes</option>
                                            <option value="0">No</option>
                                        </select>
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Contact No</label>
                                        <input class="form-control form-control-sm" ng-model="MobileNo" maxlength="10"
                                               onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Contact Person Name</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="ContactPerson">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Contact Person Mobile</label>
                                        <input class="form-control form-control-sm" ng-model="ContactMobile" maxlength="10"
                                               onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Email</label>
                                        <input type="email" class="form-control form-control-sm" ng-model="EmailId">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">PAN No.</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="Panitno">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">GSTIN/UIN</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="Gstinuin">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Description</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="Descritpion">
                                    </div>
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Valid From</label>
                                        <input type="date" class="form-control form-control-sm" ng-model="ValidFrom">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Valid To</label>
                                        <input type="date" class="form-control form-control-sm" ng-model="ValidTo">
                                    </div>
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Upload Document (PDF)</label>
                                        <input type="file" class="form-control form-control-sm"
                                               onchange="angular.element(this).scope().Vendorshow(this)">
                                    </div>

                                    <!-- Nearest Labour Office -->
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Nearest Labour Office</label>
                                        <input type="text" class="form-control form-control-sm">
                                    </div>

                                    <!-- Nature of Site (Static Dropdown with Select All) -->
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Nature of Site</label>

                                        <div class="dropdown custom-dropdown">
                                            <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                Select Nature
                                            </button>

                                            <ul class="dropdown-menu p-2">
                                                <li>
                                                    <input type="checkbox"> <b>Select All</b>
                                                </li>
                                                <li><input type="checkbox"> Factory</li>
                                                <li><input type="checkbox"> Corporate Office</li>
                                                <li><input type="checkbox"> Warehouse</li>
                                                <li><input type="checkbox"> Project Site</li>
                                                <li><input type="checkbox"> Others</li>

                                            </ul>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- ===================== 2. CLRA ===================== -->
                            <div class="form-section">
                                <div class="section-title">Under Contract Labour (Regulation and Abolition) Act, 1970</div>

                                <div class="row g-3">

                                    <!-- CLRA RC -->
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Principal Employer Registration Number</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="CLRA_RegNo">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Issuing Authority</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="CLRA_IssuingAuth">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Max Contract Workers Allowed</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="CLRA_MaxWorkers">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Validity</label>
                                        <input type="date" class="form-control form-control-sm" ng-model="CLRA_Validity">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Upload RC Copy</label>
                                        <input type="file" class="form-control form-control-sm">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Upload Renewal RC</label>
                                        <input type="file" class="form-control form-control-sm">
                                    </div>

                                    <!-- BOCW -->
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">BOCW Registration</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="BOCW_Reg">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">BOCW Issuing Authority</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="BOCW_IssuingAuth">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">BOCW Max Workers</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="BOCW_MaxWorkers">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">BOCW Validity</label>
                                        <input type="date" class="form-control form-control-sm" ng-model="BOCW_Validity">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Upload BOCW RC</label>
                                        <input type="file" class="form-control form-control-sm">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Upload BOCW Renewal</label>
                                        <input type="file" class="form-control form-control-sm">
                                    </div>

                                    <!-- Types of Vendors Allowed (Static Dropdown) -->
                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Types of Vendors Allowed</label>

                                        <div class="dropdown custom-dropdown">
                                            <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                Select Vendor Type
                                            </button>
                                            <ul class="dropdown-menu p-2">
                                                <li>
                                                    <input type="checkbox"> <b>Select All</b>
                                                </li>
                                                <li><input type="checkbox"> Manpower Supply</li>
                                                <li><input type="checkbox"> Security Services</li>
                                                <li><input type="checkbox"> Housekeeping</li>
                                                <li><input type="checkbox"> Facility Management</li>
                                                <li><input type="checkbox"> Technical Services</li>
                                                <li><input type="checkbox"> Others Services</li>

                                            </ul>
                                        </div>
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Max Contractors Allowed</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="MaxContractors">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Max Workers at Site</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="MaxWorkersSite">
                                    </div>

                                </div>
                            </div>

                            <!-- ===================== 3. SAFETY ===================== -->
                            <div class="form-section">
                                <div class="section-title">Safety & Security Requirements</div>

                                <div class="row g-3">

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">PPE Mandatory</label><br>
                                        <input type="radio" ng-model="PPEMandatory" value="1"> Yes
                                        <input type="radio" ng-model="PPEMandatory" value="0"> No
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Types of PPE</label>
                                        <input type="text" class="form-control form-control-sm" ng-model="PPEType">
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Safety Training Required</label><br>
                                        <input type="radio" ng-model="SafetyTraining" value="1"> Yes
                                        <input type="radio" ng-model="SafetyTraining" value="0"> No
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Site Induction Mandatory</label><br>
                                        <input type="radio" ng-model="SiteInduction" value="1"> Yes
                                        <input type="radio" ng-model="SiteInduction" value="0"> No
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">Police Verification Required</label><br>
                                        <input type="radio" ng-model="PoliceVerification" value="1"> Yes
                                        <input type="radio" ng-model="PoliceVerification" value="0"> No
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6">
                                        <label class="form-label">ID Card Issuance Required</label><br>
                                        <input type="radio" ng-model="IDCardRequired" value="1"> Yes
                                        <input type="radio" ng-model="IDCardRequired" value="0"> No
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-sm cancel-btn"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-sm save-btn" ng-click="AfterSave()">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>


        <!-- CARD 5 : Employee Compliance Docs -->
         
            <div id="empCompDocs" class="card section-card d-none">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="mb-0">Employee Management</h4>
                    <button type="button" class="btn btn-sm add-btn" data-bs-toggle="modal" data-bs-target="#addDocumentempModal" ng-show="loginType==4">
                        <i class="bi bi-plus me-1"></i> Add Document
                    </button>
                </div>

                <!-- KPI Bar  -->
                <div class="container mb-4">
                    <div class="kpi-row d-flex gap-2">

                        <!-- Total License -->
                        <div class="kpi-card">
                            <div>
                                <div class="kpi-title">Total Document</div>
                            </div>
                            <div class="kpi-value">{{EmpDocumentList.length ||0}}</div>
                        </div>

                        <!-- Expiring Soon License -->
                        <div class="kpi-card">
                            <div>
                                <div class="kpi-title">Total Vendor</div>
                            </div>
                            <div class="kpi-value">{{EVendorList.length || 0}}</div>
                        </div>

                        <!-- Expired -->

                    </div>
                </div>

                <div class="card-body p-3 d-flex flex-column">

                    <!-- Toolbar -->
                    <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                        <div class="d-flex align-items-center gap-2">
                            <div class="dropdown" ng-init="BindVendorListList()">

                                <select class="btn btn-sm export-btn dropdown-toggle"
                                        ng-model="SelectedVendorId"
                                        ng-change="BindEmpDocumentList()"
                                        ng-options="x.PartyId as x.PartyName for x in EVendorList">

                                    <option value="">Select</option>
                                </select>
                            </div>

                            <button type="button"
                                    class="btn btn-sm save-btn" ng-click="SaveVendorDocumentMapping()">
                                Save
                            </button>

                        </div>

                        <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                            <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                                <div class="input-group input-group-sm">
                                    <input id="scSearch" type="text" class="form-control form-control-sm" ng-model="empSiteSearch" placeholder="Search..." />
                                    <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 justify-content-center">
                                <div class="dropdown">
                                    <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="" ng-click="PrintemployeedocList()">Print</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Table wrapper -->
                    <div class="small-table-wrapper flex-grow-1 rounded-3" ng-init="BindEmpDocumentList()">
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 small-table">
                                <thead>
                                    <tr>
                                        <th>✔ Check All<input type="checkbox" ng-model="checkAll" ng-change="toggleAll()" /></th>
                                        <th>S.No</th>
                                        <th>Document Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in EmpDocumentList | filter:empSiteSearch">


                                        <td>
                                            <input type="checkbox" ng-model="x.IsCheck" />
                                        </td>
                                        <td>{{$index+1}}</td>
                                        <td>{{x.DocumentName}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                  
                    
                </div>
            </div>

            <div class="modal fade supplierAdminModal"
                 id="addDocumentempModal"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-x modal-dialog-centered">
                    <div class="modal-content">

                        <!-- Header -->
                        <div class="modal-header">
                            <h5 class="modal-title">Add Document</h5>
                            <button type="button"
                                    class="btn-close btn-close-white"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>

                        <!-- Body -->
                        <div class="modal-body">
                            <div class="container-fluid">
                                <div class="row g-12"> 
                                    <div class="col-lg-12 col-md-4 col-sm-6">
                                        <label class="form-label">Document Name </label>
                                        <input id="txtDocumentName" type="text" class="form-control form-control-sm" ng-model="DocumentName">
                                    </div> 

                                </div>

                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-sm cancel-btn"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="button"
                                    class="btn btn-sm save-btn" ng-click="Saveempdoc()">
                                Save
                            </button>
                        </div>

                    </div>
                </div>
            </div>

    </div>
</div>


