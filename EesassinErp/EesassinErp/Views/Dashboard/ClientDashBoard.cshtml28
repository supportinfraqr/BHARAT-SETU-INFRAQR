
@{
    ViewBag.Title = "DashBoard";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<!-- Load Simple DataTables Stylesheet-->
<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet" />
<link href="~/Content/css/auditor-dashboard/styles.css" rel="stylesheet" />
<link href="~/Content/css/client-dashboard/main.css" rel="stylesheet" />
<link href="~/Content/css/auditor-dashboard/font-awesome.min.css" rel="stylesheet" />
<!-- c3 CSS
============================================ -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/c3/0.4.10/c3.min.css">
<!-- morrisjs CSS
============================================ -->
<link href="~/Content/css/auditor-dashboard/morrisjs/morris.css" rel="stylesheet" />
<!-- animate CSS
============================================ -->
<link href="~/Content/css/auditor-dashboard/animate.css" rel="stylesheet" />
<!-- Bootstrap CSS -->
<link href="~/Content/css/auditor-dashboard/bootstrap.min.css" rel="stylesheet" />


<style>
    .c3-arc-Completed-Documents {
        fill: #6dbaf0 !important;
    }

    .c3-arc.target-Pending-Documentes,
    .custom-legend-color.is-neutral {
        fill: #ffa197 !important;
    }

    .c3-arc.c3-target-Sent-Documents,
    .custom-legend-color.is-bad {
        fill: #46c9b7 !important;
    }
    .client-header {
        background: #6200ea;
        padding: 10px 10px;
        color: #fff;
    }
    .profile-bg {
        background-image: url('../../Content/img/profile-bg.png');
        padding: 10px 10px;
        color: #fff;
        background-size: 220%;
    }
    .profile-row {
       margin-bottom:40px;
    }
    .profile-heading {
        font-size: 18px;
        margin-top: 30px;
    }
    .edit-icon {
        font-size: var(--pro-font-size) !important;
        top: 20px;
        position: absolute;
        right: 20px;
        color:#000;
    }
    .fa-star {
        color: #ebae4d;
    }
    .product-status-wrap tr {
        background: #6200ea;
    }
    .product-status-wrap tr th {
        color: #fff;
    }
</style>
<div class="container-fluid">
    <h3 style="font-weight: bold;">Client Dashboard</h3>
    <div class="row">
        <div class="col-lg-8 stretch-card">
            <div class="card w-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center client-header">
                        <div class="mb-4">
                            <h4 class="card-title mb-0">Invoice Compliance</h4>
                            <div class="card-subtitle">Compared to previous year</div>
                        </div>
                        <div class="d-flex gap-2">
                            <select class="form-control-sm p-0">
                                <option value="pt_1">All Vendors</option>
                                <option value="pt_1">Vendor Test</option>
                            </select>
                        </div>
                    </div>
                    <div class="invoice-chart-info">
                        <div class="d-flex flex-wrap align-items-center">
                            <div class="h5 text-muted pr-1">Overall Compliance:</div>
                            <div class="h4">&#8377;00,000</div>
                            <div class="px-2">|</div>
                            <div class="h5 text-muted pr-1">Vendor Completed invoice</div>
                            <div class="h4 ng-binding">2</div>
                            <div class="px-2">|</div>
                            <div class="h5 text-muted pr-1">Goal</div>
                            <div class="h4">119%</div>
                        </div>
                    </div>
                    <canvas id="dashboardBarChart" width="1019" height="415" style="display: block; box-sizing: border-box; width: 815.719px; height: 332px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 stretch-card">
            <div class="card w-100">
                <div class="card-body">
                    <div class="single-review-st-item res-mg-t-30 table-mg-t-pro-n profile-bg">
                        <div class="single-review-st-text">
                            <img src="/Content/img/vendor/profile.jpg">
                            <div class="review-ctn-hf w100" style="width:100%;">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="profile-heading">Anonymous</span>
                                    <span class="pull-right edit-icon">
                                        <i class="fa fa-pencil profile-icon-size"></i>
                                    </span>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="row profile-row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <p class="profile-chart-name">Document Expiry</p>
                            <table class="ttable w100">
                                <thead class="thead">
                                    <tr>
                                        <th>Sr. No.</th>
                                        <th>Document Name</th>
                                        <th>Expiry Date</th>
                                    </tr>
                                </thead>
                                <tbody class="tbody">
                                    <tr>
                                        <td>1</td>
                                        <td>Vendor Invoice</td>
                                        <td>08/01/2023</td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>Vendor Invoice</td>
                                        <td>08/01/2023</td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>Vendor Invoice</td>
                                        <td>08/01/2023</td>
                                    </tr>
                                    <tr>
                                        <td>4</td>
                                        <td>Vendor Invoice</td>
                                        <td>08/01/2023</td>
                                    </tr>
                                    <tr>
                                        <td>5</td>
                                        <td>Vendor Invoice</td>
                                        <td>08/01/2023</td>
                                    </tr>
                                    <tr>
                                        <td>6</td>
                                        <td>Vendor Invoice</td>
                                        <td>08/01/2023</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- <hr class="name-of-your-vertical-line"/> -->
                    </div>
                    <button type="button" class="btn w100 pro-btton-color">
                        Upload Documents
                    </button>
                </div>
            </div>

        </div>
    </div>

    <div class="col-lg-12 card pb-5 mb-5 mt-5">
        <h3 style="font-weight:bold;">Compliance Report</h3>
        <div class="d-flex gap-2" ng-init="BindVendor();">
            <div class="col-lg-3">
                <select style="font-size: 12px;border-radius: 5px; width:100%;" class="form-control h-100">
                    <option value="" style="font-size: 12px;" selected="selected">All Vendor</option>
                    <!-- ngRepeat: x in VendorList -->
                    <option value="1" class="ng-binding ng-scope">vendor1</option><!-- end ngRepeat: x in VendorList -->
                    <option value="5" class="ng-binding ng-scope">hyndai</option><!-- end ngRepeat: x in VendorList -->
                </select>
            </div>
            <div class="col-lg-3">
                <select style="font-size: 12px; border-radius: 5px; width: 100%;" class="form-control h-100">
                    <option value="" style="font-size: 12px;" selected="selected">All Auditor</option>
                    <!-- ngRepeat: xx in AuditorList -->
                    <option value="3" class="ng-binding ng-scope">auditor1</option><!-- end ngRepeat: xx in AuditorList -->
                    <option value="6" class="ng-binding ng-scope">manoj</option><!-- end ngRepeat: xx in AuditorList -->
                </select>
            </div>
            <div class="col-lg-3">
                <input id="txtInvoice" class="form-control h-100" placeholder="Enter Invoice No">
            </div>
            <div class="col-lg-3">
                <button type="button" class="btn pro-btton-color">
                    Generate Report
                </button>
            </div>
        </div>

    </div>

        <!-- =============================== 2 ============================ -->
        <!-- <div class="clear" style="margin-top: 3%;"></div> -->
        <div class="row box-show">
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 stretch-card">
                <div class="card w-100 invoice-box">
                    <div class="card-body">
                        <div class="pull-right position-relative">
                            <div id="g5" class="chart-area"></div>
                        </div>
                        <div>
                            <h4 class="mb-1 mt-1">New Invoice</h4>
                            <p class="text-muted mb-0">Counts: 0</p>
                        </div>
                        <p class="text-muted mb-0">
                            Amount: <i class="fa fa-rupee"></i> 400
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 stretch-card">
                <div class="card w-100 invoice-box">
                    <div class="card-body">
                        <div class="pull-right position-relative">
                            <div id="g6" class="chart-area"></div>
                        </div>
                        <div>
                            <h4 class="mb-1 mt-1">Pending Invoice</h4>
                            <p class="text-muted mb-0">Counts: 0</p>
                        </div>
                        <p class="text-muted mb-0">
                            Amount: <i class="fa fa-rupee"></i> 300
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 stretch-card">
                <div class="card w-100 invoice-box">
                    <div class="card-body">
                        <div class="pull-right position-relative">
                            <div id="g3" class="chart-area"></div>
                        </div>
                        <div>
                            <h4 class="mb-1 mt-1">Validate Invoice</h4>
                            <p class="text-muted mb-0">Counts: 0</p>
                        </div>
                        <p class="text-muted mb-0">
                            Amount: <i class="fa fa-rupee"></i> 200
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 stretch-card">
                <div class="card w-100 invoice-box">
                    <div class="card-body">
                        <div class="pull-right position-relative">
                            <div id="g4" class="chart-area"></div>
                        </div>
                        <div>
                            <h4 class="mb-1 mt-1">Complete Invoice</h4>
                            <p class="text-muted mb-0">Counts: 0</p>
                        </div>
                        <p class="text-muted mb-0">
                            Amount: <i class="fa fa-rupee"></i> 100
                        </p>
                    </div>
                </div>
            </div>
        </div>



        <!-- ================================ 5 ============================== -->
