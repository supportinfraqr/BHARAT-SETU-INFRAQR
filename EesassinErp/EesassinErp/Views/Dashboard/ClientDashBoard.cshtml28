        <div class="pro_comp_bg row">




            <div class="card card-raised" style="padding: 0;">
                <div class="card-header bg-transparent px-4" style="background-color:#6200eb!important;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-4">
                            <h2 class="card-title mb-0" style="color: #fff;font-size: 20px;margin: 10px 0;">Auditor Compliance Summary</h2>
                            <div class="card-subtitle" style="color: #fff;margin: 5px 0;font-size: 12px;">Details and history</div>
                        </div>
                        <div class="d-flex gap-2">
                            <i class="fa fa-download" style="color: #fff;font-size: 15px;margin: 0 15px 0px 0px;"></i>
                            <i class="fa fa-print" style="color: #fff;font-size: 15px;margin: 0 15px 0px 0px;"></i>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
