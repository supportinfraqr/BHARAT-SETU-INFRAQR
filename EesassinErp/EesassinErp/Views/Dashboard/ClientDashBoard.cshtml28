        <div class="pro_comp_bg row">
            <h3 class="profile-chart-name text-left">Work in Progress</h3>
            <div class="product-status mg-b-15">
                <div class="container-fluid" ng-init="BindDashBoardInvoice()">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12
                                col-xs-12 p-0">
                            <div class="product-status-wrap">
                                <div class="asset-inner m15">
                                    <table>
                                        <tr>
                                            <th>#</th>
                                            <th>Invoice no.</th>
                                            <th>Vendor Name</th>
                                            <th>Status</th>
                                            <th>Progress</th>
                                        </tr>
                                        <tr ng-repeat="x in DashBoardInvoice">
                                            <td>{{x.SNO}}</td>
                                            <td>{{x.VendorInvNum}}</td>
                                            <td>{{x.VendorName}}</td>
                                            <td>
                                                <div class="table-box-style table-box-col">{{x.Status}}</div>



                                            </td>
                                            <td style="text-align: center;">
                                                <span class="text-success">100%</span>
