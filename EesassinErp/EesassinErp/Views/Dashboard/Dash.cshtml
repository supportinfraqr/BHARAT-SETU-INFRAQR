    <script>
        const overviewBtn = document.getElementById("overviewBtn");
        const usersBtn = document.getElementById("usersBtn");
        const billingBtn = document.getElementById("billingBtn");

        const overviewSection = document.getElementById("overviewSection");
        const usersSection = document.getElementById("usersSection");
        const billingSection = document.getElementById("billingSection");

        function resetButtons() {
            document.querySelectorAll(".toggle-container button")
                .forEach(btn => btn.classList.remove("active"));
        }

        function hideAllSections() {
            overviewSection.classList.add("d-none");
            usersSection.classList.add("d-none");
            billingSection.classList.add("d-none");
        }

        // DEFAULT LOAD
        hideAllSections();
        overviewSection.classList.remove("d-none");

        // OVERVIEW
        overviewBtn.addEventListener("click", () => {
            resetButtons();
            hideAllSections();
            overviewBtn.classList.add("active");
            overviewSection.classList.remove("d-none");
        });

        // USERS
        usersBtn.addEventListener("click", () => {
            resetButtons();
            hideAllSections();
            usersBtn.classList.add("active");
            usersSection.classList.remove("d-none");
        });

        // BILLING
        billingBtn.addEventListener("click", () => {
            resetButtons();
            hideAllSections();
            billingBtn.classList.add("active");
            billingSection.classList.remove("d-none");
        });
 
    </script>

 
