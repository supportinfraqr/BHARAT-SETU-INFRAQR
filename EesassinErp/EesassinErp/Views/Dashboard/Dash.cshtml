
@{
    ViewBag.Title = "Dash";
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}

<script src="~/scripts/RetailJsLib/AdminDashboardcontroller.js"></script>
 
    <style>
        body::-webkit-scrollbar {
            display: none;
        }

        /* ===================== USER PROFILE PAGE ===================== */
        .userProfile {
            font-family: "Inter", sans-serif;
            --primary: #E45D27; /* theme accent */
            --primary-dark: #c44b1d;
            --card-bg: #FEF3EC;
            background: #FFF1EB;
            color: #223;
            padding-bottom: 3rem;
            min-height: 100vh;
        }

        .dropdown-menu {
            min-width: 120px;
            font-size: 0.85rem;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

        /* ----- HEADER SECTION ----- */
        .userProfile .profile-header {
            background: linear-gradient(90deg, #FD670B, #FF8745);
            color: #fff;
            padding: 2rem 1.5rem;
            border-radius: 12px 12px 12px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .userProfile .profile-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

            .userProfile .profile-left img {
                width: 90px;
                height: 90px;
                border-radius: 50%;
                border: 3px solid #fff;
                object-fit: cover;
            }

            .userProfile .profile-left .profile-info h4 {
                font-weight: 600;
                margin: 0;
            }

        .userProfile .admin-badge {
            background-color: #fff;
            color: #FD670B;
            font-size: 0.8rem;
            font-weight: 500;
            border-radius: 20px;
            padding: 0.2rem 0.75rem;
            margin-left: 0.5rem;
            display: inline-block;
        }

        .userProfile .profile-left .info-list {
            font-size: 0.9rem;
            margin-top: 0.5rem;
        }

        .userProfile .info-list i {
            margin-right: 0.5rem;
        }

        /* Buttons on right (STACKED) */
        .userProfile .header-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

            .userProfile .header-buttons .btn-doc {
                border: 2px solid #fff;
                color: #fff;
                background: transparent;
                border-radius: 25px;
                padding: 0.35rem 0.9rem;
                font-size: 0.9rem;
                font-weight: 500;
                text-align: left;
                transition: all 0.3s ease;
            }

                .userProfile .header-buttons .btn-doc:hover {
                    background: #fff;
                    color: #FD670B;
                }

        /* ----- TOGGLE BUTTONS ----- */
        .userProfile .toggle-section {
            display: flex;
            justify-content: flex-start;
        }

        .userProfile .toggle-container {
            background-color: #FFF0E6;
            border-radius: 30px;
            display: inline-flex;
            padding: 0.3rem;
            gap: 0.3rem;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
        }

            .userProfile .toggle-container button {
                border: none;
                background: transparent;
                color: var(--primary);
                font-weight: 500;
                border-radius: 25px;
                padding: 0.4rem 1.4rem;
                transition: all 0.3s ease;
            }

                .userProfile .toggle-container button:hover {
                    background: rgba(253, 103, 11, 0.1);
                }

                .userProfile .toggle-container button.active {
                    background: var(--primary);
                    color: #fff;
                }


        /* ----- MAIN CARDS SECTION ----- */
        .userProfile .content-section {
            padding: 0 1.5rem;
        }

        .userProfile .info-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            padding: 1.5rem;
            height: 100%;
        }

            .userProfile .info-card h5 {
                font-weight: 600;
                margin-bottom: 1rem;
            }

            .userProfile .info-card i {
                color: #FD670B;
                margin-right: 0.5rem;
            }

        /* ----- CLIENT DETAILS ----- */
        .userProfile .client-details .detail-row {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-bottom: 0.75rem;
        }

        .userProfile .client-details label {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 0.2rem;
            display: block;
        }

        .userProfile .client-details span {
            background-color: #FFF0E6;
            border-radius: 6px;
            padding: 0.25rem 0.6rem;
            font-weight: 500;
            color: #333;
            display: inline-block;
            min-width: 130px;
        }

        .userProfile .client-details .detail-row #status {
            padding-right: 1.2rem;
        }


        /* Buttons inside client details (bottom) */
        .client-details .client-card-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .client-details .btn-action {
            background-color: var(--primary);
            color: #fff;
            border: none;
            border-radius: 25px;
            padding: 4px 8px;
            font-weight: 400;
            display: inline-flex;
            align-items: center;
            cursor: pointer;
        }

            .client-details .btn-action:hover {
                background: var(--primary-dark);
            }

        /* ----- SERVICES ENROLLED ----- */
        .userProfile .services-enrolled .service-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .userProfile .services-enrolled small {
            color: #777;
        }

        .userProfile .service-list {
            margin-top: 1rem;
            max-height: 260px;
            overflow-y: auto;
        }

            .userProfile .service-list::-webkit-scrollbar {
                width: 0;
                height: 0;
            }

        .userProfile .service-item {
            background: #FFF6F1;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 0.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
        }

            .userProfile .service-item:hover {
                background: #FFE5D3;
            }

            .userProfile .service-item .left {
                display: flex;
                flex-direction: column;
            }

                .userProfile .service-item .left small {
                    color: #666;
                    font-size: 0.85rem;
                }

            .userProfile .service-item .status {
                background: #E6F8E7;
                color: #1E824C;
                font-size: 0.8rem;
                font-weight: 500;
                border-radius: 15px;
                padding: 0.25rem 0.75rem;
            }

        @@media (max-width: 992px) {
            .userProfile .info-card {
                margin-bottom: 1rem;
            }
        }

        /* ===================== USERS SECTION STYLES ===================== */
        .userProfile-users-section {
            background-color: #FFF1EB;
        }

        /* Card container */
        .userProfile-user-card {
            border: none;
            border-radius: 10px;
            background-color: #fff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

            /* Add User Button */
            .userProfile-user-card .btn-orange {
                background-color: var(--primary);
                color: #fff;
                border: none;
                border-radius: 999px;
                font-weight: 500;
                padding: 4px 8px;
                font-size: 0.9rem;
                transition: all 0.3s ease;
            }

                .userProfile-user-card .btn-orange:hover {
                    background-color: var(--primary-dark);
                }

        /* Table styling */
        .userProfile-user-table-container {
            max-height: 400px;
            overflow-y: auto;
            scrollbar-width: none;
        }

            .userProfile-user-table-container::-webkit-scrollbar {
                display: none;
            }

        .userProfile-user-card table {
            width: 100%;
        }

        .userProfile-user-card th {
            font-weight: 600;
            color: #333;
            border-bottom: 2px solid #f0f0f0;
        }

        .userProfile-user-card td {
            vertical-align: middle;
            padding: 12px 10px;
            border-top: 1px solid #f5f5f5;
        }

        /* Avatar */
        .userProfile-user-card .avatar {
            background-color: #fde5d8;
            color: #E45D27;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Role badges */
        .role-admin {
            background-color: #f6e1ff;
            color: #6b22a6;
        }

        .role-manager {
            background-color: #dcecff;
            color: #0044cc;
        }

        .role-user {
            background-color: #f1f1f1;
            color: #555;
        }

        /* Status badges */
        .status-active {
            background-color: #e9f8ee;
            color: #198754;
        }

        .status-inactive {
            background-color: #f1f1f1;
            color: #666;
        }

        /* Dropdown icon */
        .userProfile-dropdown-toggle {
            cursor: pointer;
            font-size: 1.2rem;
            color: #666;
            transition: 0.2s ease;
        }

            .userProfile-dropdown-toggle:hover {
                color: #E45D27;
            }


        /* ----- Add User modal styles (reused for edit profile & change password) ----- */
        .userProfile-adduser-card,
        .userProfile-editprofile-card,
        .userProfile-changepass-card {
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.15);
            background: #fff;
            max-width: 640px;
        }

            .userProfile-adduser-card h5,
            .userProfile-editprofile-card h5,
            .userProfile-changepass-card h5 {
                color: #222;
            }

            .userProfile-adduser-card .btn-close,
            .userProfile-editprofile-card .btn-close,
            .userProfile-changepass-card .btn-close {
                filter: invert(0.5);
                opacity: 0.6;
                transition: opacity .2s ease;
            }

                .userProfile-adduser-card .btn-close:hover,
                .userProfile-editprofile-card .btn-close:hover,
                .userProfile-changepass-card .btn-close:hover {
                    opacity: 1;
                }

            .userProfile-adduser-card .form-control:focus,
            .userProfile-adduser-card .form-select:focus,
            .userProfile-editprofile-card .form-control:focus,
            .userProfile-editprofile-card .form-select:focus,
            .userProfile-changepass-card .form-control:focus {
                border-color: #fd670b !important;
                box-shadow: 0 0 0 0.25rem rgba(253,103,11,0.25) !important;
            }

            .userProfile-adduser-card .btn-orange,
            .userProfile-editprofile-card .btn-orange,
            .userProfile-changepass-card .btn-orange {
                background-color: var(--primary);
                color: #fff;
                border: none;
            }

                .userProfile-adduser-card .btn-orange:hover,
                .userProfile-editprofile-card .btn-orange:hover,
                .userProfile-changepass-card .btn-orange:hover {
                    background-color: var(--primary-dark);
                }

        .modal-backdrop.show {
            opacity: 0.3;
        }

        /* Responsive tweaks */
        @@media (max-width: 992px) {
            .userProfile .info-card {
                margin-bottom: 1rem;
            }

            .userProfile .header-buttons {
                flex-direction: row;
                gap: 0.5rem;
            }
        }

        /* ===================== BILLING SECTION STYLES ===================== */
        .bg-orange {
            background-color: #FD670B !important;
        }

        .btn-orange {
            background-color: var(--primary);
            color: #fff;
            border: none;
            border-radius: 25px;
            font-weight: 500;
            padding: 4px 8px;
            transition: all 0.3s ease;
        }

            .btn-orange:hover {
                background-color: var(--primary-dark);
                color: #fff;
            }

        .billing-section .card {
            border: 1px solid #e1e1e1;
            border-radius: 10px;
        }

        .billing-section .section-title {
            font-weight: 600;
            font-size: 1rem;
        }

        .billing-section .small-text {
            color: gray;
            font-size: 0.9rem;
        }

        .billing-section .billing-table {
            max-height: 250px;
            overflow-y: auto;
        }

        .billing-section .table th,
        .billing-section .table td {
            vertical-align: middle;
            background: #FFF6F1;
        }

        .billing-section .status-paid {
            background-color: #d4edda;
            color: #155724;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        /*Buttons*/
        #recommendBtn {
            border-radius: 999px;
            color: #fff;
            background: var(--primary);
            padding: 4px 8px;
            font-weight: 400;
            font-size: 0.85rem;
        }

            #recommendBtn:hover {
                background: var(--primary-dark);
            }

        /* KPI CARDS */
        .kpi-card {
            background: #fff;
            border-radius: 14px;
            padding: 12px 16px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            border-left: 5px solid #E45D27;
            transition: 0.2s ease;
            align-items: center;
            justify-content: space-between;
        }

            .kpi-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 4px 20px rgba(0,0,0,0.12);
            }

        .kpi-title {
            font-size: 0.9rem;
            font-weight: 500;
            color: #555;
        }

        .kpi-value {
            font-size: 1.4rem;
            font-weight: 700;
            margin-top: 4px;
            color: #E45D27;
        }
    </style>
 
    <div class="userProfile" ng-init="BindMenuForDash();UserList();Limit(); ">
        

        <!-- TOGGLE BUTTONS -->
        <div class="toggle-section px-4 mt-3">
            <div class="toggle-container">
                <button id="overviewBtn" class="active">Overview</button>
                <button id="usersBtn">Users</button>
                @*<button id="billingBtn">Billing</button>*@
            </div>
        </div>

        <!-- MAIN CONTENT (Dynamic Section) -->
        <div class="content-section container-fluid mt-3" id="mainContent">
            <!-- Default view: Overview -->
            <div id="overviewSection">
                <div class="row g-3">
                    <!-- ================= KPI Bar ================= -->
                    <div class="container my-3">
                        <div class="row g-4 justify-content-center">

                            <!-- Total Store Assign -->
                            <!-- Used -->
                            <div class="col-md-3">
                                <div class="kpi-card d-flex">
                                    <div class="kpi-title">Total Store</div>
                                    <div class="kpi-value" id="kpiUsed">{{StoreLimit ? StoreLimit : 0}}</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="kpi-card d-flex">
                                    <div class="kpi-title">Used Store</div>
                                    <div class="kpi-value" id="kpiTotalStore">{{total ? total : 0}}</div>
                                </div>
                            </div>
                            <!-- Pending -->
                            <div class="col-md-3">
                                <div class="kpi-card d-flex">
                                    <div class="kpi-title">Left Store</div>
                                    <div class="kpi-value" id="kpiPending">{{LeftStore ? LeftStore : 0}}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- LEFT CARD -->
                    <div class="col-lg-6">
                        <div class="info-card client-details">
                            <h5><i class="bi bi-person-lines-fill"></i> Client Details</h5>
                            <div class="detail-row">
                                <div>
                                    <label>Client ID</label>
                                    <span>{{LoginId}}</span>
                                </div>
                                <div>
                                    <label>Industry</label>
                                    <span>{{Industry}}</span>
                                </div>
                            </div>
                            <div class="detail-row">
                                <div>
                                    <label>Organization</label>
                                    <span>{{MapUser}}</span>
                                </div>
                                <div id="status">
                                    <label>UserName</label>
                                    <span>{{UserName}}</span>
                                </div>
                            </div>
                            <div class="detail-row">
                                <div>
                                    <label>ContactNo</label>
                                    <span>{{ContactNo}}</span>
                                </div>
                                <div id="status">
                                    <label>EmailId</label>
                                    <span>{{REmailId}}</span>
                                </div>
                            </div>

                            
                        </div>
                    </div>

                    <!-- RIGHT CARD -->
                    <div class="col-lg-6">
                        <div class="info-card services-enrolled">
                            <div class="service-header">
                                <h5><i class="bi bi-shield-check"></i> Module Subscribed</h5>
                                @*<button id="recommendBtn" class="btn btn-sm" type="button">Other Modules</button>*@
                            </div>
                            <small>{{ DashMenu ? DashMenu.length : 0 }} active services</small>

                            <div class="service-list mt-3" ng-repeat="x in DashMenu">
                                <div class="service-item">
                                    <div class="left">
                                        <strong>
                                            {{x.SubMenuName}}
                                        </strong>
                                        <small>Assigned On: {{x.CreatedOn}}</small>
                                    </div>
                                    <span class="status">Active</span>
                                </div>
                           
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="usersSection" class="d-none">
                <!-- ================= KPI Bar ================= -->
                <div class="container my-3">
                    <div class="row g-3 justify-content-center">
                        <!-- Total User -->
                        <div class="col-md-3">
                            <div class="kpi-card d-flex">
                                <div class="kpi-title">User Limit</div>
                                <div class="kpi-value" id="kpiTotalStore">{{ (UserLimit|| 0) }}</div>
                            </div>
                        </div>
                        <!-- Used -->
                        <div class="col-md-3">
                            <div class="kpi-card d-flex">
                                <div class="kpi-title">User Created</div>
                                <div class="kpi-value" id="kpiUsed">{{(Useroccupied || 0) }}</div>
                            </div>
                        </div>
                     
                        <div class="col-md-3">
                            <div class="kpi-card d-flex">
                                <div class="kpi-title">User Left</div>
                                <div class="kpi-value" id="kpiPending"> {{ (UserLimit || 0) - (Useroccupied || 0) }}</div>
                            </div>
                        </div>

                        <!-- Delayed -->
                        @*<div class="col-md-3">
                                <div class="kpi-card d-flex">
                                    <div class="kpi-title">Delayed</div>
                                    <div class="kpi-value" id="kpiDelayed">25</div>
                                </div>
                            </div>*@

                    </div>
                </div>
                <div class="card userProfile-user-card p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                        <div>
                            <h5 class="fw-bold mb-1">User Management</h5>
                            <small class="text-muted">Manage users and their access permissions</small>
                        </div>
                       
                    </div>

                    <div class="table-responsive userProfile-user-table-container">
                      
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Last Login</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in EmployeeList">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar">U</div>
                                            <div>
                                                <strong>{{x.UserName}}</strong><br>
                                                <small class="text-muted">{{x.EmailId}}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge role-admin">
                                            {{ x.LoginType == 5 ? 'Admin' : 'User' }}
                                        </span>
                                    </td>
                                    <td ng-show="1">
                                        <span class="badge status-active">
                                            {{ x.IsActive  == 1 ? 'Active' : 'InActive' }}
                                        </span>
                                    </td>
                                    <td ng-show !="0">
                                        2
                                        <span class="badge status-inactive">
                                            {{ x.IsActive  == 1 ? 'Active' : 'InActive' }}
                                    </td>
                                    <td>
                                        {{x.LL}}
                                    </td>
                                    @*<td class="text-end position-relative">
                        <button class="btn btn-sm" data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" href="#">Edit</a></li>
                            <li><a class="dropdown-item" href="#">Remove</a></li>
                            <li><a class="dropdown-item" href="#">Reset Password</a></li>
                        </ul>
                    </td>*@
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="billingSection" class="d-none">
                <div class="billing-section container-fluid">
                    <!-- Payment Methods -->
                    <div class="card p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap">
                            <div>
                                <h5 class="fw-bold mb-1">Payment Methods</h5>
                                <small class="text-muted">Manage your saved payment cards and preferences</small>
                            </div>
                            <button id="addCardBtn" class="btn btn-orange d-flex align-items-center gap-2">
                                <i class="bi bi-plus-lg"></i> Add Card
                            </button>
                        </div>

                        <!-- Saved Cards -->
                        <div class="row mt-3 g-3">
                            <div class="col-md-6">
                                <div class="card p-3 border-0 shadow-sm bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-semibold mb-1">Visa •••• 1234</h6>
                                            <small class="text-muted">Expires 08/27</small>
                                        </div>
                                        <span class="badge bg-success">Default</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card p-3 border-0 shadow-sm bg-light">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-semibold mb-1">Mastercard •••• 5678</h6>
                                            <small class="text-muted">Expires 02/28</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Billing Summary -->
                    <div class="card p-3 mb-4">
                        <h5 class="fw-bold mb-1">Billing Summary</h5>
                        <small class="text-muted">Overview of your current billing status and usage</small>

                        <div class="row mt-3 g-3">
                            <div class="col-md-4">
                                <div class="card text-center p-3 bg-light border-0">
                                    <h6 class="fw-semibold">Total Billed</h6>
                                    <h4 class="fw-bold text-orange">₹48,500</h4>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center p-3 bg-light border-0">
                                    <h6 class="fw-semibold">Outstanding</h6>
                                    <h4 class="fw-bold text-danger">₹8,200</h4>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center p-3 bg-light border-0">
                                    <h6 class="fw-semibold">Payments This Month</h6>
                                    <h4 class="fw-bold text-success">₹12,000</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoice History -->
                    <div class="card p-3">
                        <h5 class="fw-bold mb-1">Invoice History</h5>
