
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Supplier Admin";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/Dashboards/SupplierAdmin/script.js"></script>
<link href="~/Dashboards/SupplierAdmin/style.css" rel="stylesheet" />


<div class="supplierAdminPage px-4 py-2">
    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="Overview, Party, User, Site Management, Location Management or Site Mapping">
            <button type="button" class="btn btn-pill active" data-target="#overview" aria-pressed="true">Overview</button>
            <button type="button" class="btn btn-pill" data-target="#party" aria-pressed="false">Vendor</button>
            <button type="button" class="btn btn-pill" data-target="#user" aria-pressed="false">User</button>
            <button type="button" class="btn btn-pill" data-target="#siteManagement" aria-pressed="false">Site Management</button>
            @*<button type="button" class="btn btn-pill" data-target="#locationManagement" aria-pressed="false">Location Management</button>*@
            @*<button type="button" class="btn btn-pill" data-target="#siteMapping" aria-pressed="false">Site Mapping</button>*@
            <button type="button" class="btn btn-pill" data-target="#empCompDocs" aria-pressed="false">Employee Compliance Docs</button>
            <button type="button" class="btn btn-pill" data-target="#siteDocs" aria-pressed="false">Site Doc</button>
            <button type="button" class="btn btn-pill" data-target="#activityLog" aria-pressed="false">Activity Log</button>

        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">

        <!-- CARD 1 : Overview (default visible) -->
        <div id="overview" class="card section-card active adminOverview">
            <div class="card-body">

                <!-- TOP SUMMARY  -->
                <div class="adminOverview-header">

                    <!-- Left : Org Info -->
                    <div class="adminOverview-org">
                        <div class="adminOverview-logo">
                            <img src="~/AdminSetup/Dashboard/theobroma-logo.png" alt="Organization Logo">
                        </div>

                        <div class="adminOverview-orgInfo">
                            <h4>EZcompliance</h4>
                            <a href="https://www.ezcompliance.in" target="_blank">
                                www.ezcompliance.in
                            </a>
                            <p>Client ID: 123456</p>
                        </div>
                    </div>

                    <!-- Right : Meta Info -->
                    <!-- Right : Meta + Attention -->
                    <div class="adminOverview-right">

                        <!-- Meta Info -->
                        <div class="adminOverview-meta">
                            <div class="meta-item">
                                <label>Email Address</label>
                                <span>shankar@ezcompliance.in</span>
                            </div>

                            <div class="meta-item">
                                <label>Subscription Duration</label>
                                <span>Yearly</span>
                            </div>

                            <div class="meta-item">
                                <label>Plan</label>
                                <span>Professional</span>
                            </div>

                            <div class="meta-item">
                                <label>Renewal Date</label>
                                <span>11/01/27</span>
                            </div>
                        </div>

                        <!-- Attention Card (show only when expired – logic later) -->
                        <div class="adminOverview-alert">
                            <div class="alert-icon">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </div>

                            <div class="alert-content">
                                <h6>Subscription Expired</h6>
                                <p>Your subscription has expired. Renew now to avoid service interruption.</p>
                                <button class="btn btn-sm renew-btn">Renew Subscription</button>
                            </div>
                        </div>

                    </div>


                    <!-- Edit Icon -->
                    <!--<button class="adminOverview-edit" title="Edit Organization">
                    <i class="bi bi-pencil"></i>
                </button>-->
                </div>

                <!-- KPI CARDS  -->
                <div class="adminOverview-kpis">

                    <div class="kpiCard">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <div>
                            <h6>Module Subscribed</h6>
                            <span>15</span>
                        </div>
                    </div>

                    <div class="kpiCard">
                        <i class="bi bi-shop"></i>
                        <div>
                            <h6>Total Vendor</h6>
                            <span>7</span>
                        </div>
                    </div>



                    <div class="kpiCard">
                        <i class="bi bi-people"></i>
                        <div>
                            <h6>Total Users</h6>
                            <span>7</span>
                        </div>
                    </div>

                    <div class="kpiCard">
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <h6>Total Site</h6>
                            <span>0</span>
                        </div>
                    </div>

                    <div class="kpiCard">
                        <i class="bi bi-person-badge"></i>
                        <div>
                            <h6>Total Employee</h6>
                            <span>0</span>
                        </div>
                    </div>



                </div>

            </div>

            <!--USER ANALYTICS-->
            <div class=" adminUserAnalytics mt-4">

                <div class="row g-3 align-items-stretch">
                    <!-- LEFT : User Activity Trend -->
                    <div class="col-lg-8">
                        <div class="card section-card h-100">
                            <div class="card-body">

                                <div class="analytics-header">
                                    <h5 class="card-head">User Activity Trend</h5>

                                    <div class="analytics-actions">
                                        <select class="form-select form-select-sm">
                                            <option>Last 7 days</option>
                                            <option>Last 30 days</option>
                                            <option>Last 90 days</option>
                                        </select>

                                        @*<a href="javascript:void(0)">View all reports</a>*@
                                    </div>
                                </div>

                                <div class="chartWrap">
                                    <canvas id="userActivityChart"></canvas>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- RIGHT : User Status Summary -->
                    <div class="col-lg-4">
                        <div class="card section-card h-100">
                            <div class="card-body">

                                <h5 class="mb-3 card-head" style="color: var(--primary)">User Status Summary</h5>

                                <div class="donutWrap">
                                    <canvas id="userStatusChart"></canvas>
                                    <div class="donutCenter">
                                        <span>Total</span>
                                        <strong>7</strong>
                                    </div>
                                </div>

                                <div class="userStats">
                                    <div>
                                        <span class="dot active"></span>
                                        <strong>7</strong>
                                        <small>Active users</small>
                                    </div>

                                    <div>
                                        <span class="dot inactive"></span>
                                        <strong>0</strong>
                                        <small>Inactive users</small>
                                    </div>

                                    <div>
                                        <span class="dot total"></span>
                                        <strong>7</strong>
                                        <small>Total users</small>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>


        <!-- CARD 2 : party -->
        <div id="party" class="card section-card d-none">
