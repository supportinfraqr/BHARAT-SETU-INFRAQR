                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="#">CSV</a></li>
                                    <li><a class="dropdown-item" href="#">PDF</a></li>
                                    <li><a class="dropdown-item" href="#">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Vendor Code</th>
                                    <th>Party Name</th>
                                    <th>Email</th>
                                    <th>Mobile</th>
                                    <th>Active Date</th>
                                    <th>Edit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td>12344567</td>
                                    <td>Demo Party</td>
                                    <td>party@12gmail.com</td>
                                    <td>123456789</td>
                                    <td>15/01/2026</td>
                                    <td class="action-menu">
                                        <button class="btn btn-sm">
                                            Edit
                                        </button>
                                    </td>
                                </tr>


                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

        <!--  Add Existing Party Modal -->
        <div class="modal fade supplierAdminModal"
             id="addExistingPartyModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">
                        <h5 class="modal-title">Add Party</h5>
                        <button type="button"
                                class="btn-close btn-close-white"
