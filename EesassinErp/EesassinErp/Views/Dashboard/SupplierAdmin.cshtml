                                <li><a class="dropdown-item" href="#">Fire NOC</a></li>
                                <li><a class="dropdown-item" href="#">FSSAI License</a></li>
                                <li><a class="dropdown-item" href="#">Signage License</a></li>
                                <li><a class="dropdown-item" href="#">Trade License</a></li>
                                <li><a class="dropdown-item" href="#">Pollution NOC - CTO</a></li>
                                <li><a class="dropdown-item" href="#">Pollution NOC - CTE</a></li>
                                <li><a class="dropdown-item" href="#">Music License</a></li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Location Code
