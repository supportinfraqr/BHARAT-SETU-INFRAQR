                    <i class="bi bi-plus me-1"></i> Add Party
                </button>*@
                <div class="dropdown">
                    <button class="btn btn-sm add-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus me-1"></i> Add Party</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" data-bs-toggle="modal" data-bs-target="#addExistingPartyModal">Add Existing</a></li>
                        <li><a class="dropdown-item" data-bs-toggle="modal" data-bs-target="#addNewPartyModal">Add New</a></li>
                    </ul>
                </div>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2">

