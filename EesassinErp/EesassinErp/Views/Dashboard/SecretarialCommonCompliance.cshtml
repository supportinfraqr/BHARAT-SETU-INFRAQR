@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


@*<div  ng-init="BindReport()">*@


<link href="~/ReportsDashboard/CommonReport/style.css" rel="stylesheet" />
<script src="~/Scripts/RetailJsLib/ReportDashbaord.js"></script>
<!-- REPORT PAGE 1: COMPLIANCE Report -->
<div class="report-header d-flex justify-content-between align-items-center px-4 py-2 text-white" style="background: #FFF1EB">
    <button class="btn btn-sm download-btn" ng-click="DownloadPDF('SecretarialCommonCompliance')">
        <i class="bi bi-download me-1"></i> Download Report
    </button>
    <h6 class="mb-0"> {{ReportPeriod}}</h6>
</div>
<div id="divprint">
    <div class="container-report1" ng-init="BindTiles();commonReport();BindsactrarialReport()">
        <!-- HEADER -->
        
        <!-- BODY -->
        <div class="report-body p-4">
            <!-- Overview Title Box -->
            <div class="overview-box text-center py-2 mb-4">
                <h5 class="mb-0">Secretarial Compliance Report</h5>
            </div>

            <!-- Description -->
            <p class="small text-muted mb-4 text-center">
                This section provides a consolidated overview of all compliances, highlighting the organization's completion ratio,
                pending obligations, and compliance health for the selected period.
            </p>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4 justify-content-center align-items-center">
                <div class="col-md-2">
                    <div class="summary-card rounded-3 py-3">
                        <p class="mb-1 ">Total</p>
                        <h4 class="mb-0 ">{{TotalComplied}}</h4>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="summary-card rounded-3 py-3">
                        <p class="mb-1 ">Complied</p>
                        <h4 class="mb-0">{{Complied}}</h4>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="summary-card rounded-3 py-3">
                        <p class="mb-1">Non Complied</p>
                        <h4 class="mb-0">{{NonComplied}}</h4>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="summary-card rounded-3 py-3">
                        <p class="mb-1 ">Delay Complied</p>
                        <h4 class="mb-0 ">{{DelayComplied}}</h4>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="summary-card rounded-3 py-3">
                        <p class="mb-1">Pending</p>
                        <h4 class="mb-0">{{Pending}}</h4>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="table-responsive mb-4">
                <table class="table text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Risk Metric</th>
                            <th>Count</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>High</td>
                            <td>{{HighRisk}}</td>
                            <td>
                                Compliances with critical impact and strict regulatory consequences if missed.
                            </td>
                        </tr>
                        <tr>
                            <td>Medium</td>
                            <td>{{MediumRisk}}</td>
                            <td>
                                Compliances with moderate impact that require timely monitoring and follow-up.
                            </td>
                        </tr>
                        <tr>
                            <td>Low </td>
                            <td>{{LowRisk}}</td>
                            <td>
                                Compliances with minimal impact but required for overall regulatory hygiene.
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>


            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            State
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Central</a></li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Status
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Total</a></li>
                            <li><a class="dropdown-item" href="#">Pending</a></li>
                            <li><a class="dropdown-item" href="#">Complied</a></li>
                            <li><a class="dropdown-item" href="#">Delayed</a></li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Month
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">January</a></li>
                            <li><a class="dropdown-item" href="#">February</a></li>
                            <li><a class="dropdown-item" href="#">March</a></li>
                            <!-- ... -->
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Year
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">2025</a></li>
                            <li><a class="dropdown-item" href="#">2024</a></li>
                        </ul>
                    </div>

                    <button class="btn btn-sm filter-btn active">Go</button>
                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="scSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>
                                <li><a class="dropdown-item" href="#">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table" id="scTable">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Act Name</th>
                                <th>Compliance Name</th>
                                <th>Month</th>
                                <th>State</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Actual Submission Date</th>
                                <th>Delay Days</th>
                                <th>Is Verified</th>
                            </tr>
                        </thead>
                        <tbody id="scTableBody">
                            <tr>
                                <td>1</td>
                                <td>Foreign Exchange Management Act 1999</td>
                                <td><a href="#" class="store-code-link text-success">FC-GPR: Reporting of issuance of shares to a Subscriber who is a Person Resident Outside India</a></td>
                                <td><a href="#" class="event-link text-success">Event</a></td>
                                <td>Central</td>
                                <td>dec 11</td>
                                <!--Status column-->
                                <td>
                                    <select class="form-select form-select-sm">
                                        <option value="">Select</option>
                                        <option>Complied</option>
                                        <option>Non-Complied</option>
                                        <option>Delayed</option>
                                        <option>Non-Applicable</option>
                                    </select>
                                </td>
                                <!--Actual Submission Date column-->
                                <td>
                                    <input type="date" class="form-control form-control-sm">
                                </td>
                                <td>23</td>
                                <td>Yes/no</td>
                            </tr>

                        </tbody>
                    </table>
                </div>

            </div>



        </div> 
    </div>



    </div>

 
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script src="~/ReportsDashboard/CommonReport/script.js"></script>
 
