    color: var(--primary);
}

.sitesOverviewModal .modal-footer {
    background: var(--card-bg);
    border-top: 1px solid #eee;
}

/* SEGMENT TOGGLE */

.principleEmpDashboard .siteSegment-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #E7DFDA;
    border-radius: 999px;
    padding: 6px;
    overflow-x: auto;
    overflow-y: hidden;
    margin-bottom: 24px;
    width: fit-content;
    max-width: 100%;
    scrollbar-width: none;
}

    .principleEmpDashboard .siteSegment-wrap::-webkit-scrollbar {
        display: none;
    }

/* BUTTONS */

.principleEmpDashboard .siteSegment-btn {
    border: 0;
    background: transparent;
    color: #555;
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
}

    /* HOVER */

    .principleEmpDashboard .siteSegment-btn:hover {
        color: var(--primary);
    }

    /* ACTIVE */

    .principleEmpDashboard .siteSegment-btn.active {
        background: var(--primary);
        color: #fff;
    }

    /* CLICK EFFECT */

    .principleEmpDashboard .siteSegment-btn:active {
        transform: scale(0.97);
    }


/* PANELS */

.principleEmpDashboard .employeeManualPanel-wrap {
    position: relative;
}

.principleEmpDashboard .employeeManualPanel {
    display: none;
    animation: employeePanelFade 0.28s ease;
}

    .principleEmpDashboard .employeeManualPanel.active {
        display: block;
    }

@@keyframes employeePanelFade {

    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* CARD */

.principleEmpDashboard .employeeManualPanel {
    background: #fff;
    border-radius: 24px;
    padding: 24px;
}


/* HEADER */

.principleEmpDashboard .employeeManualPanel-header {
    margin-bottom: 28px;
}

    .principleEmpDashboard .employeeManualPanel-header h4 {
        font-size: 24px;
