

@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/ReportsDashboard/CommonReport/style.css" rel="stylesheet" />
<script src="~/Scripts/RetailJsLib/ReportDashbaord.js"></script>


<div class="report-header d-flex justify-content-between align-items-center px-4 py-2 text-white">
    <button class="btn btn-light btn-sm fw-semibold" ng-click="DownloadPDF('NoticeInspectionCommonReport')">
        <i class="bi bi-download me-1"></i> Download Report
    </button>
    <h6 class="mb-0"> {{ReportPeriod}}</h6>
</div>
<!-- REPORT PAGE 9: Notice & Inspection Report-->
<div  id="divprint" class="container-report9 py-4" ng-init="noticeMater()" ng-cloak> 
     
    <div class="report-body9 p-4">

        <!-- TITLE -->
        <div class="report-title-box text-center py-2 px-2 mb-3">
            <h5 class="fw-semibold mb-0">
                Notice & Inspection Report
            </h5>
        </div>

        <!-- DESCRIPTION -->
        <p class="text-muted text-center mb-4" style="font-size:14px;">
            This section provides a consolidated overview of all compliances, highlighting the organization’s completion ratio,
            pending obligations, and compliance health for the selected period.
        </p>

        <!-- SMALL CARDS -->
        <div class="row g-3 mb-4 justify-content-center text-center">
            <div class="col-md-2 col-6">
                <div class="card small-card bg-success text-white py-3">
                    <h6>Total</h6>
                    <h5>{{TotalRecords}}</h5>
                </div>
            </div>
            <div class="col-md-2 col-6">
                <div class="card small-card bg-danger text-white py-3">
                    <h6>Submitted</h6>
                    <h5>{{SubmitCount}}</h5>
                </div>
            </div>
            <div class="col-md-2 col-6">
                <div class="card small-card bg-warning text-dark py-3">
                    <h6>Pending</h6>
                    <h5>{{PendingCount}}</h5>
                </div>
            </div>

        </div>


        <!-- TABLE  -->
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Store Code</th>
                        <th>Submission</th>
                        <th>Closer Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="x in Noticelist">
                        <td>
                            {{x.DepartmentName}}
                        </td>
                        <td>
                            {{x.StoreCode}}
                        </td>
                        <td>
                            {{x.Submitions}}
                        </td>
                        <td>
                            {{x.Submitions}}
                        </td>
                    </tr>
                     

                </tbody>
            </table>
        </div>


        <h6 class="mb-2 mt-6 fw-semibold text-center" style="color: #E45D27">Financial Impact</h6>

        <!-- GRAPH -->
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-body" style="height: 400px;">
                <canvas id="noticeInspectionChart"></canvas>
            </div>
        </div>


    </div>


   
</div>

  
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script src="~/ReportsDashboard/CommonReport/script.js"></script>