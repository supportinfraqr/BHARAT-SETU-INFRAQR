                                        License Required
                                    </label>

                                    <select class="form-select employeeManual-input">

                                        <option value="">Select</option>


                                    </select>

                                </div>

                                <div class="col-lg-3 col-md-6">

                                    <label class="employeeManual-label">
                                        License Type
                                    </label>

                                    <select class="form-select employeeManual-input">

                                        <option value="">Select</option>


                                    </select>

                                </div>


                                <div class="col-lg-3 col-md-6">

