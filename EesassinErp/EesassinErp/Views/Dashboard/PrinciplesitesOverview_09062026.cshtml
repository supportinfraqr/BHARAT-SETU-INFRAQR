@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Sites Overview";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="~/scripts/RetailJsLib/PrincipleEmployerCodeController.js"></script>
<link href="~/Dashboards/SitesOverview/style.css" rel="stylesheet" />
<script src="~/Dashboards/SitesOverview/script.js"></script>

<div class="sitesOverview px-4 py-3">

    <!-- PAGE HEADER -->
    <div class="sitesOverviewHeader">

        <div ng-init="BindAllSite()">
            <h2 class="sitesOverviewTitle">Sites Overview</h2>
            <p class="sitesOverviewSubTitle">
                All construction sites and projects
            </p>
        </div>

        <!-- VIEW TOGGLE -->
        <div class="viewToggleWrapper">

            <button class="viewToggleBtn active" data-view="grid">
                <i class="bi bi-grid-3x3-gap-fill"></i>
            </button>

            <button class="viewToggleBtn" data-view="table">
                <i class="bi bi-list-ul"></i>
            </button>

        </div>

    </div>

    <!-- GRID VIEW -->
    <div class="sitesGridView activeView">

        <div class="sitesGrid">

            
                <div class="siteOverviewCard"   ng-repeat="x in ALLsITE">

                    <!-- HEADER -->
                    <div class="siteOverviewCardHeader">

                        <div class="siteOverviewIcon">
                            <i class="bi bi-buildings"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h4>{{x.SiteName}}</h4>

                            <p>
                                <i class="bi bi-geo-alt"></i>
                                {{x.Address}}
                            </p>
                        </div>

                        <span class="siteOverviewStatus">
                            {{x.Status}}
                        </span>

                     

                    </div>

                    <!-- STATS -->
                    <div class="siteOverviewStats">

                        <div class="siteOverviewStat">
                            <span>Contractors</span>
                            <strong>{{x.VendorCount}}</strong>
                        </div>

                        <div class="siteOverviewStat">
                            <span>Workers</span>
                            <strong>{{x.EmployeeCount}}</strong>
                        </div>

                    </div>

                    <!-- PROGRESS -->
                    <div class="siteOverviewProgressWrap">

                        <div class="d-flex justify-content-between mb-2">
                            <span>Completion</span>
                            <strong>{{x.CompliancePercentage}}%</strong>
                        </div>

                        <div class="progress siteOverviewProgress">
                            <div class="progress-bar" style="width:{{x.CompliancePercentage}}%"></div>
                        </div>

                    </div>

                    <!-- BUTTON -->
                    <button class="siteOverviewViewBtn" ng-click="SearchSitebyId(x.SiteId)"
                            data-bs-toggle="modal"
                            data-bs-target="#viewSiteModal">
                        <i class="bi bi-eye"></i>
                        View
                    </button>

                </div>
           

        </div>

    </div>

    <!-- TABLE VIEW -->
    <div class="sitesTableView">

        <div class="sitesTableCard">

            <div class="table-responsive">

                <table class="table sitesOverviewTable align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Site Name</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Contractors</th>
                            <th>Workers</th>
                            <th>Completion</th>
                          
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
 
                            <tr ng-repeat="x in ALLsITE">

                                <!-- SITE -->
                                <td>
                                    <div class="tableSiteNameWrap">

                                        <div class="tableSiteIcon">
                                            <i class="bi bi-buildings"></i>
                                        </div>

                                        <strong>{{x.SiteName}}</strong>

                                    </div>
                                </td>

                                <!-- LOCATION -->
                                <td>
                                    <div class="tableLocation">
                                        <i class="bi bi-geo-alt"></i>
                                        {{x.Address}}
                                    </div>
                                </td>

                                <!-- STATUS -->
                                <td>
                                    <span class="tableStatusBadge">
                                        {{x.Status}}
                                    </span>
                                </td>

                                <!-- CONTRACTORS -->
                                <td class="fw-semibold text-center">
                                    {{x.VendorCount}}
                                </td>

                                <!-- WORKERS -->
                                <td class="fw-semibold text-center">
                                    {{x.EmployeeCount}}
                                </td>

                                <!-- PROGRESS -->
                                <td>

                                    <div class="tableProgressWrap">

                                        <div class="progress tableProgressBar siteOverviewProgress">
                                            <div class="progress-bar" style="width:{{x.CompliancePercentage}}%">  </div>
                                        </div>

                                        <strong>{{x.CompliancePercentage}}%</strong>

                                    </div>


                                  

                                </td>

                                
                                <td>

                                    <div class="tableActionWrap">

                                        <button class="tableActionBtn" data-bs-toggle="modal" data-bs-target="#viewSiteModal" ng-click="SearchSitebyId(x.SiteId)">
                                            <i class="bi bi-eye"></i>
                                        </button>
 

                                    </div>

                                </td>

                            </tr>
                         

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!--  Add Site Modal -->
    <div class="modal fade sitesOverviewModal"
         id="viewSiteModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">{{Sitemaster.SiteCode}} - {{Sitemaster.SiteName}}<br />({{Sitemaster.Address}})</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">
                    <!-- SEGMENT TOGGLE -->
                    <div class="siteSegment-wrap">

                        <button class="siteSegment-btn active"
                                data-index="0"
                                data-tab="basicTab">

                            Basic Info

                        </button>

                        <button class="siteSegment-btn"
                                data-index="1"
                                data-tab="addressTab">

                            Address Details

                        </button>

                        <button class="siteSegment-btn"
                                data-index="2"
                                data-tab="operationalTab">

                            Operational Details

                        </button>

                        <button class="siteSegment-btn"
                                data-index="3"
                                data-tab="complianceTab">

                            Compliance Client

                        </button>

                        <button class="siteSegment-btn"
                                data-index="4"
                                data-tab="contactTab">

                            Contact Details

                        </button>

                        <button class="siteSegment-btn"
                                data-index="5"
                                data-tab="attendanceTab">

                            Attendance Access

                        </button>

                        <button class="siteSegment-btn"
                                data-index="6"
                                data-tab="billingTab">

                            Billing Contractor

                        </button>

                        <button class="siteSegment-btn"
                                data-index="7"
                                data-tab="otherTab">

                            Other Facilities

                        </button>

                    </div>


                    <div class="employeeManualPanel-wrap">

                        <!-- BASIC DETAILS -->
                        <div class="employeeManualPanel active"
                             id="basicTab">

                            <div class="row g-4">


                                <div class="col-lg-3 col-md-6">
                                    <label class="employeeManual-label">
                                        Site ID
                                    </label>

                                    <input class="form-control employeeManual-input">
                                </div>


                                <div class="col-lg-3 col-md-6">
