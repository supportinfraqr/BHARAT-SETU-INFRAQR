                                    </label>

                                    <input class="form-control employeeManual-input validate">
                                </div>


                                <div class="col-lg-3 col-md-6">
                                    <label class="employeeManual-label">
                                        Site Type
                                        <span>*</span>
                                    </label>

                                    <select class="form-select employeeManual-input validate"
                                            ng-model="SiteId">

                                        <option value="">Select</option>

                                        <option ng-repeat="x in SiteList"
