                        </div>

                        <!-- Operational Details TAB -->
                        <div class="employeeManualPanel"
                             id="operationalTab">

                            <!-- FORM -->
                            <div class="row g-4">

                                <div class="col-lg-3 col-md-6">

                                    <label class="employeeManual-label">
