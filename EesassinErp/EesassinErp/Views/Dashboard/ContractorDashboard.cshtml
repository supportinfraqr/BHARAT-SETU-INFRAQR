    <!-- ==========================================================
         Contractor Worker Highlights Offcanvas
    ========================================================== -->
    <div class="offcanvas offcanvas-end contractorWorkerPanel"
         tabindex="-1"
         id="workerHighlightsPanel"
         aria-labelledby="workerHighlightsPanelLabel">

        <!-- ================= Header ================= -->
        <div class="offcanvas-header contractorWorkerHeader">

            <h4 class="offcanvas-title contractorWorkerTitle"
                id="workerHighlightsPanelLabel">

                Worker Highlights

            </h4>

            <button type="button"
                    class="btn-close btn-close-white contractorWorkerCloseBtn"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>

        <!-- ================= Body ================= -->
        <div class="offcanvas-body contractorWorkerBody">

            <!-- ==========================================
                 Onboarding Progress
            =========================================== -->

            <div class="contractorWorkerProgressCard">

                <div class="contractorWorkerProgressLabel">
                    ONBOARDING PROGRESS
                </div>

                <div class="contractorWorkerProgressValue" hidden>

                    <span>92%</span>

                    Complete

                </div>

            </div>

            <!-- ==========================================
                 Toolbar
            =========================================== -->

            <div class="contractorWorkerToolbar">

                <!-- Left -->

                <div class="contractorWorkerToolbarTitle">

                    CONSENT MANAGEMENT

                </div>

                <!-- Right -->

                <div class="contractorWorkerToolbarActions">

                    <!-- Search -->

                    <div class="contractorWorkerSearch">

                        <i class="bi bi-search"></i>

                        <input type="text" ng-model="Searchbox"
                               placeholder="">

                    </div>

                    <!-- Export -->

                    <button class="contractorWorkerExportBtn" hidden>

                        Export

                    </button>

                </div>

            </div>

            <!-- ==========================================
                 Table Container
            =========================================== -->

            <div class="contractorWorkerTableWrapper">

                <!-- Consent Table -->

                <div class="contractorWorkerTableContainer">

                    <table class="contractorWorkerTable">

                        <thead>
                            <tr>
                                <th>Worker Name</th>

                                <th>Status</th>

                                <th class="text-center">Actions</th>
                            </tr>

                        </thead>

                        <tbody>
                            <tr ng-repeat="B in RequestWorkerAll | filter:Searchbox">
                                <td>{{B.EmployeeName}}</td>
                                <td>

                                    <span class="contractorWorkerBadge contractorWorkerAccepted"
                                          ng-if="B.Status.toLowerCase() == 'accepted'">
                                        {{B.Status}}
                                    </span>

                                    <span class="contractorWorkerBadge contractorWorkerRejected"
                                          ng-if="B.Status.toLowerCase() != 'accepted'">
                                        {{B.Status}}
                                    </span>
                                </td>

                                <td class="text-center">

                                    <button class="contractorWorkerResendBtn" ng-if="B.Status.toLowerCase() != 'accepted' && B.Status.toLowerCase() != 'pending'" ng-click="ResendRequest(B.Id)">
                                        Resend
                                    </button>

                                </td>

                            </tr>
                            <tr style="display:none;">

                                <td>
                                    <input type="checkbox" class="contractorWorkerCheckbox">
                                </td>

                                <td>Aadarsh</td>

                                <td>

                                    <span class="contractorWorkerBadge contractorWorkerPending">

                                        PENDING

                                    </span>

                                </td>

                                <td class="text-center">

                                    <button class="contractorWorkerResendBtn">

                                        Resend

                                    </button>

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!--Footer-->

        <div class="contractorWorkerFooter" hidden>

            <div class="contractorWorkerFooterInner">

                <button class="contractorWorkerCloseFooterBtn"
                        data-bs-dismiss="offcanvas">

                    Close

                </button>

                <button class="contractorWorkerPrimaryBtn">

                    Resend

                </button>

            </div>

        </div>

    </div>

    <!-- ==========================================================
        Pending Request Offcanvas
    ========================================================== -->
    <div class="offcanvas offcanvas-end contractorWorkerPanel"
         tabindex="-1"
         id="principlePendingRequestPanel"
         aria-labelledby="principlePendingRequestPanelLabel">

        <!-- ================= Header ================= -->
        <div class="offcanvas-header contractorWorkerHeader">

            <h4 class="offcanvas-title contractorWorkerTitle"
                id="workerHighlightsPanelLabel">

                Pending Request

            </h4>

            <button type="button"
                    class="btn-close btn-close-white contractorWorkerCloseBtn"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>

        <!-- ================= Body ================= -->
        <div class="offcanvas-body contractorWorkerBody">

            <div class="contractorPendingInfo">
                You have <strong>{{TotalReq}}</strong> action requiring your attention
            </div>

            <!-- ==========================================
                 Table Container
            =========================================== -->

            <div class="contractorWorkerTableWrapper">

                <!-- Consent Table -->

                <div class="contractorWorkerTableContainer">

                    <table class="contractorWorkerTable">
                        <thead>
                            <tr>
                                <th>Principal Employer</th>
                                <th>Site</th>
                                <th class="text-center">Actions</th>

                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="B in BindRequestall">
                                <td>{{B.PartyName}}</td>
                                <td>{{B.sitenm}}</td>
                                <td class="text-center">
                                    <div class="contractorPendingModalActions">
                                        <button class="contractorAcceptBtn" ng-click="CompleteRequest(B.PartyId,12,B.Id)">
                                            <i class="bi bi-check-circle"></i>
                                            Accept
                                        </button>
                                        <button class="contractorCancelBtn" ng-click="CompleteRequest(B.PartyId,13,B.Id)">
                                            <i class="bi bi-x-circle"></i>
                                            Cancel
                                        </button>
                                    </div>
                                </td>

                            </tr>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>




