                                    <td>
                                        <button class="contractorTableActionBtn">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>*@

                        </tbody>

                    </table>

                </div>

                <!-- FOOTER -->
                <div class="contractorCardFooter">

                    <button class="contractorViewAllBtn">
                        View All
                        <i class="bi bi-chevron-right"></i>
                    </button>

                </div>

            </div>

        </div>

