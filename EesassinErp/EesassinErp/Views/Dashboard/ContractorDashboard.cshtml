@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Contractor Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

 
<link href="~/Content/Dashboards/ContractorDashboard/style.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/Content/Dashboards/ContractorDashboard/script.js"></script>
<script src="~/scripts/RetailJsLib/ContractorDashboardController.js?v=20260826a"></script>


<div class="contractorDashboard px-4 py-2" ng-init="BindTiles()" ng-cloak>
    <div class="contractorDashboardHeader d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <p class="contractorWelcomeText mb-1" hidden>
                Welcome back,{{UserName}}
            </p>
            <div class="d-flex flex-column gap-2 flex-wrap"  ng-if="DashboardDetail.PartyName && DashboardDetail.PartyCode">
                <h6 class="contractorCompanyName mb-1" style="font-size:1.7rem">{{DashboardDetail.PartyName}}  <span style="font-size:1.3rem;font-weight:500;">( {{DashboardDetail.PartyCode}})</span></h6>
            </div>
        </div>
        <div class="contractorStatusBadge active">
            Active
        </div>
    </div>
    <!-- ===================================================== -->
    <!-- TOP STATS -->
    <!-- ===================================================== -->
    <!--  KPI Cards  -->
    <div class="row g-3 mb-4">
        <!-- CARD -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="contractorStatCard" style="background: #F3F8FF">
                <div class="contractorStatIcon blue">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <h3>{{DashboardDetail.WorkerCount || '0'}}</h3>
                    <p style="color: #155DFC">Total Workers</p>
                </div>
            </div>
        </div>
        <!-- CARD -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="contractorStatCard" style="background: #F9F4FF">
                <div class="contractorStatIcon purple">
                    <i class="bi bi-buildings"></i>
                </div>
                <div>
                    <h3>{{DashboardDetail.SiteCount || '0'}}</h3>
                    <p style="color: purple">Total Sites</p>
                </div>
            </div>
        </div>
        <!-- CARD -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="contractorStatCard" style="background: #F3F5FF">
                <div class="contractorStatIcon blue">
                    <i class="bi bi-file-earmark-check"></i>
                </div>
                <div>
                    <h3>0</h3>
                    <p style="color: #003BB2">Active Licenses</p>
                </div>
            </div>
        </div>
        <!-- CARD -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="contractorStatCard" style="background: #F3FFF7">
                <div class="contractorStatIcon green">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h3>0%</h3>
                    <p style="color: green">Compliance Score</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================== -->
    <!-- First Row -->
    <!-- ===================================================== -->
    <div class="contractorDashboardRowOne" ng-init="BindPrincipleDetail(DashboardDetail.PartyCode)">
        
        <div class="contractorRowOneLeft">
            <div class="contractorDashboardCard h-100">
                <div class="contractorCardHeader">
                    <h5>Principle Employer</h5>
                    <button class="contractorArrowBtn">
                        <i class="bi bi-arrow-up-right-circle"></i>
                    </button>
                </div>
                <div class="contractorInfoGrid">
                    <div class="contractorInfoRow">
                        <span>Principle Employer</span>
                        <strong>{{client.Contractorname || '-'}}</strong>
                    </div>
                    <div class="contractorInfoRow">
                        <span>Employer Code</span>
                        <strong>{{client.EmployerCode || '-'}}</strong>
                    </div>
                    <div class="contractorInfoRow">
                        <span>Industry</span>
                        <strong>{{client.Industry || '-'}}</strong>
                    </div>
                    <div class="contractorInfoRow">
                        <span>Email ID</span>
                        <strong>{{client.EmailId || '-'}}</strong>
                    </div>
                    <div class="contractorInfoRow">
                        <span>LIN No</span>
                        <strong>{{client.LIN || '-'}}</strong>
                    </div>
                </div>
            </div>
        </div>


        <!-- SITE DETAILS -->
        <div class="contractorRowOneMiddle" ng-init="">
            <div class="contractorDashboardCard h-100">
                <div class="contractorCardHeader">
                    <h5>Site Details</h5>
                    <a href="../Dashboard/Contractorsitesoverview" style="text-decoration: none;">
                        <button class="contractorArrowBtn">
                            <i class="bi bi-arrow-up-right-circle"></i>
                        </button>
                    </a>
                </div>
                <div class="contractorTableWrapper">
                    <table class="table contractorTable mb-0">
                        <thead>
                            <tr>
                                <th>Sr No.</th>
                                <th>Site Name</th>
                                <th>Site Code</th>
                                <th>No. of Workers</th>
                                <th>Compliance Score</th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr ng-repeat="s in SiteList">
                                <td>{{$index+1}}</td>
                                <td>{{s.SiteName}}</td>
                                <td>{{s.SiteCode}}</td>
                                <td>{{s.EmployeeCount}}</td>
                                <td>{{s.CompliancePercentage}} %</td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- WORKER HIGHLIGHTS -->
        <div class="contractorRowOneRight">

            <!-- Worker Highlights-->
            <div class="contractorDashboardCard contractorWorkerHighlightsCard h-100">

                <div class="contractorCardHeader">

                    <h5>Worker Highlights</h5>

                    <button class="contractorArrowBtn"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#workerHighlightsPanel"
                            aria-controls="workerHighlightsPanel" ng-click="BindRequestWorkerAll()">

                        <i class="bi bi-arrow-up-right-circle"></i>

                    </button>

                </div>

                <div class="contractorHighlightsGrid" ng-init="BindRequestWorker()">

                    <!-- CARD -->
                    <div class="contractorWorkerCard accepted" ng-repeat="x in RequestWorker" ng-class="x.Status == 'Pending' ? 'pending' : 'accepted'">
                        <div>
                            <h6>{{x.EmployeeName}}</h6>
                            <p>{{x.EmployeeCode}}</p>
                        </div>
                        <span class="contractorStatusPill"
                              ng-class="x.Status == 'Accepted' ? 'success' : 'warning'">
                            {{x.Status}}
                        </span>
                    </div>
                </div>

            </div>

            <!--  My Pending Requests  -->
            <div class="contractorDashboardCard contractorPendingRequestCard h-100">

                <div class="contractorCardHeader">
                    <h5>Pending Requests</h5>

                    <button class="contractorArrowBtn"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#principlePendingRequestPanel"
                            aria-controls="principlePendingRequestPanel" ng-click="BindPrincipleRequestAll(11)">
                        <i class="bi bi-arrow-up-right-circle"></i>
                    </button>
                </div>

                <div class="contractorPendingWrapper" ng-init="BindPrincipleRequest(10)">
                    <div class="contractorPendingCard" ng-repeat="B in BindRequest">
                        <div>
                            <h6>{{B.PartyName}}</h6>
                            <p>{{B.PartyCode}}</p>
                        </div>
                        <div class="contractorPendingActions">
                            <button class="btn btn-success btn-sm" ng-click="CompleteRequest(B.PartyId,12,B.Id)">
                                Accept
                            </button>

                            <button class="btn btn-outline-danger btn-sm" ng-click="CompleteRequest(B.PartyId,13,B.Id)">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>

            </div>


        </div>

    </div>

    <!-- ===================================================== -->
    <!-- MIDDLE SECTION -->
    <!-- ===================================================== -->

    <div class="contractorMiddleSection">

        <!-- ================================================= -->
        <!-- LEFT SIDE(MIDDLE SECTION) -->
        <!-- ================================================= -->

        <div class="contractorMiddleLeft">

            <!-- ============================================= -->
            <!-- TOP ROW(MIDDLE SECTION) -->
            <!-- ============================================= -->

            <div class="contractorMiddleTop">

                <!-- ========================================= -->
                <!-- COMPLIANCE SUBMISSION LIST -->
                <!-- ========================================= -->

                <div class="contractorMiddleTopLeft" ng-init="BindControl()">

                    <div class="contractorDashboardCard h-100">

                        <div class="contractorCardHeader">

                            <h5>Compliance Submission List</h5>

                            <button class="contractorArrowBtn">
                                <i class="bi bi-arrow-up-right-circle"></i>
                            </button>

                        </div>

                        <div class="contractorTableWrapper contractorMediumTable">

                            <table class="table contractorTable mb-0">

                                <thead>

                                    <tr>
                                        <th>S.No.</th>
                                        <th>Unique No.</th>
                                        <th>Site Code</th>
                                        <th>Location</th>
                                        <th>Status</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    <tr ng-repeat="x in InvoiceList">
                                        <td>{{$index+1}}</td>
                                        <td>{{x.InvoiceNo}}</td>
                                        <td>{{x.SiteCode}}</td>
                                        <td>{{x.Location}}</td>
                                        <td>
                                            <span class="contractorStatusPill" ng-class="w.Status == 'Complete' ? 'success' : 'danger'">
                                                {{x.Status}}
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                <!-- ========================================= -->
                <!-- WORKER VERIFIED DOCUMENTS -->
                <!-- ========================================= -->

                <div class="contractorMiddleTopRight">

                    <div class="contractorDashboardCard contractorDocumentsCard h-100">

                        <div class="contractorCardHeader">

                            <h5>Worker Verified Documents</h5>

                            <button class="contractorArrowBtn">
                                <i class="bi bi-arrow-up-right-circle"></i>
                            </button>

                        </div>

                        <div class="contractorDocumentsList">

                            <!-- ITEM -->
                            <div class="contractorDocumentItem">

                                <div class="contractorDocumentTop">
                                    <span>Aadhaar</span>
                                    <strong>0%</strong>
                                </div>

                                <div class="contractorDocumentProgress">
                                    <div class="progress-bar" style="width:98%"></div>
                                </div>

                            </div>

                            <!-- ITEM -->
                            <div class="contractorDocumentItem">

                                <div class="contractorDocumentTop">
                                    <span>PAN</span>
                                    <strong>0%</strong>
                                </div>

                                <div class="contractorDocumentProgress">
                                    <div class="progress-bar" style="width:94%"></div>
                                </div>

                            </div>

                            <!-- ITEM -->
                            <div class="contractorDocumentItem">

                                <div class="contractorDocumentTop">
                                    <span>UAN</span>
                                    <strong>0%</strong>
                                </div>

                                <div class="contractorDocumentProgress">
                                    <div class="progress-bar" style="width:92%"></div>
                                </div>

                            </div>

                            <!-- ITEM -->
                            <div class="contractorDocumentItem">

                                <div class="contractorDocumentTop">
                                    <span>ESIC IP</span>
                                    <strong>0%</strong>
                                </div>

                                <div class="contractorDocumentProgress">
                                    <div class="progress-bar" style="width:88%"></div>
                                </div>

                            </div>

                            <!-- ITEM -->
                            <div class="contractorDocumentItem">

                                <div class="contractorDocumentTop">
                                    <span>Police Verification</span>
                                    <strong>0%</strong>
                                </div>

                                <div class="contractorDocumentProgress">
                                    <div class="progress-bar" style="width:78%"></div>
                                </div>

                            </div>

                            <!-- ITEM -->
                            <div class="contractorDocumentItem">

                                <div class="contractorDocumentTop">
                                    <span>Bank Verification</span>
                                    <strong>0%</strong>
                                </div>

                                <div class="contractorDocumentProgress">
                                    <div class="progress-bar" style="width:81%"></div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ============================================= -->
            <!-- BOTTOM ROW(MIDDLE SECTION) -->
            <!-- ============================================= -->

            <div class="contractorMiddleBottom">

                <!-- ========================================= -->
                <!-- WORKER COMPLIANCE OVERVIEW -->
                <!-- ========================================= -->

                <div class="contractorMiddleBottomLeft">

                    <div class="contractorDashboardCard h-100">

                        <div class="contractorCardHeader">

                            <h5>Worker Compliance Overview</h5>

                            <button class="contractorArrowBtn">
                                <i class="bi bi-arrow-up-right-circle"></i>
                            </button>

                        </div>

                        <div class="contractorTableWrapper contractorMediumTable">

                            <table class="table contractorTable mb-0">

                                <thead>

                                    <tr>
                                        <th>Worker ID</th>
                                        <th>Worker Name</th>
                                        <th>Site</th>
                                        <th>Gate Pass</th>
                                        <th>Medical Exam</th>
                                        <th>Health & Safety</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="w in WorkerSiteList">
                                        <td>{{w.EmployeeCode}}</td>
                                        <td>{{w.EmployeeName}}</td>
                                        <td>{{w.SiteName}}</td>
                                        <td>
                                            <span class="contractorStatusPill" ng-class="w.GatePassStatus == 'Valid' ? 'success' : 'danger'">
                                                {{w.GatePassStatus}}
                                            </span>
                                        </td>
                                        <td>
                                            <span class="contractorStatusPill" ng-class="w.MedicalStatusResult == 'Done' ? 'success' : 'danger'">
                                                {{w.MedicalStatusResult}}
                                            </span>
                                        </td>
                                        <td>
                                            <span class="contractorStatusPill" ng-class="w.FitnessStatus == 'Done' ? 'success' : 'danger'">
                                                {{w.FitnessStatus}}
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>

                            </table>

                        </div>

                        <div class="contractorCardFooter">

                            <button class="contractorViewAllBtn">
                                View All
                                <i class="bi bi-chevron-right"></i>
                            </button>

                        </div>

                    </div>

                </div>

                <!-- ========================================= -->
                <!-- WORKFORCE GROWTH TREND -->
                <!-- ========================================= -->

                <div class="contractorMiddleBottomRight">

                    <div class="contractorDashboardCard h-100">

                        <div class="contractorCardHeader">

                            <h5>Workforce Growth Trend</h5>

                            <button class="contractorArrowBtn">
                                <i class="bi bi-arrow-up-right-circle"></i>
                            </button>

                        </div>

                        <div class="contractorChartTop">

                            <div class="contractorChartToggle">

                                <button class="active">
                                    6 Months
                                </button>

                                <button>
                                    1 Year
                                </button>

                            </div>

                        </div>

                        <div class="flex-grow-1 d-flex align-items-center">

                            <canvas id="workforceChart"></canvas>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ================================================= -->
        <!-- RIGHT SIDE(MIDDLE SECTION) -->
        <!-- ================================================= -->

        <div class="contractorMiddleRight">

            <div class="contractorDashboardCard h-100">

                <div class="contractorCardHeader">

                    <h5>Recent Activities</h5>

                    <button class="contractorArrowBtn">
                        <i class="bi bi-arrow-up-right-circle"></i>
                    </button>

                </div>

                <!--<div class="contractorActivitiesList">-->
                <!-- ITEM -->
                <!--<div class="contractorActivityItem">

                    <h6>Monthly Compliance Filing</h6>

                    <p>
                        Form V submitted successfully for Aug 2024
                    </p>

                    <span>3 hours ago</span>

                </div>-->
                <!-- ITEM -->

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- LAST ROW -->
    <!-- ===================================================== -->

    <div class="contractorBottomSection">

        <!-- ================================================= -->
        <!-- COMPLIANCE HISTORY -->
        <!-- ================================================= -->

        <div class="contractorBottomLeft">

            <div class="contractorDashboardCard h-100">

                <!-- HEADER -->
                <div class="contractorCardHeader">

                    <h5>Compliance History</h5>

                    <button class="contractorArrowBtn">
                        <i class="bi bi-arrow-up-right-circle"></i>
                    </button>

                </div>

                <!-- TABLE -->
                <div class="contractorTableWrapper contractorHistoryTableWrapper">

                    <table class="table contractorTable contractorHistoryTable mb-0">

                        <thead>

                            <tr>
                                <th>Site ID</th>
                                <th>Total Workers</th>
                                <th>Salary Paid</th>
                                <th>Date of Payment</th>
                                <th>PF Deposited</th>
                                <th>Date of Deposit (PF)</th>
                                <th>ESIC Deposited</th>
                                <th>Date of Deposit (ESIC)</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @*
                                <tr>
                                    <td>SIGI0526DL01</td>
                                    <td>421</td>
