                                                        Choose File
                                                        <input type="file" hidden>
                                                    </label>

                                                    <button class="btn btn-sm ">
                                                        <i class="bi bi-eye"></i>
                                                    </button>

                                                    <button class="btn btn-sm ">
                                                        <i class="bi bi-download"></i>
                                                    </button>
                                                </div>
                                            </td>

                                            <td><span class="badge status-active">Validated</span></td>
                                        </tr>

                                        <!-- dummy row -->
                                        <tr>
                                            <td><input type="checkbox" /></td>
                                            <td>2</td>
                                            <td>No</td>
                                            <td>ESI Challan</td>
                                            <td>Statutory</td>
                                            <td>Monthly</td>
                                            <td>Yes</td>
                                            <td>PDF</td>
                                            <td><input type="text" class="form-control form-control-sm"></td>

                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <label class="btn btn-sm btn-upload px-3" style="white-space:nowrap; cursor:pointer;">
                                                        Choose File
                                                        <input type="file" hidden>
                                                    </label>

                                                    <button class="btn btn-sm ">
                                                        <i class="bi bi-eye"></i>
                                                    </button>

                                                    <button class="btn btn-sm ">
                                                        <i class="bi bi-download"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td><span class="badge status-disabled">Error</span></td>

                                        </tr>

                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                    <!-- FOOTER -->
                    <div class="modal-footer justify-content-end" style="background: var(--card-bg)">
                        <button class="btn btn-sm cv-btn-outline"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button class="btn btn-sm cv-btn-primary">
                            Go to Report
                        </button>
                    </div>

                </div>
            </div>
        </div>


    </div>
</div>

