
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Communication Auditor";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<style>
    #communicationAuditorPage {
        font-family: "Inter", sans-serif;
        --primary: #E45D27; /* theme accent */
        --primary-dark: #c44b1d;
        --card-bg: #FEF3EC;
        background: #FFF1EB;
        color: #223;
        min-height: 85vh;
    }

    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }

    #communicationAuditorPage #createComplDoc {
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 6px 12px;
        font-weight: 400;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        -webkit-tap-highlight-color: transparent;
    }

        #communicationAuditorPage #createComplDoc:hover {
            background: var(--primary-dark);
        }


    /* Section cards */
    #communicationAuditorPage .section-card {
        background: transparent;
        border: none;
    }

        #communicationAuditorPage .section-card .card-body {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            min-height: 320px;
        }

    /* Table wrapper and hide scrollbar visually */
    #communicationAuditorPage .small-table-wrapper .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: smooth;
        position: relative;
    }

        #communicationAuditorPage .small-table-wrapper .table-responsive::-webkit-scrollbar {
            display: none;
        }

    /* table header sticky */
    #communicationAuditorPage .small-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #F37437;
        color: #fff;
        font-weight: 600;
        font-size: 0.78rem;
        text-align: left;
        vertical-align: middle;
        white-space: nowrap;
        padding: 8px 10px;
    }

    /* table body */
    #communicationAuditorPage .small-table tbody td {
        background-color: var(--card-bg);
        font-size: 0.78rem;
        vertical-align: middle;
        text-align: left;
        padding: 8px 10px;
        white-space: nowrap;
    }

    /* hover */
    #communicationAuditorPage .small-table tbody tr:hover td {
        background-color: #FFE8D9;
    }

    #communicationAuditorPage .small-table tbody td .store-code-link,
    #communicationAuditorPage .small-table tbody td .event-link {
        text-decoration: none;
    }

    /* action menu */
    #communicationAuditorPage .action-menu {
        position: relative;
        width: 48px;
        text-align: right;
        background-color: var(--card-bg);
    }

        #communicationAuditorPage .action-menu .btn {
            color: var(--primary);
        }

        #communicationAuditorPage .action-menu .dropdown-menu {
            min-width: 120px;
            font-size: 0.85rem;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

    /* filter button */
    #communicationAuditorPage .filter-btn {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #communicationAuditorPage .filter-btn.active,
        #communicationAuditorPage .filter-btn:hover {
            background: var(--primary);
            color: #fff;
        }

    /* small inputs */
    #communicationAuditorPage .table-toolbar .form-control-sm {
        height: 36px;
        border-radius: 999px;
        border-color: var(--primary);
    }

    /* Export button (rounded) */
    #communicationAuditorPage .export-btn {
        border-radius: 999px;
        color: #fff;
        background: var(--primary);
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
        -webkit-tap-highlight-color: transparent;
    }

        #communicationAuditorPage .export-btn:hover {
            background: var(--primary-dark);
        }

        /* remove default dark flash on click for export and other action buttons while keeping subtle ring on focus */
        #communicationAuditorPage .export-btn:focus,
        #communicationAuditorPage .export-btn:active {
            outline: none;
            box-shadow: 0 0 0 3px rgba(228,93,39,0.12);
        }

    /*Fix Search bar and button in toolbar*/
    #communicationAuditorPage .table-toolbar .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    #communicationAuditorPage .table-toolbar .input-group .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-color: var(--primary);
    }

    /* Pagination area */
    #communicationAuditorPage .table-pagination {
        border-top: 1px solid rgba(0,0,0,0.04);
        padding-top: 8px;
        margin-top: 8px;
    }

        #communicationAuditorPage .table-pagination .btn {
            border-radius: 999px;
            font-size: 0.85rem;
            padding: 6px 12px;
            border: 1px solid var(--primary);
            background: #fff;
            color: var(--primary);
        }

            #communicationAuditorPage .table-pagination .btn:hover {
                background: var(--primary);
                color: #fff;
                border-color: var(--primary);
            }

    #communicationAuditorPage #viewAllRows {
        background-color: var(--primary);
        color: #fff;
        border: none;
    }

        #communicationAuditorPage #viewAllRows:hover {
            background-color: var(--primary-dark);
        }


    /* statuses */
    #communicationAuditorPage .badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
    }

    #communicationAuditorPage .status-active {
        background: #dff6e9;
        color: #197a3a;
    }

    #communicationAuditorPage .status-upcoming {
        background: #ffeedf;
        color: #d06a1e;
    }

    #communicationAuditorPage .status-disabled {
        background: #ffe9ee;
        color: #c43a5b;
    }

    /* Responsive tweaks */
    @@media (max-width: 767px) {
        #communicationAuditorPage .table-toolbar {
            flex-direction: column;
            gap: 8px;
            align-items: stretch;
        }

        #communicationAuditorPage .top-bar {
            flex-direction: column;
            gap: 8px;
            align-items: flex-start;
        }

        #communicationAuditorPage .limit-instruction {
            font-size: 0.85rem;
        }

        #communicationAuditorPage .toggle-pill .btn-pill {
            padding: 8px 12px;
            min-width: 64px;
        }
    }

    /* Table Buttons*/

    .btn-upload, .btn-view, .btn-submit {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.78rem;
    }

        .btn-upload:hover, .btn-view:hover, .btn-submit:hover {
            background: var(--primary);
            color: #fff;
        }

    /* Communication Vendor Modal*/

    #communicationAuditorPage .cv-header {
        background: var(--primary);
        color: #fff;
        padding: 12px 16px;
        border-bottom: none;
    }

        #communicationAuditorPage .cv-header h6 {
            font-size: 0.95rem;
            font-weight: 500;
        }

    #communicationAuditorPage .cv-close {
        filter: invert(1);
        opacity: 0.9;
    }

        #communicationAuditorPage .cv-close:hover {
            opacity: 1;
        }

    #communicationAuditorPage .cv-body {
        background: var(--card-bg);
        padding: 16px;
    }

        #communicationAuditorPage .cv-body .form-label {
            font-size: 0.75rem;
            font-weight: 500;
            margin-bottom: 4px;
        }

        #communicationAuditorPage .cv-body .form-select {
            height: 34px;
            font-size: 0.8rem;
            border-radius: 6px;
            border-color: #dcdcdc;
        }

            #communicationAuditorPage .cv-body .form-select:focus {
                border-color: var(--primary);
                box-shadow: none;
            }

    #communicationAuditorPage .cv-footer {
        background: var(--card-bg);
        border-top: none;
        justify-content: flex-end;
        padding: 12px 16px;
    }

    #communicationAuditorPage .cv-btn-outline {
        border-radius: 999px;
        border: 1px solid var(--primary);
        background: transparent;
        color: var(--primary);
        padding: 4px 6px;
        font-size: 0.8rem;
    }

        #communicationAuditorPage .cv-btn-outline:hover {
            background: var(--primary);
            color: #fff;
        }

    #communicationAuditorPage .cv-btn-primary {
        border-radius: 999px;
        background: var(--primary);
        color: #fff;
        border: none;
        padding: 4px 6px;
        font-size: 0.8rem;
    }

        #communicationAuditorPage .cv-btn-primary:hover {
            background: var(--primary-dark);
        }
</style>


<div id="communicationAuditorPage" class="px-4 py-2">

    <!-- Top bar: Heading left + Create Compliance Document button right -->
    <div class="d-flex align-items-center justify-content-between mb-3 top-bar">
        <h4 style="color: #E45D27">Communication Page</h4>

        <!--<div class="d-flex align-items-center gap-2">-->
        <!-- Create Compliance Document (rounded pill) -->
        <!--<button class="btn btn-sm " id="createComplDoc" type="button" data-bs-toggle="modal" data-bs-target="#createComplianceDocModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Create Compliance Doc</span>
            </button>
        </div>-->
    </div>

    <!-- Create Compliance Doc Modal -->
    <div class="modal fade" id="createComplianceDocModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header cv-header">
                    <h6 class="mb-0">Create Compliance Document</h6>

                    <!-- CLOSE BUTTON -->
                    <button type="button" class="btn-close" data-bs-dismiss="modal" style="color:#fff"></button>
                </div>

                <!-- --Body-- -->
                <div class="modal-body cv-body">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">Client</label>
                            <select class="form-select form-select-sm">
                                <option>Select</option>
                                <option>Client A</option>
                                <option>Client B</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">State</label>
                            <select class="form-select form-select-sm">
                                <option>Select</option>
                                <option>Maharashtra</option>
                                <option>Delhi</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Financial Year</label>
                            <select class="form-select form-select-sm">
                                <option>Select</option>
                                <option>2024–25</option>
                                <option>2025–26</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Month</label>
                            <select class="form-select form-select-sm">
                                <option>Select</option>
                                <option>January</option>
                                <option>February</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Site</label>
                            <select class="form-select form-select-sm">
                                <option>Select</option>
                                <option>Site 1</option>
                                <option>Site 2</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Location</label>
                            <select class="form-select form-select-sm">
                                <option>Select</option>
                                <option>Location A</option>
                                <option>Location B</option>
                            </select>
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer cv-footer">
                    <button class="btn btn-sm cv-btn-outline" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button class="btn btn-sm cv-btn-primary">
                        Create
                    </button>
                </div>

            </div>
        </div>
    </div>



    <div class="card section-card">
        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Status
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Draft</a></li>
                            <li><a class="dropdown-item" href="#">Pending</a></li>
                            <li><a class="dropdown-item" href="#">Complied</a></li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            State
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Delhi</a></li>
                            <li><a class="dropdown-item" href="#">Uttar Pradesh</a></li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Month
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">January</a></li>
                            <li><a class="dropdown-item" href="#">February</a></li>
                            <li><a class="dropdown-item" href="#">March</a></li>
                            <!-- ... -->
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Year
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">2024-25</a></li>
                            <li><a class="dropdown-item" href="#">2023-24</a></li>
                        </ul>
                    </div>

                    <button class="btn btn-sm filter-btn active">Go</button>
                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="scSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>
                                <li><a class="dropdown-item" href="#">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Vendor</th>
                                <th>State</th>
                                <th>Financial Year</th>
                                <th>Month</th>
                                <th>Location</th>
                                <th>Site</th>
                                <th>Status</th>
                                <th>Unique No.</th>
                                <th>Creation Date</th>
                                <th>Submission Updated</th>
                                <th>Days Left</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="communicationTableBody">
                            <tr>
                                <td>1</td>
                                <td>Vendor Demo</td>
                                <td>Delhi</td>
                                <td>2024-25</td>
                                <td>January</td>
                                <td>Location1</td>
                                <td>Site1</td>
                                <td>Draft</td>
                                <td>UN00496</td>
                                <td>01/01/26</td>
                                <td>01/01/26</td>
                                <td>50</td>
                                <!--View column-->
                                @*<td>
                                        <button class="btn btn-sm btn-view">View</button>
                                    </td>*@
                                <!--Action column-->
                                <td>
                                    <button class="btn btn-sm btn-submit px-3" data-bs-toggle="modal" data-bs-target="#submitComplianceModal">View</button>
                                </td>
                            </tr>
                            <tr>
                                <td>1</td>
                                <td>Vendor Demo</td>
                                <td>Delhi</td>
                                <td>2024-25</td>
                                <td>January</td>
                                <td>Location1</td>
                                <td>Site2</td>
                                <td>Draft</td>
                                <td>UN00496</td>
                                <td>01/01/26</td>
                                <td>01/01/26</td>
                                <td>50</td>
                                <!--View column-->
                                @*<td>
                                        <button class="btn btn-sm btn-view">View</button>
                                    </td>*@
                                <!--Action column-->
                                <td>
                                    <button class="btn btn-sm btn-submit px-3" data-bs-toggle="modal" data-bs-target="#submitComplianceModal">View</button>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        <!-- ================= Submit Modal ================= -->
        <div class="modal fade"
             id="submitComplianceModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content">

                    <!-- HEADER -->
                    <div class="modal-header" style="background: var(--primary); color: #fff">
                        <h5 class="modal-title">Submit Compliance Documents</h5>

                        <!-- DEFAULT BOOTSTRAP CLOSE -->
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <!-- BODY -->
                    <div class="modal-body p-4" style="background: var(--card-bg)">
                        <!-- Download All button row -->
                        <div class="d-flex justify-content-end mb-2">
                            <button class="btn btn-sm export-btn">
                                <i class="bi bi-download me-1"></i>
                                Download All
                            </button>
                        </div>

                        <!-- Table wrapper -->
                        <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0 small-table">
