
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Communication Vendor";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="~/Scripts/myjslib/WithoutInvoiceController.js?Ver=@ViewBag.Version"></script>
<style>
    #communicationVendorPage {
        font-family: "Inter", sans-serif;
        --primary: #022B5E;
        --primary-dark: #033d84;
        --bg: #FFFFFF;
        --card-bg: #fff;
        --border: #D9D9D9;
        --text: #1F2937;
        --muted: #6B7280;
        --radius: 12px;
        background: var(--bg);
        min-height: 100vh;
        color: var(--text);
    }

    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }

    #communicationVendorPage #createComplDoc {
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 6px 12px;
        font-weight: 400;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        -webkit-tap-highlight-color: transparent;
    }

        #communicationVendorPage #createComplDoc:hover {
            background: var(--primary-dark);
        }


    /* Section cards */
    #communicationVendorPage .section-card {
        background: transparent;
        border: none;
    }

        #communicationVendorPage .section-card .card-body {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            min-height: 320px;
        }

    /* Table wrapper and hide scrollbar visually */
    #communicationVendorPage .small-table-wrapper .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: smooth;
        position: relative;
    }

        #communicationVendorPage .small-table-wrapper .table-responsive::-webkit-scrollbar {
            display: none;
        }

    /* table header sticky */
    #communicationVendorPage .small-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #f8f9fd;
        color: var(--primary);
        font-weight: 600;
        font-size: 0.78rem;
        text-align: left;
        vertical-align: middle;
        white-space: nowrap;
        padding: 8px 10px;
    }

    /* table body */
    #communicationVendorPage .small-table tbody td {
        background-color: var(--card-bg);
        font-size: 0.78rem;
        vertical-align: middle;
        text-align: left;
        padding: 8px 10px;
        white-space: nowrap;
    }

    /* hover */
    #communicationVendorPage .small-table tbody tr:hover td {
        background-color: #F8f9fc;
    }

    #communicationVendorPage .small-table tbody td .store-code-link,
    #communicationVendorPage .small-table tbody td .event-link {
        text-decoration: none;
    }

    /* action menu */
    #communicationVendorPage .action-menu {
        position: relative;
        width: 48px;
        text-align: right;
        background-color: var(--card-bg);
    }

        #communicationVendorPage .action-menu .btn {
            color: var(--primary);
        }

        #communicationVendorPage .action-menu .dropdown-menu {
            min-width: 120px;
            font-size: 0.85rem;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

    /* filter button */
    #communicationVendorPage .filter-btn {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #communicationVendorPage .filter-btn.active,
        #communicationVendorPage .filter-btn:hover {
            /*background: var(--primary);
            color: #fff;*/
        }

    /* small inputs */
    #communicationVendorPage .table-toolbar .form-control-sm {
        height: 36px;
        border-radius: 999px;
        border-color: var(--primary);
    }

    /* Export button (rounded) */
    #communicationVendorPage .export-btn {
        border-radius: 999px;
        color: #fff;
        background: var(--primary);
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
        -webkit-tap-highlight-color: transparent;
    }

        #communicationVendorPage .export-btn:hover {
            background: var(--primary-dark);
        }

        /* remove default dark flash on click for export and other action buttons while keeping subtle ring on focus */
        #communicationVendorPage .export-btn:focus,
        #communicationVendorPage .export-btn:active {
            outline: none;
            box-shadow: 0 0 0 3px rgba(228,93,39,0.12);
        }

    /*Fix Search bar and button in toolbar*/
    #communicationVendorPage .table-toolbar .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    #communicationVendorPage .table-toolbar .input-group .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-color: var(--primary);
    }

    /* Pagination area */
    #communicationVendorPage .table-pagination {
        border-top: 1px solid rgba(0,0,0,0.04);
        padding-top: 8px;
        margin-top: 8px;
    }

        #communicationVendorPage .table-pagination .btn {
            border-radius: 999px;
            font-size: 0.85rem;
            padding: 6px 12px;
            border: 1px solid var(--primary);
            background: #fff;
            color: var(--primary);
        }

            #communicationVendorPage .table-pagination .btn:hover {
                background: var(--primary);
                color: #fff;
                border-color: var(--primary);
            }

    #communicationVendorPage #viewAllRows {
        background-color: var(--primary);
        color: #fff;
        border: none;
    }

        #communicationVendorPage #viewAllRows:hover {
            background-color: var(--primary-dark);
        }


    /* statuses */
    #communicationVendorPage .badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
    }

    #communicationVendorPage .status-active {
        background: #dff6e9;
        color: #197a3a;
    }

    #communicationVendorPage .status-upcoming {
        background: #ffeedf;
        color: #d06a1e;
    }

    #communicationVendorPage .status-disabled {
        background: #ffe9ee;
        color: #c43a5b;
    }

    /* Responsive tweaks */
    @@media (max-width: 767px) {
        #communicationVendorPage .table-toolbar {
            flex-direction: column;
            gap: 8px;
            align-items: stretch;
        }

        #communicationVendorPage .top-bar {
            flex-direction: column;
            gap: 8px;
            align-items: flex-start;
        }

        #communicationVendorPage .limit-instruction {
            font-size: 0.85rem;
        }

        #communicationVendorPage .toggle-pill .btn-pill {
            padding: 8px 12px;
            min-width: 64px;
        }
    }

    /* Table Buttons*/

    .btn-upload, .btn-view, .btn-submit {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.78rem;
    }

        .btn-upload:hover, .btn-view:hover, .btn-submit:hover {
            background: var(--primary);
            color: #fff;
        }

    /* Communication Vendor Modal*/

    #communicationVendorPage .cv-header {
        background: var(--primary);
        color: #fff;
        padding: 12px 16px;
        border-bottom: none;
    }

        #communicationVendorPage .cv-header h6 {
            font-size: 0.95rem;
            font-weight: 500;
        }

    #communicationVendorPage .cv-close {
        filter: invert(1);
        opacity: 0.9;
    }

        #communicationVendorPage .cv-close:hover {
            opacity: 1;
        }

    #communicationVendorPage .cv-body {
        background: var(--card-bg);
        padding: 16px;
    }

        #communicationVendorPage .cv-body .form-label {
            font-size: 0.75rem;
            font-weight: 500;
            margin-bottom: 4px;
        }

        #communicationVendorPage .cv-body .form-select {
            height: 34px;
            font-size: 0.8rem;
            border-radius: 6px;
            border-color: #dcdcdc;
        }

            #communicationVendorPage .cv-body .form-select:focus {
                border-color: var(--primary);
                box-shadow: none;
            }

    #communicationVendorPage .cv-footer {
        background: var(--card-bg);
        border-top: none;
        justify-content: flex-end;
        padding: 12px 16px;
    }

    #communicationVendorPage .cv-btn-outline {
        border-radius: 999px;
        border: 1px solid var(--primary);
        background: transparent;
        color: var(--primary);
        padding: 4px 6px;
        font-size: 0.8rem;
    }

        #communicationVendorPage .cv-btn-outline:hover {
            background: var(--primary);
            color: #fff;
        }

    #communicationVendorPage .cv-btn-primary {
        border-radius: 999px;
        background: var(--primary);
        color: #fff;
        border: none;
        padding: 4px 6px;
        font-size: 0.8rem;
    }

        #communicationVendorPage .cv-btn-primary:hover {
            background: var(--primary-dark);
        }
</style>



<div id="communicationVendorPage" class="px-4 py-4">



    <h4 style="color:var(--primary);">Compliance Submission</h4>


    <div class="card section-card">
        <div class="card-body p-3 h-100 mt-4 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">

                    <!-- STATUS -->


                    <div class="dropdown">
                        <select class="btn btn-sm filter-btn dropdown-toggle" ng-model="Controlbyuser" ng-change="BindControl()">
                            <option value="">Select</option>
                            <option value="0">Pending</option>
                            <option value="1">Complete</option>
                        </select>
                    </div>

                    <div class="dropdown">
                        <select ng-change="BindControl()" class="btn btn-sm filter-btn dropdown-toggle" ng-model="VendorId" ng-init="BindVendor();BindControl()">
                            <option value="" style="font-size: 12px;">All Vendor</option>
                            <option ng-repeat="x in VendorList" value="{{x.PartyId}}">{{x.PartyName}}</option>
                        </select>
                    </div>



                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="scSearch"
                                   type="text"
                                   ng-model="Searchbox"
                                   class="form-control form-control-sm"
                                   placeholder="Search..." />
                            <button class="btn btn-outline-secondary" ng-click="Searchbox=''" hidden>✖</button>
                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: var(--primary);" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="" ng-click="exportCSV()">CSV</a></li>
                                <li><a class="dropdown-item" href="" ng-click="printData()">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Contractor</th>
                                <th>State</th>
                                <th>Financial Year</th>
                                <th>Month</th>
                                <th>Site</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th>Unique No.</th>
                                <th>Creation Date</th>
                                <th>Submission Updated</th>
                                <th>Days Left</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr ng-repeat="x in  InvoiceList | filter:Searchbox track by $index">
                                <td>{{$index+1}}</td>
                                <td>{{x.VName}}</td>
                                <td>{{x.StateName}}</td>
                                <td>{{x.FYID}}</td>
                                <td>{{x.InMonthName}}</td>
                                <td>{{x.SiteName}}</td>
                                <td>{{x.Location}}</td>
                                <td>
                                    {{ x.Status }}
                                </td>
                                <td>{{x.InvoiceNo}}</td>
                                <td>{{x.CreatedOn}}</td>
                                <td>{{x.UpdatedON}}</td>
                                <td>{{x.DayLeft}}</td>
                                <td>
                                    <button class="btn btn-sm btn-submit px-3" data-bs-toggle="modal" data-bs-target="#submitComplianceModal" ng-click="BindClientAutomate(x);GetClientDocument(x.RegInvoiceNo,x.ConversationId)">View Document</button>
                                </td>
                            </tr>

                            <tr ng-if="(InvoiceList | filter:Searchbox).length == 0">
                                <td colspan="13" class="text-center text-muted py-3" style="color:var(--primary) !important;">
                                    No Data Found
                                </td>
                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>


        <!-- ================= Submit Modal ================= -->
        <div class="modal fade"
             id="submitComplianceModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content">

                    <!-- HEADER -->
                    <div class="modal-header" style="background: var(--primary); color: #fff">
                        <h5 class="modal-title">Submit Documents</h5>

                        <!-- DEFAULT BOOTSTRAP CLOSE -->
                        <button type="button" ng-click="BindControl()"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <!-- BODY -->
                    <div class="modal-body p-8" style="background: var(--card-bg)">

                        <div class="d-flex justify-content-end mb-2">

                            <button class="btn btn-sm export-btn" ng-click="downloadAll()">
                                <i class="bi bi-download me-1"></i>
                                Download All
                            </button>
                        </div>

                        <!-- Table wrapper -->
                        <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0 small-table">
                                    <thead>
                                        <tr>
                                            <th style="width:40px;">
                                                <input type="checkbox" />
                                            </th>
                                            <th>S. No</th>
                                            <th>Document Name</th>
                                            <th>Type</th>
                                            <th>Frequency</th>
                                            <th>Mandatory</th>
                                            <th>Required Format</th>
                                            <th>Note</th>
                                            <th>View</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="y in AutomateDocument">
                                            <td>
                                               
                                            </td>
                                            <td>{{xx.SRNO}} </td>
                                            <td>{{xx.DocumentName}}</td>
                                            <td>{{xx.DocumentType}}</td>
                                            <td>{{xx.Frequency}}</td>
                                            <td>{{xx.Mandatory}}</td>
                                            <td>{{xx.FormatType}}</td>
                                            <td>{{xx.Note}}</td>
                                           
                                            
                                            <td>
                                                <button class="btn btn-sm"
                                                        ng-click="ApproveBeforeDownload(xx.HeaderHtml,xx.Allowed,xx.DocumentId,1,xx.DocumentName)">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                <button class="btn btn-sm"
                                                        ng-click="ApproveBeforeDownload(xx.HeaderHtml,xx.Allowed,xx.DocumentId,3,xx.DocumentName)">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                            </td>

                                            <td></td>
                                        </tr>

                                        <tr ng-repeat="xx in InDocList">
                                            <td>
                                                <input type="checkbox" ng-checked="{{xx.IsDefault}}" />
                                            </td>
                                            <td>{{xx.SRNO}} </td>
                                            <td>{{xx.DocumentName}}</td>
                                            <td>{{xx.DocumentType}}</td>
                                            <td>{{xx.Frequency}}</td>
                                            <td>{{xx.Mandatory}}</td>
                                            <td>{{xx.FormatType}}</td>
                                            <td>{{xx.Note}}</td>
                                            <td>
                                                <button ng-if="xx.DocumentFile" class="btn btn-sm"
                                                        ng-click="ViewFileC(xx.DocumentFile)">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                <button ng-if="xx.DocumentFile" class="btn btn-sm"
                                                        ng-click="DownloadFileC(xx.DocumentFile, xx.DocumentName)">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                            </td>
                                            <td>
                                                <p style="color:green;" ng-if="xx.APercentage == 'Save without Error, Accuracy 100 %.'">
                                                    Save without Error, Accuracy 100 %.

                                                    <i class="bi bi-info-circle"
                                                       style="cursor:pointer; margin-left:8px; color:blue;"
                                                       ng-click="showDetailPopup(xx.Detail)">
                                                    </i>
                                                </p>

                                                <p style="color:red;" ng-if="xx.APercentage != 'Save without Error, Accuracy 100 %.'">
                                                    {{xx.APercentage}}

                                                    <i class="bi bi-info-circle" ng-if="xx.APercentage"
                                                       style="cursor:pointer; margin-left:8px; color:blue;"
                                                       ng-click="showDetailPopup(xx.Detail)">
                                                    </i>
                                                </p>
                                            </td>

                                        </tr>



                                    </tbody>

                                </table>




                            </div>
                        </div>

                    </div>

                    <!-- FOOTER -->
                    <div class="modal-footer justify-content-end" style="background: var(--card-bg)">
                        <button class="btn btn-sm cv-btn-outline" id="btnCancel" ng-click="BindControl()"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        @*<button class="btn btn-sm cv-btn-outline">
                                Save Draft
                            </button>

                            <button class="btn btn-sm cv-btn-primary">
                                Submit
                            </button>*@
                    </div>

                </div>
            </div>
        </div>


    </div>
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title">Validation Detail</h4>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body" ng-bind-html="SelectedDetail">
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-danger"
                            data-bs-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

