
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Compliance Audit Report";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/scripts/myjslib/AuditorComplianceController.js"></script>
<style>
    
     
    #complianceAuditReport {
        font-family: "Inter", sans-serif;
        --primary: #022B5E;
        --primary-dark: #033d84;
        --bg: #FFFFFF;
        --card-bg: #fff;
        --border: #D9D9D9;
        --text: #1F2937;
        --muted: #6B7280;
        --radius: 12px;
        background: var(--bg);
        min-height: 100vh;
        color: var(--text);
    }

    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    /* Section cards */
    #complianceAuditReport .section-card {
        background: transparent;
        border: none;
    }

        #complianceAuditReport .section-card .card-body {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            min-height: 320px;
        }

#complianceAuditReport .audit-info-row {
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 0.82rem;
}

#complianceAuditReport .audit-info-item {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

#complianceAuditReport .audit-label {
    font-weight: 500;
    color: #555;
}

#complianceAuditReport .audit-value {
    font-weight: 600;
    color: #223;
}

#complianceAuditReport .audit-info-divider {
    width: 1px;
    height: 18px;
    background: #ddd;
}



 /* KPI CARDS */
    .kpi-card {
    background: #fff;
    border-radius: 14px;
    padding: 12px 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    border-left: 5px solid #022B5E;
    transition: 0.2s ease;
    align-items: center;
    justify-content: space-between;
}

    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    }

.kpi-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: #555;
}

.kpi-value {
    font-size: 1.4rem;
    font-weight: 700;
    margin-top: 4px;
    color: #022B5E;
}


    /* Table wrapper and hide scrollbar visually */
    #complianceAuditReport .small-table-wrapper .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: smooth;
        position: relative;
    }

        #complianceAuditReport .small-table-wrapper .table-responsive::-webkit-scrollbar {
            display: none;
        }

    /* table header sticky */
    #complianceAuditReport .small-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #F8f9fd;
        color: Var(--primary);
        font-weight: 600;
        font-size: 0.78rem;
          text-align: justify;
        vertical-align: middle;
/*        white-space: nowrap;*/
        padding: 4px 6px;
    }

    /* table body */
    #complianceAuditReport .small-table tbody td {
        background-color: var(--card-bg);
        font-size: 0.78rem;
        vertical-align: middle;
       text-align: justify;
        padding: 2px 6px;
        /*white-space: nowrap;*/
    }

    /* hover */
    #complianceAuditReport .small-table tbody tr:hover td {
        background-color: #F8f9fc;
    }


    /* filter button */
    #complianceAuditReport .filter-btn {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #complianceAuditReport .filter-btn.active,
        #complianceAuditReport .filter-btn:hover {
            background: var(--primary);
            color: #fff;
        }

    /* small inputs */
    #complianceAuditReport .table-toolbar .form-control-sm {
        height: 36px;
        border-radius: 999px;
        border-color: var(--primary);
    }

    /* Export button (rounded) */
    #complianceAuditReport .export-btn {
        border-radius: 999px;
        color: #fff;
        background: var(--primary);
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
        -webkit-tap-highlight-color: transparent;
    }

        #complianceAuditReport .export-btn:hover {
            background: var(--primary-dark);
        }

        /* remove default dark flash on click for export and other action buttons while keeping subtle ring on focus */
        #complianceAuditReport .export-btn:focus,
        #complianceAuditReport .export-btn:active {
            outline: none;
            box-shadow: 0 0 0 3px rgba(228,93,39,0.12);
        }

    /*Fix Search bar and button in toolbar*/
    #complianceAuditReport .table-toolbar .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    #complianceAuditReport .table-toolbar .input-group .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-color: var(--primary);
    }


    /* Table Buttons*/

    .btn-upload, .btn-view, .btn-submit {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.78rem;
    }

        .btn-upload:hover, .btn-view:hover, .btn-submit:hover {
            background: var(--primary);
            color: #fff;
        }

    /* Table Selects*/

    #complianceAuditReport .form-control {
        font-size: .78rem;
        padding: 2px 8px;
        border-radius: 6px;
        border: 1px solid #dcdcdc;
        outline: none;
        min-width: 200px;
    }
</style>
<div id="complianceAuditReport" class="px-4 py-2">
    <div class="card section-card">
        <h4 class="mt-3" style="color: #022B5E">Compliance Audit Report  [{{DocumentStatus}}  ]</h4>

        <!-- Audit Details  -->
        <div class="audit-info-row">
            <div class="audit-info-item">
                <span class="audit-label">Audit Score</span>
                <span class="audit-value">Score Obtained: {{TotalComplianceScoreAchieved}}</span>
            </div>

            <div class="audit-info-divider"></div>

            <div class="audit-info-item">
                <span class="audit-label">Compliance Score</span>
                <span class="audit-value">{{ScorePer}}%</span>
            </div>

            <div class="audit-info-divider"></div>

            <div class="audit-info-item">
                <span class="audit-label">Date of Audit Report</span>
                <span class="audit-value">   {{AuditDate}}</span>
            </div>
        </div>

        <!-- KPI Bar  -->
        <div class="container my-4">
            <div class="row g-3">

                <!-- Compliance Score-->
                @*<div class="col-md-3">
                    <div class="kpi-card d-flex">
                        <div class="kpi-title">  Name of Auditor</div>
                        <div class="kpi-value">     {{Auditer}}</div>
                    </div>
                </div>*@

                <!-- High Risk -->
                <div class="col-md-4">
                    <div class="kpi-card d-flex">
                        <div class="kpi-title">   {{TypeInvoice}}</div>
                        <div class="kpi-value">   {{VendorInvNum}}</div>
                    </div>
                </div>

                <!-- Medium Risk -->
                <div class="col-md-4">
                    <div class="kpi-card d-flex">
                        <div class="kpi-title">{{InvoiceDate}}</div>
                        <div class="kpi-value">         {{InvDate}}</div>
                    </div>
                </div>

                <!-- Low Risk -->
                <div class="col-md-4">
                    <div class="kpi-card d-flex">
                        <div class="kpi-title">  Audit Month</div>
                        <div class="kpi-value">  {{MONTH}}</div>
                    </div>
                </div>

            </div>
        </div>


        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                @*<div class="d-flex align-items-center gap-2">

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Nature
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Return</a></li>
                            <li><a class="dropdown-item" href="#">Nature</a></li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Filter2
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Option1</a></li>
                            <li><a class="dropdown-item" href="#">Option2</a></li>
                        </ul>
                    </div>

                    <button class="btn btn-sm filter-btn active">Go</button>
                </div>*@

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="scSearch" type="text" ng-model="Search" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: #022B5E" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#" ng-click="exportCSV()">CSV</a></li> 
                                <li><a class="dropdown-item" href="#" ng-click="printTable()">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table" ng-init="LoadData()" id="printTable" >
                        <thead>
                            <tr>
								<th style="width:3%">S.No</th>
								<th style="width:19%">Act</th>
								<th style="width:13%">Forms/Description </th>
								<th style="width:21%">Nature of Compliance</th>
								<th style="width:8%">Compliance Score</th>
								<th style="width:8%">Compliance Score achieved</th>
								<th style="width:8%">Compliance Status</th>
								<th style="width:11%">Auditor Remarks</th>
								<th style="width:11%">Vendor Remarks</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr ng-repeat="x in DocList | filter : Search">
                                <td >
                                    <input type="hidden" ng-model="AuditorList[$index].DocId" ng-init="AuditorList[$index].DocId=x.Id" />
                                    <input type="hidden" ng-model="AuditorList[$index].SrNo" ng-init="AuditorList[$index].SrNo=x.Id" value="{{x.Id}}" />
                                    {{x.SRNO}}
                                <td  ng-init="AuditorList[$index].Act=x.Act">{{x.Act}}</td>
                                <td  ng-init="AuditorList[$index].Form=x.Form">{{x.Form}}</td>
                                <td  ng-init="AuditorList[$index].Nature=x.Nature">{{x.Nature}} </td>
                                <td  ng-init="AuditorList[$index].ComplianceScore=x.ComplianceScore">{{x.ComplianceScore}} </td>
                                <td  ng-init="AuditorList[$index].ComplianceScoreAchieved=x.ComplianceScoreAchieved">{{x.ComplianceScoreAchieved}} </td>
                                <td  ng-init="AuditorList[$index].CSS=x.CSS">{{x.CSS}} </td>
                                <td  ng-init="AuditorList[$index].Remark=x.Remark">{{x.Remark}} </td>
                                <td  ng-init="AuditorList[$index].VendorRemark=x.VendorRemark">
                                    <p ng-show="FinalSave =='2'">{{x.VendorRemark}}</p>
                                    <div ng-hide="FinalSave =='2'">
                                        <textarea type="text" class="form-control-capitalize hidecss" ng-disabled="NotOpenforClient !='2'" ng-model="AuditorList[$index].VendorRemark" onkeyup="this.value = this.value.replace(/[^a-zA-Z0-9'! ?.-]+/g, '')" ng-init="AuditorList[$index].VendorRemark=x.VendorRemark"></textarea>
                                    </div>

                                </td>
                            </tr>
                            <tr>
                                <td colspan="3"></td>
                                <td>
                                    Total :
                                </td>
                                <td ng-init="AuditorList[$index].TotalComplianceScore=x.TotalComplianceScore">{{TotalComplianceScore}}</td>
                                <td ng-init="AuditorList[$index].TotalComplianceScoreAchieved=x.TotalComplianceScoreAchieved">{{TotalComplianceScoreAchieved}}</td>
                                <td ng-show="NotOpenforClient =='2'">
                                    <button id="btnSave" type="button" value="Save" class="btn btn-sm export-btn no-print" ng-disabled="FinalSave =='2'"
                                            name="SaveButton" ng-model="Save" ng-click="VendorDraftRecord()">
                                        <span class="triangle-box" title="Print"></span>
                                        <span>Save </span>
                                    </button>
                                </td>


                                <td colspan="2"></td>
                            </tr>
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    </div>
</div>