@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Principle Employer Gate Pass";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Content/Dashboards/GatePass/PrincipleEmployerGatePass/style.css" rel="stylesheet" />
<script src="~/scripts/bharat/ContractorGatePassController.js"></script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    try {

    /*=========================================
        Permanent / Temporary Tabs
    =========================================*/

    const tabs = document.querySelectorAll(".principleEmployerGatePass .gpTypeTabs .nav-link");

    tabs.forEach(tab => {

        tab.addEventListener("click", function () {

            tabs.forEach(t => t.classList.remove("active"));

            this.classList.add("active");

        });

    });

    /*=========================================
        Select All (Main Table)
    =========================================*/

    const mainTable = document.querySelector(".principleEmployerGatePass .gpTable");

    if (mainTable) {

        const headerCheckbox = mainTable.querySelector("thead .form-check-input");

        const rowCheckboxes = mainTable.querySelectorAll("tbody .form-check-input");

        if (headerCheckbox) {
            headerCheckbox.addEventListener("change", function () {

                rowCheckboxes.forEach(cb => {

                    cb.checked = this.checked;

                });

            });
        }

    }

    /*=========================================
        Select All (Worker Modal Table)
    =========================================*/

    const workerTable = document.querySelector(".principleEmployerGatePass .workerTable");

    if (workerTable) {

        const headerCheckbox = workerTable.querySelector("thead .form-check-input");

        const rowCheckboxes = workerTable.querySelectorAll("tbody .form-check-input");

        if (headerCheckbox) {
            headerCheckbox.addEventListener("change", function () {

                rowCheckboxes.forEach(cb => {

                    cb.checked = this.checked;

                });

            });
        }

    }

    } catch (e) {
        console.error('GatePass init error (non-fatal):', e);
    }

});

</script>

<div class="principleEmployerGatePass px-4 py-3">

    <!-- ===========================================
        Header
    =========================================== -->
    <div class="pegp-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <h2 class="page-title mb-0">
            Gate Pass Approval Requests
        </h2>

        @*<ul class="nav nav-tabs gpTypeTabs border-0">
            <li class="nav-item">
                <button class="nav-link active">
                    Permanent
                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link">
                    Temporary
                </button>
            </li>
        </ul>*@

    </div>

    <!-- ===========================================
        Summary Cards
    =========================================== -->

    <div class="row g-4 mb-4">

        <!-- Pending -->

        <div class="col-xl-4 col-md-6">

            <div class="gpSummaryCard pendingCard">

                <div class="cardContent">

                    <div>

                        <p class="cardLabel">
                            Total Pending
                        </p>

                        <h2 class="cardValue">
                            {{DTiles.WorkerPending}}
                        </h2>

                    </div>

                    <div class="summaryIcon pending">

                        <i class="bi bi-clipboard-check"></i>

                    </div>

                </div>

            </div>

        </div>

        <!-- Approved -->

        <div class="col-xl-4 col-md-6">

            <div class="gpSummaryCard approvedCard">

                <div class="cardContent">

                    <div>

                        <p class="cardLabel">
                            Approved Today
                        </p>

                        <h2 class="cardValue text-success">
                            {{DTiles.TodayApproved}}
                        </h2>

                    </div>

                    <div class="summaryIcon approved">

                        <i class="bi bi-check-circle-fill"></i>

                    </div>

                </div>

            </div>

        </div>

        <!-- Rejected -->

        <div class="col-xl-4 col-md-12" ng-init="Bindtiles()">

            <div class="gpSummaryCard rejectedCard">

                <div class="cardContent">

                    <div>

                        <p class="cardLabel">
                            Rejected
                        </p>

                        <h2 class="cardValue text-danger">
                            {{DTiles.Rejected}}
                        </h2>

                    </div>

                    <div class="summaryIcon rejected">

                        <i class="bi bi-x-circle-fill"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ===========================================
        Table Card
    =========================================== -->

    <div class="gpTableCard">

        <!-- Toolbar -->

        @*<div class="gpTableToolbar" >

            <div class="d-flex align-items-center gap-2">

                <select class="form-select statusFilter">

                    <option>
                        Status : Pending
                    </option>

                    <option>
                        Approved
                    </option>

                    <option>
                        Rejected
                    </option>

                </select> 

            </div>

            <div class="toolbarButtons">

                <button class="btn rejectBtn">

                    <i class="bi bi-x-lg me-2"></i>

                    Reject Selected

                </button>

                <button class="btn approveBtn">

                    <i class="bi bi-check2 me-2"></i>

                    Approve Selected

                </button>

            </div>

        </div>*@

        <!-- Responsive Table -->

        <div class="table-responsive" ng-init="BindClientWorker()">

            <table class="table align-middle gpTable" >

                <thead>

                    <tr>

                        

                        <th>
                            Contractor Name
                        </th>

                        <th>
                            Total Worker Count
                        </th>

                        <th>
                            Pending Worker Count
                        </th>

                        <th>
                            Date Requested
                        </th>
                        
                       

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <!-- Row -->

                    <tr ng-repeat="x in EmpWorkerList">
                        

                        <td>

                            <strong>
                                {{x.PartyName}}
                            </strong>

                        </td>

                        <td>

                            <span class="workerCountTag">
                                {{x.TotalUser}}
                            </span>

                        </td>

                        <td>

                            <span class="workerCountTag">
                                {{x.WorkerPending}}
                            </span>

                        </td>

                        <td>

                            {{x.CreatedOn}}

                        </td>

                        
                        <td class="text-center">

                            <button class="iconBtn" ng-click="Getallgatepassbyparty(x)"
                                    data-bs-toggle="modal"
                                    data-bs-target="#workerListModal">

                                <i class="bi bi-eye"></i>

                            </button>

                        </td>

                    </tr>

                    <tr ng-if="!EmpWorkerList || EmpWorkerList.length == 0">
                        <th colspan="5" class="text-center text-muted py-3" style="color: #27515e !important;">
                            Gate Pass Not Generated
                        </th>
                    </tr>
                    

                </tbody>

            </table>

        </div>

