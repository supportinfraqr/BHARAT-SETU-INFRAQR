                    <li class="page-item">

                        <a class="page-link" href="#">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>*@

    </div>


    <!-- =====================================================
        Worker List Modal
    ====================================================== -->

    <div class="modal fade"
         id="workerListModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-fullscreen">

            <div class="modal-content workerListModal">

                <!-- Header -->

                <div class="modal-header">

                    <h5 class="modal-title">
                        Worker List
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <!-- Body -->

                <div class="modal-body">

                    <!-- Toolbar -->

                    <div class="workerToolbar">

                        <div></div>

                        <div class="toolbarRight">

                            <button class="btn rejectBtn" ng-click="RejectSection()">

                                <i class="bi bi-x-lg me-2"></i>

                                Reject Selected

                            </button>

                            <button class="btn approveBtn" ng-click="ApprovalSection()">

                                <i class="bi bi-check2 me-2"></i>

                                Approve Selected

                            </button>

                            <select class="form-select siteFilter"
                                    ng-model="SelectedSite"
                                    ng-change="FilterWorker()">

                                <option value="">All Sites</option>

                                <option ng-repeat="x in WorkerList1 | unique:'SiteName'"
                                        value="{{x.SiteName}}">
                                    {{x.SiteName}}
                                </option>

                            </select>

                        </div>

                    </div>

                    <!-- Table -->

                    <div class="table-responsive rounded-3">

                        <table class="table workerTable align-middle">

                            <thead>

                                <tr>

                                    <th width="40">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               ng-model="selectAll"
                                               ng-change="toggleAll()" />

                                    </th>

                                    <th>Worker Details</th>

                                   

                                    <th>Site</th>

                                    <th>Medical</th>

                                    <th>Safety Kit</th>

                                    <th>Safety Training</th>

                                    <th>Site Induction</th>

                                    <th>Aadhaar</th>

                                    <th>Bank Account</th>

                                    <th>UAN</th>

                                    <th>PF</th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                <!-- ========= Row ========= -->

                                <tr ng-repeat="x in WorkerList | filter:SiteFilter">

                                    <td>
                                        <input type="checkbox"
                                               class="form-check-input"
                                               ng-model="x.Selected"
                                               ng-change="updateSelection()" />
                                    </td>

                                    <td>

                                        <div class="workerInfo">

                                            <div class="workerName">

                                                {{x.EmployeeName}}

                                            </div>
                                            <div class="workerName">

                                                {{x.GatePassType}}

                                            </div>

                                            <div class="workerId">

                                                {{x.EmployeeCode}}

                                            </div>

                                        </div>

                                    </td>

                                    <td>  {{x.SiteName}}</td>



                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.MedicalStatus == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.MedicalStatus == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.MedicalStatus}}</small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.PPE == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.PPE == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.PPE}}</small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.SafetyTrainingStatus == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.SafetyTrainingStatus == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.SafetyTrainingStatus}}</small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.SiteInduction == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.SiteInduction == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.SiteInduction}}</small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.AadharVerify == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.AadharVerify == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.AadharVerify}}</small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.BankVerify == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.BankVerify == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.BankVerify}}</small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.UANVerify == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.UANVerify == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.UANVerify}}</small>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="verifyStatus"
                                             ng-class="x.PFVerify == 'Done' ? 'done' : 'pending'">
                                            <i class="bi"
                                               ng-class="x.PFVerify == 'Done' ? 'bi-check-circle-fill' : 'bi-dash-circle-fill'"></i>
                                            <small>{{x.PFVerify}}</small>
                                        </div>
                                    </td>
                                    <td class="text-center">

                                        <button class="tableActionBtn approve"   
                                               ng-click="IndiviualApprove(x.EmployeeId,'1','2')" >

                                            <i class="bi bi-check2-square"></i>

                                        </button>

                                        <button class="tableActionBtn reject" 
                                                ng-click="IndiviualRefect(x.EmployeeId,'2','2')" >

                                            <i class="bi bi-ban"></i>

                                        </button>

                                    </td>

                                </tr>



                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>