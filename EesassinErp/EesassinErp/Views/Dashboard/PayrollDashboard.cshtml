                                <h2 class="fw-medium mb-2" style="color: #E45D27; font-size: 1.5rem;">Payroll Summary</h2>
                                <button class="btn btn-sm btn-primary" id="payroll-btn">Generate Payroll</button>
                            </div>

                            <!-- Summary Section -->
                            <div class="summary-card p-4 rounded-3">

                                <!-- Dropdowns -->
                                <div class="d-flex gap-2 mb-4 flex-wrap">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                                            Year
