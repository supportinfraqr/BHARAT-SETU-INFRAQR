    <nav class="navbar px-4">
        <!-- Left logo -->
        <div class="nav-left">
            <img src="~/PayrollDashboard/assets/icons/logo.svg" alt="Logo" class="logo" />
        </div>

        <!-- Center nav items -->
        <div class="nav-center d-flex gap-3">
            <!-- Dashboard dropdown -->
            <div class="dropdown">
                <button class="dropbtn d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                    Dashboard
                    <img src="~/PayrollDashboard/assets/icons/DropArrow.svg" class="arrow ms-1" alt="Arrow">
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#">Dashboard 1</a></li>
                    <li><a class="dropdown-item" href="#">Dashboard 2</a></li>
                    <li><a class="dropdown-item" href="#">Dashboard 3</a></li>
                </ul>
            </div>

            <!-- Master dropdown -->
            <div class="dropdown">
                <button class="dropbtn d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                    Master
                    <img src="~/PayrollDashboard/assets/icons/DropArrow.svg" class="arrow ms-1" alt="Arrow">
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#">Master 1</a></li>
                    <li><a class="dropdown-item" href="#">Master 2</a></li>
                    <li><a class="dropdown-item" href="#">Master 3</a></li>
                </ul>
            </div>

            <!-- Report dropdown -->
            <div class="dropdown">
                <button class="dropbtn d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                    Report
                    <img src="~/PayrollDashboard/assets/icons/DropArrow.svg" class="arrow ms-1" alt="Arrow">
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#">Report 1</a></li>
                    <li><a class="dropdown-item" href="#">Report 2</a></li>
                    <li><a class="dropdown-item" href="#">Report 3</a></li>
                </ul>
            </div>
        </div>

        <!-- Right icons & profile -->
        <div class="nav-right d-flex align-items-center gap-3">

            <!-- SEARCH WRAPPER -->
            <div class="search-wrapper position-relative">
                <img src="~/PayrollDashboard/assets/icons/search.svg"
                     alt="Search" id="search-icon" class="icon cursor-pointer">
                <input type="text" id="search-field" placeholder="Search..." class="search-input">
            </div>

            <img src="~/PayrollDashboard/assets/icons/notify.svg"
                 alt="Notify" class="icon cursor-pointer">

            <!-- USER SWITCH DROPDOWN -->
            <div class="dropdown position-relative">
                <img src="~/PayrollDashboard/assets/icons/user-switch.svg"
                     alt="UserSwitch"
                     class="icon cursor-pointer dropdown-toggle"
                     id="userSwitchDropdown"
                     data-bs-toggle="dropdown"
                     title="Switch Profile">
