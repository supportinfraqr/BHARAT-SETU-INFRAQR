                                        </div>

                                        <!-- TRRN Number -->
                                        <div class="col-md-3">
                                            <label class="form-label">TRRN Number</label>
                                            <input type="text" class="form-control" id="txtTRRN_esic">
                                        </div>

                                        <!-- Payment Date -->
                                        <div class="col-md-3">
                                            <label class="form-label">Payment Date</label>
                                            <input type="date" class="form-control" id="txtPaymentDate_esic">
                                        </div>

                                        <!-- Payment Amount -->
                                        <div class="col-md-3">
                                            <label class="form-label">Payment Amount</label>
                                            <input type="number" class="form-control" id="txtPaymentAmount_esic">
                                        </div>

                                        <!-- Payment Confirmation Number -->
                                        <div class="col-md-3">
                                            <label class="form-label">Payment Confirmation Number</label>
                                            <input type="text" class="form-control" id="txtPaymentConfirmation_esic">
                                        </div>

                                        <!-- Employee Contribution -->
                                        <div class="col-md-3">
                                            <label class="form-label">Employee Contribution</label>
                                            <input type="number" class="form-control" id="txtEmpContribution_esic">
                                        </div>

                                        <!-- Employer Contribution -->
                                        <div class="col-md-3">
                                            <label class="form-label">Employer Contribution</label>
                                            <input type="number" class="form-control" id="txtEmployerContribution_esic">
                                        </div>

                                        <!-- Challan Copy -->
                                        <div class="col-md-3">
                                            <label class="form-label">Challan Copy</label>
                                            <input type="file" class="form-control" id="fuChallanCopy_esic">
                                        </div>

                                        <!-- Payment Receipt -->
                                        <div class="col-md-3">
                                            <label class="form-label">Payment Receipt</label>
                                            <input type="file" class="form-control" id="fuPaymentReceipt_esic">
                                        </div>

                                    </div> <!-- /.row -->
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="modal-footer border-0 p-4" style="background:transparent;">
                                <div class="w-100 d-flex justify-content-end gap-2">
                                    <button type="button" class="btn" id="btnCloseESIC" data-bs-dismiss="modal" style="background:var(--primary); color:#fff;">Close</button>
                                    <button type="button" class="btn" id="btnUpdateESIC" style="background:var(--primary); color:#fff;">
                                        Update ESIC
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>


