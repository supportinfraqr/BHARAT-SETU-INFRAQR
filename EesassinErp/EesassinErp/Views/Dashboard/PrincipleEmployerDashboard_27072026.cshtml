    <!-- ROW 4 -->
    <div class="peRowGrid" style="display:none">

        <div class="peCard fullWidthCard">

            <div class="tableCardHeader">
                <h3 class="sectionTitle mb-0">Compliance History</h3>
            </div>

            <div class="tableScrollWrap largeTableWrap">

                <table class="table peTable">
                    <thead>
                        <tr>
                            <th>Site ID</th>
                            <th>Contractor ID</th>
                            <th>Total Workers</th>
                            <th>Salary Paid</th>
                            <th>Date of Payment</th>
                            <th>PF Deposited</th>
                            <th>Date of Deposit (PF)</th>
                            <th>ESIC Deposited</th>
                            <th>Date of Deposit (ESIC)</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>


                        <tr>
                            <td>SIGI0526DL01</td>
                            <td>SIGI0526DL01</td>
                            <td>421</td>
                            <td>421</td>
                            <td>07/05/2026</td>
                            <td>421</td>
                            <td>07/05/2026</td>
                            <td>421</td>
                            <td>07/05/2026</td>
                            <td>
                                <button class="tableActionBtn">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>


                    </tbody>
                </table>

            </div>

            <div class="tableFooterBtn">
                <button class="viewAllBtn">
                    View All
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>

        </div>

    </div>

    <!-- LAST ROW -->
    <div class="peBottomGrid">

        <!-- LEFT -->
        <div class="peCard tableCard">

            <div class="tableCardHeader">
                <h3 class="sectionTitle mb-0">Worker Compliance Overview</h3>
            </div>

            <div class="tableScrollWrap smallTableWrap" ng-init="BindEmployeeSite()">

                <table class="table peTable">
                    <thead>
                        <tr>
                            <th>Worker ID</th>
                            <th>Worker Name</th>
                            <th>Contractor Name</th>
                            <th>Site</th>
                            <th>Gate Pass</th>
                            <th>Medical Exam</th>
                            <th>Health & Safety</th>
                        </tr>
                    </thead>

                    <tbody>


                        <tr ng-repeat="x in EmployeeSiteList  | filter:{VName: SearchText}">

                            <td>{{x.EmployeeCode}}</td>
                            <td>
                                {{x.EmployeeName}}
                            </td>
                            <td>{{x.VName}}</td>
                            <td>{{x.SiteName}}</td>

                            <td>
                                <span class="statusPill"
                                      ng-class="x.GatePassStatus == 'Valid' ? 'greenPill' : 'redPill'">
                                    {{x.GatePassStatus}}
                                </span>
                            </td>

                            <td>
                                <span class="statusPill"
                                      ng-class="x.MedicalStatusResult == 'Done' ? 'greenPill' : 'redPill'">
                                    {{x.MedicalStatusResult}}
                                </span>
                            </td>

                            <td>
                                <span class="statusPill"
                                      ng-class="x.FitnessStatus == 'Done' ? 'greenPill' : 'redPill'">
                                    {{x.FitnessStatus}}
                                </span>
                            </td>

                        </tr>


                    </tbody>
                </table>

            </div>

        </div>

        <!-- CENTER -->
        <div class="peCard">

            <div class="tableCardHeader" ng-init="BindWorkerCerifitacte()">
                <h3 class="sectionTitle mb-0">Worker Verified Documents</h3>
            </div>

            <div class="verifiedDocWrap expiryAlertWrap ">
                <div class="verifiedItem">
                    <span>PAN Card</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.PANCardPercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.PANCardPercentage | number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Cheque / Passbook</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.ChequePassbookPercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.ChequePassbookPercentage| number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Education Certificate</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.EducationCertificatePercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.EducationCertificatePercentage | number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Experience Certificate</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.ExperienceCertificatePercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.ExperienceCertificatePercentage | number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Aadhaar Front</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.AdhaarFrontPercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.AdhaarFrontPercentage | number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Aadhaar Back</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.AdhaarBackPercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.AdhaarBackPercentage | number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Relieving Letter</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.RelievingLetterPercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.RelievingLetterPercentage | number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Payslip</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.PayslipPercentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.PayslipPercentage | number:2}}%</strong>
                </div>

                <div class="verifiedItem">
                    <span>Photo </span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.Photo1Percentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.Photo1Percentage | number:2}}%</strong>
                </div>
                <div class="verifiedItem">
                    <span>Appointment Letter</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.Photo2Percentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.Photo2Percentage | number:2}}%</strong>
                </div>
                <div class="verifiedItem">
                    <span>TIC Card</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.Photo3Percentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.Photo3Percentage | number:2}}%</strong>
                </div>
                <div class="verifiedItem">
                    <span>Signature</span>

                    <div class="verifiedProgress">
                        <div class="verifiedProgressBar"
                             ng-style="{'width': dashboard.Photo4Percentage + '%'}">
                        </div>
                    </div>

                    <strong>{{dashboard.Photo4Percentage | number:2}}%</strong>
                </div>




            </div>

        </div>

        <!-- RIGHT -->
