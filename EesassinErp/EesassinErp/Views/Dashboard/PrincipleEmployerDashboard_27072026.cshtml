@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Principle Employer Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<link href="~/Content/Dashboards/PrincipleEmployerDashboard/style.css" rel="stylesheet" />
<script src="~/Content/Dashboards/PrincipleEmployerDashboard/script.js"></script>
<script src="~/scripts/RetailJsLib/PrincipleEmployerCodeController.js"></script>


<script> 
    $(document).on("click", ".siteSegment-btn", function () {

        var target = $(this).data("tab");

        $(".siteSegment-btn").removeClass("active");
        $(this).addClass("active");

        $(".employeeManualPanel").removeClass("active");
        $("#" + target).addClass("active");

    });
</script>

<style>
    span.statusPill.ng-binding.redPill {
        background: #FCDDDC !important;
        color: #a31c16 !important;
    }
</style>

<div class="principleEmpDashboard px-4 py-3">

    <!-- PAGE HEADER -->
    <div class="peDashHeader" ng-init="BindEmployerDashboard();BindTiles()">
        <div>
            <p class="welcomeText mb-1" hidden>Welcome back, {{DashboardDetail1.UserName}}</p>

            <div class="d-flex flex-column gap-2 flex-wrap">
                <h6 class="dashboardTitle mb-0" style="font-size:1.7rem">{{DashboardDetail1.PartyName}}  <span style="font-size:1.3rem;font-weight:500;">({{DashboardDetail1.PartyCode}})</span></h6>
            </div>
        </div>

        <div class="statusBadge active">
            Active
        </div>
    </div>

    <!-- KPI ROW -->
    <div class="peKpiGrid">


        <div class="peKpiCard blueCard" style="background: #F3F8FF">
            <div class="kpiIcon blue">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="kpiContent">
                <h3>{{DashboardDetail.VendorCount}}</h3>
                <p style="color: #155DFC">Total Contractors</p>

                <span class="kpiGrowth">
                    <i class="bi bi-graph-up-arrow"></i>
                    {{DashboardDetail.VendorPercentage}} % vs FY {{DashboardDetail.Currentyear}}
                </span>
            </div>
        </div>

        <div class="peKpiCard purpleCard" style="background: #F9F4FF">
            <div class="kpiIcon purple">
                <i class="bi bi-person-workspace"></i>
            </div>

            <div class="kpiContent">
                <h3>{{DashboardDetail.WorkerCount}}</h3>
                <p style="color: purple">Total Workers</p>

                <span class="kpiGrowth">
                    <i class="bi bi-graph-up-arrow"></i>
                    {{DashboardDetail.EmployeePercentage}} % vs FY {{DashboardDetail.Currentyear}}
                </span>
            </div>
        </div>

        <div class="peKpiCard blueCard" style="background: #F3F5FF">
            <div class="kpiIcon blue">
                <i class="bi bi-shield-check"></i>
            </div>

            <div class="kpiContent">
                <h3>{{DashboardDetail.SiteCount}}</h3>
                <p style="color: #003BB2">Active Sites</p>

                <span class="kpiGrowth">
                    <i class="bi bi-graph-up-arrow"></i>
                    {{DashboardDetail.SitePercentage}} % vs FY {{DashboardDetail.Currentyear}}
                </span>
            </div>
        </div>

        <div class="peKpiCard greenCard" style="background: #F3FFF7">
            <div class="kpiIcon green">
                <i class="bi bi-check2-circle"></i>
            </div>

            <div class="kpiContent">
                <h3>{{DashboardDetail.EmployeeOtherCity}}</h3>
                <p style="color: green">InterState migrant Workers</p>

                <span class="kpiGrowth">
                    <i class="bi bi-graph-up-arrow"></i>
                    {{DashboardDetail.EmployeePercentage }} % vs FY {{DashboardDetail.Currentyear}}
                </span>
            </div>
        </div>

    </div>

    <!-- ROW 1 HEADER -->
    <div class="sectionHeader" ng-init="BindActiveConstructionSite()">

        <div>
            <h3 class="sectionMainTitle">Active Sites</h3>
       
        </div>

        <a href="../Dashboard/Principlesitesoverview" style="text-decoration: none;">
            <button class="sectionViewAllBtn">
                View All
                <i class="bi bi-arrow-right"></i>
            </button>
        </a>


    </div>

    <!-- ROW 1 : SITE CARDS -->
    <div class="peRowGrid fourColGrid">

        <!-- CARD -->
        <div class="peCard siteCard" ng-repeat="x in ActiveConstructionSiteList">

            <div class="siteCardHeader">
                <div class="siteIcon">
                    <i class="bi bi-buildings"></i>
                </div>

                <div class="flex-grow-1">
                    <h4>{{x.SiteName}}</h4>

                    <p>
                        <i class="bi bi-geo-alt"></i>
                        {{x.Address}}
                    </p>
                </div>

                <span class="siteStatus">{{x.Status}}</span>
            </div>

            <div class="siteStatsWrap">

                <div class="siteStat">
                    <span>Contractors</span>
                    <strong>{{x.VendorCount}}</strong>
                </div>

                <div class="siteStat">
                    <span>Workers</span>
                    <strong>{{x.EmployeeCount}}</strong>
                </div>

            </div>

            <div class="complianceProgressWrap">
                <div class="d-flex justify-content-between mb-1">
                    <span>Average Compliance Score</span>
                    <strong>{{x.CompliancePercentage}}%</strong>
                </div>

                <div class="progress peProgressBar">
                    <div class="progress-bar"
                         ng-style="{'width': x.CompliancePercentage + '%'}">
                    </div>
                </div>
            </div>

            <button class="viewBtn" data-bs-toggle="modal" data-bs-target="#viewSiteModal" ng-click="SearchSitebyId(x.SiteId)">
                <i class="bi bi-eye"></i>
                View
            </button>

        </div>



    </div>

    <!-- ROW 2 -->
    <div class="peRowGrid fourColGrid">

        <div class="peCard complianceCard" ng-init="BindMedicalExamination()">
            <h3 class="sectionTitle">Medical Examination Compliance</h3>

            <div class="complianceCardBody">
                <div class="complianceScoreWrap orangeText">
                    <h2>{{MedicalExaminationlist.FitPercentage}}%</h2>
                    <span>Compliance score</span>
                </div>

                <div class="complianceDetails">
                    <div><span>Total Workers</span><strong>{{MedicalExaminationlist.WorkerCount}}</strong></div>
                    <div><span>Fit To Work</span><strong>{{MedicalExaminationlist.MedicalStatusYesCount}}</strong></div>
                    <div><span>Unfit / Temporarily Unfit</span><strong>{{MedicalExaminationlist.UnfitCount}}</strong></div>
                    <div><span>Due for Medical</span><strong>{{MedicalExaminationlist.ExpiredMedicalCount}}</strong></div>
                </div>
            </div>
        </div>

        <div class="peCard complianceCard" ng-init="BindHealth()">
            <h3 class="sectionTitle">Health & Safety Compliance</h3>

            <div class="complianceCardBody">
                <div class="complianceScoreWrap">
                    <h2>
                        {{HealthList.PPEPercentage }}%
                    </h2>
                    <span>Compliance score</span>
                </div>

                <div class="complianceDetails">
                    <div>
                        <span>Total Workers</span><strong>
                            {{HealthList.TotalEmployee}}
                        </strong>
                    </div>
                    <div>
                        <span>Safety Kit Issued</span><strong>
                            {{HealthList.PPEYesCount  }}
                        </strong>
                    </div>
                    <div><span>Safety Training</span><strong>{{HealthList.SafetyTrainingYesCount}}</strong></div>
                    <div>
                        <span>Site Induction</span><strong>
                            {{HealthList.SiteInductionYesCount}}
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="peCard complianceCard" ng-init="Bindgatepass()">
            <h3 class="sectionTitle">Gate Pass Compliance</h3>

            <div class="complianceCardBody">
                <div class="complianceScoreWrap">
                    <h2>{{gatepasslist.Percentage}}%</h2>
                    <span>Compliance score</span>
                </div>

                <div class="complianceDetails">
                    <div><span>Total Worker</span><strong>{{DashboardDetail.WorkerCount}}</strong></div>
                    <div><span>Gate Pass Issued</span><strong>{{gatepasslist.Totalgatepss}}</strong></div>
                    <div><span>Active</span><strong>{{gatepasslist.ActiveCount}}</strong></div>
                    <div><span>Expired</span><strong>{{gatepasslist.ExpiredCount}}</strong></div>
                </div>
            </div>
        </div>

        <div class="peCard complianceCard" ng-init="OtherFacilities()">
            <h3 class="sectionTitle">Other Facilities Compliance</h3>

            <div class="complianceCardBody">
                <div class="complianceScoreWrap">
                    <h2>{{OtherFacilitiesList.DrinkingwaterPercentage}}%</h2>
                    <span>Compliance score</span>
                </div>

                <div class="complianceDetails">
                    <div><span>Drinking Water</span><strong>{{OtherFacilitiesList.DrinkingwaterYesCount}}</strong></div>
                    <div><span>Washroom Facilities</span><strong>{{OtherFacilitiesList.WashroomYesCount}}</strong></div>
                    <div><span>Rest Shelter</span><strong>{{OtherFacilitiesList.RestShelterYesCount}}</strong></div>
                    <div><span>Canteen Facility</span><strong>{{OtherFacilitiesList.FirstAidYesCount}}</strong></div>
                </div>
            </div>
        </div>

    </div>

    <!-- ROW 3 -->
    <div class="peRowGrid" ng-init="BindControl();">

        <!-- Full Width Document Submission Overview -->
        <div class="peCard tableCard">
            <div class="tableCardHeader" style="display:flex;justify-content:space-between;align-items:center;">
                <h3 class="sectionTitle mb-0">Document Submission Overview</h3>

                <div style="position:relative;width:250px;">

                    <input type="text" style="font-size: 0.9rem; padding: 4px 8px;"
                           class="form-control"
                           placeholder="Search Contractor..."
                           ng-model="SearchText"
                           ng-focus="ShowVendorList = true" ng-change="CalculateDashboard()" />

                    <ul class="list-group"
                        ng-show="ShowVendorList && SearchText"
                        style="position: absolute; z-index: 999; width: 100%; max-height: 200px; overflow-y: auto; font-size: 0.9rem;">

                        <li class="list-group-item"
                            ng-repeat="v in VendorList | unique:'VName' | filter:{VName: SearchText}"
                            ng-click="SelectVendor(v);CalculateDashboard()"
                            style="cursor: pointer; font-size: 0.9rem; padding: 4px 8px; background: #f9fafb ">
                            {{v.VName}}
                        </li>

                    </ul>

                </div>
            </div>

            <div class="tableScrollWrap">

                <table class="table peTable">
                    <thead>
                        <tr>

                            <th>S.No</th>
                            <th>Contractor Name</th>
                            <th>SiteCode</th>
                            <th>Site</th>
                            <th>State</th>
                            <th>Financial Year</th>
                            <th>Month</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Unique No.</th>
                            <th>Creation Date</th>
                            <th>Submission Updated</th>
                            <th>Action</th>

                        </tr>
                    </thead>

                    <tbody>


                        <tr ng-repeat="x in InvoiceList | filter:{VName: SearchText}">
                            <td>{{$index+1}}</td>
                            <td>{{x.VName}}</td>
                            <td>{{x.SiteCode}}</td>
                            <td>{{x.SiteName}}</td>
                            <td>{{x.StateName}}</td>

                            <td>{{x.FYID}}</td>
                            <td>{{x.InMonthName}}</td>

                            <td>{{x.Location}}</td>
                            <td>
                                {{x.Status}}
                            </td>
                            <td>{{x.InvoiceNo}}</td>
                            <td>{{x.CreatedOn}}</td>
                            <td>{{x.UpdatedON}}</td>
                            <td>
                                <a href="../Dashboard/CommunicationClient" style="text-decoration: none;">
                                    <button class="tableActionBtn">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </a>
                            </td>
                        </tr>


                    </tbody>
                </table>

            </div>
            <div class="tableFooterBtn">
                <a href="../Dashboard/CommunicationClient" style="text-decoration: none;">
                    <button class="viewAllBtn">
                        View All
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    </a>
            </div>
        </div>

        <!-- Bottom Half Width Cards -->
        <div class="peRowGrid twoColGrid peRow3Grid" style="margin-bottom: 0;">

            <!-- Compliance Report -->
            <div class="peCard tableCard">
                <div class="tableCardHeader" ng-init="BindCompliance()">
                    <h3 class="sectionTitle mb-0">Compliance Report</h3>
                </div>

                <div class="tableScrollWrap" style="height: 250px; max-height: 250px;">


                    <table class="table peTable">
                        <thead>
                            <tr>
                                <th>Contractor Name</th>
                                <th>Site</th>
                                <th>Month</th>
                                <th>Compliance Score</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>


                            <tr ng-repeat="x in ComplianceList  | filter:{Name: SearchText}">
                                <td>{{x.Name}}</td>
                                <td>{{x.SiteName}}</td>
                                <td>{{x.MonthName}}</td>
                                <td>{{x.Percentage}}</td>
                                <td>
                                    <a href="../Dashboard/ComplianceReport" style="text-decoration: none;">
                                        <button class="tableActionBtn">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        </a>
                                </td>
                            </tr>


                        </tbody>
                    </table>

                </div>
                <div class="tableFooterBtn">
                    <a href="../Dashboard/ComplianceReport" style="text-decoration: none;">
                        <button class="viewAllBtn">
                            View All
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        </a>
                </div>
            </div>

            <!-- Worker Distribution -->
            <div class="peCard chartCard">
                <div class="tableCardHeader">
                    <h3 class="sectionTitle mb-0">Worker Distribution</h3>
                </div>

                <div id="workerDistributionChart"></div>
            </div>

        </div>

    </div>


    <!-- ROW 3 -->
