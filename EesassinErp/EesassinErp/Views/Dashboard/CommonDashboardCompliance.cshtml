

@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}



<!--<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />-->
<!-- Bootstrap Icons -->
<!--<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />-->
<link href="~/ReportsDashboard/CommonReport/style.css" rel="stylesheet" />
<script src="~/Scripts/RetailJsLib/ReportDashbaord.js"></script> 
<div class="report-header d-flex justify-content-between align-items-center px-4 py-2 text-white">
    <button class="btn btn-light btn-sm fw-semibold" ng-click="DownloadPDF('CommonDashboardCompliance')">
        <i class="bi bi-download me-1"></i> Download Report
    </button>
    <h6 class="mb-0"> {{ReportPeriod}}</h6>

</div>
<div id="divprint" class="container-report1 py-3" ng-init="BindTiles();commonReport();GetCurrentMonthYear">
    <!-- HEADER -->
    <!-- BODY -->
    <div class="report-body p-4">
        <!-- Overview Title Box -->
        <div class="overview-box text-center py-2 mb-4">
            <h5 class="mb-0 fw-semibold">Common Compliance Report</h5>
        </div>

        <!-- Description -->
        <p class="small text-muted mb-4 text-center">
            This section provides a consolidated overview of all compliances, highlighting the organization's completion ratio,
            pending obligations, and compliance health for the selected period.
        </p>

        <!-- Summary Cards -->
        <div class="row g-3 mb-4 text-center">
            <div class="col-md-4">
                <div class="summary-card pending text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Total</p>
                    <h4 class="mb-0 fw-bold">{{TotalComplied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card submitted text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Submitted</p>
                    <h4 class="mb-0 fw-bold">{{Complied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card total text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Delay Complied</p>
                    <h4 class="mb-0 fw-bold">{{DelayComplied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card total text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Non Complied</p>
                    <h4 class="mb-0 fw-bold">{{NonComplied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card total text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Pending</p>
                    <h4 class="mb-0 fw-bold">{{Pending}}</h4>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered text-center align-middle mb-0">
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th>Count</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Total Compliance</td>
                        <td>{{TotalComplied}}</td>
                        <td>Total number of compliances monitored across all states and departments.</td>
                    </tr>
                    <tr>
                        <td>Completed</td>
                        <td>{{Complied}}</td>
                        <td>Successfully filed or executed within the defined due date.</td>
                    </tr>
                    <tr>
                        <td>Pending</td>
                        <td>{{Pending}}</td>
                        <td>Awaiting submission or in process of completion.</td>
                    </tr>
                    <tr>
                        <td>Not Complied</td>
                        <td>{{NonComplied}}</td>
                        <td>Missed compliances that require corrective action or follow-up.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Insight Box -->
        <div class="insight-box p-2 mb-4 d-flex align-items-center">
            <div class="insight-bar me-2"></div>
            <p class="mb-0 small">
                <strong>Insight:</strong>  Compliance performance remains steady, though certain entries may require review or escalation.
            </p>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
            <div class="row g-4 justify-content-center">
                <!-- 6 Chart Cards -->
                <div class="col-md-6 col-lg-4">
                    <div class="chart-card text-center bg-white rounded-3 shadow-sm p-3">
                        <h6 class="fw-semibold mb-3 text-orange">Factory Compliance</h6>
                        <div class="chart-content d-flex align-items-center justify-content-center">
                            <div class="chart-left">
                                <canvas id="chartFactory"></canvas>
                            </div>
                            <div class="chart-right ms-3 text-start small fw-semibold">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#E45D27"></span>Complied 
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#8BC34A"></span>Pending 
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-dot me-2" style="background:#FFC107"></span>Delay Complied
                                </div>      
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="chart-card text-center bg-white rounded-3 shadow-sm p-3">
                        <h6 class="fw-semibold mb-3 text-orange">Finance Compliance</h6>
                        <div class="chart-content d-flex align-items-center justify-content-center">
                            <div class="chart-left">
                                <canvas id="chartFinance"></canvas>
                            </div>
                            <div class="chart-right ms-3 text-start small fw-semibold">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#E45D27"></span>Complied
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#8BC34A"></span>Pending
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-dot me-2" style="background:#FFC107"></span>Delay Complied
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="chart-card text-center bg-white rounded-3 shadow-sm p-3">
                        <h6 class="fw-semibold mb-3 text-orange">Labour Compliance</h6>
                        <div class="chart-content d-flex align-items-center justify-content-center">
                            <div class="chart-left">
                                <canvas id="chartLabour"></canvas>
                            </div>
                            <div class="chart-right ms-3 text-start small fw-semibold">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#E45D27"></span>Complied
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#8BC34A"></span>Pending
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-dot me-2" style="background:#FFC107"></span>Delay Complied
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="chart-card text-center bg-white rounded-3 shadow-sm p-3">
                        <h6 class="fw-semibold mb-3 text-orange">Secretarial Compliance</h6>
                        <div class="chart-content d-flex align-items-center justify-content-center">
                            <div class="chart-left">
                                <canvas id="chartSecretarial"></canvas>
                            </div>
                            <div class="chart-right ms-3 text-start small fw-semibold">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#E45D27"></span>Complied
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#8BC34A"></span>Pending
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-dot me-2" style="background:#FFC107"></span>Delay Complied
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @*<div class="col-md-6 col-lg-4">
                        <div class="chart-card text-center bg-white rounded-3 shadow-sm p-3">
                            <h6 class="fw-semibold mb-3 text-orange">Establishment Compliance</h6>
                            <div class="chart-content d-flex align-items-center justify-content-center">
                                <div class="chart-left">
                                    <canvas id="chartEstablishment"></canvas>
                                </div>
                                <div class="chart-right ms-3 text-start small fw-semibold">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="legend-dot me-2" style="background:#E45D27"></span>&lt;50%
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="legend-dot me-2" style="background:#8BC34A"></span>51–75%
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <span class="legend-dot me-2" style="background:#FFC107"></span>&gt;75%
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>*@

                <div class="col-md-6 col-lg-4">
                    <div class="chart-card text-center bg-white rounded-3 shadow-sm p-3">
                        <h6 class="fw-semibold mb-3 text-orange">Payroll Compliance</h6>
                        <div class="chart-content d-flex align-items-center justify-content-center">
                            <div class="chart-left">
                                <canvas id="chartPayroll"></canvas>
                            </div>
                            <div class="chart-right ms-3 text-start small fw-semibold">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#E45D27"></span>Complete
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#8BC34A"></span>Pending
                                </div>
                                @*<div class="d-flex align-items-center">
                                    <span class="legend-dot me-2" style="background:#FFC107"></span>Delay Complied
                                </div>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



    </div>

    <!-- FOOTER -->
    @*<div class="report-footer d-flex justify-content-between align-items-center px-4 py-2 text-white">
            <p class="mb-0 small fw-semibold">Prepared By: EZ Compliance</p>
            <p class="mb-0 small fw-semibold">Generated for: {{MapUser}}</p>
        </div>*@
</div>
