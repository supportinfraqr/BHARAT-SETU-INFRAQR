                        <th>Worker Name</th>

                        <th>ID Number</th>

                        <th>Skill/Role</th>

                        <th>Contact No.</th>

                        <th>Medical</th>

                        <th>Health & Safety</th>

                        <th>Compliance</th>

                        <th>Status</th>

                        <th class="text-center">
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>




                    <tr ng-repeat="x in WorkerList | filter:SiteFilter">

                        <td>

                            <input type="checkbox"
                                   class="form-check-input"
                                   ng-model="x.Selected"
                                   ng-change="updateSelection()" />

                        </td>

                        <td>

                            {{x.EmployeeName}}

                        </td>

                        <td>

                            {{x.EmployeeCode}}

                        </td>

                        <td>

                            {{x.EmployeeDesignation}}

                        </td>

                        <td>

                            {{x.mobilenumber}}

                        </td>

                        <td>

                            <span class="statusDone" ng-show="x.MedicalStatus =='Done'">

                                <i class="bi bi-check-circle"></i>

                                {{x.MedicalStatus}}

                            </span>
                            <span class="statusPending" ng-show="x.MedicalStatus =='Pending'">

                                <i class="bi bi-dash-circle"></i>

                                Pending

                            </span>
                        </td>

                        <td>

                            <span class="statusDone" ng-show="x.FitnessTypes =='Done'">

                                <i class="bi bi-check-circle"></i>

                                {{x.FitnessTypes}}

                            </span>
                            <span class="statusPending" ng-show="x.FitnessTypes =='Pending'">

                                <i class="bi bi-dash-circle"></i>

                                Pending

                            </span>

                        </td>

                        <td>

                            <span class="statusDone" ng-show="x.Compliance =='Done'">

                                <i class="bi bi-check-circle"></i>

                                {{x.Compliance}}

                            </span>
                            <span class="statusPending" ng-show="x.Compliance =='Pending'">

                                <i class="bi bi-dash-circle"></i>

                                Pending

                            </span>

                        </td>

                        <td>

                            <span class="approvalStatus approved" ng-show="x.GSTATUS=='Approved'">

                                <span class="dot"></span>

                                {{x.GSTATUS}}

                            </span>
                            <span class="approvalStatus rejected" ng-show="x.GSTATUS =='Rejected'">

                                <span class="dot"></span>

                                Rejected

                            </span>
                            <span class="approvalStatus pending" ng-show="x.GSTATUS =='Pending'">

                                <span class="dot"></span>

                                Not Alloted

                            </span>

                        </td>

                        <td class="text-center">

                            <button class="iconBtn"
                                    data-bs-toggle="modal" ng-click="setEmpValue(x)"
                                    data-bs-target="#workerPreviewModal">

                                <i class="bi bi-eye"></i>

                            </button>

                        </td>

                    </tr>

