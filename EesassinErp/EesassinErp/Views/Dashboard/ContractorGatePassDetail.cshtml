                                </div>

                                <div class="detailValue success">

                                    {{BankVerify}}

                                </div>

                            </div>

                        </div>

                        <!-- UAN -->

                        <div class="col-lg-3 col-md-6">

                            <div class="detailItem">

                                <div class="detailTitle">

                                    UAN

                                </div>

                                <div class="detailValue success">

                                    {{UANVerify}}

                                </div>

                            </div>

                        </div>

                        <div class="col-lg-3 col-md-6">

                            <div class="detailItem">

                                <div class="detailTitle">

                                    PF

