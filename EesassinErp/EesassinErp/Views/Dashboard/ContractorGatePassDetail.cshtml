@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Contractor Gate Pass";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Content/Dashboards/GatePass/ContractorGatePass/style.css" rel="stylesheet" />

<script src="~/scripts/bharat/ContractorGatePassController.js"></script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    /*=========================================
        Permanent / Temporary Tabs
    =========================================*/

    const tabs = document.querySelectorAll(".contractorGatePass .gatePassTabs .nav-link");

    tabs.forEach(tab => {

        tab.addEventListener("click", function () {

            tabs.forEach(t => t.classList.remove("active"));

            this.classList.add("active");

        });

    });

    /*=========================================
        Select All
    =========================================*/

    const table = document.querySelector(".contractorGatePass .previewTable");

    if (table) {

        const headerCheckbox = table.querySelector("thead .form-check-input");

        const rowCheckboxes = table.querySelectorAll("tbody .form-check-input");

        headerCheckbox.addEventListener("change", function () {

            rowCheckboxes.forEach(cb => {

                cb.checked = this.checked;

            });

        });

    }

});

</script>

<div class="contractorGatePass px-4 py-4">

    <!-- ==========================================
        Header
    ========================================== -->

    <div class="cgpHeader d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <h2 class="pageTitle mb-0">
            Generate Bulk Gate Passes
        </h2>

        <ul class="nav nav-tabs gatePassTabs border-0">

            <li class="nav-item">
                <button class="nav-link active"  ng-click="redirectomain()">
                    Back to Main 
