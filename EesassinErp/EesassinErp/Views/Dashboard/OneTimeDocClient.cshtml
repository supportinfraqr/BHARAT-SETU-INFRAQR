
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "One Time Document Client";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<style>
    #oneTimeDocClient {
        font-family: "Inter", sans-serif;
        --primary: #E45D27; /* theme accent */
        --primary-dark: #c44b1d;
        --card-bg: #FEF3EC;
        background: #FFF1EB;
        color: #223;
        min-height: 85vh;
    }

    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    /* Section cards */
    #oneTimeDocClient .section-card {
        background: transparent;
        border: none;
    }

        #oneTimeDocClient .section-card .card-body {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            min-height: 320px;
        }

    /* Table wrapper and hide scrollbar visually */
    #oneTimeDocClient .small-table-wrapper .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: smooth;
        position: relative;
    }

        #oneTimeDocClient .small-table-wrapper .table-responsive::-webkit-scrollbar {
            display: none;
        }

    /* table header sticky */
    #oneTimeDocClient .small-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #F37437;
        color: #fff;
        font-weight: 600;
        font-size: 0.78rem;
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
        padding: 8px 10px;
    }

    /* table body */
    #oneTimeDocClient .small-table tbody td {
        background-color: var(--card-bg);
        font-size: 0.78rem;
        vertical-align: middle;
        text-align: center;
        padding: 8px 10px;
        white-space: nowrap;
    }

    /* hover */
    #oneTimeDocClient .small-table tbody tr:hover td {
        background-color: #FFE8D9;
    }

    /* filter button */
    #oneTimeDocClient .filter-btn {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #oneTimeDocClient .filter-btn.active,
        #oneTimeDocClient .filter-btn:hover {
            background: var(--primary);
            color: #fff;
        }

    #oneTimeDocClient #goBtn,
    #oneTimeDocClient #refBtn {
        border-radius: 999px;
        border: none;
        color: #fff;
        background: var(--primary);
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #oneTimeDocClient #goBtn:hover,
        #oneTimeDocClient #refBtn:hover {
            background: var(--primary-dark);
        }

    /* Table Buttons*/

    .btn-upload, .btn-view, .btn-submit {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.78rem;
    }

        .btn-upload:hover, .btn-view:hover, .btn-submit:hover {
            background: var(--primary);
            color: #fff;
        }

    /* Table Selects*/

    #oneTimeDocClient .form-control {
        font-size: .78rem;
        padding: 2px 8px;
        border-radius: 6px;
        border: 1px solid #dcdcdc;
        outline: none;
    }

    /* filter button */
    #oneTimeDocClient .filter-btn {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #oneTimeDocClient .filter-btn.active,
        #oneTimeDocClient .filter-btn:hover {
            background: var(--primary);
            color: #fff;
        }

    /* small inputs */
    #oneTimeDocClient .table-toolbar .form-control-sm {
        height: 36px;
        border-radius: 999px;
        border-color: var(--primary);
    }

    /* Export button (rounded) */
    #oneTimeDocClient .export-btn {
        border-radius: 999px;
        color: #fff;
        background: var(--primary);
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
        -webkit-tap-highlight-color: transparent;
    }

        #oneTimeDocClient .export-btn:hover {
            background: var(--primary-dark);
        }

        /* remove default dark flash on click for export and other action buttons while keeping subtle ring on focus */
        #oneTimeDocClient .export-btn:focus,
        #oneTimeDocClient .export-btn:active {
            outline: none;
            box-shadow: 0 0 0 3px rgba(228,93,39,0.12);
        }

    /*Fix Search bar and button in toolbar*/
    #oneTimeDocClient .table-toolbar .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    #oneTimeDocClient .table-toolbar .input-group .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-color: var(--primary);
    }
</style>
<script src="~/scripts/myjslib/OneTimeDocumentController.js"></script>
<div id="oneTimeDocClient" class="px-4 py-2">
    <div class="card section-card">
        <h4 class="my-4" style="color: #E45D27">One Time Document</h4>
        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown" ng-init="BindVendor()">
                        @*<button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Vendor
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Vendor 1</a></li>
                            </ul>*@
                        <select autocomplete='address-level2' class="btn btn-sm filter-btn" id="ddlVendorId" ng-model="VendorId" ng-change="AllUserListsLoad(VendorId)">
                            <option value="">Select</option>
                            <option ng-repeat="x in VendorList" value="{{x.PartyId}}">{{x.PartyName}}</option>
                        </select>
                    </div>

                    <div class="dropdown">
                        @*<button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            User
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">User1</a></li>
                            <li><a class="dropdown-item" href="#">User2</a></li>
                            <li><a class="dropdown-item" href="#">User3</a></li>
                        </ul>*@
                        <select autocomplete='address-level2' class="btn btn-sm filter-btn " id="ddlUserList" ng-model="UserId" ng-change="BindDocument(UserId);">
                            <option value="">Select</option>
                            <option ng-repeat="x in AllUserList" value="{{x.LoginId}}">{{x.Name}}</option>
                        </select>

                    </div>

                    <button class="btn btn-sm filter-btn active">Go</button>
                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="scSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @*<li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>*@
                                <li><a class="dropdown-item" ng-click="PrintRecord()" >Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table"  ng-init="BindDocument()">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Document Name</th>
                                <th>Description</th>
                                <th>Valid From</th>
                                <th>Valid To</th>
                                <th>Status</th>
                                <th>Upload</th>
                                <th>View</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="scTableBody">
                            <tr>
                                <td>1</td>
                                <td>Email ID</td>
                                <td><input type="text" class="form-control form-control-sm"></td>
                                <td><input type="date" class="form-control form-control-sm"></td>
                                <td><input type="date" class="form-control form-control-sm"></td>
                                <td>Active</td>
                                <!--Upload File column-->
                                <td>
                                    <label class="btn btn-sm btn-upload px-3" style="white-space:nowrap; cursor:pointer;">
                                        Choose File
                                        <input type="file" hidden>
                                    </label>
                                </td>
                                <!--View column-->
                                <td>
                                    <button class="btn btn-sm btn-view">View</button>
                                </td>
                                <!--Action column-->
                                <td>
                                    <button class="btn btn-sm btn-submit px-3">Submit</button>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>