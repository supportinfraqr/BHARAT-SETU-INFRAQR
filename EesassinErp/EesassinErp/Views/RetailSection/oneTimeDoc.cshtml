
@{
    ViewBag.Title = "oneTimeDoc";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>One-Time Documents</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #FFF6F1;
            font-family: "Poppins", sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Orange Theme Button */
        .btn-orange {
            background-color: #FD670B;
            color: white;
            border: none;
            border-radius: 25px;
            font-weight: 500;
            padding: 6px 16px;
            transition: all 0.3s ease;
        }

        .btn-orange:hover {
            background-color: #E55C0A;
            color: white;
        }

        /* Main Container */
        .oneTimeDoc-container {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            padding: 2rem;
            margin: 2rem auto;
            width: 95%;
            max-width: auto;
        }

        /* Form Fields */
        .oneTimeDoc-container label {
            font-weight: 500;
            font-size: 0.8rem;
            color: #333;
        }

            /* Make input and dropdown text consistent */
            .oneTimeDoc-container .form-control,
            .oneTimeDoc-container .form-select {
                font-size: 0.8rem; /* 👈 match text size */
                border: 1px solid #ddd;
                border-radius: 6px;
                box-shadow: none;
                transition: all 0.2s ease;
            }

        .oneTimeDoc-container .form-control:focus,
        .oneTimeDoc-container .form-select:focus {
            border-color: #FD670B;
            box-shadow: 0 0 0 0.2rem rgba(253, 103, 11, 0.2);
        }

        /* Section Titles */
        .section-title {
            font-weight: 400;
            color: #FD670B;
            margin-top: 2rem;
            margin-bottom: 0.25rem;
        }

        .section-subtext {
            color: #555;
            font-size: 0.8rem;
        }

        hr {
            margin-top: 0.5rem;
            margin-bottom: 1.5rem;
            border-top: 1px solid #ddd;
        }

        /* Upload Cards */
        .upload-card {
            border: 2px dashed #ddd;
            border-radius: 10px;
            height: 150px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            cursor: pointer;
            transition: border-color 0.3s ease, background-color 0.3s ease;
            background-color: #FFF9F6;
            text-align: center;
        }

        .upload-card:hover {
            border-color: #FD670B;
            background-color: #FFF1EB;
        }

        .upload-card i {
            font-size: 2rem;
            color: #FD670B;
        }

        .upload-card span {
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: #555;
        }

        .upload-card input[type="file"] {
            display: none;
        }

        /* Responsive Spacing */
        @@media (max-width: 992px) {
            .oneTimeDoc-container {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="oneTimeDoc-container">
        <!-- Update Button -->
        <div class="d-flex justify-content-end mb-3">
            <button class="btn-orange">Update</button>
        </div>

        <!-- Company Details Form -->
        <form class="row g-3">
            <div class="col-md-3">
                <label>Company Name</label>
                <input type="text" class="form-control">
            </div>
            <div class="col-md-3">
                <label>Email ID</label>
                <input type="email" class="form-control">
            </div>
            <div class="col-md-3">
                <label>Contact No.</label>
                <input type="text" class="form-control">
            </div>
            <div class="col-md-3">
                <label>CIN</label>
                <input type="text" class="form-control">
            </div>

            <div class="col-md-3">
                <label>PAN</label>
                <input type="text" class="form-control">
            </div>
            <div class="col-md-3">
                <label>TAN</label>
                <input type="text" class="form-control">
            </div>
            <div class="col-md-3">
                <label>GSTN</label>
                <input type="text" class="form-control">
            </div>
            <div class="col-md-3">
                <label>PIN Code</label>
                <input type="text" class="form-control">
            </div>

            <div class="col-md-3">
                <label>Country</label>
                <select class="form-select">
                    <option selected>Select Country</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>State</label>
                <select class="form-select">
                    <option selected>Select State</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>City</label>
                <select class="form-select">
                    <option selected>Select City</option>
                </select>
            </div>
            <div class="col-md-3">
                <label>Address</label>
                <input type="text" class="form-control">
            </div>

            <div class="col-md-4">
                <label>PF Registration Code/Subcode</label>
                <input type="text" class="form-control">
            </div>
            <div class="col-md-4">
                <label>Labour Welfare Fund Registration</label>
                <input type="text" class="form-control">
            </div>
            <div class="col-md-4">
                <label>Professional Tax Registration</label>
                <input type="text" class="form-control">
            </div>
        </form>

        <!-- Upload Documents -->
        <h6 class="section-title">Upload Documents</h6>
        <p class="section-subtext">Please save above details before uploading document</p>
        <hr>

        <div class="row g-4">
            <div class="col-md-3 col-sm-6">
                <label>1. COI</label>
                <div class="upload-card" onclick="triggerUpload('file1')">
                    <i class="bi bi-plus-lg"></i>
                    <span>Upload File</span>
                    <input type="file" id="file1" onchange="handleFileUpload(event, this)">
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <label>2. PAN</label>
                <div class="upload-card" onclick="triggerUpload('file2')">
                    <i class="bi bi-plus-lg"></i>
                    <span>Upload File</span>
                    <input type="file" id="file2" onchange="handleFileUpload(event, this)">
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <label>3. MOA AOA</label>
                <div class="upload-card" onclick="triggerUpload('file3')">
                    <i class="bi bi-plus-lg"></i>
                    <span>Upload File</span>
                    <input type="file" id="file3" onchange="handleFileUpload(event, this)">
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <label>4. GST Registration Certificate</label>
                <div class="upload-card" onclick="triggerUpload('file4')">
                    <i class="bi bi-plus-lg"></i>
                    <span>Upload File</span>
                    <input type="file" id="file4" onchange="handleFileUpload(event, this)">
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <label>5. MSME Registration Certificate</label>
                <div class="upload-card" onclick="triggerUpload('file5')">
                    <i class="bi bi-plus-lg"></i>
                    <span>Upload File</span>
                    <input type="file" id="file5" onchange="handleFileUpload(event, this)">
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <label>6. List of Directors</label>
                <div class="upload-card" onclick="triggerUpload('file6')">
                    <i class="bi bi-plus-lg"></i>
                    <span>Upload File</span>
                    <input type="file" id="file6" onchange="handleFileUpload(event, this)">
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <label>7. Directors KYC</label>
                <div class="upload-card" onclick="triggerUpload('file7')">
                    <i class="bi bi-plus-lg"></i>
                    <span>Upload File</span>
                    <input type="file" id="file7" onchange="handleFileUpload(event, this)">
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Icons + JS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <script>
        function triggerUpload(id) {
            document.getElementById(id).click();
        }

        function handleFileUpload(event, input) {
            const file = event.target.files[0];
            if (file) {
                const card = input.closest('.upload-card');
                card.innerHTML = `<i class="bi bi-file-earmark-check-fill text-success" style="font-size:2rem;"></i>
                                  <span>${file.name}</span>`;
            }
        }
    </script>
</body>
</html>


