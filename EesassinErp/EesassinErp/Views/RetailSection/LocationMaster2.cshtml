@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Location Master";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="~/scripts/RetailJsLib/LocationMastercontroller.js"></script>

<style>
    .addbordrbutton {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.78rem;
    }

        .addbordrbutton:hover {
            background: var(--primary);
            color: #fff;
        }

    .mp-ov-card {
        padding: 12px;
    }

    .mp-big {
        font-size: 18px;
        font-weight: 600;
    }

    .history-wrapper {
        position: relative;
        display: inline-block;
    }

    .history-eye {
        cursor: pointer;
        font-size: 16px;
        color: #e45d27;
    }

    /* Popup box */
    .history-popup {
        position: absolute;
        top: 24px;
        right: 0;
        width: 360px;
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        z-index: 999999; /* 🔥 modal se bhi upar */
    }

    /* Header */
    .history-header {
        background: #e45d27;
        color: #fff;
        padding: 8px 12px;
        font-weight: 600;
        border-radius: 6px 6px 0 0;
    }

    /* Scroll body */
    .history-body {
        max-height: 200px;
        overflow-y: auto;
        padding: 8px;
    }

        .history-body th,
        .history-body td {
            font-size: 12px;
        }
</style>
<div class="locationMasterPage px-4 py-2" ng-init="BindMenus()" ng-cloak>
    <!-- Top bar: instruction left + New Location button right -->
    <div class="d-flex align-items-center justify-content-between mb-3 top-bar" ng-init="Limit()" ng-show="SMF_EditFlag==1">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="limit-instruction">Location Total Limit: <strong> {{StoreLimit}}</strong></div>
            <div class="limit-instruction">Used: <strong> {{total}}</strong></div>
            <div class="limit-instruction">Left: <strong> {{LeftStore}}   </strong></div>

        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- New Location (rounded pill) -->
            <button class="btn btn-sm btn-new-location" id="btnNewLocation" ng-click="reset();ShowDivStoreMasterForm()" type="button">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>New Location</span>
            </button>
        </div>
    </div>

