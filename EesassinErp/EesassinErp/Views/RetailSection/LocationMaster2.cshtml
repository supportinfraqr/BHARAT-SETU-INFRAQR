                            <!--<div class="d-flex align-items-center gap-2">-->
                            <!-- View -->
                            <!--<i class="bi bi-eye-fill"
                               title="View"
                               style="color:#E45D27; cursor:pointer;">
                            </i>-->
                            <!-- Download -->
                            <!--<i class="bi bi-download" style="color:#E45D27; cursor:pointer;"></i>
                            </div>-->

                        </div>
                    </div>


                    <!-- Toolbar -->
                    <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                        <div class="d-flex align-items-center gap-2">

                            <button class="btn btn-sm btn-darkOrange px-3" ng-click="AddDocRow()">
                                <i class="bi bi-plus-circle"></i> Add Row
                            </button>
                            <button class="btn btn-sm btn-darkOrange px-3" ng-click="SaveAll()">
                                <i class="bi bi-save"></i> Save All
                            </button>
                        </div>

                        <!--<div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                            <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                                <div class="input-group input-group-sm">
                                    <input id="scSearch" type="text" class="form-control form-control-sm" ng-model="scSearch"  placeholder="Search..." />
                                    <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                                </div>
                            </div>


                            <button class="btn btn-sm btn-darkOrange">Download</button>
                            <div>
                                <div class="dropdown">
                                    <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="#">CSV</a></li>
                                        <li><a class="dropdown-item" href="#">PDF</a></li>
                                        <li><a class="dropdown-item" href="#">Print</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div> -->
                    </div>

                    <!-- Table wrapper -->
                    <div class="small-table-wrapper rounded-3" ng-init="GETAllSTORE();AddDocRow()">

                        <div class="table-responsive">
                            <table class="table table-sm mb-0 small-table" id="lm-compDoc-Table">
                                <thead>
                                    <tr>
                                        <th>S.No</th>
                                        <th>Document Name</th>
                                        <th>Other Locations</th>
                                        <th>Remarks</th>
                                        <th>Valid From</th>
                                        <th>Valid To</th>
                                        <th>Upload</th>
                                        <!--<th>View</th>
                                        <th>Download</th>-->
                                        <th>Action</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="lm-compDoc-TableBody">
                                    <tr ng-repeat="row in compDocs | filter:scSearch track by $index">
                                        <td class="lm-serial">{{$index + 1}}</td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   ng-model="row.docName">
                                        </td>
                                        <td>
                                            <div class="dropdown lm-multiselect w-100">
                                                <!-- Button -->
                                                <button class="form-select form-select-sm dropdown-toggle"
                                                        type="button"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false"
                                                        style="width:220px; max-width:220px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                                    {{ row.locations.length ? row.locations.join(', ') : 'Select Locations' }}
                                                </button>

                                                <!-- Dropdown -->
                                                <ul class="dropdown-menu w-100 p-1" style="max-height:200px; overflow:auto;">

                                                    <!-- Select All -->
                                                    <li class="px-2 py-1 border-bottom">
                                                        <label class="dropdown-item fw-bold d-flex align-items-center gap-2">
                                                            <input type="checkbox"
                                                                   ng-checked="row.locationIds.length == locationLists.length"
                                                                   ng-click="selectAllLocations(row, $event)">
                                                            Select All
                                                        </label>
                                                    </li>

                                                    <!-- Location List -->
                                                    <li ng-repeat="loc in locationLists">
                                                        <label class="dropdown-item d-flex align-items-center gap-2">
                                                            <input type="checkbox"
                                                                   ng-checked="row.locationIds.indexOf(loc.StoreId) > -1"
                                                                   ng-click="toggleLocation(row, loc, $event)">
                                                            <span>{{loc.StoreName}}</span>
                                                        </label>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>

                                        <!--Remark column-->
                                        <td>
                                            <div class="d-flex align-items-center gap-2" style="min-width:150px;">
                                                <input type="text" class="form-control form-control-sm"
                                                       ng-model="row.remarks">
                                            </div>
                                        </td>
                                        <td><input type="date" class="form-control form-control-sm" ng-model="row.validFrom"></td>
                                        <td><input type="date" class="form-control form-control-sm" ng-model="row.validTo"></td>
                                        <td>
                                            <label class="btn btn-sm btn-upload px-3">
                                                Choose File
                                                <input type="file" hidden
                                                       file-model="row.file">
                                            </label>

                                            <small class="text-muted d-block mt-1" ng-if="row.file">
                                                {{row.file.name}}
                                            </small>
                                        </td>

                                        <!--View column-->
                                        <!--<td>
                                            <button class="btn btn-sm btn-view" ng-disabled="!row.file">View</button>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-view" ng-disabled="!row.file">Download</button>
                                        </td>-->
                                        <!--Actyion column-->
                                        <td>
                                            <button class="btn btn-sm btn-submit px-3"
                                                    ng-click="SaveRow(row)">
                                                {{row.isSaved ? 'Saved' : 'Save'}}
                                            </button>
                                        </td>

                                        <td class="action-menu">
                                            @*<button class="btn btn-sm" data-bs-toggle="dropdown">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item lm-row-update">Update</a></li>
                                                    <li><a class="dropdown-item lm-row-remove text-danger">Remove</a></li>
                                                </ul>*@
                                            <button class="btn btn-sm text-danger"
                                                    ng-click="RemoveRow($index)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>


                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>




