<script>
    function storedoc(A, B, C, D, E, F, G) {
        var chartDom = document.getElementById('main');
        var myChart = echarts.init(chartDom);
        var option;

        option = {
            xAxis: {
                type: 'category',
                axisLabel: { interval: 0, rotate: 25 },
                data: [
                    'Electricity Bill',
                    'Lease / LOI',
                    'Property Tax Receipt',
                    'Fire NOC',
                    'Pollution',
                    'Ownership Docs',
                    'Additional Doc Name'

                ].map(function (str) {
                    return str.replace(' ', '\n');
                })
            },
            yAxis: {
                type: 'value'
            },
            grid: {
                left: 25,
                top: 20,
                right: 10,
                bottom: 45
            },
            series: [
                {
                    data: [
                        {
                            value: A,
                            itemStyle: { color: '#FF5B5BB2' }
                        },
                        {
                            value: B,
                            itemStyle: { color: '#3A8FFFB2' }
                        },
                        {
                            value: C,
                            itemStyle: { color: '#FF5B5BB2' }
                        },
                        {
                            value: D,
                            itemStyle: { color: '#00B074B2' }
                        },
                        {
                            value: E,
                            itemStyle: { color: '#00B074B2' }
                        },
                        {
                            value: F,
                            itemStyle: { color: '#00B074B2' }
                        },
                        {
                            value: G,
                            itemStyle: { color: '#00B074B2' }
                        }

                    ],
                    type: 'bar',
                    barWidth: '25px',
                }
            ]
        };

        option && myChart.setOption(option);


    }
    function PieChartRegion(East, West, North, South, Central) {

        var chartDom1 = document.getElementById('pimain');
        var myChart1 = echarts.init(chartDom1);
        var option;

        option = {
            tooltip: {
                trigger: 'item'
            },
            legend: {
                top: '25%',
                left: '5%',
                orient: 'vertical'
            },
            series: [
                {
                    name: 'Store',
                    type: 'pie',
                    radius: ['40%', '70%'],
                    avoidLabelOverlap: false,
                    padAngle: 3,
                    itemStyle: {
                        borderRadius: 8
                    },
                    emphasis: {
                        label: {
                            show: true,
                            fontSize: 25,
                            fontWeight: 'bold'
                        }
                    },
                    labelLine: {
                        show: false
                    },
                    label: {
                        formatter: '{c}',
                        position: 'inside'
                    },
                    data: [
                        { value: East, name: 'East' },
                        { value: West, name: 'West' },
                        { value: North, name: 'North' },
                        { value: South, name: 'South' },
                        { value: Central, name: 'Central' }
                    ]
                }
            ]
        };

        option && myChart1.setOption(option);
    };

</script>

