<script>

    /* PAN VALIDATION */
    document.getElementById("pan").addEventListener("input", function () {
        const val = this.value.toUpperCase();
        this.value = val;

        const regex = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;

        const msg = document.getElementById("panMsg");

        if (val.length === 10) {
            msg.innerText = regex.test(val) ? "Valid PAN " : "Invalid PAN ";
            msg.style.color = regex.test(val) ? "green" : "red";
        } else {
            msg.innerText = "";
        }
    });
    document.getElementById("gst").addEventListener("input", function () {
        const val = this.value.toUpperCase();
        this.value = val;

        const regex = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[A-Z0-9]{3}$/;
        const msg = document.getElementById("gstMsg");

        if (val.length === 15) {
            msg.innerText = regex.test(val) ? "Valid GSTIN " : "Invalid GSTIN ";
            msg.style.color = regex.test(val) ? "green" : "red";
        } else {
            msg.innerText = "";
        }
    });

    /* CIN / LLPIN AUTO DETECT */
    document.getElementById("cin").addEventListener("input", function () {
        const val = this.value.toUpperCase();
        this.value = val;

        const msg = document.getElementById("cinMsg");

        const cinRegex = /^[A-Z0-9]{21}$/;   // CIN
        const llpRegex = /^[A-Z]{3}-[0-9]{4}$/; // LLPIN

        if (val.length > 0) {
            if (cinRegex.test(val)) {
                msg.innerText = "Detected: CIN (Company) ";
                msg.style.color = "green";
            }
            else if (llpRegex.test(val)) {
                msg.innerText = "Detected: LLPIN (LLP) ";
                msg.style.color = "green";
            }
            else {
                msg.innerText = "Invalid format ";
                msg.style.color = "red";
            }
        } else {
            msg.innerText = "";
        }
    });

</script>
<script>

    const declData = {
        indemnity: `
        <p>Vendor agrees to indemnify...</p>
        <ul>
            <li>Non-compliance with laws</li>
            <li>Non-payment of dues</li>
        </ul>
    `,
        confidentiality: `
        <p>Vendor acknowledges access to confidential info...</p>
        <ul>
            <li>No disclosure</li>
            <li>Use only for service</li>
        </ul>
    `,
        conduct: `<p>Code of conduct details...</p>`,
        aml: `<p>AML declaration...</p>`,
        abc: `<p>Anti-bribery declaration...</p>`,
        dpdp: `<p>DPDP compliance...</p>`
    };

    let currentDecl = null;
    const completedDecl = new Set();

    /* OPEN MODAL */
    document.querySelectorAll(".open-decl").forEach(btn => {
        btn.addEventListener("click", function () {
            const parent = this.closest(".decl-item");
            const id = parent.dataset.id;

            currentDecl = id;

            document.getElementById("declTitle").innerText = parent.querySelector("strong").innerText;
            document.getElementById("declContent").innerText = declData[id];

            document.getElementById("declAgree").checked = false;
            enableScrollCheck();

            new bootstrap.Modal(document.getElementById("declModal")).show();
        });
    });

    function enableScrollCheck() {
        const box = document.getElementById("declContent");
        const checkbox = document.getElementById("declAgree");

        checkbox.disabled = true;

        box.scrollTop = 0;

        // If content is small → enable directly
        if (box.scrollHeight <= box.clientHeight + 10) {
            checkbox.disabled = false;
            return;
        }

        box.onscroll = function () {
            if (box.scrollTop + box.clientHeight >= box.scrollHeight - 5) {
                checkbox.disabled = false;
            }
        };
    }

    /* CONFIRM */
    document.getElementById("confirmDecl").addEventListener("click", function () {

        if (!document.getElementById("declAgree").checked) return;

        completedDecl.add(currentDecl);

        const item = document.querySelector(`.decl-item[data-id="${currentDecl}"]`);
        item.querySelector(".status").innerText = "Done";
        item.querySelector(".status").classList.remove("pending");
        item.querySelector(".status").classList.add("done");

        bootstrap.Modal.getInstance(document.getElementById("declModal")).hide();
    });

    var declNextEl = document.getElementById("declNext");
    if (declNextEl) {
        declNextEl.addEventListener("click", function () {

            const total = document.querySelectorAll(".decl-item").length;

            currentStep++;
            showStep(currentStep);
        });
    }


</script>
<script>
    window.onload = function () {

        var input = document.getElementById("ServicesOffered");
        var dropdown = document.getElementById("serviceDropdown");

        if (input && dropdown) {
            // open dropdown
            input.addEventListener("click", function (e) {
                e.stopPropagation();
                dropdown.style.display = "block";
            });

            // checkbox change
            dropdown.addEventListener("change", function () {
                var selected = [];
                var checkboxes = dropdown.querySelectorAll("input[type='checkbox']");

                checkboxes.forEach(function (cb) {
                    if (cb.checked) {
                        selected.push(cb.value);
                    }
                });

                input.value = selected.join(", ");
            });

            // close on outside click
            document.addEventListener("click", function (e) {
                if (!dropdown.contains(e.target) && e.target !== input) {
                    dropdown.style.display = "none";
                }
            });
        }

    };
</script>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        // OPEN DROPDOWN
        document.querySelectorAll(".multi-input").forEach(function (input) {
            input.addEventListener("click", function (e) {
                e.stopPropagation();

                // close all first
                document.querySelectorAll(".multi-select-dropdown").forEach(d => d.style.display = "none");

                var targetId = this.getAttribute("data-target");
                document.getElementById(targetId).style.display = "block";
            });
        });

        document.querySelectorAll(".multi-select-dropdown").forEach(function (dropdown) {

            dropdown.addEventListener("change", function () {
                var selected = [];

                dropdown.querySelectorAll("input[type='checkbox']").forEach(function (cb) {
                    if (cb.checked) selected.push(cb.value);
                });

                // find linked input
                var input = document.querySelector('[data-target="' + dropdown.id + '"]');
                input.value = selected.join(", ");
            });

        });

        // CLOSE ON OUTSIDE CLICK
        document.addEventListener("click", function () {
            document.querySelectorAll(".multi-select-dropdown").forEach(d => d.style.display = "none");
        });

    });
</script>