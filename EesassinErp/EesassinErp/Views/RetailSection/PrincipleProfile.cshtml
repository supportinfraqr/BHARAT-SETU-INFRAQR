@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Principle Employer Profile";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/Content/Dashboards/PrincipleProfile/script.js"></script>
<link href="~/Content/Dashboards/PrincipleProfile/style.css" rel="stylesheet" />
<script src="~/scripts/RetailJsLib/PrincipleEmployerCodeController.js"></script>


<div class="principleProfile px-4 py-2" ng-init="PrincipleProfile()">

    <!-- Top Bar -->
    <div class="d-flex align-items-center justify-content-between mb-3 principleProfileTopBar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h4 class="mb-0 principleProfileHeading">
                Principle Employer’s Profile
            </h4>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-edit" id="btneditProfile" type="button" data-bs-toggle="modal" data-bs-target="#editprincipleProfileModal" ng-click="BindRegistration()">
                <i class="bi bi-pencil-square"></i>
                <span>Edit Profile</span>
            </button>
        </div>
    </div>

    <!-- EDIT PRINCIPLE PROFILE MODAL -->
    <div class="modal fade principleProfileModal"
         id="editprincipleProfileModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-fullscreen principleProfileFullscreenModal">

            <div class="modal-content principleProfileModalContent">

                <!-- HEADER -->
                <div class="modal-header principleProfileModalHeader">
                    <div class="principleProfileModalTitleWrapper">
                        <div class="principleProfileModalIcon">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <div class="principleProfileModalTitle">
                                Edit Principle Employer Profile
                            </div>
                            <div class="principleProfileModalSubTitle">
                                Update Principle information and it's details
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white principleProfileModalClose"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>

                <!-- BODY -->
                <div class="modal-body principleProfileModalBody">

                    <!-- STEPPER -->
                    <div class="stepper-modern my-3">
                        <div class="step-item active">Basic</div>
                        <div class="step-item">Contact</div>
                        <div class="step-item">Authorized Representative</div>
                        <div class="step-item" hidden>Policy</div>
                    </div>

                    <!-- STEP 1 -->
                    <div class="form-step" data-step="1">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Basic Details</h5>

                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">Principal Employer Name</label>
                                    <input type="text" class="form-control" ng-model="AgencyName">
                                </div>
                                <div>
                                    <label class="form-label">LIN Number</label>
                                    <input type="text" class="form-control" ng-model="LIN">
                                </div>
                                <div>
                                    <label class="form-label">Industry</label>
                                    <input type="text" class="form-control" ng-model="Industry" ng-disabled="true">
                                </div>

                                <div>
                                    <label class="form-label">PE Code</label>
                                    <input type="text" class="form-control" ng-model="PartyCode" ng-disabled="true">
                                </div>

                                <div>
                                    <label class="form-label">GST Number</label>
                                    <input type="text" class="form-control" id="gst" maxlength="15" ng-model="GSTIN">
                                    <small class="text-muted validation-msg" id="gstMsg"></small>
                                </div>

                                <div>
                                    <label class="form-label">PAN Number</label>
                                    <input type="text" class="form-control" id="pan" maxlength="10" ng-model="PanNo">
                                    <small class="text-muted validation-msg" id="panMsg"></small>
                                </div>

                                <div>
                                    <label class="form-label">Registered Office Address</label>
                                    <input type="text" class="form-control" ng-model="RegisteredAddress">
                                </div>

                                <div>
                                    <label class="form-label">City</label>
                                    <input type="text" class="form-control" ng-model="City" ng-disabled="true">
                                </div>

                                <div>
                                    <label class="form-label">State</label>
                                    <input type="text" class="form-control" ng-model="State" ng-disabled="true">
                                </div>

                                <div>
                                    <label class="form-label">Country</label>
                                    <input type="text" class="form-control" ng-model="Country" ng-disabled="true">
                                </div>

                                <div>
                                    <label class="form-label">Pincode</label>
                                    <input type="text" class="form-control" ng-model="Pincode" ng-disabled="true">
                                </div>

                                <div>
                                    <label class="form-label">CIN Number(if applicable)</label>
                                    <input type="text" class="form-control" id="cin" ng-model="CIN">
                                    <small class="text-muted validation-msg" id="cinMsg"></small>
                                </div>


                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn d-none">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn next-btn">Next</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 2 -->
                    <div class="form-step" data-step="2" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Contact Information</h5>

                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">Contact Person Name</label>
                                    <input type="text" class="form-control" ng-model="ContactPerson">
                                </div>

                                <div>
                                    <label class="form-label">Designation</label>
                                    <input type="text" class="form-control" ng-model="Designation">
                                </div>
                                <div>
                                    <label class="form-label">Contact Person Number</label>
                                    <input type="text" class="form-control" ng-disabled="true" ng-model="Mobile" maxlength="10" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
                                </div>

                                <div>
                                    <label class="form-label">Alternate Contact Number</label>
                                    <input type="text" class="form-control" ng-model="almobile">
                                </div>

                                <div>
                                    <label class="form-label">Official Email Address</label>
                                    <input type="email" id="txtEmail" class="form-control" ng-disabled="true" ng-model="Email" onblur="validateEmail('#txtEmail')">
                                </div>

                                <div>
                                    <label class="form-label">Website</label>
                                    <input type="text" class="form-control" ng-model="Website">
                                </div>
                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn next-btn" ng-click="SaveStep1()">Next</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 3 -->
                    <div class="form-step" data-step="3" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Authorized Representative</h5>

                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">Representative Name</label>
                                    <input type="text" class="form-control" ng-model="Representnamet">
                                </div>

                                <div>
                                    <label class="form-label">Designation</label>
                                    <input type="text" class="form-control" ng-model="representDesignation">
                                    <small id="accMsg" class="text-muted"></small>
                                </div>

                                <div>
                                    <label class="form-label">Mobile Number</label>
                                    <input type="text" class="form-control" ng-model="RepMobile" maxlength="10" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
                                    <small id="ifscMsg" class="text-muted"></small>
                                </div>

                                <div>
                                    <label class="form-label">Email</label>
                                    <input type="email" id="txtEmail" class="form-control" ng-model="RepEmail" onblur="validateEmail('#txtreEmail')">
                                    <small id="ifscMsg" class="text-muted"></small>
                                </div>

                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn" ng-click="SaveStep4();FinalSave()">Submit</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 4 -->
                    <div class="form-step" data-step="4" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Policy</h5>

                            <div class="declaration-list">

                                <div class="decl-item" data-id="indemnity">
                                    <div>
                                        Indemnity Clause
                                        <div class="status"
                                             ng-class="Dec1==1 ? 'done' : 'pending'">
                                            {{ Dec1==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
                                    <button class="btn view-btn open-decl" ng-hide="Dec1==1" ng-click="openDeclaration('Indemnity Clause')">View & Accept</button>
                                </div>

                                <div class="decl-item" data-id="confidentiality">
                                    <div>
                                        Confidentiality Agreement
                                        <div class="status"
                                             ng-class="Dec2==1 ? 'done' : 'pending'">
                                            {{ Dec2==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
                                    <button class="btn view-btn open-decl" ng-hide="Dec2==1" ng-click="openDeclaration('Confidentiality Agreement')">View & Accept</button>
                                </div>

                                <div class="decl-item" data-id="conduct">
                                    <div>
                                        Code of Conduct
                                        <div class="status"
                                             ng-class="Dec3==1 ? 'done' : 'pending'">
                                            {{ Dec3==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
                                    <button class="btn view-btn open-decl" ng-hide="Dec3==1" ng-click="openDeclaration('Code of Conduct')">View & Accept</button>
                                </div>

                                <div class="decl-item" data-id="aml">
                                    <div>
                                        AML Declaration
                                        <div class="status"
                                             ng-class="Dec4==1 ? 'done' : 'pending'">
                                            {{ Dec4==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
                                    <button class="btn view-btn open-decl" ng-hide="Dec4==1" ng-click="openDeclaration('AML Declaration')">View & Accept</button>
                                </div>

                                <div class="decl-item" data-id="abc">
                                    <div>
                                        Anti-Bribery
                                        <div class="status"
                                             ng-class="Dec5==1 ? 'done' : 'pending'">
                                            {{ Dec5==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
                                    <button class="btn view-btn open-decl" ng-hide="Dec5==1" ng-click="openDeclaration('Anti-Bribery')">View & Accept</button>
                                </div>

                                <div class="decl-item" data-id="dpdp">
                                    <div>
                                        DPDP Declaration
                                        <div class="status"
                                             ng-class="Dec6==1 ? 'done' : 'pending'">
                                            {{ Dec6==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
                                    <button class="btn view-btn open-decl" ng-hide="Dec6==1" ng-click="openDeclaration('DPDP Declaration')">View & Accept</button>
                                </div>

                            </div>

                            <div class="entity-footer d-flex justify-content-between mt-3">
                                <button class="btn save-btn prev-btn">Previous</button>

                                <div class="ms-auto d-flex gap-2">
                                    <button class="btn save-btn" ng-click="FinalSave()">Submit</button>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!--Modal for Declaration-->
                    <div class="modal fade" id="declModal" tabindex="-1">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h6 class="modal-title" id="declTitle"></h6>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body">
                                    <div class="legal-box" id="declContent"></div>

                                    <div class="legal-agree mt-3">
                                        <label>
                                            <input type="checkbox" id="declAgree">
                                            I agree
                                        </label>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button class="btn save-btn" id="confirmDecl" ng-click="confirmDeclaration()">Confirm</button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>


            </div>

        </div>

    </div>

    <!-- Main Layout -->
    <div class="row g-3 principleProfileMainWrapper">

        <!-- LEFT SIDEBAR -->
        <div class="col-xl-3 col-lg-4">

            <div class="principleProfileSidebar">

                <!-- Top Company Card -->
                <div class="principleProfileCompanyCard">

                    <div class="d-flex align-items-start gap-3">

                        <!-- Logo -->
                        <div class="principleProfileLogo">
                        </div>

                        <!-- Company Info -->
                        <div class="flex-grow-1">

                            <div class="principleProfileCompanyName">
                                {{Profile.PartyName || '-'}}
                            </div>

                            <div class="principleProfileCompanyCode">
                                {{Profile.PartyCode || '-'}}
                            </div>

                            <div class="principleProfileRatingWrapper">

                                <div class="principleProfileVerified">
                                    <i class="bi bi-patch-check-fill"></i>
                                </div>

                                <div class="principleProfileStars">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>

                                <div class="principleProfileRatingText">
                                    4.3
                                </div>

                                <div class="principleProfileReviewCount">
                                    (83)
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="principleProfileDivider"></div>

                    <!-- Contact Info -->
                    <div class="principleProfileContactList">

                        <div class="principleProfileContactItem">
                            <i class="bi bi-envelope"></i>
                            <span>{{Profile.EmailId || '-'}}</span>
                        </div>

                        <div class="principleProfileContactItem">
                            <i class="bi bi-telephone"></i>
                            <span>{{Profile.ContactNo || '-'}}</span>
                        </div>

                        <div class="principleProfileContactItem">
                            <i class="bi bi-geo-alt"></i>
                            <span>{{Profile.Address || '-'}}</span>
                        </div>

                    </div>

                </div>

                <!-- Sidebar Menu -->
                <div class="principleProfileMenuWrapper">

                    <button class="principleProfileMenuBtn active"
                            type="button"
                            data-target="principleBasicTab">

                        <span>Basic</span>

                        <i class="bi bi-arrow-right"></i>

                    </button>

                    <button class="principleProfileMenuBtn"
                            type="button"
                            data-target="principleRegistrationTab">

                        <span>Contact</span>

                        <i class="bi bi-arrow-right"></i>

                    </button>

                    <button class="principleProfileMenuBtn"
                            type="button"
                            data-target="principleFinancialTab">

                        <span>Authorized Representative</span>

                        <i class="bi bi-arrow-right"></i>

                    </button>

                    <button class="principleProfileMenuBtn"
                            type="button"
                            data-target="principleDeclarationTab" hidden>

                        <span>Policy</span>

                        <i class="bi bi-arrow-right"></i>

                    </button>

                    <button class="principleProfileMenuBtn"
                            type="button"
                            data-target="principleSubscriptionTab" hidden>

                        <span>Subscription</span>

                        <i class="bi bi-arrow-right"></i>

                    </button>

                </div>

            </div>

        </div>

        <!-- RIGHT CONTENT -->
        <div class="col-xl-9 col-lg-8">

            <div class="principleProfileContentCard">

                <!-- BASIC TAB -->
                <div class="principleProfileTab active"
                     id="principleBasicTab">

                    <div class="principleProfileSectionTitle">
                        Basic Details
                    </div>

                    <div class="row g-4">

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Principal Employer Name
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.AgencyName || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                PE Code
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.PartyCode || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                GSTIN Number
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.GSTIN || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                PAN Number
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.PanNo || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Registered Office Address
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.RegisteredAddress || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                City
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.City || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                State
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.State || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Country
                            </div>

                            <div class="principleProfileValue">
                                India
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Pincode
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.Pincode || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                CIN Number(if applicable)
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.CIN || '-'}}
                            </div>
                        </div>
                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                LIN Number
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.LINNO || '-'}}
                            </div>
                        </div>
                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Industry
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.Industryname || '-'}}
                            </div>
                        </div>

                    </div>

                </div>

                <!-- CONTACT TAB -->
                <div class="principleProfileTab"
                     id="principleRegistrationTab">

                    <div class="principleProfileSectionTitle">
                        Contact Information
                    </div>

                    <div class="row g-4">

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Contact Person Name
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.ContactPerson || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Designation
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.Designation || '-'}}
                            </div>
                        </div>
                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Contact Person Number
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.Mobile || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Alternate Contact Number
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.ContactMobile || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Official Email Address
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.Email || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Website URL
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.Website || '-'}}
                            </div>
                        </div>

                    </div>

                </div>

                <!-- AUTHORIZED TAB -->
                <div class="principleProfileTab"
                     id="principleFinancialTab">

                    <div class="principleProfileSectionTitle">
                        Authorized Representative
                    </div>

                    <div class="row g-4">

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Representative Name
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.Representativename || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Designation
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.RepresentativeDesignation || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Mobile Number
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.RepresentativeMobile   || '-'}}
                            </div>
                        </div>

                        <div class="col-xl-6 col-md-6">
                            <div class="principleProfileLabel">
                                Email ID
                            </div>

                            <div class="principleProfileValue">
                                {{Profile.RepresentativeEmail || '-'}}
                            </div>
                        </div>
                    </div>

                </div>

                <!-- POLICY TAB -->
                <div class="principleProfileTab"
                     id="principleDeclarationTab">

                    <div class="principleProfileSectionTitle">
                        Policy
                    </div>

                    <div class="principleProfileDeclarationWrapper">

                        <!-- ITEM -->
                        <div class="principleProfileDeclarationRow">

                            <div class="principleProfileDeclarationName">
                                Indemnity Clause
                            </div>
                            <div class="contractorProfileDeclarationName" ng-class="{'text-success': Profile.IndemnityClause == 1,
                                        'text-danger': Profile.IndemnityClause != 1}">
                                {{ Profile.IndemnityClause == 1 ? 'Done' : 'Pending' }}
                            </div>
                            @*<button type="button"
                                      class="principleProfileViewBtn">

                                Upload & View

                            </button>*@

                        </div>

                        <!-- ITEM -->
                        <div class="principleProfileDeclarationRow">

                            <div class="principleProfileDeclarationName">
                                Confidentiality Agreement
                            </div>

                            @*<button type="button"
                                      class="principleProfileViewBtn">

                                Upload & View

                            </button>*@
                            <div class="contractorProfileDeclarationName" ng-class="{'text-success': Profile.ConfidentialityAgreement == 1,
                                        'text-danger': Profile.ConfidentialityAgreement != 1}">
                                {{ Profile.ConfidentialityAgreement == 1 ? 'Done' : 'Pending' }}
                            </div>

                        </div>

                        <!-- ITEM -->
                        <div class="principleProfileDeclarationRow">

                            <div class="principleProfileDeclarationName">
                                Code of Conduct
                            </div>
                            <div class="contractorProfileDeclarationName" ng-class="{'text-success': Profile.CodeofConduct == 1,
                                        'text-danger': Profile.CodeofConduct != 1}">
                                {{ Profile.CodeofConduct == 1 ? 'Done' : 'Pending' }}
                            </div>
                        </div>

                        <!-- ITEM -->
                        <div class="principleProfileDeclarationRow">

                            <div class="principleProfileDeclarationName">
                                AML Declaration
                            </div>
                            <div class="contractorProfileDeclarationName" ng-class="{'text-success': Profile.AMLDeclaration == 1,
                                        'text-danger': Profile.AMLDeclaration != 1}">
                                {{ Profile.AMLDeclaration == 1 ? 'Done' : 'Pending' }}
                            </div>
                        </div>

                        <!-- ITEM -->
                        <div class="principleProfileDeclarationRow">

                            <div class="principleProfileDeclarationName">
