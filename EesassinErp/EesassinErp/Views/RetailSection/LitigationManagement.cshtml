<script>
    const monthYearEl = document.getElementById('month-year');
    const calendarBody = document.getElementById('calendar-body');
    const selectedDate = document.getElementById('selected-date');
    const caseList = document.getElementById('case-list');
    let currentDate = new Date();
    let eventMap = {}; // Global for storing events

    function formatDate(year, month, day) {
        return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    }

    function renderCalendar() {
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();

        const firstDay = new Date(year, month, 1);
        const lastDay = new Date(year, month + 1, 0);
        const monthName = firstDay.toLocaleString('default', { month: 'long' });
        monthYearEl.textContent = `${monthName} ${year}`;

        let startDay = firstDay.getDay();
        if (startDay === 0) startDay = 7; // Sunday last

        let day = 1;
        let rows = '';
        for (let i = 0; i < 6; i++) {
            let row = '<tr>';
            for (let j = 1; j <= 7; j++) {
                if ((i === 0 && j < startDay) || day > lastDay.getDate()) {
                    row += '<td></td>';
                } else {
                    const dateStr = formatDate(year, month + 1, day);
                    const isToday = new Date().toDateString() === new Date(year, month, day).toDateString();
                    const hasEvent = eventMap[dateStr];
                    const eventDot = hasEvent ? '<div class="event">•</div>' : '';

                    row += `<td class="${isToday ? 'selected' : ''}" onclick="selectDate(${year}, ${month + 1}, ${day})">
                            <div class="day-cell">${day}${eventDot}</div>
                        </td>`;
                    day++;
                }
            }
            row += '</tr>';
            rows += row;
        }

        calendarBody.innerHTML = rows;
        updateSelectedDate();
    }

    function selectDate(year, month, day) {
        const formattedDate = formatDate(year, month, day);


        // Update AngularJS scope safely
        if (window.angular && window.angular.element) {
            const scope = angular.element(document.querySelector('[ng-controller]')).scope();
            scope.$apply(() => {
                scope.searchTextCal = formattedDate;
            });
        }

        // Highlight selected
        document.querySelectorAll('#calendar-body td').forEach(td => td.classList.remove('selected'));
        const td = Array.from(document.querySelectorAll('#calendar-body td')).find(td =>
            td.textContent.trim() === String(day)
        );
        if (td) td.classList.add('selected');

        // Update date object
        currentDate = new Date(year, month - 1, day);
        updateSelectedDate();

        // Show cases if any
        const events = eventMap[formattedDate];
        if (events && events.length) {
            if (events[0].CaseNumber == '1') {
                switchTab('open')
            }
            else {
                switchTab('close')
            }

        }
    }


    function updateSelectedDate() {
        const dateStr = currentDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
        selectedDate.textContent = dateStr;
    }

    function changeMonth(offset) {
        currentDate.setMonth(currentDate.getMonth() + offset);
        renderCalendar();
    }

    // Call this from AngularJS when data is fetched
    function loadEventData(eventList) {
        eventMap = {};

        eventList.forEach(item => {
            const dt = new Date(item.FilingDate);
            const dateStr = formatDate(dt.getFullYear(), dt.getMonth() + 1, dt.getDate());

            if (!eventMap[dateStr]) {
                eventMap[dateStr] = [];
            }

            eventMap[dateStr].push({
                CaseNumber: item.CaseNumber

            });
        });

        renderCalendar();
    }

    // Initial render
    renderCalendar();
</script>


<script>
    function switchTab(tab) {
        // Toggle tab button styles
        const tabs = document.querySelectorAll('.tabs .tab');
        tabs.forEach(t => t.classList.remove('active'));

        if (tab === 'open') {
            tabs[0].classList.add('active');
            document.getElementById('open-case-list').style.display = 'block';
            document.getElementById('close-case-list').style.display = 'none';
        } else {
            tabs[1].classList.add('active');
            document.getElementById('open-case-list').style.display = 'none';
            document.getElementById('close-case-list').style.display = 'block';
        }
    }
    document.addEventListener('DOMContentLoaded', function () {
        const ctx3 = document.getElementById('caseChart').getContext('2d');
        caseChart = new Chart(ctx3, {
            type: 'bar',
            data: {
                labels: [],
                datasets: [{
                    label: 'Number of Cases',
                    data: [],
                    backgroundColor: '#00bfa5',
                    borderRadius: 4,
                    barThickness: 30
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Number of Cases'
                        },
                        ticks: { stepSize: 10 }
                    },
                    x: {
                        ticks: { maxRotation: 35, minRotation: 35 }
                    }
                }
            }
        });
    });
    function closeModal() {
        modal.style.display = 'none';
    }

    const modal = document.getElementById('popupModal');

    window.addEventListener('load', function () {
        document.body.classList.add('loaded');
    });


</script>



