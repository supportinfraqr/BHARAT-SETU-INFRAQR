@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "PrincipleEmployerRegistration";
    Layout = "~/Views/Common/Withoutlayout.cshtml";
}
<script src="~/scripts/RetailJsLib/PrincipleEmployerCodeController.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">


<style>

    /* ==========================
       NAVBAR
    ========================== */

    .autoFillDocNavbar {
        font-family: "Inter", sans-serif;
        height: 68px;
        background: #F4F9FF;
        border-bottom: 1px solid #e3e8ef;
        display: flex;
        align-items: center;
    }

    .autoFillDocNavbarInner {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .autoFillDocLogo {
        font-size: 22px;
        font-weight: 600;
        line-height: 1;
    }

        .autoFillDocLogo .logoBlue {
            color: #022B5E;
        }

        .autoFillDocLogo .logoOrange {
            color: #E45D24;
        }

        .autoFillDocLogo .logoGreen {
            color: #1D8F4E;
        }

    .autoFillDocSupportBtn {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #4b5563;
        font-size: 15px;
        font-weight: 500;
        padding: 10px 16px;
        border-radius: 12px;
        transition: .25s;
    }

        .autoFillDocSupportBtn:hover {
            background: #ffffff;
            color: #022B5E;
        }

        .autoFillDocSupportBtn i {
            font-size: 18px;
        }

    .principleEmpRegistration {
        font-family: "Inter", sans-serif;
        --primary: #022B5E; /* theme accent */
        --primary-dark: #002048;
        --card-bg: #FEF3EC;
        background: #FFF;
        color: #223;
        min-height: 84vh;
    }

    /* Labels */
    .form-label {
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 4px;
    }

    /* Inputs */
    .form-control-sm,
    .form-select-sm {
        border-radius: 8px;
        font-size: 0.9rem;
    }

    /* Section title */
    .section-title {
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--primary);
    }

    /* Upload Field (Aligned) */
    .upload-field {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .upload-input-wrap {
        position: relative;
        flex: 1;
        border: 1px solid rgba(0,0,0,0.15);
        border-radius: 8px;
        padding: 6px 8px;
        background: #fff;
        min-height: 32px;
        display: flex;
        align-items: center;
    }

    .upload-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .file-name {
        font-size: 0.72rem;
        color: #555;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .upload-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .upload-icon {
        font-size: 0.9rem;
        color: var(--primary);
        cursor: pointer;
        padding: 4px;
        border-radius: 6px;
    }

        .upload-icon:hover {
            background: rgba(228,93,39,0.12);
        }


    /* Footer */
    .employee-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 4px;
    }

    /* Save Button (Primary) */
    .import-save-btn {
        background: #022B5E !important; /* primary */
        color: #fff !important;
        border: none;
        font-size: 0.9rem;
        border-radius: 999px;
        font-weight: 400;
        padding: 4px 8px;
        transition: 0.25s ease;
    }

        .import-save-btn:hover {
            background: var(--primary-dark) !important;
        }

    /* Cancel button */
    .cancel-btn {
        background: transparent;
        color: var(--primary);
        border: 1px solid var(--primary);
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 400;
        padding: 4px 8px;
        transition: 0.25s ease;
    }

        .cancel-btn:hover {
            background: var(--primary);
            color: #fff;
        }

    .hiddenfield {
        display: none;
    }

    .cropper-view-box,
    .cropper-face {
        border-radius: 50%;
    }
</style>
<script>

    $(document).ready(function () {
        $('.ddfile').change(function () {
            //console.log(this.files);
            var f = this.files;
            var el = $(this).parent();
            if (f.length > 1) {
                console.log(this.files, 1);
                el.text('Sorry, multiple files are not allowed');
                return;
            }
            // el.removeClass('focus');
            el.html(f[0].name + '<br>' +
                '<span class="sml">' +
                'type: ' + f[0].type + ', ' +
                Math.round(f[0].size / 1024) + ' KB</span>');
        });

        $('input[type=file]').on('focus', function () {
            $(this).parent().addClass('focus');
        });

        $('input[type=file]').on('blur', function () {
            $(this).parent().removeClass('focus');
        });

    });
</script>

<!-- TOP NAVBAR -->
<div class="autoFillDocNavbar">

    <div class="autoFillDocNavbarInner">

        <div class="autoFillDocLogo">

            <span class="logoBlue">Bharat</span><span class="logoOrange">Shram</span><span class="logoGreen">Setu</span>

        </div>

        <a href="#" class="autoFillDocSupportBtn">

            <i class="fa-solid fa-headset"></i>

            <span>Support</span>

        </a>

    </div>

</div>

<div class="principleEmpRegistration px-4 py-4">

    <form>
        <!-- Employee Details  -->
        <h5 class="section-title" style="font-size:1.5rem;">Principle Employer Registration </h5>
        <hr />
        <h6 class="section-title">Basic Detail</h6>
        <div class="row g-3">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Principal Employer Name </label>
                <input class="form-control form-control-sm validate" ng-model="AgencyName">
            </div>
            <div class="col-lg-3 col-md-6" hidden>
                <label class="form-label">Industry Type </label>
                <input class="form-control form-control-sm">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Name of Eshtablishment </label>
                <input class="form-control form-control-sm validate" ng-model="nameofeshtablishment">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Type of Eshtablishment</label>
                <input class="form-control form-control-sm validate" ng-model="typeofeshtablishment">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Valid Upto</label>
                <input type="date" class="form-control form-control-sm validate" id="txtvalidupto" ng-model="Validupto">
            </div>
            <div class="col-lg-3 col-md-6" hidden>
                <label class="form-label">PE Code</label>
                <input class="form-control form-control-sm">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">PAN Number </label>
                <input class="form-control form-control-sm validate" id="pan" maxlength="10" ng-model="PanNo">
                <small class="text-muted validation-msg" id="panMsg"></small>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">GSTIN </label>
                <input class="form-control form-control-sm validate" id="gst" maxlength="15" ng-model="GSTIN">
                <small class="text-muted validation-msg" id="gstMsg"></small>
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="form-label">Registered Office Address </label>
                <input class="form-control form-control-sm validate" ng-model="RegisteredAddress">
            </div>
            <div class="col-lg-3 col-md-6" ng-init="AllCountry()">
                <label class="form-label">Country </label>
                <select id="ddlCountry" class="select2 form-control" ng-change="AllState()" ng-model="Country">
                    <option value="">Select Country</option>
                    <option ng-repeat="x in AllCountryList" value="{{x.CountryId}}">
                        {{x.CountryName}}
                    </option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">State </label>
                <select class="form-select form-select-sm validate"
                        ng-model="State">
                    <option value="">Select State</option>
                    <option ng-repeat="x in AllCityList | unique:'STATE_NAME'"
                            value="{{x.STATE_NAME}}">
                        {{x.STATE_NAME}}
                    </option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6" ng-init="AllCity()">
                <label class="form-label">City </label>
                <select class="form-select form-select-sm validate"
                        ng-model="City">
                    <option value="">Select City</option>
                    <option ng-repeat="x in AllCityList | filter:{STATE_NAME: State}"
                            value="{{x.CITY_NAME}}">
                        {{x.CITY_NAME}}
                    </option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Pincode</label>
                <input type="text" class="form-control form-control-sm validate" id="txtPincode" ng-model="Pincode" numeric-only dynamic-length maxlength="6" minlength="6">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">CIN Number(if applicable) </label>
                <input class="form-control form-control-sm validate" id="cin" ng-model="CIN">
                <small class="text-muted validation-msg" id="cinMsg"></small>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">LIN Number</label>
                <input class="form-control form-control-sm validate" id="cin" ng-model="LIN">
            </div>
            <div class="col-lg-3 col-md-6" ng-init="AllIndustry()">
                <label class="form-label">Industry </label>
                <select class="form-select form-select-sm validate"
                        ng-model="Industry">
                    <option value="">Select Industry</option>
                    <option ng-repeat="x in IndustryList" value="{{x.Id}}">{{x.Industry}}</option>
                </select>
            </div>
        </div>
        <!-- Contact  -->
        <hr>
        <h6 class="section-title">Contact Information</h6>
        <div class="row g-3">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Contact Person Name </label>
                <input class="form-control form-control-sm validate" ng-model="ContactPerson">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Designation </label>
                <input class="form-control form-control-sm validate" ng-model="Designation">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Contact Person Number </label>
                <input class="form-control form-control-sm validate" ng-model="Mobile" ng-disabled="IsMobileDisabled" maxlength="10" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
            </div>
            <div class="col-lg-3 col-md-6" hidden>
                <label class="form-label">Alternate Contact Number </label>
                <input class="form-control form-control-sm" ng-model="altMobile" maxlength="10" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Official Email Address </label>
                <input class="form-control form-control-sm validate" ng-disabled="IsEmailDisabled" ng-model="Email" onblur="validateEmail('#txtEmail')">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Website URL </label>
                <input class="form-control form-control-sm validate" ng-model="Website">
            </div>

        </div>

        <!-- Authorized Representative  -->
        <hr>
        <h6 class="section-title">Authorized Representative</h6>
        <div class="row g-3">
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Representative Name </label>
                <input class="form-control form-control-sm validate" ng-model="Representnamet">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Designation </label>
                <input class="form-control form-control-sm validate" ng-model="representDesignation">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Mobile Number </label>
                <input class="form-control form-control-sm validate" ng-model="RepMobile" maxlength="10" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">Email ID </label>
                <input type="email" id="txtEmail" class="form-control" ng-model="RepEmail" onblur="validateEmail('#txtreEmail')">
                <small id="ifscMsg" class="text-muted"></small>
            </div>
        </div>

    </form>
    <hr />
    <div class="employee-modal-footer">
        <button class="btn cancel-btn" data-bs-dismiss="modal">Cancel</button>
        <button class="btn import-save-btn" ng-click="SavePrincipleRegistration();ManageLog('Submit Principle Registration Form')">
            Submit
        </button>
    </div>

</div>