
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Contractor Profile";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


<script src="~/Content/Dashboards/ContractorProfile/script.js"></script>
<link href="~/Content/Dashboards/ContractorProfile/style.css" rel="stylesheet" />
<script src="~/scripts/RetailJsLib/ContractorDashboardController.js"></script>

<style>
    .done {
        color: green;
    }
</style>

<div class="contractorProfile px-4 py-2" ng-init="getContractorDetail()">
    <!-- Top Bar -->
    <div class="d-flex align-items-center justify-content-between mb-3 contractorProfileTopBar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h4 class="mb-0 contractorProfileHeading">
                Contractor’s Profile
            </h4>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-edit" id="btneditProfile" type="button" data-bs-toggle="modal" data-bs-target="#editContractorProfileModal" ng-click="BindRegistration()">
                <i class="bi bi-pencil-square"></i>
                <span>Edit Profile</span>
            </button>
        </div>
    </div>

    <!-- EDIT CONTRACTOR PROFILE MODAL -->
    <div class="modal fade contractorProfileModal"
         id="editContractorProfileModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-fullscreen contractorProfileFullscreenModal">

            <div class="modal-content contractorProfileModalContent">

                <!-- HEADER -->
                <div class="modal-header contractorProfileModalHeader">
                    <div class="contractorProfileModalTitleWrapper">
                        <div class="contractorProfileModalIcon">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <div class="contractorProfileModalTitle">
                                Edit Contractor Profile
                            </div>
                            <div class="contractorProfileModalSubTitle">
                                Update contractor information and company details
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white contractorProfileModalClose"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>

                <!-- BODY -->
                <div class="modal-body contractorProfileModalBody">

                    <!-- STEPPER -->
                    <div class="stepper-modern my-3">
                        <div class="step-item active">Basic</div>
                        <div class="step-item">Registration</div>
                        <div class="step-item">Financial</div>
                        <div class="step-item">Service</div>
                        <div class="step-item">Documents</div>
                        <div class="step-item">Declarations</div>
                        <div class="step-item">Undertaking</div>
                    </div>

                    <!-- STEP 1 -->
                    <div class="form-step" data-step="1">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Basic Company Details</h5>

                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">Name of the Agency</label>
                                    <input type="text" class="form-control" ng-model="AgencyName">
                                </div>

                                <div>
                                    <label class="form-label">Registered Office Address</label>
                                    <input type="text" class="form-control" ng-model="RegisteredAddress">
                                </div>

                                <div>
                                    <label class="form-label">Corporate Office Address</label>
                                    <input type="text" class="form-control" ng-model="CorporateAddress">
                                </div>

                                <div>
                                    <label class="form-label">Contact Person Name</label>
                                    <input type="text" class="form-control" ng-model="ContactPerson">
                                </div>

                                <div>
                                    <label class="form-label">Designation</label>
                                    <input type="text" class="form-control" ng-model="Designation">
                                </div>

                                <div>
                                    <label class="form-label">Mobile Number</label>
                                    <input type="text" class="form-control" ng-model="Mobile"  ng-disabled="true" maxlength="10" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
                                </div>

                                <div>
                                    <label class="form-label">Email ID</label>
                                    <input type="email" id="txtEmail" class="form-control" ng-disabled="true" ng-model="Email" onblur="validateEmail('#txtEmail')">
                                </div>

                                <div>
                                    <label class="form-label">Website</label>
                                    <input type="text" class="form-control" ng-model="Website">
                                </div>

                                <div>
                                    <label class="form-label">Year of Establishment</label>
                                    <input type="text" maxlength="4" class="form-control" ng-model="YearEstablishment" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
                                </div>

                                <div class="multi-select" style="position:relative; width:300px;">

                                    <label class="form-label">Type of Organization</label>

                                    <input type="text"
                                           readonly id="multiDisplay"
                                           class="form-control multi-input"
                                           data-target="industriesDropdown1"
                                           placeholder="Select"
                                           style="width:100%; padding:6px; cursor:pointer;" ng-model="Organization" />

                                    <div id="industriesDropdown1"
                                         class="multi-select-dropdown"
                                         style="display:none; position:absolute; background:#fff; border:1px solid #ccc; width:100%; max-height:150px; overflow:auto; z-index:999; padding:5px;">

                                        <label><input type="checkbox" value="Proprietorship"> Proprietorship</label>
                                        <label><input type="checkbox" value="Partnership"> Partnership</label>
                                        <label><input type="checkbox" value="LLP"> LLP</label>
                                        <label><input type="checkbox" value="Pvt Ltd"> Pvt Ltd</label>
                                        <label><input type="checkbox" value="Public Ltd"> Public Ltd</label>

                                    </div>
                                </div>
                                <div ng-init="AllCountry()">
                                    <label class="form-label">Country </label>
                                    <select id="ddlCountry" class="select2 form-control" ng-model="Country">
                                        <option value="">Select Country</option>
                                        <option ng-repeat="x in AllCountryList" value="{{x.CountryId}}">
                                            {{x.CountryName}}
                                        </option>
                                    </select>
                                </div>
                                <div ng-init="AllCity()">
                                    <label class="form-label">State </label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="State">
                                        <option value="">Select State</option>
                                        <option ng-repeat="x in AllCityList | unique:'STATE_NAME'"
                                                value="{{x.STATE_NAME}}">
                                            {{x.STATE_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">City </label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="City">
                                        <option value="">Select City</option>
                                        <option ng-repeat="x in AllCityList | filter:{STATE_NAME: State}"
                                                value="{{x.CITY_NAME}}">
                                            {{x.CITY_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">Pincode </label>
                                    <input type="text" class="form-control form-control-sm validate" id="txtPincode" ng-model="Pincode" numeric-only dynamic-length maxlength="6" minlength="6">
                                </div>
                                <div ng-init="AllIndustry()">
                                    <label class="form-label">Industry </label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="Industry">
                                        <option value="">Select Industry</option>
                                        <option ng-repeat="x in IndustryList" value="{{x.Id}}">{{x.Industry}}</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">LIN Number</label>
                                    <input class="form-control form-control-sm validate" id="LIN" ng-model="LIN">
                                </div>



                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn d-none">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn next-btn" ng-click="SaveStep1()">Next</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 2 -->
                    <div class="form-step" data-step="2" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Business Registration Details</h5>

                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">PAN</label>
                                    <input type="text" class="form-control" id="pan" maxlength="10" ng-model="PanNo">
                                    <small class="text-muted validation-msg" id="panMsg"></small>
                                </div>

                                <div>
                                    <label class="form-label">TAN</label>
                                    <input type="text" class="form-control" id="tan" maxlength="10" ng-model="TAN">
                                    <small class="text-muted validation-msg" id="tanMsg"></small>
                                </div>

                                <div>
                                    <label class="form-label">GSTIN</label>
                                    <input type="text" class="form-control" id="gst" maxlength="15" ng-model="GSTIN">
                                    <small class="text-muted validation-msg" id="gstMsg"></small>
                                </div>

                                <div>
                                    <label class="form-label">CIN / LLPIN</label>
                                    <input type="text" class="form-control" id="cin" ng-model="CIN">
                                    <small class="text-muted validation-msg" id="cinMsg"></small>
                                </div>

                                <div>
                                    <label class="form-label">Shop & Establishment Registration</label>
                                    <input type="text" class="form-control" ng-model="SHOPREGI">
                                </div>

                                <div>
                                    <label class="form-label">MSME (Udyam) Registration</label>
                                    <input type="text" class="form-control" ng-model="MSME">
                                </div>

                                <div>
                                    <label class="form-label">EPF Registration No.</label>
                                    <input type="text" class="form-control" ng-model="EPFREGNO">
                                </div>

                                <div>
                                    <label class="form-label">ESIC Registration No.</label>
                                    <input type="text" class="form-control" ng-model="ESICREGNO">
                                </div>

                                <div>
                                    <label class="form-label">Professional Tax Registration</label>
                                    <input type="text" class="form-control" ng-model="ProfessionalREGNO">
                                </div>

                                <div>
                                    <label class="form-label">Labour Welfare Fund Registration</label>
                                    <input type="text" class="form-control" ng-model="LabourREGNO">
                                </div>

                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn next-btn" ng-click="SaveStep2()">Next</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 3 -->
                    <div class="form-step" data-step="3" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Financial Details</h5>

                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">Bank Name</label>
                                    <input type="text" class="form-control" ng-model="BankName">
                                </div>

                                <div>
                                    <label class="form-label">Account Number</label>
                                    <input type="text" class="form-control" id="accountNo" ng-model="AccountNumber" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
                                    <small id="accMsg" class="text-muted"></small>
                                </div>

                                <div>
                                    <label class="form-label">IFSC Code</label>
                                    <input type="text" class="form-control" id="ifsc" maxlength="11" ng-model="IFSCCode">
                                    <small id="ifscMsg" class="text-muted"></small>
                                </div>

                                <!-- Cancelled Cheque -->
                                <div>
                                    <label class="form-label d-block">Cancelled Cheque</label>

                                    <div class="d-flex gap-3 mt-1">
                                        <select ng-model="CancelledCheque" class="form-select">
                                            <option value="">Select</option>
                                            <option value="No">No</option>
                                            <option value="Yes">Yes</option>
                                        </select>

                                    </div>

                                </div>

                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn next-btn" ng-click="SaveStep4()">Next</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 4 -->
                    <div class="form-step" data-step="4" style="display: none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Service Profile</h5>

                            <div class="form-grid mt-3">



                                <div class="multi-select" style="position:relative; width:300px;">

                                    <label>Type of Contractor</label>

                                    <input type="text"
                                           id="ServicesOffered"
                                           readonly class="form-control"
                                           placeholder="Select"
                                           style="width:100%; padding:6px; cursor:pointer;" />

                                    <div id="serviceDropdown" class="multi-select-dropdown"
                                         style="display:none; position:absolute; background:#fff; border:1px solid #ccc; width:100%; max-height:150px; overflow:auto; z-index:999;">

                                        <label><input type="checkbox" value="Manpower Supply"> Manpower Supply</label><br>
                                        <label><input type="checkbox" value="Facility Management"> Facility Management</label><br>
                                        <label><input type="checkbox" value="Security Services"> Security Services</label><br>
                                        <label><input type="checkbox" value="Housekeeping"> Housekeeping</label><br>
                                        <label><input type="checkbox" value="IT Services"> IT Services</label><br>
                                        <label><input type="checkbox" value="Consulting"> Consulting</label><br>

                                    </div>

                                </div>


                                <div class="multi-select" style="position:relative; width:300px;">

                                    <label class="form-label">Labour Supply Contractors</label>

                                    <input type="text"
                                           readonly id="IndustriesServed"
                                           class="form-control multi-input"
                                           data-target="industriesDropdown"
                                           placeholder="Select"
                                           style="width:100%; padding:6px; cursor:pointer;" />

                                    <div id="industriesDropdown"
                                         class="multi-select-dropdown"
                                         style="display:none; position:absolute; background:#fff; border:1px solid #ccc; width:100%; max-height:150px; overflow:auto; z-index:999; padding:5px;">

                                        <label><input type="checkbox" value="Manufacturing"> Manufacturing</label><br>
                                        <label><input type="checkbox" value="IT"> IT</label><br>
                                        <label><input type="checkbox" value="Healthcare"> Healthcare</label><br>
                                        <label><input type="checkbox" value="Retail"> Retail</label><br>
                                        <label><input type="checkbox" value="Banking"> Banking</label><br>
                                        <label><input type="checkbox" value="Logistics"> Logistics</label><br>

                                    </div>
                                </div>

                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn">Previous</button>

                                <div class="ms-auto d-flex gap-2">
                                    <button class="btn save-btn next-btn" ng-click="SaveStep5()">Next</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 5 -->
                    <div class="form-step" data-step="5" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Documents Checklist</h5>
                            <div class="form-grid mt-2">

                                <!-- ITEM -->
                                <div class="doc-item">
                                    <label>PAN Card</label>
                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File4"
                                           on-change="saveFile('File4',11)" />
                                    <a ng-if="File4"
                                       href="javascript:void(0)"
                                       class="icon-link me-2"
                                       ng-click="ViewFileC(File4,'PAN Card')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File4"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File4,'PAN Card')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>GST Certificate</label>
                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File5"
                                           on-change="saveFile('File5',12)" />  <a ng-if="File5"
                                                                                   href="javascript:void(0)"
                                                                                   class="icon-link me-2"
                                                                                   ng-click="ViewFileC(File5,'GST Certificate')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File5"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File5,'Upload Copy 2')">
                                        <i class="bi bi-download"></i>
                                    </a>

                                </div>

                                <div class="doc-item">
                                    <label>Incorporation Certificate</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File6"
                                           on-change="saveFile('File6',13)" />  <a ng-if="File6"
                                                                                   href="javascript:void(0)"
                                                                                   class="icon-link me-2"
                                                                                   ng-click="ViewFileC(File6,'Incorporation Certificate')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File6"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File6,'Incorporation Certificate')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>ESIC Registration Certificate</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File7"
                                           on-change="saveFile('File7',14)" />  <a ng-if="File7"
                                                                                   href="javascript:void(0)"
                                                                                   class="icon-link me-2"
                                                                                   ng-click="ViewFileC(File7,'EPF & ESIC Certificates')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File7"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File7,'EPF & ESIC Certificates')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>Labour License</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File8"
                                           on-change="saveFile('File8',15)" />  <a ng-if="File8"
                                                                                   href="javascript:void(0)"
                                                                                   class="icon-link me-2"
                                                                                   ng-click="ViewFileC(File8,'Labour License')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File8"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File8,'Labour License')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>Cancelled Cheque</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File9"
                                           on-change="saveFile('File9',16)" />  <a ng-if="File9"
                                                                                   href="javascript:void(0)"
                                                                                   class="icon-link me-2"
                                                                                   ng-click="ViewFileC(File9,'Cancelled Cheque')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File9"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File9,'Cancelled Cheque')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>MSME(Udhyam) Registration</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File22"
                                           on-change="saveFile('File22',37)" />  <a ng-if="file22"
                                                                                    href="javascript:void(0)"
                                                                                    class="icon-link me-2"
                                                                                    ng-click="ViewFileC(file22,'MSME(Udhyam) Registration')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="file22"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(file22,'MSME(Udhyam) Registration')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>Security License</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File23"
                                           on-change="saveFile('File23',38)" />  <a ng-if="file23"
                                                                                    href="javascript:void(0)"
                                                                                    class="icon-link me-2"
                                                                                    ng-click="ViewFileC(file23,'Security License')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="file23"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(file23,'Security License')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>PF Registration Certification</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File16"
                                           on-change="saveFile('File16',23)" />  <a ng-if="File16"
                                                                                    href="javascript:void(0)"
                                                                                    class="icon-link me-2"
                                                                                    ng-click="ViewFileC(File16,'PF Registration Certification')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File16"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File16,'PF Registration Certification')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>Shop & Establishment Registration</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File24"
                                           on-change="saveFile('File24',39)" />  <a ng-if="file24"
                                                                                    href="javascript:void(0)"
                                                                                    class="icon-link me-2"
                                                                                    ng-click="ViewFileC(file24,'Establishment Registration')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="file24"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(file24,'Establishment Registration')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>

                                <div class="doc-item">
                                    <label>Insurance Policy</label>

                                    <input type="file"
                                           class="form-control mt-1"
                                           file-model="File19"
                                           on-change="saveFile('File19',26)" />  <a ng-if="File19"
                                                                                    href="javascript:void(0)"
                                                                                    class="icon-link me-2"
                                                                                    ng-click="ViewFileC(File19,'Financial Statements 2')">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a ng-if="File19"
                                       href="javascript:void(0)"
                                       ng-click="DownloadFileC(File19,'Financial Statements 2')">
                                        <i class="bi bi-download"></i>
                                    </a>
                                </div>


                            </div>

                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-4">

                                <button class="btn save-btn prev-btn">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn next-btn">Next</button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 6 -->
                    <div class="form-step" data-step="6" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Declarations</h5>

                            <div class="declaration-list">

                                <div class="decl-item" data-id="indemnity">
                                    <div>
                                        Indemnity Clause
                                        <div class="status"
                                             ng-class="Dec1==1 ? 'done' : 'pending'">
                                            {{ Dec1==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
                                    <button class="btn view-btn open-decl" ng-hide="Dec1==1" ng-click="openDeclaration('Indemnity Clause')">View & Accept</button>
                                </div>

                                <div class="decl-item" data-id="confidentiality">
                                    <div>
                                        Confidentiality Agreement
                                        <div class="status"
                                             ng-class="Dec2==1 ? 'done' : 'pending'">
                                            {{ Dec2==1 ? 'Done' : 'Pending' }}
                                        </div>
                                    </div>
