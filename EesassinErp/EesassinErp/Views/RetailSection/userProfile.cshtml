
@{
    ViewBag.Title = "userProfile";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body::-webkit-scrollbar {
            display: none;
        }

        /* ===================== USER PROFILE PAGE ===================== */
        .userProfile {
            font-family: "Inter", sans-serif;
            --primary: #E45D27; /* theme accent */
            --primary-dark: #c44b1d;
            --card-bg: #FEF3EC;
            background: #FFF1EB;
            color: #223;
            padding-bottom: 3rem;
            min-height: 100vh;
        }

        .dropdown-menu {
            min-width: 120px;
            font-size: 0.85rem;
            border-radius: 6px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }

        /* ----- HEADER SECTION ----- */
        .userProfile .profile-header {
            background: linear-gradient(90deg, #FD670B, #FF8745);
            color: #fff;
            padding: 2rem 1.5rem;
            border-radius: 12px 12px 12px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .userProfile .profile-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .userProfile .profile-left img {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 3px solid #fff;
            object-fit: cover;
        }

        .userProfile .profile-left .profile-info h4 {
            font-weight: 600;
            margin: 0;
        }

        .userProfile .admin-badge {
            background-color: #fff;
            color: #FD670B;
            font-size: 0.8rem;
            font-weight: 500;
            border-radius: 20px;
            padding: 0.2rem 0.75rem;
            margin-left: 0.5rem;
            display: inline-block;
        }

        .userProfile .profile-left .info-list {
            font-size: 0.9rem;
            margin-top: 0.5rem;
        }

        .userProfile .info-list i {
            margin-right: 0.5rem;
        }

        /* Buttons on right (STACKED) */
        .userProfile .header-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .userProfile .header-buttons .btn-doc {
            border: 2px solid #fff;
            color: #fff;
            background: transparent;
            border-radius: 25px;
            padding: 0.35rem 0.9rem;
            font-size: 0.9rem;
            font-weight: 500;
            text-align: left;
            transition: all 0.3s ease;
        }

        .userProfile .header-buttons .btn-doc:hover {
            background: #fff;
            color: #FD670B;
        }

        .userProfile .profile-pic-wrapper {
            position: relative;
            width: 90px;
            height: 90px;
        }

        .userProfile .edit-pic-btn {
            position: absolute;
            bottom: 2px;
            right: 2px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: none;
            background: #fff;
            color: #FD670B;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
            transition: 0.2s ease;
        }

            .userProfile .edit-pic-btn:hover {
                background: #FD670B;
                color: #fff;
            }

/* ================= ONE TIME DOCUMENT ================= */

.userProfile-onetimedoc-card {
    border-radius: 14px;
    border:none;
    background: var(--card-bg);
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
}

.userProfile-onetimedoc-form .form-label {
    font-size: 0.85rem;
    color: #555;
    margin-bottom: 0.25rem;
}

.userProfile-onetimedoc-form .form-control,
.userProfile-onetimedoc-form .form-select {
    font-size: 0.85rem;
}

/* Upload section */
.userProfile-onetimedoc-uploads .upload-label {
    font-size: 0.8rem;
    color: #555;
    margin-bottom: 0.25rem;
    display: block;
}

.upload-box {
    position: relative;
    border: 1.5px dashed #cfcfcf;
    border-radius: 6px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: #fafafa;
    transition: 0.2s ease;
}

.upload-box:hover {
    border-color: var(--primary);
    background: #fff4ee;
}

.upload-box i {
    font-size: 1.4rem;
    color: #aaa;
}

.upload-box input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
}

/* Mobile */
@@media (max-width: 768px) {
    .upload-box {
        height: 70px;
    }
}
.upload-actions {
    display: flex;
    gap: 10px;
    justify-content: left;
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--primary);
}

.upload-actions i {
    cursor: pointer;
}



/*===========ENTITY DETAILS========*/
.userProfile-entity-card {
    border-radius: 14px;
    border:none;
    background: var(--card-bg);
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
}

.userProfile-entity-card .form-label {
    font-size: 0.85rem;
    color: #555;
    margin-bottom: 0.25rem;
}

.userProfile-entity-card .form-control,
.userProfile-entity-card .form-select {
    font-size: 0.85rem;
}

.userProfile-entity-header,
.userProfile-entity-subheader {
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
}

.userProfile-entity-subheader {
    border-top: 1px solid #e5e7eb;
    color: #2563eb;
}

.userProfile-entity-body {
    padding: 16px;
}

.userProfile-entity-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.userProfile-entity-card label {
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 4px;
}

.userProfile-entity-card .form-control {
    height: 36px;
    font-size: 13px;
}

.userProfile-entity-footer {
    padding: 12px 16px;
    border-top: 1px solid #e5e7eb;
    text-align: left;
}

/* Responsive */
@@media (max-width: 1200px) {
    .userProfile-entity-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@@media (max-width: 992px) {
    .userProfile-entity-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 576px) {
    .userProfile-entity-grid {
        grid-template-columns: 1fr;
    }
}




        /* -----modal styles (reused for edit profile & change password) ----- */

        .userProfile-changepass-card {
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.15);
            background: var(--card-bg);
            max-width: 640px;
        }

            .userProfile-changepass-card h5 {
                color: var(--primary);
                font-weight:400;
            }

            .userProfile-changepass-card .btn-close {
                filter: invert(0.5);
                opacity: 0.6;
                transition: opacity .2s ease;
            }

                .userProfile-changepass-card .btn-close:hover {
                    opacity: 1;
                }

            .userProfile-changepass-card .form-control:focus {
                border-color: #fd670b !important;
                box-shadow: 0 0 0 0.25rem rgba(253,103,11,0.25) !important;
            }

            .userProfile-changepass-card .btn-cancel,
            .userProfile-changepass-card .btn-update {
                background-color: var(--primary);
                color: #fff;
                border: none;
                padding: 4px 8px;
                border-radius: 999px;
            }

            .userProfile-changepass-card .btn-cancel:hover,
            .userProfile-changepass-card .btn-update:hover {
                background-color: var(--primary-dark);
                color: #fff;
            }

        .modal-backdrop.show {
            opacity: 0.3;
        }

        /* Responsive tweaks */
        @@media (max-width: 992px) {
            .userProfile .info-card {
                margin-bottom: 1rem;
            }

            .userProfile .header-buttons {
                flex-direction: row;
                gap: 0.5rem;
            }
        }

        /*========= PROFILE IMAGE MODAL ========= */

        .userProfile-profileimg-modal {
            background: #1f2328;
            color: #fff;
            border-radius: 14px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

            .userProfile-profileimg-modal .modal-header {
                padding: 1rem 1.25rem;
            }

            .userProfile-profileimg-modal .btn-close {
                filter: invert(1);
            }

        /* Circular preview */
        .profileimg-preview-wrapper {
            width: 220px;
            height: 220px;
            margin: auto;
            border-radius: 50%;
            overflow: hidden;
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .profileimg-preview-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover; /* handles any image size */
            }

        /* Action buttons */
        .profileimg-actions {
            margin-top: 1rem;
        }

        .profileimg-action-btn {
            background: transparent;
            border: none;
            color: #ddd;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 0.85rem;
            gap: 0.3rem;
            cursor: pointer;
            transition: 0.2s ease;
        }

            .profileimg-action-btn i {
                font-size: 1.4rem;
            }

            .profileimg-action-btn:hover {
                color: var(--primary);
            }

            .profileimg-action-btn.text-danger:hover {
                color: #ff5c5c;
            }

    /*Buttons*/
        .save-btn {
            background: var(--primary);
            color: #fff;
            border-radius: 999px;
            padding: 4px 8px;
            border: 0;
            font-size: 0.9rem;
        }
        .save-btn:hover{
            background:var(--primary-dark);
            color:#fff;
        }

        .profile-btn {
            background: transparent;
            color: #fff;
            border-radius: 999px;
            padding: 4px 8px;
            border: 1px solid #fff;
            font-size: 0.8rem;
        }
        .profile-btn:hover{
            background: #fff;
            color: black;
        }

    </style>
</head>

<body>
    <div class="userProfile">
        <!-- HEADER -->
        <div class="profile-header">
            <div class="profile-left">
                <div class="profile-pic-wrapper">
                    <img src="~/PayrollDashboard/assets/profile.png" alt="Profile" />
                    <button class="edit-pic-btn" title="Change Profile Picture">
                        <i class="bi bi-pencil-fill"></i>
                    </button>
                </div>
                <div class="profile-info">
                    <h4>
                        XYZ Corporation
                        <span class="admin-badge">Admin</span>
                    </h4>
                    <div class="info-list">
                        <div><i class="bi bi-envelope"></i> admin@acmecorp.com</div>
                        <div><i class="bi bi-telephone"></i> +91 (XXX) XXX-XXXX</div>
                        <div><i class="bi bi-building"></i> Party Name: XYZ Trading Pvt Ltd</div>
                        <div><i class="bi bi-person"></i> User Name: vansh.admin</div>
                    </div>
                </div>
            </div>

            <div class="header-buttons">
                <button class="btn-doc" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                    <i class="bi bi-key"></i> Change Password
                </button>

            </div>
        </div>
        <div class="p-4" ng-hide="loginType==7">
          
            <!-- ================= ONE TIME DOCUMENT CARD ================= -->
            <div class="card userProfile-onetimedoc-card my-4">
                <div class="card-body">

                    <h5 class="mb-3" style="color: var(--primary)">One Time Document</h5>

                    <!-- ========== DETAILS INPUTS ========== -->
                    <div class="row g-3 userProfile-onetimedoc-form">

                        <div class="col-md-3">
                            <label class="form-label">Company Name</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Email ID</label>
                            <input type="email" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Contact no.</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">CIN</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">PAN</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">TAN</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">GSTN</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">PIN Code</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Country</label>
                            <select class="form-select">
                                <option>Select Country</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">State</label>
                            <select class="form-select">
                                <option>Select State</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">City</label>
                            <select class="form-select">
                                <option>Select City</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">PF Registration Code/Subcode</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Labour Welfare Fund Registration</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Professional Tax Registration</label>
                            <input type="text" class="form-control">
                        </div>

                    </div>

                    <hr class="my-4">

                    <!-- ========== UPLOAD SECTION ========== -->
                    <small class="d-block mb-3" style="color: var(--primary)">
                        Upload Documents (Please Save Above Detail, Before Uploading Document)
                    </small>

                    <div class="row g-3 userProfile-onetimedoc-uploads">

                        <div class="col-md-3">
                            <label class="upload-label">1. COI</label>
                            <div class="upload-box">
                                <i class="bi bi-plus-lg"></i>
                                <input type="file">
                            </div>
                            <div class="upload-actions">
                                <i class="bi bi-eye" title="View"></i>
                                <i class="bi bi-download" title="Download"></i>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="upload-label">2. PAN</label>
                            <div class="upload-box">
                                <i class="bi bi-plus-lg"></i>
                                <input type="file">
                            </div>
                            <div class="upload-actions">
                                <i class="bi bi-eye" title="View"></i>
                                <i class="bi bi-download" title="Download"></i>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="upload-label">3. MOA AOA</label>
                            <div class="upload-box">
                                <i class="bi bi-plus-lg"></i>
                                <input type="file">
                            </div>
                            <div class="upload-actions">
                                <i class="bi bi-eye" title="View"></i>
                                <i class="bi bi-download" title="Download"></i>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="upload-label">4. GST Registration Certificate</label>
                            <div class="upload-box">
                                <i class="bi bi-plus-lg"></i>
                                <input type="file">
                            </div>
                            <div class="upload-actions">
                                <i class="bi bi-eye" title="View"></i>
                                <i class="bi bi-download" title="Download"></i>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="upload-label">5. MSME Registration Certificate</label>
                            <div class="upload-box">
                                <i class="bi bi-plus-lg"></i>
                                <input type="file">
                            </div>
                            <div class="upload-actions">
                                <i class="bi bi-eye" title="View"></i>
                                <i class="bi bi-download" title="Download"></i>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="upload-label">6. List of Directors</label>
                            <div class="upload-box">
                                <i class="bi bi-plus-lg"></i>
                                <input type="file">
                            </div>
                            <div class="upload-actions">
                                <i class="bi bi-eye" title="View"></i>
                                <i class="bi bi-download" title="Download"></i>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <label class="upload-label">7. Directors KYC</label>
                            <div class="upload-box">
                                <i class="bi bi-plus-lg"></i>
                                <input type="file">
                            </div>
                            <div class="upload-actions">
                                <i class="bi bi-eye" title="View"></i>
                                <i class="bi bi-download" title="Download"></i>
                            </div>
                        </div>

                    </div>


                    <!-- Save -->
                    <div class="text-end mt-4">
                        <button class="btn save-btn">Save</button>
                    </div>

                </div>
            </div>

            <!-- ENTITY DETAILS CARD -->
            <div class="card mt-4 userProfile-entity-card">
                <div class="card-body">

                    <!-- CARD TITLE -->
                    <h5 class="mb-3" style="color: var(--primary)">Entity Details</h5>

                    <!-- ROW 1 -->
                    <div class="row g-3">
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Type of Entity</label>
                            <select class="form-select">
                                <option selected>Private Limited Company</option>
                                <option>Public Limited Company</option>
                                <option>LLP</option>
                                <option>Partnership</option>
                            </select>
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Listed Status</label>
                            <select class="form-select">
                                <option selected>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Stock Exchange Name</label>
                            <select class="form-select">
                                <option selected>BSE (Bombay Stock Exchange Limited)</option>
                                <option>NSE</option>
                            </select>
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Funding Status</label>
                            <select class="form-select">
                                <option selected>No</option>
                                <option>Yes</option>
                            </select>
                        </div>
                    </div>

                    <!-- ROW 2 -->
                    <div class="row g-3 mt-1">
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Turnover</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Net Profit</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Borrowing</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Authorized Share Cap</label>
                            <input type="text" class="form-control">
                        </div>
                    </div>

                    <!-- ROW 3 -->
                    <div class="row g-3 mt-1">
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Issued Share Cap</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Paid up Cap</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Average Net Profit of Last 3 Years</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Holding / Subsidiary</label>
                            <select class="form-select">
                                <option selected>Select</option>
                                <option>Holding</option>
                                <option>Subsidiary</option>
                            </select>
                        </div>
                    </div>

                    <!-- ROW 4 -->
                    <div class="row g-3 mt-1">
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">NBFC Registered</label>
                            <select class="form-select">
                                <option selected>Select</option>
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">RBI Registered</label>
                            <select class="form-select">
                                <option selected>Select</option>
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Startup (DPIIT-registered)</label>
                            <select class="form-select">
                                <option selected>Select</option>
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">MSME Registered</label>
                            <select class="form-select">
                                <option selected>Select</option>
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Registered under GST</label>
                            <select class="form-select">
                                <option selected>Select</option>
                                <option>Yes</option>
                                <option>No</option>
                            </select>
                        </div>

                    </div>

                    <!-- SUB SECTION -->
                    <hr class="my-4">

                    <h6 class="mb-3" style="color: var(--primary)">Company Structure &amp; Identification</h6>

                    <div class="row g-3">
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">CIN (Corporate Identity No.)</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">PAN of Company</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">TAN of Company</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Date of Incorporation</label>
                            <input type="date" class="form-control">
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Registered Office State</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Business Activity (NIC Code)</label>
                            <input type="text" class="form-control">
                        </div>

                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="form-label">Financial Year End</label>
                            <input type="text" class="form-control" placeholder="e.g. 31 Mar">
                        </div>
                    </div>

                    <!-- ACTION -->
                    <div class="d-flex justify-content-end mt-4 gap-2">
                        <button class="btn save-btn">Save</button>
                    </div>

                </div>
            </div>



        </div>



        <!-- ========== PROFILE IMAGE MODAL ========== -->
        <div class="modal fade" id="profileImageModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content userProfile-profileimg-modal">

                    <div class="modal-header border-0">
                        <h5 class="modal-title">Profile photo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body text-center">

                        <!-- Image Preview -->
                        <div class="profileimg-preview-wrapper mb-4">
                            <img id="profilePreview"
                                 src="~/PayrollDashboard/assets/profile.png"
                                 alt="Profile Preview">
                        </div>

                        <!-- Actions -->
                        <div class="profileimg-actions d-flex justify-content-center gap-4">

                            <button class="profileimg-action-btn" id="cameraBtn">
                                <i class="bi bi-camera"></i>
                                <span>Camera</span>
                            </button>

                            <button class="profileimg-action-btn" id="uploadBtn">
                                <i class="bi bi-image"></i>
                                <span>Upload</span>
                            </button>

                            <button class="profileimg-action-btn text-danger" id="deleteBtn">
                                <i class="bi bi-trash"></i>
                                <span>Delete</span>
                            </button>

                        </div>

                        <input type="file" id="fileInput" accept="image/*" hidden />

                    </div>
                    <div class="d-flex justify-content-end m-4 gap-2">
                        <button class="btn profile-btn " data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button class="btn profile-btn " id="saveProfileImgBtn">
                            Save
                        </button>
                    </div>


                </div>
            </div>
        </div>


        <!-- ========== CHANGE PASSWORD MODAL ========== -->
        <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content userProfile-changepass-card p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class=" mb-1">Change Password</h5>
                            <small class="text-muted">Update your account password.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <form id="changePasswordForm">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label ">Current Password</label>
                                <input type="password" class="form-control" id="cur_password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label ">New Password</label>
                                <input type="password" class="form-control" id="new_password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Confirm Password</label>
                                <input type="password" class="form-control" id="confirm_password" />
                            </div>
                        </div>

                        <small class="text-muted d-block mt-2">Choose a strong password and keep it secure.</small>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-update">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const profileImg = document.querySelector('.profile-pic-wrapper img');
        const previewImg = document.getElementById('profilePreview');
        const pencilBtn = document.querySelector('.edit-pic-btn');

        const fileInput = document.getElementById('fileInput');
        const uploadBtn = document.getElementById('uploadBtn');
        const deleteBtn = document.getElementById('deleteBtn');
        const cameraBtn = document.getElementById('cameraBtn');
        const saveBtn = document.getElementById('saveProfileImgBtn');

        const defaultImg = profileImg.src;

        let tempImage = null; 

        /* Open modal */
        pencilBtn.addEventListener('click', () => {
            tempImage = profileImg.src;
            previewImg.src = tempImage;

            new bootstrap.Modal(document.getElementById('profileImageModal')).show();
        });

        /* Upload from file */
        uploadBtn.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', e => {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = () => {
                tempImage = reader.result;
                previewImg.src = tempImage;
            };
            reader.readAsDataURL(file);
        });

        /* Camera capture */
        cameraBtn.addEventListener('click', async () => {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                const video = document.createElement('video');
                video.srcObject = stream;
                video.play();

                setTimeout(() => {
                    const canvas = document.createElement('canvas');
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    canvas.getContext('2d').drawImage(video, 0, 0);

                    tempImage = canvas.toDataURL('image/png');
                    previewImg.src = tempImage;

                    stream.getTracks().forEach(t => t.stop());
                }, 800);

            } catch {
                alert('Camera access denied');
            }
        });

        /* Delete (preview only) */
        deleteBtn.addEventListener('click', () => {
            if (!confirm('Remove profile photo?')) return;

            tempImage = defaultImg;
            previewImg.src = defaultImg;
        });

        /* SAVE – apply changes */
        saveBtn.addEventListener('click', () => {
            if (!tempImage) return;

            profileImg.src = tempImage;
            bootstrap.Modal.getInstance(
                document.getElementById('profileImageModal')
            ).hide();
        });
    </script>


</body>
</html>

