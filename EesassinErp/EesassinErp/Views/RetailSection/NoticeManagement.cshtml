@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Notice Management";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<link href="~/Masters/NoticeManagement/style.css" rel="stylesheet" />
<script src="~/Masters/NoticeManagement/script.js"></script>

<div class="noticeManagementPage px-4 py-2"> 
    <!-- Top bar: instruction left + New Location button right -->
    <div class="d-flex align-items-center justify-content-between mb-3 top-bar"> 
        <h4 style="color:var(--primary)">Notice Management</h4>
        <div class="d-flex align-items-center gap-2">
            <!-- New Location (rounded pill) -->
            <button class="btn btn-sm btn-reportNotice" id="reportNoticeBtn" data-bs-toggle="modal" data-bs-target="#reportNoticeModal" type="button">
                <span>Report Notice</span>
            </button>
        </div>
    </div>

    <!-- ================= KPI Bar ================= -->
    <div class="container my-4">
        <div class="row g-3">

            <!-- Total Compliance -->
            <div class="col-md-3">
                <div class="notice-kpi-card d-flex">
                    <div class="notice-kpi-title">Total Notice</div>
                    <div class="notice-kpi-value" id="kpiTotalCompliance">230</div>
                </div>
            </div>

            <!-- Pending -->
            <div class="col-md-3">
                <div class="notice-kpi-card d-flex">
                    <div class="notice-kpi-title">Pending</div>
                    <div class="notice-kpi-value" id="kpiPending">86</div>
                </div>
            </div>

            <!-- Complied -->
            <div class="col-md-3">
                <div class="notice-kpi-card d-flex">
                    <div class="notice-kpi-title">Submission</div>
                    <div class="notice-kpi-value" id="kpiComplied">68</div>
                </div>
            </div>

            <!-- Delayed -->
            <div class="col-md-3">
                <div class="notice-kpi-card d-flex">
                    <div class="notice-kpi-title">Closure</div>
                    <div class="notice-kpi-value" id="kpiDelayed">25</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Report Notice MODAL (scoped) -->
    <div class="modal fade reportNotice-modal" id="reportNoticeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content reportNotice-card">
                <div class="modal-header reportNotice-topbar">
                    <div>
                        <h5 class="mb-0">Report Notice</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-3 reportNotice-body">
                    <div class="container-fluid">
                        <div class="reportNotice-form">

                            <div class="row g-3">

                                <!-- Row 1 -->
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Store Code</label>
                                    <select class="form-select form-select-sm">
                                        <option>Select</option>
                                    </select>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Department</label>
                                    <select class="form-select form-select-sm">
                                        <option>Select</option>
                                    </select>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Document Stage</label>
                                    <input type="text" class="form-control form-control-sm" value="First Stage" disabled />
                                </div>

                                <!-- Row 2 -->
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Upload Notice</label>
                                    <input type="file" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Date Of Notice</label>
                                    <input type="date" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Mode Of Notice</label>
                                    <select class="form-select form-select-sm">
                                        <option>Select</option>
                                    </select>
                                </div>

                                <!-- Row 3 -->
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Date Of Hearing</label>
                                    <input type="date" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Officer Name</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Department Address</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <!-- Row 4 -->
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Representative Name</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Representative Email</label>
                                    <input type="email" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Description</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <!-- Row 5 -->
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Probability</label>
                                    <select class="form-select form-select-sm">
                                        <option>Select</option>
                                    </select>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Interest</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Late Fee</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <!-- Row 6 -->
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Fines</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Penalties</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label">Other</label>
                                    <input type="text" class="form-control form-control-sm" />
                                </div>

                            </div>


                        </div>

                        <!-- Draft Notice Section -->
                        <div class="notice-draft-wrapper mt-4">

                            <div class="notice-draft-header d-flex justify-content-between align-items-center">
                                <h6 class="mb-0">Draft Notice (Internal Review)</h6>

                                <div class="draft-actions d-flex gap-2">

                                    <button type="button"
                                            class="btn btn-sm download-draft-btn">
                                        <i class="bi bi-download"></i> Download
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm trail-btn">
                                        <i class="bi bi-clock-history"></i> Check Trail
                                    </button>


                                    <button type="button"
                                            class="btn btn-sm edit-draft-btn">
                                        <i class="bi bi-pencil"></i> Edit Draft
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm save-draft-btn d-none">
                                        Save
                                    </button>

                                    <button type="button"
                                            class="btn btn-sm cancel-draft-btn d-none">
                                        Cancel
                                    </button>

                                </div>


                            </div>


                            <div class="notice-draft-body" contenteditable="false">

                                <div class="draft-block">
                                    <strong>Issuing Authority</strong><br />
                                    Provident Fund Department<br />
                                    Regional Office, New Delhi
                                </div>

                                <div class="draft-block">
                                    <strong>To</strong><br />
                                    XYZ Corporation<br />
                                    Location Code: DEMO37
                                </div>

                                <div class="draft-block">
                                    <strong>Subject:</strong><br />
                                    Notice regarding non-compliance under applicable statutory provisions.
                                </div>

                                <div class="draft-block draft-paragraph">
                                    This is to inform you that a notice has been issued by the Provident Fund
                                    Department in relation to the establishment mentioned above. Upon
                                    preliminary review of records, certain discrepancies have been observed
                                    which require clarification and necessary action.
                                </div>

                                <div class="draft-block draft-paragraph">
                                    You are hereby required to review the details mentioned herein and ensure
                                    that appropriate responses and documentation are prepared within the
                                    stipulated timelines as may be applicable.
                                </div>

                                <div class="draft-block">
                                    <strong>Important Dates</strong><br />
                                    Notice Date: 11/12/2025<br />
                                    Hearing / Reply Date: 20/12/2025
                                </div>

                                <div class="draft-block">
                                    <strong>Financial Implications</strong><br />
                                    Interest: ₹10,000<br />
                                    Late Fee: ₹2,000<br />
                                    Penalties: ₹5,000<br />
                                    <strong>Total Exposure: ₹17,000</strong>
                                </div>

                                <div class="draft-block">
                                    <strong>Attachment</strong><br />
                                    Uploaded Notice: notice_document.pdf
                                </div>

                                <div class="draft-warning">
                                    Please review this draft carefully before submitting. This is a system-generated
                                    draft intended for internal review and audit purposes only.
                                </div>

                            </div>
                        </div>


                        <!-- Draft Change Trail Modal -->
                        <div class="modal fade draftTrail-modal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-md modal-dialog-centered">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <h6 class="mb-0">Draft Change Trail</h6>
                                        <button type="button" class="btn-close"
                                                data-bs-dismiss="modal"></button>
                                    </div>

                                    <div class="modal-body">
                                        <div class="draft-trail-list">

                                            <!-- dynamically injected -->

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>



                    </div>
                </div>

                <div class="modal-footer justify-content-end">
                    <button type="button" class="btn btn-sm submit-btn">
                        Submit
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card section-card">
        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Submition
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Pending</a></li>
                            <!-- ... -->
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Closer Status
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Pending</a></li>
                            <li><a class="dropdown-item" href="#">xyz</a></li>
                        </ul>
                    </div>

                    <button class="btn btn-sm filter-btn active">Go</button>
                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="estSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" style="border-color: #E45D27" id="estSearchBtn" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>
                                <li><a class="dropdown-item" href="#">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table" id="noticeTable">
                        <thead>
                            <tr>
                                <th>Sr.No</th>
                                <th>Location Code</th>
                                <th>Department</th>
                                <th>Notice Date</th>
                                <th>Submission Status</th>
                                <th>Submission Date</th>
                                <th>Closure Status</th>
                                <th>Closure Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="noticeTableBody">
                            <tr>
                                <td>1</td>
                                <td>Demo37</td>
                                <td>Provident Fund Department</td>
                                <td>11/12/2025</td>
                                <td>Pending</td>
                                <td>11/12/2025</td>
                                <td>Pending</td>
                                <td>11/12/2025</td>
                                <td>
                                    <div class="ex-progress">
                                        <span class="bar bar-green" style="width:95%"></span>
                                    </div>
                                    <span class="ex-percent">95%</span>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>Demo19</td>
                                <td>
                                    <div class="td-inline-actions">
                                        <span class="td-text">Municipal Corporation Department</span>
                                        <span class="td-actions">
                                            <i class="bi bi-eye" title="View"></i>
                                            <i class="bi bi-download" title="Download"></i>
                                        </span>
                                    </div>
                                </td>

                                <td>11/12/2025</td>
                                <td>
                                    <div class="td-inline-actions">
                                        <span class="td-text">Submitted</span>
                                        <span class="td-actions">
                                            <i class="bi bi-eye" title="View"></i>
                                            <i class="bi bi-download" title="Download"></i>
                                        </span>
                                    </div>
                                </td>

                                <td>11/12/2025</td>
                                <td>
                                    <div class="td-inline-actions">
                                        <span class="td-text">Submitted</span>
                                        <span class="td-actions">
                                            <i class="bi bi-eye" title="View"></i>
                                            <i class="bi bi-download" title="Download"></i>
                                        </span>
                                    </div>
                                </td>

                                <td>11/12/2025</td>
                                <td>
                                    <div class="ex-progress">
                                        <span class="bar bar-green" style="width:95%"></span>
                                    </div>
                                    <span class="ex-percent">95%</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="noticePaginationWrap">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm" id="noticePrev" type="button">Previous</button>
                        <button class="btn btn-sm" id="noticeNext" type="button">Next</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="noticePageInfo" style="font-size:0.85rem;color:#555;"></div>
                        <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>