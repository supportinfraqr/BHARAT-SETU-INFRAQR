<style>
    .column-popup {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .popup-content {
        width: 320px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        overflow: hidden;
    }

    /* Header */

    .popup-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 15px;
        border-bottom: 1px solid #eee;
        background: #f8f9fa;
    }

        .popup-header h6 {
            margin: 0;
            font-weight: 600;
        }

    .close-btn {
        border: none;
        background: none;
        font-size: 16px;
        cursor: pointer;
    }

    /* Body */

    .popup-body {
        max-height: 150px;
        overflow-y: auto;
        padding: 10px 15px;
    }

    .column-item {
        padding: 6px 0;
    }

        .column-item label {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* Footer */

    .popup-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 10px 15px;
        border-top: 1px solid #eee;
    }
</style>
<script>
    function exportToPDF() {
        const { jsPDF } = window.jspdf;
        const element = document.getElementById('exportdiv');

        html2canvas(element, {
            scale: 3,
            useCORS: true,
            allowTaint: true,
            scrollX: 0,
            scrollY: -window.scrollY,
            windowWidth: element.scrollWidth,
            backgroundColor: '#ffffff'
        }).then(canvas => {

            const imgData = canvas.toDataURL('image/jpeg', 1.0);

            const pdf = new jsPDF('p', 'mm', 'a4');

            const pageWidth = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();

            const marginLeft = 10;
            const marginBottom = 10;
            let marginTop = 35;

            var companyName = angular.element(document.body).scope().MapUser || '';
            var generatedOn = new Date().toLocaleDateString('en-GB');

            pdf.setFont('helvetica', 'bold');
            pdf.setFontSize(18);
            pdf.text(companyName, pageWidth / 2, 12, { align: 'center' });

            pdf.setFontSize(14);
            pdf.text('Location Dashboard Report', pageWidth / 2, 20, { align: 'center' });

            pdf.setFont('helvetica', 'normal');
            pdf.setFontSize(9);
            pdf.text('Generated on : ' + generatedOn, pageWidth / 2, 26, { align: 'center' });

            const availableWidth = pageWidth - marginLeft * 2;
            const availableHeight = pageHeight - marginTop - marginBottom;

            const imgWidth = availableWidth;
            const imgHeight = (canvas.height * imgWidth) / canvas.width;

            let heightLeft = imgHeight;
            let position = marginTop;

            pdf.addImage(imgData, 'JPEG', marginLeft, position, imgWidth, imgHeight);
            heightLeft -= availableHeight;

            while (heightLeft > 0) {
                pdf.addPage();
                position = marginTop - (imgHeight - heightLeft);
                pdf.addImage(imgData, 'JPEG', marginLeft, position, imgWidth, imgHeight);
                heightLeft -= availableHeight;
            }

            pdf.save('LocationDashboard_A4_Clear.pdf');

        }).catch(error => {
            console.error('Error exporting to PDF:', error);
        });
    }
</script>



