<script>
    function exportToPDF() {
        const { jsPDF } = window.jspdf;

        // Select the div to export
        const element = document.getElementById('exportdiv');

        // Use html2canvas to render the div into a canvas
        html2canvas(element, {
            scale: 3,                  // Higher scale for better resolution
            useCORS: true,             // Ensure cross-origin resources are loaded
            scrollX: 0,                // Prevent scrolling artifacts
            scrollY: 0
        }).then(canvas => {
            const imgData = canvas.toDataURL('image/png');

            // Adjust PDF size dynamically based on the canvas dimensions
            const pdfWidth = canvas.width / 2;  // Divide by scale to maintain original size
            const pdfHeight = canvas.height / 2;

            // Create a new jsPDF instance
            const pdf = new jsPDF({
                orientation: 'landscape',
                unit: 'px',
                format: [pdfWidth, pdfHeight]
            });

            // Add image to PDF, applying margins (e.g., 10px)
            const margin = 10;
            pdf.addImage(imgData, 'PNG', margin, margin, pdfWidth - 2 * margin, pdfHeight - 2 * margin);

            // Save the PDF
            pdf.save('LicenceStatusDashboard.pdf');
        }).catch(error => {
            console.error('Error exporting to PDF:', error);
        });
    }



</script>
