<div  class="pagecontentbody">
    <div>
        <a onclick="exportToPDF();angular.element(document).scope().ManageLog('Download Pdf Licence Status Dashboard')" title="download Report" data-toggle="modal" data-target="#editAct" class="btn btn-warning btn-xs banner_btn1 btn-custom-download download-doc-link">Download <i class="fa fa-cloud-download hidden-xs hidden-sm hidden-md"></i></a>
    </div>
    <div id="exportdiv">
        <div style="text-align: center;font-size: large;" class="col-md-12 rbox bo curved-div"><strong class="pagehed ng-binding">Licence Status Dashboard</strong></div>

        <div id="downloaddiv2" class="pagebody" style="padding:5px">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-3 px-1" ng-init="FilterGraph()">
                        <div class="rbox box curved-div" id="style-7">
                            <div style="margin-left: 3px;" class="bhed" ng-init="GetRegion()"><b>Region</b></div>
                            <div class="row m-0 bscroll" style="max-height: 45px">
                                <div class="col-3 mnh px-1 " ng-repeat="x in RegionList"><span class="badge bg-danger cldiv" ng-click="SetRegion(x.RegionId)">{{x.Name}}</span></div>

                            </div>

                        </div>

                        <div class="grbox box curved-div margin3" ng-init="GetDocumentStatus()">
                            <div class="bhed"><b>Status</b></div>
                            <div class="row m-0 bscroll" style="max-height: 65px">
