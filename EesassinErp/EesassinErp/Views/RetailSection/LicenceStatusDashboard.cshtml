                                <div class="col-6 mnh px-1"><span class="badge bg-lsuccess1 LicenceStatus" ng-click="SetLicenceStatus('Issued')">Issued</span></div>
                            </div>
                        </div>
                        <div class="grbox box curved-div margin3">
                            <div class="bhed"><b>Expiry status</b></div>
                            <div class="row m-0 bscroll" style="max-height: 85px">
                                <div class="col-6 mnh px-1"><span class="badge bg-warning Expirystatus" ng-click="SetExpiryStatus('Expiring Soon')">Expiring Soon</span></div>
                                <div class="col-6 mnh px-1"><span class="badge bg-warning Expirystatus" ng-click="SetExpiryStatus('Expired')">Expired</span></div>
                            </div>
                        </div>
                        <div class="grbox box curved-div margin3" ng-init="BindLicenceType()">
                            <div class="bhed"><b>Fresh/Renewal</b></div>
                            <div class="row m-0 bscroll" style="max-height: 25px">
                                <div class="col-4 mnh px-1" ng-repeat="x in LicenseTypeList"><span class="badge bg-lsuccess1 Fresh" ng-click="SetLicenceType(x.LStatus)">{{x.LicenseType}}</span></div>
                            </div>
                        </div>
                        <div ng-if="LSD_Flag==1" class="grbox box curved-div margin3" ng-init="BindClientList()">
                            <div class="bhed"><b>Client Name</b></div>
                            <div class="row m-0 bscroll" style="max-height: 45px">
                                <div class="col-6 mnh px-1" ng-repeat="x in ClientList"><span class="badge bg-warning Client" ng-click="SetClient(x.MapId)">{{x.PartyName}}</span></div>

                            </div>
                        </div>
                        <div ng-if="LSD_Flag==1" class="grbox box curved-div margin3">
                            <div class="bhed"><b>Invoice Status</b></div>
                            <div class="row m-0 bscroll" style="max-height: 45px" ng-init="BindInvoiceStatus()">
                                <div class="col-12 mnh px-1" ng-repeat="x in InvoiceStatusList"><span class="badge bg-lsuccess1 InvoiceStatus" ng-click="SetInvoiceStatus(x.invoiceStatus)">{{x.invoiceStatus}}</span></div>

                            </div>
                        </div>
                        <div ng-if="LSD_Flag==1" class="grbox box curved-div margin3" ng-init="GetPaymentStatus()">
                            <div class="bhed"><b>Payment Status</b></div>
                            <div class="row m-0 bscroll" style="max-height: 45px">
                                <div class="col-12 mnh px-1" ng-repeat="x in PaymentList"><span class="badge bg-lsuccess PaymentStatus" ng-click="SetPaymentStatus(x.Payment)">{{x.PaymentStatus}}</span></div>

                            </div>
                        </div>

                        <div class="grbox box curved-div margin3" ng-init="BindStore()">
                            <div class="bhed"><b>Outlet Name</b></div>
                            <div class="row m-0 bscroll" style="max-height: 170px">
                                <div class="col-6 mnh px-1" ng-repeat="x in StoreLList"><span class="badge bg-organf Outlet" ng-click="SetStore(x.Id)">{{x.StoreName}}</span></div>

                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 px-1">
                        <div class="dbox curved-div">
                            <div id="main" style="width: 100%; height: 400px;"></div>
                        </div>
                        <div class="grbox box curved-div" ng-init="BindState()">
                            <div class="bhed"><b>State</b></div>
                            <div class="row m-0 bscroll" style="max-height: 100%">
                                <div class="col-4 mnh px-1" ng-repeat="x in StateList"><span class="badge bg-organf State" ng-click="SetState(x.STATE_ID)">{{x.STATE_NAME}}</span></div>

                            </div>
                        </div>

                        <div ng-init="BindLicence()">
                            <div class="grbox box curved-div margin3">
                                <div class="bhed"><b>Type of Licence</b></div>
                                <div class="row m-0 bscroll" style="max-height: 100%">
                                    <div class="col-3 mnh px-1" ng-repeat="x in LicenceList"><span class="badge bg-warning TLicence" ng-click="SetLicense(x.LicenseId)">{{x.LicenseName}}</span></div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 px-1">
                        <div class="grbox box curved-div" ng-init="BindAddress()">
                            <div class="bhed"><b>Address of the store</b></div>
                            <div class="row m-0 bscroll" style="max-height: 500px">
                                <div class="col-12 mnh px-1" ng-repeat="x in AddressList"><span class="badge bg-warning Address" ng-click="SetAddress(x.CompleteAddress)">{{x.CompleteAddress}}</span></div>
                            </div>
                        </div>
                        <div class="grbox box curved-div margin3">
                            <div class="bhed"><b>Filter</b></div>
                            <div class="row m-0 bscroll" style="max-height: 85px">
                                <div ng-if="dvRegion==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Region</span></div>
                                <div ng-if="dvStatus==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Status</span></div>
                                <div ng-if="dvLicenceStatus==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Licence Status</span></div>
                                <div ng-if="dvExpiryStatus==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Expiry Status</span></div>
                                <div ng-if="dvFreshRenewal==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Fresh/Renewal</span></div>
                                <div ng-if="dvClient==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Client Name</span></div>
                                <div ng-if="dvInvoice==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Invoice Status</span></div>
                                <div ng-if="dvPayment==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Payment Status</span></div>
                                <div ng-if="dvOutlet==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Outlet Name</span></div>
                                <div ng-if="dvLicenceType==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Type of Licence</span></div>
                                <div ng-if="dvState==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">State</span></div>
                                <div ng-if="dvAddress==1" class="col-6 mnh px-1"><span class="badge bg-light text-dark">Address</span></div>

                            </div>
                        </div>
                        <div class="col-8 mnh px-1 margin3">
                            <span class="badge1 bg-organf" ng-click="Reset();ManageLog('Click on Reset in Licence Dashboard')">Reset </span>
                            <a href="../RetailSection/LicenceStatusDashboardReport"><span class="badge1 bg-organf " ng-click="ManageLog('Click on Export Report in Licence Dashboard')">Export Report</span> </a>
                        </div>


                    </div>

                </div>

            </div>
        </div>
    </div>
