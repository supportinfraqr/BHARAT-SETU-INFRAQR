        <div id="generateCard" class="card section-card d-none">
            <div class="card-body p-3">
                <h6>Import Master File</h6>
                <a href="/DownloadMat/EmployeeMasterSampleSheet.xlsx"
                   download
                   class="btn import-save-btn mb-3 d-inline-flex align-items-center">
                    <i class="bi bi-download me-1"></i>
                    Download Master Template
                </a>
                <div class="est-import-box p-3">
                    <label class="form-label mb-2">Choose Master File</label>
                    <input type="file" id="input-excel" class="form-control" onchange="angular.element(this).scope().DisplayExcel()" />
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn import-save-btn px-4" id="btnValiadte" ng-click="SaveRecord();ManageLog('click on Save Record button Employee Master Import')">
                            Save
                        </button>
                        <button class="btn cancel-btn px-4" id="importCancelBtn" ng-click="CancelImport()">
                            Cancel
                        </button>
                    </div>
                    <div id="wrapper" class="mt-3"></div>
                </div>
            </div>
        </div>

    </div>
</div>