    <!-- ================= Employee ID Card ================= -->
    <!--  PRINT AREA (HIDDEN) -->
    <div id="printArea" class="d-none-print">

        <div style="font-family:'Segoe UI',sans-serif;">

            <!-- FRONT -->
            <div class="printCard" style="width: 85.6mm; height: 53.98mm; background: #f4f4f4; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; position: relative; break-after: page; page-break-after: always;">

                <!-- HEADER -->
                @*<div style="height:140px;background:{{AssignColor}};position:relative;">
                    <div class="logoBox" style="margin-top: 43px; text-align: right; color: #fff; padding-right: 30px; font-size: xx-large;">
                        {{ClientName}}
                    </div>

                </div>*@

                <div style="height: 52px; background: {{AssignColor}}; position: relative;">
                    <div class="logoBox"
                         ng-style="{'color': AssignColor.toLowerCase() == 'yellow' ? '#000' : '#fff'}"
                         style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; color: #fff; height: 100%; font-size: 13px; font-weight: 600; text-align:center; ">
                        {{ClientName}}
                    </div>
                </div>

                <!-- PROFILE -->
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 10px; gap: 8px;">

                    <div style="width: 58px; height: 58px; border-radius: 50%; overflow: hidden; border: 1px solid #fff; z-index: 999" ng-if="EmployeePhotos">
                        <img ng-src="{{EmployeePhotos ? EmployeePhotos : '../DownloadMat/dummy.jpg'}}"
                             style="width:100%;height:100%;object-fit:cover;">
                    </div>
                    <div style="width: 58px; height: 58px; border-radius: 50%; overflow: hidden; border: 1px solid #fff; z-index: 999; font-size: 2.5rem; background: #dcdcdc; " ng-if="!EmployeePhotos">
                        <i class="bi bi-person-fill" style=" margin-left: 8px;"></i>
                    </div>

                    <div style="padding-left:10px;min-width:0; text-align:left;">
                        <h2 style="font-size: 13px; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #00224F;">
                            {{EmpName}}
                        </h2>
                        <p style="font-size: 9px; line-height: 1.2; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color:#000; ">
                            {{EmpDesignation}}
                        </p>
                        <p style="font-size: 9px; line-height: 1.2; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #000;">
                            {{VendorName}}
                        </p>
                    </div>

                    <div style="margin-left:auto;">
                        <img ng-src="{{getQrUrl()}}" style="width:44px;">
                    </div>

                </div>

                <!-- INFO -->
                <div style="display:flex;padding:0px 8px;  @*flex:1;*@">

                    <div style="width: 50%; text-align: center;">
                        <div>
                            <label style="font-size: 7px; letter-spacing: 0.2px; color: #00224F;">Employee Code</label>
                            <h4 style="font-size:9px;margin:4px 0 6px;">{{EmpCode}}</h4>
                        </div>

                        <div>
                            <label style="font-size: 7px; letter-spacing: 0.2px; color: #00224F;">Mobile Number</label>
                            <h4 style="font-size:9px;margin:4px 0;">{{EmpMobile}}</h4>
                        </div>
                    </div>

                    <div style="width:2px;background:#1d3557;margin:0 10px;"></div>

                    <div style="width: 50%; text-align: center;">
                        <div>
                            <label style="font-size: 7px; letter-spacing: 0.2px; color: #00224F;">Department</label>
                            <h4 style="font-size:9px;margin:4px 0 6px;">{{EmpDep}}</h4>
                        </div>

                        <div>
                            <label style="font-size: 7px; letter-spacing: 0.2px; color: #00224F;">Location(Site)</label>
                            <h4 style="font-size:9px;margin:4px 0;">{{Location}}<br />({{SiteName}})</h4>
                        </div>
                    </div>

                </div>
            </div>

            <div style="page-break-before:always;"></div>

            <!-- BACK -->
            <div class="printCard" style="width: 85.6mm; height: 53.98mm; background: #f4f4f4; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; ">

                <!-- TOP CONTENT -->
                <div style="padding:4px 8px;flex:1;display:flex;flex-direction:column;gap:6px;">

                    <!-- GRID 2x3 -->
                    <div style="display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);gap:4px; ">

                        <!-- 1 -->
                        <div style="text-align:center;">
                            <label style="font-size: 7px; color: #00224F;">Blood Group</label>
                            <h4 style="font-size: 9px; line-height: 1.2; margin: 6px 0;">
                                {{BloodGroup}}
                            </h4>
                        </div>

                        <!-- 2 -->
                        <div style="text-align:center;">
                            <label style="font-size: 7px; color: #00224F;">Emergency No.</label>
                            <h4 style="font-size: 9px; line-height: 1.2; margin: 6px 0;">
                                {{EmpMobile}}
                            </h4>
                        </div>

                        <!-- 3 -->
                        <div style="text-align:center;">
                            <label style="font-size: 7px; color: #00224F;">Route/Bus No.</label>
                            <h4 style="font-size: 9px; line-height: 1.2; margin: 6px 0;">
                                {{RouteName}}<br />{{BusNo}}
                            </h4>
                        </div>

                        <!-- 4 -->
                        <div style="text-align:center;">
                            <label style="font-size: 7px; color: #00224F;">Camp No.</label>
                            <h4 style="font-size:8px;margin:6px 0;line-height:1.3;white-space:normal;">
                                {{CampNumber}}
                            </h4>
                        </div>

                        <!-- 5 -->
                        <div style="text-align:center;">
                            <label style="font-size: 7px; color: #00224F;">UAN No.</label>
                            <h4 style="font-size: 9px; line-height: 1.2; margin: 6px 0;">
                                {{PreviousUAN}}
                            </h4>
                        </div>

                        <!-- 6 -->
                        <div style="text-align:center;">
                            <label style="font-size: 7px; color: #00224F;">ESIC No.</label>
                            <h4 style="font-size: 9px; line-height: 1.2; margin: 6px 0;">
                                {{PreviousESI}}
                            </h4>
                        </div>

                    </div>

                </div>

                <!-- BOTTOM SECTION -->
                <div style="padding: 0px 8px 8px; margin-bottom: 4px;">

                    <!-- NOTES -->
                    <div style="background: #e6e6e6; border-radius: 6px; padding: 4px 5px; font-size: 6px; line-height: 1.25; ">
                        <ul style="margin:0;padding-left:12px;">
                            <li>This identity card must always be carried & displayed for security & identification.</li>
                            <li>Loss or theft of this card should be reported to {{ClientEmailId}} and {{ClientMobileNo}}.</li>
                            <li>This card is not transferable & must be returned immediately on cessation of employment.</li>
                        </ul>
                    </div>

                    <!-- FOOTER -->
                    <div style="display:flex;justify-content:space-between;margin-bottom:7px;">
                        <div>
                            <span style="font-size: 7px; color: #00224F;">Issue Date :</span>
                            <span style="font-size:7px;">{{IssueDate | date:'dd/MM/yyyy'}}</span>
                        </div>

                        <div style="text-align:right;">
                            <span style="font-size: 7px; color: #00224F;">Valid Upto :</span>
                            <span style="font-size:7px;">{{ValidTill | date:'dd/MM/yyyy'}}</span>
                        </div>
                    </div>

                </div>

            </div>


        </div>

    </div>


