@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Worker Profile";
 Layout = "~/Views/Common/WorkerLayout.cshtml";
}

<script src="~/Content/Dashboards/WorkerProfile/script.js"></script>
<link href="~/Content/Dashboards/WorkerProfile/style.css" rel="stylesheet" />
<link href="~/Content/Masters/NewEmployeeMaster/style.css" rel="stylesheet" />
@*
<script src="~/scripts/RetailJsLib/WorkerRegistrationController.js"></script>*@
<script src="~/scripts/RetailJsLib/NewEmployeeController.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<style>
    p {
        margin-top: 0;
        margin-bottom: 0rem !important;
    }

    .d-none-print {
        display: none;
    }

    .d-none-print {
        display: none;
    }

    .cropper-view-box,
    .cropper-face {
        border-radius: 50%;
    }
</style>
<style>
    /* ================= CONTAINER ================= */
    .idCardContainer {
        display: flex;
        gap: 20px;
        justify-content: center;
    }

    /* ================= CARD BASE ================= */
    .idCard {
        background: #f4f4f4;
        border-radius: 14px;
        overflow: hidden;
        position: relative;
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        flex-direction: column;
    }

    /* ================= UI CARD (MODAL) ================= */
    .employeeViewModalPage .idCard {
        width: 420px;
        height: 260px;
    }

    /* ================= HEADER ================= */
    .idHeader {
        height: 60px;
        background: #8f8f8f;
        /*border-bottom-left-radius: 25px;
        border-bottom-right-radius: 25px;*/
        position: relative;
    }

    .logoBox {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        color: #fff;
    }

        .logoBox span {
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .logoBox img {
            width: 18px;
        }

    /* ================= PROFILE ================= */
    .profileSection {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 15px;
        gap: 10px;
    }

    .profileImage {
        width: 65px;
        height: 65px;
        min-width: 60px;
        border-radius: 50%;
        overflow: hidden;
        /* margin-top: -40px; */
        border: 1px solid #fff;
        z-index: 10;
    }

        .profileImage img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .profileDetails {
        /*flex: 1;*/
        text-align: left;
        /* min-width: 0; */
        padding-left: 1rem;
    }

        .profileDetails h2 {
            font-size: 16px;
            color: #00224F;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profileDetails p {
            font-size: 12px;
            margin: 0;
            color: #000;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    /* ================= QR ================= */
    .qrCode {
        margin-left: auto;
    }

        .qrCode img {
            width: 55px;
        }

    /* ================= INFO ================= */
    .infoSection {
        display: flex;
        padding: 8px 10px;
        flex: 1;
    }

        .infoSection .left,
        .infoSection .right {
            width: 50%;
            min-width: 0;
        }

    .divider {
        width: 2px;
        background: #1d3557;
        margin: 0 5px;
    }

    .infoSection .field label {
        font-size: 10px;
        color: #00224F;
    }

    .field h4 {
        font-size: 13px;
        margin: 2px 0 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #000;
    }


    /* ================= BACK ================= */
    .backContent {
        padding: 10px;
        height: 100%;
        display: grid;
        grid-template-columns: repeat(3, 1fr); /* 3 columns */
        grid-template-rows: repeat(2, auto); /* 2 rows */
        gap: 8px;
    }

        /* REMOVE old row behavior */
        .backContent .row1 {
            display: contents; /* makes children behave like direct grid items */
        }

        /* EACH FIELD */
        .backContent .field {
            min-width: 0;
        }

            /* TEXT CONTROL */
            .backContent .field label {
                font-size: 10px;
                color: #00224F;
            }

        .backContent h4 {
            font-size: 11px;
            margin: 2px 0 6px;
            line-height: 1.2;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #000;
        }


    /* ================= NOTES ================= */
    .notesBox {
        background: #e6e6e6;
        border-radius: 8px;
        padding: 6px;
        font-size: 9px;
        text-align: left;
    }

        .notesBox ul {
            margin: 0;
            padding-left: 12px;
        }

    /* ================= FLIP ================= */
    .flip-card {
        width: 420px;
        height: 260px;
        perspective: 1000px;
        margin: auto;
        cursor: pointer;
    }

    .card-inner {
        width: 100%;
        height: 100%;
        position: relative;
        transition: transform 0.6s;
        transform-style: preserve-3d;
    }

    .flip-card.flip .card-inner {
        transform: rotateY(180deg);
    }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
    }

        .card-face.back {
            transform: rotateY(180deg);
        }


    /*FOOTER*/
    .footerRow {
        display: flex;
        justify-content: space-between;
        font-weight: 400;
    }

        .footerRow .label {
            color: #00224F;
            font-size: 10px;
        }

        .footerRow span {
            font-size: 10px;
        }

    .rightAlign {
        text-align: right;
    }
</style>


<div class="workerProfile px-4 py-4" ng-init="onload()">
    <!-- EDIT Worker PROFILE MODAL -->
    <div class="modal fade workerProfileModal"
         id="editWorkerProfileModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-fullscreen workerProfileFullscreenModal">

            <div class="modal-content workerProfileModalContent">

                <!-- HEADER -->
                <div class="modal-header workerProfileModalHeader">
                    <div class="workerProfileModalTitleWrapper">
                        <div class="workerProfileModalIcon">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <div>
                            <div class="workerProfileModalTitle">
                                Edit Worker Profile
                            </div>
                            <div class="workerProfileModalSubTitle">
                                Update worker information and it's details
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white workerProfileModalClose"
                            data-bs-dismiss="modal"
                            aria-label="Close" ng-click="onload()"></button>

                </div>

                <!-- BODY -->
                <div class="modal-body workerProfileModalBody">

                    <!-- STEPPER -->
                    <div class="stepper-modern my-3">
                        <div class="step-item active">Worker Details</div>
                        <div class="step-item">Nominee Details</div>
                        <div class="step-item">Current Employment</div>
                        <div class="step-item">HSC</div>
                        <div class="step-item">Job History</div>
                        <div class="step-item">Documents</div>
                        <div class="step-item" hidden>Wage & Compliance Configuration</div>

                    </div>

                    <!-- STEP 1 -->
                    <div class="form-step" data-step="1">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Worker Details</h5>

                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">Worker Code</label>
                                    <input type="text" class="form-control" ng-model="EmployeeCode" ng-disabled="true">
                                </div>
                                <div>
                                    <label class="form-label">Worker Name</label>
                                    <input class="form-control employeeManual-input validate"
                                           id="txtEmployeeName"
                                           ng-model="EmployeeName">
                                </div>
                                <div>
                                    <label class="form-label">Gender  <span>*</span></label>
                                    <select class="form-select employeeManual-input validate"
                                            ng-model="Gender">

                                        <option value="">Select</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>

                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">
                                        Date of Birth<span>*</span>
                                    </label>

                                    <input type="date"
                                           class="form-control employeeManual-input validate"
                                           id="txtDateofBirth"
                                           ng-model="DateofBirth">
                                </div>
                                <div>
                                    <label class="form-label">
                                        Marital Status   <span>*</span>
                                    </label>

                                    <select class="form-select employeeManual-input"
                                            ng-model="MaritalStatus">

                                        <option value="">Select</option>
                                        <option value="Married">Married</option>
                                        <option value="UnMarried">UnMarried</option>

                                    </select>
                                </div>
                                <div ng-init="BindSiteList()" hidden>
                                    <label class="form-label">
                                        Site Name/Code
                                    </label>
                                    <select class="form-select employeeManual-input"
                                            ng-model="SiteId" ng-disabled="true">
                                        <option value="">Select</option>
                                        <option ng-repeat="x in SiteList" value="{{x.SiteCode}}">
                                            {{x.SiteName}} ({{x.SiteCode}})
                                        </option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">
                                        Father/Husband Name <span>*</span>
                                    </label>

                                    <input class="form-control employeeManual-input validate"
                                           id="txtFatherHusbandName"
                                           ng-model="FatherHusbandName">
                                </div>
                                <div>
                                    <label class="form-label">
                                        Blood Group <span>*</span>
                                    </label>

                                    <input type="text"
                                           class="form-control employeeManual-input validate"
                                           id="txtBloodGroup"
                                           ng-model="BloodGroup">
                                </div>
                                <div>
                                    <label class="form-label">Worker Grade</label>
                                    <select class="form-select employeeManual-input"
                                            ng-model="WorkerGrade">
                                        <option value="">Select</option>
                                        <option value="Skilled">Skilled</option>
                                        <option value="Unskilled">Unskilled</option>
                                        <option value=Highly skilled">Highly skilled</option>
                                        <option value="Semi skilled">Semi skilled</option>

                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">Religion</label>
                                    <input type="text"
                                           class="form-control employeeManual-input validate"
                                           id="txtReligion"
                                           ng-model="Religion">
                                </div>
                                <div>
                                    <label class="form-label">Caste</label>
                                    <input type="text"
                                           class="form-control employeeManual-input validate"
                                           id="txtCaste"
                                           ng-model="Caste">
                                </div>
                                <div>
                                    <label class="form-label">Camp Number</label>
                                    <input type="text"
                                           class="form-control employeeManual-input validate"
                                           id="txtCampNumber"
                                           ng-model="CampNumber">
                                </div>

                                <div>
                                    <label class="form-label">
                                        Worker Photo  <span>*</span>
                                    </label>
                                    <input type="file" class="form-control employeeManual-input" onchange="angular.element(this).scope().openCropper1(this)" />
                                    <img ng-if="EmployeePhotos" src="{{EmployeePhotos ? EmployeePhotos : '../DownloadMat/dummy.jpg'}}" style="width:80px;height:80px;border-radius:8px;margin-top:10px;object-fit:cover;" />
                                </div>

                            </div>
                            <h5 style="color:var(--primary)">Contact & Address </h5>
                            <div class="form-grid mt-3">
                                <div>
                                    <label class="form-label">Present Address</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtPresentAddress"
                                           ng-model="PresentAddress">
                                </div>
                                <div ng-init="AllCity()">
                                    <label class="form-label">
                                        State
                                    </label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="State">
                                        <option value="">Select State</option>
                                        <option ng-repeat="x in AllCityList | unique:'STATE_NAME'"
                                                value="{{x.STATE_NAME}}">
                                            {{x.STATE_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">
                                        City
                                    </label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="City">
                                        <option value="">Select City</option>
                                        <option ng-repeat="x in AllCityList | filter:{STATE_NAME: State}"
                                                value="{{x.CITY_NAME}}">
                                            {{x.CITY_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">PIN Code</label>
                                    <input type="text" class="form-control form-control-sm validate" id="txtPincode" ng-model="Pincode" numeric-only dynamic-length maxlength="6" minlength="6">
                                </div>
                                <div class="form-label">
                                    <input style="font-size:0.9rem" type="checkbox" ng-model="chksameas" ng-change="SameAs()" /> Same As Above Present Address.
                                </div>
                                <div>

                                </div>
                                <div>

                                </div>
                                <div>

                                </div>
                                <div>
                                    <label class="form-label">Permanent Address</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtPermanentAddress"
                                           ng-model="PermanentAddress">
                                </div>

                                <div ng-init="AllCity()">
                                    <label class="form-label">
                                        State
                                    </label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="PState">
                                        <option value="">Select State</option>
                                        <option ng-repeat="x in AllCityList | unique:'STATE_NAME'"
                                                value="{{x.STATE_NAME}}">
                                            {{x.STATE_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">
                                        City
                                    </label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="PCity">
                                        <option value="">Select City</option>
                                        <option ng-repeat="x in AllCityList | filter:{STATE_NAME: PState}"
                                                value="{{x.CITY_NAME}}">
                                            {{x.CITY_NAME}}
                                        </option>
                                    </select>
                                </div>
                                <div>
                                    <label class="form-label">PIN Code</label>
                                    <input type="text" class="form-control form-control-sm validate" id="txtPincode" ng-model="PPincode" numeric-only dynamic-length maxlength="6" minlength="6">
                                </div>
                                <div>
                                    <label class="form-label">
                                        Mobile Number <span>*</span>
                                    </label>

                                    @*<input class="form-control employeeManual-input validate"
                                             id="txtMobileNumber"
                                             ng-model="MobileNumber"
                                             onblur="validatePhoneNo('#txtMobileNumber')"
                                             numeric-only
                                             dynamic-length
                                             maxlength="10"
                                             minlength="10" ng-disabled="true">*@
                                    <input class="form-control employeeManual-input validate"
                                           id="txtMobileNumber"
                                           ng-model="MobileNumber"
                                           ng-disabled="IsMobileDisabled"
                                           onblur="validatePhoneNo('#txtMobileNumber')"
                                           numeric-only
                                           dynamic-length
                                           maxlength="10"
                                           minlength="10">
                                </div>
                                <div>
                                    <label class="form-label">Emergency Mobile</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtAlternativeMobileNumber"
                                           ng-model="AlternativeMobileNumber"
                                           onblur="validatePhoneNo('#txtAlternativeMobileNumber')"
                                           numeric-only
                                           dynamic-length
                                           maxlength="10"
                                           minlength="10">
                                </div>
                                <div>
                                    <label class="form-label">Worker Email ID</label>
                                    @*<input class="form-control employeeManual-input"
                                             id="txtEmployeeEmailID"
                                             ng-model="EmployeeEmailID"  ng-disabled="IsEmailDisabled"
                                             onblur="validateEmail('#txtEmployeeEmailID')">*@
                                    <input class="form-control employeeManual-input"
                                           id="txtEmployeeEmailID"
                                           ng-model="EmployeeEmailID"
                                            ng-disabled="IsEmailDisabled"
                                           onblur="validateEmail('#txtEmployeeEmailID')">
                                </div>

                            </div>

                            <h5 style="color:var(--primary)">Statutory & Bank Details </h5>
                            <div class="form-grid mt-3">

                                <div>
                                    <label class="form-label">PAN No.</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtPANNumber"
                                           ng-model="PANNumber"
                                           dynamic-length
                                           maxlength="10"
                                           minlength="10">
                                </div>
                                <div>
                                    <label class="form-label">Aadhaar No.</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtAdharCardNumber"
                                           ng-model="AdharCardNumber"
                                           numeric-only
                                           dynamic-length
                                           maxlength="12"
                                           minlength="12">
                                </div>
                                <div>
                                    <label class="form-label">UAN No.</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtPreviousUAN"
                                           ng-model="PreviousUAN">
                                </div>
                                <div>
                                    <label class="form-label">
                                        Bank Name
                                    </label>

                                    <input class="form-control employeeManual-input"
                                           id="txtBankAccountname"
                                           ng-model="bankname">
                                </div>
                                <div>
                                    <label class="form-label">
                                        Account Holder Name
                                    </label>

                                    <input class="form-control employeeManual-input"
                                           id="txtBankAccountname"
                                           ng-model="acholdername">
                                </div>
                                <div>
                                    <label class="form-label">
                                        Account No
                                    </label>

                                    <input class="form-control employeeManual-input"
                                           id="txtBankAccountNumber"
                                           ng-model="BankAccountNumber">
                                </div>
                                <div>
                                    <label class="form-label">Bank IFSC Code</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtBankIFSCCode"
                                           ng-model="BankIFSCCode">
                                </div>
                                <div>
                                    <label class="form-label">ESIC No.</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtPreviousESI"
                                           ng-model="PreviousESI">
                                </div>
                                <div>
                                    <label class="form-label">LWF No.</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtLWF"
                                           ng-model="LWF">
                                </div>
                                <div>
                                    <label class="form-label">WC Policy No.</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtPreviousESI"
                                           ng-model="WCPolicy">
                                </div>
                                <div hidden>
                                    <label class="form-label">Gross Salary</label>
                                    <input class="form-control employeeManual-input"
                                           id="txtGrossSalary"
                                           ng-model="GrossSalary"
                                           numeric-only>
                                </div>

                            </div>


                            <!-- BUTTONS -->
                            <div class="entity-footer d-flex justify-content-between mt-3">

                                <button class="btn save-btn prev-btn d-none">Previous</button>

                                <div class="ms-auto d-flex gap-2">

                                    <button class="btn save-btn next-btn">Next</button>
                                    <button class="btn save-btn"
                                            ng-click="SaveStep1();ManageLog('Update in Worker Master')">
                                        Update
                                    </button>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- STEP 2 -->
                    <div class="form-step" data-step="2" style="display:none;">

                        <div class="card entity-card p-3">

                            <h5 style="color:var(--primary)">Nominee Details</h5>

                            <p class="text-muted mb-2">Gratuity Act Nominee</p>

                            <div class="form-grid mt-2">
                                <div>
                                    <label class="form-label">
                                        Nominee Name<span>*</span>
                                    </label>
                                    <input class="form-control employeeManual-input"
                                           ng-model="NameofNominee">
                                </div>
                                <div>
                                    <label class="form-label">
                                        Relation<span>*</span>
                                    </label>
                                    <input class="form-control employeeManual-input"
                                           ng-model="RelationofNominee">
                                </div>
                                <div>
                                    <label class="form-label">
                                        DOB<span>*</span>
                                    </label>
                                    <input type="date"
                                           class="form-control employeeManual-input"
                                           ng-model="DOBofNominee">
                                </div>
                                <div>
                                    <label class="form-label">Address</label>
                                    <input class="form-control employeeManual-input"
                                           ng-model="AddressofNominee">
                                </div>
                                <div>
                                    <label class="form-label">Mobile no</label>
                                    <input class="form-control employeeManual-input" id="txtNomineeMobile" onblur="validatePhoneNo('#txtNomineeMobile')" numeric-only dynamic-length maxlength="10" minlength="10"
                                           ng-model="NomineeMobile">
                                </div>
                                <div>
                                    <label class="form-label">Email Id</label>
                                    <input class="form-control employeeManual-input"
                                           ng-model="NomineeEmeail">
                                </div>
                                <div hidden>
                                    <label class="form-label">PAN No.</label>
                                    <input class="form-control employeeManual-input" maxlength="10" minlength="10" style="text-transform:uppercase;" id="txtNomineePan" ng-model="NomineePan">
                                </div>
                                <div hidden>
                                    <label class="form-label">Aadhar No.</label>
                                    <input class="form-control form-control-sm" ng-keypress="onlyNumbers($event)" id="txtNomineeAdhar" ng-model="NomineeAdhar" numeric-only dynamic-length maxlength="12" minlength="12">
                                </div>
                                <div hidden>
                                    <label class="form-label">PAN Copy</label>
                                    <input type="file" class="upload-input"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           id="fuAdhaarCard_FrontSide_FilePath{{$index}}"
                                           onchange="angular.element(this).scope().uploadFile('PANCopyFilePath', this)" ng-model="PANCopyFilePath">
                                    @*<span class="file-name">
                                        {{ PANCopyFileName || 'No file chosen' }}
                                    </span>*@
                                    <div class="upload-actions" ng-if="PANCopyFilePath">
                                        <i class="bi bi-eye upload-icon"
                                           title="View"
                                           ng-click="ViewFileC(PANCopyFilePath)"></i>
                                        <i class="bi bi-download upload-icon"
                                           title="Download"
                                           ng-click="DownloadFileC(PANCopyFilePath,'PAN Card Copy')"></i>
                                    </div>
                                </div>
                                <div hidden>
                                    <label class="form-label">Aadhar Copy</label>
                                    <input type="file" class="upload-input"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           id="fuAdhaarCard_FrontSide_FilePath{{$index}}"
                                           onchange="angular.element(this).scope().uploadFile('AdharCopy_FilePath', this)" ng-model="AdharCopy_FilePath">
                                    @*<span class="file-name">
                                        {{ AdharCopy_FileName || 'No file chosen' }}
                                    </span>*@
                                    <div class="upload-actions" ng-if="AdharCopy_FilePath">
                                        <i class="bi bi-eye upload-icon"
                                           title="View"
                                           ng-click="ViewFileC(AdharCopy_FilePath)"></i>
                                        <i class="bi bi-download upload-icon"
                                           title="Download"
                                           ng-click="DownloadFileC(AdharCopy_FilePath,'Adhar Card Copy')"></i>
                                    </div>
                                </div>
                            </div>

                            <br />
                            <p class="text-muted mb-2">PF Nominee</p>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="pfSameAsAbove" ng-model="pfsameas" ng-change="PFSameAs()">
                                <label class="form-check-label"
                                       for="pfSameAsAbove">
                                    Same as Above
