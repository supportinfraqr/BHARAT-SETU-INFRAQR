                                    </div>

                                    <div class="signature-box">

                                        <div class="signature-line"></div>

                                        <div class="signature-title">
                                            Sign of Contractor
                                        </div>

                                        <div class="signature-note">
                                            Mention Name &amp; seal
                                        </div>

                                    </div>

                                    <div class="signature-box">

                                        <div class="signature-line"></div>

                                        <div class="signature-title">
                                            Sign of HR HEAD
                                        </div>

                                        <div class="signature-note">
                                            (Mention Name &amp; Designation with seal)
                                        </div>

                                    </div>

                                    <div class="signature-box">

                                        <div class="signature-line"></div>

                                        <div class="signature-title">
                                            Sign of CSO
                                        </div>

                                        <div class="signature-note">
                                            (Mention Name &amp; Designation with seal)
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

