                                    <span class="underline underline-md">
                                        {{SiteName}}
                                    </span>

                                    plant from date

                                    <span class="inline-date">
                                        {{TCreatedOn}}
                                    </span>

                                    &nbsp; To &nbsp;

                                    <span class="inline-date">
                                        {{TGatePassExpiryDate}}
                                    </span>

                                    (

                                    <span class="inline-days">
                                        {{GatePassDays}}
                                    </span>

                                    No. of days).

                                </p>

                                <!-- Worker table starts here -->
                                <table class="worker-table">

                                    <thead>

                                        <tr>

                                            <th style="width:9%;">Sl. No.</th>

                                            <th style="width:33%;">Name</th>

                                            <th style="width:11%;">Age</th>

                                            <th>Address</th>

                                        </tr>

                                    </thead>

                                    <tbody>

                                        <tr>

                                            <td>1.</td>

                                            <td>{{EmployeeName}}</td>

                                            <td>{{Age}}</td>

                                            <td>{{PermanemtAddress}}</td>

                                        </tr>

                                    </tbody>

                                </table>

