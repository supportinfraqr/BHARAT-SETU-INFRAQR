                            @*<div class="te-unit-emp">{{x.TotalEmployee}}</div>*@
                        </div>
                        <button class="btn te-transfer-btn"
                                ng-click="SetTransfer(x.Id);ManageLog('Transfer ' + x.StoreCode)"
