@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Support Grievances";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Content/Dashboards/ContractorGrievances/style.css" rel="stylesheet" />
<script src="~/scripts/RetailJsLib/GrivancesController.js"></script>
<script>
    $(document).ready(function () {

        $('#cardViewBtn').on('click', function () {

            $('#supportCardView').show();
            $('#supportListView').hide();

            $('#cardViewBtn').addClass('active');
            $('#listViewBtn').removeClass('active');
        });

        $('#listViewBtn').on('click', function () {

            $('#supportListView').show();
            $('#supportCardView').hide();

            $('#listViewBtn').addClass('active');
            $('#cardViewBtn').removeClass('active');
        });

    });
</script>


<div class="contractorGrievances px-4 py-4">

    <!-- Page Header -->
    <div class="contractorGrievancesHeader">

        <div>
            <h3 class="supportPageTitle mb-1">
                Grievances & Tickets
            </h3>

            <p class="supportPageSubTitle mb-0">
                All tickets raised by workers across sites & contractors
            </p>
        </div>

        <div class="supportViewToggle">

            <button class="supportViewBtn active"
                    id="listViewBtn"
                    type="button">
                <i class="bi bi-list-ul"></i>
            </button>

            <button class="supportViewBtn "
                    id="cardViewBtn"
                    type="button">
                <i class="bi bi-grid-3x3-gap-fill"></i>
            </button>

        </div>

    </div>

    <!-- KPI CARDS -->
    <div class="row g-3 mb-3" ng-init="BindTiles()">

        <div class="col-xl-3 col-md-6">
            <div class="supportKpiCard" style="background: #F3F8FF">
                <div class="supportKpiIcon supportKpiOpen">
                    <i class="bi bi-hourglass-split"></i>
                </div>
              
                <div>
                    <h3>{{ (BindTilesList | filter:{CStatus:'0'}).length }}</h3>
                    <p style="color: #155DFC">Open Tickets</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="supportKpiCard" style="background: #F9F4FF">
                <div class="supportKpiIcon supportKpiProgress">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <div>
                    <h3>{{ (BindTilesList | filter:{CStatus:'0'}).length }}</h3>
                    <p style="color: purple">In Progress</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="supportKpiCard" style="background: #F3F5FF">
                <div class="supportKpiIcon supportKpiResolved">
                    <i class="bi bi-check2-circle"></i>
                </div>

                <div>
                    <h3>{{ (BindTilesList | filter:{CStatus:'1'}).length }}</h3>
                    <p style="color: #003BB2">Resolved</p>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="supportKpiCard" style="background: #F3FFF7">
                <div class="supportKpiIcon supportKpiTotal">
                    <i class="bi bi-bullseye"></i>
                </div>

                <div>
                    <h3>{{ BindTilesList.length }}</h3>
                    <p style="color: green">Total Tickets</p>
                </div>
            </div>
        </div>

    </div>

    <!-- List View-->
    <div id="supportListView">
        <!-- GRIEVANCE CARD -->
        <div class="supportTicketCard mb-2" ng-repeat="x in BindTilesList">

            <!-- TOP -->
            <div class="supportTicketTop"  >

                <div class="supportTicketLeft">

                    <div class="supportTicketIcon">
                        <i class="bi bi-chat-left-text"></i>
                    </div>

                    <div class="supportTicketContent">

                        <div class="supportTicketTitleRow">

                            <h4 class="supportTicketTitle">
                                {{x.Subject}}
                            </h4>

                            <div class="supportTicketBadges">

                               

                                  <span class="supportBadge supportBadgeProgress">
                                      {{x.Status}}
                                  </span>
 
                            </div>

                        </div>

                        <p class="supportTicketDesc mb-0">
                            {{x.AiText}}
                        </p>

                    </div>

                </div>

            </div>

            <!-- INFO GRID -->
            <div class="supportInfoGrid">

                <div class="supportInfoItem">
                    <label>Raised By</label>

                    <div>
                        <i class="bi bi-person"></i>
                        <span>{{x.UserName}}</span>
                    </div>
                </div>

                <div class="supportInfoItem">
                    <label>Site Location</label>

                    <div>
                        <i class="bi bi-geo-alt"></i>
                        <span>{{x.SiteName}}</span>
                    </div>
                </div>

            </div>

            <!-- Audio and image section-->
            <div class="supportEvidenceSection">

                <div class="supportAudioBlock">

                    <h6>Worker's Audio Recording</h6>

                    <div class="supportAudioPlayer">

                        <audio id="audioPlayer" ng-src="../DownloadMat/Uploads/Audio/{{x.AudioFileName}}"
                               controls
                               class="w-100 mt-3">
                        </audio>

                    </div>

                </div>

                <div class="supportLetterBlock">

                    <h6>Letter Image</h6>

                    <div class="supportLetterImages">

                        <div class="supportLetterCount"
                             ng-if="x.Documents && x.Documents.split(',').length > 1">
                            +{{ x.Documents.split(',').length}}
                        </div>

                    </div>

                </div>

            </div>

            <!-- FOOTER -->
            <div class="supportTicketFooter">

                <div class="supportTicketMeta">

                    <div>
                        <i class="bi bi-clock"></i>
                        Raised: {{x.CreatedOn}}
                    </div>

                    <div>
                        <i class="bi bi-activity"></i>
                        Updated:  {{x.UpdatedOn}}
                    </div>

                    <div>
                        <i class="bi bi-person-workspace"></i>
                        Assigned: {{x.Contractor}}
                    </div>

                </div>

                <div class="supportTicketActions">
                    <a href="../RetailSection/ContractorGrievancesDetails?Id={{x.Id}}">
                        <button class="supportBtn supportBtnLight">
                            <i class="bi bi-eye"></i>
                            View Details
                        </button> 
                    </a>
                   
                </div>

            </div>

        </div>

