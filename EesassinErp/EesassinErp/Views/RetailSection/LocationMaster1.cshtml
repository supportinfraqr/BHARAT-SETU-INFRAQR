                                                <input type="date" class="form-control form-control-sm" id="archStartDate" readonly>
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small mb-1">Est. Completion</label>
                                                <input type="date" class="form-control form-control-sm" id="archEndDate" readonly>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small mb-1">Notes</label>
                                                <textarea class="form-control form-control-sm" id="archContractorNotes" rows="4" readonly></textarea>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-12 col-xl-6">
                                    <div class="arch-card p-3 h-100 d-flex flex-column">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <h6 class="mb-0" style="color:var(--primary)">Drawings & Blueprints</h6>
                                            <small class="text-muted">Upload / view plans (activity-specific)</small>
                                        </div>

                                        <div id="archGallery" class="arch-gallery" style="overflow:auto; min-height:120px;"></div>

                                        <div class="row g-2 mt-3">
                                            <div class="col-6 col-md-4">
                                                <label class="form-label small mb-1">Add Floor Plan</label>
                                                <input type="file" class="form-control form-control-sm arch-file-input" data-type="Floor Plan">
                                            </div>
                                            <div class="col-6 col-md-4">
                                                <label class="form-label small mb-1">Add Electrical Layout</label>
                                                <input type="file" class="form-control form-control-sm arch-file-input" data-type="Electrical">
                                            </div>
                                            <div class="col-6 col-md-4">
                                                <label class="form-label small mb-1">Add HVAC Diagram</label>
                                                <input type="file" class="form-control form-control-sm arch-file-input" data-type="HVAC">
                                            </div>
                                        </div>

                                        <div class="mt-3">
                                            <small class="text-muted">Uploaded files are kept client-side (UI-only). Click thumbnail to preview.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 3: Compliance (full width) -->
                            <div class="row g-4 mt-1">
                                <div class="col-12">
                                    <div class="arch-card p-3 d-flex flex-column">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <h6 class="mb-0" style="color:var(--primary)">Compliance Review Status</h6>
                                            <small class="text-muted">Issues & severity</small>
                                        </div>

                                        <div id="archComplianceAlert" class="arch-alert d-none" role="alert">
                                            <div class="arch-alert-title"> Compliance Issues Found (<span id="archIssuesCount">0</span>)</div>
                                            <ul id="archIssuesList" class="mb-0 mt-2"></ul>
                                        </div>

                                        <div class="mt-2">
                                            <button class="btn btn-sm" id="archAddIssue">+ Add Issue</button>
                                            <button class="btn btn-sm ms-2" id="archResolveAll">Resolve All</button>
                                        </div>

                                        <div class="mt-auto small text-muted pt-3">Issues are UI-only in this static demo.</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- FOOTER -->
                    <div class="modal-footer border-0 p-4 lm-architect-footer">
                        <div class="w-100 d-flex justify-content-end gap-2">
                            <button type="button" class="btn" id="archCancelBtn">Cancel</button>
                            <button type="button" class="btn " id="archSaveDraftBtn">Save Draft</button>
                            <button type="button" class="btn " id="archSubmitBtn">Submit </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Architect Version history tiny modal (unchanged) -->
        <div class="modal fade lm-arch-version-modal" id="lmArchVersionModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0">
                        <h6 class="mb-0">Version history</h6>
