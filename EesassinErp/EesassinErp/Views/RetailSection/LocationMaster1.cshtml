                    </div>
                    <div class="modal-footer border-0">
                        <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>




        <!-- ================= IMPORT CARD (hidden by default) ================= -->
        <div id="importCard" class="card section-card d-none">
            <div class="card-body p-3">
                <h6>Import Locations</h6>
                <p class="text-muted">Upload CSV or Excel to import multiple locations.</p>

                <!-- Download Template -->
                <button class="btn btn-sm btn-outline-primary mb-3" id="lmDownloadTemplate">
                    <i class="bi bi-download me-1"></i> Download Template
                </button>

                <!-- Upload Box -->
                <div class="lm-import-box p-3">
                    <label class="form-label fw-semibold mb-2">Choose File</label>
