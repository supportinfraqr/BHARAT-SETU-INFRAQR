
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Location Master";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Masters/LocationMaster/style.css" rel="stylesheet" />
<script src="~/Masters/LocationMaster/script.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="locationMasterPage px-4 py-2">  
    <!-- Top bar: instruction left + New Location button right -->
    <div class="d-flex align-items-center justify-content-between mb-3 top-bar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="limit-instruction">Location Total Limit: <strong>600</strong></div>
            <div class="limit-instruction">Used: <strong>250</strong></div>
            <div class="limit-instruction">Left: <strong>350</strong></div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- New Location (rounded pill) -->
            <button class="btn btn-sm btn-new-location" id="btnNewLocation" type="button">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>New Location</span>
            </button>
        </div>
    </div>

    <!-- NEW LOCATION MODAL (scoped) -->
    <div class="modal fade lm-newlocation-modal" id="lmNewLocationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content lm-newlocation-card">
                <div class="modal-header lm-newlocation-topbar">
                    <div>
                        <h5 class="mb-0">New Location — <small class="text-white-75">Create / Edit location</small></h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-3 lm-newlocation-body">
                    <div class="container-fluid">
                        <div class="row g-3">
                            <!-- Row 1 -->
                            <div class="col-md-3">
                                <label class="form-label">Location Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtStoreCode" disabled />
                                <div class="small text-danger d-none" id="txtStoreCodeError">Special characters are not allowed.</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Ref. Location Code</label>
                                <input type="text" class="form-control" id="txtRefStoreCode" maxlength="10" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Compliance Category <span class="text-danger">*</span></label>
                                <select id="ddlComplianceCategory" class="form-select">
                                    <option value="">Select Compliance</option>
                                    <option value="Factory">Factory</option>
                                    <option value="Establishment">Establishment</option>
                                    <option value="Contractor">Contractor</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Category <span class="text-danger">*</span></label>
                                <select id="ddlCategory" class="form-select">
                                    <option value="">Select Category</option>
                                    <option value="1">Store</option>
                                    <option value="2">Warehouse</option>
                                    <option value="3">Factory</option>
                                </select>
                            </div>

                            <!-- Row 2 -->
                            <div class="col-md-3">
                                <label class="form-label">Operation model <span class="text-danger">*</span></label>
                                <select id="ddlOperationModel" class="form-select">
                                    <option value="">Select</option>
                                    <option value="COCO">COCO – Company Owned Company Operated</option>
                                    <option value="FOCO">FOCO – Franchise Owned Company Operated</option>
                                    <option value="FICO">FICO – Franchise Invested Company Operated</option>
                                    <option value="COFO">COFO – Company Owned Franchise Operated</option>
                                    <option value="FOFO">FOFO – Franchise Owned Franchise Operated</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Location Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtStoreName" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Complete Address <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtCompleteAddress" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Proposed/Existing <span class="text-danger">*</span></label>
                                <input id="txtProposedDate" type="date" class="form-control" />
                            </div>

                            <!-- Row 3 -->
                            <div class="col-md-3">
                                <label class="form-label">Location <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtStoreLocation" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">State <span class="text-danger">*</span></label>
                                <select id="ddlstate" class="form-select">
                                    <option value="">Select State</option>
                                    <option value="MH">Maharashtra</option>
                                    <option value="DL">Delhi</option>
                                    <option value="KA">Karnataka</option>
                                    <!-- keep static for now -->
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">City <span class="text-danger">*</span></label>
                                <select id="ddlcity" class="form-select">
                                    <option value="">Select City</option>
                                    <option value="MUM">Mumbai</option>
                                    <option value="DEL">New Delhi</option>
                                    <option value="BLR">Bengaluru</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Circle/Cluster</label>
                                <select id="txtCircleId" class="form-select">
                                    <option value="">Select</option>
                                    <option value="1">Circle A</option>
                                    <option value="2">Circle B</option>
                                </select>
                            </div>

                            <!-- Row 4 -->
                            <div class="col-md-3">
                                <label class="form-label">Region <span class="text-danger">*</span></label>
                                <select id="txtRegionId" class="form-select">
                                    <option value="">Select</option>
                                    <option value="R1">Region 1</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Zip Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtZipCode" maxlength="6" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Location Manager Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtStoreManagerName" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Location Manager Mobile No. <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtStoreManagerMobileNo" maxlength="10" />
                            </div>

                            <!-- Row 5 -->
                            <div class="col-md-3">
                                <label class="form-label">Location Manager Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="txtStoreManagerEmail" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Escalation 1 Name</label>
                                <input type="text" class="form-control" id="txtAreaManagerName" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Escalation 1 Mobile</label>
                                <input type="text" class="form-control" id="txtAreaManagerMobileNo" maxlength="10" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Escalation 1 Email</label>
                                <input type="email" class="form-control" id="txtAreaManagerEmail" />
                            </div>

                            <!-- Row 6: more escalation rows (kept all fields) -->
                            <div class="col-md-3">
                                <label class="form-label">Escalation 2 Name</label>
                                <input type="text" class="form-control" id="txtZonalManagerName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 2 Mobile</label>
                                <input type="text" class="form-control" id="txtZonalManagerMobileNo" maxlength="10" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 2 Email</label>
                                <input type="email" class="form-control" id="txtZonalManagerEmail" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 3 Name</label>
                                <input type="text" class="form-control" id="txtCircleHeadName" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Escalation 3 Mobile</label>
                                <input type="text" class="form-control" id="txtCircleHeadMobileNo" maxlength="10" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 3 Email</label>
                                <input type="email" class="form-control" id="txtCircleHeadEmail" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Escalation 4 Name</label>
                                <input type="text" class="form-control" id="txtRegionalHeadName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 4 Mobile</label>
                                <input type="text" class="form-control" id="txtRegionalHeadMobileNo" maxlength="10" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 4 Email</label>
                                <input type="email" class="form-control" id="txtRegionalHeadEmail" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Escalation 5 Name</label>
                                <input type="text" class="form-control" id="txtCorporateHeadName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 5 Mobile</label>
                                <input type="text" class="form-control" id="txtCorporateHeadMobileNo" maxlength="10" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Escalation 5 Email</label>
                                <input type="email" class="form-control" id="txtCorporateHeadEmail" />
                            </div>

                            <!-- Sizes, days -->
                            <div class="col-md-3">
                                <label class="form-label">Location Area in sq.ft. <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtSQFTStoreArea" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Days to Expire <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtDaysOfExpire" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">License Expiry days <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtled" />
                            </div>

                            <div class="col-12">
                                <fieldset class="border p-3 mb-2">
                                    <legend class="float-none w-auto px-2"><h6 class="mb-0">Select Due date for</h6></legend>

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">License</label>
                                            <input type="text" class="form-control" id="txtLicenseD" disabled />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Days to Expire</label>
                                            <input type="text" class="form-control" id="txtLicenseDaysOfExpire" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Expiry Days</label>
                                            <input type="text" class="form-control" id="txtLicenseED" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Labour</label>
                                            <input type="text" class="form-control" id="txtLabourD" disabled />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Days to Expire</label>
                                            <input type="text" class="form-control" id="txtLabourDaysOfExpire" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Expiry Days</label>
                                            <input type="text" class="form-control" id="txtLabourED" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Factory</label>
                                            <input type="text" class="form-control" id="txtFactoryD" disabled />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Days to Expire</label>
                                            <input type="text" class="form-control" id="txtFactoryDaysOfExpire" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Expiry Days</label>
                                            <input type="text" class="form-control" id="txtFactoryED" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Finance</label>
                                            <input type="text" class="form-control" id="txtFinanceD" disabled />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Days to Expire</label>
                                            <input type="text" class="form-control" id="txtFinanceDaysOfExpire" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Expiry Days</label>
                                            <input type="text" class="form-control" id="txtFinanceED" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">Secretarial</label>
                                            <input type="text" class="form-control" id="txtSecraterialD" disabled />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Days to Expire</label>
                                            <input type="text" class="form-control" id="txtSecraterialDaysOfExpire" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Expiry Days</label>
                                            <input type="text" class="form-control" id="txtSecraterialED" />
                                        </div>
                                    </div>
                                </fieldset>
                            </div>

                            <!-- Documents table -->
                            <div class="col-12">
                                <h6 class="subheading m-0 mb-2">Documents</h6>

                                <div class="table-responsive">
                                    <table class="table table-sm table-borderless arch-newlocation-docs">
                                        <thead class="text-center">
                                            <tr>
                                                <th>Sr no</th>
                                                <th>Document Name</th>
                                                <th>Period From</th>
                                                <th>Period Upto</th>
                                                <th>View/Upload</th>
                                                <th>Remark</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            <tr>
                                                <td>1</td>
                                                <td>Electricity Bill</td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td><input type="date" class="form-control form-control-sm" id="ElectricityBillPeriodUpTo" /></td>
                                                <td class="text-center">
                                                    <input type="file" id="fuElectricityBill" class="d-none" />
                                                    <button type="button" class="btn btn-sm doc-choose-btn" data-target="#fuElectricityBill">Choose File</button>
                                                </td>
                                                <td><input type="text" class="form-control form-control-sm" /></td>
                                            </tr>

                                            <tr>
                                                <td>2</td>
                                                <td>Lease / LOI</td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td class="text-center">
                                                    <input type="file" id="fuRentAgreement" class="d-none" />
                                                    <button type="button" class="btn btn-sm  doc-choose-btn" data-target="#fuRentAgreement">Choose File</button>
                                                </td>
                                                <td><input type="text" class="form-control form-control-sm" /></td>
                                            </tr>

                                            <tr>
                                                <td>3</td>
                                                <td>Property Tax Receipt</td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td class="text-center">
                                                    <input type="file" id="fuPropertyTaxPaidReceipt" class="d-none" />
                                                    <button type="button" class="btn btn-sm doc-choose-btn" data-target="#fuPropertyTaxPaidReceipt">Choose File</button>
                                                </td>
                                                <td><input type="text" class="form-control form-control-sm" /></td>
                                            </tr>

                                            <!-- extra dummy rows -->
                                            <tr>
                                                <td>4</td>
                                                <td>Fire NOC</td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td class="text-center">
                                                    <input type="file" id="fuFireNoc" class="d-none" />
                                                    <button type="button" class="btn btn-sm doc-choose-btn" data-target="#fuFireNoc">Choose File</button>
                                                </td>
                                                <td><input type="text" class="form-control form-control-sm" /></td>
                                            </tr>

                                            <tr>
                                                <td>5</td>
                                                <td>Pollution Certificate</td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td><input type="date" class="form-control form-control-sm" /></td>
                                                <td class="text-center">
                                                    <input type="file" id="fuPollution" class="d-none" />
                                                    <button type="button" class="btn btn-sm doc-choose-btn" data-target="#fuPollution">Choose File</button>
                                                </td>
                                                <td><input type="text" class="form-control form-control-sm" /></td>
                                            </tr>

                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- footer row actions -->
                            <div class="col-12">
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn" id="cancelNewLocationBtn" data-bs-dismiss="modal">Cancel</button>
                                    <button type="button" class="btn" id="saveNewLocationBtn">Save</button>
                                </div>
                            </div>

                        </div> <!-- .row -->
                    </div> <!-- .container-fluid -->
                </div> <!-- .modal-body -->
            </div>
        </div>
    </div>


    <!-- ================= KPI Bar ================= -->
    <div class="container my-4 locationMasterPage">
        <div class="row g-3">

            <!-- Total Locations -->
            <div class="col-md-3">
                <div class="lm-kpi-card d-flex">
                    <div class="lm-kpi-title">Total Upcoming</div>
                    <div class="lm-kpi-value" id="kpiTotalLocations">230</div>
                </div>
            </div>

            <!-- Data Quality Score -->
            <div class="col-md-3">
                <div class="lm-kpi-card d-flex">
                    <div class="lm-kpi-title">Total PD</div>
                    <div class="lm-kpi-value" id="kpiQualityScore">86</div>
                </div>
            </div>

            <!-- Locations Needing Validation -->
            <div class="col-md-3">
                <div class="lm-kpi-card d-flex">
                    <div class="lm-kpi-title">Total Architect</div>
                    <div class="lm-kpi-value" id="kpiNeedsValidation">68</div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="col-md-3">
                <div class="lm-kpi-card d-flex">
                    <div class="lm-kpi-title">License</div>
                    <div class="lm-kpi-value" id="kpiRecentActivities">25</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="View or Import">
            <button type="button" class="btn btn-pill active" data-target="#viewCard" aria-pressed="true">View</button>
            <button type="button" class="btn btn-pill" data-target="#importCard" aria-pressed="false">Import</button>
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">
        <!-- VIEW CARD (default visible) -->
        <div id="viewCard" class="card section-card active">
            <div class="card-body p-3 h-100 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Month
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">January</a></li>
                                <li><a class="dropdown-item" href="#">February</a></li>
                                <li><a class="dropdown-item" href="#">March</a></li>
                                <!-- ... -->
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Year
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">2025</a></li>
                                <li><a class="dropdown-item" href="#">2024</a></li>
                            </ul>
                        </div>

                        <button class="btn btn-sm filter-btn active">Go</button>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="lmSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                                <button class="btn btn-sm" style="border-color: #E45D27" id="lmSearchBtn" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div>
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="#">CSV</a></li>
                                    <li><a class="dropdown-item" href="#">PDF</a></li>
                                    <li><a class="dropdown-item" href="#">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="lmTable">
                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Store Code</th>
                                    <th>Ref. Location Code</th>
                                    <th>Location Name</th>
                                    <th>Category</th>
                                    <th>Location</th>
                                    <th>City</th>
                                    <th>Region</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="lmTableBody">
                                <tr>
                                    <td>1</td>
                                    <td><a href="#" class="store-code-link text-success" data-storecode="00002678" data-storeid="1">00002678</a></td>
                                    <td>Contest34</td>
                                    <td>Test SN34</td>
                                    <td>Store</td>
                                    <td>Andhra Pradesh</td>
                                    <td>Vijayawada</td>
                                    <td>Central</td>
                                    <td><span class="badge status-active">Active</span></td>
                                    <td class="action-menu">
                                        <button class="btn btn-sm" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item open-manage-project" href="#" data-storecode="ST00123">Manage Project Document</a></li>
                                            <li><a class="dropdown-item open-view-architect" href="#" data-storecode="ST00123">View Architect Form</a></li>
                                            <li><a class="dropdown-item open-license-copy" href="#">License Copy</a></li>
                                            <li><a class="dropdown-item" href="#">Compliance Doc</a></li>
                                            <li><a class="dropdown-item open-view-more" href="#" data-storecode="00002678">View More</a></li>
