    }

    /* Upload Field (Aligned) */
    .upload-field {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .upload-input-wrap {
        position: relative;
        flex: 1;
        border: 1px solid rgba(0,0,0,0.15);
