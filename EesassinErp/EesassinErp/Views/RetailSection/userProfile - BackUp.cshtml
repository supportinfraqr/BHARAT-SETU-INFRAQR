
@{
    ViewBag.Title = "userProfile";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body::-webkit-scrollbar {
            display: none;
        }

        /* ===================== USER PROFILE PAGE ===================== */
        .userProfile {
            background-color: #FFF6F1;
            font-family: "Poppins", sans-serif;
            min-height: 100vh;
            padding-bottom: 3rem;
        }

        /* ----- HEADER SECTION ----- */
        .userProfile .profile-header {
            background: linear-gradient(90deg, #FD670B, #FF8745);
            color: #fff;
            padding: 2rem 1.5rem;
            border-radius: 12px 12px 12px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .userProfile .profile-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .userProfile .profile-left img {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 3px solid #fff;
            object-fit: cover;
        }

        .userProfile .profile-left .profile-info h4 {
            font-weight: 600;
            margin: 0;
        }

        .userProfile .admin-badge {
            background-color: #fff;
            color: #FD670B;
            font-size: 0.8rem;
            font-weight: 500;
            border-radius: 20px;
            padding: 0.2rem 0.75rem;
            margin-left: 0.5rem;
            display: inline-block;
        }

        .userProfile .profile-left .info-list {
            font-size: 0.9rem;
            margin-top: 0.5rem;
        }

        .userProfile .info-list i {
            margin-right: 0.5rem;
        }

        /* Buttons on right (STACKED) */
        .userProfile .header-buttons {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .userProfile .header-buttons .btn-doc {
            border: 2px solid #fff;
            color: #fff;
            background: transparent;
            border-radius: 25px;
            padding: 0.35rem 0.9rem;
            font-size: 0.9rem;
            font-weight: 500;
            text-align: left;
            transition: all 0.3s ease;
        }

        .userProfile .header-buttons .btn-doc:hover {
            background: #fff;
            color: #FD670B;
        }

        /* ----- TOGGLE BUTTONS ----- */
        .userProfile .toggle-section {
            display: flex;
            justify-content: flex-start;
        }

        .userProfile .toggle-container {
            background-color: #FFF0E6;
            border-radius: 30px;
            display: inline-flex;
            padding: 0.3rem;
            gap: 0.3rem;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
        }

        .userProfile .toggle-container button {
            border: none;
            background: transparent;
            color: #FD670B;
            font-weight: 500;
            border-radius: 25px;
            padding: 0.4rem 1.4rem;
            transition: all 0.3s ease;
        }

        .userProfile .toggle-container button:hover {
            background: rgba(253, 103, 11, 0.1);
        }

        .userProfile .toggle-container button.active {
            background: #FD670B;
            color: #fff;
        }


        /* ----- MAIN CARDS SECTION ----- */
        .userProfile .content-section {
            padding: 0 1.5rem;
        }

        .userProfile .info-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            padding: 1.5rem;
            height: 100%;
        }

        .userProfile .info-card h5 {
            font-weight: 600;
            margin-bottom: 1rem;
        }

        .userProfile .info-card i {
            color: #FD670B;
            margin-right: 0.5rem;
        }

        /* ----- CLIENT DETAILS ----- */
        .userProfile .client-details .detail-row {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-bottom: 0.75rem;
        }

        .userProfile .client-details label {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 0.2rem;
            display: block;
        }

        .userProfile .client-details span {
            background-color: #FFF0E6;
            border-radius: 6px;
            padding: 0.25rem 0.6rem;
            font-weight: 500;
            color: #333;
            display: inline-block;
            min-width: 130px;
        }

        .userProfile .client-details .detail-row #status {
            padding-right: 1.2rem;
        }


        /* Buttons inside client details (bottom) */
        .client-details .client-card-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
            flex-wrap: wrap;
        }

        .client-details .btn-action {
            background-color: #FD670B;
            color: #fff;
            border: none;
            border-radius: 25px;
            padding: 8px 14px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

            .client-details .btn-action:hover {
                background: #E45D27;
            }

        /* ----- SERVICES ENROLLED ----- */
        .userProfile .services-enrolled .service-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .userProfile .services-enrolled small {
            color: #777;
        }

        .userProfile .service-list {
            margin-top: 1rem;
            max-height: 260px;
            overflow-y: auto;
        }

        .userProfile .service-list::-webkit-scrollbar {
            width: 0;
            height: 0;
        }

        .userProfile .service-item {
            background: #FFF6F1;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 0.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
        }

        .userProfile .service-item:hover {
            background: #FFE5D3;
        }

        .userProfile .service-item .left {
            display: flex;
            flex-direction: column;
        }

        .userProfile .service-item .left small {
            color: #666;
            font-size: 0.85rem;
        }

        .userProfile .service-item .status {
            background: #E6F8E7;
            color: #1E824C;
            font-size: 0.8rem;
            font-weight: 500;
            border-radius: 15px;
            padding: 0.25rem 0.75rem;
        }

        @@media (max-width: 992px) {
            .userProfile .info-card {
                margin-bottom: 1rem;
            }
        }

        /* ===================== USERS SECTION STYLES ===================== */
        .userProfile-users-section {
            font-family: "Poppins", sans-serif;
            background-color: #FFF1EB;
        }

        /* Card container */
        .userProfile-user-card {
            border: none;
            border-radius: 10px;
            background-color: #fff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

            /* Add User Button */
            .userProfile-user-card .btn-orange {
                background-color: #FD670B;
                color: #fff;
                border: none;
                border-radius: 25px;
                font-weight: 500;
                padding: 6px 18px;
                transition: all 0.3s ease;
            }

                .userProfile-user-card .btn-orange:hover {
                    background-color: #E45D27;
                }

        /* Table styling */
        .userProfile-user-table-container {
            max-height: 400px;
            overflow-y: auto;
            scrollbar-width: none;
        }

            .userProfile-user-table-container::-webkit-scrollbar {
                display: none;
            }

        .userProfile-user-card table {
            width: 100%;
        }

        .userProfile-user-card th {
            font-weight: 600;
            color: #333;
            border-bottom: 2px solid #f0f0f0;
        }

        .userProfile-user-card td {
            vertical-align: middle;
            padding: 12px 10px;
            border-top: 1px solid #f5f5f5;
        }

        /* Avatar */
        .userProfile-user-card .avatar {
            background-color: #fde5d8;
            color: #E45D27;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Role badges */
        .role-admin {
            background-color: #f6e1ff;
            color: #6b22a6;
        }

        .role-manager {
            background-color: #dcecff;
            color: #0044cc;
        }

        .role-user {
            background-color: #f1f1f1;
            color: #555;
        }

        /* Status badges */
        .status-active {
            background-color: #e9f8ee;
            color: #198754;
        }

        .status-inactive {
            background-color: #f1f1f1;
            color: #666;
        }

        /* Dropdown icon */
        .userProfile-dropdown-toggle {
            cursor: pointer;
            font-size: 1.2rem;
            color: #666;
            transition: 0.2s ease;
        }

        .userProfile-dropdown-toggle:hover {
            color: #E45D27;
        }


        /* ----- Add User modal styles (reused for edit profile & change password) ----- */
        .userProfile-adduser-card,
        .userProfile-editprofile-card,
        .userProfile-changepass-card {
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.15);
            background: #fff;
            max-width: 640px;
        }

            .userProfile-adduser-card h5,
            .userProfile-editprofile-card h5,
            .userProfile-changepass-card h5 {
                color: #222;
            }

            .userProfile-adduser-card .btn-close,
            .userProfile-editprofile-card .btn-close,
            .userProfile-changepass-card .btn-close {
                filter: invert(0.5);
                opacity: 0.6;
                transition: opacity .2s ease;
            }

                .userProfile-adduser-card .btn-close:hover,
                .userProfile-editprofile-card .btn-close:hover,
                .userProfile-changepass-card .btn-close:hover {
                    opacity: 1;
                }

            .userProfile-adduser-card .form-control:focus,
            .userProfile-adduser-card .form-select:focus,
            .userProfile-editprofile-card .form-control:focus,
            .userProfile-editprofile-card .form-select:focus,
            .userProfile-changepass-card .form-control:focus {
                border-color: #fd670b !important;
                box-shadow: 0 0 0 0.25rem rgba(253,103,11,0.25) !important;
            }

            .userProfile-adduser-card .btn-orange,
            .userProfile-editprofile-card .btn-orange,
            .userProfile-changepass-card .btn-orange {
                background-color: #fd670b;
                color: #fff;
                border: none;
            }

                .userProfile-adduser-card .btn-orange:hover,
                .userProfile-editprofile-card .btn-orange:hover,
                .userProfile-changepass-card .btn-orange:hover {
                    background-color: #e55c0a;
                }

        .modal-backdrop.show {
            opacity: 0.3;
        }

        /* Responsive tweaks */
        @@media (max-width: 992px) {
            .userProfile .info-card {
                margin-bottom: 1rem;
            }

            .userProfile .header-buttons {
                flex-direction: row;
                gap: 0.5rem;
            }
        }

        /* ===================== BILLING SECTION STYLES ===================== */
        .bg-orange {
            background-color: #FD670B !important;
        }

        .btn-orange {
            background-color: #FD670B;
            color: #fff;
            border: none;
            border-radius: 25px;
            font-weight: 500;
            padding: 6px 18px;
            transition: all 0.3s ease;
        }

            .btn-orange:hover {
                background-color: #E45D27;
                color:#fff;
            }

        .billing-section .card {
            border: 1px solid #e1e1e1;
            border-radius: 10px;
        }

        .billing-section .section-title {
            font-weight: 600;
            font-size: 1rem;
        }

        .billing-section .small-text {
            color: gray;
            font-size: 0.9rem;
        }

        .billing-section .billing-table {
            max-height: 250px;
            overflow-y: auto;
        }

        .billing-section .table th,
        .billing-section .table td {
            vertical-align: middle;
            background: #FFF6F1;
        }

        .billing-section .status-paid {
            background-color: #d4edda;
            color: #155724;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }
    </style>
</head>

<body>
    <div class="userProfile">
        <!-- HEADER -->
        <div class="profile-header">
            <div class="profile-left">
                <img src="~/PayrollDashboard/assets/profile.png" alt="Profile" />
                <div class="profile-info">
                    <h4>
                        XYZ Corporation
                        <span class="admin-badge">Admin</span>
                    </h4>
                    <div class="info-list">
                        <div><i class="bi bi-envelope"></i> admin@acmecorp.com</div>
                        <div><i class="bi bi-telephone"></i> +91 (XXX) XXX-XXXX</div>
                        <div><i class="bi bi-geo-alt"></i> 123 Business Tower, Greater Noida, GBN, Uttar Pradesh 101001</div>
                        <div><i class="bi bi-calendar"></i> Client since January 15, 2024</div>
                    </div>
                </div>
            </div>

            <div class="header-buttons">
                <button class="btn-doc"><i class="bi bi-file-earmark-text"></i> One-Time Documents</button>
                <button class="btn-doc"><i class="bi bi-folder"></i> Entity Details</button>
            </div>
        </div>

        <!-- TOGGLE BUTTONS -->
        <div class="toggle-section px-4 mt-3">
            <div class="toggle-container">
                <button id="overviewBtn" class="active">Overview</button>
                <button id="usersBtn">Users</button>
                <button id="billingBtn">Billing</button>
            </div>
        </div>

        <!-- MAIN CONTENT (Dynamic Section) -->
        <div class="content-section container-fluid mt-3" id="mainContent">
            <!-- Default view: Overview -->
            <div id="overviewContent">
                <div class="row g-3">
                    <!-- LEFT CARD -->
                    <div class="col-lg-6">
                        <div class="info-card client-details">
                            <h5><i class="bi bi-person-lines-fill"></i> Client Details</h5>
                            <div class="detail-row">
                                <div>
                                    <label>Client ID</label>
                                    <span>CLI-2024-001</span>
                                </div>
                                <div>
                                    <label>Industry</label>
                                    <span>Financial Services</span>
                                </div>
                            </div>
                            <div class="detail-row">
                                <div>
                                    <label>Company Size</label>
                                    <span>500-1000 employees</span>
                                </div>
                                <div id="status">
                                    <label>Status</label>
                                    <span>Active</span>
                                </div>
                            </div>
                            <!-- Buttons: Edit Profile & Change Password -->
                            <div class="client-card-actions mt-5">
                                <button id="openEditProfile" class="btn-action fw-normal" type="button">
                                    <i class="bi bi-pencil-square" style="color:#fff"></i> Edit Profile
                                </button>

                                <button id="openChangePassword" class="btn-action fw-normal" type="button">
                                    <i class="bi bi-lock-fill" style="color:#fff"></i> Change Password
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT CARD -->
                    <div class="col-lg-6">
                        <div class="info-card services-enrolled">
                            <div class="service-header">
                                <h5><i class="bi bi-shield-check"></i> Product Subscribed</h5>
                            </div>
                            <small>4 active services</small>

                            <div class="service-list mt-3">
                                <div class="service-item">
                                    <div class="left">
                                        <strong>KYC Verification</strong>
                                        <small>Enrolled: Jan 15, 2024</small>
                                    </div>
                                    <span class="status">Active</span>
                                </div>
                                <div class="service-item">
                                    <div class="left">
                                        <strong>AML Monitoring</strong>
                                        <small>Enrolled: Jan 15, 2024</small>
                                    </div>
                                    <span class="status">Active</span>
                                </div>
                                <div class="service-item">
                                    <div class="left">
                                        <strong>Risk Assessment</strong>
                                        <small>Enrolled: Feb 1, 2024</small>
                                    </div>
                                    <span class="status">Active</span>
                                </div>
                                <div class="service-item">
                                    <div class="left">
                                        <strong>Document Verification</strong>
                                        <small>Enrolled: Jan 15, 2024</small>
                                    </div>
                                    <span class="status">Active</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========== EDIT PROFILE MODAL ========== -->
        <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content userProfile-editprofile-card p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">Edit Profile</h5>
                            <small class="text-muted">Update client profile information.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <form id="editProfileForm">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Name</label>
                                <input type="text" class="form-control" id="edit_name" value="XYZ Corporation" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Username</label>
                                <input type="text" class="form-control" id="edit_username" value="xyzcorp" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" class="form-control" id="edit_email" value="admin@acmecorp.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mobile No.</label>
                                <input type="text" class="form-control" id="edit_mobile" value="+91 (XXX) XXX-XXXX" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Address</label>
                                <textarea class="form-control" id="edit_address" rows="3">123 Business Tower, Greater Noida</textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Profile Photo</label>
                                <input type="file" class="form-control" id="edit_profile_photo" accept="image/*" />
                            </div>
                        </div>

                        <small class="text-muted d-block mt-2">Make sure to save changes to persist them.</small>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-orange px-4">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ========== CHANGE PASSWORD MODAL ========== -->
        <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content userProfile-changepass-card p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">Change Password</h5>
                            <small class="text-muted">Update your account password.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <form id="changePasswordForm">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Current Password</label>
                                <input type="password" class="form-control" id="cur_password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">New Password</label>
                                <input type="password" class="form-control" id="new_password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Confirm Password</label>
                                <input type="password" class="form-control" id="confirm_password" />
                            </div>
                        </div>

                        <small class="text-muted d-block mt-2">Choose a strong password and keep it secure.</small>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-orange px-4">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ADD USER MODAL -->
        <div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content userProfile-adduser-card p-4">
                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">Add New User</h5>
                            <small class="text-muted">Create a new user account and assign their role and permissions.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <!-- Form -->
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">First Name</label>
                                <input type="text" class="form-control" placeholder="John" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Last Name</label>
                                <input type="text" class="form-control" placeholder="Doe" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Email Address</label>
                                <input type="email" class="form-control" placeholder="john.doe@acmecorp.com" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Role</label>
                                <select class="form-select">
                                    <option>Select a role</option>
                                    <option>Admin</option>
                                    <option>Manager</option>
                                    <option>User</option>
                                </select>
                            </div>
                        </div>

                        <small class="text-muted d-block mt-2">This determines the user's access level and permissions.</small>

                        <!-- Footer Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-orange px-4">Add User</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Add Card Modal -->
        <div class="modal fade" id="addCardModal" tabindex="-1" aria-labelledby="addCardModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-orange text-white">
                        <h5 class="modal-title" id="addCardModalLabel">Add New Payment Card</h5>
                        <button type="button" class="btn-close bg-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Cardholder Name</label>
                                <input type="text" class="form-control" placeholder="John Doe">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Card Number</label>
                                <input type="text" class="form-control" placeholder="XXXX XXXX XXXX XXXX">
                            </div>
