= @{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Payroll Components Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/Dashboards/PayrollComponentsDash/script.js"></script>
<link href="~/Dashboards/PayrollComponentsDash/style.css" rel="stylesheet" />


<div class="payrollComponentsDashPage px-4 py-2">
    <!-- Top bar: instruction left + Generate button right -->
    <div class="d-flex align-items-center justify-content-between mb-3 top-bar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h4 style="color: var(--primary)">Payroll Components Dashboard</h4>
        </div>

        <div class="d-flex align-items-center gap-2"> 
            <!-- Generate (rounded pill) -->
            <button class="btn btn-sm btn-generate" id="btnGenereate" type="button" data-bs-toggle="modal" data-bs-target="#generateModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Generate</span>
            </button>
        </div>
    </div>
    

    <!-- VIEW CARD (default visible) -->
    <div class="card section-card">
        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Month
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">January</a></li>
                            <li><a class="dropdown-item" href="#">February</a></li>
                            <li><a class="dropdown-item" href="#">March</a></li>
                            <!-- ... -->
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Year
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">2025</a></li>
                            <li><a class="dropdown-item" href="#">2024</a></li>
                        </ul>
                    </div>

                    <button class="btn btn-sm filter-btn active">Go</button>
                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="estSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" style="border-color: #E45D27" id="estSearchBtn" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div>
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>
                                <li><a class="dropdown-item" href="#">Print</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 small-table" id="estTable">
                        <thead>
                            <tr>
                                <th>Sr.No</th>
                                <th>Month</th>
                                <th>Year</th>
                                <th>Category</th>
                                <th>State Count</th>
                                <th>Employee Count</th>
                                <th>Location Count</th>
                                <th>Generated On</th>
                                <th>Status</th>
                                <th>View</th>
                                <th>Master File</th>
                            </tr>
                        </thead>
                        <tbody id="estTableBody">
                            <tr>
                                <td>1</td>
                                <td>Jan</td>
                                <td>2025</td>
                                <td>Category1</td>
                                <td>27</td>
                                <td>97</td>
                                <td>47</td>
                                <td>01/01/2026</td>
                                <td><span class="badge status-active">Generated</span></td>
                                <td><button class="btn btn-sm view-btn">View</button></td>
                                <td><button class="btn btn-sm download-btn">Download</button></td>
                            </tr>
                            <tr>
                                <td>1</td>
                                <td>Jan</td>
                                <td>2025</td>
                                <td>Category1</td>
                                <td>27</td>
                                <td>97</td>
                                <td>47</td>
                                <td>01/01/2026</td>
                                <td><span class="badge status-active">Generated</span></td>
                                <td><button class="btn btn-sm view-btn">View</button></td>
                                <td><button class="btn btn-sm download-btn">Download</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="estPaginationWrap">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm" id="estPrev" type="button">Previous</button>
                        <button class="btn btn-sm" id="estNext" type="button">Next</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="estPageInfo" style="font-size:0.85rem;color:#555;"></div>
                        <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!--  Generate Modal -->
    <div class="modal fade"
         id="generateModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">Generate Payroll</h5>
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row g-3">

                            <!-- Payroll Type -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Payroll Type</label>
                                <select class="form-select form-select-sm">
                                    <option>Select</option>
                                    <option>Monthly</option>
                                    <option>Weekly</option>
                                </select>
                            </div>

                            <!-- Mode -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Mode</label>
                                <select class="form-select form-select-sm">
                                    <option>Select</option>
                                    <option>Auto</option>
                                    <option>Manual</option>
                                </select>
                            </div>

                            <!-- Location -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Location</label>
                                <select class="form-select form-select-sm">
                                    <option>Select Location</option>
                                    <option>Mumbai</option>
                                    <option>Delhi</option>
                                </select>
                            </div>

                            <!-- Month -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Month</label>
                                <select class="form-select form-select-sm">
                                    <option>Select</option>
                                    <option>January</option>
                                    <option>February</option>
                                </select>
                            </div>

                            <!-- Year -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Year</label>
                                <select class="form-select form-select-sm">
                                    <option>Select</option>
                                    <option>2025</option>
                                    <option>2026</option>
                                </select> 
                            </div>
                            
                            <!-- Active/Deactive Data -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Active/Deactive Data</label>
                                <input type="file" class="form-control form-control-sm">
                            </div>

                            <!-- Salary Sheet -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Salary Sheet</label>
                                <input type="file" class="form-control form-control-sm">
                            </div>

                            <!-- Financial Year -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Financial Year</label>
                                <select class="form-select form-select-sm">
                                    <option>Select</option>
                                    <option>2024-25</option>
                                    <option>2025-26</option>
                                </select>
                            </div>

                            <!-- Month (Second Section) -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Month</label>
                                <select class="form-select form-select-sm">
                                    <option>Select</option>
                                    <option>January</option>
                                    <option>February</option>
                                </select>
                            </div>

                            <!-- Upload Master Sheet -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Upload Master Sheet</label>
                                <input type="file" class="form-control form-control-sm">
                            </div>

                            <!-- Signature -->
                            <div class="col-lg-3 col-md-4 col-sm-6">
                                <label class="form-label">Signature</label>
                                <input type="file" class="form-control form-control-sm">
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-sm cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-sm save-btn">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>


</div>