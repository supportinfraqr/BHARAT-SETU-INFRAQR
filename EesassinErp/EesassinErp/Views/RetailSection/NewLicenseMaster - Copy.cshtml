                    <div class="d-flex justify-content-end mt-12" >
                        <button class="btn px-4" id="saveBtn" style="background:var(--primary); color:#fff;" ng-if="loginType=='5'"
                                ng-click="DeleteRecord(LMLicenceRequstId);ManageLog('Delete License, Licence Name : '+ LMLicenseNamee + ' &amp; Location  '+ LMStoreCode )">
                            Delete 
                        </button>
                        <div ng-show="LM_EditFlag==1">
                            <button class="btn px-4" id="saveBtn" style="background:var(--primary); color:#fff;"
                                    ng-click="LSave();ManageLog('Submit License Licence Name : '+ LMLicenseNamee + ' &amp; Location  '+ LMStoreCode )" ng-hide="LMLStatus==2||LMLStatus==4">
                                Save
                            </button>
                        </div>
                    </div>
                    </div>

            </div>
            o
        </div>
    </div>
</div>

