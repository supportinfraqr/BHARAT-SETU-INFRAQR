                                    <option value="NonRenew">Non Renew</option>
                                    <option value="Renew">Renew</option>

                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Renewal Copy</label>
                                <div class="lic-upload-field">
                                    <input id="LMUploadRenewedCopy" class="form-control form-control-sm" type="file" ng-model="LMUploadRenewedCopy" onchange="angular.element(this).scope().uploadFile('UploadRenewedCopy', this)" file-size-limit="20" />

                                    <div class="lic-upload-actions" ng-show="LMUploadRenewedCopy && LMUploadRenewedCopy.trim() !== ''">

                                        <a href="#" ng-Click="ViewFileC(LMUploadRenewedCopy)">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a ng-click="DownloadFileC(LMUploadRenewedCopy,'RenewalCopy_'+LMLicenseNamee);ManageLog('View Renewed Copy Licence Name : '+ LMLicenseName + ' & StoreName '+ LMStoreCode)">
                                            <i class="bi bi-download"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>




                    </div>
