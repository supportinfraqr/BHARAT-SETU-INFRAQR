
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Store Master";
    Layout = "~/Views/Common/_RetailLayout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript" src="https://unpkg.com/xlsx@0.15.1/dist/xlsx.full.min.js"></script>
<style>
    .column-content {
        column-width: 300px; /* Maximum column width */
        column-gap: 20px; /* Space between columns */
        word-wrap: break-word; /* Ensures long words break */
        white-space: normal; /* Enable text wrapping */
        word-wrap: break-word; /* Break long words */
        word-break: break-word;
    }

</style>
<style>

    .newslider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        -webkit-transition: .4s;
        transition: .4s;
    }

    .dataTables_filter, .dataTables_info {
        display: none;
    }

    .licencefrmhed {
        background-color: #f3e3ec;
        color: #fff;
        border-top-left-radius: 14px;
        border-top-right-radius: 14px;
        display: initial;
    }

        .licencefrmhed .btnarrow {
            color: #fff !important;
            font-size: 2rem;
            display: inline-block;
            margin-top: 11px;
        }

    .modal-header.licencefrmhed {
        border-bottom: 1px solid #f3e3ec !important;
    }
</style>

<script src="https://code.jquery.com/jquery-2.1.4.min.js"></script>
