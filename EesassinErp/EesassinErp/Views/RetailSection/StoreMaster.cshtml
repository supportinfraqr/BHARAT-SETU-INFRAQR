            <div class="modal-body p-0">
                <div class="row">
                    <div class="col-md-12">
                        <div class="table-responsive">
                            <table class="table table-hover text-center bgw">
                                <thead class="">
                                    <tr>
                                        <th>S.No.</th>
                                        <th>Applicable License</th>
                                        <th>Approval</th>
                                        <th>Upload Doc.</th>
                                        <th>Link</th>
                                        <th>View </th>
                                    </tr>
                                </thead>
                                <tbody>
                                 
                                    <tr ng-repeat="licenseMaster in LicenseMasterList">
                                        <td>{{ licenseMaster.SrNo }} </td>
                                        <td><a class="text-success" href="#" ng-click="ShowLicenseDetail( licenseMaster.LicenseName, licenseMaster.LicenseId,licenseMaster.StoreId)" data-bs-toggle="modal" data-bs-target="#LicenseFormop">{{ licenseMaster.LicenseName }}</a> </td>
                                        <td>
                                            <button class="btn btn-default bgr" ng-if="SMF_EditFlag==1" ng-disabled="licenseMaster.IsApproved == true" ng-click="ApproveLicenseMaster(licenseMaster.LicenseId);logmaintainwithstore('Approve '+  licenseMaster.LicenseName )">Approve</button>
                                        </td>
                                        <td>
                                            <button class="btn btn-default" ng-disabled="licenseMaster.Status == 1" ng-if="licenseMaster.IsApproved == true || licenseMaster.IsActive==false" ng-click="ShowStoreMasterDocForm(licenseMaster.Id,licenseMaster.LicenseId,licenseMaster.StoreId);PermissionForSection(licenseMaster.LicenseId);logmaintainwithstore('Click Here '+  licenseMaster.LicenseName )">Click Here</button>
                                        </td>
                                        @*<td>
                                            <button class="btn btn-default position-relative"
                                                    ng-disabled="licenseMaster.Status == 1"
                                                    ng-if="licenseMaster.IsApproved == true || licenseMaster.IsActive==false"
                                                    ng-click="generateAndCopyLink($event, licenseMaster)"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    title="Click to Copy">
                                                {{ licenseMaster.buttonText || 'Generate Link' }}
                                            </button>
                                        </td>*@
                                        <td>
                                            <button class="btn btn-default" id="{{licenseMaster.Id}}"
                                                    ng-disabled="licenseMaster.Status == 1"
                                                    ng-if="licenseMaster.IsApproved == true || licenseMaster.IsActive==false"
                                                    data-bs-toggle="tooltip"
                                                    data-bs-placement="top"
                                                    ng-click="generateAndCopyLink(licenseMaster)">

                                                {{ licenseMaster.buttonText == 1 ? 'Click To Copy' : 'Generate Link' }}
                                            </button>
                                        </td>
                                        <td><a href="#" ng-if="licenseMaster.Status == 1 && SMF_ViewFlag==1" ng-click="ShowStoreMasterDocForm(licenseMaster.Id,licenseMaster.LicenseId,licenseMaster.StoreId);PermissionForSection(licenseMaster.LicenseId)" class="text-dark"><i class="fa fa-eye"></i></a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
