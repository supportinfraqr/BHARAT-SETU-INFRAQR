<script>


    $(document).ready(function () {

        // Attach a click event listener to the buttons
        $('.dt-buttons').on('click', function () {
            debugger;
            // Identify which button was clicked
            const clickedButton = $(this).text().trim(); // Get the text of the button
            alert('Button clicked: ${clickedButton}');

            // Perform specific actions based on the button clicked
            if ($(this).hasClass('buttons-csv')) {
                alert('CSV export button clicked!');
                // Add your CSV export logic here
            } else if ($(this).hasClass('buttons-pdf')) {
                alert('PDF export button clicked!');
                // Add your PDF export logic here
            } else if ($(this).hasClass('buttons-print')) {
                alert('Print button clicked!');
                // Add your print logic here
            }
        });
    });
</script>


<div class="pagecontentbody themed-element" ng-show="StoreMasterGrid" ng-init="Limit()">
    <div class="pagebody">
        <div class="col-md-12 pageheader">
            <div class="row">
                <div class="col-md-9">
                  
                    <div class="col-sm-4 text-end" ng-if="SM_NewStoreFlag==1">
                        <a class="btn btn-warning" href="#"><span class="fas fa-asterisk"></span>&nbsp;&nbsp Location Limit Left :  {{LeftStore}}</a>
                    </div>
                    <h4 class="mb-0"></h4>
                </div>

                <div class="col-sm-3 text-end" ng-if="SM_NewStoreFlag==1">
                    <a class="btn btn-warning" href="#" ng-click="reset(); ShowDivStoreMasterForm();ManageLog('Open New Location')"><span class="fas fa-plus"></span>&nbsp;&nbsp;New Location</a>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="row mb-3 p-3">
                <div class="card p-0">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-10">
                                <ul class="nav nav-tabs" id="myTab" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab" aria-controls="tab1" aria-selected="true">View</button>
                                    </li>
                                    <li ng-if="SCS_DeleteFlag==1" class="nav-item" role="presentation">
                                        <button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2"   type="button" role="tab" aria-controls="tab2" aria-selected="false">Import</button>
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-2 text-end">
                                <a href="#" class="btn btn-primary expbtn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" style="margin-top: 2px;">Export</a>
                                <ul class="dropdown-menu escalul" aria-labelledby="escalbtnLink">
                                    <li><a ng-click="ExportExcel();ManageLog('Export in Excel')" class="dropdown-item">Export in Excel</a></li>

                                    <li><a class="dropdown-item" ng-click="ExportPdf();ManageLog('Export in PDF')">Export in PDF</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="myTabContent">
                            <div class="tab-pane fade show active" id="tab1" role="tabpanel" aria-labelledby="tab1-tab">
                                <div class="row mb-3 align-items-center">
                                    <div class="col-md-6 mt-3">
                                        <ul class="filter-search">
                                            <li class="p-0">
                                                <div class="input-group">
                                                    <input class="form-control" type="text" id="myInput" value="" ng-keyup="GetStoreMaster(1,10)" placeholder="Search">
                                                    <button class="btn btn-default" type="button" id="button-addon2">
                                                        <span class="icons icon-magnifier"></span>
                                                    </button>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                   
                                </div>
                                <div class="nosearch themed-element">
                                    <table id="example" style="width:100% !important" class="display nowrap table table-bordred table-hover tableFixHead unittbl datatable themed-element">
                             
                                    </table>
                                </div>
                              
                            </div>
                            <div class="tab-pane fade" id="tab2" role="tabpanel" aria-labelledby="tab2-tab">
                                <div class="py-5 mt-3 text-center">

                                    <a class="btn btn-warning btn-lg" ng-click="ManageLog('Download Store Sample Sheet')" href="~/DownloadMat/StoreMasterSampleSheet.xlsx" download><span class="fas fa-download"></span>&nbsp;&nbsp;Download Store Sample Sheet</a>
                                </div>
                                <div class="py-5 mt-3 text-center">
                                    <div class="input-box">
                                        <input type="file" id="input-excel" onchange="angular.element(document).scope().DisplayExcel(), angular.element(document).scope().setFile(this);" />
                                        <div class="text-box-msg-r">
                                        </div>
                                    </div>
                                    <div class="input-box">
                                        <button id="btnValiadte" type="button" class="btn2 btn-common btn-3 btn-3d pe-7s-check" ng-click="SaveRecord();ManageLog('Bulk Save Store Record')">
                                            Save Record
                                        </button>
                                    </div>
                                    <div class="input-box" id="wrapper">

                                    </div>
                                </div>

                                <div class="dropbg" ng-if="SCS_DeleteFlag==1">
                                    <form method="post" action="/upload">
                                        <div class="row">
                                            <div class="col-md-5 text-center">
                                                <img src="~/compliance/images/dropf.png" />
                                            </div>
                                            <div class="col-md-7">
                                                <h4 class="mt-5">Choose a Select [.csv] files</h4>
                                                <p>
                                                    click   to select thorough your machine Accepted files type:.csv
                                                </p>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="pagecontentbody themed-element" ng-show="StoreMasterForm">
    <div class="pagebody">
        <div class="col-md-12 pageheader">
            <div class="row">
                <div class="col-md-9">
                    <h4 class="mb-0"></h4>
                </div>
                <div ng-click="getbackfromedit();ManageLog('Go Back from Store Master')" class="col-sm-3 text-end">
                    <div class="btn btn-primary">Go Back</div>
                    @*<a href="../RetailSection/StoreMaster?Store Master" class="btn btn-primary">Go Back</a>*@
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="row mb-3 p-3">
                <div class="card p-0">
                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-md-3">
                                <label class="form-label">Location Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtStoreCode" ng-model="StoreCode" ng-change="validate()" disabled />
                                <span class="text-danger" ng-show="showValidationError">Special characters are not allowed.</span>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Ref. Location Code  </label>
                                <input type="text" class="form-control" id="txtRefStoreCode" ng-model="RefStoreCode" maxlength="10" />
                                <span class="text-danger" ng-show="showValidationError">Special characters are not allowed.</span>
                            </div>
                            <div class="col-md-3">
                                <label class="control-label">Compliance Category<span class="vd_red">*</span></label>
                                <div class="input-box">
                                    <select id="ddlComplianceCategory" class="select2 form-control validate" ng-model="ComplianceCategory">
                                        <option value="">Select Compliance</option>
                                        <option value="Factory">Factory</option>
                                        <option value="Establishment">Establishment</option>
                                        <option value="Contractor">Contractor</option>
                                    </select>
                                    <div class="text-box-msg-r">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3" ng-init="CategoryList = [{ID: 1, Name: 'Store'}, {ID: 2, Name: 'Warehouse'}, {ID: 3, Name: 'Factory'}]">
                                <label class="control-label">Category<span class="vd_red">*</span></label>
                                <div class="input-box">
                                    <select id="ddlCategory" class="select2 form-control validate" ng-model="Category">
                                        <option value="">Select Category</option>
                                        <option ng-repeat="x in CategoryList" value="{{x.ID}}">{{x.Name}}</option>
                                    </select>
                                    <div class="text-box-msg-r">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="control-label">Operation model<span class="vd_red">*</span></label>
                                <div class="input-box">
                                    <select id="ddlComplianceCategory" class="select2 form-control validate" ng-model="Operationmodel">
                                        <option value="">Select Compliance</option>
                                        <option value="COCO">COCO–Company Owned Company Operated</option>
                                        <option value="FOCO">FOCO–Franchise Owned Company Operated</option>
                                        <option value="FICO">FICO–Franchise Invested Company Operated</option>
                                        <option value="COFO">COFO–Company Owned Franchise Operated</option>
                                        <option value="FOFO">FOFO–Franchise Owned Franchise Operated</option>
                                    </select>
                                    <div class="text-box-msg-r">
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Location Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control validate" id="txtStoreName" ng-model="StoreName" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Complete Address <span class="text-danger">*</span></label>
                                <input type="text" class="form-control validate" id="txtCompleteAddress" ng-model="CompleteAddress" />
                            </div>
                            <div class="col-md-3">
                                <label class="control-label">Proposed/Existing <span class="text-danger">*</span></label>
                                <div class="input-box">
                                    <input id="txtProposedDate" type="date" class="form-control clear validate" ng-model="StartDate" />

                                    <div class="text-box-msg-r">
                                    </div>
                                </div>

                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Location <span class="text-danger">*</span></label>
                                <input type="text" class="form-control validate" id="txtStoreLocation" ng-model="StoreLocation" />
                            </div>
                            @*<div class="col-md-3">
                                <label class="form-label"> Execution Level 1</label>
                                <input type="text" class="form-control" id="txtExecutionLevel1" ng-model="ExecutionLevel1" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label"> Execution Level 2</label>
                                <input type="text" class="form-control" id="txtExecutionLevel2" ng-model="ExecutionLevel2" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label"> Execution Level 3</label>
                                <input type="text" class="form-control" id="txtExecutionLevel3" ng-model="ExecutionLevel3" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label"> Execution Level 4</label>
                                <input type="text" class="form-control" id="txtExecutionLevel4" ng-model="ExecutionLevel4" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Execution Level 5</label>
                                <input type="text" class="form-control" id="txtExecutionLevel5" ng-model="ExecutionLevel5" />
