@{
    ViewBag.Title = "OverView Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/ckeditor/ckeditor.js"></script>
<script src="~/Content/ckfinder/ckfinder.js"></script>
<script src="~/Scripts/RetailJsLib/DeclarationController.js?Ver=@ViewBag.Version"></script>
 
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<input type="hidden" id="Id1" name="Id1" value="" ng-model="hfId1" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Declaration Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Retail</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Declaration Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">

                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-init="AllParty()">

                                            <label class="control-label">Select Party<span class="vd_red">*</span></label>

                                            <div class="input-box">
                                                <select id="ddlPartyId" autocomplete='address-level2' class="select2 form-control validate" ng-model="PartyId">
                                                    <option value="">Select Party</option>
                                                    <option ng-repeat="x in AllPartyList" value="{{x.PartyId}}">{{x.PartyName}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15" ng-init="AllParty()">

                                            <label class="control-label">Select Type<span class="vd_red">*</span></label>

                                            <div class="input-box">
                                                <select id="ddlPartyId" autocomplete='address-level2' class="select2 form-control validate" ng-model="DeclarationType">
                                                    <option value="">Select Declaration Type</option>
                                                    <option value="Indemnity Clause">Indemnity Clause</option>
                                                    <option value="Confidentiality Agreement">Confidentiality Agreement</option>
                                                    <option value="Code of Conduct">Code of Conduct</option>
                                                    <option value="AML Declaration">AML Declaration</option>
                                                    <option value="Anti-Bribery">Anti-Bribery</option> 
                                                    <option value="DPDP Declaration">DPDP Declaration</option>

                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Declaration </label>
                                            <div class="input-box">
                                                @Html.TextArea("txtHeaderTemplate", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "HeaderTemplate", @name = "txtHeaderTemplate", @id = "txtHeaderTemplate", @rows = "10", @cols = "80" })
                                                <script>$(document).ready(function () { CKEDITOR.replace('txtHeaderTemplate'); });</script>

                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>
