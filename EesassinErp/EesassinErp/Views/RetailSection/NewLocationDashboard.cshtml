            <h6 class="mb-0">Select Columns</h6>

            <button type="button"
                    class="btn-close"
                    ng-click="showColumnPopup=false"
                    aria-label="Close">
            </button>
        </div>

        <!-- Column List -->
        <div class="popup-body">
            <div>
                <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 0.85rem;">
                    <input type="checkbox"
                           ng-model="selectAll"
                           ng-change="toggleAllColumns()">
                    <span>Select All</span>
                </label>
            </div>
            <div class="column-item" ng-repeat="col in tblheader">
                <label>
                    <input type="checkbox"
                           ng-checked="col.ShowColumn=='Yes'"
                           ng-click="col.ShowColumn = (col.ShowColumn=='Yes' ? 'No' : 'Yes')">

                    <span>{{col.HeaderText}}</span>
                </label>
            </div>

        </div>



    </div>
</div>
