            background: transparent;
            padding: 6px 12px;
            font-size: 0.8rem;
        }

            .payrollCompPage .btn1:hover {
                background: var(--primary);
                color: #fff;
            }

        .payrollCompPage .btn2 {
            border-radius: 999px;
            color: #fff;
            padding: 6px 12px;
            font-size: 0.8rem;
            background: var(--primary);
            border: none;
        }

            .payrollCompPage .btn2:hover {
                background: var(--primary-dark);
                color: #fff;
            }

