        .payrollCompPage table thead th {
            background-color: var(--primary);
            color: #fff;
            font-weight: 600;
            font-size: 0.82rem;
            white-space: nowrap;
        }

        .payrollCompPage table tbody td {
            background-color: var(--card-bg);
            font-size: 0.82rem;
            white-space: nowrap;
        }

        .payrollCompPage table tbody tr:hover td {
            background-color: #FFE8D9;
        }

        /*Improve Form Controls*/
