    // Download file simulation or actual CSV
    function downloadFinalFile(type) {
        if (type === "csv") {
            // ✅ CSV Download (same as before)
            const rows = document.querySelectorAll("#finalCsvTable tr");
            let csv = [];

            rows.forEach(row => {
                const cols = Array.from(row.querySelectorAll("th, td"))
                    .map(cell => `"${cell.innerText.replace(/"/g, '""')}"`);
                csv.push(cols.join(","));
            });

            const csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            const downloadLink = document.createElement("a");
            downloadLink.download = "Final_EPF_Report.csv";
            downloadLink.href = URL.createObjectURL(csvFile);
            downloadLink.click();
        }

        else if (type === "txt") {
            // ✅ TXT Download (Dynamic from AngularJS scope)
            const scope = angular.element(document.getElementById("finalFileContainer")).scope();
            const data = scope.ValidationStageThree || [];

            // 🔹 Header row
            let txtContent = `UAN | Member Name | Gross Wages | EPF Wages | EPS Wages | EDLI Wages | EPF (12%) | EPS (8.33%) | Diff (3.67%) | NCP | Refund\n`;

            // 🔹 Data rows dynamically generated
            data.forEach(x => {
                txtContent += `${x.UAN} | ${x.MemberName} | ${x.GrossWages} | ${x.EPFWages} | ${x.EPSWages} | ${x.EDLIWages} | ${x.EPFEmployee12} | ${x.EPSEmployer833} | ${x.EPF_EPSDiff367} | ${x.NCP} | ${x.RefundOfAdvances}\n`;
            });

            // 🔹 Create and download TXT file
            const txtFile = new Blob([txtContent.trim()], { type: "text/plain" });
            const downloadLink = document.createElement("a");
            downloadLink.download = "Final_EPF_Report.txt";
            downloadLink.href = URL.createObjectURL(txtFile);
            downloadLink.click();
        }
    }


