    function scrollToElement(id) {
        const el = document.getElementById(id);
        if (el) {
            window.scrollTo({
                top: el.offsetTop - 20,
                behavior: "smooth"
            });
        }
    }

    // =============================
    // STEP NAVIGATION
    // =============================
    function showStep1() {
        document.getElementById('step1').classList.remove('d-none');
        scrollToElement('step1');
    }

    function showSalaryStep() {
        document.getElementById('salaryStep').classList.remove('d-none');
        scrollToElement('salaryStep');
    }


    document.getElementById("downloadActiveTemplateBtn").addEventListener("click", () => {

        const link = document.createElement('a');
