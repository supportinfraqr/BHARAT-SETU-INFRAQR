    // Open Fix modal – only show relevant field(s)
    function openFixModal(button, category, errorCol) {
        selectedRow = button.closest("tr");
        const columns = sheetColumns[category] || [];
        let fieldsHTML = "";

        columns.forEach(col => {
            const isErrorField = col === errorCol;
            fieldsHTML += `
          <div class="col-md-6 mb-3">
            <label class="form-label">${col}</label>
            <input type="text" class="form-control" name="${col}" placeholder="Enter ${col}" ${isErrorField ? "required" : ""}>
          </div>`;
        });

        document.getElementById("fixModalFields").innerHTML = fieldsHTML;
        document.getElementById("fixModal").setAttribute("data-category", category);
        document.getElementById("fixModal").setAttribute("data-errorcol", errorCol);

        new bootstrap.Modal(document.getElementById("fixModal")).show();
    }

    // Submit fix — only check required field
    function submitFix() {
        if (!selectedRow) return;

        const form = document.getElementById("fixModalForm");
        const requiredInputs = form.querySelectorAll("input[required]");
        const isFilled = Array.from(requiredInputs).every(inp => inp.value.trim() !== "");

        if (!isFilled) return alert("Please fill the highlighted error field before fixing.");

        const category = document.getElementById("fixModal").getAttribute("data-category");
        const errorCol = document.getElementById("fixModal").getAttribute("data-errorcol");

        // Remove fixed row
        selectedRow.remove();
        selectedRow = null;

        // Close fix modal
        bootstrap.Modal.getInstance(document.getElementById("fixModal")).hide();

        // If no errors left → mark category as fixed
        const tbody = document.querySelector("#errorModalContent tbody");
        if (tbody.querySelectorAll("tr").length === 0) {
            categoryStatus[category] = true;
            categorizedErrors[category] = [];
            updateCategoryStatus(category);
        }

        checkAllCategoriesFixed();
    }

