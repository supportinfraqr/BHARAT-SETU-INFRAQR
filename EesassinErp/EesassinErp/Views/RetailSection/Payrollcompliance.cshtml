        const rows = document.querySelectorAll("#validationFailed tbody tr");
        rows.forEach(row => {
            const label = row.cells[1].innerText.trim();
            if (label.includes(category)) {
                row.cells[0].innerHTML = categoryStatus[category]
                    ? `<span class="text-success fw-bold">✅</span>`
                    : `<span class="text-danger fw-bold">❌</span>`;
            }
        });
    }

