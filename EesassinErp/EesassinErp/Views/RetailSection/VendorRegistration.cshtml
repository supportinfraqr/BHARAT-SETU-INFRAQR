<script>
    let currentStep = 1;
    const totalSteps = 9;

    /* STEP SWITCH */
    const stepIndicators = document.querySelectorAll(".step-item");

    function showStep(step) {

        document.querySelectorAll(".form-step").forEach(s => s.style.display = "none");
        document.querySelector(`[data-step="${step}"]`).style.display = "block";

        stepIndicators.forEach((el, index) => {
            el.classList.remove("active", "completed");

            if (index + 1 < step) {
                el.classList.add("completed");
            }
            else if (index + 1 === step) {
                el.classList.add("active");
            }
        });

        document.querySelector(".prev-btn").classList.toggle("d-none", step === 1);
    }

    document.addEventListener("click", function (e) {

        if (e.target.classList.contains("next-btn")) {
            if (currentStep < totalSteps) {
                currentStep++;
                showStep(currentStep);
            }
        }

        if (e.target.classList.contains("prev-btn")) {
            if (currentStep > 1) {
                currentStep--;
                showStep(currentStep);
            }
        }

    });

    /* MULTI SELECT */
    const display = document.getElementById("multiDisplay");
    const dropdown = document.getElementById("multiDropdown");

    display.addEventListener("click", () => {
        dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
    });

    dropdown.addEventListener("change", () => {
        const checks = dropdown.querySelectorAll("input[type=checkbox]");
        const selected = [];

        checks.forEach(c => {
            if (c.checked && c.value !== "all") {
                selected.push(c.value);
            }
        });

        display.value = selected.join(", ");
    });

    /* CLOSE ON OUTSIDE CLICK */
    document.addEventListener("click", function (e) {
        if (!e.target.closest(".multi-select")) {
            dropdown.style.display = "none";
        }
    });

    showStep(currentStep);
</script>
<script>

