<div class="modal fade" id="reportNotice" tabindex="-1" aria-labelledby="reportNoticeModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content notiModal1">
            <div class="modal-header" ng-click="BindNoticeStoreList()">
                <h5 class="modal-title" id="reportNoticeModalLabel">Report Notice</h5>
                <button @*id="closeId"*@ type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3" ng-init="BindNoticeStoreList()">

                            <label class="mb-3">Location Code</label>
                            <select class="form-control form-select" ng-model="NStoreId" ng-change="BindNoticeDepartment(NStoreId)">
                                <option value="">Select</option>
                                <option ng-repeat="x in NoticeStoreList | unique:'StoreId'" value="{{x.StoreId}}">{{x.StoreCode}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Department</label>
                            <select class="form-control form-select validate" ng-model="DepartmentId" ng-change="BindNoticeStoreStatus(DepartmentId)">
                                <option value="">Select</option>
                                <option ng-repeat="x in NoticeDepartmentList" value="{{x.DepartmentId}}">{{x.DepartmentName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6" ng-if="DocStage !='-1'">
                        <div class="form-group mb-3">
                            <label class="mb-3">Document Stage</label>
                            <input type="text" class="form-control" readonly ng-model="DocStage" />

                        </div>
                    </div>
                    <div class="col-md-6" ng-if="DocStatus=='open'">
                        <div class="form-group mb-3">
                            <label class="mb-3">Upload</label>
                            <input type="file" class="form-control" id="fNoticeUpload" onchange="angular.element(this).scope().BindNoticeUpload(this, '#AlbumIcon')" ng-model="NoticeUpload">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Date Of Notice</label>
                            <input id="txtNoticeDate" type="date" class="form-control" ng-model="NoticeDate" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Mode Of Notice</label>
                            <select class="form-control form-select" ng-model="NoticeMode">
                                <option value="">Select</option>
                                <option value="Email">Email</option>
                                <option value="Online">Online</option>
                                <option value="Physical">Physical</option>
                                <option value="SpeedPost">SpeedPost</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Date Of Hearing</label>
                            <input id="txtHearingDate" type="date" class="form-control" ng-model="HearingDate" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Officer Name</label>
                            <input id="txtOfficerName" type="text" class="form-control" ng-model="OfficerName" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Department Address</label>
                            <input id="txtAddress" type="text" class="form-control" ng-model="Address" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Representative Name</label>
                            <input id="txtRepresentativeName" type="text" class="form-control" ng-model="RepresentativeName" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Representative Email</label>
                            <input id="txtRepresentativeEmail" type="text" class="form-control" ng-model="RepresentativeEmail" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Description</label>
                            <input id="txtDescription" type="text" class="form-control" ng-model="Description" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Probability</label>
                            <select id="txtProbability" class="select2 form-control" ng-model="Probability">
                                <option value="">Select</option>
                                <option value="High">High</option>
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                            </select>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Interest</label>
                            <input id="txtInterest" type="text" class="form-control" ng-model="Interest" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">LateFee</label>
                            <input id="txtLateFee" type="text" class="form-control" ng-model="LateFee" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Fines</label>
                            <input id="txtFines" type="text" class="form-control" ng-model="Fines" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Penalities</label>
                            <input id="txtPenalities" type="text" class="form-control" ng-model="Penalities" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="mb-3">Other</label>
                            <input id="txtOther" type="text" class="form-control" ng-model="Other" />
                        </div>
                    </div>







                    <div class="row justify-content-center postion-reletive mt-3 mb-1" ng-if="DocStatus=='open'">
                        <div class="col-md-10 d-grid">
                            <div class="btn btn-warning" ng-click="SaveRecord();ManageLog('Click on Save Record in Report Notice ')">Submit</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


