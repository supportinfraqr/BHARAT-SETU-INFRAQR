<style>
    .pagecontentbody {
        font-family: "Inter", sans-serif;
        --primary: #E45D27; /* theme accent */
        --primary-dark: #c44b1d;
        --card-bg: #FEF3EC;
        background: #FFF1EB;
        color: #223;
    }

    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        max-height: 240px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .btn-reportNotice, .uploadbtn, .btn-viewAll {
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 999px;
        padding: 6px 12px;
        font-weight: 400;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor:pointer;
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }

    .card {
        background: var(--card-bg);
        padding: 10px;
        border-radius: 12px;
        border: none;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    }

    .card-body{
        padding:0px !important;
    }

    th{
        background: var(--primary);
    }

    td{
        background: var(--card-bg);
    }

    label{
        color:var(--primary);

    }

    .filter-search {
        list-style: none;
        margin: 9px !important;
        padding: 0px !important;
    }
</style>
<script>
    $(document).ready(function () {
        $('#myDropdown').select2({
            placeholder: "Select an option",
            allowClear: true
        });
        $('#myDropdown').on('change', function () {
            angular.element(this).triggerHandler('change');
        });
    });
</script>
<style>
    /* width */
    ::-webkit-scrollbar {
        width: 5px;
    }

    /* Track */
    ::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    /* Handle */
    ::-webkit-scrollbar-thumb {
        background: #888;
    }

        /* Handle on hover */
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    .form-select {
        line-height: 1.0 !important;
    }
</style>

<style>
    .select2-selection__choice {
        float: none !important;
        display: inline-block !important;
    }
</style>

