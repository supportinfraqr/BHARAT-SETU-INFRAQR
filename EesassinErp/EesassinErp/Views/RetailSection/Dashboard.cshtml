                        <div class="table-responsive nosearch" style="max-height: 560px;">
                            <table id="noticesinspections" class="table table-bordred tableFixHead datatable">
                                <thead class="nocolor">
                                    <tr class="noborder">
                                        <th></th>
                                        <th class="text-center">Department</th>
                                        <th class="text-center">Location Code</th>
                                        <th class="text-center">Submitions</th>
                                        <th></th>
                                        <th class="text-center">Closer Status</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <tr class="noborder" ng-repeat="x in NoticeClientList">
                                        <td style="background: #FEF3EC" class="text-center"><a class="submiteds"><i class="fas fa-book-reader"></i></a></td>
                                        <td style="background: #FEF3EC" class="text-center">
                                            <b>{{x.DepartmentName}} </b><br />
                                            <a href="{{x.NoticeUpload}}" ng-click="ManageLog('Dashboard in Notice Download')" download><small>Notice &nbsp;<i class="fas fa-download"></i></small></a>
                                            <p>{{x.ReceiptDate}}</p>
                                        </td>
                                        <td style="background: #FEF3EC" class="text-center"><b><i class="fas fa-store-alt"></i>&nbsp;{{x.StoreCode}}</b></td>
                                        <td style="background: #FEF3EC" class="text-center">
                                            <b>Reply Status</b><br />
                                            <a href="{{x.ExecuterNoticeUpload}}" ng-if="x.NUStatus=='1'" ng-click="ManageLog('Dashboard in Notice Submitted')" download>
                                                <small>Submitted &nbsp;<i class="fas fa-download"></i></small>
                                                <p>{{x.ExecuterReceiptDate}}</p>
                                            </a>
                                            <small ng-if="x.NUStatus=='0'">Pending</small>
                                        </td>
                                        <td style="background: #FEF3EC" class="text-center">
                                            <b>{{x.Percentage}}% done </b>
                                            <br />
                                            <progress id="file" class="hundredper" value="{{x.Percentage}}" max="100"></progress>
                                        </td>
                                        <td style="background: #FEF3EC" class="text-center">
                                            <b>Final Status</b><br />
                                            <a ng-if="x.FinalSubmittionbyExecuter !='-1'" href="{{x.FinalSubmittionbyExecuter}}" ng-click="ManageLog('Dashboard in Notice Closed')" download>
                                                <small>Closed &nbsp;<i class="fas fa-download"></i></small>
                                                <p>{{x.FinalReceiptDate}}</p>
                                            </a>

                                            <small ng-if="x.FinalSubmittionbyExecuter=='-1'">Pending </small>
                                        </td>
                                    </tr>
                                    <tr ng-if="NoticeClientList.Length<0">
                                        <td style="background: #FEF3EC" colspan="5" style="text-align:center">No Record Found</td>
                                    </tr>

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

