        document.querySelectorAll("#esicFinalCategoryTableContainer tbody tr").forEach(r => {
            if (r.cells[1].innerText.trim() === category) {
                r.cells[0].innerHTML = esicCategoryStatus[category]
                    ? `<span class="text-success fw-bold">✅</span>`
                    : `<span class="text-danger fw-bold">❌</span>`;
            }
        });
    }


    /*  Unlock Proceed When All Fixed */
    function checkAllESICCategoriesFixed() {

        //  FIX: Directly check status map instead of error object
        const allFixed = Object.values(esicCategoryStatus).every(v => v === true);

        // Ensure parent step container is visible
        const stepContainer = document.getElementById("esicFinalValidationStep");
        if (stepContainer.classList.contains("d-none")) {
            stepContainer.classList.remove("d-none");
        }

        //  Toggle UI correctly
        document.getElementById("esicErrorWarning").classList.toggle("d-none", allFixed);
        document.getElementById("proceedESICFinishBtn").classList.toggle("d-none", !allFixed);
    }

    /*  Call This When STEP 5 Loads */
    function showESICFinalValidationStep() {

        // Show Step 5
        document.getElementById("esicFinalValidationStep").classList.remove("d-none");

        populateESICCategories();

        document.getElementById("esicFinalValidationStep").scrollIntoView({
            behavior: "smooth"
        });
    }

    /*  Show ESIC Step 6 */
   
    //  DEMO DATA (Replace later with backend/API)
    const esicFinalData = [
        { empCode: "EMP001", ip: "IP1001", name: "Rahul Sharma", gross: 18000 },
        { empCode: "EMP002", ip: "IP1002", name: "Neha Verma", gross: 22000 },
        { empCode: "EMP003", ip: "IP1003", name: "Amit Singh", gross: 25000 },
        { empCode: "EMP004", ip: "IP1004", name: "Pooja Mehta", gross: 30000 }
    ];


    /* SHOW STEP 6 + LOAD SUMMARY */
    function showESICStep6() {

        const tbody = document.getElementById("esicSummaryBody");
        tbody.innerHTML = "";

        let totalGross = 0;
        let totalEmpShare = 0;
        let totalEmprShare = 0;

        esicFinalData.forEach((x, index) => {

            const empShare = x.gross * 0.0075;   // 0.75%
            const emprShare = x.gross * 0.0325; // 3.25%
            const total = empShare + emprShare;

            totalGross += x.gross;
            totalEmpShare += empShare;
            totalEmprShare += emprShare;

            const tr = document.createElement("tr");

            tr.innerHTML = `
            <td style="border:1px solid #ccc; padding:6px; text-align:center;">${index + 1}</td>
            <td style="border:1px solid #ccc; padding:6px; text-align:center;">${x.empCode}</td>
            <td style="border:1px solid #ccc; padding:6px; text-align:center;">${x.ip}</td>
            <td style="border:1px solid #ccc; padding:6px;">${x.name}</td>
            <td style="border:1px solid #ccc; padding:6px; text-align:right;">${x.gross.toLocaleString("en-IN")}</td>
            <td style="border:1px solid #ccc; padding:6px; text-align:right;">${empShare.toLocaleString("en-IN", { maximumFractionDigits: 2 })}</td>
            <td style="border:1px solid #ccc; padding:6px; text-align:right;">${emprShare.toLocaleString("en-IN", { maximumFractionDigits: 2 })}</td>
            <td style="border:1px solid #ccc; padding:6px; text-align:right;">${total.toLocaleString("en-IN", { maximumFractionDigits: 2 })}</td>
        `;

            tbody.appendChild(tr);
        });

        const grandTotal = totalEmpShare + totalEmprShare;

        //  APPLY TOTALS INTO FOOTER
        document.getElementById("gtGross").innerText =
            totalGross.toLocaleString("en-IN", { maximumFractionDigits: 2 });

        document.getElementById("gtEmployee").innerText =
            totalEmpShare.toLocaleString("en-IN", { maximumFractionDigits: 2 });

        document.getElementById("gtEmployer").innerText =
            totalEmprShare.toLocaleString("en-IN", { maximumFractionDigits: 2 });

        document.getElementById("gtTotal").innerText =
            grandTotal.toLocaleString("en-IN", { maximumFractionDigits: 2 });

        document.getElementById("gtEmployees").innerText = esicFinalData.length;
        document.getElementById("esicEmployeeCount").innerText = esicFinalData.length;

        //  SHOW SUMMARY BLOCK
        document.getElementById("esicFinalSummary").classList.remove("d-none");

        //  SHOW STEP 6
        document.getElementById("esicStep6").classList.remove("d-none");

        document.getElementById("esicStep6").scrollIntoView({
            behavior: "smooth"
        });
    }

</script>
