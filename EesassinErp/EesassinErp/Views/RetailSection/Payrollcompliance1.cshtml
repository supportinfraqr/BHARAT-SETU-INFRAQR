@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Combined Report";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/scripts/RetailJsLib/CombinedReportController.js"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

<div class="container my-4 py-4" style="background-color: #FFF1EB; max-width: 100% ;">

    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="PF or ESIC">
            <button type="button" class="btn btn-pill active" data-target="#PFCard" aria-pressed="true">PF</button>
            <button type="button" class="btn btn-pill" data-target="#ESICCard" aria-pressed="false">ESIC</button>
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">
        <div id="PFCard" class="card section-card active">
            <h2 class="mb-4">Payroll Compliance </h2>
            <!-- STEP 1: Payroll Setup + Period + Uploads -->
            <div class="card mb-4" id="step1">
                <div class="card-header text-white">
                    Payroll Setup & Period
                </div>

                <div class="card-body">
                    <form class="row g-3">
                        <!-- Payroll Type -->
                        <div class="col-md-3">
                            <label class="form-label">Payroll Type</label>
                            <select class="form-control form-select validate" id="payrollType" ng-model="PayRollType" ng-disabled="Disableplease">
                                <option value="">Select</option>
                                <option value="Main">Main</option>
                                <option value="Supplementary">Supplementary</option>
                            </select>
                        </div>

                        <!-- Mode -->
                        <div class="col-md-3">
                            <label class="form-label">Mode</label>
                            <select class="form-control form-select validate" id="mode" ng-model="Mode" ng-disabled="Disableplease">

                                <option value="">Select</option>
                                <option value="Console">Console</option>
                                <option value="Branch">Branch</option>

                            </select>
                        </div>

                        <!-- Location -->
                        <div class="col-md-3">
                            <label class="form-label">Location</label>
                            <select id="ddlState" class="form-control form-select validate" ng-model="StoreCode" ng-init="BindStore()" ng-disabled="Disableplease">
                                <option value="">Select Location</option>
                                <option ng-repeat="x in StoreList" value="{{x.StoreId}}">
                                    {{x.StoreCode}}
                                </option>
                            </select>
                        </div>

                        <!-- Month -->
                        <div class="col-md-3" ng-init="BindMonth();">
                            <label class="form-label">Month</label>
                            <select id="CMonth" class="form-control form-select validate" ng-model="Month" ng-disabled="Disableplease">
                                <option value="">Select</option>
                                <option ng-repeat="x in MonthList" value="{{x.MonthNumber}}">
                                    {{x.MonthName}}
                                </option>
                            </select>
                        </div>

                        <!-- Year -->
                        <div class="col-md-3" ng-init="BindFinacialYear()">
                            <label class="form-label">Year</label>
                            <select id="ddlFinancialYear" class="form-control form-select validate" ng-model="Year" ng-change="callfromStage1()" ng-disabled="Disableplease">
                                <option value="">Select</option>
                                <option ng-repeat="x in finacialyearList" value="{{x.FyId}}">
                                    {{x.FyId}}
                                </option>
                            </select>
                        </div>

                        <!-- File Uploads -->
                        <div class="col-md-3">
                            <label class="form-label">Active/Deactive Data</label>
                            <input type="file" id="excelFile1" onchange="angular.element(this).scope().ReadActiveExcel(this)" class="form-control" />

                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Salary Sheet</label>

                            <input type="file" id="excelFile2" onchange="angular.element(this).scope().ReadSalaryExcel(this)" class="form-control" />
                        </div>

                        <!-- Proceed + Download -->
                        <div class="col-12 text-end mt-3">
                            <button type="button" class="btn btn-outline-primary me-2" id="downloadActiveTemplateBtn">
                                <i class="bi bi-download"></i> Download Active Template
                            </button>
                            <button type="button" class="btn btn-outline-primary me-2" id="downloadSalaryTemplateBtn">
                                <i class="bi bi-download"></i> Download Salary Template
                            </button>

                            <button type="button"
                                    id="btnProceed"
                                    class="btn btn-success"
                                    ng-click="SaveRecordStage1($event)">
                                Proceed
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- STEP 2: Validation Process -->
            <div class="card mb-4 d-none" id="salaryStep">
                <div class="card-header text-white">Validation Process</div>
                <div class="card-body">

                    <!-- Action buttons grouped by type -->
                    <div class="d-flex flex-wrap gap-2 mb-4">
                        <!-- Employee Master -->
                        <div class="btn-group">
                            <button class="btn btn-outline-primary" onclick="showData('employee')">
                                <i class="bi bi-eye"></i> View Employee
                            </button>
                            <button class="btn btn-outline-secondary" ng-click="DownloadEmpTableCSV()">
                                <i class="bi bi-download"></i> Download
                            </button>
                        </div>

                        <!-- Active/Deactive -->
                        <div class="btn-group">
                            <button class="btn btn-outline-primary" onclick="showData('active')">
                                <i class="bi bi-eye"></i> View Active/Inactive
                            </button>
                            <button class="btn btn-outline-secondary" ng-click="DownloadActiveTableCSV()">
                                <i class="bi bi-download"></i> Download
                            </button>
                        </div>

                        <!-- Salary -->
                        <div class="btn-group">
                            <button class="btn btn-outline-primary" onclick="showData('salary')">
                                <i class="bi bi-eye"></i> View Salary
                            </button>
                            <button class="btn btn-outline-secondary" ng-click="DownloadSalarySheetCSV()">
                                <i class="bi bi-download"></i> Download
                            </button>
                        </div>

                        <!-- Proceed -->
                        <button class="btn btn-success ms-auto" ng-click="callfromStagevalidationthreetable()">
                            Proceed → Validate
                        </button>
                    </div>

                    <!-- Data Tables Container -->
                    <div id="dataTablesContainer">

                        <!-- Employee Table -->
                        <div class="table-responsive d-none" id="employeeTable">
                            <h5 class="mb-3 text-primary">Employee Master Data</h5>
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ref Employee Code</th>
                                        <th>Employee Name</th>
                                        <th>Employee Designation</th>
                                        <th>Employee Department</th>
                                        <th>Father/Husband Name</th>
                                        <th>Gender</th>
                                        <th>Marital Status</th>
                                        <th>Date of Birth</th>
                                        <th>Present Address</th>
                                        <th>Permanent Address</th>
                                        <th>Aadhar Card Number</th>
                                        <th>PAN Number </th>
                                        <th>Mobile Number</th>
                                        <th>Alternative Mobile Number</th>
                                        <th>Employee Email ID</th>
                                        <th>Bank Account Number</th>
                                        <th>Bank IFSC Code</th>
                                        <th>Previous UAN</th>
                                        <th>Previous ESI</th>
                                        <th>Gross Salary</th>
                                        <th>DOJ</th>
                                        <th>Name of Nominee</th>
                                        <th>Address of Nominee</th>
                                        <th>Relation of Nominee</th>
                                        <th>DOB of Nominee</th>
                                        <th>PF Account</th>
                                        <th>Date of Leaving</th>
                                        <th>Store Code</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in EmpTable">
                                        <td>
                                            {{x.RefEmployeeCode}}
                                        </td>
                                        <td>
                                            {{x.EmployeeName}}
                                        </td>
                                        <td>
                                            {{x.EmployeeDesignation}}
                                        </td>
                                        <td>
                                            {{x.EmployeeDepartment}}
                                        </td>
                                        <td>
                                            {{x.Father_Husband_Name}}
                                        </td>
                                        <td>
                                            {{x.Gendar}}
                                        </td>
                                        <td>
                                            {{x.MaritalStatus}}
                                        </td>
                                        <td>
                                            {{x.DateOfBirth}}
                                        </td>
                                        <td>
                                            {{x.PresentAddress }}
                                        </td>
                                        <td>
                                            {{x.PermanemtAddress}}
                                        </td>

                                        <td>
                                            {{x.AdharCardNumber}}
                                        </td>
                                        <td>
                                            {{x.PANNumber}}
                                        </td>
                                        <td>
                                            {{x.MobileNumber}}
                                        </td>
                                        <td>
                                            {{x.AlternativeMobileNumber}}
                                        </td>
                                        <td>
                                            {{x.EmployeeEmailID}}
                                        </td>
                                        <td>
                                            {{x.BankAccountNumber}}
                                        </td>
                                        <td>
                                            {{x.BankIFSCCode}}
                                        </td>
                                        <td>
                                            {{x.PreviousUAN}}
                                        </td>
                                        <td>
                                            {{x.PreviousESI}}
                                        </td>
                                        <td>
                                            {{x.GrossSalary}}
                                        </td>
                                        <td>
                                            {{x.DOJ}}
                                        </td>
                                        <td>
                                            {{x.NomineeName}}
                                        </td>
                                        <td>
                                            {{x.NomineeAddress}}
                                        </td>
                                        <td>
                                            {{x.NomineeRelation}}
                                        </td>
                                        <td>
                                            {{x.NomineeDOB}}
                                        </td>
                                        <td>
                                            {{x.PFAccount}}
                                        </td>
                                        <td>
                                            {{x.DateofLeaving}}
                                        </td>
                                        <td>
                                            {{x.StoreCode}}
                                        </td>
                                        <td>
                                            {{x.IsActive}}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Active/Deactive Table -->
                        <div class="table-responsive d-none" id="activeTable">
                            <h5 class="mb-3 text-primary">Active/Inactive Data</h5>

                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>UAN</th>
                                        <th>Member ID</th>
                                        <th>Name</th>
                                        <th>Gender</th>
                                        <th>DoB</th>
                                        <th>DoJ</th>
                                        <th>Father's/Husband's Name</th>
                                        <th>Relation</th>
                                        <th>Marital Status</th>
                                        <th>Mobile</th>
                                        <th>Email ID</th>
                                        <th>AADHAAR</th>
                                        <th>PAN</th>
                                        <th>Bank Account No</th>
                                        <th>IFSC Code</th>
                                        <th>Nomination Filed</th>
                                        <th>Is AADHAAR Verified</th>
                                        <th>Face Auth Status</th>
                                        <th>Whether Member of Pension Scheme</th>
                                        <th>EPS: Contributing on Higher Wages</th>
                                        <th>Deferred Pension</th>
                                        <th>International Worker</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in ActiveMemberSheet">
                                        <td>{{x.UAN}}</td>
                                        <td>{{x.MemberID}}</td>
                                        <td>{{x.Name}}</td>
                                        <td>{{x.Gender}}</td>
                                        <td>{{x.DoB}}</td>
                                        <td>{{x.DoJ}}</td>
                                        <td>{{x.FatherHusbandName}}</td>
                                        <td>{{x.Relation}}</td>
                                        <td>{{x.MaritalStatus}}</td>
                                        <td>{{x.Mobile}}</td>
                                        <td>{{x.EmailID}}</td>
                                        <td>{{x.AADHAAR}}</td>
                                        <td>{{x.PAN}}</td>
                                        <td>{{x.BankAccountNo}}</td>
                                        <td>{{x.IFSCCode}}</td>
                                        <td>{{x.NominationFiled}}</td>
                                        <td>{{x.IsAadhaarVerified}}</td>
                                        <td>{{x.FaceAuthStatus}}</td>
                                        <td>{{x.PensionSchemeMember}}</td>
                                        <td>{{x.ContributingOnHigherWages}}</td>
                                        <td>{{x.DeferredPension}}</td>
                                        <td>{{x.InternationalWorker}}</td>
                                    </tr>
                                </tbody>
                            </table>


                        </div>

                        <!-- Salary Table -->
                        <div class="table-responsive d-none" id="salaryTable">
                            <h5 class="mb-3 text-primary">Salary Sheet Data</h5>
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Ref Employee Code</th>
                                        <th>Employee Name</th>
                                        <th>DOJ</th>
                                        <th>Designation</th>
                                        <th>International Worker (Yes/No)</th>
                                        <th>POHW (Yes/No)</th>
                                        <th>Branch/Location</th>
                                        <th>UAN Number</th>
                                        <th>PF Type</th>
                                        <th>Resignation Date</th>
                                        <th>Total Working Days</th>
                                        <th>Earned Gross Salary</th>
                                        <th>PF Salary</th>
                                        <th>Employee's PF Cont.</th>
                                        <th>VPF</th>
                                        <th>Arrear Gross Salary</th>
                                        <th>Arrear PF Salary</th>
                                        <th>Employee's ESIC Cont.</th>
                                        <th>P Tax</th>
                                        <th>LWF</th>
                                        <th>Total Deduction</th>
                                        <th>Net Payable Salary</th>
                                        <th>Pensioner Employee (Yes/No)</th>
                                        <th>Created Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="x in SalarySheet">
                                        <td>{{x.EmployeeCode}}</td>
                                        <td>{{x.EmployeeName}}</td>
                                        <td>{{x.DOJ}}</td>
                                        <td>{{x.Designation}}</td>
                                        <td>{{x.InternationalWorker}}</td>
                                        <td>{{x.POHW}}</td>
                                        <td>{{x.BranchLocation}}</td>
                                        <td>{{x.UANNumber}}</td>
                                        <td>{{x.PFType}}</td>
                                        <td>{{x.ResignationDate}}</td>
                                        <td>{{x.TotalWorkingDays}}</td>
                                        <td>{{x.EarnedGrossSalary}}</td>
                                        <td>{{x.PFSalary}}</td>
                                        <td>{{x.EmployeePFCont}}</td>
                                        <td>{{x.VPF}}</td>
                                        <td>{{x.ArrearGrossSalary}}</td>
                                        <td>{{x.ArrearPFSalary}}</td>
                                        <td>{{x.EmployeeESICCont}}</td>
                                        <td>{{x.PTax}}</td>
                                        <td>{{x.LWF}}</td>
                                        <td>{{x.TotalDeduction}}</td>
                                        <td>{{x.NetPayableSalary}}</td>
                                        <td>{{x.PensionerEmployee}}</td>
                                        <td>{{x.CreatedDate}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>

            <!-- STEP 3: Validation Output -->
            <div class="card mb-4" id="validationStep">
                @*<div class="card mb-4 d-none" id="validationStep">*@
                <div class="card-header text-white">Validation Results</div>
                <div class="card-body">
                    <!-- Validation Passed -->
                    <div id="validationPassed" class="d-none text-center p-4">
                        <h5 class="text-success mb-3">Validation Passed</h5>
                        <p>All sheets validated successfully. You can proceed to the next step.</p>
                        <button class="btn btn-success" ng-click="proceedToValidatedSheet()">
                            Proceed → Validated Sheet
                        </button>
                    </div>

                    <!-- Validation Failed -->
                    <div id="validationFailed" class="d-none">
                        <h5 class="text-danger mb-3">Validation Failed</h5>
                        <p>Some discrepancies were found. Review each category below.</p>

                        <!-- Category Table -->
                        <table class="table table-bordered table-hover mt-3">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>Status</th>
                                    <th>Error Category</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span class="text-danger fw-bold" ng-if="DuplicateEmployeeTableRecord==1">❌</span>
                                        <span class="text-success fw-bold" ng-if="DuplicateEmployeeTableRecord==0">✅</span>

                                    </td>
                                    <td>Employee Errors</td>
                                    <td><button class="btn btn-sm btn-primary" ng-click="TableerrorList('Employee')">View Details</button></td>
                                </tr>
                                <tr>
                                    <td>
                                        <span class="text-danger fw-bold" ng-if="DuplicateActiveTableRecord==1">❌</span>
                                        <span class="text-success fw-bold" ng-if="DuplicateActiveTableRecord==0">✅</span>
                                    </td>
                                    <td>Active/Inactive Errors</td>
                                    <td><button class="btn btn-sm btn-primary" ng-click="TableerrorList('Active/Inactive')">View Details</button></td>
                                </tr>
                                <tr>
                                    <td>
                                        <span class="text-danger fw-bold" ng-if="DuplicateSalaryTableRecord==1">❌</span>
                                        <span class="text-success fw-bold" ng-if="DuplicateSalaryTableRecord==0">✅</span>
                                    </td>
                                    <td>Salary Sheet Errors</td>
                                    <td><button class="btn btn-sm btn-primary" ng-click="TableerrorList('Salary')">View Details</button></td>
                                </tr>
                                <tr>
                                    <td>
                                        <span class="text-danger fw-bold" ng-if="MisMatchTableRecord==1">❌</span>
                                        <span class="text-success fw-bold" ng-if="MisMatchTableRecord==0">✅</span>
                                    </td>
                                    <td>MisMatching  Sheet Errors</td>
                                    <td><button class="btn btn-sm btn-primary" ng-click="OpenMismatch()">View Details</button></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Warning & Proceed -->
                        <div id="errorWarning" class="alert alert-warning mt-3">
                            ⚠ Please review all errors before proceeding to the next step.
                        </div>
                        <div class="text-end mt-3">
                            <button class="btn btn-success d-none" id="proceedAfterFixBtn" onclick="showValidatedSheetStep()">Proceed → Validated Sheet</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Error Modal for step 3 -->
            <div class="modal" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header text-white">
                            <h5 class="modal-title" id="errorModalLabel">Error Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div id="errorModalContent">
                                <h6 class="mb-3 text-primary">
                                    {{TableHeader}} Error Details [ Total Count : {{errorList.length || 0}} ]
                                </h6>
                                <table class="table table-bordered table-hover align-middle">
                                    <thead class="table-light text-center">
                                        <tr>
                                            <th>Emp ID</th>
                                            <th>Employee Name</th>
                                            <th>Error Description</th>
                                            <th>Column</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in errorList">
                                            <td>{{x.RefEmployeeCode}}</td>
                                            <td>
                                                {{x.EmployeeName}}
                                            </td>
                                            <td>{{x.Description}}</td>
                                            <td>
                                                <!-- Normal display -->
                                                <span ng-hide="x.isEditing">{{x.ColumnName}}</span>

                                                <!-- Editable input (shows when Fix clicked) -->
                                                <input type="text" class="form-control form-control-sm"
                                                       ng-show="x.isEditing"
                                                       ng-model="x.newValue"
                                                       placeholder="Enter new value">
                                            </td>
                                            <td>
                                                <!-- Fix button -->
                                                <button class="btn btn-sm btn-warning"
                                                        ng-hide="x.isEditing"
                                                        ng-click="startEdit(x)">
                                                    Fix
                                                </button>

                                                <!-- Save button -->
                                                <button class="btn btn-sm btn-success"
                                                        ng-show="x.isEditing"
                                                        ng-click="saveFix(x)">
                                                    Save
                                                </button>
                                            </td>
                                        </tr>
                                        <tr ng-if="!errorList || errorList.length === 0">
                                            <td colspan="4" class="text-center text-success">
                                                ✅ No errors remaining in this category
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal" id="MisserrorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header text-white">
                            <h5 class="modal-title" id="errorModalLabel">Error Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div id="errorModalContent">
                                <h6 class="mb-3 text-primary d-flex justify-content-between align-items-center">
                                    <span>
                                        {{TableHeader}} Error Details [ Total Count : {{errorList1.length || 0}} ]
                                    </span>
                                    <button class="btn btn-sm btn-warning" ng-click="BeforeFixAll()">
                                        Fix All
                                    </button>
                                </h6>
                                <table class="table table-bordered table-hover align-middle">
                                    <thead class="table-light text-center">
                                        <tr>
                                            @*<th>UniqueId</th>*@
                                            <th>Employee Master</th>
                                            <th>Salary Sheet</th>
                                            <th>Active Sheet</th>
                                            <th>Error Description</th>
                                            <th>Update Table</th>
                                            <th>Column</th>

                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="x in errorList1">
                                            @*<td>
                                                    {{x.MemberID}}
                                                </td>*@
                                            <td>
                                                {{x.EmployeeMaster}}
                                            </td>
                                            <td>
                                                {{x.SalarySheet}}
                                            </td>
                                            <td>
                                                {{x.ActiveSheet}}
                                            </td>
                                            <td>
                                                {{x.Description}}
                                            </td>
                                            <td>{{x.UpdateTable}}</td>
                                            <td>
                                                <!-- Normal display -->
                                                <span ng-hide="x.MisEditing">{{x.ColumnName}}</span>

                                                <!-- Editable input (shows when Fix clicked) -->
                                                <input type="text" class="form-control form-control-sm"
                                                       ng-show="x.MisEditing"
                                                       ng-model="x.MnewValue"
                                                       placeholder="Enter new value">
                                            </td>
                                            <td>
                                                <!-- Fix button -->

                                                <button class="btn btn-sm btn-warning" ng-if="x.IsFix==0"
                                                        ng-hide="x.MisEditing"
                                                        ng-click="MstartEdit(x)">
                                                    Fix
                                                </button>
                                                <button style="background-color:crimson;color:white" ng-if="x.IsFix==1">
                                                    ReUpload
                                                </button>
                                                <!-- Save button -->
                                                <button class="btn btn-sm btn-success" ng-if="x.IsFix==0"
                                                        ng-show="x.MisEditing"
                                                        ng-click="MsaveFix(x)">
                                                    Save
                                                </button>
                                            </td>
                                        </tr>
                                        <tr ng-if="!errorList1 || errorList1.length === 0">
                                            <td colspan="4" class="text-center text-success">
                                                ✅ No errors remaining in this category
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fix Modal for step 3 -->
            <div class="modal fade" id="fixModal" tabindex="-1" aria-labelledby="fixModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="fixModalLabel">Fix Error</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
