@{
    ViewBag.Title = "OverView Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/ckeditor/ckeditor.js"></script>
<script src="~/Content/ckfinder/ckfinder.js"></script>
<script src="~/Scripts/RetailJsLib/RetailOverViewMasterController.js?Ver=@ViewBag.Version"></script>
<style>
    .dropdown-menu {
        display: block !important;
    }
</style>
@*<script src="~/Scripts/myjslib/ddlBindings.js"></script>*@
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<input type="hidden" id="Id1" name="Id1" value="" ng-model="hfId1" />
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Act Overview Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Retail</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Act Overview Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">

                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">

                                            <label class="control-label">State<span class="vd_red">*</span></label>

                                            <div class="input-box" ng-init="BindState()">
                                                <select id="ddlCustomerId" autocomplete='address-level2' class="select2 form-control validate" ng-model="State" ng-change="BindAct()" ng-disabled="IseditDisable">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in AllStateList" value="{{x.SATE_CODE}}">{{x.STATE_NM}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Act Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="ddlAct" autocomplete='address-level2' class="select2 form-control validate" ng-model="ActId" ng-disabled="IseditDisable">
                                                    <option value="">Select</option>
                                                    <option ng-repeat="x in AllActList" value="{{x.ActId}}">{{x.Act}}</option>
                                                </select>

                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div> 
                                         
                                        <div class="col-md-2 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Act Copy (excel/pdf only)</label>
                                            <div class="input-box">
                                                <input type="file" id="UploadFile" onchange="angular.element(this).scope().ActUploadExcelFile(this, '#AlbumIcon')"
                                                       ng-model="ActFile">
                                              
                                                <a   href="{{ActFile}}" ng-show="ActFile !=''" download>View File</a>
                                                <div class="text-box-msg-r">
                                                </div>

                                            </div>
                                            </div>
                                        <div class="col-md-2 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Rule Copy(excel/pdf only)</label>
                                            <div class="input-box">
                                                <input type="file" id="ExcelFile"
                                                       onchange="angular.element(this).scope().RuleUploadExcelFile(this)"
                                                       accept=".xls, .xlsx,.pdf" />
                                             
                                                <a href="{{RuleFile}}" ng-show="RuleFile !=''" download>View File</a>
                                                <div class="text-box-msg-r">
                                                </div>

                                            </div>
                                        </div>
                                        <div class="col-md-12 col-sm-12 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Overview </label>
                                            <div class="input-box"> 
                                                @Html.TextArea("txtHeaderTemplate", "", new { @class = "form-control clear", @placeholder = "", @ng_model = "HeaderTemplate", @name = "txtHeaderTemplate", @id = "txtHeaderTemplate", @rows = "10", @cols = "80" })
                                                <script>$(document).ready(function () { CKEDITOR.replace('txtHeaderTemplate'); });</script>
                                                 
                                                <div class="text-box-msg-r"></div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>
                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>
