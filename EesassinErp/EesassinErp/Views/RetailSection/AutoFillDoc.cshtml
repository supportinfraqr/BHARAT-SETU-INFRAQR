 
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
    /* ==========================
       NAVBAR
    ========================== */

    .autoFillDocNavbar {
        font-family: "Inter", sans-serif;
        height: 68px;
        background: #eef2f6;
        border-bottom: 1px solid #e3e8ef;
        display: flex;
        align-items: center;
    }

    .autoFillDocNavbarInner {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .autoFillDocLogo {
        font-size: 22px;
        font-weight: 600;
        line-height: 1;
    }

        .autoFillDocLogo .logoBlue {
            color: #022B5E;
        }

        .autoFillDocLogo .logoOrange {
            color: #E45D24;
        }

        .autoFillDocLogo .logoGreen {
            color: #1D8F4E;
        }

    .autoFillDocSupportBtn {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: #4b5563;
        font-size: 15px;
        font-weight: 500;
        padding: 10px 16px;
        border-radius: 12px;
        transition: .25s;
    }

        .autoFillDocSupportBtn:hover {
            background: #ffffff;
            color: #022B5E;
        }

        .autoFillDocSupportBtn i {
            font-size: 18px;
        }

    .autoFillDoc {
        min-height: 100vh;
        background: #f5f7fb;
        padding: 30px 40px 40px;
        font-family: "Inter", sans-serif;
    }

    .autoFillDocContainer {
        max-width: 1500px;
        margin: auto;
    }

    /* HEADER */
    .autoFillDocHeader {
        text-align: center;
        margin-bottom: 40px;
    }

        .autoFillDocHeader h1 {
            font-size: 28px;
            font-weight: 700;
            color: #022B5E;
            margin-bottom: 12px;
        }

        .autoFillDocHeader p {
            font-size: 16px;
            max-width: 550px;
            color: #4b5563;
            margin: auto;
            line-height: 1.5;
        }

    /* LAYOUT */
    .autoFillDocLayout {
        display: grid;
        grid-template-columns: 58% 42%;
        gap: 24px;
        align-items: start;
    }

    /* LEFT UPLOAD AREA */
    .autoFillDocUploadArea {
        border: 3px dashed #1e88e5;
        border-radius: 8px;
        min-height: 620px;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
    }

    .autoFillDocUploadContent {
        text-align: center;
    }

    .autoFillDocUploadIcon {
        width: 70px;
        height: 70px;
        background: #edf4ff;
        border-radius: 12px;
        margin: auto auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .autoFillDocUploadIcon i {
            font-size: 34px;
            color: #022B5E;
        }

    .autoFillDocUploadContent h3 {
        font-size: 20px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .autoFillDocUploadContent p {
        color: #6b7280;
        margin-bottom: 25px;
    }

    .autoFillDocBrowseBtn {
        background: #022B5E;
        color: white;
        border: none;
        height: 56px;
        padding: 0 35px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 18px;
    }

    .autoFillDocFileTypes {
        margin-top: 25px;
        display: flex;
        justify-content: center;
        gap: 12px;
    }

        .autoFillDocFileTypes span {
            padding: 8px 22px;
            border-radius: 25px;
            background: #edf2f7;
            font-size: 14px;
            color: #4b5563;
        }

    /* RIGHT PANEL */
    .autoFillDocRight {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .autoFillDocCard {
        background: #fff;
        border: 1px solid #d7dde7;
        border-radius: 10px;
        padding: 24px;
    }

    /* PROGRESS */
    .autoFillDocProgressTop {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .autoFillDocProgressTop span {
            color: #022B5E;
            font-size: 16px;
            font-weight: 600;
        }

    .autoFillDocProgressBar {
        height: 14px;
        background: #dbe6f5;
        border-radius: 30px;
        overflow: hidden;
    }

    .autoFillDocProgressFill {
        width: 65%;
        height: 100%;
        background: #022B5E;
        border-radius: 30px;
    }

    /* SECTION TITLE */
    .autoFillDocSectionTitle {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 2px;
        color: #022B5E;
        text-transform: uppercase;
        padding-bottom: 10px;
        margin-bottom: 18px;
        border-bottom: 1px solid #d7dde7;
    }

    /* PROFILE */
    .autoFillDocProfileCard {
        border: 1px solid #d7dde7;
        border-radius: 6px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .autoFillDocProfileImage {
        width: 90px;
        height: 90px;
        background: #dbe3f1;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .autoFillDocProfileImage i {
            font-size: 40px;
            color: #4b5563;
        }

    .autoFillDocProfileInfo h4 {
        font-size: 18px;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 12px;
        margin-top: 0;
    }

    .autoFillDocProfileBtns {
        display: flex;
        gap: 10px;
    }

    .autoFillDocDarkBtn {
        background: #022B5E;
        color: white;
        border: none;
        height: 40px;
        padding: 0 20px;
        border-radius: 12px;
    }

    .autoFillDocOutlineBtn {
        background: white;
        border: 1px solid #022B5E;
        color: #022B5E;
        height: 40px;
        padding: 0 20px;
        border-radius: 12px;
    }

    /* DOCUMENTS */
    .autoFillDocDocsGrid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 16px;
    }

    .autoFillDocDocCard {
        border: 1px solid #d7dde7;
        border-radius: 6px;
        padding: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .autoFillDocDocLeft {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .autoFillDocDocIcon {
        width: 42px;
        height: 42px;
        background: #edf2f7;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .autoFillDocDocInfo h5 {
        font-size: 16px;
        margin-top: 2px;
        margin-bottom: 2px;
    }

    .autoFillDocDocInfo p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .autoFillDocPending {
        color: #dc2626;
        font-size: 12px;
    }

    .autoFillDocNotAdded {
        color: #9ca3af;
        font-size: 12px;
    }

    /* ACTION BUTTON */
    .autoFillDocPrimaryBtn {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 10px;
        background: #022B5E;
        color: white;
        font-size: 20px;
        font-weight: 500;
    }

    .autoFillDocSkip {
        text-align: center;
        display: block;
        margin-top: 14px;
        text-decoration: none;
        color: #022B5E;
        font-weight: 600;
    }

    /* RESPONSIVE */
    @@media (max-width:1200px) {

        .autoFillDocLayout {
            grid-template-columns: 1fr;
        }

        .autoFillDocUploadArea {
            min-height: 500px;
        }
    }

    @@media (max-width:768px) {

        .autoFillDoc {
            padding: 20px;
        }

        .autoFillDocHeader h1 {
            font-size: 34px;
        }

        .autoFillDocHeader p {
            font-size: 16px;
        }

        .autoFillDocDocsGrid {
            grid-template-columns: 1fr;
        }

        .autoFillDocProfileCard {
            flex-direction: column;
            align-items: flex-start;
        }

        .autoFillDocProfileBtns {
            width: 100%;
            flex-direction: column;
        }
    }
</style>



<!-- TOP NAVBAR -->
<div class="autoFillDocNavbar">

    <div class="autoFillDocNavbarInner">

        <div class="autoFillDocLogo">

            <span class="logoBlue">Bharat</span><span class="logoOrange">Shram</span><span class="logoGreen">Setu</span>

        </div>

        <a href="#" class="autoFillDocSupportBtn">

            <i class="fa-solid fa-headset"></i>

            <span>Support</span>

        </a>

    </div>

</div>

<div class="autoFillDoc">
    <div class="autoFillDocContainer">

        <!-- PAGE HEADER -->
        <div class="autoFillDocHeader">

            <h1>
                Complete Your Profile
            </h1>

            <p>
                Upload your documents and let BharatShramSetu automatically populate your profile information.
            </p>

        </div>


        <!-- MAIN LAYOUT -->
        <div class="autoFillDocLayout">

            <!-- LEFT -->
            <div class="autoFillDocLeft">

                <div class="autoFillDocUploadArea">

                    <div class="autoFillDocUploadContent">

                        <div class="autoFillDocUploadIcon">
                            <i class="fa-solid fa-file-arrow-up"></i>
                        </div>

                        <h3>Drag and drop files here</h3>

                        <p>Maximum file size: 5MB</p>

                        <button class="autoFillDocBrowseBtn">
                            <i class="fa-solid fa-plus me-2"></i>
                            Browse Files
                        </button>

                        <div class="autoFillDocFileTypes">
                            <span>PDF</span>
                            <span>JPG</span>
                            <span>PNG</span>
                        </div>

                    </div>

                </div>

            </div>


            <!-- RIGHT -->
            <div class="autoFillDocRight">

                <!-- PROGRESS -->
                <div class="autoFillDocCard">

                    <div class="autoFillDocProgressTop">
                        <span>Progress</span>
                        <span>65%</span>
                    </div>

                    <div class="autoFillDocProgressBar">
                        <div class="autoFillDocProgressFill"></div>
                    </div>

                </div>

                <!-- PROFILE -->
                <div>

                    <div class="autoFillDocSectionTitle">
                        Profile Photo
                    </div>

                    <div class="autoFillDocProfileCard">

                        <div class="autoFillDocProfileImage">
                            <i class="fa-regular fa-user"></i>
                        </div>

                        <div class="autoFillDocProfileInfo">

                            <h4>Personal Photograph</h4>

                            <div class="autoFillDocProfileBtns">

                                <button class="autoFillDocDarkBtn">
                                    <i class="fa-solid fa-upload me-2"></i>
                                    Upload Photo
                                </button>

                                <button class="autoFillDocOutlineBtn">
                                    <i class="fa-solid fa-camera me-2"></i>
                                    Capture via Camera
                                </button>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- DOCUMENTS -->
                <div>

                    <div class="autoFillDocSectionTitle">
                        Required Documents
                    </div>

                    <div class="autoFillDocDocsGrid">

                        <div class="autoFillDocDocCard">
                            <div class="autoFillDocDocLeft">
                                <div class="autoFillDocDocIcon">
                                    <i class="fa-regular fa-id-card"></i>
                                </div>
                                <div class="autoFillDocDocInfo">
                                    <h5>Aadhaar Card</h5>
                                    <p>Primary Identity</p>
                                </div>
                            </div>
                            <span class="autoFillDocPending">Pending</span>
                        </div>

                        <div class="autoFillDocDocCard">
                            <div class="autoFillDocDocLeft">
                                <div class="autoFillDocDocIcon">
                                    <i class="fa-regular fa-credit-card"></i>
                                </div>
                                <div class="autoFillDocDocInfo">
                                    <h5>PAN Card</h5>
                                    <p>Financial Record</p>
                                </div>
                            </div>
                            <span class="autoFillDocPending">Pending</span>
                        </div>

                        <div class="autoFillDocDocCard">
                            <div class="autoFillDocDocLeft">
                                <div class="autoFillDocDocIcon">
                                    <i class="fa-solid fa-shield-halved"></i>
                                </div>
                                <div class="autoFillDocDocInfo">
                                    <h5>ESIC Card</h5>
                                    <p>Optional</p>
                                </div>
                            </div>
                            <span class="autoFillDocNotAdded">Not Added</span>
                        </div>

                        <div class="autoFillDocDocCard">
                            <div class="autoFillDocDocLeft">
                                <div class="autoFillDocDocIcon">
                                    <i class="fa-regular fa-file-lines"></i>
                                </div>
                                <div class="autoFillDocDocInfo">
                                    <h5>UAN</h5>
                                    <p>Optional</p>
                                </div>
                            </div>
                            <span class="autoFillDocNotAdded">Not Added</span>
                        </div>

                    </div>

                </div>

                <div>

                    <button class="autoFillDocPrimaryBtn">
                        Upload
                    </button>

                    <a href="#" class="autoFillDocSkip">
                        Skip to Manual Entry
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>
