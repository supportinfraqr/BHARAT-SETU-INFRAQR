                                            </div>
                                            <div class="profileImage" style="font-size: 4.8rem; background: #dcdcdc " ng-if="!EmployeePhotos">
                                                <i class="bi bi-person-fill" style=" margin-left: 4px;"></i>
                                            </div>
                                            <div class="profileDetails">
                                                <h2>{{EmpName}}</h2>
                                                <p>{{EmpDesignation}}</p>
                                                <p>
                                                    {{VendorName}}
                                                </p>
                                            </div>

                                            <div class="qrCode">
                                                <img ng-src="{{getQrUrl()}}" />
                                            </div>
                                        </div>

                                        <div class="infoSection">

                                            <div class="left">
                                                <div class="field">
                                                    <label>EmpCode</label>
                                                    <h4>{{EmpCode}}</h4>
                                                </div>

                                                <div class="field">
                                                    <label>Mobile Number</label>
                                                    <h4>{{EmpMobile}}</h4>
                                                </div>
                                            </div>

                                            <div class="divider"></div>

                                            <div class="right">
                                                <div class="field">
                                                    <label>Department</label>
                                                    <h4>{{EmpDep}}</h4>
                                                </div>

                                                <div class="field">
                                                    <label>Location(Site)</label>
                                                    <h4>{{Location}}<br />({{SiteName}})</h4> 
                                                </div>
                                            </div>

                                            

                                        </div>   
                                    </div>
                                </div>

                                <!-- BACK -->
                                <div class="card-face back">
                                    <div class="idCard backCard">
                                        <div class="backContent">

                                            <!-- Row 1 -->
                                            <div class="row1">
                                                <div class="field">
                                                    <label>Blood Group</label>
                                                    <h4>{{BloodGroup}}</h4>
                                                </div>

                                                <div class="field"> 
                                                    <label>Emergency No.</label>
                                                    <h4>{{EmpMobile}}</h4>
                                                </div>
                                            </div>

                                            <!-- Row 2 -->
                                            <div class="row1">

                                                <div class="field">
                                                    <label>Route/Bus No.</label>
                                                    <h4>
                                                        {{RouteName}}<br />{{BusNo}}
                                                    </h4>
                                                </div>

                                                <div class="field">
                                                    <label>Camp No.</label>
                                                    <h4>{{CampNumber}}</h4>
                                                </div>


                                            </div>

                                            <!-- Row 3 -->
                                            <div class="row1">
                                                <div class="field">
                                                    <label>UAN No.</label>
                                                    <h4>{{PreviousUAN}}</h4>
                                                </div>

                                                <div class="field">
                                                    <label>ESIC No.</label>
                                                    <h4>
                                                        {{PreviousESI}}
                                                    </h4>
                                                </div>
                                            </div>


                                        </div>

                                        <div class="p-2">
                                            <!-- NOTES (UNCHANGED) -->
                                            <div class="notesBox">
                                                <ul>
                                                    <li>This identity card must always be carried & displayed for security & identification.</li>
                                                    <li>Loss or theft of this card should be reported to {{ClientEmailId}} and {{ClientMobileNo}}.</li>
                                                    <li>This card is not transferable & must be returned immediately on cessation of employment.</li>
                                                </ul>
                                            </div>

                                            <!-- Footer -->
                                            <div class="footerRow">
                                                <div>
                                                    <span class="label">Issue Date :</span>
                                                    <span>{{IssueDate | date:'dd/MM/yyyy'}}</span>
                                                </div>

                                                <div class="rightAlign">
                                                    <span class="label">Valid Upto :</span>
                                                    <span>{{ValidTill | date:'dd/MM/yyyy'}}</span>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!--===========Profile Crop Modal============-->
        <div id="cropModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%; background:rgba(0,0,0,0.7);z-index:9999; justify-content:center;align-items:center;">

            <div style="background:#fff;padding:10px;border-radius:10px;width:80%;text-align:center;">

                <img id="cropImage" style="max-width:100%;max-height:300px;" />

                <br><br>


                <button class="btn cancel-btn" ng-click="closeCrop()">Cancel</button>
                <button class="btn import-save-btn" ng-click="cropImageSave()">
                    Crop & Save
                </button>
            </div>
        </div>
    </div>
</div>



 