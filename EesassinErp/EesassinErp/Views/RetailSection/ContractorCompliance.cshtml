@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Contractor Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/Content/Masters/ContractorCompliance/script.js"></script>
<link href="~/Content/Masters/ContractorCompliance/style.css" rel="stylesheet" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>  
