<div class="contractorCompPage px-4 py-2">

    <div class="d-flex align-items-center justify-content-between mb-3 top-bar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h4 style="color: var(--primary)">Contractor Compliance</h4>
        </div>
        <div id="print-area"
             style="position:absolute;
            left:-9999px;
            top:0;
            width:1000px;
            background:#fff;">
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-bulk-download"  ng-hide="loginType === 5" id="btnBulkDownload" type="button" data-bs-toggle="modal" data-bs-target="#bulkDownloadModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>Bulk Download</span>
            </button>
        </div>
    </div>

    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="View or Generate">
            <button type="button" class="btn btn-pill active" id="btnViewCard" data-target="#viewCard" aria-pressed="true">View</button>
            <button type="button" class="btn btn-pill" data-target="#generateCard" aria-pressed="false" ng-hide="loginType === 5"> Generate</button>
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">
        <!-- VIEW CARD (default visible) -->
        <div id="viewCard" class="card section-card active">
            <div class="card-body p-3 h-100 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        
                      <div class="dropdown" ng-show="loginType === 5">
                            <button class="btn btn-sm filter-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">
                                {{SelectedvendorName || 'Vendor'}}
                            </button>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       ng-click="SelectedvendorName=''; ApplyFilter('','','')">
                                        All
                                    </a>
                                </li>

                                <li ng-repeat="x in FilteredList | unique:'PartyName'">
                                    <a class="dropdown-item"
                                       ng-click="ApplyFilter('','',x.PartyName)">
                                        {{x.PartyName}}
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Month -->
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                {{SelectedMonth || 'Month'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="m in MonthList">
                                    <a class="dropdown-item"
                                       ng-click="SelectedMonth = m ; ApplyFilter(m,'','')">
                                        {{m}}
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Year -->
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                {{SelectedYear || 'Year'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="y in YearList">
                                    <a class="dropdown-item"
                                       ng-click="SelectedYear = y; ApplyFilter('',y,'')">
                                        {{y}}
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <button class="btn btn-sm filter-btn active" ng-click="ResetFiltercontractor()">Reset</button>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="estSearch" type="text" class="form-control form-control-sm" placeholder="Search..." ng-model="SearchBox" />
                                <button class="btn btn-sm" style="border-color: #022B5E" id="estSearchBtn" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div>
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="" ng-click="ContractorexportCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" href="" ng-click="ContractorprintTable()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3" ng-init="AllContratorList()">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table" id="estTable">
                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Month</th>
                                    <th>Year</th>
                                    <th>State Count</th>
                                    <th>Employee Count</th>
                                    <th>Location Count</th>
                                    <th>Generated On</th>
                                    <th>Generated by</th>
                                    <th>Status</th>
                                    <th>View</th>
                                    <th>Master File</th>
                                </tr>
                            </thead>
                            <tbody id="estTableBody">
                                <tr ng-repeat="x in FilteredList | filter:SearchBox">
                                    <td>{{$index +1}}</td>
                                    <td>{{x.MonthName}}</td>
                                    <td>{{x.Year}}</td>
                                    <td>{{x.TotalState}}</td>
                                    <td>{{x.TotalEmployee}}</td>
                                    <td>{{x.TotalSite}}</td>
                                    <td>{{x.generatedon}}</td>
                                    <td>{{x.PartyName}}</td>
                                    <td><span class="badge status-active">Generated</span></td>
                                    <td>
                                        <a class="btn btn-sm download-btn"
                                           ng-href="../RetailSection/ContractorReport?UID={{x.UID}}">
                                            View
                                        </a>
                                    </td>
                                    <td><button class="btn btn-sm download-btn" ng-click="DownloadFileC(x.ExcelFile)">Download</button></td>
                                </tr>
                                <tr ng-if="!FilteredList || FilteredList.length == 0">
                                    <td colspan="11" class="text-center text-muted py-3" style="color:var(--primary) !important;">
                                        Data Not Found
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @*<div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="estPaginationWrap">
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-sm" id="estPrev" type="button">Previous</button>
                                <button class="btn btn-sm" id="estNext" type="button">Next</button>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div id="estPageInfo" style="font-size:0.85rem;color:#555;"></div>
                                <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                            </div>
                        </div>*@
                </div>
            </div>
        </div>

        <!-- BULK DOWNLOAD MODAL -->
        <div class="modal fade bulkDownloadModal" id="bulkDownloadModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">

                    <!-- HEADER -->
                    <div class="modal-header">
                        <h5 class="modal-title">Bulk Download Documents</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <!-- BODY -->
                    <div class="modal-body">

                        <!-- STATES -->
                        <div class="form-group mb-3">
                            <label class="form-label">Select State(s)</label>
                            <div class="state-box">


                                <div class="form-check state-item" ng-repeat="s in AllStateList">
                                    <input type="checkbox"
                                           class="form-check-input state-checkbox"
                                           id="chk_{{s.SATE_CODE}}"
                                           ng-checked="SelectedStates.indexOf(s.SATE_CODE) > -1"
                                           ng-click="toggleStateSelection(s.SATE_CODE)">
                                    <label class="form-check-label" for="chk_{{s.SATE_CODE}}">
                                        {{s.STATE_NM}}
                                    </label>
                                </div>

                            </div>
                        </div>

                        <!-- FY + MONTH -->
                        <div class="row">
                            <div class="col-md-6 mb-3" ng-init="BindFinacialYear();">
                                <label class="form-label">Financial Year</label>

                                <select id="ddlFinancialYear" class="form-select" ng-model="FY">
                                    <option value="">Select</option>
                                    <option ng-repeat="x in finacialyearList" value="{{x.FinancialName}}">
                                        {{x.FinancialName}}
                                    </option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3" ng-init="BindMonth();">
                                <label class="form-label">Month</label>
                                <select id="CMonth" class="form-select" ng-model="CMonth">
                                    <option value="">Select</option>
                                    <option ng-repeat="x in MMonthList" value="{{x.MonthNumber}}">
                                        {{x.MonthName}}
                                    </option>
                                </select>
                            </div>
                        </div>

                    </div>

                    <!-- FOOTER -->
                    <div class="modal-footer">
                        <div style="margin-bottom: 1rem;padding-left: 1rem;">
                            {{downloadAlertMessage}}<br />
                            {{downloadMessage}}

                        </div>
                        <button type="button"
                                class="btn btn-download"
                                ng-click="DownloadSelected()">
                            <i class="bi bi-download me-1"></i> Download
                        </button>
                        @*<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>*@
                        <button class="btn btn-download" data-bs-dismiss="modal">Close</button>
                    </div>

                </div>
            </div>
        </div>


        <!-- ================= GENERATE CARD (hidden by default) ================= -->
        <div id="generateCard" class="card section-card d-none" ng-init="BindFinacialYear();AllState();LoadStore();BindState()">
            <div class="card-body p-3">
                <h6>Import Master File</h6>
                <a href="~/DownloadMat/ContractorMasterSheet_Audit.xlsx" target="_blank" class="btn btn-sm mb-3" id="estDownloadTemplate">
