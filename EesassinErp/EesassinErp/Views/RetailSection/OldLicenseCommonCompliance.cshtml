    <!-- REPORT PAGE 3: Labour Compliance Report -->
    <!-- REPORT PAGE 7: License Report -->
    <div class="container-report7 py-4" ng-init="BindTiles();commonReport()">

        <!-- HEADER -->
        <div class="report-header7 d-flex justify-content-end align-items-center mb-3">
            <h6 class="mb-0 fw-semibold text-end">Report Period: Oct 2025</h6>
        </div>

        <!-- BODY -->
        <div class="report-body7 p-4">

            <!-- TITLE -->
            <div class="report-title-box text-center py-2 px-2 mb-3">
                <h5 class="fw-semibold mb-0">
                    License Report
                </h5>
            </div>

            <!-- DESCRIPTION -->
            <p class="text-muted text-center mb-4" style="font-size:14px;">
                This section provides a consolidated overview of all compliances, highlighting the organization’s completion ratio,
                pending obligations, and compliance health for the selected period.
            </p>

            <!-- SMALL CARDS -->
            <div class="row g-3 mb-4 justify-content-center text-center">
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-success text-white py-3">
                        <h6>All Licenses</h6>
                        <h5>{{licenseCount.total}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-danger text-white py-3">
                        <h6>Expire</h6>
                        <h5>{{licenseCount.expired}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-warning text-dark py-3">
                        <h6>Expiring Soon</h6>
                        <h5>{{licenseCount.expiringSoon}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-orange text-white py-3" style="background-color:#E45D27;">
                        <h6>Application Copy Count</h6>
                        <h5>{{licenseCount.appCopy}}</h5>
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <div class="card small-card bg-success text-white py-3">
                        <h6>License Count</h6>
                        <h5>{{licenseCount.uploadCopy}}</h5>
                    </div>
                </div>
            </div>

            <!-- GRAPH -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body" style="height: 320px;">
                    <canvas id="licenseReportChart"></canvas>
                </div>
            </div>


            <h6 class="mb-2 fw-semibold text-center" style="color: #E45D27">License Applicability</h6>

            <!-- TABLE  -->
            <div class="table-responsive" ng-init="BindlicenseReport()">
                <table class="table table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>License</th>
                            <th>State</th>
                            <th>Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in licenseCompliance">
                            <td>{{x.LicenseName}}</td>
                            <td>{{x.STATE_NAME}}</td>
                            <td>{{x.StoreCode}}</td>
                        </tr>


                    </tbody>
                </table>
            </div>
        </div>


        <!-- ===== Foote    r ===== -->
