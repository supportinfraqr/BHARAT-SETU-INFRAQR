                                        {{ (licenseMaster.LicenseStatus === 'Surrender' && licenseMaster.DaysOfExpire < 0) ? 0  : licenseMaster.DaysOfExpire }}
                                    </td>
                                    <td>{{licenseMaster.LicenseStatus}}</td>
                                    <td>
                                        <span ng-class="{ 'ex-status ex-active': licenseMaster.ExpiryStatus === 'Active',
