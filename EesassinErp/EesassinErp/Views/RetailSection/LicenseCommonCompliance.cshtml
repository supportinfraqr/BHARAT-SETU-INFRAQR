
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "License Common Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="~/scripts/RetailJsLib/LicenseCommonComplianceController.js"></script>
<script src="~/ReportsDashboard/LicenseCommonCompliance/script.js"></script>
<script src="~/scripts/Rootfile/chart.umd.min.js"></script>
<link href="~/ReportsDashboard/LicenseCommonCompliance/style.css" rel="stylesheet" />
 
<style>
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }


    .filter-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        font-size: 13px;
        border-radius: 20px;
        border: 1px solid #ff7a2f;
        background: #fff;
        color: #ff7a2f;
        cursor: pointer;
        transition: all 0.25s ease;
    }

        .filter-btn i {
            font-size: 12px;
        }

        .filter-btn:hover {
            background: #ff7a2f;
            color: #fff;
            box-shadow: 0 4px 10px rgba(255,122,47,0.35);
        }

    /* Reset */
    .reset-btn {
        border-radius: 999px;
        color: #fff;
        background: var(--primary);
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.75rem;
    }

        .reset-btn:hover {
            background: var(--primary-dark);
            color: #fff;
        }
</style>

<div class="licCommonCompPage px-4 py-2">
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="Overview, License Report, Expiry Report or Report">
            <button type="button" class="btn btn-pill active" data-target="#overview" ng-click="ManageLog('Click on Overview')" aria-pressed="true">Overview</button> 
            <button type="button" class="btn btn-pill" data-target="#expiryReport" aria-pressed="false" ng-click="BindSecondPart();LoadLicenseReg();ManageLog('Click on Expiry License')">Expiry License</button>
            <button type="button" class="btn btn-pill" data-target="#masterReport" aria-pressed="false" ng-click="started()">Reports</button>
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">
        <!-- CARD 1 : Overview (default visible) -->
        <div id="overview" class="card section-card active">
            <!-- Header -->
            <div class="licCommonCompPage-header mb-3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="mb-0">License Overview</h4>
                    <button type="button" class="btn btn-sm export-btn" ng-click="printoverview();ManageLog('Click on print button License Overview')">
                        <i class="bi bi-download me-1"></i> Print
                    </button>
                </div>
            </div>

            <div class="grbox box curved-div margin3" ng-if="hasAppliedFilters()">
                <div class="bhed"><b style="font-weight: 400; color: var(--primary);">Applied Filters</b></div>

                <div class="filter-scroll" style="font-size: 0.75rem; color: #6e6e6e;">
                    <span ng-if="dvRegion==1" class="filter-chip">
                        <i class="bi bi-globe"></i> Region
                    </span>

                    <span ng-if="dvStatus==1" class="filter-chip">
                        <i class="bi bi-info-circle"></i> Status
                    </span>

                    <span ng-if="dvLicenceStatus==1" class="filter-chip">
                        <i class="bi bi-id-card"></i> Licence Status
                    </span>

                    <span ng-if="dvLicenceApplicable==1" class="filter-chip">
                        <i class="bi bi-check-circle"></i> Licence Applicable
                    </span>

                    <span ng-if="dvExpiryStatus==1" class="filter-chip">
                        <i class="bi bi-clock"></i> Expiry Status
                    </span>

                    <span ng-if="dvFreshRenewal==1" class="filter-chip">
                        <i class="bi bi-sync"></i> Fresh / Renewal
                    </span>

                    <span ng-if="dvClient==1" class="filter-chip">
                        <i class="bi bi-user"></i> Client
                    </span>

                    <span ng-if="dvInvoice==1" class="filter-chip">
                        <i class="bi bi-file-text"></i> Invoice
                    </span>

                    <span ng-if="dvPayment==1" class="filter-chip">
                        <i class="bi bi-credit-card"></i> Payment
                    </span>

                    <span ng-if="dvOutlet==1" class="filter-chip">
                        <i class="bi bi-store"></i> Outlet
                    </span>

                    <span ng-if="dvLicenceType==1" class="filter-chip">
                        <i class="bi bi-certificate"></i> Licence Type
                    </span>

                    <span ng-if="dvState==1" class="filter-chip">
                        <i class="bi bi-map-marker"></i> State
                    </span>

                    <span ng-if="dvAddress==1" class="filter-chip">
                        <i class="bi bi-location-arrow"></i> Address
                    </span>
                </div>
            </div>

            <div class="card-body p-3 d-flex flex-column">
                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown"  ng-click="GetRegion()">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-globe"></i> Region
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-repeat="x in RegionList  | orderBy:'Name'" ng-click="SetRegion(x.RegionId);ManageLog('Click on License Overview Region buuton '+ x.Name)">{{x.Name}}</a></li>
                            </ul>
                        </div>
                        <div class="dropdown" ng-click="BindState()">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-marker-tip"></i>     State
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-repeat="x in StateList  | orderBy:'STATE_NAME'" ng-click="SetState(x.STATE_ID);ManageLog('Click on License Overview ' + x.STATE_NAME)">{{x.STATE_NAME}}</a></li>

                            </ul>
                        </div>

                        <div class="dropdown" ng-click="BindSStore()">

                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-outlet"></i>   Outlet
                            </button>

                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-repeat="x in StoreLList  | orderBy:'StoreName'| unique:'Id'" ng-click="SetStore(x.Id);ManageLog('Click on License Overview ' + x.StoreName)">{{x.StoreName}}</a></li>

                            </ul>
                        </div>

                        <div class="dropdown" ng-click="BindAddress()">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-lock"></i>   Address
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-repeat="x in AddressList | orderBy:'CompleteAddress.toLowerCase()'" ng-click="SetAddress(x.CompleteAddress);ManageLog('Click on License Overview ' + x.CompleteAddress)">{{x.CompleteAddress}}</a></li>
                            </ul>
                        </div>


                        <div class="dropdown" ng-click="BindLicence()">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-card-image"></i>  License
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-repeat="x in LicenceList | orderBy: 'LicenseName.toLowerCase()'" ng-click="SetLicense(x.LicenseId);ManageLog('Click on License Overview ' + x.LicenseName)">{{x.LicenseName}}</a></li>

                            </ul>
                        </div>


                        <div class="dropdown" ng-click="BindLicenceStatus()">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-card-checklist"></i>   License Status
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-click="SetLicenceStatus('Applied');ManageLog('Click on License Overview Applied button')">Applied</a></li>
                                <li><a class="dropdown-item" ng-click="SetLicenceStatus('Issued');ManageLog('Click on License Overview Issued button')">Issued</a></li>
                                <li><a class="dropdown-item" ng-click="SetLicenceStatus('Surrender');ManageLog('Click on License Overview Surrender button')">Surrender</a></li>
                                <li><a class="dropdown-item" ng-click="SetLicenceStatus('Not Applied');ManageLog('Click on License Overview Not Applied button')">Not Applied</a></li>

                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-activity"></i>   Expiry Status
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-click="SetExpiryStatus('Expiring Soon');ManageLog('Click on License Overview Expiring Soon button')">Expiring Soon</a></li>
                                <li><a class="dropdown-item" ng-click="SetExpiryStatus('Expired');ManageLog('Click on License Overview Expired button')">Expired</a></li>
                            </ul>
                        </div>
                        <div class="dropdown" ng-click="BindLicenceType();BindSStore()">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-sign-yield"></i>       License Stage
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" ng-repeat="x in LicenseTypeList  | orderBy:'LicenseType'" ng-click="SetLicenceType(x.LStatus)">{{x.LicenseType}}</a></li>

                            </ul>
                        </div>






                        <button class="btn btn-sm reset-btn" ng-click="Reset();ManageLog('Click on License Overview Reset')">  <i class="bi bi-refresh"></i>Reset</button>
                    </div>


                </div>

                <!--  Dashboard Chart -->
                <div id="licenseoverview" class="licCommonCompPage-chartWrap mt-3" ng-init="FilterGraph()">
                    <div class="licCommonCompPage-chartContainer" style="height:350px;">
                        <canvas id="licCommonComplianceChart"></canvas>
                    </div>
                </div>

            </div>
        </div>

