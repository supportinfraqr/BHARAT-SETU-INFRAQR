                <div class="licReportInsights mt-3">

                    <div class="row g-3 align-items-stretch">
                 LEFT 
                <div class="col-lg-6">
                    <div class="licReportInsights-card">
                        <h5 class="licReportInsights-title">License Status Distribution</h5>
                        <div class="licReportInsights-chartWrap licReportInsights-chart-lg">
                            <canvas id="licStatusDonut"></canvas>
                 Legend 
                <div class="licReportInsights-legend single-row">
                                <span class="active">Active: {{SActive}}</span>
                                <span class="expiring">Expiring Soon: {{SExpiringSoon}}</span>
                                <span class="expired">Expired: {{SExpired}}</span>
                                <span class="pending">Pending Approval: {{SPendingApproval}}</span>
                            </div>
                        </div>
                    </div>
                </div>
                 RIGHT 
                <div class="col-lg-6 d-flex flex-column gap-3">
                 Risk 
                <div class="licReportInsights-card">
                    <h5 class="licReportInsights-title">Risk Assessment</h5>
                    <div class="licReportInsights-riskWrap">
                        <div class="risk-chart">
                            <canvas id="riskDonut"></canvas>
                            <div class="risk-score">{{SExpired}}</div>
                            <div class="risk-label">Risk</div>
                        </div>

                        <ul class="licReportInsights-riskList">
                            <li class="high">High Risk: {{SExpired}}</li>
                            <li class="medium">Medium Risk: {{SExpiringSoon}}</li>
                            <li class="low">Low Risk:  {{SActive}}</li>
                        </ul>
                    </div>
                </div>
                 Document 
                <div class="licReportInsights-card">
                                <h6 class="licReportInsights-title">License Status</h6>
                                <div class="licReportInsights-chartWrap licReportInsights-chart-sm">
                                    <canvas id="docStatusBar"></canvas>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                 ================= License Report : Charts Row ================= 
                <div class="row g-3 mt-1">
                 Left: Licenses by Category 
                <div class="col-lg-6">
                    <div class="licReportInsights-card h-100">
                        <h5 class="licReportInsights-title">Licenses</h5>
                        <div class="licReportInsights-chartWrap licReportInsights-chart-lg">
                            <canvas id="licensesByCategory"></canvas>
                        </div>
                    </div>
                </div>
                 Right: Expiry Timeline 
                <div class="col-lg-6">
                        <div class="licReportInsights-card h-100">
                            <h5 class="licReportInsights-title">Expiry Timeline</h5>
                            <div class="licReportInsights-chartWrap licReportInsights-chart-lg">
                                <canvas id="expiryTimeline"></canvas>
                            </div>
                        </div>
                    </div>

                </div>
                 ================= License Details & Status Table ================= 
                <div class="small-table-wrapper exLicTableWrapper flex-grow-1 overflow-auto rounded-3 mt-3" ng-init="LoadLicenseReg()">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 exLicTable" id="exLicTable">
                            <thead>
                                <tr>
                                    <th>Location</th>
                                    <th>License</th>
                                    <th>License No.</th>
                                    <th>Status</th>
                                    <th>Issue Date</th>
                                    <th>Expiry Date</th>
                                    <th>Days to Expiry</th>
                                    <th>Risk</th>
                                    <th>Compliance</th>
                <th>Documents (P/A/C)</th>
                </tr>
                </thead>
                <tr ng-repeat="licenseMaster in LoadMasterList">
                        <td> {{ licenseMaster.StoreCode }} </td>
                        <td>{{ licenseMaster.LicenseName }}</td>
                        <td>{{ licenseMaster.LicenseNumber }}</td>
                        <td>{{ licenseMaster.ExpiryStatus }}</td>
                        <td>{{ licenseMaster.ValidityStartDate }}</td>
                        <td>{{ licenseMaster.ValidityEndDate }}</td>
                        <td>{{ licenseMaster.DaysOfExpire }}</td>
                        <td ng-class="{ 'ex-risk ex-medium': licenseMaster.ExpiryStatus === 'expire soon' }">
                            {{ licenseMaster.ExpiryStatus }}
                        </td>
                        <td><span class="ex-status ex-danger">Expired</span></td>
                        <td><span class="ex-risk ex-medium">Medium</span></td>

                    </tr>
                <tbody>
                    <tr ng-repeat="licenseMaster in LoadMasterList">

                        <td>{{ licenseMaster.StoreCode }}</td>
                        <td>{{ licenseMaster.LicenseName }}</td>
                        <td>{{ licenseMaster.LicenseNumber }}</td>
                 Expiry Status 
                <td>
                                            <span ng-class="{
                        'ex-status ex-active': licenseMaster.ExpiryStatus === 'Active',
                        'ex-risk ex-medium': licenseMaster.ExpiryStatus === 'Expiring Soon',
                        'ex-status ex-danger': licenseMaster.ExpiryStatus === 'Expired'
                    }">
                                                {{ licenseMaster.ExpiryStatus }}
                                            </span>
                                        </td>

                                        <td>{{ licenseMaster.ValidityStartDate }}</td>
                                        <td>{{ licenseMaster.ValidityEndDate }}</td>

                                        <td class="ex-days"
                                            ng-class="{
                    'ex-good': licenseMaster.ExpiryStatus === 'Active',
                    'ex-warn': licenseMaster.ExpiryStatus === 'Expiring Soon',
                    'ex-bad':  licenseMaster.ExpiryStatus === 'Expired'
                }">
                                            {{ licenseMaster.DaysOfExpire }}
                                        </td>
                 Risk Level 
                <td>
                                        <span ng-class="{
                    'ex-status ex-active': licenseMaster.ExpiryStatus === 'Active',
                    'ex-risk ex-medium': licenseMaster.ExpiryStatus === 'Expiring Soon',
                    'ex-status ex-danger': licenseMaster.ExpiryStatus === 'Expired'
                }">
                                            {{ licenseMaster.ExpiryStatus === 'Active' ? 'Low' :
                   licenseMaster.ExpiryStatus === 'Expiring Soon' ? 'Medium' : 'High' }}
                                        </span>
                                    </td>
                 Progress Bar + % 
                <td>
                                        <div class="ex-progress">
                                            <span class="bar"
                                                  ng-class="{
                          'bar-green': licenseMaster.ExpiryStatus === 'Active',
                          'bar-orange': licenseMaster.ExpiryStatus === 'Expiring Soon',
                          'bar-red': licenseMaster.ExpiryStatus === 'Expired'
                      }"
                                                  ng-style="{
                          width:
                              (licenseMaster.ExpiryStatus === 'Active' ? '100%' :
                               licenseMaster.ExpiryStatus === 'Expiring Soon' ? '60%' :
                               '30%')
                      }">
                                            </span>
                                        </div>

                                        <span class="ex-percent">
                                            {{ licenseMaster.ExpiryStatus === 'Active' ? '100%' :
                   licenseMaster.ExpiryStatus === 'Expiring Soon' ? '60%' :
                   '30%' }}
                                        </span>
                                    </td>

                                </tr>


                            </tbody>
                        </table>
                    </div>
                </div>
