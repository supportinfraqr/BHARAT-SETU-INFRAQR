                        <div class="col-lg-4">
                            <div class="licAction-summary h-100">

                                <div class="licAction-summaryItem compliant">
                                    <i class="bi bi-shield-check"></i>
                                    <span><strong>{{SExpiringSoon}}</strong> of <strong>{{STotalLicense}}</strong> License Expiring Soon</span>
                                </div>

                                <div class="licAction-summaryItem attention">
                                    <i class="bi bi-exclamation-triangle"></i>
