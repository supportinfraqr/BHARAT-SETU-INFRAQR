@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Error</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .error-box {
            background: #fff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            text-align: center;
            max-width: 420px;
            width: 100%;
        }

        .error-icon {
            font-size: 60px;
            color: #dc3545;
            margin-bottom: 15px;
        }

        .error-title {
            font-size: 26px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .error-text {
            color: #6c757d;
            margin-bottom: 25px;
        }

        .btn-home {
            padding: 10px 22px;
            border-radius: 25px;
        }
    </style>
</head>
<body>
    <div class="error-box">
        <div class="error-icon">⚠️</div>
        <div class="error-title">Something went wrong</div>
        <div class="error-text">
            An unexpected error occurred. Please try again later or contact support if the problem persists.
        </div>
        <a href="~/login/login" class="btn btn-primary btn-home">Go to Login Page</a>
    </div>
</body>
</html>
