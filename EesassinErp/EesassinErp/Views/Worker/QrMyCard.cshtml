@{
    string lt = Session["loginType"]?.ToString() ?? Session["LoginType"]?.ToString() ?? Session["loginType"]?.ToString() ?? "";
    Layout = lt == "7" ? "~/Views/Common/WorkerLayout.cshtml" : "~/Views/Common/_NewRetailLayout.cshtml";
    ViewBag.Title = "My Identity Card";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root{
        --blue:#022B5E;
        --blue2:#0b4b96;
        --green:#14843C;
        --orange:#E45D24;
        --line:#c9d2dc;
        --text:#101820;
        --soft:#f5f7fa;
    }
    *{box-sizing:border-box}
    body{background:#f0f4f8;font-family:"Segoe UI",Arial,sans-serif;color:var(--text)}

    .card-page{max-width:1100px;margin:0 auto;padding:34px 22px 60px}

    .card-toolbar{
        display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;
        margin-bottom:20px;padding:16px 22px;background:#fff;border-radius:14px;
        box-shadow:0 2px 10px rgba(0,0,0,.06)
    }
    .card-toolbar h2{margin:0;font-size:20px;font-weight:800;color:#022B5E}
    .card-toolbar .sub{font-size:12px;color:#666;margin-top:2px}
    .card-toolbar .actions{display:flex;gap:10px}
    .btn-card{
        display:inline-flex;align-items:center;gap:7px;padding:10px 20px;
        border-radius:8px;border:none;font-size:13px;font-weight:700;cursor:pointer;
        transition:all .15s
    }
    .btn-card.primary{background:#022B5E;color:#fff}
    .btn-card.primary:hover{background:#0b4b96}
    .btn-card.outline{background:#fff;color:#022B5E;border:2px solid #022B5E}
    .btn-card.outline:hover{background:#f0f4f8}
    .btn-card:disabled{background:#ccc;color:#888;cursor:not-allowed;border-color:#ccc}

    .card-stage{
        width:100%;background:#fff;padding:14px;border-radius:12px;
        box-shadow:0 4px 24px rgba(0,0,0,.12)
    }
    /* Side-by-side with equal fixed size */
    .cards{
        display:flex;
        flex-wrap:wrap;
        gap:16px;
        justify-content:center;
    }

    .card{
        /* Fixed physical size — matches a real ID card proportion */
        position:relative;
        width:440px;
        height:280px;
        overflow:hidden;border-radius:14px;
        background:#fff;border:1px solid #d5dce4;
        box-shadow:0 4px 18px rgba(0,0,0,.18);
        flex-shrink:0;
    }

    /* ── FRONT ── */
.front-top{
        height:18%;padding:9px 16px 5px;display:flex;align-items:center;
        justify-content:space-between;
        background:radial-gradient(circle at 82% 20%,rgba(18,151,76,.10),transparent 28%),#fff;
        border-top:4px solid var(--orange);position:relative
    }
    .front-top:after{
        content:"";position:absolute;left:0;right:0;bottom:0;height:3px;
        background:linear-gradient(90deg,var(--orange),#fff 32%,#fff 67%,var(--green))
    }
    .brand{display:flex;align-items:center;gap:8px;min-width:0}
    .brand-logo{width:44px;height:36px;object-fit:contain;flex-shrink:0}
    .brand-mark{width:48px;height:38px;position:relative}
    .person{position:absolute;width:10px;height:15px;border-radius:8px 8px 4px 4px;bottom:4px}
    .person:before{content:"";position:absolute;width:9px;height:9px;border-radius:50%;top:-8px;left:.5px;background:inherit}
    .p1{left:3px;background:#14843C}.p2{left:17px;background:#E45D24}.p3{left:30px;background:#14843C}
    .arc{position:absolute;left:0;bottom:0;width:43px;height:20px;border:4px solid var(--blue);border-top:0;border-radius:0 0 50px 50px;transform:rotate(-8deg)}
    .brand-name{line-height:1;font-weight:900;font-size:15px;color:#022B5E;white-space:nowrap}
    .brand-name .shram{color:#E45D24}
    .brand-name .setu{color:#14843C}
    .tagline{margin-top:4px;font-size:7px;color:#555;letter-spacing:.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px}
    .employment{text-align:right;font-size:14px;line-height:1.1;font-weight:900;color:#022B5E}

    .verified-bar{
        height:8%;background:linear-gradient(90deg,#022B5E 0 49%,#0b4b96 50% 84%,#14843C 85%);
        color:#fff;display:flex;align-items:center;justify-content:center;
        font-size:11px;font-weight:800;gap:7px;letter-spacing:.5px
    }
    .shield{width:15px;height:15px;border:1.5px solid currentColor;border-radius:50% 50% 45% 45%;position:relative}
    .shield:after{content:"\2713";position:absolute;left:2px;top:-2px;font-size:11px}

    .front-main{height:54%;padding:6px 12px 3px;overflow:hidden}
    .identity{display:grid;grid-template-columns:80px 1fr 74px;gap:8px;align-items:center;height:48%}

    .photo{
        width:72px;height:72px;border-radius:50%;
        background:linear-gradient(145deg,#11a8e8,#0876c8);
        border:2px solid #0b4b96;overflow:hidden;display:flex;align-items:flex-end;justify-content:center
    }
    .photo img{width:100%;height:100%;object-fit:cover}
    .photo .avatar-fallback{display:none}
    .photo.no-photo .avatar-fallback{display:block}
    .photo.no-photo img{display:none}
    .avatar-fallback{position:relative;width:48px;height:56px}
    .avatar-fallback:before{content:"";position:absolute;width:30px;height:30px;left:9px;top:2px;border-radius:50%;background:#d6a47b}
    .avatar-fallback:after{content:"";position:absolute;width:48px;height:36px;left:0;bottom:0;border-radius:26px 26px 0 0;background:#263b55}
    .avatar-hair{position:absolute;width:30px;height:16px;left:9px;top:0;z-index:2;border-radius:50% 50% 35% 35%;background:#1d2835}

    .name{font-size:14px;font-weight:900;color:#022B5E;line-height:1.15;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
    .role{margin-top:2px;font-size:11px;color:#333;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .contractor{margin-top:2px;font-size:10px;color:#444;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}

    .qr{width:70px;height:70px;border:4px solid #fff;outline:1px solid #7b8793;overflow:hidden;justify-self:end}
    .qr img{width:100%;height:100%;object-fit:contain}

    .front-grid{
        border-top:1px solid #aeb9c5;
        display:grid;grid-template-columns:1fr 1fr;
        height:52%;padding-top:4px
    }
    .info-cell{
        display:grid;grid-template-columns:28px 1fr;gap:5px;
        align-items:center;padding:1px 8px 3px 3px;
        border-right:1px solid #aeb9c5;min-width:0;overflow:hidden
    }
    .info-cell:nth-child(even){border-right:0}
    .info-cell:nth-child(n+3){border-top:1px solid #aeb9c5}
    .info-icon{width:24px;height:24px;border:2px solid var(--blue);border-radius:50%;display:grid;place-items:center;color:var(--blue);font-size:11px;font-weight:800;flex-shrink:0}
    .label{font-size:9px;color:#444;line-height:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .value{font-size:11.5px;font-weight:800;margin-top:1px;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
    .city{line-height:1.2;overflow:hidden;min-width:0}
    .city small{font-size:8.5px;font-weight:700;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#555;margin-top:1px}

    .cityscape{
        position:absolute;left:0;right:0;bottom:12%;height:15%;opacity:.2;
        background:linear-gradient(180deg,transparent 0 36%,#76a9d7 36% 100%);
        clip-path:polygon(0 100%,0 75%,5% 72%,5% 60%,8% 60%,8% 74%,13% 68%,13% 48%,16% 48%,16% 74%,21% 61%,21% 40%,24% 40%,24% 70%,29% 58%,29% 28%,33% 28%,33% 70%,38% 55%,38% 45%,41% 45%,41% 73%,46% 62%,46% 35%,50% 35%,50% 73%,55% 52%,55% 25%,59% 25%,59% 72%,65% 58%,65% 42%,68% 42%,68% 72%,73% 55%,73% 31%,77% 31%,77% 70%,83% 62%,83% 45%,87% 45%,87% 73%,92% 60%,92% 37%,96% 37%,96% 72%,100% 70%,100% 100%)
    }

    .front-footer{
        position:absolute;left:0;right:0;bottom:0;height:12%;background:#022B5E;color:#fff;
        display:grid;grid-template-columns:repeat(4,1fr)
    }
    .footer-item{display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:10px;line-height:1.2;text-align:center;border-right:1px solid rgba(255,255,255,.4);gap:1px}
    .footer-item:last-child{border-right:0}
    .footer-icon{font-size:18px}

    /* ── BACK ── */
    .back-header{
        height:12%;background:linear-gradient(135deg,#022B5E,#0b4b96);color:#fff;
        display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;position:relative;
        letter-spacing:.3px
    }
    .back-header:before,.back-header:after{content:"";width:24px;height:1px;background:#fff;opacity:.75;margin:0 8px}
    .back-list{height:64%;padding:3px 12px 0;display:flex;flex-direction:column;overflow:hidden}
    .back-row{
        display:grid;grid-template-columns:24px 1fr 10px 1.05fr;
        flex:1 1 auto;min-height:0;align-items:center;
        border-bottom:1px dotted #aeb6bf;font-size:10px;gap:2px
    }
    .back-row:last-child{border-bottom:0}
    .back-row .bi{width:18px;height:18px;border:1.5px solid #0b4b96;border-radius:50%;display:grid;place-items:center;color:#0b4b96;font-size:9px}
    .back-label{font-weight:500;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .colon{text-align:center;font-weight:700}
    .back-value{font-weight:700;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .notice{margin-top:2px;background:#eef0f2;border-radius:6px;padding:2px 6px;font-size:6.5px;line-height:1.4;flex-shrink:0}
    .notice div:before{content:"\2022";margin-right:4px}
    .dates{height:10%;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:0 12px;font-size:9px;font-weight:700;gap:4px}
    .dates div:first-child{border-right:1px solid #9da8b4;padding-right:6px}
    .dates div:last-child{padding-left:8px}
    .dates strong{color:#0b4b96}
    .signature-row{height:9%;display:grid;grid-template-columns:1fr 1fr;padding:0 12px;font-size:7.5px;align-items:center}
    .signature{font-size:11px;font-family:cursive;border-bottom:1px solid #333;width:64px;margin-bottom:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .back-footer{position:absolute;left:0;right:0;bottom:0;height:6%;background:#14843C;color:#fff;display:flex;align-items:center;justify-content:center;font-size:8.5px;font-weight:700;gap:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 6px}

    .loading-overlay{
        position:fixed;inset:0;background:rgba(255,255,255,.85);z-index:9999;
        display:flex;flex-direction:column;align-items:center;justify-content:center;
        font-size:15px;color:#022B5E;font-weight:600;gap:16px
    }
    .loading-overlay .spinner{width:40px;height:40px;border:4px solid #e0e0e0;border-top-color:#022B5E;border-radius:50%;animation:spin .7s linear infinite}
    @@keyframes spin{to{transform:rotate(360deg)}}

    /* On small screens — scale the physical card down */
    @@media(max-width:960px){
        .cards{gap:12px}
        .card{width:390px;height:247px}
        .brand-logo{width:38px;height:31px}
        .brand-name{font-size:12px}.employment{font-size:11px}
        .photo{width:64px;height:64px}.qr{width:62px;height:62px}
        .name{font-size:13px}.role,.contractor{font-size:9.5px}
        .identity{grid-template-columns:72px 1fr 66px;gap:6px}
        .info-icon{width:22px;height:22px;font-size:10px}
        .label{font-size:8px}.value{font-size:10.5px}
        .back-row{font-size:9px}.back-label,.back-value{font-size:9px}
        .back-header{font-size:11px}
        .notice{font-size:6px}
        .dates{font-size:8.5px}
        .signature-row{font-size:7px}
        .back-footer{font-size:8px}
    }
    @@media(max-width:680px){
        .card-page{padding:14px 8px 28px}
        .card-stage{padding:8px}
        .card{width:340px;height:215px}
        .brand-logo{width:32px;height:26px}
        .brand-name{font-size:11px}.tagline{font-size:5.5px}.employment{font-size:10px}
        .photo{width:56px;height:56px}.qr{width:54px;height:54px}
        .name{font-size:12px}.role,.contractor{font-size:8.5px}
        .identity{grid-template-columns:62px 1fr 58px;gap:5px}
        .info-icon{width:20px;height:20px;font-size:9px}
        .label{font-size:7.5px}.value{font-size:9.5px}
        .footer-item{font-size:8px}.footer-icon{font-size:14px}
        .back-header{font-size:10px}
        .back-row{font-size:8.5px}.back-label,.back-value{font-size:8.5px}
        .back-list{padding:2px 6px 0}
        .dates{padding:0 6px;font-size:8px}
        .signature-row{padding:0 6px;font-size:6.5px}
        .back-footer{font-size:7px}
    }
    @@media print{
        body{background:#fff!important;padding:0!important;margin:0!important}
        /* Hide ERP layout chrome (header navbar, footer, breadcrumbs, modals, loader) */
        .navbar,.nav-left,.nav-center,.nav-right,
        .topbar,.footer,.main-footer,.breadcrumb,.page-title,
        .modal,.modal-backdrop,.loader-overlay,
        .griviences,.sidebar,.header-top,footer{
            display:none!important
        }
        .card-page{padding:0!important;margin:0!important;max-width:100%!important}
        .card-toolbar,.loading-overlay,.standalone-qr{display:none!important}
        .card-stage{
            padding:0!important;margin:0!important;
            box-shadow:none!important;border-radius:0!important;background:#fff!important
        }
        .cards{
            display:grid!important;
            grid-template-columns:1fr 1fr!important;
            gap:10mm!important;
            justify-content:flex-start!important;
            padding:0!important;margin:0!important
        }
        .card{
            width:auto!important;height:auto!important;
            aspect-ratio:1.72/1!important;
            page-break-inside:avoid;
            box-shadow:none!important;border:1px solid #d5dce4!important;
            border-radius:0!important
        }
        @@page{size:auto;margin:10mm}
    }
    .standalone-qr{
        display:flex;justify-content:center;margin-bottom:20px
    }
    .sqr-box{
        background:#fff;border-radius:14px;padding:22px 28px;
        box-shadow:0 2px 10px rgba(0,0,0,.06);text-align:center
    }
    .sqr-title{
        font-size:14px;font-weight:800;color:#022B5E;margin-bottom:14px
    }
    .sqr-box img{
        width:200px;height:200px;border:3px solid #022B5E;border-radius:12px;
        padding:6px;background:#fff
    }
    .sqr-sub{
        font-size:12px;color:#666;margin:12px 0 14px
    }
    .sqr-dl{display:inline-flex!important;text-decoration:none}
</style>

<!-- Loading -->
<div class="loading-overlay" id="cardLoader">
    <div class="spinner"></div>
    Loading your identity card...
</div>

<div class="card-page" id="cardPage" style="display:none">

    <!-- Toolbar -->
    <div class="card-toolbar">
        <div>
            <h2>Bharat Shram Setu &mdash; Employment Card</h2>
            <div class="sub">Verified digital identity card &mdash; front &amp; back</div>
        </div>
        <div class="actions">
            <button class="btn-card outline" onclick="window.print()">
                <i class="bi bi-printer"></i> Print
            </button>
            <button class="btn-card primary" onclick="window.print()">
                <i class="bi bi-file-earmark-pdf"></i> Download PDF
            </button>
            <a class="btn-card primary" id="downloadQrBtn" href="#" download="bss-qr-code.png" style="display:none;text-decoration:none">
                <i class="bi bi-download"></i> Download QR
            </a>
        </div>
    </div>

    <!-- Standalone QR -->
    <div class="standalone-qr" id="standaloneQrPanel" style="display:none">
        <div class="sqr-box">
            <div class="sqr-title"><i class="bi bi-qr-code"></i> Standalone QR Code</div>
            <img id="standaloneQrImg" src="" alt="Standalone QR Code" />
            <div class="sqr-sub">Scan this code to verify your identity</div>
            <a class="btn-card primary sqr-dl" id="downloadQrBtn2" href="#" download="bss-qr-code.png">
                <i class="bi bi-download"></i> Download QR
            </a>
        </div>
    </div>

    <!-- Card Stage -->
    <div class="card-stage">
        <div class="cards">

            <!-- FRONT -->
            <section class="card front">
                <div class="front-top">
                    <div class="brand">
                        <img src="~/Content/NewLogin/images/bharatshramsetu-logo.png" alt="Bharat Shram Setu" class="brand-logo" />
                        <div>
                            <div class="brand-name"><span class="bharat">BHARAT</span> <span class="shram">SHRAM</span> <span class="setu">SETU</span></div>
                            <div class="tagline">One Worker. One Identity. One Future.</div>
                        </div>
                    </div>
                    <div class="employment">EMPLOYMENT<br/>CARD</div>
                </div>

                <div class="verified-bar">
                    <span class="shield"></span> VERIFIED WORKER ID
                </div>

                <div class="front-main">
                    <div class="identity">
                        <div class="photo" id="cardPhoto">
                            <img id="cardPhotoImg" src="" alt="Photo" style="display:none" />
                            <div class="avatar-fallback">
                                <div class="avatar-hair"></div>
                            </div>
                        </div>
                        <div>
                            <div class="name" id="cName">-</div>
                            <div class="role" id="cDesignation">-</div>
                            <div class="contractor">Contractor : <span id="cContractor">-</span></div>
                        </div>
                        <div class="qr">
                            <img id="cQr" src="" alt="QR Code" />
                        </div>
                    </div>

                    <div class="front-grid">
                        <div class="info-cell">
                            <div class="info-icon">ID</div>
                            <div>
                                <div class="label">Worker Code</div>
                                <div class="value" id="cCode">-</div>
                            </div>
                        </div>
                        <div class="info-cell">
                            <div class="info-icon"><i class="bi bi-building"></i></div>
                            <div>
                                <div class="label">Department</div>
                                <div class="value" id="cDept">-</div>
                            </div>
                        </div>
                        <div class="info-cell">
                            <div class="info-icon"><i class="bi bi-telephone"></i></div>
                            <div>
                                <div class="label">Mobile Number</div>
                                <div class="value" id="cMobile">-</div>
                            </div>
                        </div>
                        <div class="info-cell">
                            <div class="info-icon"><i class="bi bi-geo-alt"></i></div>
                            <div class="city">
                                <div class="label">Work Location</div>
                                <div class="value" id="cSite">-</div>
                                <small id="cEmployer">-</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cityscape"></div>

                <div class="front-footer">
                    <div class="footer-item"><div class="footer-icon"><i class="bi bi-shield-check"></i></div>Verified<br/>Identity</div>
                    <div class="footer-item"><div class="footer-icon"><i class="bi bi-arrow-left-right"></i></div>Portable<br/>Across Jobs</div>
                    <div class="footer-item"><div class="footer-icon"><i class="bi bi-lock"></i></div>Secure &amp;<br/>Trusted</div>
                    <div class="footer-item"><div class="footer-icon"><i class="bi bi-qr-code"></i></div>Scan for<br/>Verification</div>
                </div>
            </section>

            <!-- BACK -->
            <section class="card back">
                <div class="back-header">Your Identity. Your Work. Your Security.</div>
                <div class="back-list">
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-droplet"></i></div>
                        <div class="back-label">Blood Group</div><div class="colon">:</div>
                        <div class="back-value" id="cBlood">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-telephone"></i></div>
                        <div class="back-label">Emergency Contact</div><div class="colon">:</div>
                        <div class="back-value" style="color:#022B5E" id="cAltMobile">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-person"></i></div>
                        <div class="back-label">Relation</div><div class="colon">:</div>
                        <div class="back-value" id="cRelation">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-hash"></i></div>
                        <div class="back-label">Camp No.</div><div class="colon">:</div>
                        <div class="back-value" style="color:#022B5E" id="cCamp">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-credit-card"></i></div>
                        <div class="back-label">UAN No.</div><div class="colon">:</div>
                        <div class="back-value" id="cUAN">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-file-medical"></i></div>
                        <div class="back-label">ESIC No.</div><div class="colon">:</div>
                        <div class="back-value" id="cESIC">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-person-badge"></i></div>
                        <div class="back-label">Supervisor Name</div><div class="colon">:</div>
                        <div class="back-value" id="cSupervisor">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-telephone"></i></div>
                        <div class="back-label">Supervisor No.</div><div class="colon">:</div>
                        <div class="back-value" style="color:#022B5E" id="cSupervisorNo">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-bus-front"></i></div>
                        <div class="back-label">Route/Bus No.</div><div class="colon">:</div>
                        <div class="back-value" id="cBus">-</div>
                    </div>
                    <div class="notice">
                        <div>This identity card must always be carried &amp; displayed for security &amp; identification.</div>
                        <div>Loss of this card should be reported to the appropriate authority.</div>
                        <div>This card is not transferable &amp; must be returned immediately on cessation of employment.</div>
                    </div>
                </div>
                <div class="dates">
                    <div><strong>Issue Date :</strong> <span id="cIssue">-</span></div>
                    <div><strong>Valid Upto :</strong> <span id="cValid">-</span></div>
                </div>
                <div class="signature-row">
                    <div>
                        <div class="signature" id="cSigName">-</div>
                        <b id="cSigName2">-</b><br/>
                        <span id="cSigDesig">-</span>
                    </div>
                    <div><br/><b>Contractor : <span id="cSigCon">-</span></b></div>
                </div>
                <div class="back-footer">
                    <i class="bi bi-shield-check"></i> &nbsp; https://bharat-shram-setu-staging.bharatshramsetu.com
                </div>
            </section>
        </div>
    </div>
</div>

<script>
    (function () {
        var API = '@Url.Action("bindworkerdetail", "RetailSection")';
        var QrBase = '@Url.Content("~/Api/QrBridge")';

        function getWorkerId() {
            var p = new URLSearchParams(window.location.search);
            return p.get('WorkerId') || p.get('workerid') || p.get('workerId') || '';
        }

        function mask(val) {
            if (!val) return '-';
            val = String(val);
            return '*'.repeat(Math.max(0, val.length - 4)) + val.slice(-4);
        }

        function formatDate(d) {
            if (!d) return '-';
            try {
                var dt = new Date(d);
                if (isNaN(dt)) return d;
                var dd = String(dt.getDate()).padStart(2, '0');
                var mm = String(dt.getMonth() + 1).padStart(2, '0');
                var yyyy = dt.getFullYear();
                return dd + '/' + mm + '/' + yyyy;
            } catch (e) { return d; }
        }

        function setTxt(id, val) {
            var el = document.getElementById(id);
            if (el) el.textContent = val || '-';
        }

        // Resilient bridge GET: on an intermittent 401, transparently re-login
        // to the bridge using the credentials cached at login, then retry once.
        function qBridgeReAuth() {
            var creds = null;
            try { creds = JSON.parse(sessionStorage.getItem('bssBridgeCreds') || 'null'); } catch (e) { }
            if (!creds || !creds.username) return $.Deferred().reject().promise();
            return $.post(QrBase + '/auth/login/', {
                username: creds.username,
                password: creds.password || ''
            });
        }

        function qBridgeJson(url, attempt) {
            attempt = attempt || 0;
            var dfd = $.Deferred();
            $.get(url)
                .done(function (data) { dfd.resolve(data); })
                .fail(function (xhr) {
                    if (attempt === 0 && xhr && xhr.status === 401) {
                        qBridgeReAuth().done(function () {
                            qBridgeJson(url, 1).done(dfd.resolve).fail(dfd.reject);
                        }).fail(function () { dfd.reject(xhr); });
                    } else {
                        dfd.reject(xhr || 'error');
                    }
                });
            return dfd.promise();
        }

        function setStandaloneQr(qrUrl) {
            var panel = document.getElementById('standaloneQrPanel');
            var img = document.getElementById('standaloneQrImg');
            var dl1 = document.getElementById('downloadQrBtn');
            var dl2 = document.getElementById('downloadQrBtn2');
            if (!panel || !qrUrl) return;
            var attempt = 0;
            var doLoad = function () {
                img.src = qrUrl + '&t=' + Date.now();
            };
            img.onerror = function () {
                if (attempt === 0) {
                    attempt = 1;
                    qBridgeReAuth().done(doLoad).fail(doLoad);
                } else {
                    img.onerror = null;
                }
            };
            doLoad();
            var clean = qrUrl.split('&t=')[0];
            if (dl1) { dl1.href = clean; dl1.style.display = 'inline-flex'; }
            if (dl2) { dl2.href = clean; }
            panel.style.display = 'flex';
        }

        function loadCard(data) {
            if (!data || !data.Result || !data.Result.length) {
                document.getElementById('cardLoader').innerHTML =
                    '<div style="color:#e53935;font-size:16px"><i class="bi bi-exclamation-triangle" style="font-size:32px;display:block;margin-bottom:10px"></i>Worker data not found.</div>';
                return;
            }
            var w = data.Result[0];

            setTxt('cName', w.EmployeeName);
            setTxt('cDesignation', w.EmployeeDesignation || w.Supervisor || '-');
            setTxt('cContractor', w.PartyName || w.VendorName || w.ContractName || '-');
            setTxt('cCode', w.EmployeeCode);
            setTxt('cDept', w.EmployeeDepartment);
            setTxt('cMobile', mask(w.MobileNumber));
            setTxt('cSite', w.SiteName || w.Site || '-');
            setTxt('cEmployer', w.PartyName || w.ClientName || w.EmployerName || '-');
            setTxt('cBlood', w.BloodGroup || '-');
            setTxt('cAltMobile', mask(w.AlternativeMobileNumber || w.NomineeName));
            setTxt('cRelation', w.NomineeRelation || w.Relation || '-');
            setTxt('cCamp', w.CampNumber || w.StoreCode || '-');
            setTxt('cUAN', mask(w.PreviousUAN));
            setTxt('cESIC', mask(w.PreviousESI));
            // Supervisor: TrannerName is stored as supervisor name in DB
            var supName = w.TrannerName || w.Supervisor || w.reportingmang || '-';
            var supNo   = w.managemercontact || w.SuperVisior1 || '-';
            // If SuperVisior1 is '0' or 0, treat as empty
            if (!supName || supName === '0') supName = '-';
            if (!supNo   || supNo   === '0') supNo   = '-';
            setTxt('cSupervisor', supName);
            setTxt('cSupervisorNo', supNo);
            setTxt('cBus', w.BusNo || w.RouteName || '-');
            setTxt('cIssue', formatDate(w.CreatedOn || w.DOJ));
            setTxt('cValid', formatDate(w.ValidTill || w.LeavingDate));
            setTxt('cSigName', w.EmployeeName || '-');
            setTxt('cSigName2', w.EmployeeName || '-');
            setTxt('cSigDesig', w.EmployeeDesignation || '-');
            setTxt('cSigCon', w.VendorName || w.ContractName || '-');

            // Photo
            var photoImg = document.getElementById('cardPhotoImg');
            var photoWrap = document.getElementById('cardPhoto');
            if (w.EmployeePhotos) {
                photoImg.src = w.EmployeePhotos;
                photoImg.style.display = 'block';
                photoWrap.classList.remove('no-photo');
                photoImg.onerror = function () {
                    photoImg.style.display = 'none';
                    photoWrap.classList.add('no-photo');
                };
            } else {
                photoImg.style.display = 'none';
                photoWrap.classList.add('no-photo');
            }

            // QR
            var qrImg = document.getElementById('cQr');
            var qrUrl;
            if (w.Id) {
                qrUrl = QrBase + '/qr/workers/' + w.Id + '/card/?fmt=qr';
            } else {
                qrUrl = QrBase + '/qr/my-card/?fmt=qr';
            }
            qrImg.src = qrUrl + '&t=' + Date.now();
            setStandaloneQr(qrUrl + '&t=' + Date.now());

            document.getElementById('cardLoader').style.display = 'none';
            document.getElementById('cardPage').style.display = 'block';
        }

        // Stores Action=1 supplementary data (site, party, supervisor) to enrich Action=4 result
        var _action1Cache = null;

        function loadCardById(workerId) {
            $.ajax({
                url: API,
                method: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: '{obj:' + JSON.stringify({ ActionType: 4, Id: workerId }) + '}',
                success: function (res) {
                    if (res && res.Result && res.Result.length) {
                        // Merge supplementary Action=1 fields if available
                        if (_action1Cache) {
                            var a1 = _action1Cache;
                            var w  = res.Result[0];
                            w.SiteName         = w.SiteName     || a1.SiteName     || a1.SiteCode;
                            w.PartyName        = w.PartyName    || a1.PartyName    || a1.PartyCode;
                            w.Supervisor       = w.Supervisor   || a1.Supervisor;
                            w.reportingmang    = w.reportingmang|| a1.reportingmang;
                            w.managemercontact = w.managemercontact || a1.managemercontact;
                            w.EmployeePhotos   = w.EmployeePhotos  || a1.EmployeePhotos;
                        }
                        loadCard(res);
                    } else {
                        loadEntityCard();
                    }
                },
                error: function () { loadEntityCard(); }
            });
        }

        function loadByLogin() {
            var userId = sessionStorage.getItem('LoginId') || '@(Session["LoginId"]?.ToString() ?? Session["loginId"]?.ToString() ?? "")';
            if (!userId) {
                loadEntityCard();
                return;
            }
            $.ajax({
                url: API,
                method: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: '{obj:' + JSON.stringify({ ActionType: 1, UserId: userId }) + '}',
                success: function (res) {
                    if (res && res.Result && res.Result.length) {
                        _action1Cache = res.Result[0]; // Cache supplementary data
                        var empCode = res.Result[0].EmployeeCode;
                        if (empCode) {
                            loadCardById(empCode);
                        } else {
                            // Action=1 data might be enough for basic card
                            loadCard(res);
                        }
                    } else {
                        loadEntityCard();
                    }
                },
                error: function () { loadEntityCard(); }
            });
        }

        function loadEntityCard() {
            qBridgeJson(QrBase + '/qr/profile/me/')
                .done(function (res) {
                    if (res && res.Result === 'Success' && res.Data && res.Data.profile) {
                        renderEntityCard(res.Data);
                    } else {
                        document.getElementById('cardLoader').innerHTML =
                            '<div style="color:#e53935;font-size:16px"><i class="bi bi-exclamation-triangle" style="font-size:32px;display:block;margin-bottom:10px"></i>Identity data not found.</div>';
                    }
                })
                .fail(function () {
                    document.getElementById('cardLoader').innerHTML =
                        '<div style="color:#e53935;font-size:16px"><i class="bi bi-exclamation-triangle" style="font-size:32px;display:block;margin-bottom:10px"></i>Failed to load identity data. Please try again.</div>';
                });
        }

        function renderEntityCard(data) {
            var p = data.profile || {};
            var entity = data.entity || '';
            var role = data.role || '';
            var name = p.name || p.full_name || p.contact_person || '-';
            var desig = entity === 'employer' ? 'Employer' : (entity === 'contractor' ? 'Contractor' : 'Worker');
            var isEmp = entity === 'employer';
            var isCon = entity === 'contractor';

            setTxt('cName', name);
            setTxt('cDesignation', p.designation || desig);
            setTxt('cCode', p.legacy_employee_code || p.worker_id || (isEmp ? 'EMP-' + p.id : isCon ? 'CON-' + p.id : p.id) || '-');
            setTxt('cDept', p.department || p.industry || (isCon ? 'Contractor Services' : isEmp ? 'Construction' : '-'));
            setTxt('cMobile', mask(p.mobile || p.contact_mobile));
            setTxt('cSite', p.site_name || p.site || (isCon ? 'Site Assigned' : isEmp ? 'Multiple Sites' : '-'));
            setTxt('cEmployer', p.employer_name || (isCon ? p.name : '-'));
            setTxt('cContractor', p.contractor_name || (isEmp ? p.name : p.name) || '-');

            // ── BACK SIDE: fill every row with DB data or demo fallback ──
            var blood = p.blood_group || (isEmp ? 'A+' : isCon ? 'B+' : 'O+');
            var altMob = p.alternative_mobile || p.contact_mobile || '9876500000';
            var relation = p.nominee_relation || (isEmp ? 'Self' : isCon ? 'Proprietor' : 'Self');
            var camp = p.camp_number || (isEmp ? 'CAMP-EMP-01' : isCon ? 'CAMP-CON-01' : 'CAMP-WK-01');
            var uan = p.previous_uan || '100123456789';
            var esic = p.previous_esi || '2001234567890';
            var sup = p.supervisor1 || p.contact_person || (isEmp ? 'Vikash Sharma' : 'Site Manager');
            var supNo = p.supervisor2 || p.contact_mobile || '9876543210';
            var bus = p.transport || p.route_id || 'BSS Shuttle / RTE-01';

            setTxt('cBlood', blood);
            setTxt('cAltMobile', mask(altMob));
            setTxt('cRelation', relation);
            setTxt('cCamp', camp);
            setTxt('cUAN', mask(uan));
            setTxt('cESIC', mask(esic));
            setTxt('cSupervisor', sup);
            setTxt('cSupervisorNo', mask(supNo));
            setTxt('cBus', bus);
            setTxt('cIssue', formatDate(p.issue_date || p.created_at));
            setTxt('cValid', formatDate(p.valid_till || '31/12/2026'));
            setTxt('cSigName', name);
            setTxt('cSigName2', name);
            setTxt('cSigDesig', p.designation || desig);
            setTxt('cSigCon', p.contractor_name || (isEmp ? p.name : '-') || '-');

            var photoWrap = document.getElementById('cardPhoto');
            document.getElementById('cardPhotoImg').style.display = 'none';
            photoWrap.classList.add('no-photo');

            var qrImg = document.getElementById('cQr');
            var qrUrl = QrBase + '/qr/my-card/?fmt=qr';
            qrImg.src = qrUrl + '&t=' + Date.now();
            setStandaloneQr(qrUrl + '&t=' + Date.now());

            document.getElementById('cardLoader').style.display = 'none';
            document.getElementById('cardPage').style.display = 'block';
        }

        var wid = getWorkerId();
        if (wid) {
            loadCardById(wid);
        } else {
            loadByLogin();
        }
    })();
</script>
