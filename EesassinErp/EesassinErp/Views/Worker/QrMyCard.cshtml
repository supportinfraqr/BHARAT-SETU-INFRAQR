                        <div class="bi"><i class="bi bi-telephone"></i></div>
                        <div class="back-label">Emergency Contact</div><div class="colon">:</div>
                        <div class="back-value" style="color:#124fba" id="cAltMobile">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-person"></i></div>
                        <div class="back-label">Relation</div><div class="colon">:</div>
                        <div class="back-value" id="cRelation">Father</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-hash"></i></div>
                        <div class="back-label">Camp No.</div><div class="colon">:</div>
                        <div class="back-value" style="color:#124fba" id="cCamp">-</div>
                    </div>
                    <div class="back-row">
                        <div class="bi"><i class="bi bi-credit-card"></i></div>
