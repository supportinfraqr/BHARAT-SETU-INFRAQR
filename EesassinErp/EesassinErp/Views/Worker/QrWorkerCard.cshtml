@{
    ViewBag.Title = "Worker QR Card";
    int workerId = ViewBag.WorkerId ?? 0;
    string qrBase = ViewBag.QrBaseUrl ?? "https://bharat-shramsetu.infraqr.com";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<style>
    body { background: #f0f4f8; font-family: 'Segoe UI', sans-serif; }
    .card-wrap {
        max-width: 480px;
        margin: 40px auto;
        background: #fff;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 4px 24px rgba(0,0,0,.1);
        text-align: center;
    }
    .card-title { font-size: 20px; font-weight: 700; color: #1a237e; margin-bottom: 8px; }
    .card-sub   { font-size: 13px; color: #7b8fa1; margin-bottom: 24px; }
    .qr-card-img {
        width: 100%;
        border-radius: 14px;
        box-shadow: 0 4px 16px rgba(0,0,0,.12);
    }
    .btn-qr {
        background: linear-gradient(135deg, #1a237e, #3949ab);
        color: #fff; border: none;
        border-radius: 10px;
        padding: 11px 26px;
        font-weight: 600;
        margin: 8px 4px 0;
        transition: opacity .2s;
    }
    .btn-qr:hover { opacity: .88; color: #fff; }
    #loadingBlock { padding: 40px 0; color: #7b8fa1; }
    #errorBlock  { display:none; }
</style>

<div class="card-wrap">
    <div class="card-title"><i class="fa fa-id-card me-2"></i>Worker Identity QR Card</div>
    <div class="card-sub">Worker ID: @workerId</div>

    <div id="loadingBlock">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div>Loading QR card...</div>
    </div>

    <div id="errorBlock" class="alert alert-danger">
        Failed to load the QR card. Please check your connection or try again.
    </div>

    <img id="qrCardImage" class="qr-card-img" style="display:none;"
         alt="Worker QR Card" />

    <div class="mt-4" id="actionBtns" style="display:none;">
        <button class="btn btn-qr" onclick="downloadPng()">
            <i class="fa fa-image me-1"></i> Download PNG
        </button>
        <button class="btn btn-qr" onclick="downloadPdf()">
            <i class="fa fa-file-pdf me-1"></i> Download PDF
        </button>
        <a href="/Worker/QrDashboard" class="btn btn-outline-secondary ms-2 mt-2 fw-semibold">
            <i class="fa fa-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<script>
    var QR_BRIDGE = '@Html.Raw(Url.Content("~/Api/QrBridge"))';
    var WORKER_ID = @workerId;

    $(function () {
        var imgUrl = QR_BRIDGE + '/qr/workers/' + WORKER_ID + '/card/?fmt=png&t=' + Date.now();
        var img = new Image();
        img.onload = function () {
            $('#loadingBlock').hide();
            $('#qrCardImage').attr('src', imgUrl).show();
            $('#actionBtns').show();
        };
        img.onerror = function () {
            $('#loadingBlock').hide();
            $('#errorBlock').show();
        };
        img.src = imgUrl;
    });

    function downloadPng() {
        var a = document.createElement('a');
        a.href = QR_BRIDGE + '/qr/workers/' + WORKER_ID + '/card/?fmt=png';
        a.download = 'worker_' + WORKER_ID + '_qr_card.png';
        a.click();
    }

    function downloadPdf() {
        window.open(QR_BRIDGE + '/qr/workers/' + WORKER_ID + '/card/?fmt=pdf', '_blank');
    }
</script>
