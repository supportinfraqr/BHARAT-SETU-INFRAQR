@{
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
    ViewBag.Title = "Worker Identity Card";
    int workerId = ViewBag.WorkerId ?? 0;
    string qrBase = ViewBag.QrBaseUrl ?? "https://bharat-shramsetu.infraqr.com";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />



<style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
        background: linear-gradient(135deg, #0a1628 0%, #0d2247 50%, #0a1628 100%);
        min-height: 100vh;
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        color: #e2e8f0;
    }

    .page-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 20px 60px;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 40px;
        padding: 20px 28px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        backdrop-filter: blur(12px);
    }
    .page-header-left h1 {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin: 0;
        letter-spacing: -0.3px;
    }
    .page-header-left p {
        font-size: 13px;
        color: #94a3b8;
        margin: 4px 0 0 0;
    }
    .btn-group-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-act {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-act-success { background: linear-gradient(135deg, #059669, #047857); color: #fff; box-shadow: 0 4px 14px rgba(5,150,105,0.3); }
    .btn-act-success:hover { transform: translateY(-1px); color: #fff; }
    .btn-act-ghost {
        background: rgba(255,255,255,0.07);
        color: #cbd5e1;
        border: 1px solid rgba(255,255,255,0.12);
    }
    .btn-act-ghost:hover { background: rgba(255,255,255,0.12); color: #fff; }

    #loadingBlock {
        text-align: center;
        padding: 80px 0;
        color: #94a3b8;
    }
    .spinner-ring {
        width: 52px; height: 52px;
        border: 4px solid rgba(37,99,235,0.2);
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 20px;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .cards-stage {
        display: flex;
        gap: 32px;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .card-slot {
        flex: 0 0 auto;
        width: 380px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .card-side-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
    }
    .card-side-label span {
        display: inline-block;
        width: 24px; height: 2px;
        background: #334155;
        border-radius: 2px;
    }

    .card-frame {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        box-shadow:
            0 0 0 1px rgba(255,255,255,0.06),
            0 20px 60px rgba(0,0,0,0.5),
            0 4px 16px rgba(0,0,0,0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #0f172a;
        cursor: default;
        aspect-ratio: 870 / 1200;
    }
    .card-frame:hover {
        transform: translateY(-4px) scale(1.005);
        box-shadow:
            0 0 0 1px rgba(255,255,255,0.1),
            0 28px 70px rgba(0,0,0,0.55),
            0 6px 20px rgba(0,0,0,0.35);
    }
    .card-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .card-skeleton {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        background: linear-gradient(
            90deg,
            rgba(255,255,255,0.03) 25%,
            rgba(255,255,255,0.07) 50%,
            rgba(255,255,255,0.03) 75%
        );
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }
    @@keyframes shimmer {
        0%   { background-position: 200% center; }
        100% { background-position: -200% center; }
    }

    .error-box {
        background: rgba(239,68,68,0.1);
        border: 1px solid rgba(239,68,68,0.3);
        color: #fca5a5;
        border-radius: 12px;
        padding: 16px 20px;
        font-size: 14px;
        display: none;
        margin-bottom: 24px;
    }

    .card-info-strip {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 32px;
        flex-wrap: wrap;
        margin-top: 40px;
        padding: 20px 28px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
    }
    .info-chip {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #94a3b8;
    }
    .info-chip i { color: #2563eb; font-size: 15px; }

    @@media (max-width: 860px) {
        .card-slot { width: 320px; }
        .cards-stage { gap: 24px; }
    }
    @@media (max-width: 680px) {
        .card-slot { width: 90vw; max-width: 380px; }
        .cards-stage { gap: 20px; }
        .page-header { padding: 16px 18px; }
    }
</style>

<div class="page-wrap">

    <!-- Error -->
    <div id="errorBox" class="error-box">
        <i class="fa fa-triangle-exclamation me-2"></i>
        <span id="errorMsg">Failed to load identity card.</span>
    </div>

    <!-- Top header -->
    <div class="page-header">
        <div class="page-header-left">
            <h1><i class="fa fa-id-card me-2" style="color:#2563eb;"></i>Worker Identity Card</h1>
            <p>Verification ID card for Worker ID: @workerId</p>
        </div>
        <div class="btn-group-actions">
            <button class="btn-act btn-act-success" id="btnPdf" onclick="downloadPdf()" disabled>
                <i class="fa fa-file-pdf"></i> Download PDF
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div id="loadingBlock">
        <div class="spinner-ring"></div>
        <div style="font-size:15px;color:#64748b;">Loading worker identity card…</div>
    </div>

    <!-- Dual card display -->
    <div id="displayArea" style="display:none;">
        <div class="cards-stage">

            <!-- Front -->
            <div class="card-slot">
                <div class="card-side-label">
                    <span></span>
                    Front Side
                    <span></span>
                </div>
                <div class="card-frame" id="frameFront">
                    <div class="card-skeleton" id="skelFront"></div>
                    <img id="imgFront" alt="Worker Identity Card - Front" style="display:none;" />
                </div>
            </div>

            <!-- Back -->
            <div class="card-slot">
                <div class="card-side-label">
                    <span></span>
                    Back Side
                    <span></span>
                </div>
                <div class="card-frame" id="frameBack">
                    <div class="card-skeleton" id="skelBack"></div>
                    <img id="imgBack" alt="Worker Identity Card - Back" style="display:none;" />
                </div>
            </div>

        </div>

        <!-- Info strip -->
        <div class="card-info-strip">
            <div class="info-chip"><i class="fa fa-shield-halved"></i> Verified Identity</div>
            <div class="info-chip"><i class="fa fa-briefcase"></i> Portable Across Jobs</div>
            <div class="info-chip"><i class="fa fa-lock"></i> Secure &amp; Trusted</div>
            <div class="info-chip"><i class="fa fa-qrcode"></i> Scan for Verification</div>
        </div>
    </div>

</div>

<script>
    var QR_BRIDGE = '@Html.Raw(Url.Content("~/Api/QrBridge"))';
    var WORKER_ID = @workerId;
    var loadedCount = 0;

    $(function () {
        $('#displayArea').show();
        loadCard('front');
        loadCard('back');
    });

    function loadCard(side) {
        var url = QR_BRIDGE + '/qr/workers/' + WORKER_ID + '/card/?fmt=png&side=' + side + '&t=' + Date.now();
        var img = new Image();
        var imgEl  = side === 'front' ? $('#imgFront')  : $('#imgBack');
        var skelEl = side === 'front' ? $('#skelFront') : $('#skelBack');

        img.onload = function () {
            imgEl.attr('src', url).show();
            skelEl.hide();
            loadedCount++;
            if (loadedCount >= 2) {
                $('#loadingBlock').hide();
                $('#btnPdf').prop('disabled', false);
            }
        };

        img.onerror = function () {
            skelEl.hide();
            imgEl.parent().css({ background: 'rgba(239,68,68,0.08)', display: 'flex', alignItems: 'center', justifyContent: 'center' });
            imgEl.parent().html('<div style="text-align:center;padding:20px;color:#f87171;font-size:13px;"><i class="fa fa-circle-xmark" style="font-size:32px;margin-bottom:10px;display:block;"></i>Could not load ' + side + ' side.</div>');
            $('#loadingBlock').hide();
            $('#errorBox').show();
            $('#errorMsg').text('One or more card sides failed to load.');
        };

        img.src = url;
    }

    function downloadPdf() {
        window.open(QR_BRIDGE + '/qr/workers/' + WORKER_ID + '/card/?fmt=pdf&side=both', '_blank');
    }
</script>
