                                    <div class="upload-field">
                                        <div class="upload-input-wrap">
                                            <input type="file" class="upload-input form-control-sm " accept=".pdf" id="InsuranceCopy" onchange="angular.element(this).scope().showFileName(this, 'InsuranceCopy')" ng-model="InsuranceCopy">
                                            <span class="file-name">
                                                {{ InsuranceCopyName }}
                                            </span>
                                        </div>
                                        <div class="upload-actions" ng-if="InsuranceCopy">
                                            <i class="bi bi-eye upload-icon" title="View" ng-click="ViewFileC(InsuranceCopy)"></i>
                                            <i class="bi bi-download upload-icon" title="Download" ng-click="DownloadFileC(InsuranceCopy,'InsuranceCopy')"></i>
                                        </div>
                                    </div>
                                </div>



                            </div>


                        </form>
                    </div>
                    <!-- Footer -->
                    <div class="modal-footer employee-modal-footer">
                        <button class="btn cancel-btn" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-sm add-btn"
                                ng-click="SaveRouteMaster();ManageLog('Submit Route')">
                            Submit
                        </button>

                    </div>
                </div>
            </div>
        </div>
        <div id="Transportmapping" class="card section-card d-none">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="mb-0">Transport Management</h4>
                <button class="btn btn-sm add-btn" id="btnNewEmployee" type="button" data-bs-toggle="modal" data-bs-target="#newtransModal" ng-click="ResetForm();ManageLog('click on New Employee button')">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Add BusRoute</span>
                </button>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2">

                    <!-- Total License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total Bus Route</div>
                        </div>
                        <div class="kpi-value">{{TransportList.length ||0}}</div>
                    </div>

                    <!-- Expiring Soon License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total Contractor</div>
                        </div>
                        <div class="kpi-value">{{EVendorList.length || 0}}</div>
                    </div>

                    <!-- Expired -->

                </div>
            </div>

            <div class="card-body p-3 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown" ng-init="BindVendorListList()">

                            <select class="btn btn-save export-btn dropdown-toggle" ng-model="SelectedVendorId" ng-change="GetTransport()">
                                <option value="">Select</option>
                                <option ng-repeat="x in EVendorList" value="{{x.PartyId}}">{{x.PartyName}}</option>
                            </select>


                        </div>

                        <button type="button"
                                class="btn btn-sm save-btn" ng-click="SaveVendorTransportMapping()">
                            Save
                        </button>

                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="scSearch" type="text" class="form-control form-control-sm" ng-model="empSiteSearch" placeholder="Search..." />
                                <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="" ng-click="TExportToCSV();ManageLog('Transport Print')">
                                            CSV
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="" ng-click="TExportToPDF(); $event.preventDefault(); ManageLog('Export Transport PDF')">
                                            PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="" ng-click="TExportToPrint(); $event.preventDefault(); ManageLog('Export Transport Print')">
                                            Print
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 rounded-3">
                    <div class="table-responsive">
                        <table id="example" class="table table-sm mb-0 small-table">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" ng-model="SelectAll" ng-click="TrtansporttoggleAll()" /></th>
                                    <th>Sr.No</th>
                                    <th>Route ID</th>
                                    <th>Route Name</th>
                                    <th>Start Location</th>
                                    <th>End Location</th>
                                    <th>Bus Number</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr ng-repeat="x in TransportList | filter: SearchEmp | filter: { RouteName: SelectedPartyName }">
                                    <td>
                                        <input type="checkbox" ng-model="x.IsSelected" />
                                    </td>
                                    <td>{{$index + 1}}</td>
                                    <td>{{ x.RouteID }}</td>
                                    <td>{{ x.RouteName }}</td>
                                    <td>{{ x.RouteStartLocation }}</td>
                                    <td>{{ x.RouteEndLocation }}</td>
                                    <td>{{ x.BusNumber }}</td>
                                    <td>{{ x.Status }}</td>

                                    <td class="action-menu">
                                        <button class="btn btn-sm" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#newtransModal" ng-click="setTransportData(x.Id)">
                                                    View More
                                                </a>
                                            </li>


                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>


            </div>
        </div>
    </div>
</div>


