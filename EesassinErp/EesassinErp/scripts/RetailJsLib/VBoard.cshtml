
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Supplier Admin";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}
<script src="~/Masters/NewEmployeeMaster/script.js"></script>
<link href="~/Masters/NewEmployeeMaster/style.css" rel="stylesheet" />
<script src="~/Dashboards/SupplierAdmin/script.js"></script>
<link href="~/Dashboards/SupplierAdmin/style.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/scripts/RetailJsLib/VendorDashboardController.js"></script>
<script src="~/scripts/RetailJsLib/TransportController.js"></script>
<div class="supplierAdminPage px-4 py-2">
    <!-- Capsule Toggle (single capsule container) -->
    <div class="mb-3">
        <div class="toggle-pill" role="tablist" aria-label="Overview, Party, User, Site Management, Location Management or Site Mapping">
            @*<button type="button" class="btn btn-pill" data-target="#overview" aria-pressed="true">Overview</button>*@
            <button type="button" class="btn btn-pill active" data-target="#party" aria-pressed="true">Contractor</button>
            <button type="button" class="btn btn-pill" data-target="#user" aria-pressed="false">User</button>
            <button type="button" class="btn btn-pill" data-target="#siteManagement" aria-pressed="false">Site Management</button>
            @*<button type="button" class="btn btn-pill" data-target="#locationManagement" aria-pressed="false">Location Management</button>
                <button type="button" class="btn btn-pill" data-target="#siteMapping" aria-pressed="false">Site Mapping</button>*@
            <button type="button" class="btn btn-pill" data-target="#empCompDocs" aria-pressed="false" ng-show="loginType==5">Employee Compliance Docs</button>
            <button type="button" class="btn btn-pill" data-target="#activityReport" ng-click="ManageLog('Log Report');BindActivity()" aria-pressed="false">Log Report</button>
            <button type="button" class="btn btn-pill" data-target="#Transportmapping" aria-pressed="false" ng-click="GetTransport()">Transport</button>
        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">

        <!-- CARD 1 : Overview (default visible) -->
        @*<div id="overview" class="card section-card active adminOverview">
            <div class="card-body">



            </div>

        </div>*@


        <!-- CARD 2 : party -->
        <div id="party" class="card section-card active">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="mb-0">Contractor Management</h4>
                <button type="button" class="btn btn-sm add-btn" ng-show="loginType=='5'" data-bs-toggle="modal" data-bs-target="#addPartyModal">
                    <i class="bi bi-plus me-1"></i> Add Contractor
                </button>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2" ng-init="bindtiles()">

                    <!-- Total License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total Contractor</div>
                        </div>
                        <div class="kpi-value">{{AllowContractorLimit || 0}}</div>
                    </div>

                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Used Contractor</div>
                        </div>
                        <div class="kpi-value">{{FullContractorLimit || 0}}</div>
                    </div>

                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Remaining Contractor</div>
                        </div>
                        <div class="kpi-value">{{ContractorLimit || 0}}</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-3 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">
                                {{SelectedContractor || 'Contractor'}}
                            </button>
                       
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="PartySelectContractor()">
                                        All
                                    </a>
                                </li>
                                <li ng-repeat="item in NIndustryList ">
                                    <button type="button"
                                            class="dropdown-item"
                                            ng-click="PartySelectContractor(item)">
                                        {{item}}
                                    </button>
                                </li>


                            </ul>
                        </div>



                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="scSearch"
                                       type="text"
                                       class="form-control form-control-sm"
                                       placeholder="Search..."
                                       ng-model="SearchText" />
                                <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="" ng-click="ExportVendorCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" href="" ng-click="PrintVendorList()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3" ng-init="PartySearch()">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Contractor Code</th>
                                    <th>Contractor Name</th>
                                    <th>Email</th>
                                    <th>Valid From</th>
                                    <th>Valid To</th>

                                    @*<th>Mobile</th>
        <th>Contact Person</th>
        <th>Industry</th>
        <th>UserLimit</th>*@

                                    <th>Status</th>
                                    <th>Craetion Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in FilteredVendorList | filter:SearchText">
                                    <td>{{x.SNO}}</td>
                                    <td>
                                        {{x.PartyCode}}
                                    </td>
                                    <td>
                                        {{x.PartyName}}
                                    </td>
                                    <td>
                                        {{x.EmailId }}
                                    </td>
                                    @*<td>{{x.ContactNo }}</td>
        <td>
            {{x.ContactPerson }}
        </td>
        <td>
            {{x.IndustryName}}
        </td><td>
                                        {{x.UserLimit}}
                                    </td>*@
                                    <td>
                                        {{x.Startdtt}}
                                    </td>
                                    <td>
                                        {{x.Valid}}
                                    </td>

                                    <td>{{x.IsActived}}</td>
                                    <td>{{x.Createddt}}</td>
                                    @*<td class="action-menu">
            <button class="btn btn-sm">
                Edit
            </button>
        </td>*@
                                </tr>


                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

        <!--  Add Party Modal -->
        <div class="modal fade supplierAdminModal"
             id="addPartyModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">
                        <h5 class="modal-title">Add Contractor</h5>
                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <div class="container-fluid">
                            <div class="row g-3">

                                <!-- Party Name -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contractor Name </label>
                                    <input type="text" id="txtPartyName" class="form-control form-control-sm validate" ng-model="PartyName">
                                </div>

                                <!-- Address -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Address</label>
                                    <input id="txtAddress" type="text" class="form-control form-control-sm" ng-model="Address">
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Pincode</label>
                                    <input class="form-control form-control-sm" id="txtPincode" ng-model="Pincode" type="text" maxlength="6" onblur="validateNumberAndDecimalOnly('#txtPincode')">
                                </div>

                                <!-- Email -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Email Id </label>
                                    <input id="txtEmail" class="form-control form-control-sm validate" ng-model="EmailId" type="email" onblur="validateEmail('#txtEmail')" />

                                </div>

                                <!-- Contact No -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact No </label>
                                    <input id="txtContactNo" class="form-control form-control-sm validate" onblur="validatePhoneNo('#txtContactNo')" maxlength="10" placeholder="" ng-model="MobileNo" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />

                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact Person Name </label>
                                    <input type="text" id="txtContactPerson" class="form-control form-control-sm validate" ng-model="ContactPerson">
                                </div>

                                <!-- Contact Person Mobile -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact Person Mobile No.</label>
                                    <input type="text" id="txtContactMobile" class="form-control form-control-sm" onblur="validatePhoneNo('#txtContactMobile')" maxlength="10" placeholder="" ng-model="ContactMobile" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))">
                                </div>
                                <!-- User Limit -->
                                <div class="col-lg-3 col-md-4 col-sm-6 hidden" style="display:none;">
                                    <label class="form-label">User Limit </label>
                                    <input id="txtUserLimit" type="text" ng-model="UserLimit" onblur="validateNumberAndDecimalOnly('#txtUserLimit')"
                                           class="form-control form-control-sm text-right clear" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />
                                </div>

                                <!-- Valid Date -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Valid From</label>
                                    <input type="date" id="txtstartdt" class="form-control form-control-sm" ng-model="Startdt">

                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Valid To</label>
                                    <input type="date" id="txtValidTo" class="form-control form-control-sm" ng-model="ValidTo">

                                </div>

                                <!-- Industry -->
                                <div class="col-lg-3 col-md-4 col-sm-6" ng-init="AllIndustry()" style="display:none;">
                                    <label class="form-label">Industry </label>
                                    <select id="ddlIndustry" autocomplete='address-level2' class="form-select form-select-sm" ng-model="NIndustryId">
                                        <option value="">Select Industry</option>
                                        <option ng-repeat="x in IndustryList" value="{{x.Id}}">{{x.Industry}}</option>
                                    </select>
                                </div>

                                <!-- Description -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Description</label>
                                    <input id="txtDescritpion" type="text" class="form-control form-control-sm" ng-model="Descritpion">
                                </div>

                                <!-- Is Active -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Is Active</label>
                                    <select id="ddlIsActive" ng-init="IsActive='True'" class="form-select form-select-sm" ng-model="IsActive">
                                        <option value="">Select</option>
                                        <option value="True">Yes</option>
                                        <option value="False">No</option>
                                    </select>

                                </div>

                                <!-- Month Expired -->
                                @*<div class="col-lg-3 col-md-4 col-sm-6" style="display:none;">
                                    <label class="form-label">Month Expired</label>
                                    <select id="ddlMonthExpired" class="form-select form-select-sm" ng-model="MonthExpired">
                                        <option value="">Select</option>
                                        <option value="1">1 Month</option>
                                        <option value="2">2 Month</option>
                                        <option value="3">3 Month</option>
                                        <option value="4">4 Month</option>
                                        <option value="5">5 Month</option>
                                        <option value="6">6 Month</option>
                                        <option value="7">7 Month</option>
                                        <option value="8">8 Month</option>
                                        <option value="9">9 Month</option>
                                        <option value="10">10 Month</option>
                                        <option value="11">11Month</option>
                                        <option value="12">12 Month</option>

                                    </select>
                                </div>*@
                               
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">State <span class="text-danger">*</span></label>

                                    <select class="form-select form-select-sm validate"  ng-init="AllCity()"
                                            ng-model="State">
                                        <option value="">Select State</option>
                                        <option ng-repeat="x in AllCityList | unique:'STATE_NAME'"
                                                value="{{x.STATE_NAME}}">
                                            {{x.STATE_NAME}}
                                        </option>
                                    </select>
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">City <span class="text-danger">*</span></label>
                                    <select class="form-select form-select-sm validate"
                                            ng-model="City">
                                        <option value="">Select City</option>
                                        <option ng-repeat="x in AllCityList | filter:{STATE_NAME: State}"
                                                value="{{x.CITY_NAME}}">
                                            {{x.CITY_NAME}}
                                        </option>
                                    </select>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer">
                        <button type="button" id="btnCancel"
                                class="btn btn-sm cancel-btn"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button" ng-click="Contractorlimit();" class="btn btn-sm save-btn">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>



        <!-- CARD 3 : user -->
        <div id="user" class="card section-card d-none">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="mb-0">User Management</h4>
                <button type="button" class="btn btn-sm add-btn" data-bs-toggle="modal" data-bs-target="#addUserModal">
                    <i class="bi bi-plus me-1"></i> Add User
                </button>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2">

                    <!-- Total License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Total User</div>
                        </div>
                        <div class="kpi-value">{{AllowUserLimit || 0}}</div>
                    </div>

                    <!-- Expiring Soon License -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Used User</div>
                        </div>
                        <div class="kpi-value">{{(FullUserLimit || 0) }}</div>
                    </div>

                    <!-- Expired -->
                    <div class="kpi-card">
                        <div>
                            <div class="kpi-title">Remaining User</div>
                        </div>
                        <div class="kpi-value">
                            {{ULimit ||0}}
                        </div>
                    </div>

                </div>
            </div>

            <div class="card-body p-3 d-flex flex-column">

                <!-- Toolbar -->
                <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-2">
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">
                                {{ SelectedPartyName || 'Contractor List' }}
                            </button>

                            <ul class="dropdown-menu">

                                <!-- All Option -->
                                <li>
                                    <a class="dropdown-item" href="" ng-click="SelectPartyAll()">
                                        All
                                    </a>
                                </li>

                                <li ng-repeat="x in EmployeeList | unique:'PartyName'">
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="SelectParty(x)">
                                        {{ x.PartyName }}
                                    </a>
                                </li>

                            </ul>
                        </div>
                        <!--Add new  Desing Code For Filter -->
                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">
                                {{ SelectedUserName || 'User List' }}
                            </button>

                            <ul class="dropdown-menu">
                                <li ng-repeat="x in FilteredUsers">
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="SelectUsername(x)">
                                        {{ x.UserName }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <button class="btn btn-sm filter-btn active" ng-click="reset()">Reset</button>
                        @*<div class="dropdown">
                            <button class="btn btn-sm"
                                    type="button">Reset
                            </button>
                        </div>*@
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       class="form-control form-control-sm"
                                       placeholder="Search..."
                                       ng-model="searchText" />

                                <button class="btn btn-sm" id="exLicSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="" ng-click="ExportUserCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" href="" ng-click="PrintUserList()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 rounded-3" ng-init="UserList();AllVendorCity()">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0 small-table">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>User Name</th>
                                    <th>Contractor Name</th>
                                    <th>EmailId</th>
                                    <th>Contact No</th>
                                    <th>Creation Date</th>
                                    @*<th>Role</th> Old code*@
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in EmployeeList
    | filter:(SelectedUserName ? {UserName: SelectedUserName} : '')
    | filter:(SelectedPartyId ? {PartyId: SelectedPartyId} : '')
    | filter:searchText">
                                    @*<tr ng-repeat="x in EmployeeList
                                    | filter:(SelectedPartyId ? {PartyId: SelectedPartyId} : '')
                                    | filter:searchText">*@

                                    <td>{{x.Id}}</td>
                                    <td>
                                        {{x.UserName}}
                                    </td>
                                    <td>{{x.PartyName}}</td>

                                    <td>
                                        {{x.EmailId}}
                                    </td>
                                    <td>
                                        {{x.ContactNo}}
                                    </td>
                                    <td>
                                        {{x.Createdon}}
                                    </td>
                                    @*<td>      {{ x.Usertype}}</td> old code *@

                                    @*<td class="action-menu">
                                        <button class="btn btn-sm">
                                            Edit
                                        </button>
                                    </td>*@
                                </tr>


                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <!--  Add User Modal -->
        <div class="modal fade supplierAdminModal"
             id="addUserModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">

                    <!-- Header -->
                    <div class="modal-header">
                        <h5 class="modal-title">Add User</h5>
                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <div class="container-fluid">
                            <div class="row g-3">


                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Select Contractor</label>
                                    <select ng-model="PPId" id="ddlPPId" class="form-control">
                                        <option value="">Select</option>
                                        <option ng-repeat="x in VendorList" value="{{x.PartyId}}">{{x.PartyName}}</option>
                                    </select>
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Name</label>
                                    <input type="text" id="txtUName" class="form-control" ng-model="UName">
                                </div>

                                <!-- User Name -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">User Name </label>
                                    <input type="text" id="txtUserNames"
                                           class="form-control"
                                           ng-model="UserNames"
                                           oninput="this.value = this.value.replace(/[^A-Za-z]/g,'')">
                                </div>

                                <!-- Password -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Password</label>
                                    <input type="text" id="txtPassword"
                                           class="form-control"
                                           ng-model="Password"
                                           oninput="this.value = this.value.replace(/\s/g,'')">
                                </div>

                                <!-- Contact No. -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Contact No.</label>
                                    <input id="txtContactNo" class="form-control" onblur="validatePhoneNo('#txtContactNumber')" maxlength="10" placeholder="" ng-model="ContactNumber" onKeyUp="$(this).val($(this).val().replace(/[^\d]/ig, ''))" />

                                </div>

                                <!-- Email ID -->
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">Email ID</label>
                                    <input ng-model="UserEmail" id="txtUserEmail" class="form-control">
                                </div>
                                @*<div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="form-label">User Type</label>
                                    <select ng-model="VendorType" id="ddlUser" class="form-control">
                                        <option value="">Select</option>
                                        <option value="6">Vendor Admin</option>
                                        <option value="2">Vendor User</option>
                                    </select>
                                </div>*@




                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-sm cancel-btn"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="button"
                                class="btn btn-sm save-btn" ng-click="VUserlimit()">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>




        <!-- CARD 4 : Site Management -->
        <div id="siteManagement" class="card section-card d-none">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h4 class="mb-0">Site Management</h4>
                <button type="button" class="btn btn-sm add-btn" data-bs-toggle="modal" id="btnsite" data-bs-target="#addSiteModal" ng-click="Resetsite()">
                    <i class="bi bi-plus me-1"></i> Add Site
                </button>
            </div>

            <!-- KPI Bar  -->
            <div class="container mb-4">
                <div class="kpi-row d-flex gap-2">

                    <!-- Total License -->
                    <div class="kpi-card">
                        <div>
